<https://data.cultureelerfgoed.nl/term/id/cht/13b16a5f-e0f2-4c60-905f-749fc2e811c0>
  a skos:Concept;
  skos:prefLabel "pleisteraars"@nl;
  skos:scopeNote "Ambachtsman die muren bestreek, bewierp of bepleisterde met een laag die vooral bestond uit kalk, soms vermengd met zand of andere toeslagmaterialen. In XIX kwam daar het portlandcement bij. (Haslinghuis)"@nl;
  skos:altLabel "pleisteraar"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db4a7619-d236-4b14-8e79-b4a6e890f677>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/13becadb-8272-46a7-874a-6376e30e4576>
  a skos:Concept;
  skos:prefLabel "jagers (zeil)"@nl;
  skos:scopeNote "(1) Scheepsjager; (2) Enigszins bolgesneden driehoekig zeil van licht doek dat bij zachte wind op het eind van de kluiverboom of van het jaaghollt werd gezet en zo de driehoek tussen eind kluiverboom en de mast vulde."@nl;
  skos:altLabel "jager (zeil)"@nl;
