<https://data.cultureelerfgoed.nl/term/id/cht/2ac4ae17-5c4a-4a2d-bb9e-8bb3a295968d>
  a skos:Concept;
  skos:prefLabel "uitkammers"@nl;
  skos:scopeNote "Uitkammers zijn planken met opstaande ijzeren pennen, waarmee het riet na het oogsten wordt ontdaan van los blad en onkruid. (Het weke dak: riet- en strobedekkingen / , RV bijdrage 11, Zeist 1990)"@nl;
  skos:altLabel "uitkammer"@nl;
