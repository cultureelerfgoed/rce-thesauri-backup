<https://data.cultureelerfgoed.nl/term/id/cht/52d2de42-f8ba-4786-b021-9af470a3119f>
  a skos:Concept;
  skos:prefLabel "tuigjes (kleding)"@nl;
  skos:scopeNote "Tuigjes zijn kledingaccessoires die gebruikt worden om kledingstukken zoals broeken of rokken op hun plaats te houden, vaak verstelbaar en gemaakt van stof of leer."@nl;
  skos:altLabel "tuigje (kledingaccessoire)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5dec9aa2-5ced-4f77-b929-c043b90b2a8f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/9cacf722-abfd-4428-ae58-e412688dca53>
  a skos:Concept;
  skos:prefLabel "maaslappen"@nl;
  skos:scopeNote "Maaslappen zijn stukken stof gebruikt voor naaiwerk waarbij gaten of scheuren worden gerepareerd, vaak met een fijnmazige structuur."@nl;
  skos:altLabel "maaslap"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d4da6562-4510-468e-8b6f-fb1fd79c1205>;
