<https://data.cultureelerfgoed.nl/term/id/cht/191744a4-b17b-4a36-ab59-bf85562fdd9e>
  a skos:Concept;
  skos:prefLabel "krimpenboerderijen"@nl;
  skos:scopeNote "Krimpenboerderijen zijn boerderijen met krimpen in de gevels. Deze krimpen zijn verspringen in de gevels, waardoor de boerderij naar het bedrijfsgedeelte steeds breder wordt."@nl;
  skos:altLabel "krimpenboerderij"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24681d2a-2f2d-40fe-8257-25a35525ae92>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/749f0573-f8be-4a0c-accf-d785333c1beb>
  a skos:Concept;
  skos:prefLabel "Westfriese stolpen"@nl;
  skos:scopeNote "West-friese stolpen zijn stolpen waarbij de darsdeuren in de voorgevel aan de wegzijde zijn gesitueerd, zodat het vee via de weg naar de wei kan worden gebracht. Dars en stalling liggen haaks op elkaar. Dit type komt vooral voor in het Westfriese gedeelte van Noord-Holland."@nl;
  skos:altLabel "Westfriese stelp"@nl, "Westfriese stelpen"@nl, "Westfriese stolp"@nl,
    "Westfriese type"@nl, "Westfriese typen"@nl;
