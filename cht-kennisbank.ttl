  a skos:Concept;
  skos:prefLabel "vesten (kleding)"@nl;
  skos:scopeNote "Een vest is een open of dichtgeknoopt kledingstuk voor het bovenlijf dat oorspronkelijk tot over de heupen hing, maar steeds verder omhoog kroop. Een vest kan mouwen hebben of mouwloos zijn. (Wikipedia)"@nl;
  skos:altLabel "vest (kleding)"@nl;
