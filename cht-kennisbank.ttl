  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/29de062b-0085-4b40-a3de-cc0ce31a9ac1>
  a skos:Concept;
  skos:prefLabel "lineaire erosie"@nl;
  skos:scopeNote "Lineaire erosie is erosie door rivier- en beekwerking (in de eigenlijke zin alleen in de diepte, vaak wordt daarbij gerekend de laterale erosie: ondermijning van de oevers). (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9481cbb0-8f3a-4e59-bc76-0779af35431b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f72bda24-8f38-4f9e-8ba1-821ab4e67b6b>
  a skos:Concept;
  skos:prefLabel "microlieten"@nl;
  skos:scopeNote "Microlieten zijn in het Mesolithicum vervaardigde artefacten van kleine afmetingen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "microliet"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bc706712-3738-462b-8c8c-a0befff10ff5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e8fbb58f-f83c-4ce6-a1ab-24e98dea3b9f>
  a skos:Concept;
  skos:prefLabel "mobilia"@nl;
  skos:scopeNote "Mobilia zijn alle voorwerpen die door de mens zijn gebruikt of vervaardigd, en die in principe verplaatst kunnen worden; roerende goederen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1cc34c40-1990-4667-a00f-0f67900f0202>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c2920597-b01f-44f8-81ac-4c80d4fe889c>
  a skos:Concept;
  skos:prefLabel "modderklei"@nl;
  skos:scopeNote "Modderklei is meestal donker gekleurde, slappe, humeuze brakwaterklei welke rijk is aan sulfiden. Vaak aan de landzijde van een kwelder afgezet in een rietgorsmilieu. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b9956996-fdd1-4d28-aa1c-d85235ece55b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/60b6671d-24bc-44e9-9600-b94cac8e79da>
  a skos:Concept;
  skos:prefLabel "napoleonshoed"@nl;
  skos:scopeNote "Type maalsteen, waarvan de vorm overeen komt met de vorm van een steek(hoed) zoals gedragen door Napoleon. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b97f8070-031c-4df8-96bd-aebf61fde2f4>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6f047853-039b-462a-8f08-106d757a505e>
  a skos:Concept;
  skos:prefLabel "N-wegnummers"@nl;
  skos:scopeNote "N-wegnummers betreft de nummering van de provinciale wegen behorende tot het nationale wegenstelsel. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "N-wegnummer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2e44391b-0677-4f76-a9be-d9b3289b8108>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c2a4bba4-d0fe-4d99-bfbe-e29647f372d7>
  a skos:Concept;
  skos:prefLabel "occupatiepatronen"@nl;
  skos:scopeNote "Occupatiepatronen zijn voor een gebied kenmerkende patronen van bewoning en/of verstedelijking, nauw gerelateerd aan de ontginningsgeschiedenis en aan het kavelpatroon. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "occupatiepatroon"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/cc963c5f-f33e-4b0a-a1cb-06183e15f351>
  a skos:Concept;
  skos:prefLabel "oeverafzetting"@nl;
  skos:scopeNote "Oeverafzettingen zijn de afzettingen die een natuurlijke (niet bedijkte) rivier vormt naast de geul. Deze afzettingen zijn fijner dan die in de bedding zijn gevormd en grover dan die in de kommen worden gevormd. In het centrale rivierengebied bestaan de oeverafzettingen vaak uit sterk siltige klei of zandige klei. Het vormt een rug langs een rivier, bestaande uit overwegend kleiafzettingen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c6b8be00-b04b-45cc-a5ee-c7e04254319f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b3dc1c67-01fc-42fb-b618-630febd3e4aa>
  a skos:Concept;
  skos:prefLabel "oevergronden"@nl;
  skos:scopeNote "Oevergronden zijn, meestal, zandige of zavelige afzettingen die zijn ontstaan bij doorbraken van oeverwallen. (dus onder natuurlijke omstandigheden) (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "oevergrond"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c6b8be00-b04b-45cc-a5ee-c7e04254319f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/307dc588-e30e-42ff-96f3-ed3aca6681b3>
  a skos:Concept;
  skos:prefLabel "onderhouten (organisme)"@nl;
  skos:scopeNote "Onderhout is lage, struikachtige, min of meer verwilderde begroeiing tussen de bomen in een bos of populierenopstand. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "onderhout (organisme)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/78672fa4-8815-4427-995e-21a2cc90bd39>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/edf5c2b8-b25c-47ff-8c0d-7baded009949>
  a skos:Concept;
  skos:prefLabel "ontginningsgeschiedenis"@nl;
  skos:scopeNote "De ontginningsgeschiedenis is de historie van de in gebruik name (ontginning) van gronden, vaak vergeleken met bewoningsgeschiedenis. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/3497e072-02f7-4560-b7a6-438df232a4ad>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/bb557d2a-227d-46ae-9d16-bc8ac22cc9cd>
  a skos:Concept;
  skos:prefLabel "ontturving"@nl;
  skos:scopeNote "Ontturving is het afgraven van veenlagen op grotere diepte (1,5 tot 2 meter), waarbij eerst de bovenlaag wordt verwijderd en vervolgens het veen, waarna de bovenlaag weer wordt teruggestort. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/9ef30e4a-41d0-4d12-a9d6-02828da61c69>
  a skos:Concept;
  skos:prefLabel "oppida"@nl;
  skos:scopeNote "Een oppidum is een versterkte nederzetting uit de IJzertijd. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "oppidum"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d67a4fa0-7ed6-4584-b653-8cd0bef4a150>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/37b7d97b-4c43-48f1-b0ad-eddc8104c835>
  a skos:Concept;
  skos:prefLabel "paleolieten"@nl;
  skos:scopeNote "Paleolieten zijn in het Paleolithicum vervaardigde artefacten. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "paleoliet"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bc706712-3738-462b-8c8c-a0befff10ff5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/5bd8e3c8-a891-4a62-b8a2-cac79cae6c71>
  a skos:Concept;
  skos:prefLabel "patronaatsrecht"@nl;
  skos:scopeNote "Patronaatsrecht is het recht om geestelijken ter benoeming voor te dragen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2ca337aa-dad8-4cb9-83fa-f6472ccf97c8>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a932991e-9bdc-4736-8627-1652443b2939>
  a skos:Concept;
  skos:prefLabel "peilbeheer"@nl;
  skos:scopeNote "Peilbeheer is beheer gericht op het reguleren van het grondwaterpeil in een gebied. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/190b9fce-fb0d-4b41-b46d-e1795ae38304>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a2a6aaa9-878c-4a74-b52e-af773178f55b>
  a skos:Concept;
  skos:prefLabel "penetrerende echoloden"@nl;
  skos:scopeNote "Penetrerende echoloden zijn echoloden waarbij de golven niet alleen vanaf het bodemoppervlak terugkaatsen, maar ook enigszins in de bodem doordringen en daar terugkaatsen op reflectievlakken. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "penetrerend echolood"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4201602d-9f56-43b3-8995-a6d7c3157fac>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/16fa363a-7aba-446b-b849-1a51e81cf2fb>
  a skos:Concept;
  skos:prefLabel "pikklei"@nl;
  skos:scopeNote "pikklei is als knipklei, maar dan in het westen van het land, een bruine onvruchtbare soort klei. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b9956996-fdd1-4d28-aa1c-d85235ece55b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8e70d76a-28d2-4d62-bf4b-5d35c63b2312>
  a skos:Concept;
  skos:prefLabel "pollenanalyse"@nl;
  skos:scopeNote "Pollenanalyse is de bestudering van fossiele stuifmeelkorrels en sporen waardoor een beeld van de vegetatiegeschiedenis gevormd kan worden. Uit de vegetatiegeschiedenis kan het klimaat worden gereconstrueerd. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c31c17cc-ac7d-4a4e-bc63-41f888e1a047>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/14c143f4-5fe4-4333-be24-c503fca8ab1f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/0d1246b5-b82a-496f-9662-d44e81de1e7a>
  a skos:Concept;
  skos:prefLabel "pollendiagrammen"@nl;
  skos:scopeNote "Pollendiagrammen zijn diagrammen waarin door de weergave van de relatieve hoeveelheden stuifmeelkorrels van grassen/kruiden en bomen een indruk wordt gegeven van de begroeiingsgeschiedenis van een gebied: enerzijds een afspiegeling van de klimaatgeschiedenis, anderzijds van de mate waarin de mens heeft ingegrepen in de natuurlijke begroeiing. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "pollendiagram"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91712616-6dec-4871-8fdc-c317850c20d1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/1d0fb55e-7bb6-4bdf-a0b9-18d66e6c639d>
  a skos:Concept;
  skos:prefLabel "potentiekaarten"@nl;
  skos:scopeNote "Potentiekaarten zijn kaarten waarop zones staan aangegeven die waarden / belangen in het gebied weergeven. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "potentiekaart"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7c99f9e1-2f0f-4367-abe4-f6d72120c233>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b6c72f5f-05c8-4615-9c77-89aeaefc4e76>
  a skos:Concept;
  skos:prefLabel "radiaire verkavelingen"@nl;
  skos:scopeNote "Radiaire verkaveling is een verkavelingstype dat gekenmerkt wordt door een straalsgewijze configuratie,waarbij een bewonings-centrum (altijd een terp) als uitgangspunt dient. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "radiaire verkaveling"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/efa87804-abc7-47f0-9dc4-94007456af7c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/1f8b6d70-d446-426e-9a5f-9f1e2d433ead>
  a skos:Concept;
  skos:prefLabel "restveen"@nl;
  skos:scopeNote "Restveen is het in voormalige veenplassen niet van de bodem weggebaggerde of geërodeerde veen dat nu nog lokaal aan de oppervlakte van droogmakerijen voorkomt. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/626077f4-772b-4c36-9f6b-e72a4c9d28fa>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4d29a26a-d814-4e82-b756-63c6662fb852>
  a skos:Concept;
  skos:prefLabel "roodleem"@nl;
  skos:scopeNote "Roodleem is verbrande leem. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/83f4ebfd-1cad-442e-b58e-d83df84758d9>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/80b42278-9492-4769-9c5d-4eebf461abdf>
  a skos:Concept;
  skos:prefLabel "roodzand"@nl;
  skos:scopeNote "Roodzand zijn (Cirkelvormige) plekken van rood zand, waarop een zogenaamde houtskoolmeiler heeft gestaan. Houtskoolmeilers werden gebruikt om houtskool te maken. Zij bestonden uit een halfronde pol van gestapeld hout afgedekt met plaggen. Door de langdurige hoge temperatuur ontstond er roodzandige bodem. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/8feb4715-c276-4ae1-adb9-44613b25214a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/0f425e6d-1f96-41e0-bae1-32febfc63deb>
  a skos:Concept;
  skos:prefLabel "slagenverkavelingen"@nl;
  skos:scopeNote "Slagenverkaveling is de verdeling van cultuurgrond in lange en smalle, door sloten gescheiden, stukken. (kavels) (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "slagenverkaveling"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/efa87804-abc7-47f0-9dc4-94007456af7c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4023c503-0311-4308-ae65-16c0c1e8f97d>
  a skos:Concept;
  skos:prefLabel "smeltwater"@nl;
  skos:scopeNote "Smeltwater is water dat ontstaat bij smelting van sneeuw en van gletsjerijs. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0c41c9b8-fb66-48af-b44a-46dd24503c6c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a8c96d47-c59a-46ca-80bd-919781b49886>
  a skos:Concept;
  skos:prefLabel "tolgaarders"@nl;
  skos:scopeNote "Tolgaarders zijn de personen aan wie het tol (recht of cijns) te worden afgedragen voor de passage van personen en goederen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "tolgaarder"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db4a7619-d236-4b14-8e79-b4a6e890f677>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2de885f4-cff1-4e58-8e46-f2074c9a8060>
  a skos:Concept;
  skos:prefLabel "verbrede landbouw"@nl;
  skos:scopeNote "Verbrede landbouw bestaat uit landbouw met verbredende activiteiten die altijd in combinatie met agrarische activiteiten worden uitgevoerd. Er wordt onderscheid gemaakt in de thema’s agrarisch natuur- en landschapsbeheer, recreatie en product en afzet. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/95376ae1-fcb9-40f4-822f-44abd3a7e91e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fa3de81a-fc3c-4c71-aa15-9808179c7017>
  a skos:Concept;
  skos:prefLabel "votieven"@nl;
  skos:scopeNote "Votieven zijn voorwerpen die aan een godheid geschonken worden. (meestal als dank) (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "votief"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1cc34c40-1990-4667-a00f-0f67900f0202>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/77a8bc50-6799-4638-90c8-54c175bc930d>
  a skos:Concept;
  skos:prefLabel "wegstaties"@nl;
