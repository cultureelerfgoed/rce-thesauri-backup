<https://data.cultureelerfgoed.nl/term/id/cht/205803f5-72a0-4ea2-b847-97cb34d51a0d>
  a skos:Concept;
  skos:prefLabel "berries (roosterwerk/fundering)"@nl;
  skos:scopeNote "Houten roosterwerk in fundering, bestaande uit twee langshouten met dwarsverbindingen, waartussen geheid werd. 1456 Brielle, St.-Catharijnekerk; berrij: 1651 Rotterdam, St.-Laurenstoren. (Haslinghuis)"@nl;
