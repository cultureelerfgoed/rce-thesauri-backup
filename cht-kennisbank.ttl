  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/420456a0-f405-4d56-b0bc-f25884acc694>
  a skos:Concept;
  skos:prefLabel "zadelvorsten"@nl;
  skos:scopeNote "Zadelvorsten zijn machinaal vervaardigde vorstpannen met een hoge zadelvormige doorsnede."@nl;
