<https://data.cultureelerfgoed.nl/term/id/cht/a2b8fbbb-6edb-4b55-bd2a-f6da2c64e287>
  a skos:Concept;
  skos:prefLabel "vervormd"@nl;
  skos:scopeNote "Vervorming van een voorwerp is een ongewenste verandering van vorm."@nl,
