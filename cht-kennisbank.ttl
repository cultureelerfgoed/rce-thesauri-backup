<https://data.cultureelerfgoed.nl/term/id/cht/4fefdd4a-3049-408d-a79a-7a4ba24f707a>
  a skos:Concept;
  skos:prefLabel "doorslagen"@nl;
  skos:scopeNote "Balk, liggend op de brede kant op gemetselde pilaren, penanten of poeren onder een gebouw, dwarsverbinding. Erover liggen de vloerbalken. (Haslinghuis)"@nl;
  skos:altLabel "doorslag"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/650ab4b1-e8ab-4c49-9195-8401d4a6cd6e>;
