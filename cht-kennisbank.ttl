  a skos:Concept;
  skos:prefLabel "wasberen"@nl;
  skos:scopeNote "Wasberen (Procyon) zijn een geslacht van de roofdieren (Carnivora) uit de familie kleine beren (Procyonidae). Ze komen voor in grote delen van Amerika en Noord-Europa. De bekendste soort wasbeer is de gewone wasbeer (Procyon lotor). (MARDOC)"@nl;
  skos:altLabel "wasbeer"@nl;
