<https://data.cultureelerfgoed.nl/term/id/cht/7f4fd0ee-7b14-42b1-99ac-5de5015fd0c8>
  a skos:Concept;
  skos:prefLabel "loodreien"@nl;
  skos:scopeNote "Voorloper van de waterpas met een lange rechte onderzijde en een schietloodje in het midden. Er werd mee gecontroleerd of een vlak horizontaal was. (Haslinghuis)"@nl;
  skos:altLabel "loodrei"@nl;
