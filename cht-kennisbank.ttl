  a skos:Concept;
  skos:prefLabel "hoekkeperpannen"@nl;
  skos:scopeNote "Hoekkeperpannen zijn pannen die op de hoekkepers worden gelegd."@nl;
  skos:altLabel "hoekkeperpan"@nl;
