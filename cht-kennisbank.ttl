<https://data.cultureelerfgoed.nl/term/id/cht/72bd7bf1-cbba-4ab2-8e66-0666047881cc>
  a skos:Concept;
  skos:prefLabel "microklimaat"@nl;
  skos:scopeNote "Een microklimaat is een besloten en gecontroleerd milieu, gewoonlijk bedoeld om voorwerpen onder optimale condities te bewaren of tentoon te stellen in een afgesloten omhulsel of vitrine."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/de1b7736-5d45-413a-925f-2ae733f8836f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/dc8a0710-5d5b-4fba-ad6e-c86c79b75a1b>
  a skos:Concept;
  skos:prefLabel "afbraakwanden"@nl;
  skos:scopeNote "afbraakwanden zijn dalwanden die zijn blootgesteld aan hellingerosie. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "afbraakwand"@nl;
