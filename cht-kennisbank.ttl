  skos:altLabel "gasluchter"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/849e4364-5f6a-4e6d-bad5-e7b04e4492b9>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e13fc84c-58af-4001-ae90-ed3fffcd2591>
  a skos:Concept;
  skos:prefLabel "doopkannen"@nl;
  skos:scopeNote "Kan waarmee het doopwater boven het doopbekken over de dopeling wordt gegoten."@nl;
  skos:altLabel "doopkan"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9d88ce85-dbad-4200-b1f3-22770f82795b>;
