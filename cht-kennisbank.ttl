  a skos:Concept;
  skos:prefLabel "Noordzeebotters"@nl;
  skos:scopeNote "Botter met een minder geveegd onderwaterschip dan de Zuiderzeebotter, een vollere kop en achterschip. De zeeg lag praktisch horizontaal, zodat het achterschip hoger was. De romp was geheel gedekt. (aatned.nl)"@nl;
  skos:altLabel "Noordzeebotter"@nl;
