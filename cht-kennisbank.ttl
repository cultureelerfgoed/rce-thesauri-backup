<https://data.cultureelerfgoed.nl/term/id/cht/38151b31-e9bf-42ff-8466-dc1cc827eea8>
  a skos:Concept;
  skos:prefLabel "zeildoek"@nl;
  skos:scopeNote "Zeildoek (ongekeperd linnen of katoen) is een sterk weefsel dat kan worden gebruikt als schildersdoek of bedoekingsmateriaal. In het Engels heet het duck (eend) omdat het waterafstotend is."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/86d3631a-1f3f-4b51-bbbb-dadebc310ecc>;
