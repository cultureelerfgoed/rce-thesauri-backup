<https://data.cultureelerfgoed.nl/term/id/cht/a2f0a744-2b23-4129-97aa-cccd32a12483>
  a skos:Concept;
  skos:prefLabel "koopovereenkomst"@nl;
  skos:scopeNote "Een koopovereenkomst is de overeenkomst waarbij de een zich verbindt een zaak te geven en de ander daarvoor een prijs in geld te betalen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/efc26230-3f88-4eeb-bd03-3763f19ac69b>;
