  a skos:Concept;
  skos:prefLabel "hoekblokken"@nl;
  skos:scopeNote "Natuurstenen blok op de hoek van een gevel of muur. Vooral in XIV-XVII geliefde opluistering van bakstenen vlakken. ((Haslinghuis)"@nl;
  skos:altLabel "eksteen"@nl, "ekstenen"@nl, "hoekblok"@nl;
