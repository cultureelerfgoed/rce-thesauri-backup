<https://data.cultureelerfgoed.nl/term/id/cht/d04b03e8-668d-46df-a7b3-db34bd3d47cd>
  a skos:Concept;
  skos:prefLabel "gewassen grindvloeren"@nl;
  skos:scopeNote "Gewassen grindvloeren zijn afwerkvloeren vervaardigd van grind vermengd met een kleurloze transparante epoxyhars. Voor de vloeren wordt voornamelijk riviergrind gebruikt uit Zuid-Duitsland dat vrij hard is. Het wordt gewassen, gezeefd en vuurgedroogd en daarna gekleurd. (P. Bot, Vademecum historische bouwmaterialen, installaties en infrastructuur, Alphen aan de Maas 2009)"@nl;
  skos:altLabel "gewassen grindvloer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/be9ffbd0-dd12-491e-b9a1-0d224a57a03d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/60a06309-e920-4ce8-a30d-88d09334658b>
  a skos:Concept;
  skos:prefLabel "fabriekstuinen"@nl;
  skos:scopeNote "Fabriekstuinen zijn tuinen op fabrieksterreinen die het aanzien voor medewerkers en bezoekers aantrekkelijk maken. De tuinen bieden vaak ook zit- en wandelgelegenheid voor de medewerkers. Bekende voorbeelden zijn de tuinen van Mien Ruys bij weverij De Ploeg in Bergeijk en bij de Van Nellefabriek in Rotterdam. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "fabriekstuin"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c2fcf3dc-6efd-4c88-afcf-287b680894ff>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ab254d18-a0f8-41b0-9793-42132a00d71f>
  a skos:Concept;
  skos:prefLabel "eendenfokkerijen"@nl;
  skos:scopeNote "Bedrijf waar eenden gefokt worden"@nl;
  skos:altLabel "eendenfokkerij"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e96e309b-c611-48fa-8284-0dcc323ef519>;
