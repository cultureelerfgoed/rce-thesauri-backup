  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b77a6f2b-a86c-4d19-a749-3a38c1a48615>
  a skos:Concept;
  skos:prefLabel "driekoningenkandelaren"@nl;
  skos:scopeNote "Kandelaar voor drie kaarsen. Op een pin in het midden staat een waskaars, in de twee houders ter weerszijden staan vetkaarsen. Wordt gebruikt op het feest van Driekoningen (6 januari)."@nl;
  skos:altLabel "driekoningenkandelaar"@nl, "driekoningenkandelaars"@nl;
