<https://data.cultureelerfgoed.nl/term/id/cht/04f74ebd-68b1-4fba-ad07-65034a5e6f0c>
  a skos:Concept;
  skos:prefLabel "kalkwater"@nl;
  skos:scopeNote "Kalkwater is een oplossing van gebluste kalk (calciumhydroxide( in water. Het is wel gebruikt voor de versteviging van het oppervlak van kalksteen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0c41c9b8-fb66-48af-b44a-46dd24503c6c>;
