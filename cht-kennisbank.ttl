<https://data.cultureelerfgoed.nl/term/id/cht/1ff897f2-88aa-4f59-a4cf-cf1b355d31d8>
  a skos:Concept;
  skos:prefLabel "cope"@nl;
  skos:scopeNote "Een cope is een overeenkomst of een contract om een gebied (perceel) te mogen ontginnen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/df4db7b4-3b69-49a2-9068-13034f1a068f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/200349f5-27bd-472c-9035-c1f6b3e3e4ac>
  a skos:Concept;
  skos:prefLabel "levensbomen (Torastokken)"@nl;
  skos:scopeNote "Levensbomen zijn de twee stokken waaraan een Sefer Tora is bevestigd. Enkelvoud = eets chajiem."@nl;
  skos:altLabel "Atsee chajiem"@nl, "levensboom (Torastokken)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/abfc1bb7-04d7-43a0-9e99-dd4c5a4f2c15>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/200ee905-dbdf-4ad3-b73a-fdd875b7ae22>
  a skos:Concept;
  skos:prefLabel "Perzisch, modern"@nl;
  skos:scopeNote "Het Perzisch (lokale namen: Pârsi, Fârsi, Dari en Tōjiki) is de officiële taal van Iran (Perzië), Afghanistan en Tadzjikistan en wordt door miljoenen mensen in Oezbekistan gesproken. Het behoort tot de Indo-Europese taalfamilie en daarbinnen is het een onderdeel van de tak van de Iraanse of Arische talen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ba8a0df0-e7c1-48f4-ab90-dfde6c264f0e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/202ee8e4-8609-4141-8fe6-40c004b25b80>
  a skos:Concept;
  skos:prefLabel "sputtering"@nl;
  skos:scopeNote "Sputtering is het aanbrengen van een magneto-optische laag op een polycarbonaat drager voor minidiscs waarbij de vloeistof in druppelvorm wordt opgebracht."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/204ee612-8306-45f2-bd9a-7e27884f95d9>
  a skos:Concept;
  skos:prefLabel "gesso grosso"@nl;
  skos:scopeNote "Gesso grosso is een laag van grof poeder van gebrand gips gemengd met lijm, die direct op de, meestal houten, drager van het schilderij wordt aangebracht."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9d9e957c-ba7b-4138-b09c-c19653b04ea4>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/20571621-403f-443c-85e4-cada943a8be4>
  a skos:Concept;
  skos:prefLabel "handvaardigheid"@nl;
  skos:scopeNote "Handvaardigheid duidt op de manuele vaardigheden die in de praktijk geleerd worden."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/df4db7b4-3b69-49a2-9068-13034f1a068f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/20649d5d-a83b-49b6-b7c3-95de1e8df6d8>
  a skos:Concept;
  skos:prefLabel "composietfolie"@nl;
  skos:scopeNote "Composietfolie is een metaalfolie van brons of messing. Het is een goedkoop vervangingsmiddel voor goudblad. Zie ook klatergoud."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/20686fb6-323b-4ddf-90e3-c73c05f4f883>
  a skos:Concept;
  skos:prefLabel "omofor"@nl;
  skos:scopeNote "Een omofor op een icoon is een kledingstuk dat door bisschoppen wordt gedragen over de sakkos. Het is een teken van de bisschoppelijke waardigheid."@nl;
  skos:altLabel "omoforion"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7b6aa962-9e1b-4be4-88ae-11e4b89dbc8b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/206beb1a-7da7-4e83-ace2-fbae5645048e>
  a skos:Concept;
  skos:prefLabel "dansorgels"@nl;
  skos:scopeNote "Het dansorgel is een vast opgesteld groot draaiorgel, veelal geplaatst in cafés of danszalen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "dansorgel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa9cda1e-c01d-431e-9f74-51d3073b97d5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/207849fa-a6eb-4337-9c20-2ff959f29812>
  a skos:Concept;
  skos:prefLabel "binnenschuurmachines"@nl;
  skos:scopeNote "binnenschuurmachines zijn schuurmachines met een draaiende schuurdop waarmee de klompen van binnen worden gladgeschuurd."@nl;
  skos:altLabel "binnenschuurmachine"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/476f28ba-ff0d-4cac-98ab-74be53a91233>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/20842cd4-e405-4c7c-a622-09ffa45981be>
  a skos:Concept;
  skos:prefLabel "draaiorgels"@nl;
  skos:scopeNote "Het draaiorgel is een bescheiden pijporgel, verrijdbaar, dat geheel mechanisch wordt bediend. De partituren zijn in zogenaamde boeken geponst. Door het draaien aan een groot wiel wordt het mechanisme voor het inlezen van een boek en de windvoorziening in werking gesteld. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "draaiorgel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa9cda1e-c01d-431e-9f74-51d3073b97d5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/20902d66-bee7-4624-9a1e-47f72d5f75fd>
  a skos:Concept;
  skos:prefLabel "tape packs"@nl;
  skos:scopeNote "Het tape-pack is de gehele magnetische band die gelijkmatig is opgespoeld om een as, zoals de kern van een spoel. (Conservation Dictionary)"@nl;
  skos:altLabel "tape pack"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91712616-6dec-4871-8fdc-c317850c20d1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/20b1062a-2d63-4d1b-99eb-c90c4bf12e75>
  a skos:Concept;
  skos:prefLabel "ongewild wissen"@nl;
  skos:scopeNote "Ongewild wissen is het gedeeltelijk of geheel wissen van magnetische informatie op geluids- en beeldbanden veroorzaakt door onvoorziene magnetische velden, vooral tijdens opslag. Zie ook magnetische strooivelden."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/20e575dd-93a8-4a36-b501-db6cda23337b>
  a skos:Concept;
  skos:prefLabel "keperbinding"@nl;
  skos:scopeNote "Een keperbinding is een weeftechniek gebaseerd op een weefeenheid van drie of meer kettingen en drie of meer inslagen. Elke ketting loopt over twee of meer naast elkaar gelegen inslagen en vervolgens onder de volgende een of meer inslagen. Het resultaat is een satijnachtig uiterlijk met een vaag diagonaal patroon. Keperdoek werd in de 18e en 19e eeuw gebruikt als schilderdoek."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/20fd36cb-cb9a-427a-9ae4-4c6c095ef1a9>
  a skos:Concept;
  skos:prefLabel "schade door knaagdieren"@nl;
  skos:scopeNote "Schade door knaagdieren is de mechanische schade veroorzaakt door muizen of ratten. Knaagdieren knagen voor hun nest stukken uit voorwerpen en tevens vervuilen zij de voorwerpen met urine en fecaliën."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0e07bd39-012a-4958-90b8-ac9a877ea42e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/210b1f1e-eb95-45bc-9678-7554cd207d0b>
  a skos:Concept;
  skos:prefLabel "doubleren met lijmdotjes"@nl;
  skos:scopeNote "Doubleren met lijmdotjes (de nap bond methode) is een manier van hechten van het bedoekingslinnen aan het originele doek. De lijm wordt niet over het hele oppervlak verdeeld maar in kleine puntjes aangebracht door middel van een geperforeerde folie of een weefsel met gaten."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2112bfa0-8a6f-4f0e-bec8-e380cebc75ac>
  a skos:Concept;
  skos:prefLabel "synthetisch doek"@nl;
  skos:scopeNote "Synthetisch doek is doek gemaakt van synthetisch materiaal, bijvoorbeeld polyester."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2f811d65-8ae4-4dab-a818-0d6e0ed3e23a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/213495d5-301d-46ed-b9cc-0d48aaace40a>
  a skos:Concept;
  skos:prefLabel "losgeraakt"@nl;
  skos:scopeNote "Een deel van een voorwerp raakt los als het de verbinding ermee verliest."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/213b8f8a-1760-419a-a07c-635f02598a1d>
  a skos:Concept;
  skos:prefLabel "Ablebond 342-1"@nl;
  skos:scopeNote "Ablebond (342-1) is een tweecomponenten epoxyhars die vroeger werd gebruikt bij de conservering van ceramiek en glas. De harder is polyoxypropyleendiamine en de hars is een diglycidylether van bisfenol. Deze hars werd voor het eerst gemaakt in 1979, de productie werd in de late jaren ’80 gestaakt."@nl;
  skos:altLabel "Ablebond (342-1)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6d4b6aba-4df5-4895-9cab-9bdb979c5bd2>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/214239dd-2672-4b1c-a940-8fcc9c616e8b>
  a skos:Concept;
  skos:prefLabel "reageren"@nl;
  skos:scopeNote "Men reageert op een situatie door de handelingen uit te voeren die zijn gebaseerd op de beoordeling van de conserveringsbehoefte."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/190b9fce-fb0d-4b41-b46d-e1795ae38304>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2150b030-7dc5-4aab-ab49-9d7a5b229910>
  a skos:Concept;
  skos:prefLabel "netwerkmodificator"@nl;
  skos:scopeNote "Een netwerkmodificator, vloeimiddel, is een stof die gebruikt wordt om bij glas en glazuur de silicaatstructuur te veranderen teneinde de verwerkingstemperatuur en de smelttemperatuur te verlagen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/21565861-8809-423f-9bd0-de769791d5ef>
  a skos:Concept;
  skos:prefLabel "kloofbeitels"@nl;
  skos:scopeNote "Kloofbeitels zijn wigvormige ijzeren voorwerpen die het breedst zijn bij de enigszins gebogen snede. Ze worden bij het kloven van houtbollen met de hand op de bollen geplaatst en met een kloofhamer daarin gedreven."@nl;
  skos:altLabel "kliefbeitel"@nl, "kliefbeitels"@nl, "kloofbeitel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ceb91b0c-75e8-4063-a01d-eeb27e4e7941>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/21572cc8-56c9-4fc9-a32a-c5f786a0d249>
  a skos:Concept;
  skos:prefLabel "ultrasone reinigingsbaden"@nl;
  skos:scopeNote "Het behandelen van een voorwerp in een ultrasoon reinigingsbad houdt in dat men het in een vloeistof doet waarin ultrasone trillingen worden gegenereerd met frequenties boven 16.000 Hz. Een ultrasoon reinigingsbad is een apparaat dat voorwerpen reinigt die ondergedompeld zijn in een vloeistof die cavitatie vertoont door ultrasone trillingen. (Conservation Dictionary)"@nl;
  skos:altLabel "ultrasoon reinigingsbad"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/33f1944f-4045-46f2-a3b0-8283bdc5b328>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/215a2e53-e5c5-433b-9beb-d2f28c0a8e31>
  a skos:Concept;
  skos:prefLabel "vastzetten"@nl;
  skos:scopeNote "Het vastzetten van losse verf of deeltjes is het verlijmen ervan met de ondergrond."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/215f3d9e-96f3-4c96-aded-96e67dd61da2>
  a skos:Concept;
  skos:prefLabel "ontzetting"@nl;
  skos:scopeNote "Ontzetting is de beweging in een fundament door het bevriezen van aarde die verzadigd is met water. De uitzetting van het water kan leiden tot schade aan gebouwen en andere bouwwerken. Ontzetting is de volumevergroting van corroderend ijzerwerk dat is ingebed in metselwerk waardoor het metselwerk uit elkaar wordt geduwd."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2172cd9a-fd16-4852-a0b9-45b16d55609e>
  a skos:Concept;
  skos:prefLabel "verweerschriften"@nl;
  skos:scopeNote "Officieel stuk waarin je je verdedigt. (Encyclo.nl)"@nl;
  skos:altLabel "verweerschrift"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91712616-6dec-4871-8fdc-c317850c20d1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/218d8819-6571-4db5-9e9f-1f93e10edd93>
  a skos:Concept;
  skos:prefLabel "bedoeken"@nl;
  skos:scopeNote "Bedoeken is het plakken van een doek aan de achterkant van een doekschilderij, om het originele doek te verstevigen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/21bcc3ca-2234-4b7c-890e-45b56dec9177>
  a skos:Concept;
  skos:prefLabel "overbelichting"@nl;
  skos:scopeNote "Overbelichting treedt op wanneer de hoeveelheid licht waaraan een fotografisch materiaal is blootgesteld, de maximale hoeveelheid licht overschrijdt waarvoor het materiaal was gemaakt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/21c1afbb-6684-4268-862e-556196e353aa>
  a skos:Concept;
  skos:prefLabel "kanononderdelen"@nl;
  skos:scopeNote "Een kanon bestaat uit onderdelen als een of meerdere schietbuizen, een onderstel (affuit) en richtmiddelen. Een kanon is een vuurmond: het projectiel wordt afgeschoten door middel van kruit, dat wordt ontstoken."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ec60ecba-2a3d-450f-8e30-eee6efce8a41>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/3a301501-d3f8-414c-a4a1-fcbc87b8b391>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/21f32690-024e-4f26-9a53-3421a08e1d1b>
  a skos:Concept;
  skos:prefLabel "hydrofiel"@nl;
  skos:scopeNote "Een hydrofiel materiaal neemt gemakkelijk water op."@nl;
  skos:altLabel "hydrophiel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/21ff0b4c-9637-4d32-909c-b3da01a0b9c8>
  a skos:Concept;
  skos:prefLabel "bladmetaal"@nl;
  skos:scopeNote "Metaal, zo dun mogelijk geslagen of gewalst, te gebruiken voor vergulding of andere versieringsprocessen. (AAT-Ned)"@nl;
  skos:altLabel "metaalfolie"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b9fd0887-297b-4bab-bea5-cb288d068816>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/22055148-2adb-42ec-a601-9ab657200b97>
  a skos:Concept;
  skos:prefLabel "pentimento"@nl;
  skos:scopeNote "Pentimento is een verandering die door de kunstenaar in een kunstwerk wordt aangebracht tijdens de schepping. De verandering kan na jaren zichtbaar worden omdat de brekingsindex van de olie toeneemt en dichter bij die van loodwit komt. Licht kan dan beter door de verflaag dringen en de verborgen tekening of verf kan doorschijnen."@nl;
  skos:altLabel "pentiment"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/221a607b-083b-40fc-a0c8-72e3054359df>
  a skos:Concept;
  skos:prefLabel "vogelorgels"@nl;
  skos:scopeNote "Het vogelorgel is een instrument dat in de 18de eeuw zeer populair was. Het betrof eigenlijk een miniatuuruitvoering van een mechanisch orgel dat bijvoorbeeld gebruikt werd voor de tijdssignalen van doorgaans zeer decoratief uitgewerkte salonklokken. Dergelijke kleine orgels werkten met cilinders waarop kleine metalen pennen waren aangebracht het speel- en windsysteem systeem aanstuurden die doorgaans modieuze deuntjes lieten horen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "vogelorgel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa9cda1e-c01d-431e-9f74-51d3073b97d5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/223db7e4-dfb7-4d78-bef4-b0338a28a774>
  a skos:Concept;
  skos:prefLabel "natuurlijk cement"@nl;
  skos:scopeNote "Natuurlijk cement kan ontstaan uit in de natuur voorkomende stoffen die met water reageren."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5edf3ff6-8b94-4892-b1ce-af9a41d5a5b5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/22804e22-50e8-4e01-83d1-393962459d35>
  a skos:Concept;
  skos:prefLabel "aanvulling met verloop"@nl;
  skos:scopeNote "Een aanvulling met verloop is een stopsel in een verkeerde aangezette verbinding, zodanig dat het vulmateriaal van het oppervlak van het ene deel geleidelijk naar het oppervlak van het andere deel loopt. Het verloop is om een gelijkmatig aanzicht te krijgen en te verhinderen dat de fout te veel aandacht trekt. Een voorbeeld waarbij dit voorkomt, zijn barsten in vervormd porselein. Zie ook barsten."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4e5e557c-1faa-4594-b994-f1cbcd98dac7>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/22a5d18c-288c-4bdf-b3c4-7a2bfb9fa060>
  a skos:Concept;
  skos:prefLabel "onzuiverheid"@nl;
  skos:scopeNote "Onzuiverheid is de aanwezigheid van een hoeveelheid van een andere (ongewenste) stof in een materiaal."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f94da6b6-f1b8-4141-b4e8-316573793d59>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/22d200ad-2799-4887-9020-bd9cd76865f0>
  a skos:Concept;
  skos:prefLabel "stroopjacht"@nl;
  skos:scopeNote "Stroopjacht is een vorm van vangjacht bedreven door stropers. Stropen is een illegale vorm van jacht. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fe944ecb-9c86-4a8e-87e0-f196bac83383>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/230e72f9-c67f-47a4-8210-ca060b1f1a69>
  a skos:Concept;
  skos:prefLabel "coupé's (voertuig)"@nl;
  skos:scopeNote "Een coupé is een aan de achterzijde naar beneden aflopende sportieve carrosserievorm voor een auto waarbij het bestuurdersgedeelte/passagiersgedeelte slechts door 2 of 3 deuren te betreden is: twee deuren indien de coupé gemaakt is op de basis van een sedan, drie deuren als de coupé gebaseerd is op een hatchback. Een coupé met een inklapbaar stalen dak wordt Coupé Cabriolet genoemd. Heeft de auto de vorm van een coupé met 4 portieren, dan is het een 4-deurs coupé (cls)."@nl;
  skos:altLabel "coupé (voertuig)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dec3cb60-0105-49ac-a19f-d52c1f1ac5b4>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2319a4f1-ef6a-45c3-ad9c-e39db1929794>
  a skos:Concept;
  skos:prefLabel "treinverwarmingonderdelen"@nl;
  skos:scopeNote "Treinverwarmingonderdelen zijn alle delen van een treinverwarmingssysteem."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4e5a7ff7-bcbd-4a0a-98f0-93ebce4b951e>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/5cb3aefb-7e1b-43d5-ac3a-05b9c2214408>,
    <https://data.cultureelerfgoed.nl/term/id/cht/e13c7c0b-a6e9-4e61-a186-0517533a3c7c>,
    <https://data.cultureelerfgoed.nl/term/id/cht/f3b311fa-efbc-42ce-aae5-97150b2698b7>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/232a6741-9d53-4e1b-9e99-1db566b1031d>
  a skos:Concept;
  skos:prefLabel "boekblokken"@nl;
  skos:scopeNote "Een boekblok bestaat uit de genaaide katernen, vliegende bladen en schutbladen, zonder de band. Een boekblok bestaat uit de bedrukte of beschreven katernen van een boek zonder de toevoegingen die de binder eraan doet als de schutbladen, vliegende bladen en de platten. (Conservation Dictionary)"@nl;
  skos:altLabel "boekblok"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cf6bc0f3-9144-4847-8578-4e2227470cdd>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/235b2812-9525-4ef1-9b5c-039fcdc30506>
  a skos:Concept;
  skos:prefLabel "bodemkaarten"@nl;
  skos:scopeNote "Een bodemkaart is een kaart die informatie geeft over eigenschappen van de bodem. (Wikipedia)"@nl;
  skos:altLabel "bodemkaart"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7c99f9e1-2f0f-4367-abe4-f6d72120c233>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/235b6cc7-840c-4568-b988-32878b1f9cbe>
  a skos:Concept;
  skos:prefLabel "vervallen (staat)"@nl;
  skos:scopeNote "1. Een materiaal vervalt als het kleine stukjes verliest door chemische of fysische aantasting. 2. Een vervallen gebouw is een verlaten en verwaarloosd gebouw dat aanzienlijke reparatie en onderhoud behoeft. 3. Een voorwerp vervalt als zijn informatie-inhoud afneemt ten gevolge van achteruitgang van de conditie door biologische, chemische of mechanische invloeden."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/236cbe24-431c-426d-9a68-2ce5a550d943>
  a skos:Concept;
  skos:prefLabel "boogvullingen"@nl;
  skos:scopeNote "Boogvullingen zijn de gemodelleerde vormen die de ruimte tussen een rechthoekige lijst en een ovaal of rond schilderij opvullen. Ze werden vanaf de tweede helft van de 19de eeuw toegepast. (Conservation Dictionary)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/461d88c4-a46f-4dbb-a137-a9266eae7a42>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2375c6e7-027f-44e4-a32e-4f0f9f5a401e>
  a skos:Concept;
  skos:prefLabel "drukverdelers"@nl;
  skos:scopeNote "Een drukverdeler is een stuk stof met een open structuur dat wordt gebruikt bij het behandelen van schilderijen op een vacuümtafel. De stof vergemakkelijkt het gelijkmatig wegzuigen van de lucht om het vacuüm te bewerkstelligen. (Conservation Dictionary)"@nl;
  skos:altLabel "drukverdeler"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/23a2684c-007d-48ed-9848-376891513b28>
  a skos:Concept;
  skos:prefLabel "flanelsteek"@nl;
  skos:scopeNote "Een flanelsteek is een borduursteek die eruit ziet als een rij van X'en die elkaar boven en onder overlappen. De steek wordt gemaakt door onderaan een korte horizontale steek van rechts naar links te maken en de draad vervolgens diagonaal naar rechtsboven te brengen en een korte steek van rechts naar links te maken. De volgende steek wordt diagonaal rechtsonder de eerste steek gemaakt (opnieuw van rechts naar links). In de textielconservering wordt deze steek onder meer gebruikt om randen van een conserveringsstof of het textiele voorwerp op een steunlaag te naaien."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/23b630f5-32c7-478b-944a-71d4f11100b2>
  a skos:Concept;
  skos:prefLabel "echt antiekglas streakyglas"@nl;
  skos:scopeNote "Echt antiekglas Streakyglas is mondgeblazen glas dat beperkt onregelmatigheden bevat, die tijdens het blazen worden verkregen door bewerking van de cilinder in een halfronde mal. Beperkt aantal kleurencombinaties, het glas heeft meerdere kleuren in een glasplaat kan volgens klantspecificatie in kleur en structuur worden gemaakt. Toepassing: Voor speciale opdrachten, artistieke en creatieve opdrachten. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/32ba7c93-04d1-4b27-8dd3-99a0db677082>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/23bfd292-4f70-4f1a-a800-5260fa732749>
  a skos:Concept;
  skos:prefLabel "metaaldraadbevestiging"@nl;
  skos:scopeNote "De metaaldraadbevestiging van een herbarium specimen is het vastbinden van dat specimen op een herbariumblad met behulp van een roestvrije metaaldraad."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/23ea1e32-f407-4b46-96a0-5384396b0e89>
  a skos:Concept;
  skos:prefLabel "ventilatieglas"@nl;
  skos:scopeNote "Ventilatieglas is een plaat geperforeerd vlakglas, met tal van kleine, trechtervormige gaten. Deze zijn er in aangebracht door het glas uit te gieten en te walsen op een tafel met kegelvormige pinnen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/963156e3-7f49-4073-ab86-cea592518c26>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/242091de-5eee-440a-92df-6ad50dc964a1>
  a skos:Concept;
  skos:prefLabel "droogspanning"@nl;
  skos:scopeNote "Wanneer een materiaal water afstaat en krimpt, is de droogspanning de kracht die vervorming of andere mechanische schade veroorzaakt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/426a7b18-94a4-4e11-ba82-9b385065a1e6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2423b778-fd65-43bd-ae31-d084492c17e7>
  a skos:Concept;
  skos:prefLabel "zuigerpompen"@nl;
  skos:scopeNote "Een zuigerpomp is een pomp waarbij de te transporteren vloeistof of het te transporteren gas door middel van een zuiger wordt verplaatst. De meeste recente zuigerpompen bevatten twee of meer kleppen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/578c713f-ab52-4afd-8457-db217bac57a5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2430a26e-1071-4542-9d80-f78273f87d74>
  a skos:Concept;
  skos:prefLabel "machinerichting"@nl;
  skos:scopeNote "De machinerichting van een machinaal gemaakt papier is de richting waarin de vezels hoofdzakelijk liggen. Het is het gevolg van het feit dat vezels geneigd zijn zich hoofdzakelijk in de bewegingsrichting van de zeef te oriënteren."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/243d9e20-060b-49d1-a152-75c6599e65a3>
  a skos:Concept;
  skos:prefLabel "taxonomie"@nl;
  skos:scopeNote "Taxonomie is een systematische indeling in groepen, speciaal van planten en dieren, door hun overeenkomst te vergelijken."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f589af4f-1bdb-4f1f-93a7-ccc927da4917>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/24668255-7c40-480a-8d77-bc3ddf2a92e7>
  a skos:Concept;
  skos:prefLabel "luchtzuivering"@nl;
  skos:scopeNote "Luchtzuivering is het uitfilteren of absorberen van verontreinigingen uit een gebouw of een kast door lucht via leidingen langs installaties te voeren."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/190b9fce-fb0d-4b41-b46d-e1795ae38304>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/248d7e4f-3796-47b8-9564-300586d4ba50>
  a skos:Concept;
  skos:prefLabel "lithofilms"@nl;
  skos:scopeNote "Lithofilm is een contrastrijk filmmateriaal waarmee een bijzonder hoge optische dekking kan worden bereikt met behulp van een speciale ontwikkeltechniek. (Conservation Dictionary)"@nl;
  skos:altLabel "lijnfilm"@nl, "lithofilm"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/3481ebf6-767c-4b6a-8b20-b0a0152c60a6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2494f114-d868-438e-8024-fdf97a0b45ef>
  a skos:Concept;
  skos:prefLabel "penseelvoering"@nl;
  skos:scopeNote "De penseelvoering betreft de sporen van de penselen op het verfoppervlak. De aard van de penseelstreek behoort tot de expressie van de kunstenaar en kan helpen bij de herkenning van de maker van een stuk."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/47e05121-f2b9-4020-a461-97319b89bf5e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/24ddadf6-e61a-4513-ab80-fb0033c5d368>
  a skos:Concept;
  skos:prefLabel "inktvraat"@nl;
  skos:scopeNote "Inktvraat van papier is een schade die veroorzaakt wordt door ijzergallus-inkt. De inkt tast het papier op twee manieren aan: ten eerste door zure hydrolyse veroorzaakt door zwavelzuur aanwezig in de inkt en ten tweede door oxidatie van de vezels door katalytische afbraakreacties veroorzaakt door vrije tweewaardige ijzerionen in de inkt. De aangetaste delen worden donkerbruin en verliezen hun samenhang waardoor de delen met inkt verloren gaan."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/98b5139f-ec16-4fbb-8f24-d80fd2a767f5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/24f62aed-89ca-46d4-8206-1ad4336edd8b>
  a skos:Concept;
  skos:prefLabel "zijdeverzwaring"@nl;
  skos:scopeNote "Zijdeverzwaring is een veredelingstechniek waarbij gommen, suiker of minerale zouten aan de textiel worden toegevoegd om het verlies in gewicht en stijfheid ervan, veroorzaakt door het ontbasten van de zijdevezels, te compenseren. Deze behandeling werd soms ook toegepast op rayon."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/24fd22c9-c882-4a15-ba37-8628b7150367>
  a skos:Concept;
  skos:prefLabel "typografie (Amsterdamse School) "@nl;
  skos:scopeNote "De typografie van de Amsterdamse School is wat betreft de vormgeving verwant aan het lettertype van het tijdschrift Wendingen. De huisnummers en gevelopschriften zijn uitgevoerd in dit kenmerkende lettertype. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d64b1932-0c20-4d2a-b57e-685c2de359ae>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2502af09-635e-4890-afa2-ffff22b57958>
  a skos:Concept;
  skos:prefLabel "mengsel van harde was en lampenzwart"@nl;
  skos:scopeNote "Heel ball (een soort schoensmeer) is een mengsel van harde was en lampenzwart dat wordt gebruikt om een afwrijving op dun papier te maken van glaspanelen, bij de restauratie van glas in lood."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/25315669-0351-4ffd-8d09-a97fc8a01fc5>
  a skos:Concept;
  skos:prefLabel "barkermachines"@nl;
  skos:scopeNote "Het barkersysteem is genoemd naar de Engelse uitvinder die het systeem in de jaren 1830 in Parijs geperfectioneerd heeft. De pneumatische hefboom is een groot ventiel in de vorm van een balg die het mechaniek onderbreekt om ondersteuning te bieden aan de toetsentractuur. Dit systeem wordt in de eerste plaats geïnstalleerd op het manuaal van het hoofdwerk, van waaruit de andere klavieren door middel van een koppeling kunnen bespeeld worden. Het systeem kan bij grotere instrumenten ook aan de andere klavieren worden toegevoegd. Met de toets wordt een hefboom geopend die de toetsbeweging overneemt in de tractuur richting windladen daardoor zorgend voor een aanzienlijke verlichting van de toetsdruk. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "barkermachine"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cf51f60b-c1bb-4c17-b938-17e1dacb6e7c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2537e688-28aa-43a3-ba15-ebfd462196ad>
  a skos:Concept;
  skos:prefLabel "depositie (fysiek kenmerk)"@nl;
  skos:scopeNote "Depositie is de reactie van een verontreinigende stof met een oppervlak. Dit kan het oppervlak van een voorwerp zijn, of een bouwmateriaal of materiaal dat is aangebracht met het doel de verontreiniging gemakkelijk te kunnen verwijderen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/254abbeb-6c30-40bf-a299-f0a588981099>
  a skos:Concept;
  skos:prefLabel "schilderskarton"@nl;
  skos:scopeNote "Een schilderskarton is een karton of zwaar bordpapier dat is geprepareerd als ondergrond om op te schilderen. Het kan een bepaalde oppervlaktestructuur hebben."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7cd15f10-1ef4-42c7-abcf-be4c3c74eeb5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2570958c-adde-4a2b-a532-38f7b9a38f35>
  a skos:Concept;
  skos:prefLabel "losgeweven doek"@nl;
  skos:scopeNote "Losgeweven doek is een sterk katoenen of linnen weefsel met een open structuur."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/25d61a02-8b0b-4e13-bc58-261f4f0328d5>
  a skos:Concept;
  skos:prefLabel "brittannia-metaal"@nl;
  skos:scopeNote "Brittannia-metaal is een zilverkleurige legering van 80-90% tin met antimoon, koper, lood en/of zink. Deze legering werd in de late 18e eeuw ontwikkeld."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1b5373ef-5c88-44c9-9ce8-ba0dd67f56aa>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/25d8b814-edbb-4dbb-afe2-249aecbf08da>
  a skos:Concept;
  skos:prefLabel "beurtveren"@nl;
  skos:scopeNote "De hoeveelheid vracht en inventaris die een schip aan boord kan nemen tot het op zijn geladen lastlijn ligt."@nl;
  skos:altLabel "beurtveer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/46c9da30-a775-4c7a-8ce1-b030236816e6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/25f6da51-0055-4093-a92d-be202a56d334>
  a skos:Concept;
  skos:prefLabel "visgraatdessins"@nl;
  skos:scopeNote "Weven in visgraatdessin geeft een zigzagpatroon, als variatie op de keperbinding. Op deze wijze geweven doek werd vooral in de 15e en 16e eeuw in Venetië als drager voor schilderijen gebruikt. Visgraat geweven doek werd ook in Nederland gebruikt en in de 19e eeuw ook als bedoekingslinnen. (Conservation Dictionary)"@nl;
  skos:altLabel "visgraatdessin"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2616c588-c3ca-4c70-bd4c-8d90607ec653>
  a skos:Concept;
  skos:prefLabel "pick-up's (autotype)"@nl;
  skos:scopeNote "Een pick-up is een carrosserieuitvoering van een bestelwagen, waarbij de wagen bestaat uit een passagiers- en bestuurdersgedeelte, met daarachter een open laadbak. Er bestaan verschillende uitvoeringen, bijvoorbeeld met een enkele cabine, verlengde cabine (met passagiersstoelen bereikbaar via de bestuurdersdeur en passagiersdeur) of met een dubbele cabine. In het Afrikaans en Zuid-Afrikaans Engels staan pick-ups beter bekend als bakkie."@nl;
  skos:altLabel "Pickup truck"@nl, "pick-up (autotype)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dec3cb60-0105-49ac-a19f-d52c1f1ac5b4>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2617118c-41e6-4144-8c69-eec6d2da6192>
  a skos:Concept;
  skos:prefLabel "matte vernis"@nl;
  skos:scopeNote "Een matte vernis is een vernis die niet glanst."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6340ddd5-1366-423b-a501-88cfc45f8746>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/266a8e57-e5b0-4cdc-b9ff-6ee99dc99263>
  a skos:Concept;
  skos:prefLabel "kurkplaten"@nl;
  skos:scopeNote "Kurkplaten zijn platen vervaardigd van geperste kurk, die dienen als geluiddemping en om uit te vlakken. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "kurkplaat"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6472b16f-9d6c-4eb2-9114-b787005b715f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/266b3713-a873-4c95-b915-73c5532e1dc2>
  a skos:Concept;
  skos:prefLabel "glashelder"@nl;
  skos:scopeNote "Een glashelder materiaal is een materiaal dat geen kleur heeft en niet opaak is, zoals water. Glasheldere lijmen en gietmaterialen worden vooral bij de conservering van ceramiek en glas gebruikt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/26d8645b-f034-45ab-9bb4-43cb1de59f69>
  a skos:Concept;
  skos:prefLabel "knipsels"@nl;
  skos:scopeNote "Illustraties, pagina's, artikelen of kolommen tekst die uit boeken, kranten, dagbladen of andere gedrukte bronnen afkomstig zijn. (AAT-Ned)"@nl;
  skos:altLabel "knipsel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91712616-6dec-4871-8fdc-c317850c20d1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/26f10df0-8829-4330-8994-7911fa40dc6c>
  a skos:Concept;
  skos:prefLabel "Mowital"@nl;
  skos:scopeNote "Mowital is een polyvinylbutyral. Mowital is in de conservering op ruime schaal gebruikt als verstevigingsmiddel en als lijm."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fce84563-8f36-41ce-a0bb-7f6c03e83e8d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/27277c27-1fed-422c-a0fe-9d94105c257c>
  a skos:Concept;
  skos:prefLabel "oplossen"@nl;
  skos:scopeNote "In de scheikunde lost een oplosbare stof op in een vloeistof doordat de samenstellende moleculen of ionen zich van elkaar scheiden en zich door de vloeistof verdelen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/27321733-b8c6-449f-bfc1-cd8661f66ea0>
  a skos:Concept;
  skos:prefLabel "uitzettend kleimineraal"@nl;
  skos:scopeNote "Een uitzettend, zwellend kleimineraal is een ongebrande of bij lage temperatuur gebrande klei die water kan absorberen tussen de plaatvormige kristallen van de klei. De optredende uitzetting (zwelling) kan voorwerpen gemaakt van deze klei beschadigen evenals bouwsels die op een fundament van deze klei staan."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/541cf6bb-3273-4fa4-bcc8-8f579f552c03>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/273a411d-f00b-4fbb-87e7-56124e9daef0>
  a skos:Concept;
  skos:prefLabel "afwerklagen"@nl;
  skos:scopeNote "Een afwerklaag is de laatste decoratieve laag, bijvoorbeeld een vernislaag of een laklaag (Conservation Dictionary)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/623e7274-a6cb-4133-b9b4-83f0db8d4f01>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/273c5103-2ea1-4869-babe-c4936ce0f28c>
  a skos:Concept;
  skos:prefLabel "glas smelten"@nl;
  skos:scopeNote "Glas smelten is het maken van gesmolten glas door stukken breukglas en frit te smelten."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/273e8a83-cfba-4c48-b3e6-38e175c4f34b>
  a skos:Concept;
  skos:prefLabel "dauwpunt"@nl;
  skos:scopeNote "Het dauwpunt is de temperatuur waarbij tijdens het afkoelen van een volume lucht vloeibaar water condenseert."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/274641af-99b8-4932-b17f-bdd082cf2921>
  a skos:Concept;
  skos:prefLabel "zilverfolie"@nl;
  skos:scopeNote "Zilverfolie is zilver in de vorm van dunne blaadjes die worden gebruikt voor verzilvering. Na het aanbrengen van het zilverblad wordt het gevernist om aanlopen tegen te gaan."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/edfb1e84-1d31-4e7e-9fa5-f4e6aa5a88fa>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/274bef66-cd58-4451-bb4e-f22ec1d6d5c7>
  a skos:Concept;
  skos:prefLabel "smeedtangen"@nl;
  skos:scopeNote "Smeedtangen zijn twee-armige hefbomen waarmee een smid onderdelen kan vastknijpen voor bewerking. Ook zijn ze handig om in bewerking zijnde onderdelen uit het vuur te halen. Smeedtangen zijn in vele vormen en grootte, en met verschillende bekken in gebruik. Ze zijn onmisbaar in de werkplaats."@nl;
  skos:altLabel "smeedtang"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/275a879a-3b2d-486a-91bd-e9fe3fd660c7>
  a skos:Concept;
  skos:prefLabel "Desco da Parto"@nl;
  skos:scopeNote "Desco da Parto is een beschilderd rond of ovaal houten paneel dat in de middeleeuwen en de vroege Renaissance in Italië werd gebruikt bij het brengen van geschenken aan een vrouw die bevallen was. Tegenwoordig zijn ze ingelijst en worden ze getoond als paneelschilderingen. (Conservation Dictionary)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb6c285d-ac57-49cf-a14e-8b4fe22099c7>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/275c22fb-5327-463e-91d4-839d516d224f>
  a skos:Concept;
  skos:prefLabel "homopolymeer"@nl;
  skos:scopeNote "Een homopolymeer is een polymeer dat samengesteld is uit een enkel type monomeer."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/362a9c1d-41b3-46e0-bb2c-f3f3cfdc21b0>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/27692d7b-a39b-4066-9561-ca37b75f881f>
  a skos:Concept;
  skos:prefLabel "glas in beton"@nl;
  skos:scopeNote "In beton gevatte dikke stukken dalles de verre, die met hamer en beitel bewerkt zijn tot glasbrokken. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dcc2121b-8394-44f7-9664-86b109d079a4>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2782b73f-f164-4b89-b190-f72ee932c3d2>
  a skos:Concept;
  skos:prefLabel "jachtwet"@nl;
  skos:scopeNote "Pas in 1923 werd de eerste jachtwet ingevoerd. Deze wet diende de landbouwgewassen te beschermen. Wild kan immers grote schade toebrengen aan gewassen. Door de jaren heen is deze wet aangepast tot de huidige flora- en faunawet. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/11df50d9-d1f6-49d8-ae65-5218354674c7>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/27ac28e3-e69b-4bad-b25b-5ce0c67a4925>
  a skos:Concept;
  skos:prefLabel "zeemeerminnen"@nl;
  skos:scopeNote "Mythische wezens uit de zee, half vrouw, half vis. (AAT)"@nl;
  skos:altLabel "zeemeermin"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6ac25e81-feab-4f59-9601-58dec9ef02a8>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/27adfa00-9217-452d-8fb9-dcf497abfddb>
  a skos:Concept;
  skos:prefLabel "glasblazerssteen"@nl;
  skos:scopeNote "Een glasblazerssteen is een vlak oppervlak, oorspronkelijk van steen of marmer, later van ijzer, waarop de glaspost van gesmolten glas aan de blaaspijp in een cilindrische of bolle vorm kan worden gerold."@nl;
  skos:altLabel "werken op de glasblazerssteen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dcc2121b-8394-44f7-9664-86b109d079a4>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/27d6de18-705e-4974-a8fc-3ac388813d22>
  a skos:Concept;
  skos:prefLabel "onzichtbare retouche"@nl;
  skos:scopeNote "Een onzichtbare retouche wordt aangebracht als het de bedoeling is om een object als een visuele eenheid te kunnen bekijken. De retouche moet te ontdekken en reversibel zijn."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/27e5bb80-3e99-44f1-aaeb-e3af3a88cd66>
  a skos:Concept;
  skos:prefLabel "lutmalijsten"@nl;
  skos:scopeNote "Wordt gebruikt voor een bepaald soort vergulde lijst uit Nederland met gedetailleerde, reliëfachtige versieringen in '@Auricular' of naturalistische stijl, of beide. Ze zijn vernoemd naar de 17e-eeuwse zilversmid Johannes Lutma. (AAT)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f9ad90dc-6fc8-454a-9010-278cc1b0349f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/27e8134d-34ae-48f9-8298-257b83d57138>
  a skos:Concept;
  skos:prefLabel "schoonschuren"@nl;
  skos:scopeNote "Schoonschuren is een behandeling waarbij het oppervlak van een voorwerp voor een deel wordt gereinigd door schuren."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/27f18a43-a2aa-4b07-a601-e083756f1874>
  a skos:Concept;
  skos:prefLabel "wegvoertuigen"@nl;
  skos:scopeNote "De term voertuig wordt over het algemeen gebruikt voor vervoermiddelen die over land gaan. (Wikipedia)"@nl,
    "Objecten oorspronkelijk gemaakt om mensen of goederen op of langs wegen, paden, etc. te vervoeren. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "voertuigen"@nl, "voertuig"@nl, "wegvoertuig"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c55c9e1b-b4dd-469c-a2fa-98e049fdb9f3>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/0e8a6dfe-1280-4414-9a64-ca190bac648f>,
