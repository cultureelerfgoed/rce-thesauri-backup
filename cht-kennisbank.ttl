<https://data.cultureelerfgoed.nl/term/id/cht/902ae289-5fb4-4d9a-b50e-9c280146446e>
  a skos:Concept;
  skos:prefLabel "kijkgaten"@nl;
  skos:scopeNote "Spiegat, kleine opening in een muur om te kijken zonder zich bloot te stellen. (Haslinghuis)"@nl;
  skos:altLabel "kijkgat"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4e481c81-319a-44da-86bf-106f145d22c1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/048cac6b-0761-4e4d-96a4-ad9211a82b03>
  a skos:Concept;
  skos:prefLabel "landschapsparken"@nl;
  skos:scopeNote "Landschapsparken zijn parken aangelegd in de vroege of late landschapsstijl bij landgoederen of buitenplaatsen of als openbaar wandelpark. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "landschapspark"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c65f0763-e45f-4cb4-9ca5-73873027c67c>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/663afa70-cb9c-437b-adab-e13dae678f34>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f7c3a9f6-b3ab-4132-abdf-b782bc928009>
  a skos:Concept;
  skos:prefLabel "mast-, blok- en pompmakerijen"@nl;
  skos:scopeNote "Onafhankelijk bedrijf, danwel afdeling op een scheepswerf, waar diverse soorten pompen gemaakt worden. Vaak is de pompmakerij verenigd met de mast(en)- en blok(ken)makerij."@nl;
  skos:altLabel "mast-, blok- en pompmakerij"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a752382f-2254-4aba-b325-7d966c4c40f8>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d71c962f-db32-4dab-96a9-7c396740668a>
  a skos:Concept;
  skos:prefLabel "belichtingsregime"@nl;
  skos:scopeNote "De belichtingsduur bij verschillende verlichtingssterktes."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/929f2b49-e558-4543-a710-41a893c3c5dd>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6b59b3b8-501a-4eaa-b0f6-55e68dd59e48>
  a skos:Concept;
  skos:prefLabel "armen (taps)"@nl;
  skos:scopeNote "Arm hakken: zo behakken dat de steen achterwaarts taps toeloopt, zodat de voegen aan de zichtzijde zeer dun kunnen zijn. Arm schaven: het vlak maakt aan de ene zijde een scherpe hoek met het aanliggende vlak en aan de andere zijde een stompe hoek. Toegepast bij ramen en deuren, waarbij zo geschaafd wordt dat aan de zijde van de aanslagsponning de stompe hoek komt om bij het dichtslaan gemakkelijk in de sponning te sluiten. (Haslinghuis)"@nl;
  skos:altLabel "arm (taps)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/04770e4f-1c11-40e7-a256-9de8c6d569c6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/1f29d086-9198-4adb-83d3-fcb7b7a504e7>
  a skos:Concept;
  skos:prefLabel "kamstaarten"@nl;
  skos:scopeNote "Achter(onder)eind van de kam, met werkzijde onder de beet en drukzijde. Helemaal onderaan voorzien van een opening, het spiegat, waardoorheen een wig (de kamnagel) wordt geslagen. Zie ook kam, kamkop."@nl;
  skos:altLabel "kamstaart"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/04770e4f-1c11-40e7-a256-9de8c6d569c6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8eef7f07-4d48-4d7c-b7f3-4af12dff4db6>
  a skos:Concept;
  skos:prefLabel "duikplanken"@nl;
  skos:scopeNote "Duikplanken zijn toestellen aan de rand van zwembaden bedoeld om vanaf in het water te duiken of voor schoonspringen, bestaande uit een ladder of trap om omhoog te klimmen en een brede, horizontale 'plank' om vanaf te springen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "duikplank"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c05a0e3d-31bb-45e2-8f09-a5aacf56a9d9>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b3ac4b55-9458-4f88-8d9f-4634bec3e235>
  a skos:Concept;
  skos:prefLabel "subtractieve kleurenprocedés"@nl;
  skos:scopeNote "Fotografische procedés waarbij gebruik wordt gemaakt van cyaan, magenta en gele kleurenstoffen of inkt om een kleurenafdruk te maken. Elke kleurstof laat slechts twee van de drie hoofdkleuren door, terwijl de derde wordt tegengehouden. Een combinatie van twee kleurstoffen (op afzonderlijke filters) zal slechts één hoofdkleur doorlaten. (Project Fotografie)"@nl;
  skos:altLabel "subtractief kleurprocedé"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bf0d6dee-99b9-44e8-b61b-369ba2a50402>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/7941e72b-90ba-4dda-82e5-ad47fe1dcfa4>,
    <https://data.cultureelerfgoed.nl/term/id/cht/c3f3529e-047f-4c08-8514-5130d7fc5165>,
    <https://data.cultureelerfgoed.nl/term/id/cht/9c8f9c94-0ed0-4839-97d3-7404ca700d8e>,
    <https://data.cultureelerfgoed.nl/term/id/cht/29792ec5-287a-4bec-9669-0525fe90520c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8109f9b8-a3a5-4218-9a32-c16becd66e72>
  a skos:Concept;
  skos:prefLabel "collo-autotypieën"@nl;
  skos:scopeNote "Fotomechanische drukken, gepatenteerd door Wilhelm Cronenberg (Duits patentnr. 98203). Vanaf de lichtdrukplaat werd met behulp van autografische inkt een afdruk op geprepareerd autografisch papier gemaakt. Vervolgens werd deze overgezet op een metalen plaat, die werd geëtst tot er een hoogdrukvorm ontstond. (Project Fotografie)"@nl;
  skos:altLabel "collo-autotypie"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9a87affe-636f-4376-808f-abe9397e3f75>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/20cf473a-5f51-4190-a3c5-6b6fb3021af0>
  a skos:Concept;
  skos:prefLabel "trappalen"@nl;
  skos:scopeNote "Trappalen zijn hoofd- of beginbalusters. De eerste baluster onderaan de trap is doorgaans groter en rijker geornamenteerd dan de overige balusters."@nl;
  skos:altLabel "trappaal"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5c51c121-fc97-489c-a4d1-239254b94270>;
