    <https://data.cultureelerfgoed.nl/term/id/cht/dc095881-932f-4d4b-ac80-e5a482ed02f4>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c81a22c5-e49e-4cdc-a68f-0d4beb813b9a>
  a skos:Concept;
  skos:prefLabel "stoomtrams"@nl;
  skos:scopeNote "Een stoomtram is een tram die wordt voorbewogen door een stoomlocomotief. Na de opkomst van de spoorwegen vanaf halverwege de 19e eeuw werden alleen tussen de belangrijkste steden spoorlijnen aangelegd."@nl;
  skos:altLabel "stoomtram"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b12f2ba0-ea54-4e6a-b6ba-e5c01453e1d3>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c96ffdb5-765d-44b4-a219-d95bb98a98c3>
  a skos:Concept;
  skos:prefLabel "lichtgewichttreinen"@nl;
  skos:scopeNote "De nieuwste generatie lichte en goedkope treinstellen worden ook wel lichtgewichttrein of lighttrain genoemd. Een Belgisch voorbeeld zijn de Desiro-treinen die op het toekomstige GEN zouden moeten gaan rijden. Omdat dit in feite reguliere treinen zijn plaatst niet iedereen deze vervoersvorm onder de benaming lightrail."@nl;
  skos:altLabel "lichtgewichttrein"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a8ce193b-164e-4cc1-a6eb-d2397cef07ed>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/caea8444-5aaa-4dda-ae47-bb5d4db0638c>
  a skos:Concept;
  skos:prefLabel "bobbers"@nl;
  skos:scopeNote "Door de decennia heen zijn er verschillende stijlen van chopperbouw ontstaan. Een bekende stijl is de bobber. De bobber is een kale motor, van oorsprong ook weer een ex-US army Harley Davidson die voor de racerij werd gebruikt."@nl;
  skos:altLabel "bobber"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9ca79d0b-5dc1-447a-83c1-5facc6293e1e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/cb51b312-1556-4e3e-b870-a93bc96c0af8>
  a skos:Concept;
  skos:prefLabel "tankvliegtuigen"@nl;
  skos:scopeNote "Een tankvliegtuig is een vliegtuig waarmee andere vliegtuigen (vaak jachtvliegtuigen) in de lucht kunnen worden bijgetankt, waardoor deze minder starts en landingen hoeven te maken. Hierdoor vermindert de geluidsoverlast voor omwonenden van de vliegbasis en kunnen de vliegtuigen operationeel efficiënter worden ingezet."@nl;
  skos:altLabel "tankvliegtuig"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb7a4a3a-1dce-43ea-bfda-ef193155257e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/cb9a521a-2c27-4a56-8879-dc6084bb2176>
  a skos:Concept;
  skos:prefLabel "zijstandslocomotieven"@nl;
  skos:scopeNote "Bij een zijstandslocomotief is er een apart machinistenhuis gebouwd op de locomotief naast de ketel. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "zijstandslocomotief"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ba2a8dda-f500-418e-bbbf-a7c08f2cf7ee>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ce2f93e5-7f71-4110-bbab-9f0de9a758d9>
  a skos:Concept;
  skos:prefLabel "naked bikes"@nl;
  skos:scopeNote "Naked bikes zijn motorfietsen zonder stroomlijnkuip, die zijn afgeleid van sportmotoren die een dergelijke kuip wél hebben. Deze categorie is ook ontstaan door initiatieven van klanten die hun sportmotor zelf gingen 'uitkleden', vaak als goedkope oplossing voor schade die aan kuipdelen was ontstaan."@nl;
  skos:altLabel "naked bike"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9c0314a7-6954-4d9c-b981-a1864eacc3fb>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/cf3d6241-8d33-4fee-9ae3-33c9e5270359>
  a skos:Concept;
  skos:prefLabel "motortrams"@nl;
  skos:scopeNote "Een motortram is een tram die wordt voortbewogen door een verbrandingsmotor."@nl;
  skos:altLabel "motortram"@nl, "spoorauto"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b12f2ba0-ea54-4e6a-b6ba-e5c01453e1d3>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/cfc28785-c149-4d75-ac6a-d93f0088b4bf>
  a skos:Concept;
  skos:prefLabel "elektrische treinen"@nl;
  skos:scopeNote "Een elektrische trein wordt aangedreven door een of meerdere elektromotoren."@nl;
  skos:altLabel "elektrische trein"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/775f84d2-1450-4371-8354-63617b798c09>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d073757d-09e7-425e-9c13-c8111f7baa87>
  a skos:Concept;
  skos:prefLabel "trailmotorfietsen"@nl;
  skos:scopeNote "Het begrip trailmotor wordt vaak verward met de trialmotor, de naam is echter afgeleid van 'trail' (gebaand pad). De trailmotor echter is een offroad of allroad motorfiets. Deze laatste typen kwamen pas in de jaren zeventig in zwang. Tot die tijd werd vaak een wegmotor omgebouwd. De veerwegen werden dan iets verlengd, er kwamen semi-terreinbanden op en er werden verhoogde uitlaatpijpen (Swept back pipes) gemonteerd. De trailmotor werd ook wel Scrambler genoemd."@nl;
  skos:altLabel "trailmotorfiets"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/522f659d-6dc5-4b64-a244-1ea88701b7ea>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d2bf274d-aefd-4d88-b2f7-8991e3faa774>
  a skos:Concept;
  skos:prefLabel "elektrische trein tramstellen"@nl;
  skos:scopeNote "Een tramtrein is een benaming voor spoorvoertuigen die zowel gebruikmaken van trein- als tramsporen. Dit materieel heeft daarom treinbeheersing en kan rijden op de lage bovenleidingspanning voor trams en de hogere spanning voor treinen."@nl;
  skos:altLabel "elektrische trein tramstel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2aaaf3fd-e746-4262-81b1-e38db5dd033b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d39bc00a-0a31-4510-ba12-0fc802eb06ea>
  a skos:Concept;
  skos:prefLabel "vliegtuigen"@nl;
  skos:scopeNote "Een vliegtuig is een luchtvaartuig dat een hogere dichtheid heeft dan lucht en in staat is een gecontroleerde vlucht te maken. Het maakt hierbij gebruik van de opwaartse kracht, lift genoemd, veroorzaakt door de lucht die met een zekere snelheid over het speciale profiel van het vleugeloppervlak stroomt."@nl;
  skos:altLabel "kist (vliegtuig)"@nl, "vliegtuig"@nl;
