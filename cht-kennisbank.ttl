<https://data.cultureelerfgoed.nl/term/id/cht/104034e2-42c1-4aa4-b8e9-6b4961167234>
  a skos:Concept;
  skos:prefLabel "sepioliet"@nl;
  skos:scopeNote "Sepioliet is een mengsel van kleiachtige, gehydrateerde magnesiumsilicaten. Als gemalen poeder is sepioliet sterk absorberend. Het wordt gebruikt voor het maken van extractiemassa's."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/1040c581-3cbb-48c9-91b1-d529573bed98>
  a skos:Concept;
  skos:prefLabel "canvas"@nl;
  skos:scopeNote "Dichtgeweven stof in verschillende gewichten; wordt meestal gemaakt van vlas, hennep, jute of katoen en vooral gebruikt voor zeilen, dekkleden en stoffering en als ondergrond voor olieverfschilderijen. Het wordt ook gebruikt voor rasterachtig gaas dat van soortgelijke materialen is gemaakt en wordt gebruikt als ondergrond voor borduurwerk. (Zuiderzeemuseum)"@nl;
  skos:altLabel "kanvas"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/86d3631a-1f3f-4b51-bbbb-dadebc310ecc>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fe670aa5-0144-42c6-8026-28a88d5e4e25>
  a skos:Concept;
  skos:prefLabel "canon (belasting)"@nl;
  skos:scopeNote "Jaarlijkse heffing voor grond die in erfpacht is uitgegeven door de gemeente. (Encyclo.nl)"@nl;
