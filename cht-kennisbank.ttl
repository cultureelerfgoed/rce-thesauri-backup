<https://data.cultureelerfgoed.nl/term/id/cht/9f8ccf59-6231-4c7b-8b70-989852214619>
  a skos:Concept;
  skos:prefLabel "temperatuurmeter elementen"@nl;
  skos:scopeNote "Het temperatuur element is meestal in de cilinderkop gemonteerd. Dit element geeft via de temperatuurmeter de motortemperatuur aan. Hetzelfde principe geldt voor de olietemperatuur element."@nl;
  skos:altLabel "temperatuurmeter element"@nl, "temperatuurmeter zender"@nl, "themistor"@nl;
