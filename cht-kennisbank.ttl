<https://data.cultureelerfgoed.nl/term/id/cht/b876b8aa-2fa0-4fb9-a9f6-d8fe77b9f201>
  a skos:Concept;
  skos:prefLabel "schippersscholen"@nl;
  skos:scopeNote "Schippersscholen zijn scholen voor kinderen van schippers, met een onderwijsprogramma dat is afgestemd op het reizende bestaan van deze leerlingen."@nl;
