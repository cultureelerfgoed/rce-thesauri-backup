<https://data.cultureelerfgoed.nl/term/id/cht/a853acbf-461a-48f6-be80-32ac72a8c670>
  a skos:Concept;
  skos:prefLabel "portormarmer"@nl;
  skos:scopeNote "Een marmer uit Portovenere en het eiland Palmaria in het Italiaanse Ligurië. Portormarmer van de beste kwaliteit is donkerzwart met gelijkmatig verdeelde matte gouden aders, terwijl portormarmer van mindere kwaliteit bruinachtig grijs is met onregelmatige aders en matte gele vlekken. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a8ccbdf1-5888-495c-8b40-47fa8a55ef0f>
  a skos:Concept;
  skos:prefLabel "Texas marmer"@nl;
  skos:scopeNote "Een wit marmer met een ruwe structuur, dat bijna geheel uit calciumcarbonaat bestaat. Het werd gebruikt om de eerste 46 meter te bouwen van het Washington Monument in Washington D.C. Dit marmer wordt gedolven in Texas, Maryland, niet in de staat Texas. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/af0961ec-2e01-4798-bc06-0361f5995321>
  a skos:Concept;
  skos:prefLabel "fiore di Persico"@nl;
  skos:scopeNote "Bont geschakeerd marmer met verscheidene tinten rood, roze en paars op een witte grondmassa; werd in de oudheid voornamelijk gedolven bij Epirus in Turkije. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b5a4ccf4-c5e6-4b30-b557-9e4a59c71c23>
  a skos:Concept;
  skos:prefLabel "Winooski-marmer"@nl;
  skos:scopeNote "Een rood-bruin marmer, geschakeerd met wit dolomiet, gewonnen bij Winooski, Vermont. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b78e7cf0-a4f6-44a9-a864-351e199d4e8b>
  a skos:Concept;
  skos:prefLabel "grijs Napoleon-marmer"@nl;
  skos:scopeNote "Een hard en zeer kristallijn marmer uit Missouri dat veelvuldig wordt gebruikt voor binnen- en buitentoepassingen. Het heeft een grijsachtige kleur, een gesloten en gelijkmatige textuur en het glanst snel. De resten van crinoidea geven het een schetsachtig patroon. Dit zorgt voor de fraaie motieven die zichtbaar worden als het marmer overdwars wordt gesneden. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/bb28ec3a-62f8-4f38-b5c8-af94c7e65369>
  a skos:Concept;
  skos:prefLabel "Connemara-marmer"@nl;
  skos:scopeNote "Een grotendeels lichtgroen marmer met witte markeringen dat wordt gewonnen bij Clifden in County Galway in Ierland. De metamorfe dolomitische kalksteen wordt beschouwd als een van de twee echte marmersoorten van de Britse eilanden. De andere is Iona-marmer. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c4357e93-9fe9-43b7-820a-54b632dc2f98>
  a skos:Concept;
  skos:prefLabel "Vermont wit statuair marmer"@nl;
  skos:scopeNote "Een fijnkorrelig, wit marmer uit Vermont dat zeer wordt gewaardeerd door beeldhouwers. Dit marmer kan blauwachtig-grijze aderen of vlekken bevatten. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c856f711-1fc7-4253-a820-363a8f7464a5>
  a skos:Concept;
  skos:prefLabel "fiortomarmer"@nl;
  skos:scopeNote "Bont geschakeerd marmer in licht chocoladebruin en wit, afkomstig uit Italië. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c9c53e44-6c2d-4cae-96c6-0006a5e2d3cc>
  a skos:Concept;
  skos:prefLabel "brocatelle marmer"@nl;
  skos:scopeNote "Een matgeel, compact marmer met onregelmatige aderen en matte, terracottarode vlekken. Dit marmer bevat soms ook plekken met wit, kristallijnen calciet. Gevonden in Catalonië in Noord-Spanje en in Siena in Italië. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ce082bd4-d5bb-456a-8333-040dd73d8001>
  a skos:Concept;
  skos:prefLabel "rosé aurore"@nl;
  skos:scopeNote "Roze gevlamd marmer uit Portugal. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
