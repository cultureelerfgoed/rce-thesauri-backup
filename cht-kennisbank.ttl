<https://data.cultureelerfgoed.nl/term/id/cht/70b6b505-9323-4acd-a828-470c82fed2d3>
  a skos:Concept;
  skos:prefLabel "golf-punt rand"@nl;
  skos:scopeNote "Een golf-punt rand is een rand met afwisselende golvende en puntige vormen. Deze vorm creëert een dynamisch en decoratief profiel, vaak gebruikt in schalen, borden en ander servies."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ec63f655-7a67-49ee-ab0e-c5e1666aa051>;
