<https://data.cultureelerfgoed.nl/term/id/cht/850aa556-807a-4cdf-b928-9936a1422ee8>
  a skos:Concept;
  skos:prefLabel "scharnierpennen"@nl;
  skos:scopeNote "De lange pinnen die door de gewrichten van een scharnier worden gestoken om de twee helften van het scharnier bij elkaar te houden. (AAT-Ned)"@nl;
  skos:altLabel "scharnierpen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f6329b1a-dd46-40a7-93c9-2009f99af72b>;
