<https://data.cultureelerfgoed.nl/term/id/cht/8c360447-cb37-4c48-bcf3-dc665029d1ea>
  a skos:Concept;
  skos:prefLabel "slagdrempels"@nl;
  skos:scopeNote "Opstaande rand op de sluisdrempel of sluisvloer, waartegen de sluisdeuren sluiten. Men onderscheidt de onderslagdorpel en de bovenslagdorpel. De eerste is van de benedendeur, de tweede van de bovendeur."@nl;
  skos:altLabel "jokdorpel"@nl, "jokdorpels"@nl, "slagdrempel"@nl;
