<https://data.cultureelerfgoed.nl/term/id/cht/8d275d63-3ed4-4bc2-928c-dd70cb151dd3>
  a skos:Concept;
  skos:prefLabel "gebedsnoten"@nl;
  skos:scopeNote "Middeleeuws devotieobject voor de persoonlijke geloofsbeleving. Diep uitgesneden, houten object in de vorm van eennoot en open te klappen. Versierd met voorstellingen van heiligen, inscripties en ornamenten."@nl;
  skos:altLabel "gebedsnoot"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/abfc1bb7-04d7-43a0-9e99-dd4c5a4f2c15>;
