<https://data.cultureelerfgoed.nl/term/id/cht/29c441e3-6f0d-4ea7-959c-e12903243f16>
  a skos:Concept;
  skos:prefLabel "kofferdek"@nl;
  skos:scopeNote "Een kofferdek is een opbouw op het bovendek van een schip die aan beide boorden maar tot halverwege de breedte van het schip gaat."@nl;
  skos:altLabel "trunkdek"@nl;
