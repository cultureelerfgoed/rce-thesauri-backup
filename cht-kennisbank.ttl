<https://data.cultureelerfgoed.nl/term/id/cht/122b173d-f808-492e-812a-ecba461ac328>
  a skos:Concept;
  skos:prefLabel "bovenpannen"@nl;
  skos:scopeNote "Bovenpannen zijn machinaal vervaardigde dakpannen waarbij aan de bovenzijde geen sluitingsprofielen zijn aangebracht zodat de nokvorsten gladder op de pannen aansluiten."@nl;
  skos:altLabel "bovenpan"@nl;
