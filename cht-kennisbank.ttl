<https://data.cultureelerfgoed.nl/term/id/cht/09f32ab9-96e4-40f5-8e7b-ec505e437a6a>
  a skos:Concept;
  skos:prefLabel "grendelsloten"@nl;
  skos:scopeNote "Samenstel van opdekslot met grendel, waarbij de grendelbout (grendel) geborgd wordt d.m.v. een aan de bout bevestigde beugel die in de slotkast valt. (Haslinghuis)"@nl;
  skos:altLabel "grendelslot"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/650f5b55-5245-41cf-b3fb-67264363c775>;
