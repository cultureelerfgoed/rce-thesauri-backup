<https://data.cultureelerfgoed.nl/term/id/cht/6d251679-ec31-4f61-9eea-f8af3ab9eaf2>
  a skos:Concept;
  skos:prefLabel "filiformcorrosie"@nl;
  skos:scopeNote "Filiformcorrosie op metalen vertoont een kenmerkend lineair patroon. Het verschijnsel komt door verschil in snelheid warmee de lucht op verschillende plaatsen onder een laklaag of andere soort beschermlaag doordringt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6d29b704-fe05-4e35-968c-3aa4426e7ed6>
  a skos:Concept;
