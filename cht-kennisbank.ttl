<https://data.cultureelerfgoed.nl/term/id/cht/025bee43-43e4-4b3d-a70c-a7a598867547>
  a skos:Concept;
  skos:prefLabel "meiers"@nl;
  skos:scopeNote "Meiers zijn vertegenwoordigers of zaakwaarnemers van een eigenaar van een hof. De meier hield onder andere toezicht op de bewerking van de hoofdhof, ze inden de tinsen (vorm van belasting) en zorgden ervoor dat deze werden doorgezonden naar de hofeigenaar. De belangrijkste taak van de meier was het voorzitten van het hofgericht waar recht werd gesproken over kwesties aangaande de verhouding heer-horige. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "meier"@nl, "scholten"@nl, "schulten"@nl, "Villica"@nl, "Villicus"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db4a7619-d236-4b14-8e79-b4a6e890f677>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/644faf4f-50f0-4075-a953-92b282dde0e3>
  a skos:Concept;
  skos:prefLabel "stofhumus"@nl;
  skos:scopeNote "stofhumus zijn humusdeeltjes (organisch) kleiner dan 50mm. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/1b6e1f30-0fd6-4490-a81a-d66df715a307>
  a skos:Concept;
  skos:prefLabel "veenvorming"@nl;
  skos:scopeNote "Veenvorming, als verlandingsproces begint met rietgroei gevolgd door allerlei zeggesoorten. Met vermindering van de grondwaterinvloed komt een moerasbosvegetatie tot ontwikkeling. Veen ontstaat vervolgens uit een opeenstapeling van dode plantenresten. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/df4db7b4-3b69-49a2-9068-13034f1a068f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/af4c7372-c317-4225-8b42-a5a1af8c681e>
  a skos:Concept;
  skos:prefLabel "schaal van Beaufort"@nl;
  skos:scopeNote "De schaal van Beaufort wordt gebruikt om de snelheid van de wind aan te duiden. De schaal werd in 1805 opgesteld door de Ier Francis Beaufort. (Wikipedia)"@nl;
  skos:altLabel "windkracht"@nl, "windsnelheid"@nl, "windsterkte"@nl;
