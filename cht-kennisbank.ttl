  a skos:Concept;
  skos:prefLabel "ferrotypieën"@nl;
  skos:scopeNote "Varianten van het natte collodiumprocedé waarbij een direct positief beeld wordt gemaakt op een dun blad gelakt metaal. In het Engels 'ferrotype' of 'tintype' geheten, afgekort van 'tinplate', wat overeenkomt met het Nederlandse plaatstaal. (Project Fotografie)"@nl,
    "Een ferrotypie is een collodiumpositief op een zwarte metalen drager."@nl, "Foto's vervaardigd met het natte collodiumprocedé direct op gelakt metaal, meestal blik. (AAT-Ned)"@nl;
  skos:altLabel "ferrotypie"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b3f01e10-2f00-4ab3-99c9-97b06dc39a56>,
    <https://data.cultureelerfgoed.nl/term/id/cht/84ce9e66-39e7-427a-88f6-d2141a80228c>;
