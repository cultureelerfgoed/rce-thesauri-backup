<https://data.cultureelerfgoed.nl/term/id/cht/c6e13ba0-09b4-433d-83af-80949ed57300>
  a skos:Concept;
  skos:prefLabel "stuitblokken"@nl;
  skos:scopeNote "(oliemolen), blok hout waarop voor- of naslagblok lag."@nl;
