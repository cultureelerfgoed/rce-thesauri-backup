<https://data.cultureelerfgoed.nl/term/id/cht/738a143f-a529-4dc0-a74c-4b66b7174356>
  a skos:Concept;
  skos:prefLabel "jukstijlen"@nl;
  skos:scopeNote "Een jukstijl is een onderdeel van een jukspant. Het is een stijl van een standjuk. (Historische houtconstructies in Nederland / G. Behrends, 1996)"@nl;
