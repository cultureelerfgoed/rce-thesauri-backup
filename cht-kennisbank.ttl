<https://data.cultureelerfgoed.nl/term/id/cht/2e0472a1-fbe9-4c11-8090-b73ae65738eb>
  a skos:Concept;
  skos:prefLabel "theerozen"@nl;
  skos:scopeNote "Gekweekte roos (Rosa odorata). De theeroos werd in 1810 uit China ingevoerd en komt voor in gele en roodachtig gekleurde soorten. Zo genoemd omdat blad en bloem ruiken als fijngewreven vers blad van de thee. (MARDOC)"@nl;
  skos:altLabel "theeroos"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/78672fa4-8815-4427-995e-21a2cc90bd39>;
