<https://data.cultureelerfgoed.nl/term/id/cht/d61dcd2c-a8ba-43f2-b701-983c1042f61a>
  a skos:Concept;
  skos:prefLabel "sabelstukken"@nl;
  skos:scopeNote "Eerste klemstuk van de vang. Vangblok waaraan het sabelijzer hangt en trekt. Wordt aan de zijkant gestut door de lendestut."@nl;
