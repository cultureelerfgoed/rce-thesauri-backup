<https://data.cultureelerfgoed.nl/term/id/cht/fd440c88-5e17-4063-b87f-0af2a6f29071>
  a skos:Concept;
  skos:prefLabel "rioolgemalen"@nl;
  skos:scopeNote "Een rioolgemaal wordt gebruikt in een rioolstelsel om afvalwater naar een hoger peil te brengen of over langere afstand te transporteren."@nl;
