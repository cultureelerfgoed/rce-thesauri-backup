<https://data.cultureelerfgoed.nl/term/id/cht/ff55bd5e-f50d-40f0-bcee-c8ce65a75ac6>
  a skos:Concept;
  skos:prefLabel "pulvertorens"@nl;
  skos:scopeNote "Een pulvertoren was de plaats waar tot de 20e eeuw in steden de voorraad buskruit opgeslagen lag. (Wikipedia)"@nl;
  skos:altLabel "kruittoren"@nl, "kruittorens"@nl, "polvertoren"@nl, "polvertorens"@nl,
    "pulvertoren"@nl;
