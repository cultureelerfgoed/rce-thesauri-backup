<https://data.cultureelerfgoed.nl/term/id/cht/87924b13-84e1-4e6c-a919-99ca9485a456>
  a skos:Concept;
  skos:prefLabel "wolkenkrabbers"@nl;
  skos:scopeNote "Wolkenkrabbers zijn torenachtig gebouwen voor woon- en kantoordoeleinden. In New York ontstond deze hoogbouw door de zeer hoge grondprijzen en gebrek aan ruimte. Deze bouwwerken hebben meestal staalskeletten in verband met het eigen gewicht van de constructie."@nl;
  skos:altLabel "wolkenkrabber"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/577c35f2-3621-49dc-9db4-25331b8dbe0c>;
