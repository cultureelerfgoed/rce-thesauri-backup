<https://data.cultureelerfgoed.nl/term/id/cht/4781b4fb-4ba9-4aee-82b2-9d9a2caa658e>
  a skos:Concept;
  skos:prefLabel "parterres"@nl;
  skos:scopeNote "Parterres zijn toeschouwersruimten op de begane grond. Parterres zijn van oorsprong ingericht voor staanplaatsen. Vanaf de 17e eeuw is deze ruimte ook voor zitplaatsen bestemd. (Haslinghuis)"@nl;
  skos:altLabel "parterre"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/3ecd1894-dca1-4341-b534-1cef52f17ca5>;
