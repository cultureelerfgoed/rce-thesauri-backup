<https://data.cultureelerfgoed.nl/term/id/cht/60989b5e-2b0e-478a-8a9a-3366dcb8c344>
  a skos:Concept;
  skos:prefLabel "sneeuwkelders"@nl;
  skos:scopeNote "Sneeuwkelders zijn oude opslagplaatsen, geheel of deels in de grond, voor sneeuw dat voor de bereiding van voedsel wordt gebruikt. Tegelijkertijd dienen de opslagplaatsen als koelruimten. De kelders kunnen zijn voorzien van een gewelf. De bovenbouw bestaat uit een dak met stro. Stro wordt ook gebruikt als afdekking van de sneeuw. (IJskelders, koeltechnieken van weleer / A.W. Reinink en J.G. Vermeulen, Nieuwkoop 1981)"@nl;
  skos:altLabel "sneeuwkelder"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/176e2bc9-63ef-4998-aa5f-20af01e96640>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b30f64ff-63c2-4753-ae16-1687dc9b4f8d>
  a skos:Concept;
  skos:prefLabel "landarbeiderswoningen"@nl;
  skos:scopeNote "Landarbeiderswoningen zijn woningen bestemd voor landarbeiders. Veelal zijn het relatief kleine woningen bestaande uit één bouwlaag met kap."@nl;
  skos:altLabel "landarbeiderswoning"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a50c8c86-1884-468a-87aa-820867848c20>;
