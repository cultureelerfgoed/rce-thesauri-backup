<https://data.cultureelerfgoed.nl/term/id/cht/7bc39fe8-dc53-480e-a782-b4f5360b297b>
  a skos:Concept;
  skos:prefLabel "steenslag"@nl;
  skos:scopeNote "Kleine stukjes natuursteen, verkregen door vermorzeling van grote stukken. In het buitenland gebruikt voor het maken van beton, minder in Nederland. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/160dd0cb-52ec-4320-82a0-16cad8889f5d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/5af0fd9c-3082-48a8-a47f-41bb306e0e7f>
  a skos:Concept;
  skos:prefLabel "atletiekbanen"@nl;
  skos:scopeNote "Atletiekbanen zijn ovalen banen voor het bedrijven van atletiek, voornamelijk hardloopwedstrijden. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "atletiekbaan"@nl;
