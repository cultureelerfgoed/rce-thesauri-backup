  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/48d57558-3412-47b0-818f-52bcf225ae36>
  a skos:Concept;
  skos:prefLabel "kopieën (naar foto)"@nl;
  skos:scopeNote "Wordt gebruikt voor objecten die zijn afgeleid van of moeten lijken op originele, bestaande foto’s. Suggereert een minder precieze en getrouwe imitatie dan de term 'reproductie'. Gebruik de term 'vervalsing' wanneer het de opzet is om met de kopie personen te misleiden. (Project Fotografie)"@nl;
  skos:altLabel "kopie (naar foto)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91712616-6dec-4871-8fdc-c317850c20d1>;
