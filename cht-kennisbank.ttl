<https://data.cultureelerfgoed.nl/term/id/cht/4a19ccab-9bed-4fac-ab15-d60274ac11aa>
  a skos:Concept;
  skos:prefLabel "stroomlagen"@nl;
  skos:scopeNote "Rij van enigszins hellend op hun kant gestelde stenen. Wordt aangebracht als geen plaats genoeg is voor haaks metselverband, b.v. onder een balk of een boog. Ook decoratief op regelmatige afstanden, reeds in de Merovingische tijd. Ook boven rondboogfriezen in de romaanse periode in Lombardije. (Haslinghuis)"@nl;
  skos:altLabel "stroomlaag"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/528582f4-16e1-4b39-bfd0-6bdd4eb7fb33>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/cae48e77-a43c-48a5-a19c-975b646e1e48>
  a skos:Concept;
  skos:prefLabel "kernhout"@nl;
  skos:scopeNote "Hout uit de kern van een boom, dus niet het spinthout. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3e2f4684-af3e-4a15-aae4-e70aaebfae88>
  a skos:Concept;
  skos:prefLabel "Vlaamse schuurgroep"@nl;
  skos:scopeNote "De Vlaamse schuurgroep is een benaming voor een indeling in boerderijtypen die R.C. Hekker heeft gemaakt. In deze groep zijn de Vlaamse schuren ingedeeld, maar ook de West-Brabantse en Zuid-Hollandse boerderijen waar de Vlaamse schuur is geïntegreerd in de boerderij."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24681d2a-2f2d-40fe-8257-25a35525ae92>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/05a5680f-f189-4aad-af7c-dfc75f9f607f>
  a skos:Concept;
  skos:prefLabel "strijkspanten"@nl;
  skos:scopeNote "Kapgebint langs een gevel. (Haslinghuis)"@nl;
  skos:altLabel "strijkspant"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c4da8b07-9847-4269-86a6-8da0ab1923f5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/63f08d75-7f05-4ee4-9b97-b73bf01b96e6>
  a skos:Concept;
  skos:prefLabel "wantijen"@nl;
  skos:scopeNote "Het wantij is de plaats, gelegen tussen een eiland en de kust, waar tijdens vloed de beide getijstromen samenkomen die zich via de zeegaten aan weerszijden van het eiland naar het gebied tussen eiland en kust bewegen.(Wikipedia)"@nl;
  skos:altLabel "wantij"@nl, "wantyen"@nl, "wanty"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2971af0-cde7-4888-b828-33443f702e7d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6ca09805-cae6-484a-a477-3171acae7c50>
  a skos:Concept;
  skos:prefLabel "ontginningsboerderijen"@nl;
  skos:scopeNote "Ontginningsboerderijen zijn boerderijen die gebouwd zijn ten behoeve van of bij nieuw te werven land."@nl;
  skos:altLabel "ontginningsboerderij"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24681d2a-2f2d-40fe-8257-25a35525ae92>;
