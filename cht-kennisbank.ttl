<https://data.cultureelerfgoed.nl/term/id/cht/c1706edf-3c59-4ea9-b741-99149c266571>
  a skos:Concept;
  skos:prefLabel "Limburgse hoeves"@nl;
  skos:scopeNote "Limburgse hoeves zijn boerderijen die tot de dwarshuisgroep behoren. Ze komen voor in Midden- en Zuid-Limburg."@nl;
