  a skos:Concept;
  skos:prefLabel "tinellen"@nl;
  skos:scopeNote "Hal, grote zaal met estrade of podium in zuidelijke paleizen in de M.e. Dient als rechtszaal (Barcelona), ontvangzaal (Aragon) of eetzaal voor hofpersoneel (Avignon). (Haslinghuis)"@nl;
