<https://data.cultureelerfgoed.nl/term/id/cht/2ab9b3a3-3c19-4331-8158-6912d21c49e8>
  a skos:Concept;
  skos:prefLabel "profielstalen"@nl;
  skos:scopeNote "Balk van ijzer van een bijzondere doorsnede, vaak I-, H-, U- of T- of L-vormig. Ook: façonijzer. Te onderscheiden zijn meestal het lijf, en een of twee flensen. Reeds in gietijzer werden in XIX dergelijke balken gemaakt. De uitvinding van het walsprocedé door de Amerikaanse ingenieur Grey, dat het walsen van de profielvorm mogelijk maakte, dateert van 1901."@nl;
  skos:altLabel "profielijzer"@nl, "profielijzers"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/650ab4b1-e8ab-4c49-9195-8401d4a6cd6e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

