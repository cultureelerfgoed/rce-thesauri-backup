<https://data.cultureelerfgoed.nl/term/id/cht/cb1f6529-52fc-49f0-8502-9ec6bea8b851>
  a skos:Concept;
  skos:prefLabel "trappenhuizen"@nl;
  skos:scopeNote "Trappenhuizen zijn ruime gedeelten van gebouwen waarin de trappen zijn aangebracht. Ze zijn minder zelfstandig dan traptorens."@nl;
  skos:altLabel "trappenhuis"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b2331d07-8cfc-4ddb-ab21-ed760e7cbc9f>;
