<https://data.cultureelerfgoed.nl/term/id/cht/16e1e5da-1b19-4d3f-a100-e41aa2cc8e22>
  a skos:Concept;
  skos:prefLabel "verdiepte tuinen"@nl;
  skos:scopeNote "Verdiepte tuinen zijn tuindelen met een lagere ligging dan andere tuindelen, omgeven door een talud of keermuur en meestal via enkele traptreden toegankelijk. Door de lage ligging ontstaat een ruimtelijke afwisseling, een ander perspectief op de vaak bloemrijke beplanting. Veel toegepast in de Architectonische stijl. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "dieptetuin"@nl, "dieptetuinen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c2fcf3dc-6efd-4c88-afcf-287b680894ff>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/25b3e22a-db1a-4167-aa16-a35bb4d4832a>
  a skos:Concept;
  skos:prefLabel "brillen (persoonlijk voorwerp)"@nl;
  skos:scopeNote "Hulpmiddel ter verbetering van het gezichtsvermogen bestaande uit twee in een montuur gevatte lensglazen die men voor de ogen plaatst. (ABR)"@nl;
  skos:altLabel "bril (persoonlijk voorwerp)"@nl;
