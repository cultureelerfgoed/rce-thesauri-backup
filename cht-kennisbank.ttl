<https://data.cultureelerfgoed.nl/term/id/cht/7bcfd8b6-652d-4dd6-a499-43149a20a68e>
  a skos:Concept;
  skos:prefLabel "spoelkeukens"@nl;
  skos:scopeNote "Een vertrek aangebouwd aan de eigenlijke keuken dat voor afwas handelingen gebruikt wordt. (Wikiwoordenboek)"@nl;
  skos:altLabel "spoelkeuken"@nl;
