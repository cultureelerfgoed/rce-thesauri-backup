<https://data.cultureelerfgoed.nl/term/id/cht/dc4f6192-17fc-4641-b222-8bf37efa5717>
  a skos:Concept;
  skos:prefLabel "kepen (molen)"@nl;
  skos:scopeNote "De actie of het proces waarmee kepen worden gemaakt, dat wil zeggen groeven, inkepingen of kartelingen. Kepen wordt bijvoorbeeld gedaan bij timmerwerk, waar kepen worden aangebracht om balken met elkaar te verbinden.(AAT)"@nl;
  skos:altLabel "keep (molen)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/04770e4f-1c11-40e7-a256-9de8c6d569c6>;
