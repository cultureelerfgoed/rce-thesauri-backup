  a skos:Concept;
  skos:prefLabel "Rabat-tapijten"@nl;
  skos:scopeNote "Rabat-tapijten zijn handgeweven tapijten afkomstig uit de Marokkaanse stad Rabat. Deze tapijten staan bekend om hun levendige kleuren en geometrische ontwerpen, vaak gemaakt van wol. Ze weerspiegelen de rijke cultuur en tradities van Marokko."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0e27175e-cf3a-40cd-9c33-55d9127fa6fd>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/42a607c8-654f-4d82-bec5-3bd7e3929d49>
  a skos:Concept;
  skos:prefLabel "acanthus"@nl;
  skos:scopeNote "Gestileerd decoratief motief gebaseerd op de diepe zaagvormige en uitgeschulpte bladeren en gebogen stengels van de acanthus-plant (AAT)."@nl,
    "Het acanthusmotief is een veel toegepaste vormgeving binnen de bouwornamentiek. Zij is afgeleid van de bladvorm van de Acanthus, een doornachtige mediterrane plant met sierlijk krullende bladeren. Het acanthusornament is eeuwenlang met name toegepast op kapitelen. De Grieken gebruikten vooral de stekelige vorm, Acanthus spinosus terwijl de Romeinen de rondere Acanthus mollis als motief hanteerden. Het blad van deze planten vertoont enige gelijkenis met het blad van de distel, papaver en peterselie."@nl;
  skos:altLabel "acanthusblad"@nl, "acanthuskrul"@nl, "acanthuskrullen"@nl, "acanthussen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5db74efc-e56d-4ff9-b60c-5c3bd938226c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2398ac39-e350-4d69-9bb9-2c9957adc744>
  a skos:Concept;
