<https://data.cultureelerfgoed.nl/term/id/cht/e2ba2e84-9878-49ef-9b3f-a6a0c3d0a18f>
  a skos:Concept;
  skos:prefLabel "lavabokannen"@nl;
  skos:scopeNote "Schenkkan voor de liturgische handwassing door paus, kardinalen, bisschoppen, abten en andere prelaten. In sommige kerken ook door de pastoors gebruikt. Vormt veelal een stel met een lavaboschaal."@nl;
  skos:altLabel "lavabokan"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9d88ce85-dbad-4200-b1f3-22770f82795b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e3b7951e-6e4b-4275-a621-fb3ffe3de8f0>
  a skos:Concept;
  skos:prefLabel "prentenseries"@nl;
  skos:scopeNote "Een aantal prenten die onafscheidelijk bij elkaar horen door de voorstellingen en doorlopende teksten. (Religieus Erfgoedthesaurus)"@nl;
  skos:altLabel "prentenserie"@nl;
