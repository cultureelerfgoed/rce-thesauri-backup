<https://data.cultureelerfgoed.nl/term/id/cht/916e8327-ed9a-41c1-a732-cda175ff366c>
  a skos:Concept;
  skos:prefLabel "roestkleurige draden"@nl;
  skos:scopeNote "Roestkleurige draden: gebrek in de vorm van roestkleurige, onvolledig opgevulde draden, loodrecht of schuin op het leger, die gevuld zijn met pyriet en markasiet, dat gedeeltelijk is omgezet in limoniet."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/91dadd09-d1bf-45d4-80e8-ea99d6c53fb6>
  a skos:Concept;
  skos:prefLabel "leemlagen"@nl;
  skos:scopeNote "Leemlagen: bij natuurlijk gelaagde natuursteen min of meer evenwijdige lagen leem of lagen met een hoog leemgehalte."@nl;
  skos:altLabel "leemlaag"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
