<https://data.cultureelerfgoed.nl/term/id/cht/bcc5005f-b44d-453a-84f8-16c6afc82127>
  a skos:Concept;
  skos:prefLabel "goten (gereedschap)"@nl;
  skos:scopeNote "Gootvormige smalle ijzeren staaf, ca. 1,5 cm breed, met boven een houten of ijzeren kruk. Wordt door het oog van de naald gestoken. (Van aaks tot zwei / H. Janse)"@nl;
  skos:altLabel "goot (gereedschap)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
