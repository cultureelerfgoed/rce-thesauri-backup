<https://data.cultureelerfgoed.nl/term/id/cht/7c51f012-d1a9-44d6-ab76-4bc43db9a926>
  a skos:Concept;
  skos:prefLabel "vaandelhangers"@nl;
  skos:scopeNote "Horizontale stok, waaraan het vaandel aan banden is opgehangen. De vaandelhanger is bevestigd bovenaan de vaandelstok."@nl;
  skos:altLabel "vaandelhanger"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
