<https://data.cultureelerfgoed.nl/term/id/cht/6c476599-3212-4372-87b4-da79788176a2>
  a skos:Concept;
  skos:prefLabel "Ausluchten"@nl;
  skos:scopeNote "Uitbouwsel (XVI-XVII) aan woonhuizen in Noord- en West-Duitsland, een van de grond opgaande erker die nog vrij veel voorkomt in Bremen, Hamburg, Wolfenbüttel en Hildesheim. Enkele oude exemplaren waren in XIX in het oosten van Nederland nog over. (Haslinghuis)"@nl;
  skos:altLabel "Auslucht"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ffc206d4-2de0-4cf8-9b6f-28eea013c3ef>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/5a2c4cb7-8e58-4861-80c5-ac1ec1061fd7>
  a skos:Concept;
  skos:prefLabel "ijshutten"@nl;
  skos:scopeNote "IJshutten zijn geïsoleerde bovengrondse opslagplaatsen voor natuurijs. Vaak hebben ijshutten een beperkte opslagcapaciteit vergeleken met ijshuizen. IJshutten worden soms aangeduid met ijshuizen. (IJskelders, koeltechnieken van weleer / A.W. Reinink en J.G. Vermeulen, Nieuwkoop 1981)"@nl;
  skos:altLabel "ijshut"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ab37e8ae-9925-4009-a747-7abc4fd17415>;
