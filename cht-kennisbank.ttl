  a skos:Concept;
  skos:prefLabel "zwichten"@nl;
  skos:scopeNote "Verkleinen van het windvangende oppervlak van de wieken van een windmolen. Dat kan gebeuren met zeilen of d.m.v. jaloezieën, in het laatste geval meestal automatisch o.i.v. de windkracht. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
