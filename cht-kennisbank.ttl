<https://data.cultureelerfgoed.nl/term/id/cht/0e184433-0c52-4bd0-8b7f-64025684dfc1>
  a skos:Concept;
  skos:prefLabel "maalzolders"@nl;
  skos:scopeNote "De zolder waar het gemalen graan in zakken wordt opgevangen. Meestal bevindt het maalzolder zich op stellinghoogte. Onder het maalzolder bevinden zich de pelstenen, erboven de steenspillen, de dooieman, de korenharp en gortharp, de stuifpompen en de lichtstokken. Zie ook: steenzolder."@nl;
  skos:altLabel "maalzolder"@nl, "meelzolder"@nl, "meelzolders"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f0e4821c-e4ec-49cc-bdf5-66a206c63f69>;
