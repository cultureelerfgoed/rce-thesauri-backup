<https://data.cultureelerfgoed.nl/term/id/cht/5904b4e6-124b-410e-bc60-ba31d3c534e7>
  a skos:Concept;
  skos:prefLabel "hygrometers"@nl;
  skos:scopeNote "Een hygrometer is een instrument voor het meten van de relatieve vochtigheid in de lucht. (Conservation Dictionary)"@nl;
