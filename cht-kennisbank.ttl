<https://data.cultureelerfgoed.nl/term/id/cht/39a04318-fc19-4660-ae97-bf8d9db4cb99>
  a skos:Concept;
  skos:prefLabel "tonelen"@nl;
  skos:scopeNote "Tonelen zijn verhogingen waarop spelers, zangers, dansers voorstellingen geven. Het speelvlak is meestal rechthoekig of enigszins uitgebogen en in de toeschouwersruimte uitgebouwd. De toneelruimte is aan drie zijden omgeven door coulissen en het achterdoek. Aan de voorzijde kan het geopend worden door het wegschuiven of ophalen van een gordijn of scherm. (Haslinghuis)"@nl;
  skos:altLabel "podia"@nl, "podium"@nl, "podiums"@nl, "speelvlak"@nl, "speelvlakken"@nl,
    "toneel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/3ecd1894-dca1-4341-b534-1cef52f17ca5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/39a7d4de-f012-4c36-8832-a9a3accfea71>
  a skos:Concept;
  skos:prefLabel "vlechtbogen"@nl;
  skos:scopeNote "Elk van de elkaar kruisende bogen van een boogfries of een blinde arcade. (Haslinghuis)"@nl;
