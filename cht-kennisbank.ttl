<https://data.cultureelerfgoed.nl/term/id/cht/d5671866-f501-47e3-b733-b4ebccffdbb1>
  a skos:Concept;
  skos:prefLabel "harde zeep"@nl;
  skos:scopeNote "Hoofdklasse zeep; wordt vervaardigd uit olijfolie en natronloog. Algemeen type zeep, meestal wit of gevlekt. (AAT)"@nl;
