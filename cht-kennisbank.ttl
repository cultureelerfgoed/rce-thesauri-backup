  a skos:Concept;
  skos:prefLabel "maatselrie"@nl;
  skos:scopeNote "Het metselen van baksteen en natuursteen. maetselrie, maetselrienwerk: 1410 Westkapelle (W.V.). Ook: machelrie. (Haslinghuis)"@nl;
