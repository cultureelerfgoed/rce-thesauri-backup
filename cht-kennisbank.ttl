<https://data.cultureelerfgoed.nl/term/id/cht/8714a5b6-d489-4e79-890e-6525f174f2b8>
  a skos:Concept;
  skos:prefLabel "kolenwagens (mijnen)"@nl;
  skos:scopeNote "Kolenwagens werden gebruikt voor het vervoer van kolen of stenen. De kolenwagen heeft normaliter een inhoud van 1 ton."@nl;
  skos:altLabel "kolenwagen (mijnen)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/feb50453-4925-49d0-a20e-39d63bed2a0f>;
