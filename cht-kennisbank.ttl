<https://data.cultureelerfgoed.nl/term/id/cht/e892f3da-41b8-4197-9393-28e1737764ea>
  a skos:Concept;
  skos:prefLabel "rijtuigen"@nl;
  skos:scopeNote "Te gebruiken voor voertuigen met wielen die worden getrokken door paarden en vooral worden gebruikt om mensen op een comfortabele manier te vervoeren. (AAT-Ned)"@nl;
  skos:altLabel "bak (rijtuig)"@nl, "bakken (rijtuig)"@nl, "rijtuig"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/27f18a43-a2aa-4b07-a601-e083756f1874>;
