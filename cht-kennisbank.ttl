<https://data.cultureelerfgoed.nl/term/id/cht/447042af-92d9-495e-89ec-78d27f1622c0>
  a skos:Concept;
  skos:prefLabel "Babylonische uurlijnen"@nl;
  skos:scopeNote "Babylonische uurlijnen is een bepaalde tijdaanduiding op zonnewijzers. Bij deze tijdaanduiding worden de uren geteld vanaf zonsopgang: ‘’HOE LANGH DE ZON GESCHENEN HEEFT’’. (Zonnewijzers in Nederland / J.G. van Cittert-Eymers en M.J. Hagen, Zutphen 1984)"@nl;
  skos:altLabel "Babylonische uurlijn"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/681bcb79-12e4-42d8-8a44-1ade145bed3b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4485ef1f-ab8f-4e2d-9147-d6264b6c2da9>
  a skos:Concept;
  skos:prefLabel "bandrecorders"@nl;
  skos:scopeNote "Apparaten waarmee geluid wordt vastgelegd op en afgespeeld van een magneetband. (AAT-Ned)"@nl;
  skos:altLabel "bandrecorder"@nl;
