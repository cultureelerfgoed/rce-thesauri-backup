  skos:scopeNote "Pigsticking is een jachttechniek waarbij wordt gejaagd op everzwijn door ruiters te paard die proberen het wild te doden door gebruik te maken van een speer. (Hunting.be : The Home of Hunting)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fe944ecb-9c86-4a8e-87e0-f196bac83383>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/17ee4727-0c19-418e-b8e7-d79da548b92a>
  a skos:Concept;
  skos:prefLabel "blocketten"@nl;
  skos:scopeNote "Klein blokkeel aan voet van dakspoor. (Haslinghuis)"@nl;
  skos:altLabel "blocket"@nl;
