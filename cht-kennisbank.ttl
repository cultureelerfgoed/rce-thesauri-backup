<https://data.cultureelerfgoed.nl/term/id/cht/1c51f741-4619-4cd9-a4ef-b3cbb0dcb888>
  a skos:Concept;
  skos:prefLabel "motorraderboten"@nl;
  skos:scopeNote "Vaartuig, dat door een ronddraaiend scheprad aangedreven wordt. Het scheprad wordt aangedreven door een motor."@nl;
  skos:altLabel "motorraderboot"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/66ede133-a197-490d-ace9-214fcddd82ff>;
