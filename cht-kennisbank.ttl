<https://data.cultureelerfgoed.nl/term/id/cht/24e4e737-abd4-4b55-ade8-4e1de3a05dcd>
  a skos:Concept;
  skos:prefLabel "vinderslonen"@nl;
  skos:scopeNote "Vindersloon is de (mogelijke) beloning bij het vinden van een verloren voorwerp. Bij een koppeling van vinder en eigenaar van het voorwerp zal de rechtmatige eigenaar zijn eigendom terugkrijgen. Wettelijk gezien mag en kan de vinder een vindersloon van 10% van de economische waarde verlangen. Dat kan hij via de rechter opeisen."@nl;
  skos:altLabel "vindersloon"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f94da6b6-f1b8-4141-b4e8-316573793d59>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/84cfb6b4-957b-490e-966f-8cd668d89651>
  a skos:Concept;
  skos:prefLabel "botanische waarden"@nl;
  skos:scopeNote "Botanische waarde heeft betrekking op de waarde van alles wat behoort tot de plantkunde."@nl;
  skos:altLabel "botanisch belang"@nl, "botanische waarde"@nl;
