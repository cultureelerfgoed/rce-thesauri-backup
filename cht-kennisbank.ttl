<https://data.cultureelerfgoed.nl/term/id/cht/bd015525-4ad7-43e0-a546-f90ac94f6d3c>
  a skos:Concept;
  skos:prefLabel "wiggen"@nl;
  skos:scopeNote "klein stuk hout van scherp driehoekige doorsnede. Wordt gebruikt om een bouwdeel vast te zetten door de wig aan te drijven tussen twee delen. Ook b.v. om natuursteenwerk te stellen bij het bouwen. (Haslinghuis)"@nl;
  skos:altLabel "wig"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
