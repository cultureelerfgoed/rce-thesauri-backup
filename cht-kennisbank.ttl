<https://data.cultureelerfgoed.nl/term/id/cht/80f40e5b-e92e-4482-b63d-a432dcf863c2>
  a skos:Concept;
  skos:prefLabel "kraalschroten"@nl;
  skos:scopeNote "Planken met een ronding aan de rand, bijv. in de steenkuip."@nl, "Schroot, aan één zijde voorzien van een kraal. Vooral eind XIX en begin XX. (Haslinghuis)"@nl;
  skos:altLabel "kraalschroot"@nl;
