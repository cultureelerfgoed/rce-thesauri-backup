<https://data.cultureelerfgoed.nl/term/id/cht/6fd35627-6c7c-4740-88fe-84b3bde1dff1>
  a skos:Concept;
  skos:prefLabel "co-Italiaanse uurlijnen"@nl;
  skos:scopeNote "Co-Italiaanse uurlijnen is een bepaalde tijdaanduiding op zonnewijzers die samenhangt met de Italiaanse uurlijnen. Door de Italiaanse uren af te trekken van 24, krijgt men de tijdaanduiding tot zonsondergang: ‘’Hoe lanGH de Son noch Schinen Zal’’. (Zonnewijzers in Nederland / J.G. van Cittert-Eymers en M.J. Hagen, Zutphen 1984)"@nl;
  skos:altLabel "co-Italiaanse uurlijn"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/681bcb79-12e4-42d8-8a44-1ade145bed3b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6822ef95-5c5f-4770-a01e-041a00b9ad29>
  a skos:Concept;
  skos:prefLabel "voegers"@nl;
  skos:scopeNote "Voegers zijn vakmensen die voegen in metselwerk afwerken. Ze komen voor sinds de 18e eeuw. (Haslinghuis)"@nl;
  skos:altLabel "voeger"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db4a7619-d236-4b14-8e79-b4a6e890f677>;
