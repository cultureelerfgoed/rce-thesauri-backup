  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/faa9e72f-13f0-4128-9a83-4282644c8759>
  a skos:Concept;
  skos:prefLabel "kemenaden"@nl;
  skos:scopeNote "Kemenaden zijn verwarmbare woonvertrekken, in het bijzonder van de burchtvrouw, maar ook in stenen huizen. In middeleeuwen worden ook de verwarmde zalen in kloosters kemenaden genoemd. (Haslinghuis)"@nl;
