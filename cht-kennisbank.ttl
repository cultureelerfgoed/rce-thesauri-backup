<https://data.cultureelerfgoed.nl/term/id/cht/50815583-4b76-4aa8-8222-03cdbce5629c>
  a skos:Concept;
  skos:prefLabel "stofdorpels"@nl;
  skos:scopeNote "Houten onderdorpel van een binnendeurkozijn die daarmee constructief geen geheel vormt, drempel. (Haslinghuis)"@nl;
  skos:altLabel "stofdorpel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/821a12c5-d8e8-406e-968a-262eaa768828>;
