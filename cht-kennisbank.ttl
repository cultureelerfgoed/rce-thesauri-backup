<https://data.cultureelerfgoed.nl/term/id/cht/646bd685-469f-4fa5-8fe0-db64edda750c>
  a skos:Concept;
  skos:prefLabel "contékrijt"@nl;
  skos:scopeNote "Fabricated chalk' in de vorm van harde krijtjes die zijn gemaakt van een mengsel van grafiet en klei in de kleuren wit, donkerbruin, rood en drie soorten zwart. Worden gebruikt door kunstenaars. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a4f08240-778c-430c-9c85-028ca55bb632>;
