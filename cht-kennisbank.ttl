<https://data.cultureelerfgoed.nl/term/id/cht/ac0a1402-3e4b-45b9-82a3-f62bdb64033a>
  a skos:Concept;
  skos:prefLabel "inschilderen"@nl;
  skos:scopeNote "Inschilderen is het retoucheren van ontbrekende of beschadigde delen, bijvoorbeeld in een schilderij of op gepolychromeerd beeldhouwwerk."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/638b0d5f-5331-461c-89c9-8e607deaf32c>;
