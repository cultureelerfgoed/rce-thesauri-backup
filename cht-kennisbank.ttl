<https://data.cultureelerfgoed.nl/term/id/cht/d655b63b-6a4c-4fcb-a0ca-a78dab9c2028>
  a skos:Concept;
  skos:prefLabel "jukspanten"@nl;
  skos:scopeNote "Jukspanten zijn spanten met benen of stijlen die niet tot in de nok doorlopen. De benen of stijlen worden steeds verbonden door een horizontale balk. De gewone jukspanten of jukken zijn uitgevoerd met jukbenen, een jukbalk en schoren. (Historische houtconstructies in Nederland / G. Behrends, 1996)"@nl;
  skos:altLabel "juk"@nl, "jukken"@nl, "jukspant"@nl;
