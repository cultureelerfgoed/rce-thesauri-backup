<https://data.cultureelerfgoed.nl/term/id/cht/123cde46-f73f-4c5f-b614-5fe131ee65fd>
  a skos:Concept;
  skos:prefLabel "pannenlappen"@nl;
  skos:scopeNote "Een pannenlap bestaat uit een dik stuk stof en wordt gebruikt om een hete pan of ovenschalen mee op te tillen."@nl;
  skos:altLabel "pannenlap"@nl;
  skos:hiddenLabel "pannelappen"@nl, "pannelap"@nl;
