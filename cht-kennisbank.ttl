<https://data.cultureelerfgoed.nl/term/id/cht/72393de9-9189-4b5e-a2ea-679d2b77d46c>
  a skos:Concept;
  skos:prefLabel "slingerkogels"@nl;
  skos:scopeNote "Een slingerkogel is een ronde of citroenvormige kogel van gebakken klei. Een slingerkogel wordt met een slinger weggegooid en niet afgeschoten. Een slingerkogel is daarom geen kanonskogel of balistakogel. Slingerkogels komen voor vanaf IJZM tot in ROML. Behalve slingerkogels van gebakken klei komen ook exemplaren van metaal voor. (ABR)"@nl;
  skos:altLabel "slingerkogel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bcd5acd8-2625-4b6f-b01e-f80d8787b4da>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

