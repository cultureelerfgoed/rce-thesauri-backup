<https://data.cultureelerfgoed.nl/term/id/cht/abef9dd5-a8fe-49dc-a1ff-491776b5b4a2>
  a skos:Concept;
  skos:prefLabel "jachthuizen"@nl;
  skos:scopeNote "Jachthuizen zijn gebouwen waar jagers voor, tijdens of na de jacht bijeenkomen. Doorgaans bedoeld voor niet grote gezelschappen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "jachtgebouw"@nl, "jachtgebouwen"@nl, "jachthuis"@nl;
