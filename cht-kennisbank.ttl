<https://data.cultureelerfgoed.nl/term/id/cht/3ada38c9-b0b6-4a54-8572-90de77894f21>
  a skos:Concept;
  skos:prefLabel "sapperen"@nl;
  skos:scopeNote "Het graven van loopgraven waarbij de sappeurs zo veel mogelijk onder het maaiveld gedekt bleven. (Menno van Coehoorn)"@nl;
