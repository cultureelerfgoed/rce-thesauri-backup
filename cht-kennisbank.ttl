<https://data.cultureelerfgoed.nl/term/id/cht/66683303-fe18-41c4-9c04-f72098354284>
  a skos:Concept;
  skos:prefLabel "haspelkozijnen"@nl;
  skos:scopeNote "Twee lichtopeningen naast elkaar, tweelicht. De term schijnt in het bijz. (Haslinghuis)"@nl;
  skos:altLabel "haspelkozijn"@nl, "haspelraam"@nl, "haspelramen"@nl;
