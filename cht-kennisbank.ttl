<https://data.cultureelerfgoed.nl/term/id/cht/9f5ea9a7-d70d-46b2-9c8e-69cdcca47079>
  a skos:Concept;
  skos:prefLabel "scheiding"@nl;
  skos:scopeNote "De scheiding van activiteiten is het aanwijzen van zones voor verschillende functies die niet samengaan met de museale functies. Quarantaineruimtes en ruimtes waar wordt gegeten, moeten apart worden gehouden van de collectie."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/190b9fce-fb0d-4b41-b46d-e1795ae38304>;
