<https://data.cultureelerfgoed.nl/term/id/cht/2d44c6d8-80ea-47f5-b51c-7574ce55b116>
  a skos:Concept;
  skos:prefLabel "rails"@nl;
  skos:scopeNote "Gerolde stalen staven, gewoonlijk T-stukken, die zijn ontworpen om aan elkaar te worden gelegd, gewoonlijk in paren en in parallelle lijnen, om een oppervlak te creëren waar bepaalde vervoersmiddelen over kunnen rijden."@nl;
  skos:altLabel "rail"@nl, "spoorstaaf"@nl, "spoorstaven"@nl;
