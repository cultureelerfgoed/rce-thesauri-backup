<https://data.cultureelerfgoed.nl/term/id/cht/e41870c1-d57e-46d8-912f-5b207af7eb75>
  a skos:Concept;
  skos:prefLabel "deugdentellers"@nl;
  skos:scopeNote "Snoer met donker- en lichtgekleurde kralen, met aan het einde een kruisje, gedragen aan de riem van het habijt in sommige vrouwenkloosters. Dagelijks werden de donkere en lichte kralen naar het midden geschoven om respectievelijk de begane fouten en deugden te tellen. (Religieus Erfgoedthesaurus)"@nl;
  skos:altLabel "deugdenteller"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/45befda9-6eb8-4dc1-b9b2-3ee105611dee>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

