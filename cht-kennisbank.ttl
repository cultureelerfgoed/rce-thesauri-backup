<https://data.cultureelerfgoed.nl/term/id/cht/6a1b1ef7-9162-4603-8dad-aff721399edd>
  a skos:Concept;
  skos:prefLabel "volksprenten"@nl;
  skos:scopeNote "Prent, al dan niet met onderschrift, bedoeld voor een groot publiek, goedkoop en in grote hoeveelheden gemaakt. De eenvoudig te begrijpen boodschap was belangrijker dan de esthetische waarde."@nl;
  skos:altLabel "volksprent"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26b0d61a-e37a-4912-b516-48884f251bc6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6e7a349d-f34e-45d7-85e9-cc54701baf9d>
  a skos:Concept;
  skos:prefLabel "applicatieprenten"@nl;
  skos:scopeNote "Voorstelling op perkament of papier met oplegwerk van uitgeknipte stukjes stof."@nl;
  skos:altLabel "applicatieprent"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26b0d61a-e37a-4912-b516-48884f251bc6>;
