<https://data.cultureelerfgoed.nl/term/id/cht/a340143c-55aa-41c3-b546-2ef95014e8af>
  a skos:Concept;
  skos:prefLabel "schietwapens"@nl;
  skos:scopeNote "Een schietwapen is een soort gevechtswapen, dat gebruikt wordt om mensen, dieren of voorwerpen te verwonden/beschadigen of te doden. Het kan gebruikt worden als aanvals- of verdedigingsmiddel. Al sinds het begin van de menselijke geschiedenis hebben mensen wapens gebruikt voor de jacht, zelfverdediging en oorlogsvoering. Schietwapens zijn projectielwapens als slinger, pijl-en-boog, kruisboog, katapult, ballista, trebuchet, speer, werpspies en shuriken of vuurwapens als pistool, revolver, geweer, hagelgeweer en jachtgeweer."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9fc006f1-cd54-4303-88b7-84c9b8152990>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/f97cbb36-b567-45a7-b03e-a00517a207e7>,
    <https://data.cultureelerfgoed.nl/term/id/cht/c20fb44c-e7f4-44ee-9a54-8571159aa6aa>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/61288aa8-c44c-4640-abb0-2baac3d3ad4a>
  a skos:Concept;
