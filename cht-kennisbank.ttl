<https://data.cultureelerfgoed.nl/term/id/cht/4c9d4d44-0f3c-4424-a34c-02cd962571bb>
  a skos:Concept;
  skos:prefLabel "sociale werkplaatsen"@nl;
  skos:scopeNote "Plaatsen die werkervaring en beroepsomscholing aanbieden voor mensen die minder bevoorrecht zijn, hetzij door een lichamelijke handicap, hetzij door een gebrek aan ervaring of scholing. (AAT-Ned)"@nl;
  skos:altLabel "sociale werkplaats"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7a3fef04-32ad-4b47-9a65-8059b21a629c>;
