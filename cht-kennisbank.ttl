<https://data.cultureelerfgoed.nl/term/id/cht/0bcc28c2-61e5-48c7-954d-0b3bcc46a6f3>
  a skos:Concept;
  skos:prefLabel "gemeng"@nl;
  skos:scopeNote "Het gemeng is de verzameling van alle ingrediënten die zijn afgewogen en gemengd en die in de smeltpot worden gedaan om tot glas te worden gesmolten."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

