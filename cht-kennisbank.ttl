  a skos:Concept;
  skos:prefLabel "Oostenrijkse palen"@nl;
  skos:scopeNote "Oostenrijkse palen zijn grenspalen die dienden ter aanduiding van de grens tussen de Republiek der zeven provincien en de Oostenrijkse of Zuidelijke Nederlanden. Het gaat doorgaans om stenen palen. (Merkwaardige grenspalen en grensstenen / M.A. Aalbregtse, Oostburg 1974)"@nl;
  skos:altLabel "Oostenrijkse paal"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d0672d52-28d1-439e-9af1-9aa0a834b681>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

