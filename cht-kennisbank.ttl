<https://data.cultureelerfgoed.nl/term/id/cht/252a1ba8-e78f-46fe-a834-048a3a210da4>
  a skos:Concept;
  skos:prefLabel "Wijkers hout"@nl;
  skos:scopeNote "Wijkershout is hout dat afkomstig isuit de omgeving van ‘de Wijk van Revele’, Reval (tegnwoordig Tallin) in Estland aan de Finse Golf. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/25307a92-1ef0-4cf8-b0f4-c770538bcba9>
  a skos:Concept;
