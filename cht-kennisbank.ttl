<https://data.cultureelerfgoed.nl/term/id/cht/e9b26171-295c-4284-ae5d-64dc61ac05f6>
  a skos:Concept;
  skos:prefLabel "steengaas"@nl;
  skos:scopeNote "Gaas, bestaande uit draad van 1 mm dikte en mazen van 20 mm met kruisvormige opgeperste kleilichaampjes, ruitvormig in doorsnede. Het geheel wordt gebakken, zodat een gaas met terracotta kruisjes ontstaat. Het gaas werd in XXac gebruikt als onderlaag, tevens dragende constructie voor pleister- en stukadoorswerk. Werd geleverd in rollen van 1 m breedte en 5 m lengte. Ontwikkeld door P. Stauß en H. Ruff te Kottbus (D). (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4e481c81-319a-44da-86bf-106f145d22c1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/880fd617-ade2-400e-a07e-bbe2c6d61317>
  a skos:Concept;
  skos:prefLabel "museummolens"@nl;
  skos:scopeNote "Een molen ingericht om aan het publiek te tonen hoe de molen in vroeger tijden eruit zag en gebruikt werd. (Molenwoordenboek G.J. Pouw)"@nl;
  skos:altLabel "museummolen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0198a25a-3469-469e-8103-a613e32fcdc6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/41971e3c-4ce9-45bb-9dc6-c23aafe6f8b6>
  a skos:Concept;
  skos:prefLabel "stalinterieurs"@nl;
  skos:scopeNote "Stalinterieurs verwijzen naar de binnenruimtes van stallen, waarin vee werd gehuisvest, vaak ingericht met voederbakken, drinkvoorzieningen en strobedden."@nl;
  skos:altLabel "stalinterieur"@nl;
