  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/875fb46b-7567-41a5-bdea-c1f044294d36>
  a skos:Concept;
  skos:prefLabel "klant"@nl;
  skos:scopeNote "De persoon of groep die opdracht voor het werk heeft gegeven en die baat heeft bij de eindresultaten."@nl;
