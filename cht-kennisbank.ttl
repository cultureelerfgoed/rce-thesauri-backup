  a skos:Concept;
  skos:prefLabel "bakjes (roeischouw)"@nl;
  skos:scopeNote "West-Nederlandse term voor bepaalde roeischouwen. Men kent onder meer het bakje van de Bollenstreek en het Slotens bakje. (De Binnenvaart)"@nl;
  skos:altLabel "bakje (roeischouw)"@nl;
