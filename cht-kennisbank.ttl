<https://data.cultureelerfgoed.nl/term/id/cht/3fb11ea1-faee-4e1f-ad49-a65133bdb52c>
  a skos:Concept;
  skos:prefLabel "tandijzers"@nl;
  skos:scopeNote "Steenhouwersbeitel met tandjes op het snijvlak. Oorspr. zaten de tanden aan de beitel zelf, tegenwoordig wordt veelal een los tandstuk gebruikt. Overwegend gebruikt na het boucharderen en voor het scharreren van een vlak in niet te harde steen. (Haslinghuis)"@nl;
  skos:altLabel "gradeerijzer"@nl, "gradeerijzers"@nl, "gradine"@nl, "gradines"@nl,
    "tandijzer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ceb91b0c-75e8-4063-a01d-eeb27e4e7941>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3fb1aa4b-3aa8-4951-8421-64432e695f00>
  a skos:Concept;
  skos:prefLabel "mortelmolens"@nl;
  skos:scopeNote "Mechanisch aangedreven werktuig waarin grondstoffen worden gemengd tot mortel voor metsel- of stukadoorswerk. (Haslinghuis)"@nl;
