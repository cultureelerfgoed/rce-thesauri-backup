<https://data.cultureelerfgoed.nl/term/id/cht/a540da42-ec0a-4261-b6ce-8dc1cdebc028>
  a skos:Concept;
  skos:prefLabel "Philibertspanten"@nl;
  skos:scopeNote "Philibertspanten zijn kapspanten waarbij de benen gebogen zijn. De benen zijn samengesteld uit twee of drie lagen tegen elkaar gespijkerde planken. De spanten worden genoemd naar de uitvinder ervan, Fransman Philibert de l'Orme (1512-1570). (Historische houtconstructies in Nederland / G. Behrends, 1996)"@nl;
  skos:altLabel "Philibertspant"@nl, "schenkelspant"@nl, "schenkelspanten"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c4da8b07-9847-4269-86a6-8da0ab1923f5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a741a708-a8c4-436b-b55a-264cd25dcf0a>
  a skos:Concept;
  skos:prefLabel "tussenbalkjukken"@nl;
  skos:scopeNote "Tussenbalkjukken zijn gewone jukspanten waarbij de jukbalk is uitgevoerd als een tussenbalk."@nl;
