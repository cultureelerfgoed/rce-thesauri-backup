<https://data.cultureelerfgoed.nl/term/id/cht/801a0134-75b7-4075-9250-45a4d15a82cc>
  a skos:Concept;
  skos:prefLabel "kwadraturen"@nl;
  skos:scopeNote "Verhoudingsstelsel, verkregen door een reeks vierkanten, telkens ingeschreven in een groter vierkant, door de middens van de zijden van het grotere vierkant te verbinden. Werd o.a. in de M.e. gebruikt om plattegronden te ontwikkelen, maar ook voor ornamenten en pinakels. Het stelsel is gebaseerd op ÷2, 1:1,414, ruim 54°. (Haslinghuis)"@nl;
  skos:altLabel "kwadratuur"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/929f2b49-e558-4543-a710-41a893c3c5dd>;
