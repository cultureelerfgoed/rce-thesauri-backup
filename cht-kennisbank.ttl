<https://data.cultureelerfgoed.nl/term/id/cht/a615013d-ce8b-421b-bfe7-f60f63270f2f>
  a skos:Concept;
  skos:prefLabel "olievernis"@nl;
  skos:scopeNote "Een olievernis is een mengsel van een harde natuurlijke hars en drogende olie; olievernis is vaak slecht oplosbaar."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6340ddd5-1366-423b-a501-88cfc45f8746>;
