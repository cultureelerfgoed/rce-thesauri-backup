<https://data.cultureelerfgoed.nl/term/id/cht/680c44a0-4b27-43a9-9255-c18fd46b24fb>
  a skos:Concept;
  skos:prefLabel "toiletspiegels"@nl;
  skos:scopeNote "Kleine, vrijstaande spiegels, meestal in een rechtopstaande omlijsting waarbinnen de spiegel kan worden versteld. Ze zijn bedoeld voor gebruik op de toilettafel en hebben soms een doosachtig onderstuk met kleine laatjes. (AAT-Ned)"@nl;
  skos:altLabel "toiletspiegel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dcaddd09-099f-4dcd-81d0-171e7a0d42bd>;
