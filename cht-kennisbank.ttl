<https://data.cultureelerfgoed.nl/term/id/cht/26aea2a6-c49c-4fbd-b6bc-0a3112b9ed79>
  a skos:Concept;
  skos:prefLabel "wegafsluitingen"@nl;
  skos:scopeNote "Een fysieke permanente of tijdelijke barrière in of dwars over een weg voor tenminste een gedeelte van de gebruikers van die weg. (b.v paaltjes, slagboom, toegangshek, etc.)"@nl;
  skos:altLabel "wegafsluiting"@nl;
