<https://data.cultureelerfgoed.nl/term/id/cht/620da555-710e-4ebb-a21b-427dda547ac4>
  a skos:Concept;
  skos:prefLabel "hardpaste"@nl;
  skos:scopeNote "Hardpaste is een type keramiek, ook wel bekend als \"echte porselein,\" dat wordt gekenmerkt door zijn harde, glasachtige structuur. Het wordt geproduceerd door het bakken van een mengsel van kaolien, veldspaat en kwarts bij hoge temperaturen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/352b0f41-2397-4608-bf6b-28bacaf1e999>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/878081f3-9bb0-4a8a-a563-3626ed68750d>
  a skos:Concept;
  skos:prefLabel "softpaste"@nl;
  skos:scopeNote "Softpaste is een type keramiek dat zachter en poreuzer is dan hardpaste. Het wordt gebakken bij lagere temperaturen en bevat vaak extra ingrediënten zoals krijt of beenas, waardoor het gemakkelijker te bewerken is maar minder duurzaam."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/239b6e00-5ce9-49a1-aba9-ff0c01bdb3d3>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8ac91fad-bb85-4ae3-bead-1310a06cda53>
  a skos:Concept;
  skos:prefLabel "eierschaalporselein"@nl;
  skos:scopeNote "Eierschaalporselein is zeer dun, kwetsbaar porselein van Chinese origine. (Wikipedia)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/239b6e00-5ce9-49a1-aba9-ff0c01bdb3d3>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8c8cb118-6a9a-43dc-a494-6bab5e31cca1>
  a skos:Concept;
  skos:prefLabel "plateel"@nl;
  skos:scopeNote "Plateel is een vorm van geglazuurd aardewerk, vaak kunstzinnig beschilderd, dat zijn oorsprong vindt in Nederland. Het werd populair in de 19e en 20e eeuw en omvat vaak decoratieve motieven op een witte ondergrond."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/239b6e00-5ce9-49a1-aba9-ff0c01bdb3d3>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d5761e0d-02c1-449c-be60-fe1845486a0a>
  a skos:Concept;
  skos:prefLabel "creamware"@nl;
