<https://data.cultureelerfgoed.nl/term/id/cht/24f41ced-e67d-45d7-b795-1f2b84def482>
  a skos:Concept;
  skos:prefLabel "hielingen"@nl;
  skos:scopeNote "Onderste gedeelte van de mast."@nl;
  skos:altLabel "hieling"@nl, "masthielingen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/77f91bd1-4367-448a-903c-da826fa40e88>;
