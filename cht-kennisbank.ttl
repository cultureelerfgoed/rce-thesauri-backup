<https://data.cultureelerfgoed.nl/term/id/cht/fc520dff-24d7-44b9-8d41-9e4a42c778d2>
  a skos:Concept;
  skos:prefLabel "wachttorens"@nl;
  skos:scopeNote "Wachttorens zijn torens die bedoeld zijn voor bewaking of verdediging, vaak onderdeel van een fort of stadsmuur, en bieden een strategisch overzicht over het omliggende gebied."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2ffb2c5-397c-47c9-bdb8-a655cd21326d>;
