  a skos:Concept;
  skos:prefLabel "randmerken"@nl;
  skos:scopeNote "Randmerken zijn geschreven of grafische codes van de fabrikant, die buiten het beeldgedeelte van rolfilm zijn inbelicht en die het filmtype aangeven. (Conservation Dictionary)"@nl;
