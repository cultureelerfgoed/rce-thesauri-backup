  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bbe4a82c-d0af-42c9-86c2-cca2e9560bac>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d3ad3ab8-7ed4-4f9c-b9da-10fda1215f83>
  a skos:Concept;
  skos:prefLabel "Leca-steen"@nl;
  skos:scopeNote "Leca-stenen zijn gebakken poreuze bakstenen. Leca staat voor: Light Expanded Clay Aggregate. Deze werden te Nijmegen geproduceerd en verkocht onder de naam Pora-blocs voor het opmetselen van binnenmuren. De poreuze structuur is lichter en biedt verbeterde warmte- en geluidsisolatie."@nl;
  skos:altLabel "Pora-bloc"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bbe4a82c-d0af-42c9-86c2-cca2e9560bac>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a36ddb76-354a-4460-a8de-37e0ac253607>
  a skos:Concept;
  skos:prefLabel "koffieroom"@nl;
  skos:scopeNote "Koffieroom of schenkroom is gehomogeniseerde, gesteriliseerde room bestemd voor gebruik in de drank koffie. (Wikipedia)"@nl;
  skos:altLabel "schenkroom"@nl, "schenkroom "@nl;
