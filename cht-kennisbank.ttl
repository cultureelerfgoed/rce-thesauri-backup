  a skos:Concept;
  skos:prefLabel "verontreinigende stof"@nl;
  skos:scopeNote "Een verontreinigende stof vervuilt de normale, schone omgeving. Het kan een gas, vloeistof of vaste stof zijn. Sommige stoffen zijn schadelijk voor historische materialen, andere voor mensen en weer andere voor het milieu."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
