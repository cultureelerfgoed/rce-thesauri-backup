<https://data.cultureelerfgoed.nl/term/id/cht/2e9a7f60-748c-4934-a1c2-75679702ec3c>
  a skos:Concept;
  skos:prefLabel "urnengraven"@nl;
  skos:scopeNote "Urnengraven zijn kleine plaatsen van hooguit 60 bij 60 centimeter waarin één tot vier urnen kunnen worden bijgezet. Urnengraven worden afgedekt met kleine toepasselijke monumenten, waar de urn in sommige gevallen deel van kan uitmaken. Urnengraven liggen vaak in een urnentuin. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "urnengraf"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d6eef960-5cb5-4dd5-b68d-cc1929ed20c0>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/20cf6ecc-0c83-44af-b675-7baac021c57a>
  a skos:Concept;
  skos:prefLabel "bronnen (water)"@nl;
  skos:scopeNote "Een plek waar stromend grondwater zich concentreert en (periodiek) aan de oppervlakte komt."@nl,
    "Plaats waar op natuurlijke wijze water uit de grond opwelt."@nl;
  skos:altLabel "bron (water)"@nl, "wellen (water)"@nl, "wel (water)"@nl;
