<https://data.cultureelerfgoed.nl/term/id/cht/a625d33a-9525-4529-b390-3f83274a9072>
  a skos:Concept;
  skos:prefLabel "shortblocks"@nl;
  skos:scopeNote "Gerevideerd of nieuw cilinderblok compleet met zuigers, drijfstangen, krukas, lagers, nokkenas enz., maar zonder cilinderkop en accessoires."@nl;
  skos:altLabel "shortblock"@nl;
