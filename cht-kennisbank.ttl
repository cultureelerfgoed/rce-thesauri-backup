<https://data.cultureelerfgoed.nl/term/id/cht/b00ffba3-ad38-46df-9535-bd24431a1e6b>
  a skos:Concept;
  skos:prefLabel "steltenbergen"@nl;
  skos:scopeNote "Steltenbergen zijn kapbergen met een verhoogde tasvloer. Wanneer de tasvloer hoog genoeg ligt kan de ruimte eronder worden gebruikt als opslagruimte. In Oost-Nederland wordt steltenberg ook wel als synoniem voor schuurberg gebruikt. (Hooibergen in Nederland / Jurgens, Suzan, Marten Jansen en Wim Lanphen, Kampen: IJsselacademie, 2008)"@nl;
  skos:altLabel "kaaiberg"@nl, "kaaibergen"@nl, "steltenberg"@nl, "tasberg"@nl, "tasbergen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/164e269e-aa56-45c7-af51-eb178d29ab1c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

