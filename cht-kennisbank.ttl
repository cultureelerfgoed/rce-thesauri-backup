  a skos:Concept;
  skos:prefLabel "horsten"@nl;
  skos:scopeNote "Een horst is een geologisch gedeelte dat na een aardbeving, een afschuiving of een opheffing van de druk onder de gedeelten van land omhoog is gekomen"@nl;
