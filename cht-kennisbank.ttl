<https://data.cultureelerfgoed.nl/term/id/cht/09d51f17-5974-4297-a292-28c1877cc802>
  a skos:Concept;
  skos:prefLabel "mentors"@nl;
  skos:scopeNote "Een mentor is een in een bepaald beroep ervaren leidsman, die volgens bepaalde afspraken iemand met minder ervaring onder zijn hoede neemt."@nl;
  skos:altLabel "mentor"@nl;
