<https://data.cultureelerfgoed.nl/term/id/cht/0ea57f9d-c787-4d01-b6ac-54c460cf552b>
  a skos:Concept;
  skos:prefLabel "wensputten"@nl;
  skos:scopeNote "Wensputten zijn putten waarin men een geldstuk werpt, waarna men een wens kan doen. Doorgaans gaat het om putten die buiten werking zijn gesteld."@nl;
  skos:altLabel "wensput"@nl;
