  a skos:Concept;
  skos:prefLabel "waagonderdelen"@nl;
  skos:scopeNote "De waag is een meetinstrument waarmee het gewicht kan worden bepaald. Alle onderdelen van zo'n waag vormen de waagonderdelen."@nl;
