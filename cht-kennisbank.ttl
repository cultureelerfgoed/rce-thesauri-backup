<https://data.cultureelerfgoed.nl/term/id/cht/f093a8d0-04e3-4e8d-82de-4f1019dc1600>
  a skos:Concept;
  skos:prefLabel "textielvezels"@nl;
  skos:scopeNote "Textielvezels zijn vezels, zowel natuurlijk als synthetisch, die worden gebruikt bij het vervaardigen van textielproducten. Ze vormen de basis van weefsels en stoffen."@nl;
  skos:altLabel "textielvezel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b885b180-0922-40b0-b178-7b8a9ea00eea>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ac3b40a5-e724-415d-abd3-fdfdf4defaa5>
  a skos:Concept;
  skos:prefLabel "styreen acrylonitril"@nl;
  skos:scopeNote "Styreen acrylonitril (SAN) is een thermoplastisch polymeer met een hoge transparantie en chemische weerstand, vaak toegepast in huishoudelijke apparaten en verpakkingen."@nl;
  skos:altLabel "styreenacrylonitril"@nl, "SAN"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a061ecd4-92f0-47fc-b937-066e78e8d8e0>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f82c00b3-4bfa-4574-86fd-32bd7ce91f79>
  a skos:Concept;
  skos:prefLabel "polytetrafluoroethyleen"@nl;
  skos:scopeNote "Polytetrafluoroethyleen (PTFE), beter bekend als teflon, is een thermoplastisch polymeer, beroemd om zijn niet-klevende eigenschappen, vaak gebruikt in kookgerei en isolatoren."@nl;
  skos:altLabel "teflon"@nl, "PTFE"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a061ecd4-92f0-47fc-b937-066e78e8d8e0>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d6e50ee6-0518-4fed-93ed-6fbd26cd386f>
  a skos:Concept;
  skos:prefLabel "polysulfon"@nl;
  skos:scopeNote "Polysulfon is een thermoplastisch polymeer, bekend om zijn thermische stabiliteit en chemische weerstand, vaak toegepast in medische en industriële filtratiesystemen."@nl;
  skos:altLabel "PSU"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a061ecd4-92f0-47fc-b937-066e78e8d8e0>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/98dfd3cd-759b-40ea-80f3-79686e7672c0>
  a skos:Concept;
  skos:prefLabel "polyoxyethyleen"@nl;
  skos:scopeNote "Polyoxyethyleen is een thermoplastisch polymeer, veelgebruikt in de productie van schuimen, smeermiddelen en cosmetica, dankzij zijn veelzijdige eigenschappen."@nl;
  skos:altLabel "polyoxymethyleen"@nl, "POM"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a061ecd4-92f0-47fc-b937-066e78e8d8e0>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f573d538-98e7-41db-a4f9-5e27604e3d40>
  a skos:Concept;
  skos:prefLabel "polyethyleenterephthalaat"@nl;
  skos:scopeNote "Polyethyleenterephthalaat (PET) is een thermoplastisch polymeer, vooral bekend om zijn gebruik in verpakkingsmaterialen zoals plastic flessen, vanwege zijn duurzaamheid en recycleerbaarheid."@nl;
  skos:altLabel "PET"@nl, "polyetheentereftalaat"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a061ecd4-92f0-47fc-b937-066e78e8d8e0>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e92c2624-8f1c-4b7e-9937-c49b9ae32af6>
  a skos:Concept;
  skos:prefLabel "phenol formaldehyde"@nl;
  skos:scopeNote "Phenol formaldehyde is een thermohardend polymeer, bekend om zijn uitstekende thermische stabiliteit en mechanische sterkte. Het wordt vaak toegepast in schuurmaterialen en isolatie."@nl;
  skos:altLabel "fenolformaldehyde"@nl, "PF"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f441e935-eea6-4606-9017-ce0b579c91e7>;
