<https://data.cultureelerfgoed.nl/term/id/cht/70dbb9af-6fbb-47b9-8081-108d8adb8358>
  a skos:Concept;
  skos:prefLabel "stekelhuidigen"@nl;
  skos:scopeNote "Ongewervelde zeedieren met een stekelachtige huid. (MARDOC)"@nl;
