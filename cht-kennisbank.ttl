<https://data.cultureelerfgoed.nl/term/id/cht/4f510d14-58f4-4e67-a6da-bd45ebe54d3f>
  a skos:Concept;
  skos:prefLabel "Doornikse as"@nl;
  skos:scopeNote "Synthetische puzzolaan bestaande uit steenkoolsintels uit Doornikse kalkovens, vermengd met fijngestampte gebrande kalksteen. (Haslinghuis)"@nl;
