  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fce9d2b2-7860-406c-82df-a7232280c124>
  a skos:Concept;
  skos:prefLabel "wijnkoop"@nl;
  skos:scopeNote "Gelag, te betalen bij aankoop van een partij bouwmaterialen, waardoor men een kleine hoeveelheid materiaal gratis toe kreeg. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/df4db7b4-3b69-49a2-9068-13034f1a068f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/1c1e8e89-b3ad-4039-9789-9d5d0a0a9165>
  a skos:Concept;
  skos:prefLabel "monniken en nonnen"@nl;
  skos:scopeNote "Monniken en nonnen zijn middeleeuwse dakpannen, die beurtelings met de holle en de bolle kant naar boven werden gelegd. Ze werden voornamelijk in Noord- en Oost-Nederland gebruikt."@nl;
  skos:altLabel "holle- en bolle pan"@nl, "holle- en bolle pannen"@nl, "kloosterpan"@nl,
    "kloosterpannen"@nl, "monnik en non"@nl;
  skos:hiddenLabel "monikken"@nl, "non"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f1834398-e32b-4a85-acf4-7f71ab3f94d1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/1c29537c-28b6-4a62-b422-8f598d20e65f>
  a skos:Concept;
  skos:prefLabel "schampgoten"@nl;
  skos:scopeNote "Goot waarvan de binnenzijde gevormd wordt door het hellende dakvlak en de buitenboeiing daar loodrecht op staat. (Haslinghuis)"@nl;
  skos:altLabel "schampgoot"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/20e9ac01-2919-4886-9727-bb1329daea89>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/513badcc-2fb3-4f91-a256-a385cc095ac9>
  a skos:Concept;
  skos:prefLabel "stroomverdelers"@nl;
  skos:scopeNote "Apparaat, gewoonlijk aangedreven vanaf de nokkenas en bestemd om de hoge spanning van de bobine in de juiste volgorde over de verschillende bougies te verdelen. De stroomverdeler bevat de onderbrekerpunten, die zodanig zijn afgesteld dat de stroom op een bepaald tijdstip aan de bougies wordt afgeleverd."@nl;
  skos:altLabel "stroomverdeler"@nl, "verdeler"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6e5908ae-b3e1-4f8b-b4cf-87e924644f30>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/1c30ae09-45fd-43a8-9057-1dbcee455487>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/48efa387-e96a-45a0-ae85-4908c90ce986>
  a skos:Concept;
  skos:prefLabel "verdelerassen"@nl;
  skos:scopeNote "As waarmee de rotor en de verdelernok ronddraaien. Gewoonlijk aangedreven vanaf de nokkenas met de halve snelheid van de motor."@nl;
  skos:altLabel "verdeleras"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1c30ae09-45fd-43a8-9057-1dbcee455487>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/585f06dc-ebe1-4139-a5b6-847d21cf5cd5>
  a skos:Concept;
  skos:prefLabel "grondplaten (vervoer)"@nl;
  skos:scopeNote "Op de grondplaat vormt een onderdeel van de stroomverdeler. Op de grondplaat zijn de onderbrekerpunten bevestigd."@nl;
  skos:altLabel "grondplaat (vervoer)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1c30ae09-45fd-43a8-9057-1dbcee455487>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6d1ecaed-2543-4ad8-94ca-f5fc0179f145>
  a skos:Concept;
  skos:prefLabel "condensatoren"@nl;
  skos:scopeNote "Elektrisch apparaat dat in staat is een elektrische lading op te zamelen en zodoende de vonkvorming te voorkomen. Maakt deel uit van de gebruikelijke bobine-ontsteking en is gewoonlijk in of tegen de stroomverdeler aangebracht."@nl;
  skos:altLabel "condensator"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1c30ae09-45fd-43a8-9057-1dbcee455487>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/85d59eb1-0c5b-4ebd-871f-d2e4f73b41e7>
  a skos:Concept;
  skos:prefLabel "centrifugaal vervroegingen"@nl;
  skos:scopeNote "De centrifugaal vervroeging bestaat uit een scharnierende gewichtjes, die door veren in de nabijheid van de verdeleras worden gehouden. De centrifugaal kracht drijft ze steeds verder naar buiten naarmate de motor sneller draait. Aangezien de gewichtjes met de onderbrekernok zijn verbonden, zullend e onderbrekerpunten zoveel eerder open gaan."@nl;
  skos:altLabel "centrifugaal vervroeging"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1c30ae09-45fd-43a8-9057-1dbcee455487>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8966c181-4bb9-4d3f-9c2e-05f3b612fcb0>
  a skos:Concept;
  skos:prefLabel "verdeelkappen"@nl;
  skos:scopeNote "Geperste bakelieten kap die bovenop het verdelerhuis past en waar inde kabels, voor de hoge spanning vanaf de bobine en de bougiekabels zijn aangebracht."@nl;
  skos:altLabel "distibutiekap"@nl, "distibutiekappen"@nl, "verdeelkap"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1c30ae09-45fd-43a8-9057-1dbcee455487>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/93e6bf21-e676-4f4b-8510-39e530856430>
  a skos:Concept;
  skos:prefLabel "vacuümvervroegingen"@nl;
  skos:scopeNote "Middel om het ontstekingstijdstip te regelen overeenkomstig de onderdruk in het inlaatspruitstuk, met behulp van een door een veer belast membraan."@nl;
  skos:altLabel "vacuümvervroeging"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1c30ae09-45fd-43a8-9057-1dbcee455487>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b03ff9b5-0d08-4a76-8c83-69d8b231871d>
  a skos:Concept;
  skos:prefLabel "onderbrekernokken"@nl;
  skos:scopeNote "Meervoudige nok op de verdeleras bevestigd, met voor iedere cilinder een nok. De functie van de nok is de geïsoleerde onderbrekerhamer te lichten en daarmee het contact met de massa te verbreken."@nl;
  skos:altLabel "onderbrekernok"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1c30ae09-45fd-43a8-9057-1dbcee455487>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b19fa860-2722-4397-804e-64ca24a43499>
  a skos:Concept;
  skos:prefLabel "onderbrekerpunten"@nl;
  skos:scopeNote "Hard metalen contactpunten van de onderbreker binnen in de stroomverdeler. Wanneer de punten door de nok van de onderbreker van elkaar worden gelicht, wordt de stroom in het primaire circuit onderbroken en een stroom van hoge spanning in het secundaire circuit opgewekt."@nl;
  skos:altLabel "onderbrekerpunt"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1c30ae09-45fd-43a8-9057-1dbcee455487>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b8d232c2-6cf2-424f-a651-97dcc189148f>
  a skos:Concept;
  skos:prefLabel "onderbrekerhamers"@nl;
  skos:scopeNote "De onderbrekerhamer in de stroomverdeler zorgt er voor dat de hoogspanningsstroomkring sluit en onderbreekt."@nl;
  skos:altLabel "onderbrekerhamer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1c30ae09-45fd-43a8-9057-1dbcee455487>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c36703f6-9178-480b-a4fe-ace773ac15a9>
  a skos:Concept;
  skos:prefLabel "vacuümvervroegings mechanismes"@nl;
  skos:scopeNote "Het vacuumvervroegingsmechanisme is ingebouwd in de stroomverdeler. Het werkt op de onderdruk in het inlaatspruitstuk. Bij gedeeltelijk geopende smoorklep wordt het membraan aangezogen en het ontstekingstijdstip vervroegd. Bij vol geopende smoorklep is er weinig onderdruk en wordt de ontsteking minder vervroegd."@nl;
  skos:altLabel "vacuümvervroegings mechanisme"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1c30ae09-45fd-43a8-9057-1dbcee455487>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ccad5e4f-3934-44f3-9c5e-b081c5150042>
  a skos:Concept;
  skos:prefLabel "stroomverdelerhuizen"@nl;
  skos:scopeNote "Het huis van de stroomverdeler bevat o.a. het laagspanningsgedeelte, inclusief de onderbrekerpunten, die het tijdstip van ontsteken bepalen."@nl;
  skos:altLabel "stroomverdelerhuis"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1c30ae09-45fd-43a8-9057-1dbcee455487>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f9089ca4-0a5f-41bc-91d3-fc94c67a3f98>
  a skos:Concept;
  skos:prefLabel "automatische vervroegingen"@nl;
  skos:scopeNote "Methode om het ontstekingstijdstip op automatische wijze aan de behoeften van de motor aan te passen."@nl;
  skos:altLabel "automatische vervroeging"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1c30ae09-45fd-43a8-9057-1dbcee455487>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2d14b5b4-cdf3-4ad7-91da-5dac7a98f422>
  a skos:Concept;
  skos:prefLabel "aluminiumfolie"@nl;
  skos:scopeNote "Zeer dun uitgewalst aluminium, meestal gebruikt als verpakkingsmateriaal voor levensmiddelen. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1c31c659-0b7b-446f-a9ce-ef296a3acffa>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/351e6485-6a98-437a-9493-88e27fd83460>
  a skos:Concept;
  skos:prefLabel "plakplastic"@nl;
  skos:scopeNote "Plakplastic is plasticfolie die op diverse oppervlakken kan worden aangebracht. (Wikipedia)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1c31c659-0b7b-446f-a9ce-ef296a3acffa>;
