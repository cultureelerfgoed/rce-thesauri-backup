  a skos:Concept;
  skos:prefLabel "kussens (blok)"@nl;
  skos:scopeNote "Op de pasbalk gelegen horizontaal verstelbaar blok waarin de taatspot is bevestigd. In oliemolens, blokken van kops iepehout die door de slagbeitel tegen de jaagijzers werden gedreven, waardoor de olie uit het gemalen zaad werd geperst."@nl;
  skos:altLabel "kussen (blok)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/04770e4f-1c11-40e7-a256-9de8c6d569c6>;
