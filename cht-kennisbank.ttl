  a skos:Concept;
  skos:prefLabel "heksenwagen"@nl;
  skos:scopeNote "Heksenwagen zijn weegtoestellen waarop men vroeger personen zette om uit te maken of ze heksen waren (heksen werden geacht lichter te zijn dan gewone mensen). (Rijksdienst voor het Cultureel Erfgoed)"@nl;
