<https://data.cultureelerfgoed.nl/term/id/cht/8bdeeeb7-5764-4463-93d0-6c3e1d41342c>
  a skos:Concept;
  skos:prefLabel "ijzerertsen"@nl;
  skos:scopeNote "Die delfstoffen welke het ijzer in zulke hoeveelheden bevatten dat het zich daaruit met voordeel laat afzonderen. (MARDOC)"@nl;
