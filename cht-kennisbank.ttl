  a skos:Concept;
  skos:prefLabel "kaarsenluchters"@nl;
  skos:scopeNote "Kaarsenluchters zijn een type kandelaar, specifiek ontworpen om meerdere kaarsen te dragen en vaak aan het plafond opgehangen. Ze vallen onder de bredere categorie kandelaars en werden traditioneel gebruikt in kerken en grote huizen voor verlichting en decoratie."@nl;
