<https://data.cultureelerfgoed.nl/term/id/cht/daf7f76a-a416-4c3b-9754-71c0c40bbab3>
  a skos:Concept;
  skos:prefLabel "zuigkamers"@nl;
  skos:scopeNote "De zuigkamer is de ruimte waarin de zuiger van een SU carburateur op- en neer beweegt."@nl;
  skos:altLabel "zuigkamer"@nl;
