<https://data.cultureelerfgoed.nl/term/id/cht/5fb4a9f2-2017-49be-9da5-9828b2f53102>
  a skos:Concept;
  skos:prefLabel "carolusguldens"@nl;
  skos:scopeNote "Carolusguldens zijn historische gouden of zilveren munten die werden geslagen onder keizer Karel V."@nl;
