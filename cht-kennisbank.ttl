  skos:prefLabel "paardenfokkerijen"@nl;
  skos:scopeNote "Paardenfokkerijen zijn fokkerijen die op het fokker van paarden gericht zijn. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
