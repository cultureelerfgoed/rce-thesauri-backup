  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9ddae20c-b263-4b8d-a0b3-2116895b2ac8>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/1da2b42e-4111-482f-8872-8ae1caafa855>
  a skos:Concept;
  skos:prefLabel "lichtmasten"@nl;
  skos:scopeNote "Een paal waaraan één of meerdere lampen zijn opgehangen. (WikiWoordenboek)"@nl;
  skos:altLabel "lichtmast"@nl;
