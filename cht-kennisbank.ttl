<https://data.cultureelerfgoed.nl/term/id/cht/79c95b4b-5b86-4d82-b813-1c83ca063add>
  a skos:Concept;
  skos:prefLabel "phalerae"@nl;
  skos:scopeNote "Te gebruiken voor Oud-Romeinse decoratieve metalen schijven of knoppen, door mannen op de borst gedragen als militair onderscheidingsteken of sieraad; ook te gebruiken voor vergelijkbare versierselen op paardentuig. Mogelijk van Keltische oorsprong. (AAT-Ned)"@nl;
  skos:altLabel "phalera"@nl, "ronde sierschijf"@nl, "ronde sierschijven"@nl;
