<https://data.cultureelerfgoed.nl/term/id/cht/685f078e-cf7b-4039-94a7-f298ce5ce099>
  a skos:Concept;
  skos:prefLabel "hugenoten"@nl;
  skos:scopeNote "Hugenoten zijn Franse protestanten (voornamelijk calvinisten) die in de 16e en 17e eeuw vervolgd werden. Velen vluchtten naar Nederland en speelden een rol in handel, ambacht en religie."@nl;
  skos:altLabel "hugenoot"@nl;
