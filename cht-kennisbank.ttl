<https://data.cultureelerfgoed.nl/term/id/cht/33d8591c-319d-4fc3-96d0-cb82c1dec640>
  a skos:Concept;
  skos:prefLabel "rotstuinen"@nl;
  skos:scopeNote "Rotstuinen zijn tuinen met een nagebootst miniatuur berglandschap met echte keien of imitatie-rotsen (cementrustiek) en een aangepaste groeiplaats waarin rotsplanten kunnen overleven. De rotstuin is nauw verwant aan het alpinum. In een alpinum ligt de nadruk op de plantenverzameling; in een rotstuin op de vormgeving van de aanleg. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "rotstuin"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c2fcf3dc-6efd-4c88-afcf-287b680894ff>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ffbf9bea-eb65-4e3a-982f-170408bf89d3>
  a skos:Concept;
  skos:prefLabel "hondenmolens"@nl;
  skos:scopeNote "Een tredmolen aangedreven met een hond. (Molenwoordenboek G.J. Pouw)"@nl;
  skos:altLabel "hondenmolen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1ed2543e-96bd-4594-ac0f-d93bf0613cf7>;
