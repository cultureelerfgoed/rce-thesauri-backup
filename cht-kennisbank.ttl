<https://data.cultureelerfgoed.nl/term/id/cht/38c06732-1c34-4ff2-a5a4-42f38b2fe0db>
  a skos:Concept;
  skos:prefLabel "familiewapens"@nl;
  skos:scopeNote "Een familiewapen is sinds de Middeleeuwen het onderscheidende kleur- en vormrijk beeldmerk van een familie of persoon, uitgebeeld op een wapenschild. Een familiewapen kan voor naamdragende afstammelingen erfelijk of persoonlijk zijn. (Wikipedia)"@nl;
  skos:altLabel "familiewapen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7c884119-cc2d-41db-8df7-a9e838d5ccca>;
