<https://data.cultureelerfgoed.nl/term/id/cht/c8f71add-4d80-49c0-8c2e-e8385372afa2>
  a skos:Concept;
  skos:prefLabel "Jessevensters"@nl;
  skos:scopeNote "Kerkvenster waarvan de stijlen en het maaswerk, al of niet met de glasschildering, de boom van Jesse (Jozua) tot motief heeft. De genealogie van Christus is weergegeven in de vorm van takken waarin de koningen van Juda. Fraaie voorb. in Engeland: Shrewsbury (St.-Mary’s) en Dorchester Abbey (c. 1340). (Haslinghuis)"@nl;
  skos:altLabel "Jessevenster"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f355cf6c-14c3-4630-8a50-1c0a2b7ee042>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8644067a-3b4d-4ecf-9c5b-5bb0b91a2086>
  a skos:Concept;
  skos:prefLabel "bergkristal"@nl;
  skos:scopeNote "Bergkristal is in de natuur voorkomend kwarts. Chemisch is het zuiver siliciumdioxide. Het is gewoonlijk kleurloos en glashelder. (Conservation Dictionary)"@nl;
  skos:hiddenLabel "kristal"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b798d2e1-746f-4c1a-82a2-828e575f490e>;
