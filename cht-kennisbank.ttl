<https://data.cultureelerfgoed.nl/term/id/cht/f244c0a5-2fa0-4703-b634-08ee1772b09c>
  a skos:Concept;
  skos:prefLabel "eenzijdige afremmingen"@nl;
  skos:scopeNote "Bij eenzijdige afremming maakt men gebruik van een remblok per wiel"@nl;
  skos:altLabel "eenzijdige afremming"@nl;
