  a skos:Concept;
  skos:prefLabel "dubbeldik goudblad"@nl;
  skos:scopeNote "Dubbeldik goudblad is een soort goudblad. Het is in de regel zuiver gewoon goud en het is iets dikker dan het enkel goudblad, maar niet noodzakelijk twee keer zo dik."@nl;
