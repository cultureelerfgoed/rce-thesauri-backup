<https://data.cultureelerfgoed.nl/term/id/cht/339f6179-c347-436f-a578-e2a953c1aeb0>
  a skos:Concept;
  skos:prefLabel "wasknijpers"@nl;
  skos:scopeNote "Verschillende soorten knijpers voor het bevestigen van gewassen wasgoed aan een was-of waslijn. Bestaat uit twee delen die zijn verbonden met een voorgespannen veer. De pen wordt geopend door de uitstaande uiteinden samen te knijpen. (AAT-Ned)"@nl;
  skos:altLabel "wasknijper"@nl;
