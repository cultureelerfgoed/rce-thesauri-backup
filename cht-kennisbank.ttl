<https://data.cultureelerfgoed.nl/term/id/cht/c77799dc-294e-4393-a499-b5f6cf3d7274>
  a skos:Concept;
  skos:prefLabel "driften (land)"@nl;
  skos:scopeNote "Driften zijn stukken land waar men wild opdrijft richting jagers. Op enige afstand staan jagers gereed om opgejaagde dieren af te schieten. (Wikipedia)"@nl;
