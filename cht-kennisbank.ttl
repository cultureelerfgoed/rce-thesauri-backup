<https://data.cultureelerfgoed.nl/term/id/cht/503e1539-3390-4e1d-8ae5-9216e83d2d97>
  a skos:Concept;
  skos:prefLabel "stoommotorfietsen"@nl;
  skos:scopeNote "Een stoommotorfiets is een tweewielig voertuig dat wordt voortbewogen door een stoommachine. (Wikipedia)"@nl;
  skos:altLabel "stoomfiets"@nl, "stoommotorfiets"@nl;
