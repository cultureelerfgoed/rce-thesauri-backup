  skos:prefLabel "ruitenwisserarmen"@nl;
  skos:scopeNote "De ruitenwisser arm vormt de verbinding tussen de as van de ruitenwissermotor en het wisserblad."@nl;
  skos:altLabel "ruitenwisserarm"@nl;
