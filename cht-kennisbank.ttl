  skos:scopeNote "Een voorraadpot is een huishoudelijk voorwerp dat wordt gebruikt om veelal droge voedings- of genotsmiddelen in te bewaren."@nl;
  skos:altLabel "voorraadpot"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/888c6b9b-3e4f-4d52-8819-da81c0b07ad9>;
