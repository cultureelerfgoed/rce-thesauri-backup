  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d7d90c04-237e-4ac9-b053-bcaf41d0daf2>
  a skos:Concept;
  skos:prefLabel "stockracecars"@nl;
  skos:scopeNote "Een stockracecar is een raceauto die speciaal gebouwd is voor de Stockcar Formule 1, de koningsklasse van de autocross en de autospeedway. (Wikipedia)"@nl;
  skos:altLabel "stockcar"@nl, "stockcars"@nl, "stockracecar"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0437a8ce-4163-4912-95d4-da3e1854419b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e1344abd-d066-49e0-a368-1fece7a10262>
  a skos:Concept;
  skos:prefLabel "toerwagens"@nl;
  skos:scopeNote "Toerwagens zijn racewagens op basis van een bestaand autotype dat vrij te koop is en op de openbare weg kan rijden. (Wikipedia)"@nl;
  skos:altLabel "toerwagen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0437a8ce-4163-4912-95d4-da3e1854419b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f8de559f-1bd6-4ec0-ba89-0315eaf61962>
  a skos:Concept;
  skos:prefLabel "negatief kopieën"@nl;
  skos:scopeNote "Een negatief kopie is een opname van een fotografische afdruk met een negatieffilm. (Conservation Dictionary)"@nl;
  skos:altLabel "negatief kopie"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/997d625e-f272-47cd-be0b-00e681876dde>;
