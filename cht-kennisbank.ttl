  a skos:Concept;
  skos:prefLabel "bandenspanningsmeters"@nl;
  skos:scopeNote "Bandenspanningsmeters zijn technische apparaten ter controle van het aantal atmosfeer in een (binnen)band."@nl;
  skos:altLabel "bandenspanningsmeter"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b82b1af7-2b81-4047-8762-1db681e94b03>;
