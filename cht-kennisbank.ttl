<https://data.cultureelerfgoed.nl/term/id/cht/615168a8-416e-4977-83e7-076671409559>
  a skos:Concept;
  skos:prefLabel "römer tufsteen"@nl;
  skos:scopeNote "Römer tufsteen: tufsteen welke gewonnen wordt in de omgeving van Kruft, Duitsland. De steen heeft een bruin-rode ondergrond met open poriën en zwarte basaltfragmenten en witte of gele bims. Het breukvlak is ruw korrelig."@nl,
    "Römer tufsteen: tufsteenwelke gewonnen wordt in de omgeving van Kruft, Duitsland. De steen heeft een bruin-rode ondergrond met open poriën en zwarte basaltfragmenten en witte of gele bims. Het breukvlak is ruw korrelig."@nl;
  skos:altLabel "römer tuf"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fe46430e-3e7a-4e9d-9be4-c76ee19bf2d5>;
