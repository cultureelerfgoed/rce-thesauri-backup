<https://data.cultureelerfgoed.nl/term/id/cht/70140e96-cc83-4bc7-911c-c874579f90f6>
  a skos:Concept;
  skos:prefLabel "atriumwoningen"@nl;
  skos:scopeNote "Atriumwoningen zijn woningen die grenzen aan een binnenhof. De woningen op de etages worden ontsloten door een galerij."@nl;
  skos:altLabel "atriumwoning"@nl;
