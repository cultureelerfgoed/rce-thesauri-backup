<https://data.cultureelerfgoed.nl/term/id/cht/8c11601d-8cbe-4beb-b384-5c4ca8c96eb9>
  a skos:Concept;
  skos:prefLabel "haringachtigen"@nl;
  skos:scopeNote "Haringachtigen (Clupeiformes) vormen een orde van straalvinnige vissen.Het is de enige orde binnen de superorde Clupeomorpha (haringachtige beenvissen) en omvat ongeveer 300 soorten in vijf families. (Wikipedia)"@nl;
  skos:altLabel "Clupeomorpha"@nl, "Clupeiformes"@nl, "haringachtige"@nl, "haringachtige beenvissen"@nl;
