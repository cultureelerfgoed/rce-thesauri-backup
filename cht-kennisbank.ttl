  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/0ace64ae-0da0-4e86-a98d-5ae9aaf2e5eb>
  a skos:Concept;
  skos:prefLabel "kopperrons"@nl;
  skos:scopeNote "Kopperrons zijn perrons die de spoorlijnen beëindigen in een station of opstelstelplaats. De trein kan dan niet meer verder rijden maar alleen terug rijden over dezelfde spoorlijn."@nl;
  skos:altLabel "kopperron"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6ac6617c-9a84-42df-b250-c42c4ca4c106>;
