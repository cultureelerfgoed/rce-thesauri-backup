<https://data.cultureelerfgoed.nl/term/id/cht/3562f99b-5e8b-4ad0-9a10-397992f94dde>
  a skos:Concept;
  skos:prefLabel "Bosse keukens"@nl;
  skos:scopeNote "Tegenover het voorhuis verdiept gelegde binnenhaard, om een hogere insteekruimte ( opkamer) erboven te krijgen (woonkeuken, keukenkelder, ook keuken, volgens beschrijving c. 1780). (Haslinghuis)"@nl;
  skos:altLabel "Bosse keuken"@nl;
