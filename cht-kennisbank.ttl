  a skos:Concept;
  skos:prefLabel "chromoplast"@nl;
  skos:scopeNote "Chromoplasten zijn gespecialiseerde organellen in planten die verantwoordelijk zijn voor de synthese en opslag van pigmenten, die kleur geven aan bloemen en vruchten."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
