<https://data.cultureelerfgoed.nl/term/id/cht/5a804d10-2288-4bff-9a07-7303ad583e97>
  a skos:Concept;
  skos:prefLabel "onroerend monument"@nl;
  skos:scopeNote "Een onroerend monument is een onroerende zaak welke van algemeen belang is wegens zijn schoonheid, zijn betekenis voor de wetenschap of zijn cultuurhistorische waarde."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f94da6b6-f1b8-4141-b4e8-316573793d59>;
