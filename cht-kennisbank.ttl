<https://data.cultureelerfgoed.nl/term/id/cht/3c592a12-6f43-44ff-8d88-cea309dbf992>
  a skos:Concept;
  skos:prefLabel "crematoriumaula's"@nl;
  skos:scopeNote "Crematoriumaula's zijn aula's die deel uitmaken van een crematoriumcomplex. Ze worden gebruikt voor afscheidsdiensten en ceremonies voorafgaand aan de crematie van overledenen."@nl;
  skos:altLabel "crematoriumaula"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1e80063c-e8a5-48f7-bc55-e27971ce2177>;
