<https://data.cultureelerfgoed.nl/term/id/cht/1e4f05b4-8b49-478b-a3e8-3895e22967e7>
  a skos:Concept;
  skos:prefLabel "steekschuiten"@nl;
  skos:scopeNote "Nederlandse platboomde open vissersboot van de grote rivieren. De boot gelijkt enigszins op de hengst. Het vlak is geheel plat. Beide stevens zijn recht de voorsteven vrij recht vallend. Het boord valt breed open het boeisel valt binnenwaarts. Voor- en achterschip zijn scherp. Zij kon gezeild worden met een spriettuig en voerde daarom zwaarden. (MARDOC)"@nl;
  skos:altLabel "steekschuit"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/3f1ace50-e981-4b2e-9b9b-4bfa2cf0b576>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/afa26f2d-ca12-4790-bd5e-24373a87bceb>
  a skos:Concept;
  skos:prefLabel "snijbonenmolens"@nl;
  skos:scopeNote "Molens waarmee snijbonen worden fijngesneden. (MARDOC)"@nl;
  skos:altLabel "snijbonenmolen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c986e8f0-b839-46a0-8e3e-9d345e11b71b>;
