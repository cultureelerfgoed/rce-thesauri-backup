<https://data.cultureelerfgoed.nl/term/id/cht/dc6fc39e-dc05-4ff1-a908-f080e7f91dd3>
  a skos:Concept;
  skos:prefLabel "dagzomen"@nl;
  skos:scopeNote "Dagzomen is het aan de oppervlakte komen, zichtbaar worden, van gesteenten. (met inbegrip van zand, klei, etc.) (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2971af0-cde7-4888-b828-33443f702e7d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/5f47d8f3-d8dd-4e36-ae56-b89d194250b6>
  a skos:Concept;
  skos:prefLabel "molentochten"@nl;
  skos:scopeNote "Verwijst naar eenvoudige of complexe machines of mechanische apparaten die worden gebruikt om vaste stoffen, zoals graan of kruiden, te verpulveren of tot poeder of pulp te vermalen. Gebruik 'molens (gebouwen)' om te verwijzen naar de combinatie van een gebouw en de daarin ondergebrachte maalinrichting. (AAT-Ned)"@nl;
  skos:altLabel "molentocht"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e9f07631-1f34-408d-a1cd-08cb80cf2023>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/02c4298b-f07a-446e-854b-bebc88aabfe1>
  a skos:Concept;
  skos:prefLabel "bolvormige gewelven"@nl;
  skos:scopeNote "Bolvormige gewelven zijn zijn gewelven die ontstaan door de wenteling van een halve cirkel of minder dan een halve cirkel om zijn verticale as. Een halve cirkel op een cirkelvormige plattegrond levert de volmaakte koepel. (Haslinghuis)"@nl;
  skos:altLabel "bolvormig gewelf"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/02e2289e-bbb7-4233-9e02-fd95935f4e28>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/9046741c-41f7-468a-89de-5b550aff0ad9>
  a skos:Concept;
  skos:prefLabel "boterhallen"@nl;
  skos:scopeNote "Boterhallen zijn markthallen waar boter werd verhandeld. Ze waren vaak centraal gelegen in steden en dienden als belangrijke commerciële en sociale ontmoetingsplaatsen."@nl;
  skos:altLabel "boterhal"@nl, "boterhuis"@nl, "boterhuizen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/83883001-9943-4726-9ddd-3fd73c7b9c46>;
