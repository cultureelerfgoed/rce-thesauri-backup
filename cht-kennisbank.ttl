<https://data.cultureelerfgoed.nl/term/id/cht/a178e4e1-8057-4624-b882-99db93280d54>
  a skos:Concept;
  skos:prefLabel "testament (wilsbeschikking)"@nl;
  skos:scopeNote "Wettelijke documenten waarin iemand verklaart wat er na zijn dood met zijn vermogen zal geschieden. Tijdens het leven van de erflater kan een testament nog worden herroepen. (AAT-Ned)"@nl;
  skos:altLabel "testamenten (wilsbeschikking)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91712616-6dec-4871-8fdc-c317850c20d1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a17d5059-71d5-4c5a-9882-148b629c8990>
  a skos:Concept;
  skos:prefLabel "schuimspanen (keukengereedschap)"@nl;
  skos:scopeNote "Geperforeerd gerei, meestal met een handvat, dat wordt gebruikt voor het afromen van vloeistoffen. (AAT-Ned)"@nl;
  skos:altLabel "schuimspaan (keukengereedschap)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
