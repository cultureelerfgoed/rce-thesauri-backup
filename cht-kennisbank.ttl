  a skos:Concept;
  skos:prefLabel "wit Zweeds graniet"@nl;
  skos:scopeNote "Wit Zweeds graniet is een granietsoort afkomstig uit Zweden, bekend om zijn lichte, bijna witte kleur. Het wordt veel gebruikt in bouwprojecten waar een heldere, duurzame steen gewenst is, zoals in gevels en grafmonumenten."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9940cc61-e695-40f9-b0a7-ad3270091e1f>;
