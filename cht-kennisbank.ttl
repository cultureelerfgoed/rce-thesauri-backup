<https://data.cultureelerfgoed.nl/term/id/cht/91c7730a-ea32-4d3c-99ea-7a9a9f3f70ba>
  a skos:Concept;
  skos:prefLabel "halsen (zuilschachtdeel)"@nl;
  skos:scopeNote "Bovenste deel van een zuilschacht, als deze met een profiel of een ring aansluit bij het kapiteel ( (astragaal). (Haslinghuis)"@nl;
  skos:altLabel "hals (zuilschachtdeel)"@nl;
