<https://data.cultureelerfgoed.nl/term/id/cht/3f9a3bb9-c515-465a-b3ab-ab1b6c5ffa80>
  a skos:Concept;
  skos:prefLabel "vijzelaars"@nl;
  skos:scopeNote "Ambachtsman die gespecialiseerd was in het omhoogbrengen van doorgaans verzakte bouwwerken met vijzels. In XVIIa was Jan Jansz. Vijselaer van Edam een bekende aannemer. De vijzelaars behoorden in Amsterdam in 1565 tot het timmermansgilde. (Haslinghuis)"@nl;
  skos:altLabel "vijzelaar"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db4a7619-d236-4b14-8e79-b4a6e890f677>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3fa557f7-5c4e-447f-9544-72d4eb0e0210>
  a skos:Concept;
  skos:prefLabel "combinatiedrukken"@nl;
  skos:scopeNote "Fotografische afdruktechniek waarbij meer dan één negatief wordt gebruikt. Gebruik 'meervoudige belichting' voor de techniek waarbij meer dan één beeld wordt vastgelegd binnen één kader. (AAT-Ned)"@nl;
  skos:altLabel "combinatiedruk"@nl;
