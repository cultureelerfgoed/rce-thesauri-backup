<https://data.cultureelerfgoed.nl/term/id/cht/b1e72bb8-453d-445b-8188-4b819a471436>
  a skos:Concept;
  skos:prefLabel "beklemrecht"@nl;
  skos:scopeNote "Een beklemrecht is een zakelijk, ondeelbaar en eeuwigdurend recht op de onroerende zaak van een ander om daarvan het volledige genot te hebben en waardoor men eigenaar wordt van de zich op de grond bevindende gebouwen en beplantingen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bcc9ece8-29e8-46f8-b0ab-144d51f43c72>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/0e92e7c3-6ecf-4fe3-a2e3-bb503adfc6e7>
  a skos:Concept;
  skos:prefLabel "oppervlaktelaag"@nl;
  skos:scopeNote "Een oppervlaktelaag is een coating die op het voorwerp wordt aangebracht om het te beschermen of om het er beter te laten uitzien."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
