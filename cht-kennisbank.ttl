<https://data.cultureelerfgoed.nl/term/id/cht/da4c9342-15e4-4b23-8ab0-c6e0ca634ffd>
  a skos:Concept;
  skos:prefLabel "bouten (afsluitingmiddel)"@nl;
  skos:scopeNote "Ijzeren staaf om een deur, raam, blinden enz. overdwars af te sluiten en te verzekeren. (Haslinghuis)"@nl;
  skos:altLabel "bout (afsluitingmiddel)"@nl;
