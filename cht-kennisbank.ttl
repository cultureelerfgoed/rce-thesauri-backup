<https://data.cultureelerfgoed.nl/term/id/cht/4ac44b40-a53c-40c4-801c-8f069883c20e>
  a skos:Concept;
  skos:prefLabel "schoorsteenkanalen"@nl;
  skos:scopeNote "Schoorsteenkanalen zijn de kanalen waardoor rook en verbrandingsgassen worden afgevoerd. Ze zijn, omdat ze gemetseld zijn, doorgaans vierkant of rechthoekig in doorsnede. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "schoorsteenkanaal"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c3af92e8-b567-4a77-9fea-4459c6975149>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e2248589-7b30-4c10-9dae-04ff247a5d28>
  a skos:Concept;
  skos:prefLabel "schuifkozijnen"@nl;
  skos:scopeNote "Schuifkozijnen zijn kozijnen met kokers in de stijlen. In de kokers hangen de gewichten van het schuifraam. (wat doen die gewichten?) In de stijlen zijn kokers gemaakt voor de gewichten waaraan de schuivende delen zijn opgehangen. (Haslinghuis)"@nl;
  skos:altLabel "schuifkozijn"@nl, "schuifraamkozijn"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e088659a-d39d-4719-aa26-f5fdbdab610f>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/a5468364-1912-4954-966e-22875e9d31e5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/25a72c5f-30a9-4891-b8db-c1c90a92991c>
  a skos:Concept;
  skos:prefLabel "knorrenkapitelen"@nl;
  skos:scopeNote "Kapiteel, waarvan de horizontale doorsnede een geschulpte (gefestonneerde) omtrek vertoont. Ontstaan uit onderverdeling van het teerlingkapiteel. Krijgt het aanzien van een gepijpte kanten kraag. Kenmerkend voor de vroege Normandische architectuur (St.-Georges de Boscherville, XI) en vooral de Engelse tak daarvan (Fountains, Kirstall, Malmesbury, Smithfield (Londen), St.-Bartholomew’s, 1123). Daar verbindt het motief zich met dat van knoppen ( knoppenkapiteel). (Haslinghuis)"@nl;
  skos:altLabel "knobbelkapiteel"@nl, "knobbelkapitelen"@nl, "knorrenkapiteel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1bd43a03-2889-400f-b451-ba760c3e0114>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/428d2f54-7dee-4c6d-b064-e6578a812a77>
  a skos:Concept;
  skos:prefLabel "small cell"@nl;
  skos:scopeNote "Small cells zijn kleine antennes om een klein gebied te bedienen waar veel mensen bij elkaar komen, zoals stationsgebouwen, winkelcentra of parkeergarages."@nl;
  skos:altLabel "small cells"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d91f8882-8a88-4675-9621-50f4710a1ba9>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/af48f61c-8fd2-4e90-8ca4-bb44ab8693e4>
  a skos:Concept;
  skos:prefLabel "bindlood"@nl;
  skos:scopeNote "Lood of een ander metaal, zoals koper, dat gebruikt wordt voor het vastzetten van de bindroede aan een glas-in-loodpaneel. (Werkgroep Vlakglas)"@nl;
  skos:altLabel "bindloodjes"@nl, "bindloodje"@nl, "loodveter"@nl, "loodveters"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2bb9e948-a44c-458d-824b-031b81d443e0>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/87989ee9-f5d0-417e-8c28-92785eb0d103>
  a skos:Concept;
  skos:prefLabel "putstellen"@nl;
  skos:scopeNote "Putstellen zijn de gedeelten van putten die boven de grond zichtbaar zijn; bovenbouw van putten."@nl;
  skos:altLabel "putstel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cc35695d-14c2-4533-8dde-d121a0b71bda>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/15d26695-4a51-4fbf-aec2-65a18b5a5cc5>
  a skos:Concept;
  skos:prefLabel "kleurrasterplaten"@nl;
  skos:scopeNote "Glasplaten waarop afbeeldingen met additieve kleuren worden gemaakt via een raster van minuscule rode, groene en blauwe filters om de onderlinge intensiteit van elke tint over te brengen op een panchromatische ontwikkelgelatinezilveremulsie. Deze wordt verwerkt tot een diapositief op glas. Als ze door dezelfde filter worden bekeken is van elk filter de tint zichtbaar waarvan de intensiteit is gemoduleerd door het zilverbeeld. (Project Fotografie)"@nl,
    "Een kleurenrasterplaat is een diapositief met natuurlijke kleuren waarin een fijn regelmatig lijnraster, of willekeurig puntraster bestaande uit additieve, primaire kleuren is aangebracht, dat gebruikt wordt voor kleurweergave. (Conservation Dictionary)"@nl;
  skos:altLabel "kleurenrasterplaat"@nl, "rasterplaat of -film"@nl, "kleurenrasterplaten"@nl,
    "kleurrasterplaat"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/add0ea9b-2ed0-44f6-8b32-04223190fc46>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/04e00088-3075-415e-a524-a10ec91257e6>,
    <https://data.cultureelerfgoed.nl/term/id/cht/0705698b-d9a0-4746-8096-27b681b605ef>,
    <https://data.cultureelerfgoed.nl/term/id/cht/c81065fb-5174-4314-9567-28429d95a2ed>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/cf8d18d1-d589-4ed1-ae54-0e70050a26cb>
  a skos:Concept;
  skos:prefLabel "baleinverwerkingsbedrijven"@nl;
  skos:scopeNote "Werkplaats waar walvisbalein wordt verwerkt voor diverse producten."@nl;
  skos:altLabel "baleinverwerkingsbedrijf"@nl;
