<https://data.cultureelerfgoed.nl/term/id/cht/dc92091e-64ca-4370-b0e3-ba8c1655fd44>
  a skos:Concept;
  skos:prefLabel "edelstaal"@nl;
  skos:scopeNote "Edelstaal is een term gebruikt door staalfabrikanten om hoogwaardige roestvast staal (in de volksmond: roestvrij staal) aan te duiden, waarmee benadrukt moet worden dat het staal sterk, zuiver en mooi is. (Wikipedia)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f8c2a906-b0f7-441c-a6ea-60bbc63fa29b>;
