  a skos:Concept;
  skos:prefLabel "interdisciplinair"@nl;
  skos:scopeNote "Bij een interdisciplinair project of andere activiteit zijn mensen uit verschillende disciplines betrokken. Bij een museaal project bijvoorbeeld, kunnen conservatoren, restauratoren en ontwerpers betrokken zijn."@nl;
