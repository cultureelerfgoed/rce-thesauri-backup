<https://data.cultureelerfgoed.nl/term/id/cht/5152cfe7-6004-4ba5-b578-944251d6a8ab>
  a skos:Concept;
  skos:prefLabel "DMC2"@nl;
  skos:scopeNote "DMC2 is een co-polymeerdispersie van vinylacetaat en di-n-butylmaleaat. Het heeft een Tg (glasovergangstemperatuur) van 100°C."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4c8b3905-3d3d-4f73-be92-a33a95f378fd>;
