<https://data.cultureelerfgoed.nl/term/id/cht/45eb46e8-383b-45e0-9228-85cc2d24fdda>
  a skos:Concept;
  skos:prefLabel "kloostergangen"@nl;
  skos:scopeNote "Kloostergangen zijn gangen die doorgaans in drie of vier armen het rechthoekige kloosterhof omringen. De kloostergang is omgeven door de belangrijkste kloostergebouwen, waardoor zij als verbindingsgang dienst doet. Naar de hof toe heeft de kloostergang open arcades, oorspronkelijk van de vloer opgaande en later met borstweringen waarop de zuilen rusten die aaneengeschakelde rondbogen dragen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "kloostergang"@nl, "kloostergangtuin"@nl, "kruisgang"@nl, "kruisgangen"@nl,
    "kruisgangtuin"@nl, "pandhoof"@nl, "pandhoven"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a40f45b6-e7b7-4d9a-b34b-fc84feef85a9>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

