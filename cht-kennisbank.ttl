<https://data.cultureelerfgoed.nl/term/id/cht/4b9a4c88-833b-4f4f-ac7a-ad214d5197d2>
  a skos:Concept;
  skos:prefLabel "tekenpapier"@nl;
  skos:scopeNote "Zwaar papier, meestal in de kleur wit of buff, gebruikt voor het maken van tekeningen. Het kan zacht of ruw zijn; ruw papier wordt heetgeperst. Bij tekenpapier van goede kwaliteit moet redelijk vaak uitgummen mogelijk zijn zonder het papier zichtbaar te beschadigen. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2d28d9aa-77e8-40ab-b0fe-f04d99f57955>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4fddb539-81cb-41e1-86a9-d675d84ad686>
  a skos:Concept;
  skos:prefLabel "bordpapier"@nl;
  skos:scopeNote "Dik, onbuigzaam papier, gewoonlijk in de vorm van zware vellen bestaand uit verschillende lagen papier. (Zuiderzeemuseum)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2d28d9aa-77e8-40ab-b0fe-f04d99f57955>;
