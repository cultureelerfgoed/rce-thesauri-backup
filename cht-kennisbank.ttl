<https://data.cultureelerfgoed.nl/term/id/cht/4b1ba849-754f-45b7-b7b5-da67f388a3a1>
  a skos:Concept;
  skos:prefLabel "gaffels (molen)"@nl;
  skos:scopeNote "Buiten een gaffelwiel (b.v. luiwiel) uitstekende vork­ vormige ijzers waarover een doorlopend touw werd geleid."@nl;
  skos:altLabel "gaffel (molen)"@nl;
