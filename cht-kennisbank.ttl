  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6658e645-9a5d-4d0b-a7a8-e42acf89608f>
  a skos:Concept;
  skos:prefLabel "schoorsteenkappen"@nl;
  skos:scopeNote "Schoorsteenkappen zijn metalen dekstukken of kappen, geplaatst op schoorstenen om het inregenen van de rookkanalen te voorkomen en schadelijk invloeden van de wind te keren. Ze kunnen een eenvoudig tot sierlijk uiterlijk hebben. (Kachels / R. Rook, Utrecht/Aartselaar, 1985)"@nl;
  skos:altLabel "schoorsteenkap"@nl, "schoorsteentafel"@nl, "schoorsteentafels"@nl;
