<https://data.cultureelerfgoed.nl/term/id/cht/0db06f7c-7bdd-4743-bb6a-a28f8690632b>
  a skos:Concept;
  skos:prefLabel "plastisch"@nl;
  skos:scopeNote "Een plastisch materiaal is materiaal dat zich laat vormen en dat bij gebruik in die vorm blijft. Voorbeelden zijn klei, hoorn, polytheen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
