<https://data.cultureelerfgoed.nl/term/id/cht/e774f13e-3b98-4f01-9a41-62ed5e8b7078>
  a skos:Concept;
  skos:prefLabel "kleurendrukken (prent)"@nl;
  skos:scopeNote "Prenten gedrukt in twee of meer kleuren. Gebruik de termen 'gekleurd' (ALT van 'kleuren') + 'prenten' voor prenten, waarin de kleuren zijn aangebracht na het drukken. Gebruik 'kleurenafdrukken' in de context van foto's. (AAT-Ned)"@nl;
  skos:altLabel "kleurendruk (prent)"@nl;
