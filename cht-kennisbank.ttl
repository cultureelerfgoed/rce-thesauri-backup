<https://data.cultureelerfgoed.nl/term/id/cht/fa5f0532-94d8-4e56-b01a-4cf0ecdf854b>
  a skos:Concept;
  skos:prefLabel "negatiefdrukken"@nl;
  skos:scopeNote "Fotografische afdrukken waarin de tonen of kleuren het tegenovergestelde zijn van hun natuurlijke verschijning. (AAT-Ned)"@nl;
