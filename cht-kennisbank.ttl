<https://data.cultureelerfgoed.nl/term/id/cht/e9d7003f-346e-467f-a3dd-2d55ceef17d3>
  a skos:Concept;
  skos:prefLabel "pitotbuizen"@nl;
  skos:scopeNote "Pitotbuizen worden in vliegtuigen gebruikt om de luchtsnelheid te bepalen. IJsvorming in pitotbuizen kan tot onjuist werkende snelheidsmeters leiden. Om dit te voorkomen worden pitotbuizen vaak van een verwarmingselement voorzien."@nl;
  skos:altLabel "pitotbuis"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/8b7968f6-8e6a-47f8-9e1c-90df9ea86573>;
