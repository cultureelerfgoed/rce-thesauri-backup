<https://data.cultureelerfgoed.nl/term/id/cht/b172e3a6-ce45-4303-b50e-d60d6958b5cd>
  a skos:Concept;
  skos:prefLabel "stalgebouwen"@nl;
  skos:scopeNote "Gebouwen of delen van gebouwen voor het huisvesten en voeren van paarden, koeien en ander vee, ook voor het opslaan van rij-uitrustingen en voertuigen, en soms met de woonverblijven van betrokken personeel. Gebruik bijvoorbeeld 'paardenschuren' of 'koestallen' voor specifieke doeleinden. (AAT-Ned)"@nl;
  skos:altLabel "stalgebouw"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/41ae98cd-0cc4-438a-8032-3c6ee1429b8d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6ddd3e15-f79c-4920-aa29-2b7a6e0e7357>
  a skos:Concept;
  skos:prefLabel "sanders"@nl;
  skos:scopeNote "Sanders zijn fluvioglaciale puinwaaiers afgezet in het ijsvrije gebied voor of naast een gletsjer en waarover het smeltwater in sterk verwilderde stromen wegloopt. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "sander"@nl, "spoelzandvlaktes"@nl, "spoelzandvlakte"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2971af0-cde7-4888-b828-33443f702e7d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/abef2819-0985-4bcb-84f5-f4d767a0fd56>
  a skos:Concept;
  skos:prefLabel "versnijdingen"@nl;
  skos:scopeNote "Versnijdingen zijn lichte sprongen in metselwerk, meestal van een fundering, waardoor deze op een bredere voet komt te rusten. Overeenkomstig aan insnoering of versmalling van opgaand metselwerk, b.v. aan steunberen en torens. (Haslinghuis)"@nl;
  skos:altLabel "schrading"@nl, "schradingen"@nl, "snijding"@nl, "snijdingen"@nl, "snijdingensnijding"@nl,
    "versnijding"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/04770e4f-1c11-40e7-a256-9de8c6d569c6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f4e9eec3-2f0e-4682-adf6-82ef8224dc59>
  a skos:Concept;
  skos:prefLabel "ontsluitingen"@nl;
  skos:scopeNote "Een ontsluiting is de plaats waar de ondergrond zichtbaar is, zoals in een groeve, bouwput of bij een steile beekoever."@nl;
  skos:altLabel "ontsluiting"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2971af0-cde7-4888-b828-33443f702e7d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f0bc9b3f-3867-472f-8d20-a604100991d1>
  a skos:Concept;
  skos:prefLabel "onderlanen"@nl;
  skos:scopeNote "Onderlanen zijn balken die ter hoogte van de tasvloer buiten om de roeden lopen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "onderlaan"@nl, "onderlan"@nl, "onderlannen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dccd162d-8105-4e95-a90d-7a67d4d41a3a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/7d810422-8aae-48e3-ae8b-4767f4f8e7ff>
  a skos:Concept;
  skos:prefLabel "Augustijnenkloosters"@nl;
  skos:scopeNote "Augustijnenkloosters zijn kloosters waarin de Reguliere Kanunniken van Sint-Augustinus leefden. Deze gemeenschappen volgden de regel van Augustinus en richtten zich op een combinatie van religieus leven en pastorale zorg. Ze ontstonden in de 11e eeuw en verspreidden zich door Europa. Augustijnenkloosters zijn te herkennen aan een sobere architectuur en waren vaak verbonden aan kerken of onderwijsinstellingen."@nl;
  skos:altLabel "Augustijnenklooster"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c627ea74-ed43-4327-b8fb-f46f759e5ff4>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/809299dd-b690-401b-94c7-3edac3fcf175>
  a skos:Concept;
  skos:prefLabel "bladlood"@nl;
  skos:scopeNote "Dun, ondoordringbaar materiaal dat geplaatst wordt in bouwwerken om te voorkomen dat er water binnenkomt en/of om waterdrainage aan te brengen, over het algemeen geplaatst tussen dak en muur en boven buitendeuren en -ramen. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4e481c81-319a-44da-86bf-106f145d22c1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/713582cd-0904-4a61-a94f-015689506aa6>
  a skos:Concept;
  skos:prefLabel "vier-iwanmoskeeën"@nl;
  skos:scopeNote "Moskeeën met een plattegrond die vier iwans omvat, dat zijn grote gewelfde zalen. (AAT)"@nl;
  skos:altLabel "vier-iwanmoskee"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b44d8b93-21b9-4c5d-bde2-5496636d35eb>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ce174fa8-f7b8-48d3-898c-a477c06a7fb7>
  a skos:Concept;
  skos:prefLabel "straatverlichting"@nl;
  skos:scopeNote "Straatverlichting is te vinden langs de weg en op andere plaatsen in de openbare ruimte zoals in parken. (Wikipedia)"@nl;
  skos:altLabel "straatverlichtingen"@nl, "openbare verlichting"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/45a74ae2-8946-4fec-a6fb-e8cdefed17c6>;
