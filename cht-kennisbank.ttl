<https://data.cultureelerfgoed.nl/term/id/cht/61da010e-bdb8-4950-a803-923bbbbaea05>
  a skos:Concept;
  skos:prefLabel "hennepvilt"@nl;
  skos:scopeNote "Hennepvilt is een vilt dat hoofdzakelijk van hennep is gemaakt. Hennepvilt gedrenkt in teer is toegepast als een bitumineuze dakbedekking."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/70b2da84-0d06-438f-a809-5d76078d4fa4>;
