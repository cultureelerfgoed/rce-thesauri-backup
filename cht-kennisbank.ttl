  a skos:Concept;
  skos:prefLabel "oliekelders"@nl;
  skos:scopeNote "Oliekelders zijn kelders die zijn ingericht voor de opslag van olie, vaak met stenen muren en vloeren om de olie veilig en koel te bewaren."@nl;
