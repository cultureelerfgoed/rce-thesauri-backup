<https://data.cultureelerfgoed.nl/term/id/cht/dd0f4e99-6cc1-4ad1-bc78-8a9ed8827248>
  a skos:Concept;
  skos:prefLabel "breimachines"@nl;
  skos:scopeNote "Verwijst naar exemplaren van de breimachine zoals uitgevonden door William Lee uit Cambridge (Engeland) in 1589. De machine produceerde een breisel met een rechte steek kon dus breien met de hand vervangen. De invoering van deze technologie gaf de aanzet tot de mechanisatie van de textielindustrie. (AAT)"@nl;
  skos:altLabel "breimachine"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dee127ef-f0a9-47bf-8c61-ad40233610cc>;
