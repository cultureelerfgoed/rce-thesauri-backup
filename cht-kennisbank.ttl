<https://data.cultureelerfgoed.nl/term/id/cht/11036d5c-29b6-48eb-b2fa-69d090c1f0fd>
  a skos:Concept;
  skos:prefLabel "strijkbouten"@nl;
  skos:scopeNote "Apparaten, meestal met een tamelijk zware, platte metalen basis, die kunnen worden verhit en gebruikt om stukken stof glad te maken, af te werken of te persen. (AAT-Ned)"@nl;
