  skos:scopeNote "Dameshoed, meestal met linten en geplooid kant."@nl;
  skos:altLabel "kapothoeden"@nl, "kapothoed"@nl, "oorijzerhoed"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d67d07d9-1a96-4504-a76b-a962d012df8c>;
