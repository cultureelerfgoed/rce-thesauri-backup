<https://data.cultureelerfgoed.nl/term/id/cht/b59a035e-cd14-4658-9f12-91b8c6d73c80>
  a skos:Concept;
  skos:prefLabel "afdelingen (begraafplaats)"@nl;
  skos:scopeNote "Afdelingen zijn eenheden waaruit een aanleg van een begraafplaats is opgebouwd. Een afdeling is vaak naar klasse, grootte van de graven of bestemming ingedeeld. Een afdeling kan bestaan uit meerdere grafperken. Gebruikelijk is dat de afdelingen genummerd worden naar klasse. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "afdeling (begraafplaats)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ebfd7cd7-7a9c-4832-8672-59dfdba61f5d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f67ff3a8-630f-4b0b-bdcc-e0520e48b498>
  a skos:Concept;
  skos:prefLabel "oordjesnagels"@nl;
  skos:scopeNote "Lange dikke nagel die een oordje per stuk kostte. (Haslinghuis)"@nl;
  skos:altLabel "oordjesnagel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6f8bf719-083b-482e-bc3d-85e91fbabcdf>;
