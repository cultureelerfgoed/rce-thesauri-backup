<https://data.cultureelerfgoed.nl/term/id/cht/14d6fb63-53ca-4024-9de3-11d84203e84f>
  a skos:Concept;
  skos:prefLabel "turfgraven"@nl;
  skos:scopeNote "Het exploiteren van veen; ook: plaats (land of water) waar het veen vergraven of gebaggerd wordt; veenpolder."@nl;
