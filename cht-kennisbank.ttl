<https://data.cultureelerfgoed.nl/term/id/cht/50f7f423-83ad-4dce-ab43-5d4b9eaf17b3>
  a skos:Concept;
  skos:prefLabel "weiden"@nl;
  skos:scopeNote "Een weide is een stuk open grasland dat gebruikt wordt om vee te laten grazen. Weiden kunnen in cultuur gebracht zijn en bij een boerderij horen, maar ook in het wild is veel grasland."@nl;
  skos:altLabel "weilanden"@nl, "wei"@nl, "weide"@nl, "weien"@nl, "weiland"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4e188c67-9c81-4381-8ab8-72019092215d>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/cc21e511-478c-4ded-bc55-3192329f675b>,
    <https://data.cultureelerfgoed.nl/term/id/cht/828ab8cf-c903-4aaf-ab99-f764697c83c6>,
