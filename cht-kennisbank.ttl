<https://data.cultureelerfgoed.nl/term/id/cht/ba34cf54-78bc-4e69-802e-efc1d217f2c3>
  a skos:Concept;
  skos:prefLabel "versnellingsmeters"@nl;
  skos:scopeNote "Een versnellingsmeter is een meetapparaat dat een versnelling kan registreren en meten. Het wordt onder andere gebruikt in de seismologie om de trillingen van de aarde in het gebied dicht bij het epicentrum te meten."@nl;
  skos:altLabel "versnellingsmeter"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/36963dcd-7f11-4902-8e8e-91eb92ad8ffd>;
