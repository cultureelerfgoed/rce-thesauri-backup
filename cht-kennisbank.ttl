<https://data.cultureelerfgoed.nl/term/id/cht/0ee595ec-faf2-493b-aa1a-16161de036de>
  a skos:Concept;
  skos:prefLabel "Slag op de Zuiderzee"@nl;
  skos:scopeNote "De Slag op de Zuiderzee op 11 oktober 1573 was een treffen tussen de watergeuzen en een Spaanse vloot, dat werd gewonnen door de watergeuzen. (Wikipedia)"@nl,
    "De Slag op de Zuiderzee op 11 oktober 1573 was een treffen tussen de watergeuzen en een Spaanse vloot, dat werd gewonnen door de watergeuzen. (Wikipedia) "@nl;
