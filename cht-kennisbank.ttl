<https://data.cultureelerfgoed.nl/term/id/cht/08a6a654-7e6d-4ea8-b1ba-6a364ddb2457>
  a skos:Concept;
  skos:prefLabel "houtsnijders"@nl;
  skos:scopeNote "Vertegenwoordiger van een vrij ambacht, bedreven in het uit de hand snijden van figuren uit hout. De ordonnantie van het Amsterdamse Sint-Lucasgilde uit 1579 onderscheidt beeldsnijders en figuursnijders. Elders worden ook antieksnijders genoemd. Het was meubelmakers of schrijnwerkers verboden vrij uit de hand snijwerk te maken. (Haslinghuis)"@nl;
  skos:altLabel "houtsnijder"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db4a7619-d236-4b14-8e79-b4a6e890f677>;
