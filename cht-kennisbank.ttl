<https://data.cultureelerfgoed.nl/term/id/cht/5ce2af3e-0b1d-406f-882e-65317484f85a>
  a skos:Concept;
  skos:prefLabel "campêchehout"@nl;
  skos:scopeNote "Campêchehout is een tropische houtsoort die bekend staat om zijn hardheid en wordt vaak gebruikt in de meubelindustrie en voor het winnen van kleurstoffen."@nl;
