<https://data.cultureelerfgoed.nl/term/id/cht/f79404b2-721b-4d34-87b4-f0c7793054d1>
  a skos:Concept;
  skos:prefLabel "kneppelkogels"@nl;
  skos:scopeNote "Twee kogels verbonden door een staaf, gemaakt in de vorm van een halter om al slingerend zoveel mogelijk schade aan te brengen aan masten en tuigages van schepen. (MARDOC)"@nl;
  skos:altLabel "staafkogels"@nl, "staafkogel"@nl, "kneppelkogel"@nl;
