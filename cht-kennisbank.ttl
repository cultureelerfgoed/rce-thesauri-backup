<https://data.cultureelerfgoed.nl/term/id/cht/43e3f59e-131d-444b-a74b-af5b752a6de7>
  a skos:Concept;
  skos:prefLabel "ommantelingen"@nl;
  skos:scopeNote "De ommantelingen schermen de inhoud van de reservoirs af van zowel lucht als licht. Dit houdt de kwaliteit van het drinkwater op peil. De ommanteling voorkomt verontreiniging van het drinkwater door insecten, vogels of stof en weert het daglicht om algengroei te voorkomen. (Henk van der Veen, Watertorens in Nederland. 1994, p. 30)"@nl;
  skos:altLabel "ommanteling"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ba4b10ae-c486-42a4-82f8-3417c6a8a4cc>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8bfb06fa-5b15-49e0-bd3c-5242304c4d1b>
  a skos:Concept;
  skos:prefLabel "paslagen"@nl;
  skos:scopeNote "Bovenste laag metselwerk van een fundament, die waterpas is gelegd. (Haslinghuis)"@nl;
  skos:altLabel "paslaag"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/945e379c-8dd5-4731-8e75-5f3c2b99e104>;
