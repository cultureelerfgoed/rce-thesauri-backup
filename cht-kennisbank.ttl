<https://data.cultureelerfgoed.nl/term/id/cht/956af9eb-8510-4e2f-802c-4a9a6185d8ce>
  a skos:Concept;
  skos:prefLabel "accoladebogen"@nl;
  skos:scopeNote "Accoladebogen zijn bogen waarvan de beide delen licht in- en uitgezwenkt zijn (maar niet hellend als bij de kielboog) en bij hun snijding een spits vormen. De accoladeboog komt veel voor in de late gotiek en is vermoedelijk afkomstig uit de Engelse ‘curvilinear’ stijl."@nl;
  skos:altLabel "accoladeboog"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/99635227-1a61-42ef-9f38-a937146a0de4>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/49d76a12-d24a-47be-b59b-56293c0e8846>
  a skos:Concept;
  skos:prefLabel "sluitingen"@nl;
  skos:scopeNote "Instrument, werktuig om een deur of raam te sluiten, slot. (Haslinghuis)"@nl;
  skos:altLabel "sluiting"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/04770e4f-1c11-40e7-a256-9de8c6d569c6>;
