  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3f1dddbd-7e08-488b-88d7-86ab48251108>
  a skos:Concept;
  skos:prefLabel "visfuiken"@nl;
  skos:scopeNote "Visfuiken zijn aan hoepels gespannen toelopende visnetten, waarin zich trechtervormige delen, kelen of inkels, bevinden en eindigend in een soort van dichtgesnoerde zak, de kruik of kubbe. Vaak voorzien van uitstaande vleugels aan de eerste hoepel. Wanneer twee fuiken elk met één vleugel met de ander verbonden is, dan spreekt men van een schietfuik. (www.debinnenvaart.nl)"@nl;
  skos:altLabel "visfuik"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
