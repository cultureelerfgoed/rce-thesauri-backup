  a skos:Concept;
  skos:prefLabel "opzendingen"@nl;
  skos:scopeNote "Rijtuig(en)/loc(s) die mee worden gevoerd in een trein zonder dat deze in dienst zijn en/of tractie leveren; in opzending"@nl;
