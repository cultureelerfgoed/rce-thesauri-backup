<https://data.cultureelerfgoed.nl/term/id/cht/dd405ebe-62f7-49ed-a783-b10d57be42d8>
  a skos:Concept;
  skos:prefLabel "grafheuvels"@nl;
  skos:scopeNote "Grafheuvels zijn heuvels die zijn opgeworpen boven een graf of een aantal graven. (Thesaurus landschap)"@nl;
