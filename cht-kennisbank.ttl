  a skos:Concept;
  skos:prefLabel "orgelbouwers"@nl;
  skos:scopeNote "Zij die orgels ontwerpen en bouwen en ook vaak tijdens het installeren van de grotere modellen advies geven en toezicht houden. (AAT)"@nl;
