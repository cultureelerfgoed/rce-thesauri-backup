<https://data.cultureelerfgoed.nl/term/id/cht/fc8ed02b-b2c4-44cb-a39f-8531968c1e43>
  a skos:Concept;
  skos:prefLabel "zakbalgen"@nl;
  skos:scopeNote "De zak(magazijn)balg heeft geen houten vouwen zoals een magazijnbalg en schepbalg maar een grote lerenzak als windreservoir. De constructie is daardoor eenvoudiger dan die van de balg met in- en uitslaande vouwen.(bron: Muziekindex.nl)"@nl;
  skos:altLabel "zakbalg"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/738ccaaf-b35f-4872-8d3a-ca2575a8a60b>;
