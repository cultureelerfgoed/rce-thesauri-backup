<https://data.cultureelerfgoed.nl/term/id/cht/c634927b-c12e-4095-93c0-15d6311e6457>
  a skos:Concept;
  skos:prefLabel "toestand"@nl;
  skos:scopeNote "De (conserverings)toestand van een voorwerp wordt bepaald door de mate waarin de originele onderdelen bewaard zijn en door de fysieke staat ervan."@nl;
