<https://data.cultureelerfgoed.nl/term/id/cht/8f8c444d-b016-4139-b5a8-fa3fdb9aae41>
  a skos:Concept;
  skos:prefLabel "matronikonen"@nl;
  skos:scopeNote "Vrouwengalerij in synagogen (door rasterwerk afgezonderd) en vroegchristelijke kerken (vaak aan de noordzijde). In het Westen sinds ix ongebruikelijk, in oosterse kerken nog in gebruik. Het kon aanvankelijk zowel gelijkvloers als op de verdieping liggen. (Haslinghuis)"@nl;
  skos:altLabel "matronikon"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/42b9f405-fd7e-49a8-9dee-cc1cd4b007b3>;
