  a skos:Concept;
  skos:prefLabel "kachelplaten"@nl;
  skos:scopeNote "Gietijzeren rechthoekige platen die, wanneer met bouten of op andere wijze aan elkaar gemonteerd, deel uitmaken van een vijf-plaat, zes-plaat, of tien-plaats houtkachel. Kachelplaten bestemd voor de voor-en zijkanten van de kachels werden vaak versierd in bas-reliëf, vooral met Bijbelse scènes of tekst. (AAT-Ned)"@nl;
  skos:altLabel "kachelplaat"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4cb301f5-3dc9-4595-85cf-54f2ecf8a6aa>;
