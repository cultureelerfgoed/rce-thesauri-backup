<https://data.cultureelerfgoed.nl/term/id/cht/30ea0a55-0c5c-44a3-b1e4-9f9f154b0fbc>
  a skos:Concept;
  skos:prefLabel "siergevels"@nl;
  skos:scopeNote "Loze topgevel, opzetgevel, aangebracht om een plat of weinig hellend dak te maskeren. Gewoonlijk in de vorm van een trap, klok- of tuitgevel. (Haslinghuis)"@nl;
  skos:altLabel "siergevel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/075a35fd-b879-45b4-9f97-b8c1f38bcbca>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b27193e0-f787-4a96-9db9-2b7da037bbfa>
  a skos:Concept;
  skos:prefLabel "tweeschalensysteem"@nl;
  skos:scopeNote "Spouwing of splitsing in de dikte van dragende muren voor venstergalerijen, triomfgangen en gewelfdragers. Het systeem kwam op in de periode van het laatromaans en de vroege gotiek. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4e481c81-319a-44da-86bf-106f145d22c1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8f8ed060-ca58-42b4-b410-c7662802a864>
  a skos:Concept;
  skos:prefLabel "Palladiostijl"@nl;
  skos:scopeNote "Classicistische bouwtrant (classicisme), gebruik makend van de (zie) kolossale orde zoals die door Andrea Palladio (1508-’80) werd toegepast. Men kan b.v. de voorgevel van het Trippenhuis te Amsterdam (Justus Vingboons, 1662) en het stadhuis van Groningen (Jacob Otten Husly, 1802-’10) uitingen van de Palladiostijl noemen.(Haslinghuis)"@nl;
  skos:altLabel "Palladianisme"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/946e80a3-fd4a-4187-ae44-fb5551489b42>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ca02e699-80f2-4a7c-a75f-3e92278a8f92>
  a skos:Concept;
  skos:prefLabel "gaatpannen"@nl;
  skos:scopeNote "Gaatpannen zijn keramische pannen waar in het midden een opening is uitgespaard voorzien van een sponning waarin een glasplaat kan worden aangebracht. Gebruikt voor de verlichting van zolders."@nl;
  skos:altLabel "gaatpan"@nl, "gehakte pan"@nl, "gehakte pannen"@nl, "lichtpan"@nl,
    "lichtpannen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f1834398-e32b-4a85-acf4-7f71ab3f94d1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/1500217a-b06d-4e20-9b17-a903d49896cc>
  a skos:Concept;
  skos:prefLabel "contrescarpkoffers"@nl;
  skos:scopeNote "Kazemat, aangebracht in een hoek van de contrescarp (muur), voor het bestrijken van de droge gracht. (Stichting Menno van Coehoorn)"@nl;
  skos:altLabel "contrescarpkoffer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/97ff463f-06cf-49cd-aa33-08e3c2688f5a>;
