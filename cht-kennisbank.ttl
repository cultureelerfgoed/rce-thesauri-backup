<https://data.cultureelerfgoed.nl/term/id/cht/1457265b-3df5-4cdd-b321-417a5f621ef7>
  a skos:Concept;
  skos:prefLabel "Jezuïetencolleges"@nl;
  skos:scopeNote "Jezuïetencolleges zijn scholen die worden beheerd door de jezuïetenorde, een rooms-katholieke religieuze orde. Ze bieden een breed curriculum aan en hebben vaak een historische rol in het onderwijs."@nl;
  skos:altLabel "Jezuïetencollege"@nl, "Jezuïetenscholen"@nl, "Jezuïetenschool"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f6451643-0a3a-4077-a19c-d6a30a4e2583>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/00817a4d-33c4-4fa3-981d-21f18744ef8f>
  a skos:Concept;
  skos:prefLabel "algemeen bijzonder onderwijs"@nl;
  skos:scopeNote "Algemeen bijzonder onderwijs betreft scholen zonder religieuze grondslag, die wel op bijzondere wijze zijn ingericht en vallen onder particulier bestuur."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f6451643-0a3a-4077-a19c-d6a30a4e2583>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/99be5db1-aca0-4f2c-bf18-5db8e3cba399>
  a skos:Concept;
  skos:prefLabel "burgeravondscholen"@nl;
  skos:scopeNote "Burgeravondscholen zijn scholen die buiten reguliere schooluren lessen aanbieden, speciaal gericht op volwassenen en werkende jongeren."@nl;
  skos:altLabel "burgeravondschool"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f6451643-0a3a-4077-a19c-d6a30a4e2583>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d44d74c7-d713-493e-838c-6d7493ed4878>
  a skos:Concept;
  skos:prefLabel "dansscholen"@nl;
  skos:scopeNote "Dansscholen zijn scholen waar verschillende stijlen van dans worden onderwezen, variërend van klassiek ballet tot moderne dans, en zijn gespecialiseerd in beweging en expressie."@nl;
  skos:altLabel "dansschool"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f6451643-0a3a-4077-a19c-d6a30a4e2583>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f3663c76-f1d2-4da9-9a83-46dde5b84ba2>
  a skos:Concept;
  skos:prefLabel "hoekscholen"@nl;
  skos:scopeNote "Hoekscholen zijn historische scholen die werden opgericht op hoeken van straten in stadscentra, bedoeld om toegankelijk onderwijs te bieden aan stadsbewoners. Een hoekschool ligt op de hoek van twee straten, waarbij twee haaks geplaatste vleugels de straten volgen, en de ingang op de hoek is."@nl;
  skos:altLabel "hoekschool"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f6451643-0a3a-4077-a19c-d6a30a4e2583>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/7ad21321-26df-49d4-b8fb-6a3dd5f82dd6>
  a skos:Concept;
  skos:prefLabel "jongensscholen"@nl;
  skos:scopeNote "Jongensscholen zijn scholen waar alleen jongens worden toegelaten, met een curriculum dat vaak is afgestemd op de ontwikkeling en interesses van jongens."@nl;
  skos:altLabel "jongensschool"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f6451643-0a3a-4077-a19c-d6a30a4e2583>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/876a6ea9-e601-47ce-8c4a-76dc26d4ef2b>
  a skos:Concept;
  skos:prefLabel "kapittelscholen"@nl;
  skos:scopeNote "Kapittelscholen zijn historische scholen die verbonden waren aan kerkelijke kapittels en die onderwijs verzorgden voor toekomstige geestelijken."@nl;
  skos:altLabel "kapittelschool"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f6451643-0a3a-4077-a19c-d6a30a4e2583>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f29904f3-dbed-46cb-a5ba-19b0ba458bb9>
  a skos:Concept;
  skos:prefLabel "kloosterscholen"@nl;
  skos:scopeNote "Kloosterscholen zijn scholen geleid door kloosterorden, waar naast regulier onderwijs ook religieuze vorming een belangrijke rol speelt."@nl;
  skos:altLabel "kloosterschool"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f6451643-0a3a-4077-a19c-d6a30a4e2583>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4daaa450-981d-4427-8613-68bd2ad829ea>
  a skos:Concept;
  skos:prefLabel "meisjesscholen"@nl;
  skos:scopeNote "Meisjesscholen zijn scholen exclusief voor meisjes, met een curriculum dat vaak rekening houdt met de specifieke ontwikkeling en behoeften van meisjes."@nl;
  skos:altLabel "meisjesschool"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f6451643-0a3a-4077-a19c-d6a30a4e2583>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/0b85a321-b8b0-4d17-ae83-c8b25f30ac8a>
  a skos:Concept;
  skos:prefLabel "montessorischolen"@nl;
  skos:scopeNote "Montessorischolen zijn scholen die het Montessoriconcept hanteren, waarbij het kind centraal staat en leren door zelfontdekking wordt gestimuleerd."@nl;
  skos:altLabel "montessorischool"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f6451643-0a3a-4077-a19c-d6a30a4e2583>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/5025316d-3e6c-41be-a13e-4e8906b9a7ee>
  a skos:Concept;
  skos:prefLabel "naaischolen"@nl;
  skos:scopeNote "Naaischolen zijn scholen die zich richten op het aanleren van naaivaardigheden en handwerken, vaak speciaal gericht op meisjes of vrouwen."@nl;
  skos:altLabel "naaischool"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f6451643-0a3a-4077-a19c-d6a30a4e2583>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/39d112a8-5164-4b28-b006-29462131831b>
  a skos:Concept;
  skos:prefLabel "polytechnische scholen"@nl;
  skos:scopeNote "Polytechnische scholen zijn technische onderwijsinstellingen waar studenten worden opgeleid in diverse technische en toegepaste wetenschappen."@nl;
  skos:altLabel "polytechnische school"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f6451643-0a3a-4077-a19c-d6a30a4e2583>;
