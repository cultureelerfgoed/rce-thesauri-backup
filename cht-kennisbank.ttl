    <https://data.cultureelerfgoed.nl/term/id/cht/d0c89e84-334b-4733-8577-ba763cb220fd>,
    <https://data.cultureelerfgoed.nl/term/id/cht/52d41fd6-3117-4c90-86ce-4fcea2513fb6>,
    <https://data.cultureelerfgoed.nl/term/id/cht/5ecccb43-a3d5-4138-9754-a24d23c26b69>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e704d349-86c8-4eb6-849d-2e46aa4eee59>
  a skos:Concept;
  skos:prefLabel "Duits formaat"@nl;
  skos:scopeNote "Duits formaat is een vorm baksteen die c. 24 x 11,5 x 52 cm meet. Onder andere Silezische stenen zijn in dit formaat te vinden."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bbe4a82c-d0af-42c9-86c2-cca2e9560bac>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e71987cf-4d70-48b8-b44e-38359bc1a838>
  a skos:Concept;
  skos:prefLabel "ontwikkelingsschade"@nl;
  skos:scopeNote "Ontwikkelingsschade is het bederf dat door (een gebrek aan) ruimtelijke ordening kan optreden, vooral in open gebied en bij bebouwing, maar ook in andere landschappelijke opzichten."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cea5f41e-f9e4-42a3-a2e4-b0a0977bfa39>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e7217e21-ca23-4415-adac-0db776330c08>
  a skos:Concept;
  skos:prefLabel "Archeoderm"@nl;
  skos:scopeNote "Archeoderm is een polyvinylchloride (PVC) gebruikt voor de versteviging van archeologische vondsten. Het verving Derm-o-plast in jaren’70."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/277f3c66-db8b-4dbd-b153-55952f65d7e5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e75c2d1c-18da-41d3-b2c4-91b9c7b22525>
  a skos:Concept;
  skos:prefLabel "S-VHS"@nl;
  skos:scopeNote "S-VHS staat voor Super Video Home System, een videoformaat voor niet-professionele videocamera's, van een betere kwaliteit dan gewone VHS banden. (Conservation Dictionary)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/803bc11d-2768-4154-954f-34321916e749>;
