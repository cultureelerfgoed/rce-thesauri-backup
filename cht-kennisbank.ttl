<https://data.cultureelerfgoed.nl/term/id/cht/13fb82f6-51c8-47f1-a22b-0474adc44ebf>
  a skos:Concept;
  skos:prefLabel "vermetgutsen"@nl;
  skos:scopeNote "Lange, smalle gutsen waarvan het snijvlak aan de holle kant is afgeschuind. Worden gebruikt om hout te bewerken. (AAT)"@nl;
