<https://data.cultureelerfgoed.nl/term/id/cht/3317ac73-0b4e-4c32-bced-3d0bdf62255e>
  a skos:Concept;
  skos:prefLabel "ruitenwisserbladen"@nl;
  skos:scopeNote "Een rubber wisserblad, dat op een demontabele en flexibele metalen rug is bevestigd, veegt de ruit schoon. Het wisserblad is op de wisserarm bevestigd en deze op zijn beurt op de as van de ruitenwissermotor."@nl;
  skos:altLabel "ruitenwisserblad"@nl, "wisserblad"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0271e914-a42e-47da-9143-a9427564e248>;
