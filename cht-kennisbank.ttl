<https://data.cultureelerfgoed.nl/term/id/cht/e8dabc3c-c54a-4ab8-83e0-ffd8baa6e6f2>
  a skos:Concept;
  skos:prefLabel "feodalisering"@nl;
  skos:scopeNote "Feodalisering is het overgaan tot een feodaal stelsel. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
