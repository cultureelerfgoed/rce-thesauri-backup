<https://data.cultureelerfgoed.nl/term/id/cht/84392fc6-b99a-44f5-bae2-f6fa640072ad>
  a skos:Concept;
  skos:prefLabel "loodnet"@nl;
  skos:scopeNote "Het geheel van loodprofielen en soldeerpunten dat de diverse glasstukken in een glas-in-loodpaneel bij elkaar houdt. (Werkgroep Vlakglas)"@nl;
  skos:altLabel "loodpatroon"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2bb9e948-a44c-458d-824b-031b81d443e0>;
