<https://data.cultureelerfgoed.nl/term/id/cht/5116df0a-3806-46aa-8274-4cc99400078f>
  a skos:Concept;
  skos:prefLabel "uiterwaarden"@nl;
  skos:scopeNote "Een uiterwaard is het buitendijkse, vrijwel vlakke gebied tussen de winterdijken van een rivier dat bij hoog water onder water loopt. Uiterwaarden zijn ontstaan door de aanleg van rivierdijken, die vanaf circa 1000 na Chr. in Nederland worden aangelegd. (Jongmans et al. 2013/Stouthamer et al. 2015)"@nl;
  skos:altLabel "uiterwaarde"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/41d0db11-7cd2-4cbb-b885-cc763b01298d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d6eef960-5cb5-4dd5-b68d-cc1929ed20c0>
  a skos:Concept;
  skos:prefLabel "graven (bouwwerk)"@nl;
  skos:scopeNote "Graven zijn uitgravingen in de grond die worden gebruikt voor het begraven van stoffelijke overschotten. Het woord wordt vaak ten onrechte gebruikt als men spreekt over grafmonument. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "graf"@nl, "grafstedes"@nl, "grafstede"@nl;
