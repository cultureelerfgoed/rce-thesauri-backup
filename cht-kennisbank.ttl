<https://data.cultureelerfgoed.nl/term/id/cht/aa80794d-a052-460b-8fcc-1d8d6f1ac801>
  a skos:Concept;
  skos:prefLabel "druipen"@nl;
  skos:scopeNote "Druipen is de afscheiding van (verkleurde olie) bindmiddel met of zonder pigment. Dit leidt tot lange druipsporen over de drager en soms tot opeenhopingen van verf langs de bovenrand van impasto of langs de onderrand van een schilderij."@nl;
  skos:altLabel "druipende verf"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/19a4249c-f03b-4c4c-9806-45c04fb0bceb>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/9fde7c3c-bbde-42ad-a320-d2352913ef30>
  a skos:Concept;
  skos:prefLabel "slaglijnen"@nl;
  skos:scopeNote "Lijn waarmee een opgerold zeil aan een ra of aan een molenwiek wordt vastgelegd. (MARDOC)"@nl,
    "Lang touw waarmee het zeil wordt vastgezet. 3/8 henneptouw (9,5 mm). (Molenwoordenboek B.D. Poppen)"@nl,
    "(Zaans) Drie of vier lijnen om het achterlijk van het zeil op het hekwerk te kunnen vastmaken."@nl;
  skos:altLabel "schinkellijnen"@nl, "schinkellijn"@nl, "scheerlijn"@nl, "scheerlijnen"@nl,
