<https://data.cultureelerfgoed.nl/term/id/cht/f31196f9-044f-4408-9442-c08a560eefc0>
  a skos:Concept;
  skos:prefLabel "processieparken"@nl;
  skos:scopeNote "Processieparken zijn parken in overwegend zuidelijk Nederland aangelegd om religieuze processies te kunnen houden. De parken bevatten religieuze ornamenten zoals kruiswegstaties, Lourdesgrotten, kapellen en calvariebergen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "processiebos"@nl, "processiebossen"@nl, "processiepark"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c65f0763-e45f-4cb4-9ca5-73873027c67c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b43a795e-03d3-4702-83fb-6a8aa16579d2>
  a skos:Concept;
  skos:prefLabel "noodstallen (schuren)"@nl;
  skos:scopeNote "Noodstallen zijn stallen die in geval van nood een tijdelijk onderkomen bieden aan vee. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "noodschuren"@nl, "noodschuur"@nl, "noodstal (schuren)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c8a9451e-9ee0-43ae-99b8-5066f8aab68b>;
