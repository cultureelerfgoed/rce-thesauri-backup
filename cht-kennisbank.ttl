<https://data.cultureelerfgoed.nl/term/id/cht/fea45064-03ad-4571-a756-f100639049c9>
  a skos:Concept;
  skos:prefLabel "veervormige craquelure"@nl;
  skos:scopeNote "Veervormige craquelure is een glazuurdefect dat leidt tot matte delen in de glazuur. Het verschijnsel ontstaat door de afzetting van calciumsulfaat tijdens het branden."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/88668eb7-491c-4565-b2b1-58ecd149f506>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fec7a15c-d26a-49b7-83d1-01955fb23d84>
  a skos:Concept;
  skos:prefLabel "beeldovergangen"@nl;
  skos:scopeNote "Een beeldovergang is de verandering van een filmscène naar de volgende. Zie ook ruwe montage en eindmontage."@nl;
  skos:altLabel "beeldovergang"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5f4c4bef-a5c2-4d8e-ad2a-88b04f93f3dc>;
