<https://data.cultureelerfgoed.nl/term/id/cht/97aa5105-acee-4717-90b4-8cccfa310925>
  a skos:Concept;
  skos:prefLabel "stifthouders"@nl;
  skos:scopeNote "IJzeren staaf met hol ondereinde. In de opening wordt een potlood of andere stift gestoken dat wordt vastgeklemd door een of twee ringen naar beneden te schuiven."@nl;
  skos:altLabel "stifthouder"@nl;
