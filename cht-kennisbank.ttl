<https://data.cultureelerfgoed.nl/term/id/cht/fb082808-4325-49b6-a068-ec7e4ed1a887>
  a skos:Concept;
  skos:prefLabel "lagen"@nl;
  skos:scopeNote "Lagen zijn reeksen aaneengevoegde stenen van gelijke dikte op hun plat, horizontaal, soms in hellende stand of op hun kant (rollaag) gelegd. De hoogte van bakstenen metselwerk wordt naar het aantal lagen opgegeven. Een laag waarin alleen de korte zijden van de bakstenen zichtbaar zijn, heet een koppenlaag. die waarin alleen de lange zijden vertonen noemt men een strekkenlaag. (Haslinghuis)"@nl;
  skos:altLabel "laag"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/945e379c-8dd5-4731-8e75-5f3c2b99e104>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/ebdcedb4-d7cc-418a-85f3-cf9626d1672b>,
    <https://data.cultureelerfgoed.nl/term/id/cht/51da96e2-71a3-414a-88a2-bdf00370f970>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4befec32-5046-4530-bba3-045eb8179d35>
  a skos:Concept;
  skos:prefLabel "spatzolders"@nl;
  skos:scopeNote "Spatzolders zijn zolders waar ongewenste vogels, zoals spreeuwen of duiven, werden gehouden of tegengehouden, vaak voorzien van netten of andere afsluitingen."@nl;
  skos:altLabel "spatzolder"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f0e4821c-e4ec-49cc-bdf5-66a206c63f69>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d28b72e3-eb50-45b3-a216-95ddca8a84df>
  a skos:Concept;
  skos:prefLabel "cordonata's"@nl;
  skos:scopeNote "Zacht stijgende opgang, rampe of trap, vaak voor kerken en grote landhuizen in Italië, of leidend naar een plein, zoals de ‘cordonata di Giacomo della Porta’ naar het Capitool in Rome (1576). (Haslinghuis)"@nl;
  skos:altLabel "cordonata"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/45a74ae2-8946-4fec-a6fb-e8cdefed17c6>;
