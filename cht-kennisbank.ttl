<https://data.cultureelerfgoed.nl/term/id/cht/97d9aa8a-e64b-4c21-b6da-cbcebdc3fb3f>
  a skos:Concept;
  skos:prefLabel "leidammen"@nl;
  skos:scopeNote "Stroomleidende dammen of hoofden m.n. rijsdammen om de schurende werking te verbeteren. (MARDOC)"@nl;
