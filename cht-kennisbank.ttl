<https://data.cultureelerfgoed.nl/term/id/cht/c27e05ea-7816-4047-935e-1e1839971f49>
  a skos:Concept;
  skos:prefLabel "vervormbare stuurkolommen"@nl;
  skos:scopeNote "Stuurkolom die zo is geconstrueerd, dat de kolom ineen schrompelt of vervormt in geval van een ernstige frontale aanrijding."@nl;
  skos:altLabel "veiligheidsstuurkolom"@nl, "vervormbare stuurkolom"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/031f9a4a-c15b-4e39-837e-f57bb734cfbe>;
