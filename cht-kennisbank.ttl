<https://data.cultureelerfgoed.nl/term/id/cht/756590a2-9736-48b6-9295-85f126c459bd>
  a skos:Concept;
  skos:prefLabel "spinnen"@nl;
  skos:scopeNote "IJzeren hefboompjes die zich recht voor de (doorboorde) askop bevindt en is bevestigd aan de zwichtstang die door de as loopt. Treft men aan bij zelfzwichting, Bilau-, Van Riet- en Ten Have wieksysteem."@nl;
  skos:altLabel "spin"@nl, "zwichtkruis"@nl;
