  a skos:Concept;
  skos:prefLabel "spantbenen"@nl;
  skos:scopeNote "Verticale dakbalk die in de spantring begint en in de vorstbalk uitloopt. Ook kapspant."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/04770e4f-1c11-40e7-a256-9de8c6d569c6>;
