<https://data.cultureelerfgoed.nl/term/id/cht/51bbe8e3-5ffb-4aef-910d-5b9648263a41>
  a skos:Concept;
  skos:prefLabel "basen"@nl;
  skos:scopeNote "Een base of loog – ook wel alkali genoemd – is een substantie die reageert met een zuur."@nl;
  skos:altLabel "base"@nl, "loog"@nl, "alkali"@nl;
