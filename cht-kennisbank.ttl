<https://data.cultureelerfgoed.nl/term/id/cht/01bbeed8-4b04-47f7-9330-5da009024c91>
  a skos:Concept;
  skos:prefLabel "metaaloxide"@nl;
  skos:scopeNote "Metaaloxiden zijn binaire verbindingen van een metaal met zuurstof."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b5018c8d-6fc1-4dcd-9211-ada740aafde3>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b3656414-9960-423c-91e9-aba4811d1e95>
  a skos:Concept;
  skos:prefLabel "ventilatietorens"@nl;
  skos:scopeNote "Ventilatietorens zijn torens die zijn ontworpen om luchtstromen in en uit een gebouw te reguleren, vaak te vinden in grote gebouwen, tunnels, of mijnen voor de afvoer van verontreinigde lucht."@nl;
  skos:altLabel "ventilatietoren"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2ffb2c5-397c-47c9-bdb8-a655cd21326d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4f1b1c79-510d-4aea-af16-d9fe5a3e741c>
  a skos:Concept;
  skos:prefLabel "koggenagels"@nl;
  skos:scopeNote "Gesmede spijker waarmee de gangen van een kogge-achtig schip overnaads aan elkaar werden verbonden; koggennagels werden tweemaal kromgeslagen, waarbij de punt weer in het hout was gedreven; het had de functie van een klinknagel."@nl;
  skos:altLabel "koggenagel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6f8bf719-083b-482e-bc3d-85e91fbabcdf>;
