<https://data.cultureelerfgoed.nl/term/id/cht/0ffc22a6-2e08-4c2e-b85f-4512a64d5b39>
  a skos:Concept;
  skos:prefLabel "aashokken"@nl;
  skos:scopeNote "Schuurtje/werkplaats voor het bewaren en repareren van vistuig en voorzien van het hoekwant van aas."@nl;
