<https://data.cultureelerfgoed.nl/term/id/cht/160a8d53-d151-43e0-9180-bfe460703b2d>
  a skos:Concept;
  skos:prefLabel "tanden (metselwerk)"@nl;
  skos:scopeNote "Tanden zijn (bij metselwerk) gedeeltes van bakstenen die vooruitspringen tov de onmiddellijk erboven en erondergelegen stenen. (Haslinghuis)"@nl;
