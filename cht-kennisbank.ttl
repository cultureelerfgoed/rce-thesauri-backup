<https://data.cultureelerfgoed.nl/term/id/cht/4358018c-69e7-4934-8815-6a602346d071>
  a skos:Concept;
  skos:prefLabel "kindernevendienstlantaarns"@nl;
  skos:scopeNote "Lantaarn met kaars of waxinelichtje voor de kinderen die de kindernevendienst (benaming in de protestantse kerk) of kinderdienst (oud-katholieke term) bijwonen. Voordat de dienst van het Woord begint – deze neemt een aanvang met de schriftlezingen – verlaten de kinderen de kerk met hun lantaarn waarin de kaars is ontstoken."@nl;
  skos:altLabel "kindernevendienstlantaarn"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a7eaaaa7-1ee2-4beb-a9f0-0132d844a77b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

