<https://data.cultureelerfgoed.nl/term/id/cht/c9745c16-4c4f-4c4c-bb52-4b781fc289e2>
  a skos:Concept;
  skos:prefLabel "technische waarden"@nl;
  skos:scopeNote "Een onroerend goed heeft technische waarde als het de ontwikkeling van de (cultuur)techniek in het verleden illustreert. Het gaat om technische toepassingen als illustratie van zowel traditionele als innovatieve technieken en materialen. (bron: https://id.erfgoed.net/thesauri/waardetypes/45)"@nl;
  skos:altLabel "technische waarde"@nl, "technisch belang"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f94da6b6-f1b8-4141-b4e8-316573793d59>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3628364f-272b-45d5-81fc-d8d63b0b27ad>
  a skos:Concept;
  skos:prefLabel "bolle akkers"@nl;
  skos:scopeNote "Een bolle akker is een akker waarbij het midden van de akker hoger ligt dan de randen."@nl;
  skos:altLabel "akkermeet"@nl, "akkermeten"@nl, "kruinig perceel"@nl, "kruinig percelen"@nl,
