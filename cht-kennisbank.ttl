<https://data.cultureelerfgoed.nl/term/id/cht/75bf36d2-9520-47d3-bdbe-c0f2dfbdbf48>
  a skos:Concept;
  skos:prefLabel "titanium"@nl;
  skos:scopeNote "Te gebruiken voor het zuivere metaalelement met het symbool Ti en het atoomnummer 22. Dit zilverkleurig metaal is hard en glanzend. Ook te gebruiken voor het metaal wanneer het wordt bewerkt en gevormd om, meestal in combinatie met andere stoffen, diverse voorwerpen en materialen te maken. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b9fd0887-297b-4bab-bea5-cb288d068816>;
