  a skos:Concept;
  skos:prefLabel "haardstellen"@nl;
  skos:scopeNote "Haardstellen zijn groepjes gereedschappen, opgehangen in metalen rekken, voor de verzorging van het verbrandingsproces bij kachels. De gereedschappen zijn poken, schepjes, vegertjes, en eventueel blaaspijpjes en tangen. (Kachels / R. Rook, Utrecht/Aartselaar, 1985)"@nl;
  skos:altLabel "haardstel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
