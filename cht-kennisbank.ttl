<https://data.cultureelerfgoed.nl/term/id/cht/5c7fc265-7619-4672-8dc0-dee75c3b645f>
  a skos:Concept;
  skos:prefLabel "patioblokken"@nl;
  skos:scopeNote "Met symmetrische figuur opengewerkte steen die voor patio- of tuinmuren wordt gebruikt, claustra. (Haslinghuis)"@nl;
