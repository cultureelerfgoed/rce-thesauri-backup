<https://data.cultureelerfgoed.nl/term/id/cht/f022afe0-a035-447b-99e2-8b2159c8f60e>
  a skos:Concept;
  skos:prefLabel "holbodemreservoirs"@nl;
  skos:scopeNote "Holbodemreservoirs zijn meestal betonnen reservoirs met een holle bodem die kunnen worden gezien als de tegenhangers van de ijzeren hangbodemreservoirs. De krachten van het reservoir worden afgevoerd naar een gecombineerde trek -en oplegring die op de overgang van bodem en wand is geconstrueerd. (Henk van der Veen, Watertorens in Nederland. 1994, p. 39)"@nl;
  skos:altLabel "holbodemreservoir"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b3330446-f4d3-4e0c-8b9d-1dd8d2259419>;
