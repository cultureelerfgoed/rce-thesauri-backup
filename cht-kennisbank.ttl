<https://data.cultureelerfgoed.nl/term/id/cht/7f748271-8b8b-4317-a98a-a8951804e271>
  a skos:Concept;
  skos:prefLabel "spitsschaven"@nl;
  skos:scopeNote "Schaaf in de vorm van een spits met twee convergerende geretoucheerde zijden. (ABR)"@nl;
