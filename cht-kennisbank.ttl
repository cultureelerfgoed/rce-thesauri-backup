<https://data.cultureelerfgoed.nl/term/id/cht/aed399ba-7039-4d4c-b0cb-7c374b6370a7>
  a skos:Concept;
  skos:prefLabel "voorzangerslezenaars"@nl;
  skos:scopeNote "Lezenaar op het doophek gemonteerd, ten dienste van de voorzanger/voor-lezer. De lezenaar heeft een rechte stam bij plaatsing bovenop het doophek en evenals een kansellezenaar een krul bij plaatsing tegen het doophek. Omdat veel dooptuinen zijn ontmanteld, zijn de voorzangerslezenaars nogal eens op een houten voet overgeplaatst."@nl;
  skos:altLabel "voorzangerslezenaar"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f0ec0eef-47af-4993-b56e-608ac992e354>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b0bc57db-e66c-4378-b3ce-50d97b37ba23>
  a skos:Concept;
  skos:prefLabel "flambouwstandaarden"@nl;
  skos:scopeNote "Standaard voor één of meer processielantaarns."@nl;
  skos:altLabel "flambouwstandaard"@nl;
