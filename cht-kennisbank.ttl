<https://data.cultureelerfgoed.nl/term/id/cht/5fcc0286-7781-4a1c-a17a-7554101a6d31>
  a skos:Concept;
  skos:prefLabel "verde di ranocchia"@nl;
  skos:scopeNote "Een serpentijn in verschillende geelachtig groene tinten, vaak met fijne zwarte of grijze tekeningen. Het ontleent zijn naam aan de kikkerachtige tekeningen. (AAT-Ned)"@nl;
