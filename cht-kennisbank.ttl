<https://data.cultureelerfgoed.nl/term/id/cht/5709e492-eab5-4e3e-9daa-95fac30018b7>
  a skos:Concept;
  skos:prefLabel "dwergauto's"@nl;
  skos:scopeNote "Een dwergauto (ook wel microcar, bubblecar of Kabinenroller) is een compacte auto."@nl;
  skos:altLabel "dwergauto"@nl, "kabinenroller"@nl, "kabinenrollers"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dec3cb60-0105-49ac-a19f-d52c1f1ac5b4>;
