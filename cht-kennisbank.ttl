<https://data.cultureelerfgoed.nl/term/id/cht/ec711282-0697-4a64-b574-658bc32a2607>
  a skos:Concept;
  skos:prefLabel "cross-flow cilinderkoppen"@nl;
  skos:scopeNote "Bij een cross-flow cilinderkop komt aan de ne zijde het benzine/luchtmengsel binnen en de verbrande gassen worden aan de andere kant uitgedreven, zodat een doorstroming (cross-flow) ontstaat."@nl;
  skos:altLabel "cross-flow cilinderkop"@nl;
