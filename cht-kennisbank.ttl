<https://data.cultureelerfgoed.nl/term/id/cht/661813af-36d4-4a63-a985-1e54c854ae17>
  a skos:Concept;
  skos:prefLabel "late dryas"@nl;
  skos:scopeNote "De Jonge(re) Dryas of het Jonge(re) Dryas-stadiaal (12.700 - 11.560 jaar BP) is de laatste koudeperiode (een zogenaamd stadiaal) tijdens het Weichsel-glaciaal."@nl;
  skos:altLabel "Jonge Dryas"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/73aeaaaa-9b7f-483d-932c-a17889383d5f>;
