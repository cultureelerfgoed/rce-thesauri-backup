<https://data.cultureelerfgoed.nl/term/id/cht/7084e694-000f-4787-a668-f438bf543141>
  a skos:Concept;
  skos:prefLabel "tochtpuien"@nl;
  skos:scopeNote "Glazen enkele of dubbele deur met omgevende pui. De deuren zijn meestal naar beide zijden draaibaar en dienen om tocht te voorkomen. (Haslinghuis)"@nl;
  skos:altLabel "tochtpui"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ae5086cc-98d2-4091-84e1-7386f80c39be>;
