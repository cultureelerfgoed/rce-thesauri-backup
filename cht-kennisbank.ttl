  a skos:Concept;
  skos:prefLabel "voeghouten"@nl;
  skos:scopeNote "Bij een standerd- en wipmolen een van de twee evenwijdig aan elkaar liggende zware balken die de basis vormen van de kast, resp. het bovenhuis. De vloerbalken en dwarsberriebalken rusten erop. De voeghouten, met daartussen twee (zie) kalven, omsluiten zeer nauw de standerd van de standerdmolen dan wel de (zie) koker van de wipmolen. Daardoor wordt het schommelen van de kast, resp. het bovenhuis voorkomen. voeckhoute: 1419 Spijkenisse (Z.H.), molen. (Haslinghuis)"@nl;
  skos:altLabel "lange berriebalk"@nl, "lange berriebalken"@nl, "lange burriebalk"@nl,
