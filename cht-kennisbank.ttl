  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ee455779-8c67-4851-95ff-fea85a0d5681>
  a skos:Concept;
  skos:prefLabel "commodore"@nl;
  skos:scopeNote "Een commodore in de luchtmacht is een lagere opperofficier, vaak verantwoordelijk voor het bevel over een luchtvleugel of een grotere operationele eenheid binnen de luchtmacht."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f78784c2-154f-400a-94a5-8d4801650167>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d46713ea-3204-45bf-8896-429a3b47bf2a>
  a skos:Concept;
  skos:prefLabel "woningbouwverenigingen"@nl;
  skos:scopeNote "Woningbouwverenigingen zijn verenigingen die zich richten op de ontwikkeling, bouw, en beheer van betaalbare woningen. Deze verenigingen zijn vaak betrokken bij het verstrekken van huurwoningen en het verbeteren van de woonomstandigheden voor hun leden."@nl;
  skos:altLabel "woningbouwvereniging"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/65066abd-d768-422a-b309-2cb0c35a9164>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/1e9785fb-e568-4fdc-a498-89f99e760cfc>
  a skos:Concept;
  skos:prefLabel "winkeliersverenigingen"@nl;
  skos:scopeNote "Winkeliersverenigingen zijn verenigingen die zich richten op het behartigen van de belangen van winkeliers en detaillisten. Ze bieden ondersteuning op het gebied van ondernemerschap, promotie, en vertegenwoordiging bij lokale en nationale overheden."@nl;
  skos:altLabel "winkeliersvereniging"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/65066abd-d768-422a-b309-2cb0c35a9164>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d4cd4d4e-89db-4840-a88f-d3ecb16bda7a>
  a skos:Concept;
  skos:prefLabel "visserijverenigingen"@nl;
  skos:scopeNote "Visserijverenigingen zijn verenigingen die zich inzetten voor de belangen van vissers en de visserijsector. Ze organiseren activiteiten en bijeenkomsten om de samenwerking tussen vissers te bevorderen en behartigen de belangen van hun leden bij overheden en andere belanghebbenden."@nl;
  skos:altLabel "visserijvereniging"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/65066abd-d768-422a-b309-2cb0c35a9164>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2134f956-3d15-49b5-b8a2-ad2388fd3f1c>
  a skos:Concept;
  skos:prefLabel "schippersverenigingen"@nl;
  skos:scopeNote "Schippersverenigingen zijn verenigingen die de belangen van schippers en binnenvaartschippers behartigen. Deze verenigingen bieden ondersteuning op het gebied van arbeidsvoorwaarden, beroepsopleiding, en vertegenwoordigen schippers bij overheden en andere instanties."@nl;
  skos:altLabel "schippersvereniging"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/65066abd-d768-422a-b309-2cb0c35a9164>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/dc20f321-2028-4792-897a-05e0794feef0>
  a skos:Concept;
  skos:prefLabel "reciteercolleges"@nl;
  skos:scopeNote "Reciteercolleges zijn verenigingen die zich richten op het beoefenen en promoten van voordrachtskunst. Leden van deze verenigingen oefenen zich in het reciteren van gedichten, toespraken, en andere teksten, vaak met het doel om hun spreekvaardigheid en presentatie te verbeteren."@nl;
  skos:altLabel "reciteercollege"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/65066abd-d768-422a-b309-2cb0c35a9164>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/05c49318-8b8d-4420-ab59-f86c8b2fbe40>
  a skos:Concept;
  skos:prefLabel "pluimveeverenigingen"@nl;
  skos:scopeNote "Pluimveeverenigingen zijn verenigingen die zich bezighouden met de fokkerij, tentoonstelling, en het welzijn van pluimvee. Leden van deze verenigingen zijn vaak pluimveehouders en hobbyisten die zich richten op het behoud van rassen en het verbeteren van de kwaliteit van pluimvee."@nl;
  skos:altLabel "pluimveevereniging"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/65066abd-d768-422a-b309-2cb0c35a9164>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/635174f7-58ca-41d9-b95b-30b41b48bb48>
  a skos:Concept;
  skos:prefLabel "natuurkundig genootschappen"@nl;
  skos:scopeNote "Natuurkundig genootschappen zijn verenigingen die zich richten op de studie en bevordering van natuurkunde. Ze organiseren lezingen, conferenties, en publicaties om kennis over natuurkundige wetenschappen te verspreiden en bevorderen de samenwerking tussen wetenschappers."@nl;
  skos:altLabel "natuurkundig genootschap"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/65066abd-d768-422a-b309-2cb0c35a9164>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f830ba58-5977-445a-b9f1-cd8ef128af61>
  a skos:Concept;
  skos:prefLabel "muziekverenigingen"@nl;
  skos:scopeNote "Muziekverenigingen zijn verenigingen die zich toeleggen op het beoefenen en bevorderen van muziek. Deze verenigingen kunnen koren, fanfares, harmonieorkesten, of andere muziekgroepen omvatten, en organiseren regelmatig concerten en andere muzikale evenementen."@nl;
  skos:altLabel "muziekvereniging"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/65066abd-d768-422a-b309-2cb0c35a9164>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/1f90ea1c-3818-4b9b-9aa9-852a7527db41>
  a skos:Concept;
  skos:prefLabel "middenstandsverenigingen"@nl;
  skos:scopeNote "Middenstandsverenigingen zijn verenigingen die de belangen van middenstanders, zoals winkeliers en kleine ondernemers, behartigen. Ze bieden ondersteuning op het gebied van ondernemersbeleid, scholing, en vertegenwoordiging bij lokale en nationale overheden."@nl;
  skos:altLabel "middenstandsvereniging"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/65066abd-d768-422a-b309-2cb0c35a9164>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/62a1fdef-ab6f-407a-b0f8-c2088a1eb3d0>
  a skos:Concept;
  skos:prefLabel "kiesverenigingen"@nl;
  skos:scopeNote "Kiesverenigingen zijn verenigingen die zijn opgericht om politieke partijen of kandidaten te ondersteunen bij verkiezingen. Deze verenigingen spelen een rol in de verkiezingscampagnes en mobiliseren kiezers om op hun kandidaten te stemmen."@nl;
  skos:altLabel "kiesvereniging"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/65066abd-d768-422a-b309-2cb0c35a9164>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d6325516-a771-4561-90c6-47628aa9a846>
  a skos:Concept;
  skos:prefLabel "begrafenisverenigingen"@nl;
  skos:scopeNote "Begrafenisverenigingen zijn verenigingen die zich richten op het bieden van financiële en organisatorische ondersteuning bij begrafenissen. Deze verenigingen helpen leden met de kosten van een begrafenis en organiseren vaak uitvaarten voor hun leden."@nl;
  skos:altLabel "begrafenisvereniging"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/65066abd-d768-422a-b309-2cb0c35a9164>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a9b6789b-32bf-42c6-ba71-eb5cdfd53525>
  a skos:Concept;
  skos:prefLabel "Zuiderzeevereniging"@nl;
  skos:scopeNote "De Zuiderzeevereniging was een vereniging die zich richtte op de ontwikkeling en drooglegging van de Zuiderzee. De vereniging speelde een belangrijke rol in de totstandkoming van de Afsluitdijk en de drooglegging van de polders, wat leidde tot de creatie van de provincie Flevoland."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/65066abd-d768-422a-b309-2cb0c35a9164>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fc486502-5a03-4693-af54-39ddd65d3d4a>
  a skos:Concept;
  skos:prefLabel "Oranjeverenigingen"@nl;
  skos:scopeNote "Oranjeverenigingen zijn verenigingen die zich inzetten voor het bevorderen van nationale eenheid en verbondenheid met het Koninklijk Huis in Nederland. Ze organiseren evenementen zoals Koningsdag en andere activiteiten die de nationale trots en verbondenheid met het koningshuis versterken."@nl;
  skos:altLabel "Oranjevereniging"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/65066abd-d768-422a-b309-2cb0c35a9164>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e752b4ae-1ed7-4ebb-b4e8-6e16f037b1b2>
  a skos:Concept;
  skos:prefLabel "kolonel (landmacht)"@nl;
  skos:scopeNote "Een kolonel in de landmacht is een rang binnen de hoofdofficieren van de landmacht. Deze rang staat direct onder de rang van brigadegeneraal en boven de rang van luitenant-kolonel. Kolonels hebben doorgaans de leiding over regimenten of brigades en vervullen belangrijke staf- of leidinggevende functies binnen het leger."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/de0d727e-b0a5-4fd6-9bbe-6c7d7bae76cc>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/dc365940-b60d-4982-b598-694524482095>
  a skos:Concept;
  skos:prefLabel "luitenant-kolonel (landmacht)"@nl;
  skos:scopeNote "Een luitenant-kolonel in de landmacht is een rang binnen de hoofdofficieren van de landmacht, direct onder de rang van kolonel en boven de rang van majoor. Luitenant-kolonels hebben vaak de leiding over bataljons en vervullen belangrijke staf- of commandofuncties."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/de0d727e-b0a5-4fd6-9bbe-6c7d7bae76cc>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/04faa040-4209-4853-84f2-32542763c779>
  a skos:Concept;
  skos:prefLabel "majoor (landmacht)"@nl;
  skos:scopeNote "Een majoor in de landmacht is een rang binnen de hoofdofficieren van de landmacht. Deze rang staat direct onder de rang van luitenant-kolonel en boven de rang van kapitein. Majoren vervullen vaak de rol van stafmedewerker of leidinggevende in kleinere eenheden zoals compagnies."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/de0d727e-b0a5-4fd6-9bbe-6c7d7bae76cc>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/59bc11c2-0a1a-412a-a638-7c8abeacfe9b>
  a skos:Concept;
  skos:prefLabel "luitenant-generaal (landmacht)"@nl;
  skos:scopeNote "Een luitenant-generaal in de landmacht is een hooggeplaatste opperofficier die leiding geeft aan een korps of een leger, verantwoordelijk voor strategische operaties en militaire planning."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/861793d3-b74f-4d07-9447-426d86ac97c0>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3334f690-0b8f-4c2e-af72-dcf831a8047e>
  a skos:Concept;
  skos:prefLabel "generaal-majoor (landmacht)"@nl;
  skos:scopeNote "Een generaal-majoor in de landmacht is een hogere opperofficier die het bevel voert over divisies of andere grote militaire eenheden, met een focus op strategische planning en uitvoering."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/861793d3-b74f-4d07-9447-426d86ac97c0>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/faa3b146-23a9-4652-b9cb-00189b00d263>
  a skos:Concept;
  skos:prefLabel "generaal (landmacht)"@nl;
  skos:scopeNote "Een generaal in de landmacht is de hoogste rang binnen de opperofficieren, verantwoordelijk voor het leidinggeven aan grote militaire eenheden, zoals een legerkorps, en strategische besluitvorming."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/861793d3-b74f-4d07-9447-426d86ac97c0>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/31c39409-14d9-46c6-914f-378eda69dbb8>
  a skos:Concept;
  skos:prefLabel "brigadegeneraal (landmacht)"@nl;
  skos:scopeNote "Een brigadegeneraal in de landmacht is een opperofficier die het bevel voert over een brigade of een vergelijkbare eenheid, met verantwoordelijkheden op strategisch en operationeel niveau."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/861793d3-b74f-4d07-9447-426d86ac97c0>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/861793d3-b74f-4d07-9447-426d86ac97c0>
  a skos:Concept;
  skos:prefLabel "opper- of vlagofficieren (landmacht)"@nl;
  skos:scopeNote "Opper- of vlagofficieren bij de landmacht zijn de hoogste rangen binnen de officiersgelederen, verantwoordelijk voor het strategisch leiderschap en beleidsvorming."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ae811a42-6d9b-4431-ade8-ed6f8d365d04>;
