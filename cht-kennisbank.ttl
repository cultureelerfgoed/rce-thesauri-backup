<https://data.cultureelerfgoed.nl/term/id/cht/59f86707-d5ea-46cd-afc9-62f06e23c735>
  a skos:Concept;
  skos:prefLabel "winterserres"@nl;
  skos:scopeNote "Winterserres zijn serres die op een natuurlijke of kunstmatige wijze worden verwarmd zodat de ruimten het hele jaar door gebruikt kunnen worden. (Gids historische serres en veranda's 2014)"@nl;
  skos:altLabel "winterserre"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c42f65bc-172b-4629-93d8-7ef1d7a4e704>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/9b763a0c-0e48-4521-8426-0dceb8410863>
  a skos:Concept;
  skos:prefLabel "zomerserres"@nl;
  skos:scopeNote "Zomerserres zijn serres die op een natuurlijke wijze opwarmen. Hun gebruik is beperkter dan die van winterserres, want als er weinig zon is in de koude perioden is het er niet aangenaam. (Gids historische serres en veranda's 2014)"@nl;
  skos:altLabel "zomerserre"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c42f65bc-172b-4629-93d8-7ef1d7a4e704>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/14e09834-29ea-4c36-ba1d-1d7377cfdb3f>
  a skos:Concept;
  skos:prefLabel "mijten"@nl;
  skos:scopeNote "De mijt is een hoge, vaste stapel hooi (of rogge), als wintervoorraad voor het vee opgeworpen rondom een houten paal."@nl;
  skos:altLabel "mijt"@nl, "viemhoop"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/164e269e-aa56-45c7-af51-eb178d29ab1c>;
