<https://data.cultureelerfgoed.nl/term/id/cht/64a927a5-8562-4f36-b75a-e98633829957>
  a skos:Concept;
  skos:prefLabel "duivenslagpoorten"@nl;
  skos:scopeNote "Duivenslagpoorten zijn poorten die de ingang vormen van een gebied waar duiven werden gehouden. Deze poorten waren vaak onderdeel van grotere landgoederen of kastelen."@nl;
  skos:altLabel "duivenslagpoort"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c8f08076-526c-4ed4-a079-1ea5dcf52547>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/025e9781-e9db-4065-a006-07b04f8957f9>
  a skos:Concept;
  skos:prefLabel "traanpakhuizen"@nl;
  skos:scopeNote "Opslagplaats van walvisproducten zoals traan, baleinen en potvistanden; de traan wordt bewaard in gemetselde 'oliebakken'"@nl;
  skos:altLabel "traanpakhuis"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/37ac1141-a23d-452e-b68e-5237775f8916>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d9e5f626-e99f-48ea-a9e3-6a45e15705c8>
  a skos:Concept;
  skos:prefLabel "ruitenkruizen"@nl;
  skos:scopeNote "Ruitenkruizen zijn metalen versieringskruizen op daken bestaande uit een horizontale en een verticale staf. Op het ontmoetingspunt van de staven is een ruit uitgespaard. Mogelijk wordt met de ruit de abstracte vorm van Christus aan het kruis uitgebeeld. Ruitenkruizen worden voornamelijk op kerken aangetroffen, meestal aan de oostzijde. (Windwijzers in het vizier / K.T. Meindersma)"@nl;
  skos:altLabel "ruitenkruis"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/63ab59b9-2253-40ee-a495-4b141bf2ff70>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c46e346b-fffd-408a-a526-734e209b36e0>
  a skos:Concept;
  skos:prefLabel "scheerspruiten"@nl;
  skos:scopeNote "Driehoekspant op het scheergebint, waarop gordingen en nokgording rusten. (Haslinghuis)"@nl;
  skos:altLabel "scheerspruit"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c4da8b07-9847-4269-86a6-8da0ab1923f5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/89b67183-8812-43b8-9b04-3f696f86f164>
  a skos:Concept;
  skos:prefLabel "netwerkoperators"@nl;
  skos:scopeNote "Een bedrijf dat eigenaar is van een systeem voor mobiele telefonie (netwerk) en dat dit systeem beheert."@nl;
  skos:altLabel "netwerkoperator"@nl;
