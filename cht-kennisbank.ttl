<https://data.cultureelerfgoed.nl/term/id/cht/3da2dcb0-584e-43ce-a4e7-75f84881213f>
  a skos:Concept;
  skos:prefLabel "traveeën"@nl;
  skos:scopeNote "Deel van gebouw of gevel, bepaald door de afstand tussen twee opvolgende steunpuntassen in de lengterichting van het bouwwerk. Zie tekening arcade. (Haslinghuis)"@nl;
  skos:altLabel "travee"@nl;
