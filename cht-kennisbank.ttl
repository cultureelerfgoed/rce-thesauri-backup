<https://data.cultureelerfgoed.nl/term/id/cht/248cd143-57cb-486b-9346-eec7f88f58f5>
  a skos:Concept;
  skos:prefLabel "kalvermesterijen"@nl;
  skos:scopeNote "Kalvermesterijen zijn agrarische bedrijven, werkplaatsen of fabrieken waarin het mesten van kalveren als bedrijf wordt uitgeoefend."@nl;
