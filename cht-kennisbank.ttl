<https://data.cultureelerfgoed.nl/term/id/cht/67189940-8e10-401e-8ea0-15e91c8093d9>
  a skos:Concept;
  skos:prefLabel "orkestbakken"@nl;
  skos:scopeNote "Orkestbakken zijn gedeeltelijk onder het toneel liggende ruimtes waar orkesten zitten bij opera- en balletuitvoeringen. Ze liggen tussen het publiek en het toneel, zodat de dirigent kan reageren op wat zich op het toneel afspeelt. (Rijksdienst voor het Cultureel Erfgoed/Van Dale)"@nl;
  skos:altLabel "orkestbak"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/3ecd1894-dca1-4341-b534-1cef52f17ca5>;
