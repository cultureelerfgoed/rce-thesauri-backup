<https://data.cultureelerfgoed.nl/term/id/cht/7aed6b1a-cc18-41b8-ab08-355c9e559727>
  a skos:Concept;
  skos:prefLabel "loodschuimspanen"@nl;
  skos:scopeNote "Grote platte koperen lepel met gaten in de bodem en rand. Wordt gebruikt om bovendrijvende laag ongerechtigheden van vloeibaar lood te scheppen."@nl;
