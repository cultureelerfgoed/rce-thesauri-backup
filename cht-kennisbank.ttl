<https://data.cultureelerfgoed.nl/term/id/cht/87fbb2e3-3444-4e27-b20b-57979bb5b8f2>
  a skos:Concept;
  skos:prefLabel "plaatvloeren"@nl;
  skos:scopeNote "Plaatvloeren zijn vrijdragende vloeren bestaande uit gewapend betonnen vloerelementen. Wanneer het element twee ribben aan de onderzijde heeft wordt gesproken over een TT-plaatvloer. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "elementvloer"@nl, "elementvloeren"@nl, "plaatvloer"@nl;
