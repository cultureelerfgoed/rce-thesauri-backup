<https://data.cultureelerfgoed.nl/term/id/cht/e4dd2ee3-53d6-4cbe-8887-ffaf1e379343>
  a skos:Concept;
  skos:prefLabel "meestoven"@nl;
  skos:scopeNote "Meestoven zijn schuren waarin de wortelstokken van de Rubia tinctorum bij 50°- 60° werden gedroogd, waarna de rode kleurstof meekrap werd bereid. Deze schuren werden gebruikt van de 16de tot de 19de eeuw in de provincie Zeeland. (Haslinghuis)"@nl;
  skos:altLabel "meekrapstoof"@nl, "meekrapstoven"@nl, "meestoof"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c8a9451e-9ee0-43ae-99b8-5066f8aab68b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b8604da5-da46-49e4-98cb-978c7b3880f3>
  a skos:Concept;
  skos:prefLabel "kassen"@nl;
  skos:scopeNote "Kassen zijn bouwwerken om planten in te kweken bestaande uit een lichte constructie (meestal van ijzer) waarvan de afsluiting naar buiten vrijwel uitsluitend uit glas bestaat. (Haslinghuis)"@nl;
