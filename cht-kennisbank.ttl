<https://data.cultureelerfgoed.nl/term/id/cht/f80ab621-10e0-4400-801a-0357df4d30ea>
  a skos:Concept;
  skos:prefLabel "stampers (machinaal)"@nl;
  skos:scopeNote "Machinaal aangedreven gereedschap dat wordt gebruikt voor het samendrukken van aarde of ander korrelig materiaal. (AAT-Ned)"@nl;
  skos:altLabel "stamper (machinaal)"@nl;
