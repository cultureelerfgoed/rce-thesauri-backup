<https://data.cultureelerfgoed.nl/term/id/cht/ba2d388d-81a2-4fd2-a182-a148e1c098b3>
  a skos:Concept;
  skos:prefLabel "kornet (marechaussée)"@nl;
  skos:scopeNote "Kornet bij de marechaussee is een lagere rang binnen de subalterne officieren, doorgaans verantwoordelijk voor leidinggevende taken bij kleinere operationele eenheden."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ebe46e17-3cf8-4ae7-bdd9-1fc9394e9b47>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/de0d727e-b0a5-4fd6-9bbe-6c7d7bae76cc>
  a skos:Concept;
  skos:prefLabel "hoofdofficieren (landmacht)"@nl;
  skos:scopeNote "Hoofdofficieren bij de landmacht vormen een middelhoge officiersrang die verantwoordelijk is voor het leidinggeven aan grotere eenheden en strategische operaties."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ae811a42-6d9b-4431-ade8-ed6f8d365d04>;
