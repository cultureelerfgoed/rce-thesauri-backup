<https://data.cultureelerfgoed.nl/term/id/cht/c00cc1a6-b68f-49b2-8ed1-ef77a4beb554>
  a skos:Concept;
  skos:prefLabel "zomerkeukens"@nl;
  skos:scopeNote "Zomerkeukens zijn keukens die specifiek zijn ontworpen voor gebruik in de warme zomermaanden, vaak los van het hoofdgebouw om oververhitting te voorkomen."@nl;
  skos:altLabel "zomerkeuken"@nl;
