<https://data.cultureelerfgoed.nl/term/id/cht/4dbe635c-e6c4-40a0-b2f1-baa3cc361200>
  a skos:Concept;
  skos:prefLabel "gemengde bossen"@nl;
  skos:scopeNote "Bos waarin loofhout en naaldhout voorkomen."@nl;
  skos:altLabel "gemengd bos"@nl;
