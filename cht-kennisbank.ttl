<https://data.cultureelerfgoed.nl/term/id/cht/91429576-5490-4d6f-93a0-8c41e735cbee>
  a skos:Concept;
  skos:prefLabel "versteknaden"@nl;
  skos:scopeNote "Naad tussen twee in verstek omgezette onderdelen. (Haslinghuis)"@nl;
  skos:altLabel "versteknaad"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/03229830-2d06-4aa1-8ad2-6d2267eeeafc>;
