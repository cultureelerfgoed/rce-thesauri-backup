<https://data.cultureelerfgoed.nl/term/id/cht/d8f570fc-8113-4b5b-a349-14236f473192>
  a skos:Concept;
  skos:prefLabel "fruitkeermuren"@nl;
  skos:scopeNote "Fruitkeermuren zijn fruitmuren, al of niet uitgevoerd als experimentele fruitmuren, toepast op plaatsen waar hoogteverschillen in het terrein een rol spelen. Dat kan zijn bij natuurlijke hellingen of kunstmatige verhogingen zoals bij terpen."@nl;
  skos:altLabel "fruitkeermuur"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5077455e-47c8-4e7f-87fd-84bb7fac8b9b>;
