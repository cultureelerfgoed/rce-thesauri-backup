  a skos:Concept;
  skos:prefLabel "ecoline"@nl;
  skos:scopeNote "Ecoline is een vloeibare aquarelverf. Het hoort bij de niet-watervaste inkten en is in veel kleuren verkrijgbaar. (Wikipedia)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7a795abe-51b8-4f72-85bf-aa2ccce7ff02>;
