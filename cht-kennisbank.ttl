<https://data.cultureelerfgoed.nl/term/id/cht/67d3b58a-42c9-43c6-a710-362cec98869b>
  a skos:Concept;
  skos:prefLabel "variomatics"@nl;
  skos:scopeNote "De Variomatic riemaandrijving van DAF geeft volautomatisch traploze versnellingsverhoudingen, die zich aanpassen aan alle verkeers- en rijomstandigheden."@nl;
