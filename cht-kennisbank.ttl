<https://data.cultureelerfgoed.nl/term/id/cht/4dab6d4a-32cb-4743-8a82-6aa2c6d93903>
  a skos:Concept;
  skos:prefLabel "tuinkamers"@nl;
  skos:scopeNote "Tuinkamers zijn kamers die uitkijken op een tuin en vaak lichte en luchtige ruimtes zijn, bedoeld om het buitenleven naar binnen te brengen."@nl;
  skos:altLabel "tuinkamer"@nl;
