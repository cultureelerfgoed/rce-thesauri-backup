<https://data.cultureelerfgoed.nl/term/id/cht/59d95888-86ff-4e05-b813-8818f6239557>
  a skos:Concept;
  skos:prefLabel "partiële reiniging"@nl;
  skos:scopeNote "Partiële reiniging is het alleen afnemen van verkleurde vernis van de lichtgekleurde partijen in het schilderij, bijvoorbeeld de vleeskleur op een portret."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/59dd50d6-092b-4d4f-8dcd-dd525b0540e2>
  a skos:Concept;
  skos:prefLabel "gelatine zilverdruk papier"@nl;
  skos:scopeNote "Gelatine-zilverdruk-papier is elk ontwikkel- of daglichtpapier gebaseerd op zilver als beeldvormend materiaal en gelatine als bindmiddel."@nl;
  skos:altLabel "zilverchloride gelatinepapier"@nl;
