<https://data.cultureelerfgoed.nl/term/id/cht/032ae85d-1621-458f-8ce3-0bce4fc11e63>
  a skos:Concept;
  skos:prefLabel "hard gevulkaniseerd rubber"@nl;
  skos:scopeNote "HVR is een vorm van natuurrubber waarbij het vulkanisatieproces (extra dwarsverbindingen met zwavel) heel ver is doorgevoerd. Hierdoor wordt het materiaal in plaats van elastisch juist heel hard. Het is vaak donker van kleur dat naar zwavel kan ruiken. (Toen het materiaal ontdekt werd deed het denken aan ebbenhout; vandaar de handelsnaam Eboniet.)"@nl;
  skos:altLabel "HVR"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9834c5a3-66d2-4d2d-aa64-789ff13dde5e>;
