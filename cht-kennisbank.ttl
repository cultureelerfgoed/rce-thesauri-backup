<https://data.cultureelerfgoed.nl/term/id/cht/96a00950-4d43-4684-813b-d8f065648e76>
  a skos:Concept;
  skos:prefLabel "voorbeeldprenten"@nl;
  skos:scopeNote "Ontwerp voor een object of een patroon voor de ambachtsman. Deze prenten werden in mappen met losse platen of in boekvorm uitgegeven. In de kerken zijn er voorwerpen te vinden die te herleiden zijn tot deze voorbeeldplaten."@nl;
  skos:altLabel "voorbeeldprent"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26b0d61a-e37a-4912-b516-48884f251bc6>;
