  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3f14eb2e-b835-402b-a928-3ce675292a32>
  a skos:Concept;
  skos:prefLabel "wierbergen"@nl;
  skos:scopeNote "Wierbergen zijn kapbergen die worden gebruikt voor de opslag van zeewier. Dit type kwam voor op het voormalige eiland Wieringen. (Alles over hooibergen : compleet met de Blaricumse situatie / Jurgens, Suzan. - Blaricum: Historische kring Blaricum, 2007)"@nl;
  skos:altLabel "wierberg"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/164e269e-aa56-45c7-af51-eb178d29ab1c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ee2da28a-d77c-4d98-a145-36af49767584>
  a skos:Concept;
