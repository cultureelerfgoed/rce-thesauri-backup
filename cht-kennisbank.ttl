<https://data.cultureelerfgoed.nl/term/id/cht/764493d9-3997-4953-a46c-c4a3c4c1c99e>
  a skos:Concept;
  skos:prefLabel "visscheppen"@nl;
  skos:scopeNote "Een visschep is een keukengerei met een brede, platte schep, bedoeld om vis uit een pan of schaal te halen. De schep is vaak geperforeerd zodat vocht of vet kan weglopen tijdens het serveren."@nl;
  skos:altLabel "visschep"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c2cb71db-70a0-4a85-b8b7-da6fc5bc48c5>;
