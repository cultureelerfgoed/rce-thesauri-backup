  a skos:Concept;
  skos:prefLabel "altaarkisten"@nl;
  skos:scopeNote "Draagbaar altaar met altaarsteen, uit-gevoerd als een uitklapbare kist. In de kist zat een volledige uitrusting voor de eucharistieviering. Dit ‘onzichtbare’ altaar werd gebruikt in tijden van verbod op de viering van de katholieke eredienst in de zeventiende en achttiende eeuw, de schuilkerkperiode."@nl;
  skos:altLabel "altaarkist"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1aceb3d4-ccd6-4e60-8b6b-e65ccad44ef1>;
