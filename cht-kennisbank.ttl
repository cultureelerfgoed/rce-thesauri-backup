  a skos:Concept;
  skos:prefLabel "ordening (archief)"@nl;
  skos:scopeNote "Het rangschikken van informatie binnen een archief overeenkomstig een vastgestelde systematiek (ordeningsplan)."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/96f8ea1c-ab5c-42dc-975b-8ec50ae5bc66>;
