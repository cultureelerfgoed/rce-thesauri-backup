<https://data.cultureelerfgoed.nl/term/id/cht/4a41b4a9-6c3c-4c77-ba16-7607b38c0e1f>
  a skos:Concept;
  skos:prefLabel "stalactietengewelven"@nl;
  skos:scopeNote "Stalactietengewelven zijn honingraatgewelven, kenmerkend voor de islamitische gewelfbouw. Ze bestaan uit nis- en trechtervormige cellen en kegel- of piramidevormige druipers. De constructie is meestal zo ingewikkeld, dat dit gewelf slechts in hout en stuc kan worden uitgevoerd. Het is waarschijnlijk via Noord-Afrika (moskeekoepel van Tremecén) in Spanje gekomen. (Haslinghuis)"@nl;
  skos:altLabel "celgewelf"@nl, "celgewelven"@nl, "honingraatgewelf"@nl, "honingraatgewelven"@nl,
    "muqarna"@nl, "muqarnas"@nl, "stalactietengewelf"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/02e2289e-bbb7-4233-9e02-fd95935f4e28>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

