<https://data.cultureelerfgoed.nl/term/id/cht/8c26e60f-f326-4c63-94ce-8f092e5dca6b>
  a skos:Concept;
  skos:prefLabel "kokermessen"@nl;
  skos:scopeNote "Een kokermes is een mes uit de bronstijd met een holhandvat."@nl;
  skos:altLabel "kokermes"@nl;
