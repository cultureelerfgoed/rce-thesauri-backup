  a skos:Concept;
  skos:prefLabel "ringrijderijen"@nl;
  skos:scopeNote "Ringrijderijen is een folkloristisch gebruik waarbij ruiters te paard in galop proberen met een lans ringen van een standaard te steken. Dit traditionele evenement behoort tot de bredere categorie folklore."@nl;
  skos:altLabel "ringrijderij"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a804f575-d2d5-401d-a574-e704afe0c1f0>;
