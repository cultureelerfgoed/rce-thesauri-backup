<https://data.cultureelerfgoed.nl/term/id/cht/cbb46560-3c1a-4ee0-86a1-ffcd2d86b99b>
  a skos:Concept;
  skos:prefLabel "zijdeglans"@nl;
  skos:scopeNote "Een weerspiegelende oppervlaktekwaliteit die minder stralend is dan hoogglans en die meer een gevoel van diepte dan van glans aan de afwerking geeft. (Project Fotografie)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6cc62105-702d-4ddb-baf8-71eff8ee77b5>;
