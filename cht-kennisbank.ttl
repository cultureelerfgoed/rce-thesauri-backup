<https://data.cultureelerfgoed.nl/term/id/cht/fc7ed281-f718-473b-bcd0-c189f004dbb5>
  a skos:Concept;
  skos:prefLabel "getijhavens"@nl;
  skos:scopeNote "Getijhaven zijn havens met open verbinding naar zee, met duidelijk merkbare verschillen in de waterstand. Sommige getijhavens komen bij laag water droog te staan, zodat enkel bij hoog water schepen kunnen in- of uitvaren.(Wikipedia)"@nl;
  skos:altLabel "getijhaven"@nl, "getijdehavens"@nl, "getijdehaven"@nl, "tijhavens"@nl,
    "tijhaven"@nl;
