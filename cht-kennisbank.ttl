<https://data.cultureelerfgoed.nl/term/id/cht/9820aebb-1541-49bc-9f53-d5c0d0e0012c>
  a skos:Concept;
  skos:prefLabel "tactische bommenwerpers"@nl;
  skos:scopeNote "Tactische bommenwerpers worden vooral ingezet bij gevechten om doelgericht vijandige voertuigen uit te schakelen."@nl;
  skos:altLabel "tactische bommenwerper"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/17a2bb48-dbbb-4e09-8ca8-8801d709a6d4>;
