<https://data.cultureelerfgoed.nl/term/id/cht/49ce03ad-1511-4ad3-b4e0-94f60c13206b>
  a skos:Concept;
  skos:prefLabel "schalmgaten"@nl;
  skos:scopeNote "Schalmgaten zijn open ruimten in het midden van slingertrappen of rondlopende bordestrappen. Schalmgaten hebben de vorm van langgerekte schalmen van kettingen."@nl;
  skos:altLabel "schalmgat"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d6c80a9d-63cd-41d6-adce-9daddf08ebb2>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4f7a7e95-21a8-4e2c-a1f0-7f96f2beaeb1>
  a skos:Concept;
  skos:prefLabel "lenden"@nl;
  skos:scopeNote "Lenden zijn de (steilere) onderste gedeelte van bogen of gewelven die zich aansluiten bij de geboortes of aanzetten. De lende is door aanrazering versterkt. (Haslinghuis)"@nl;
  skos:altLabel "lende"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d7f9c4b9-07a9-4794-8f03-6d0dbd508a76>;
