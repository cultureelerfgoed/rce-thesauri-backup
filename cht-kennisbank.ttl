<https://data.cultureelerfgoed.nl/term/id/cht/e210ea52-0e05-4dbf-932e-464e34409692>
  a skos:Concept;
  skos:prefLabel "kroonkandelaars"@nl;
  skos:scopeNote "Vlaamse term: Manshoge monumentale standaard met elektrische kaarsen als deel van het geheel, meestal neogoisch. Komt veel voor in Vlaanderen, maar is zeldzaam in nederland."@nl;
  skos:altLabel "kroonkandelaar"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c54d75d4-df7d-4114-b50d-f0270df8a38a>;
