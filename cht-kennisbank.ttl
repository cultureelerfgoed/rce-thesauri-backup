<https://data.cultureelerfgoed.nl/term/id/cht/0b0b40ce-f20b-4875-b945-d02a35de002f>
  a skos:Concept;
  skos:prefLabel "barische windrozen"@nl;
  skos:scopeNote "Barische windrozen zijn roosvormige figuren waarbij de gemiddelde barometerstand van iedere windrichting is aangegeven. (Van Dale)"@nl;
  skos:altLabel "barische windroos"@nl, "barometrische windroos"@nl, "barometrische windrozen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1c5c1eee-ae17-4c51-99b2-74631161153a>;
