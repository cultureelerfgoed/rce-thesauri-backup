<https://data.cultureelerfgoed.nl/term/id/cht/0a28404b-1261-46a3-872b-5208ab12ed82>
  a skos:Concept;
  skos:prefLabel "weckartikelen"@nl;
  skos:scopeNote "Attributen en benodigdheden om levensmiddelen te wecken: het steriliseren en verduurzamen door ze te koken en vervolgens van de lucht af te sluiten in daartoe ingerichte flessen of potten."@nl;
  skos:altLabel "weckartikel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
