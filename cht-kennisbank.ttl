<https://data.cultureelerfgoed.nl/term/id/cht/9591f859-567a-4e5f-a456-7e4a5e59fff0>
  a skos:Concept;
  skos:prefLabel "kiemschuren"@nl;
  skos:scopeNote "Kiemschuren zijn schuren die gebruikt worden voor heet ontkiemen van pootaardappels. De wanden bestaan uit glas."@nl;
  skos:altLabel "kiemschuur"@nl, "pootschuren"@nl, "pootschuur"@nl;
