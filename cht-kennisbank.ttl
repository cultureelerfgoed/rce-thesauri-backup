  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a0ef5abf-c18e-4c13-8f73-b1b024eafdfe>
  a skos:Concept;
  skos:prefLabel "tandwalvissen"@nl;
  skos:scopeNote "Tandwalvissen vormen een subgroep van walvissen, gekenmerkt door het bezit van tanden in plaats van baleinen. Ze jagen actief op grotere prooien zoals vis en inktvis, in tegenstelling tot de filtervoeding van baleinwalvissen."@nl;
  skos:altLabel "tandwalvis"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/83b98f25-2272-457f-88ca-ebb148aa04d5>;
