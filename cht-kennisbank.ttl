<https://data.cultureelerfgoed.nl/term/id/cht/03ed20c7-151e-4da4-b555-241d8f2e095d>
  a skos:Concept;
  skos:prefLabel "brandweerstokken"@nl;
  skos:scopeNote "Brandweerstokken zijn lange stokken die door brandweerlieden werden gebruikt, bijvoorbeeld om ladders te stabiliseren of om toegang te krijgen tot moeilijk bereikbare plaatsen. Ze zijn een deel van de geschiedenis van brandbestrijding."@nl;
  skos:altLabel "brandweerstok"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/abfc1bb7-04d7-43a0-9e99-dd4c5a4f2c15>;
