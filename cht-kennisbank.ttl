<https://data.cultureelerfgoed.nl/term/id/cht/980f0795-657f-45a2-aacf-4671b389d779>
  a skos:Concept;
  skos:prefLabel "hortus botanicus"@nl;
  skos:scopeNote "Botanische tuinen zijn collectietuinen die vanaf de middeleeuwen voor medische doeleinden (hortus medicus) en sinds de zeventiende eeuw voor onderzoek en onderwijs aan de universiteit dienden. De laatste decennia zijn daar het veiligstellen van bedreigde plantensoorten en educatie aan een breder publiek bij gekomen. Slechts enkele Nederlandse hortussen zijn nog aan de universiteit verbonden. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "botanische tuinen"@nl, "botanische tuin"@nl, "hortus"@nl, "hortussen"@nl,
    "plantentuinen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/43243bc0-662e-4c4c-a559-3156601ffc69>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

