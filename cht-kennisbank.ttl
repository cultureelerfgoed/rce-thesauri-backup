  a skos:Concept;
  skos:prefLabel "doorrijschuren"@nl;
  skos:scopeNote "Doorrijschuren zijn schuren met een open dwarsdeel waardoor de mogelijkheid bestaat om er met oogstwagens doorheen te rijden of deze wagen in de schuur te laden."@nl;
