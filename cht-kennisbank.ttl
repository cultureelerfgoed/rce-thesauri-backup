<https://data.cultureelerfgoed.nl/term/id/cht/41f474c6-d437-4d6b-8547-8c9397a417c7>
  a skos:Concept;
  skos:prefLabel "gemeentelijke begraafplaatsen"@nl;
  skos:scopeNote "Gemeentelijke begraafplaatsen zijn in handen van burgerlijke gemeenten. De Wet op de lijkbezorging onderscheid enkel gemeentelijke en bijzondere begraafplaatsen. (Wet op de lijkbezorging)"@nl;
  skos:altLabel "gemeentelijke begraafplaats"@nl;
