<https://data.cultureelerfgoed.nl/term/id/cht/32e32914-2acd-423d-9493-9b0f88c76517>
  a skos:Concept;
  skos:prefLabel "gedomesticeerd"@nl;
  skos:scopeNote "Gedomesticeerd heeft betrekking op het selecteren en fokken van oorspronkelijk wilde dieren tot huisdier of selectie en teelt tot verbouw gebrachte planten. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/df4db7b4-3b69-49a2-9068-13034f1a068f>;
