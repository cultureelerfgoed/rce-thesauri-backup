  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d702f40f-6eca-40eb-9b0f-fc277a6e8cc7>
  a skos:Concept;
  skos:prefLabel "kopbalken (spinnekop)"@nl;
  skos:scopeNote "Balk in spinnekop die de koker draagt. Manderbalk in wipmolen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/650ab4b1-e8ab-4c49-9195-8401d4a6cd6e>;
