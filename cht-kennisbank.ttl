<https://data.cultureelerfgoed.nl/term/id/cht/f78784c2-154f-400a-94a5-8d4801650167>
  a skos:Concept;
  skos:prefLabel "opperofficieren (luchtmacht)"@nl;
  skos:scopeNote "Opperofficieren bij de luchtmacht zijn de hoogste officiersrangen binnen de luchtmachtorganisatie. Zij vervullen strategische en operationele leidinggevende functies."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/144883a5-7f82-404f-9698-f1e7f7fec8a5>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/ee455779-8c67-4851-95ff-fea85a0d5681>,
