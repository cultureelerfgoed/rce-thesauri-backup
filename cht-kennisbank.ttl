<https://data.cultureelerfgoed.nl/term/id/cht/5c8db936-ede6-48fb-8a28-78c77c1ad4ef>
  a skos:Concept;
  skos:prefLabel "dubbele bovenliggende nokkenassen"@nl;
  skos:scopeNote "Bij dubbele bovenliggende nokkenassen zijn de nokkenassen bovenop de cilinderkop gemonteerd. Bij dubbele bovenliggende nokkenassen bedient elke nokkenas een aparte rij kleppen."@nl;
  skos:altLabel "dubbele bovenliggende nokkenas"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d9af3f44-5790-470a-93a6-50802693ab39>;
