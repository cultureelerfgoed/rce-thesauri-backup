  a skos:Concept;
  skos:prefLabel "differentieelhuizen"@nl;
  skos:scopeNote "Het differentieelhuis is het element van de transmissie waar het kroonwiel en pignon zijn ingebouwd. Het differentieelhuis is verbonden aan de versnellingsbak (voorwielaandrijving) of is in de achterasconstructie opgenomen (achterwielaandrijving)"@nl;
  skos:altLabel "differentieelhuis"@nl;
