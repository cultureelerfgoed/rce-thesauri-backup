<https://data.cultureelerfgoed.nl/term/id/cht/0668b101-8ec0-4d39-8f9b-f0e43a0a779d>
  a skos:Concept;
  skos:prefLabel "bedevaartprenten"@nl;
  skos:scopeNote "Devotieprent op perkament, papier of linnen of vouwbriefje dat werd meegnomen uit een bedevaarsoord, uitgegeven de vele broederschappen die jaarlijks bedevaarten organiseren of organiseerden. (Religieus Erfgoedthesaurus)"@nl;
  skos:altLabel "bedevaartpentje"@nl, "bedevaartprent"@nl, "bedevaartprentjes"@nl;
