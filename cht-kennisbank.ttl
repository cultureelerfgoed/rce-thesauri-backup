<https://data.cultureelerfgoed.nl/term/id/cht/4201602d-9f56-43b3-8995-a6d7c3157fac>
  a skos:Concept;
  skos:prefLabel "echoloden"@nl;
  skos:scopeNote "Echoloden zijn instrumenten waarmee diepten kunnen worden bepaald door middel van teruggekaatste geluidsgolven. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "echolood"@nl;
