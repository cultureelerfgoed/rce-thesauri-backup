<https://data.cultureelerfgoed.nl/term/id/cht/a8fcd9ed-e0b1-440a-8564-4bffe9819dcd>
  a skos:Concept;
  skos:prefLabel "oorlogen"@nl;
  skos:scopeNote "Open en officieel verklaard vijandelijk gewapend conflict tussen naties of partijen binnen een natie. (AAT-Ned)"@nl;
  skos:altLabel "oorlog"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/15d2a044-9ebe-4f8e-8a34-bd7e5780b2aa>;
