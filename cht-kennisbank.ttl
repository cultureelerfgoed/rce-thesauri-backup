<https://data.cultureelerfgoed.nl/term/id/cht/3aea8a0e-5dbd-4d68-bfb8-364f34049b20>
  a skos:Concept;
  skos:prefLabel "banne"@nl;
  skos:scopeNote "Een banne was vroeger de term voor een rechtsgebied. Een ban of banne stond onder de rechtspraak van een rechter.Nu nog is het woord terug te vinden in plaatsnamen als Banne Buiksloot en Vrijenban en in het woord -bandijk-. Vroeger sprak men van de Ban(ne) van Westzaan, Assendelft enz. Bannen werden gemarkeerd door banpalen. Iemand die -verbannen- werd, mocht zich niet meer binnen de banne begeven. Hij was dan uit de gemeenschap verwijderd. Het woord bandiet betekent eigenlijk -iemand die verbannen is-."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/96f8ea1c-ab5c-42dc-975b-8ec50ae5bc66>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/602e1b7c-5bc4-409f-be47-36980f4ccd4a>
  a skos:Concept;
  skos:prefLabel "beeldend kunstenaars"@nl;
  skos:scopeNote "Beeldend kunstenaars maken visuele kunst, zoals schilderijen, beeldhouwwerken, installaties of grafiek. Zij werken met vorm, kleur en ruimte om ideeën uit te drukken."@nl;
  skos:altLabel "beeldend kunstenaar"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db4a7619-d236-4b14-8e79-b4a6e890f677>;
