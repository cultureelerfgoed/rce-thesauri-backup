<https://data.cultureelerfgoed.nl/term/id/cht/5fad86ba-0758-47e3-ba93-1043a0e92216>
  a skos:Concept;
  skos:prefLabel "kasteelbergen"@nl;
  skos:scopeNote "(Vroege-) Middeleeuwse kunstmatige heuvel, waarop veelal een verdedigingswerk was aangebracht. (Stichting Menno van Coehoorn)"@nl,
    "Een kasteelberg is een (in ons land meestal kunstmatige) verhoging, waarop in de Middeleeuwen een versterking werd gebouwd. De internationale term voor kasteelberg is motte. (Thesaurus landschap)"@nl;
  skos:altLabel "mottekastelen"@nl, "berg (verdedigingswerk)"@nl, "bolberg"@nl, "hegewier"@nl,
