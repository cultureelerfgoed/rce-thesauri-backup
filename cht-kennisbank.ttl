<https://data.cultureelerfgoed.nl/term/id/cht/5a1e6ab9-39f8-4d4a-8e88-fee564e4e321>
  a skos:Concept;
  skos:prefLabel "paarden (balk)"@nl;
  skos:scopeNote "Verticale balken waartussen de pasbalk is bevestigd. Inrichting om de lopersteen verticaal te verstellen, dus lichter of zwaarder te laten malen. (Molenwoordenboek B.D. Poppen)"@nl;
  skos:altLabel "paard (balk)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/650ab4b1-e8ab-4c49-9195-8401d4a6cd6e>;
