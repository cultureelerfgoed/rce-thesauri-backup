<https://data.cultureelerfgoed.nl/term/id/cht/b82b1af7-2b81-4047-8762-1db681e94b03>
  a skos:Concept;
  skos:prefLabel "spanningsmeters"@nl;
  skos:scopeNote "Apparaten die gebruik maken van de verandering van elektrische weerstand in metaaldraad om druk te meten. (AAT-Ned)"@nl;
