<https://data.cultureelerfgoed.nl/term/id/cht/9b114b68-fd92-4e4c-8694-fe3e54bed1d2>
  a skos:Concept;
  skos:prefLabel "lockheed schrijfremmen"@nl;
  skos:scopeNote "Lockheed schrijfremmen hebben een draaiend juk. Dit soort heeft een enkele zuiger, die rechtstreeks op het ene remblok werkt. De vloeistofdruk in de cilinder maakt dat het juk het andere remblok bedient."@nl;
  skos:altLabel "lockheed schrijfrem"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/02c8f023-078b-40eb-bf30-9cedb493559c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/02cd0244-2d22-4f9b-a816-b226ac37a7d2>
  a skos:Concept;
  skos:prefLabel "glasborstels"@nl;
  skos:scopeNote "Een glasborstel wordt voor schoonmaken gebruikt. Ongewenst materiaal wordt van een oppervlak verwijderd door het eraf te krassen."@nl;
  skos:altLabel "glasborstel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/610522c9-bd55-40c7-9711-d6409d4561a2>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/02d32470-3bf8-4dd0-a47f-5b6985670489>
  a skos:Concept;
  skos:prefLabel "koorborden"@nl;
  skos:scopeNote "Bord met het woord 'chorus'. Het werd in het koor gehangen bij de plaats van het eerstekoor tijdens het psalmodiëren van het koorgebed."@nl;
  skos:altLabel "koorbord"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2e44391b-0677-4f76-a9be-d9b3289b8108>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/02e1efc9-9be7-41c2-a4ec-6e0a6b358af9>
  a skos:Concept;
  skos:prefLabel "talrepen"@nl;
  skos:scopeNote "Touwsjorring, meestal tussen twee ogen."@nl;
  skos:altLabel "talreep"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/77f91bd1-4367-448a-903c-da826fa40e88>;
