<https://data.cultureelerfgoed.nl/term/id/cht/74bf3a0b-ce53-417d-b541-db56d21b3dd0>
  a skos:Concept;
  skos:prefLabel "wingplaatvloeren"@nl;
  skos:scopeNote "Wingplaatvloeren zijn vrijdragende vloeren waarvan alleen het middendeel is uitgevoerd als kanaalplaatvloer. De veel dunnere zijkanten worden wings of vleugels genoemd de vandaar de benaming. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "vleugelplaatvloer"@nl, "vleugelplaatvloeren"@nl, "vleugelvloer"@nl,
