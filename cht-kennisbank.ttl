<https://data.cultureelerfgoed.nl/term/id/cht/e749d386-7138-4567-9c43-a764bbb243fa>
  a skos:Concept;
  skos:prefLabel "compacte steden"@nl;
  skos:scopeNote "Compacte steden zijn het gevolg van een stedenbouwkundige concepten waarbij in een stad alle open plekken en oude bedrijfsterreinen worden volgebouwd om de stad weer aantrekkelijk te maken voor grotere groepen mensen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "compacte stad"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ec38530c-0050-458e-8f97-fb3276fc5cab>;
