<https://data.cultureelerfgoed.nl/term/id/cht/6e5260c8-a6a3-44c4-83ef-ac7d41368858>
  a skos:Concept;
  skos:prefLabel "vleesmessen"@nl;
  skos:scopeNote "Groot zwaar mes met breed lemmet om vlees mee te snijden, soms ook als wapen gebruikt. (Wikiwoordenboek)"@nl;
  skos:altLabel "vleesmes"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2ed04729-7ad2-4346-ae14-74dda34a3163>;
