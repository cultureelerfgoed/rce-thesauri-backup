<https://data.cultureelerfgoed.nl/term/id/cht/beed11b7-a60c-46e6-967f-d878b41d9fb3>
  a skos:Concept;
  skos:prefLabel "rietdekkersmessen"@nl;
  skos:scopeNote "Stevig mes, ruim 50 cm lang."@nl;
  skos:altLabel "rietdekkersmes"@nl, "strodekkersmes"@nl;
