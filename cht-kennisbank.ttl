  a skos:Concept;
  skos:prefLabel "kalkzandsteen (CD)"@nl;
  skos:scopeNote "Kalkzandsteen is een afzettingsgesteente dat bestaat uit kwartskorrels die gebonden zijn door carbonaten."@nl;
