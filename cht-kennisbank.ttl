  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/90903bdc-4e7e-4b7a-82fd-1accd119916c>
  a skos:Concept;
  skos:prefLabel "antropomorfisme"@nl;
  skos:scopeNote "Het overdragen van menselijk-lichamelijke delen, eigenschappen, betrekkingen en attributen op voorwerpen, i.c. bouwwerken. Een dergelijke zienswijze – te onderscheiden van de m.e. symboliek (architectuurtheorie) – vindt men vooral in de bouwtheorieën van de renaissance (Filarete, De Giorgio). Die ijkte graag het menselijke tot maat van de dingen, ofschoon reeds oudere benamingen aan dit beginsel ontsproten, zoals: geboorte, lies, lende, graat, kruin van een gewelf, kop en voet van een zuil. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/df4db7b4-3b69-49a2-9068-13034f1a068f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/910d732d-ccbf-45fb-b362-436ac3705d01>
  a skos:Concept;
  skos:prefLabel "tecuta dakbedekking"@nl;
  skos:scopeNote "Tecuta dakbedekking is de benaming voor een combinatie van koper en teervrij dakvilt. Een alternatief is bekend met de naam cubiledekking."@nl;
  skos:altLabel "cubiledekking"@nl, "koperbitumen"@nl;
