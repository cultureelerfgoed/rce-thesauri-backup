  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c91d9dc3-ca20-439d-bc23-9b12a4069c16>
  a skos:Concept;
  skos:prefLabel "apostelkruisen"@nl;
  skos:scopeNote "Kruisvormige markering in de kerk (meestal op de muren of op zuilen) van de plek waar de bisschop de kerk met chrisma wijdde. Behoort tot een serie van twaalf wijdingskruisen, die de twaalf apostelen symboliseren, daarom ook wel apostelkruisen werden genoemd. (Wikipedia)"@nl;
  skos:altLabel "apostelkruis"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/63ab59b9-2253-40ee-a495-4b141bf2ff70>;
