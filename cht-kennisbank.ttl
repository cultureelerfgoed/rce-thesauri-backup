<https://data.cultureelerfgoed.nl/term/id/cht/6523d5f6-77fa-4566-9f25-74a618552749>
  a skos:Concept;
  skos:prefLabel "middenonder"@nl;
  skos:scopeNote "Middenonder beschrijft de positie of locatie van een object, detail of element dat zich direct onder het midden van een ander object of een structuur bevindt. Het wordt vaak gebruikt in beschrijvingen van symmetrische composities."@nl;
  skos:altLabel "midden onder"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d744a929-2f06-4ed4-8710-43cd695fe180>;
