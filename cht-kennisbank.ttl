<https://data.cultureelerfgoed.nl/term/id/cht/a76942d3-7755-4c80-9e54-c63afa4e1734>
  a skos:Concept;
  skos:prefLabel "islamitische scholen"@nl;
  skos:scopeNote "Islamitische scholen zijn scholen gebaseerd op de islamitische geloofsovertuiging, waar regulier onderwijs gecombineerd wordt met lessen in de islamitische leer en praktijk."@nl;
  skos:altLabel "islamitische school"@nl;
