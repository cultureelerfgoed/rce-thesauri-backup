<https://data.cultureelerfgoed.nl/term/id/cht/aca5e7d8-52d6-4b65-9907-bcbc57568c2f>
  a skos:Concept;
  skos:prefLabel "duplexwoningen"@nl;
  skos:scopeNote "Duplexwoningen zijn een type woningen uit de tijd van ernstige woningschaarste na de Tweede Wereldoorlog, bestaande uit twee kleine woningen boven elkaar, bedoeld om later tot een woning samengevoegd te worden"@nl;
  skos:altLabel "duplexwoning"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/27a69fff-57b2-4d81-a8ae-9102d21d03e2>;
