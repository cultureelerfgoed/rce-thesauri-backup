<https://data.cultureelerfgoed.nl/term/id/cht/46e4c36b-b42e-4da4-84c9-5bca3e11440a>
  a skos:Concept;
  skos:prefLabel "glasvezel"@nl;
  skos:scopeNote "Glasvezel is glas dat is gesmolten en is uitgetrokken tot draden. Het bestaat in vele samenstellingen en diktes. De draden kunnen worden gebruikt als wapening in kunstharsen en ze kunnen worden geweven in textiel."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2f786007-5bc0-4f0b-960b-3aad1e67b7e5>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/766e74eb-ecea-4941-987f-74d05060b980>,
