    <https://data.cultureelerfgoed.nl/term/id/cht/abb6393a-9c5d-4af4-ade1-b03187896895>,
    <https://data.cultureelerfgoed.nl/term/id/cht/c5734ef1-144a-4825-944b-dc48d78e1ae6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

