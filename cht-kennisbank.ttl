  a skos:Concept;
  skos:prefLabel "halve manen (scheepvaart)"@nl;
  skos:scopeNote "Aan weerszijden van de achtersteven was bij vele vrachtschepen een halve cirkel te zien met de opening naar boven; binnen deze halve cirkel had de scheepshuid een afwijkende kleur."@nl;
  skos:altLabel "halve maan (scheepvaart)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/77f91bd1-4367-448a-903c-da826fa40e88>;
