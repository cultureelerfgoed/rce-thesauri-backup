  a skos:Concept;
  skos:prefLabel "spitsvlechten"@nl;
  skos:scopeNote "Houweelachtig steenhouwersgereedschap met aan één zijde een spitse punt en aan de andere zijde een vlecht. Het brede bijlachtige vlak kan zowel evenwijdig aan de steel lopen als er loodrecht op staan."@nl;
  skos:altLabel "spitsvlecht"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/71c7f68d-aa4f-4515-b020-139b181eafec>;
