<https://data.cultureelerfgoed.nl/term/id/cht/0f4eae91-224a-446d-bc26-74e085a83200>
  a skos:Concept;
  skos:prefLabel "winkelwoningen"@nl;
  skos:scopeNote "Winkelwoningen zijn gebouwen waar de winkel- en woonfunctie met elkaar gecombineerd worden. In dorpen bevindt de woning zich in het achterste gedeelte van het gebouw. In grotere steden en centrumgebieden hebben deze panden twee bouwlagen Op de begane grond bevinden zich de winkel en de achtergelegen opslagruimten. De woning bevindt zich dan op de eerste verdieping."@nl;
  skos:altLabel "winkelwoning"@nl, "winkelwoonhuis"@nl, "winkelwoonhuizen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/27a69fff-57b2-4d81-a8ae-9102d21d03e2>;
