<https://data.cultureelerfgoed.nl/term/id/cht/1ad404b2-7984-4303-8309-7310eb8ba720>
  a skos:Concept;
  skos:prefLabel "mult-role helikopters"@nl;
  skos:scopeNote "Een multi-role helikopter is een helikopter die wordt gebruikt voor verschillende taken als transport, elektronische oorlogsvoering en medische evacuaties."@nl;
