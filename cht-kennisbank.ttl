<https://data.cultureelerfgoed.nl/term/id/cht/853d4aed-be1b-43b9-970e-ca9a1a874199>
  a skos:Concept;
  skos:prefLabel "verde di Ponsevera"@nl;
  skos:scopeNote "Een serpentijn uit het Italiaanse Ponsevera bij Genua. Het is meestal groen met witte aders. De groene kleur varieert van lichtgroen tot metallic groen tot blauwachtig groen. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/66347aaa-273b-442c-a18b-703dea519df0>;
