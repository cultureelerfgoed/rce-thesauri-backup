<https://data.cultureelerfgoed.nl/term/id/cht/3a6adbfa-1a95-4c20-b0d2-3e2d689ce666>
  a skos:Concept;
  skos:prefLabel "isopreen rubber"@nl;
  skos:scopeNote "Isopreen rubber is een synthetisch elastomeer dat veel eigenschappen deelt met natuurrubber. Het wordt gebruikt in een breed scala aan toepassingen, waaronder banden, slangen, en elastische materialen vanwege zijn duurzaamheid en elasticiteit."@nl;
  skos:altLabel "IR (Rubber)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9834c5a3-66d2-4d2d-aa64-789ff13dde5e>;
