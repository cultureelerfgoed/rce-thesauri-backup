<https://data.cultureelerfgoed.nl/term/id/cht/90879269-caee-468f-b391-5ebb97badc13>
  a skos:Concept;
  skos:prefLabel "verhoogde bogen"@nl;
  skos:scopeNote "Verhoogde bogen of steltbogen zijn bogen waarvan tussen de aanzetten en de hieronder gestelde dragers (zuilen, pijlers) zich korte stukken rechtstand bevinden. De lancetboog is een voorbeeld van een verhoogde boog."@nl;
  skos:altLabel "steltbogen"@nl, "steltboog"@nl, "verhoogde boog"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/42f94d21-f2a3-40e2-bf34-cc9e17ddaaaa>;
