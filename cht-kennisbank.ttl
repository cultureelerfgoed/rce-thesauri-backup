<https://data.cultureelerfgoed.nl/term/id/cht/2bcd1a94-7d94-4666-925c-84acdc62a46a>
  a skos:Concept;
  skos:prefLabel "vierkleurenautotypieën"@nl;
  skos:scopeNote "Autotypieën in vier drukgangen: rood (magenta), geel, blauw (cyaan) en zwart. Let op: bij combinatiedrukken worden de technieken apart vermeld, bijv. sleutel autotypie met chromolithografie of sleutel lichtdruk met chromolithografie. Dit zijn dus geen (meer)kleurenautotypieën. (Project Fotografie)"@nl;
  skos:altLabel "vierkleurenautotypie"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fd69bda4-88da-4b39-9ec0-b58e9645d6b7>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/0544d46d-ea46-41b4-9da8-def2e1a820f9>
  a skos:Concept;
  skos:prefLabel "knikbogen"@nl;
  skos:scopeNote "Geknikte bogen zijn bogen waarvan de boogdelen in het midden een rechthoekige knik vertonen. Deze bogen lenen zich beter voor decoratieve dan voor constructieve toepassingen. (Haslinghuis)"@nl;
  skos:altLabel "geknikte bogen"@nl, "geknikte boog"@nl, "knikboog"@nl;
