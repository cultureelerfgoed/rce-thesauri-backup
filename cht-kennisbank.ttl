<https://data.cultureelerfgoed.nl/term/id/cht/99912b2c-a4f8-4642-8199-c3038bb0ed84>
  a skos:Concept;
  skos:prefLabel "apostellinden"@nl;
  skos:scopeNote "Bewuste aanplant van twaalf lindebomen in een cirkel, verwijzing naar de twaalf apostelen."@nl;
  skos:altLabel "apostellinde"@nl, "twaalf apostelen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2971af0-cde7-4888-b828-33443f702e7d>;
