  a skos:Concept;
  skos:prefLabel "conservering (voedsel)"@nl;
  skos:scopeNote "Conservering is het proces waarbij voedsel wordt behandeld om bederf tegen te gaan en de houdbaarheid te verlengen, dit kan door drogen, pekelen of invriezen."@nl;
  skos:altLabel "conserveren (voedsel)"@nl, "geconserveerd"@nl;
