  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a1758ed4-1591-4b86-a3e4-082c2443f343>
  a skos:Concept;
  skos:prefLabel "dummy's (gedrukt materiaal)"@nl;
  skos:scopeNote "Onafgedrukte, gedeeltelijk afgedrukte of geschetste stalen van geplande publicaties om de indruk te wekken van het voltooide werk (AAT-Ned)"@nl;
