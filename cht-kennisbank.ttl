<https://data.cultureelerfgoed.nl/term/id/cht/947870ef-17c3-419a-8d11-6a21f4ccbace>
  a skos:Concept;
  skos:prefLabel "sjablonen"@nl;
  skos:scopeNote "Een sjabloon is een vel papier, een blad metaal, plastic plaat of dun karton waaruit een vorm is uitgesneden. (Conservation Dictionary)"@nl,
    "Een sjabloon is een vel papier, een blad metaal, plastic plaat of dun karton waaruit een vorm is uitgesneden. Het wordt gebruikt om de vorm over te brengen op een ander oppervlak door verf te spuiten door de uitsnijdingen. Zie ook sjabloneren. (Conservation Dictionary)"@nl;
  skos:altLabel "sjabloon"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
