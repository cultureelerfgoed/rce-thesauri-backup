<https://data.cultureelerfgoed.nl/term/id/cht/5880ffe5-8613-4625-a359-1b47cb99640d>
  a skos:Concept;
  skos:prefLabel "vorsttegels"@nl;
  skos:scopeNote "Vorsttegels zijn vorstpannen met een hoekige bovenzijde, horend bij een bedekking van daktegels."@nl;
  skos:altLabel "vorststeen"@nl, "vorststenen"@nl, "vorsttegel"@nl;
