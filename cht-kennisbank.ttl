<https://data.cultureelerfgoed.nl/term/id/cht/bf8c7784-a484-44f8-aff0-097cf6e8c829>
  a skos:Concept;
  skos:prefLabel "aarden vloeren"@nl;
  skos:scopeNote "Een aarden (lemen) vloer is een vloer die bestaat uit aangestampte aarde. (Conservation Dictionary)"@nl;
  skos:altLabel "aarden vloer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/3bf64cd9-cf95-4482-9e31-6069991467df>;
