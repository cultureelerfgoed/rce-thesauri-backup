  a skos:Concept;
  skos:prefLabel "onderhuizen"@nl;
  skos:scopeNote "Onderhuizen zijn woningen in het onderste gedeelte van een huis, vaak half in de grond gebouwd. (Haslinghuis)"@nl;
  skos:altLabel "benedenhuis"@nl, "benedenhuizen"@nl, "onderhuis"@nl;
