<https://data.cultureelerfgoed.nl/term/id/cht/71574b68-e934-4922-b58c-045a223c6421>
  a skos:Concept;
  skos:prefLabel "zoomlatten"@nl;
  skos:scopeNote "Zoomlatten zijn kleine latten van ca. 12 x 36 mm die aangebracht worden op binnen boeiborden. Om wat meer ruimte te verkrijgen voor het aanbrengen van de zinken goten en het voetlood worden de beschietingen niet direct, maar via zoomlatten op de binnen boeiborden vastgespijkerd. (Bouwkunde / Jellema, R., deel 3, 1964)"@nl;
  skos:altLabel "zoomlat"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/650ab4b1-e8ab-4c49-9195-8401d4a6cd6e>;
