<https://data.cultureelerfgoed.nl/term/id/cht/a04370da-e66f-465c-9599-189349908b52>
  a skos:Concept;
  skos:prefLabel "villaboerderijen"@nl;
  skos:scopeNote "Villaboerderijen zijn boerderijen met een woonhuis dat de kenmerken heeft van een villa."@nl;
