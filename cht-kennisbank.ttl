<https://data.cultureelerfgoed.nl/term/id/cht/947f3c25-f11d-40fa-97ac-e766e29a1f86>
  a skos:Concept;
  skos:prefLabel "heksmederijen"@nl;
  skos:scopeNote "Heksmederijen zijn smederijen die zich gespecialiseerd hebben in het maken van hekwerken, in het bijzonder sierhekwerken."@nl;
