  a skos:Concept;
  skos:prefLabel "imitatiefotokeramiek"@nl;
  skos:scopeNote "Op fotokeramiek lijkende foto's die voorzien zijn van een bolle, glanzende celluloid-toplaag op karton (semi-emaille) of op bol blik (fotobuttons). (Project Fotografie)"@nl;
