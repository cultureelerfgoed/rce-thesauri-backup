  a skos:Concept;
  skos:prefLabel "cantille"@nl;
  skos:scopeNote "Cantille is een fijn metaaldraad of een materiaal dat gebruikt wordt voor decoratieve toepassingen, vooral in borduurwerk en sieraden."@nl;
