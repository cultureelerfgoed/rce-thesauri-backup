<https://data.cultureelerfgoed.nl/term/id/cht/496c19fc-f866-4484-bef0-f8722991b873>
  a skos:Concept;
  skos:prefLabel "industriele waarden"@nl;
  skos:scopeNote "Een onroerend goed heeft industrieel-archeologische waarde als het getuigt van een ambachtelijk of industrieel verleden. (bron:https://id.erfgoed.net/thesauri/waardetypes/44)"@nl;
