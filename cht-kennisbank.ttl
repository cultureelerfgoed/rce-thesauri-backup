  a skos:Concept;
  skos:prefLabel "stroopkokerijen"@nl;
  skos:scopeNote "Stroopkokerijen zijn agrarische gebouwen waar suikersap van bijvoorbeeld bieten of fruit wordt gekookt en verwerkt tot stroop, vaak met grote ketels en stookinstallaties."@nl;
