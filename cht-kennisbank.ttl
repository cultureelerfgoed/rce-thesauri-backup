<https://data.cultureelerfgoed.nl/term/id/cht/a8803cf9-29c7-42c5-810c-5e945aeedcbf>
  a skos:Concept;
  skos:prefLabel "omtrek"@nl;
  skos:scopeNote "Lijn die een cirkelvormig plat vlak begrensd; de lengte van deze lijn is gelijk aan pi maal de diameter. (AAT)"@nl;
