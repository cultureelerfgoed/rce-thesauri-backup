<https://data.cultureelerfgoed.nl/term/id/cht/8f99cb36-93fc-4415-ba59-d7b8bf3fe09f>
  a skos:Concept;
  skos:prefLabel "verdikte bovenrand"@nl;
  skos:scopeNote "Verdikte bovenrand beschrijft een rand die dikker is dan de rest van het object, vaak toegepast in serviesgoed en glazen om extra stevigheid en een decoratief element toe te voegen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ec63f655-7a67-49ee-ab0e-c5e1666aa051>;
