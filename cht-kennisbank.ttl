<https://data.cultureelerfgoed.nl/term/id/cht/556986a6-e598-420e-9eb9-bc1d38c88a86>
  a skos:Concept;
  skos:prefLabel "rijnen"@nl;
  skos:scopeNote "Molenijzer bevestigd aan de bovenste molensteen (loper) waarin zowel het klauwijzer (steenspil, staakijzer) als de kleine spil (peerijzer, bolspil) op een bepaalde manier grijpen. Zie molenijzer, tuimelrijn."@nl;
  skos:altLabel "brug (molenijzer)"@nl, "bruggen (molenijzer)"@nl, "rijn"@nl;
