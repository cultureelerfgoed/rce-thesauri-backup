<https://data.cultureelerfgoed.nl/term/id/cht/58b67d23-3840-4ef7-a4b1-53dc4099367d>
  a skos:Concept;
  skos:prefLabel "gebedsriemen"@nl;
  skos:scopeNote "Tefilin of tefillien (Hebreeuws: תפילין, afgeleid van tefiela, gebed) of tefillen (Nederlands-Jiddisch/Asjkenazische uitspr.) zijn in het jodendom riemen waaraan doosjes die bij het Joodse ochtendgebed worden gedragen. In de doosjes zitten teksten uit de Pentateuch.Op doordeweekse worden de gebedsriemen gedragen bij het ochtendgebed (sjachariet). De gebedsriemen bestaan uit een hoofdstel (Hebreeuws tefillien shel rosh) en een gedeelte om de arm en hand (Hebreeuws tefillien shel jad). (Wikipedia)"@nl;
  skos:altLabel "gebedsriem"@nl, "tefiliem"@nl, "tefilin"@nl, "tefillen"@nl, "tefillien"@nl,
    "tefillim"@nl, "tefillin"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/155dba54-1be0-460c-b6b2-c137c02ff7ed>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

