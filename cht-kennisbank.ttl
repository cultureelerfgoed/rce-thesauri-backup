<https://data.cultureelerfgoed.nl/term/id/cht/39adc900-7b15-4248-bf38-15cfb7aea578>
  a skos:Concept;
  skos:prefLabel "aangieten"@nl;
  skos:scopeNote "Aangieten is een techniek om metalen werkstukken te verbinden. Eén stuk is een deel van de gietmal, het andere wordt er permanent aan bevestigd door gesmolten metaal in de mal te gieten."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/923ae204-3093-4214-9001-5eec55be8f5d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ccf30c23-e268-4f54-a20d-9e4ea9f77f7d>
  a skos:Concept;
  skos:prefLabel "impannata's"@nl;
  skos:scopeNote "M.e. raambespanning van linnen of papier, gedrenkt in terpentijn. (Haslinghuis)"@nl;
  skos:altLabel "impannata"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4e481c81-319a-44da-86bf-106f145d22c1>;
