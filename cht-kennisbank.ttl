<https://data.cultureelerfgoed.nl/term/id/cht/23660f35-711b-4b21-bd96-05d4bf73a9ca>
  a skos:Concept;
  skos:prefLabel "Brabants hout"@nl;
  skos:scopeNote "Brabants hout is eikenhout uit het zuidelijke deel van het voormalig hertogdom Brabant, met name ten zuiden van Brussel. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
