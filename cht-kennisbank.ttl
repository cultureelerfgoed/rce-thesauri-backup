<https://data.cultureelerfgoed.nl/term/id/cht/2c5d97ac-2e58-4fab-a74a-035e0e80b64e>
  a skos:Concept;
  skos:prefLabel "kantschuiven"@nl;
  skos:scopeNote "Lange verticale grendel voor het vastzetten van hoge deuren en ramen aan de bovenkant. (Haslinghuis)"@nl;
  skos:altLabel "kantschuif"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/31c8b029-61c5-423a-b5ce-e901c267adbc>;
