<https://data.cultureelerfgoed.nl/term/id/cht/86264cff-01a7-4ec3-82ae-3eda1f7a7a65>
  a skos:Concept;
  skos:prefLabel "academies"@nl;
  skos:scopeNote "Gebouw waarin een hogere school voor beeldende kunsten is gevestigd. Daarom voorzien van goed verlichte werk- en leslokalen, tentoonstellingszaal en liefst een aula of gehoor- en ontvangstzaal. Aangezien deze kunstacademies sinds XVId in Italië en Frankrijk in zwang kwamen, placht haar architectuur classicistisch te zijn, althans tot XX. (Haslinghuis)"@nl;
  skos:altLabel "academie"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f6451643-0a3a-4077-a19c-d6a30a4e2583>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/676f84f2-a92e-46db-8b48-ecdfaa56fab1>
  a skos:Concept;
