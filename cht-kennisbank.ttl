<https://data.cultureelerfgoed.nl/term/id/cht/e37d07cf-bee0-4073-9a96-dedc22de82e6>
  a skos:Concept;
  skos:prefLabel "lichtgevoelig"@nl;
  skos:scopeNote "Een lichtgevoelig materiaal of object raakt beschadigd door de blootstelling aan licht."@nl,
    "De mogelijkheid of neiging van een stof te reageren op licht of een soortgelijk straling. (AAT)"@nl;
  skos:altLabel "lichtgevoeligheid"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
