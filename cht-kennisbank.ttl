<https://data.cultureelerfgoed.nl/term/id/cht/cb902553-0371-402b-9e1b-cd3c7e03f432>
  a skos:Concept;
  skos:prefLabel "kalkschoppen"@nl;
  skos:scopeNote "Enigszins holle schop, waarmee kalkmortel geschept wordt. Deze schop heeft een vrijwel rechte onderzijde en een essen- of beukenhouten steel met daarop een kruk."@nl;
  skos:altLabel "kalkschop"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/45a6ff74-f598-4e21-b99d-a241ecde2612>;
