<https://data.cultureelerfgoed.nl/term/id/cht/d92b4770-7f77-4a4c-86ea-46ffd7e23d54>
  a skos:Concept;
  skos:prefLabel "Turkse tenten"@nl;
  skos:scopeNote "De Turkse tent is een tuinhuis in Oosterse of exotische stijl uitgevoerd als tent in textiel of in steen of hout. Populair in de achttiende eeuw. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "Turkse tent"@nl;
