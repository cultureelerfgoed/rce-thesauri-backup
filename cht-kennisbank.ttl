<https://data.cultureelerfgoed.nl/term/id/cht/c2ab0958-57c6-4224-a6fd-a9401632ec63>
  a skos:Concept;
  skos:prefLabel "weegbruggen"@nl;
  skos:scopeNote "Weegbruggen zijn weegtoestellen om zware of grote hoeveelheden goederen, zoals volgeladen wagens, te wegen. (Van Dale 1991)"@nl;
  skos:altLabel "weegbrug"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
