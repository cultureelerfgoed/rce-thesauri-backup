  a skos:Concept;
  skos:prefLabel "hart op hart"@nl;
  skos:scopeNote "Gemeten van het midden van een pijler, balk, stijl of muur tot het midden van een andere. Vgl. ‘in de dag’ gemeten. (Haslinghuis)"@nl;
