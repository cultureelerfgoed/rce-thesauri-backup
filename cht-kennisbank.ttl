<https://data.cultureelerfgoed.nl/term/id/cht/c946b9de-13d6-4a96-b2b1-4abe4864db17>
  a skos:Concept;
  skos:prefLabel "metaalhalogeniden"@nl;
  skos:scopeNote "Metaalhalogeniden zijn verbindingen tussen metalen en halogenen. Sommige, zoals natriumchloride, zijn ionisch, terwijl andere covalent gebonden zijn. Enkele metaalhalogeniden zijn afzonderlijke moleculen, zoals uraniumhexafluoride, maar de meeste hebben een polymere structuur, zoals palladiumchloride."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6d02e6d5-2479-40e9-9861-573af29e1b21>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/1cafa6d9-5d1c-48da-b1e4-3e0b22573b07>
  a skos:Concept;
  skos:prefLabel "eswallen"@nl;
  skos:scopeNote "Opgeworpen wal rond of deels rond een es."@nl, "Wal rond de es om loslopend vee buiten de akkers te houden. Reeds in de Late Middeleeuwen had men wallen met houtsingels rond het bouwlandencomplex van het esdorp, die, wat vorm en functie betreft, overeenkwamen met de wallen in de groenlanden. De wal rond de es hield loslopend vee uit de akkers.(Geheugen van Drenthe)"@nl;
  skos:altLabel "eswal"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2971af0-cde7-4888-b828-33443f702e7d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c369dcf0-e79c-410f-aa09-d2f3f94bcffb>
  a skos:Concept;
  skos:prefLabel "jufferbalken"@nl;
  skos:scopeNote "Vierkant behakte juffer. (Haslinghuis)"@nl;
  skos:altLabel "jufferbalk"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/650ab4b1-e8ab-4c49-9195-8401d4a6cd6e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/bba47959-5cd6-453b-b5a2-9f8cbdd46435>
  a skos:Concept;
  skos:prefLabel "hoofden"@nl;
  skos:scopeNote "De bovenste lichaamsdelen van mens of dier die de mond of bek, zintuiglijke organen zoals ogen, neus en oren, en de hersenen bevatten; gewoonlijk door een nek of hals gescheiden of anderszins te onderscheiden van de rest van het lichaam. (AAT-Ned)"@nl;
  skos:altLabel "hoofd"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e9f07631-1f34-408d-a1cd-08cb80cf2023>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/db815fb3-dc7d-4b4e-83bf-b8048da94c4e>
  a skos:Concept;
  skos:prefLabel "schiphuizen"@nl;
  skos:scopeNote "Soort van over het water gebouwde schuur waarin één of meerdere vaartuigen ligplaats kunnen hebben. (De Binnenvaart)"@nl;
  skos:altLabel "schiphuis"@nl, "schuitenhuis"@nl, "schuitenhuizen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e9f07631-1f34-408d-a1cd-08cb80cf2023>;
