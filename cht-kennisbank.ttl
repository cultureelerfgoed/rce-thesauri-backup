<https://data.cultureelerfgoed.nl/term/id/cht/894ebefc-277d-40a6-8184-1a50713b621c>
  a skos:Concept;
  skos:prefLabel "banen (rand)"@nl;
  skos:scopeNote "Smalle gladgehakte rand langs een ruw behouwen blok steen. (Haslinghuis)"@nl;
