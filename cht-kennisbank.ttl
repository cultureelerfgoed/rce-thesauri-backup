<https://data.cultureelerfgoed.nl/term/id/cht/bf6a13f5-5631-467b-9a76-77df3a3b7166>
  a skos:Concept;
  skos:prefLabel "zeeleeuwen"@nl;
  skos:scopeNote "De zeeleeuwen vormen een groep (meestal beschouwd als onderfamilie, Otariinae) van zeeroofdieren uit de familie der oorrobben (Otariidae). Grote zeer beweeglijke soort van oorrob waarvan het mannetje korte manen heeft (leeft aan de kusten van de Grote Oceaan). (Wikipedia/MARDOC)"@nl;
  skos:altLabel "zeeleeuw"@nl, "Otariinae"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/78672fa4-8815-4427-995e-21a2cc90bd39>;
