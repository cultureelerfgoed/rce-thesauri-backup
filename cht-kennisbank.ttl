<https://data.cultureelerfgoed.nl/term/id/cht/3d69a1df-3503-4f12-8bfa-273ee852c769>
  a skos:Concept;
  skos:prefLabel "Europaschepen"@nl;
  skos:scopeNote "Grote binnenvaartschepen met een waterverplaatsing van ongeveer 1350 ton ontstaan uit het Rijn- of Hernaschip. (MARDOC)"@nl;
  skos:altLabel "Europaschip"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c277e22a-e53d-4a3f-a21b-34e5fc1e153c>;
