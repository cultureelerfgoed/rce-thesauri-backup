<https://data.cultureelerfgoed.nl/term/id/cht/884145b6-ce14-47da-b577-57c147ebbf2e>
  a skos:Concept;
  skos:prefLabel "motorfietsonderdelen"@nl;
  skos:scopeNote "Onderdelen van een motorfiets. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "motorfietsonderdeel"@nl;
