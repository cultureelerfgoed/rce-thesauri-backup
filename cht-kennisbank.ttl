<https://data.cultureelerfgoed.nl/term/id/cht/ec000ff8-560f-4da7-866d-a3286eacb5a2>
  a skos:Concept;
  skos:prefLabel "schakelmoffen"@nl;
  skos:scopeNote "Het koppelen van de tandwielen met de as gebeurt door schakelmoffen, die met spiebanen op de as zijn bevestigd."@nl;
