<https://data.cultureelerfgoed.nl/term/id/cht/068a34a3-4a34-408c-bbb7-6930d22fc223>
  a skos:Concept;
  skos:prefLabel "grondduikers"@nl;
  skos:scopeNote "Gelegen in een onder een ander water doorlopende koker, die dient voor de instandhouding van de verbinding tussen wederzijds gelegen wateren of voor de afwatering van aangrenzende landerijen."@nl;
  skos:altLabel "grondduiker"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a24eeb8a-cddf-4bda-82a1-d0f6b61fc01d>;
