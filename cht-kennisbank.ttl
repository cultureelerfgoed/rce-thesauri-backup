<https://data.cultureelerfgoed.nl/term/id/cht/b72030fe-5a75-49c4-b005-e5d1d45c0bd3>
  a skos:Concept;
  skos:prefLabel "toetsnaalden"@nl;
  skos:scopeNote "Om het gehalte van goud of zilver te bepalen moet men weten wat voor gehalte een bepaalt voorwerp heeft. Voor het toetsen heeft men een stel toetsnaalden, een toetssteen en een paar flesjes toetswater nodig.(bron:wiki.gzu-online.com)"@nl,
    """Om het gehalte van goud of zilver te bepalen moet men weten wat voor gehalte een bepaalt voorwerp heeft. Voor het toetsen heeft men een stel toetsnaalden, een toetssteen en een paar flesjes toetswater nodig.(bron:wiki.gzu-online.com)
"""@nl;
  skos:altLabel "toetsnaald"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
