<https://data.cultureelerfgoed.nl/term/id/cht/b7964234-f207-47fc-a9a5-a66a0a910ee3>
  a skos:Concept;
  skos:prefLabel "stoephekken"@nl;
  skos:scopeNote "Hek om een een stoep; ook als het aangebracht is tussen stoeppalen d.m.v. stangen of kettingen."@nl;
