  a skos:Concept;
  skos:prefLabel "strodekken"@nl;
  skos:scopeNote "Strodekken is het vakkundig dekken van een dak of wand met stro. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
