<https://data.cultureelerfgoed.nl/term/id/cht/a1afa7c1-414c-4d16-a76c-a22ab19c84f1>
  a skos:Concept;
  skos:prefLabel "bedstededeuren"@nl;
  skos:scopeNote "Twee kleine deuren in de wand waarmee een bedstede kan worden gesloten, o.a. tegen de kou tijdens het slapen."@nl;
