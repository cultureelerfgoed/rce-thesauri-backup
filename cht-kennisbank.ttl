<https://data.cultureelerfgoed.nl/term/id/cht/c86774b1-0304-4c34-a68e-c2375b71e1d4>
  a skos:Concept;
  skos:prefLabel "twijfelaars"@nl;
  skos:scopeNote "Een twijfelaar is een bed met een zodanige breedte (100-120 cm) dat het als eenpersoonsbed breed is en als tweepersoonsbed smal. (Wikipedia)"@nl;
  skos:altLabel "twijfelaar"@nl;
