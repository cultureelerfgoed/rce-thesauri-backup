<https://data.cultureelerfgoed.nl/term/id/cht/a01fb7e7-b679-4013-937a-a4b57262faf6>
  a skos:Concept;
  skos:prefLabel "dekbalkstandjukken"@nl;
  skos:scopeNote "Dekbalkstandjukken zijn standjukspanten waarbij de jukbalk is uitgevoerd als een dekbalk. (Historische houtconstructies in Nederland / G. Behrends, 1996)"@nl;
  skos:altLabel "dekbalkstandjuk"@nl;
