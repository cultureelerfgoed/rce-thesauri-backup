<https://data.cultureelerfgoed.nl/term/id/cht/5ef76be0-66bf-4323-ba1d-869487177749>
  a skos:Concept;
  skos:prefLabel "paumellen"@nl;
  skos:scopeNote "Scharnier met één knoop aan ieder lid. Op de onderste knoop is een pen bevestigd, waar de knoop van het andere lid over valt. Het is met een paumelle niet mogelijk in gesloten positie de pennen van de scharnieren te verwijderen. (Haslinghuis)"@nl;
  skos:altLabel "paumelle"@nl, "stopfits"@nl, "stopfitsen"@nl;
