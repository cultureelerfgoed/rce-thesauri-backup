  a skos:Concept;
  skos:prefLabel "Rechter Blauwsteen"@nl;
  skos:scopeNote "Rechter Blauwsteen is een duurzame natuursteensoort gewonnen in het belgische dorpje Recht, die veel gebruikt wordt in de bouw vanwege zijn hardheid en weerbestendigheid, vaak in historische gebouwen."@nl;
