<https://data.cultureelerfgoed.nl/term/id/cht/122bf5c1-8785-4e7f-a80f-310fa0d59695>
  a skos:Concept;
  skos:prefLabel "baleinkam"@nl;
  skos:scopeNote "Een baleinkam is een kam gemaakt van balein, een flexibel materiaal afkomstig uit de kaken van walvissen, traditioneel gebruikt voor fijne haarverzorging en decoratieve doeleinden."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/98b43208-765f-4658-92c5-3b5ade3dc0cb>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/97bb410f-a3f0-43d4-9211-93c8e825c946>
  a skos:Concept;
  skos:prefLabel "bedrukt textiel"@nl;
  skos:scopeNote "Bedrukt textiel is textiel dat is voorzien van patronen, afbeeldingen of andere ontwerpen door middel van verschillende druktechnieken, gebruikt in kleding en interieurstoffen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/86d3631a-1f3f-4b51-bbbb-dadebc310ecc>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/0a4c8a5c-3e3b-488c-b549-2598bc873231>
  a skos:Concept;
  skos:prefLabel "beenderporseleinen"@nl;
  skos:scopeNote "Beenderporseleinen is een type keramiek dat wordt gemaakt met beenderas, wat resulteert in een hard, wit en doorschijnend materiaal, vaak gebruikt voor serviesgoed van hoge kwaliteit."@nl;
  skos:altLabel "beenderporselein"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/239b6e00-5ce9-49a1-aba9-ff0c01bdb3d3>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/80be798c-2af6-4c7e-a57a-a7cfadb7d3f9>
  a skos:Concept;
  skos:prefLabel "behandelde staalplaten"@nl;
  skos:scopeNote "Behandelde staalplaten zijn metalen platen die een oppervlaktebehandeling hebben ondergaan, zoals verzinken of coaten, om hun weerstand tegen corrosie en slijtage te verbeteren."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2f015793-fc1f-4f76-bed5-1022c2bd15c4>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/54e2be5b-dd45-4d90-adeb-448da6f03e13>
  a skos:Concept;
  skos:prefLabel "berberishout"@nl;
  skos:scopeNote "Berberishout is een hardhoutsoort afkomstig van de Berberisplant, gekenmerkt door zijn fijne textuur en geelachtige kleur, vaak gebruikt in houtsnijwerk en fijne meubelstukken."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/0541529a-cde9-4e52-b66b-49c9786a436e>
  a skos:Concept;
  skos:prefLabel "beschilderd textiel"@nl;
  skos:scopeNote "Beschilderd textiel is textiel dat met de hand of door een mechanisch proces is beschilderd, gebruikt voor decoratieve doeleinden in kleding, wandkleden of gordijnen."@nl;
  skos:altLabel "geschilderd textiel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/86d3631a-1f3f-4b51-bbbb-dadebc310ecc>;
