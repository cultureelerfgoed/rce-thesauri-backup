<https://data.cultureelerfgoed.nl/term/id/cht/58882b6e-68be-455a-8bb9-9276ee9c1098>
  a skos:Concept;
  skos:prefLabel "tonmolens"@nl;
  skos:scopeNote "De tjaskers zijn tonmolens, ze hebben een wateropvoerwerktuig zoals ooit ontworpen is door Leonardo da Vinci. Het is een grote houten koker met daarin een tweetal schroefvormige elementen. (Molenwoordenboek G.J. Pouw)"@nl;
  skos:altLabel "schroef (molen)"@nl, "schroeven (molen)"@nl, "tonmolen"@nl;
