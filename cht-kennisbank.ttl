  a skos:Concept;
  skos:prefLabel "roffelschaven"@nl;
  skos:scopeNote "Schaven met een enkele beitel, die worden gebruikt voor het ruwe werk of voorschaven; zijn geschikt voor ruwer werk dan de voorlopers. (AAT)"@nl;
  skos:altLabel "roffelschaaf"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/16a2b01d-6b53-462f-9793-80ebb06a6f43>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ff1bf96f-08d5-4c32-86e6-3d1f171738d3>
  a skos:Concept;
  skos:prefLabel "dekspanen"@nl;
  skos:scopeNote "Bestaat uit een plankje van ca. 15 tot 20 cm breed, ca. 30 cm lang en ca. 3,5 cm dik met een schuin oplopende steel van ca. 1 m lengte. In het plankje zijn rijen gaten geboord met een centerboor van ca. 2 cm diameter, 1,5 tot 2 cm diep en 2,5 tot 3,5 cm hart-op-hart."@nl;
  skos:altLabel "dekspaan"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/07e84e29-a3ac-4ac3-a81b-a810b43bc421>
  a skos:Concept;
  skos:prefLabel "room"@nl;
  skos:scopeNote "De geelwitte laag die op melk drijft en circa 18 à 40 procent aan botervet bevat. (AAT)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fdd18b2a-f24a-4569-8373-e6d0cb63e805>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/a36ddb76-354a-4460-a8de-37e0ac253607>,
    <https://data.cultureelerfgoed.nl/term/id/cht/8021e1f6-b32c-4666-96ce-d1da6eb8928b>;
