<https://data.cultureelerfgoed.nl/term/id/cht/d38702a8-bd12-40f1-805b-5ed940bb03f8>
  a skos:Concept;
  skos:prefLabel "balies (toonbank)"@nl;
  skos:scopeNote "Soort toonbank, die in een kantoor (vooral bij banken) de voor de cliënten bestemde ruimte afscheidt van die van het personeel. (Haslinghuis)"@nl;
  skos:altLabel "balie (toonbank)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1c453774-e3f0-414e-a4c0-33cb3817656c>;
