<https://data.cultureelerfgoed.nl/term/id/cht/df6c5884-e1c6-4523-afac-77d2c6ce420e>
  a skos:Concept;
  skos:prefLabel "mantelzorg"@nl;
  skos:scopeNote "Mantelzorg is de zorg voor chronisch zieken, gehandicapten en hulpbehoevenden door naasten: familieleden, vrienden, kennissen en buren. Kenmerkend is de reeds bestaande persoonlijke band tussen de mantelzorger en zijn of haar naaste. Daarnaast gaat het om langdurige zorg die onbetaald is."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/45983d11-2b5e-4dbf-8d2a-1c37f6e2547a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/5458163e-3bd7-49f9-b1bd-4d51f41e24cb>
  a skos:Concept;
  skos:prefLabel "maatschappelijk werk"@nl;
  skos:scopeNote "Handelingen en maatregelen ten aanzien van hen die in moeilijke sociaal-economische omstandigheden verkeren; maatschappelijke hulpverlening."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/45983d11-2b5e-4dbf-8d2a-1c37f6e2547a>;
