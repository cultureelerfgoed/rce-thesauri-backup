<https://data.cultureelerfgoed.nl/term/id/cht/9bddfb1f-d4dc-4d09-9458-5fccd6cadb1d>
  a skos:Concept;
  skos:prefLabel "netgewelven"@nl;
  skos:scopeNote "Netgewelven zijn laatgotisch veeldelige gewelven waarvan de ribben mazen vormen als van een net. Zoals bij het stergewelf vervallen de kruisribben. Ook de hulpribben (tierceron) komen vrij en worden tot tussen- of koppelribben (lierne). Die worden van de ene rib naar de andere geslagen, al naar het decoratieve patroon het vergt. Omdat ook de gordelbogen vervallen, spint zich een continu net over de ruimte die mede daardoor haar laatgotische ruimtevorm krijgt. In Nederland komt het netgewelf voor sinds eind 15e eeuw. (Haslinghuis)"@nl;
  skos:altLabel "netgewelf"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/76cb2c1a-25f3-4f5f-8f58-6eeff4c69a45>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/98c88524-6eca-4946-9e89-7bebde7d5f7b>
  a skos:Concept;
  skos:prefLabel "binnensporen"@nl;
