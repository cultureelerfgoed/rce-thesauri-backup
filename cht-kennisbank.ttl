<https://data.cultureelerfgoed.nl/term/id/cht/9f1e8db3-0004-4ca1-924d-109cf52f4a02>
  a skos:Concept;
  skos:prefLabel "Amsterdamse boeiers"@nl;
  skos:scopeNote "Type Boeier. Nog niet voldoende bekend, maar vermoedelijk sterk gelijkend op de Zaanse boeier dan echter gladboordig gebouwd."@nl;
  skos:altLabel "Amsterdamse boeier"@nl;
