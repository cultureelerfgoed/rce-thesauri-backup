<https://data.cultureelerfgoed.nl/term/id/cht/e5bf910a-6164-428e-8627-7b01998a52af>
  a skos:Concept;
  skos:prefLabel "balsem"@nl;
  skos:scopeNote "Een plantaardige balsem is een natuurlijk mengsel van harsen en etherische oliën dat wordt afgescheiden door sommige bomen en struiken. Voorbeelden zijn: copaivabalsem en Venetiaanse terpentijn."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/014237aa-5381-4dbe-8818-8d15931b3a34>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/2cc373d9-8c90-447c-a389-72960dc3b4f1>,
