<https://data.cultureelerfgoed.nl/term/id/cht/5aeba8fa-4b5d-4e9b-918a-49d60f85bfe9>
  a skos:Concept;
  skos:prefLabel "moestuinoranjerieën"@nl;
  skos:scopeNote "Moestuinoranjerieën zijn oranjerieën waarbij het nuttige en het aangename efficiënt en praktisch werden verenigd. In tegenstelling tot een formele of landschappelijke-oranjerie worden de omliggende gronden ingericht voor de productie van voeding in plaatst van voor grandeur. Zo vindt men hier geen gazons of serpentine vijvers maar broeikassen, waterputten en moestuinen. (Oranjerieën in Nederland. Alphen aan de Rijn / Geytenbeek, E., 1991)"@nl;
  skos:altLabel "moestuinorangerie"@nl, "moestuinorangerieën"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/032771ea-179a-4938-b333-2dd3156a11a2>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fc28300a-fd30-47fe-b60e-2bcb0eb953ed>
  a skos:Concept;
  skos:prefLabel "balkrond"@nl;
  skos:scopeNote "Balkrond is een duveljager aan de onderzijde van een balk. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d4552b9f-db61-4164-8b4a-6c593022bddb>;
