<https://data.cultureelerfgoed.nl/term/id/cht/652a877d-d890-4df6-8247-fa73886a3a2a>
  a skos:Concept;
  skos:prefLabel "reddingschepen"@nl;
  skos:scopeNote "Klein schip – de bruto inhoud varieerde van 906 tot 2258 – dat tijdens WO-II achteraan in een konvooi voer en speciaal was bestemd voor het redden van opvarenden van tot zinken gebrachte of beschadigde schepen. (MARDOC)"@nl;
  skos:altLabel "reddingschip"@nl, "reddingsschepen"@nl, "reddingsschip"@nl;
