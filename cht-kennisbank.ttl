<https://data.cultureelerfgoed.nl/term/id/cht/72b37e2d-4842-4ef8-8ffc-241aa290104c>
  a skos:Concept;
  skos:prefLabel "kwelwater"@nl;
  skos:scopeNote "Kwelwater is water dat door de grondslag van een dijk dringt / sijpelt. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "drangwater"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0c41c9b8-fb66-48af-b44a-46dd24503c6c>;
