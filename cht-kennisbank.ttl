  a skos:Concept;
  skos:prefLabel "platvol voegen"@nl;
  skos:scopeNote "Platvol voegen is het volstrijken met nog natte mortel van voegen in metselwerk, zodat de voorkanten gelijk liggen met die van de stenen. (Haslinghuis)"@nl;
