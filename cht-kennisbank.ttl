<https://data.cultureelerfgoed.nl/term/id/cht/14184d8f-d7ee-49e8-94af-542a37095ba6>
  a skos:Concept;
  skos:prefLabel "gildezilveren"@nl;
  skos:scopeNote "Zilveren voorwerpen, die eigendom zijn of waren van een gilde."@nl;
  skos:altLabel "gildezilver"@nl;
