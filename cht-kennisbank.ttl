<https://data.cultureelerfgoed.nl/term/id/cht/babac037-e0e0-4138-9ca0-3ea236aacc09>
  a skos:Concept;
  skos:prefLabel "documentatie"@nl;
  skos:scopeNote "De documentatie van een voorwerp, een collectie, een gebouw of een locatie is de bewaard gebleven informatie die er verband mee houdt. De documentatie aangaande een voorwerp is de verzameling van alle relevante informatie over het voorwerp en de behandeling ervan. (Conservation Dictionary)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91712616-6dec-4871-8fdc-c317850c20d1>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/c7d5cabc-28d8-4bdd-b595-9039fe07a4ae>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

