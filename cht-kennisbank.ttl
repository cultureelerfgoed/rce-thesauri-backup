  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b6492d3f-0a51-4653-a5f9-23f8b744cb2d>
  a skos:Concept;
  skos:prefLabel "verstekhaken"@nl;
  skos:scopeNote "Het schuine blad maakt een hoek van 45° met het lange rechte gedeelte. Lijnen onder 45° en 135° kunnen hiermee worden afgeschreven en gecontroleerd."@nl,
    "Hierbij staat de dikke arm onder een hoek van 45° ten opzichte van de dunne arm. De schuine arm zit in het midden van net lange deel."@nl;
  skos:altLabel "verstekhaak"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/644d8db5-c8a7-45c5-bdc7-e92bdcb85203>;
