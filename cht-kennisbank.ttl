<https://data.cultureelerfgoed.nl/term/id/cht/d9a67076-bf41-4415-bb0b-0e5c5cd318ce>
  a skos:Concept;
  skos:prefLabel "chemisch element"@nl;
  skos:scopeNote "Een chemisch of scheikundig element is een stof die met scheikundige middelen en methoden niet in andere stoffen opgesplitst kan worden. Een element bestaat uit één soort atomen met alle hetzelfde atoomnummer, dus met hetzelfde aantal protonen in de kern. Het aantal neutronen in de atomen van een element kan variëren."@nl;
  skos:altLabel "chemische elementen"@nl, "element (scheikunde)"@nl, "natuurkundig element"@nl,
    "scheikundig element"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/960ba592-7383-41e4-a8fc-a6e6ea14000a>;
