<https://data.cultureelerfgoed.nl/term/id/cht/bef38eca-22f5-4326-b975-b6acecf7c22f>
  a skos:Concept;
  skos:prefLabel "textielmolens"@nl;
  skos:scopeNote "Textielmolens zijn industriemolens die werden gebruikt voor de productie van textiel. Deze molens waren uitgerust met machines voor het spinnen, weven of verven van textielvezels, zoals katoen, wol, of linnen. Textielmolens speelden een centrale rol in de textielindustrie, vooral tijdens de industriële revolutie, en waren vaak wind- of watergedreven. Deze molens waren essentieel voor de massaproductie van stoffen en droegen bij aan de economische groei in textielproducerende regio's."@nl;
  skos:altLabel "textielmolen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6654db8a-3424-4bf3-bfd8-0490ce52b8ae>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/18770281-8dec-48a4-a64d-df5204d61bcc>,
