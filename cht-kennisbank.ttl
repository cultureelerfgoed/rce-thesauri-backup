<https://data.cultureelerfgoed.nl/term/id/cht/e2d34718-d769-4211-b2ac-644fa26478aa>
  a skos:Concept;
  skos:prefLabel "kaneel"@nl;
  skos:scopeNote "Kaneel is een specerij gewonnen uit de schors van bomen uit het geslacht Cinnamomum, gebruikt voor zijn warme, zoete smaak in zoete en hartige gerechten."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1ebf8d48-7a3a-4341-aa53-fdcb0ed7bd1e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f0762a74-9535-4be2-a083-6d1113dd1587>
  a skos:Concept;
  skos:prefLabel "witbakkend steengoed"@nl;
  skos:scopeNote "Witbakkend steengoed is keramiek dat na het bakken een witte of lichte kleur heeft. Het wordt vaak gebruikt voor serviesgoed en tegels vanwege zijn duurzaamheid en waterdichtheid."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ff8bbfb6-c22e-49cf-af46-cc26f7a7523d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/dbca63f2-aae3-4b74-b722-033221a6eebb>
  a skos:Concept;
  skos:prefLabel "shag"@nl;
  skos:scopeNote "Shag is grof gesneden rooktabak, behorend tot tabak (materiaal), gebruikt voor het zelf rollen van sigaretten."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/90db1196-7e23-4190-a66d-75c17b14978b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/0a8ae763-ed42-4060-95c7-7935945950e5>
  a skos:Concept;
  skos:prefLabel "kokos"@nl;
  skos:scopeNote "Kokos is een vezel gewonnen uit de schil van kokosnoten, gebruikt in producten zoals tapijten en matten vanwege zijn duurzaamheid en waterbestendigheid."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/86d3631a-1f3f-4b51-bbbb-dadebc310ecc>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/042806da-391a-49ce-b3a2-acf8cd282f96>
  a skos:Concept;
  skos:prefLabel "markieslinnen"@nl;
  skos:scopeNote "Markieslinnen is een fijn geweven, glanzend linnen dat gebruikt wordt voor luxe kleding en interieurstoffen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/86d3631a-1f3f-4b51-bbbb-dadebc310ecc>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4bdfd799-5f6f-410b-8916-f42cce7768bf>
  a skos:Concept;
  skos:prefLabel "meubelstof"@nl;
  skos:scopeNote "Meubelstof is een textielsoort speciaal ontworpen voor het bekleden van meubels, bekend om zijn duurzaamheid en esthetische kwaliteiten."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/86d3631a-1f3f-4b51-bbbb-dadebc310ecc>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2a9b26db-dc1b-4087-bfbf-d5ff35690da1>
  a skos:Concept;
  skos:prefLabel "verguld zilver"@nl;
  skos:scopeNote "Verguld zilver is zilver dat is bedekt met een dunne laag goud, vaak toegepast in sieraden en decoratieve objecten om een luxe uitstraling te geven."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/edfb1e84-1d31-4e7e-9fa5-f4e6aa5a88fa>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/37d03460-0666-4f32-9fb4-da80fcbaa2b9>
  a skos:Concept;
  skos:prefLabel "rode Bremersteen"@nl;
  skos:scopeNote "Rode Bremersteen is een zandsteen afkomstig uit Bremen, Duitsland, bekend om zijn roodbruine kleur en veel gebruikt in historische gebouwen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/07067413-15a3-4210-a2ca-5fa80893357d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/af5c12bc-f33e-4f82-b28c-f96d67a9919e>
  a skos:Concept;
  skos:prefLabel "schapenwol"@nl;
  skos:scopeNote "Schapenwol is een type wol dat afkomstig is van schapen, veelgebruikt in textiel voor zijn isolerende en ademende eigenschappen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2c2cd90a-95eb-4754-9a14-84bc394aebdc>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/33734926-d5b9-403e-8608-4ed908a6a7c7>
  a skos:Concept;
  skos:prefLabel "walvistanden"@nl;
  skos:scopeNote "Walvistanden zijn een onderdeel van het walvisskelet, vaak gebruikt in kunstnijverheid, vooral in de productie van scrimshaw en andere decoratieve objecten."@nl;
  skos:altLabel "walvistand"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/30702c12-2708-4c27-80ab-cb1ce544a268>;
