<https://data.cultureelerfgoed.nl/term/id/cht/be9ffbd0-dd12-491e-b9a1-0d224a57a03d>
  a skos:Concept;
  skos:prefLabel "afwerkvloeren"@nl;
  skos:scopeNote "Afwerkvloeren vormen de bovenste laag van een vloer die direct wordt blootgesteld aan gebruik. Afwerkvloeren zijn in te delen in vloeren die in het werk worden gemaakt en afwerkvloeren die fabrieksmatig, vooraf, zijn gemaakt. (Bedrijfschap Afbouw)"@nl;
  skos:altLabel "afwerkvloer"@nl, "bovenvloer"@nl, "bovenvloeren"@nl, "gebruiksvloer"@nl,
