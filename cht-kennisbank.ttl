<https://data.cultureelerfgoed.nl/term/id/cht/40dbc15d-7235-423b-a9be-e2790fa0c8ec>
  a skos:Concept;
  skos:prefLabel "particuliere begraafplaatsen"@nl;
  skos:scopeNote "Particuliere begraafplaatsen zijn in principe alle begraafplaatsen die in handen zijn van een stichting, BV, NV of een andere organisatie met een rechtsvorm. Dergelijke begraafplaatsen worden bedrijfsmatig gerund en staan voor iedereen open. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "particuliere begraafplaats"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bb70464c-b05e-45f7-a5ef-bfb3c5dcdb8c>;
