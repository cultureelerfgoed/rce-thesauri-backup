<https://data.cultureelerfgoed.nl/term/id/cht/a0dbfc6a-64fc-40e0-b266-2b4775037cd8>
  a skos:Concept;
  skos:prefLabel "putboorders"@nl;
  skos:scopeNote "Putboorders zijn mensen die door middel van boren waterputten maken."@nl;
