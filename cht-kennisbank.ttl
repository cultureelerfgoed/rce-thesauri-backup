<https://data.cultureelerfgoed.nl/term/id/cht/a7a963a0-e6b7-46cf-a0ee-e17b5f9adc2c>
  a skos:Concept;
  skos:prefLabel "rechthuizen"@nl;
  skos:scopeNote "Rechthuizen zijn huizen waar een schepen- of ambachtsgerecht zetelde."@nl;
  skos:altLabel "rechthuis"@nl;
