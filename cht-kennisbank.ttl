<https://data.cultureelerfgoed.nl/term/id/cht/90b14c7c-09d8-464f-94c8-ec6b176bf146>
  a skos:Concept;
  skos:prefLabel "lunulahouders"@nl;
  skos:scopeNote "De Lunulahouder (maantje in het Latijn) is een ring- of maanvormige houder, meestal van verguld zilver of goud, waarin een geconsacreerde Hostie kan worden geklemd.(Wikipedia)"@nl;
  skos:altLabel "lunulahouder"@nl;
