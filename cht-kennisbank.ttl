<https://data.cultureelerfgoed.nl/term/id/cht/e57f5bf8-db16-473a-b08c-9baec7dfc341>
  a skos:Concept;
  skos:prefLabel "sluipwallen"@nl;
  skos:scopeNote "Smalle strook grond aan de voet van het buitentalud van een vestingwal, soms voorzien van een palissade of een doornenhaag; ook wel sluipwal. (Menno van Coehoorn)"@nl;
  skos:altLabel "berm (sluipwal)"@nl, "bermen (sluipwal)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/393c010b-a352-44b5-8e64-0338906a2da5>;
