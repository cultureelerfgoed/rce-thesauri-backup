<https://data.cultureelerfgoed.nl/term/id/cht/31c8b029-61c5-423a-b5ce-e901c267adbc>
  a skos:Concept;
  skos:prefLabel "grendels (schuif)"@nl;
  skos:scopeNote "Met dezelfde bestemming, ronde staaf of bout met handgreep of knop, uitschuifbaar en sluitend in een ring of rond gat. Naast ijzeren zijn ook houten schuifgrendels bekend. Een valgrendel is verticaal geplaatst aan de onderzijde van een deur. De grendel is soms met een slot verbonden, (Haslinghuis)"@nl;
  skos:altLabel "frumeel"@nl, "frumelen"@nl, "grendel (schuif)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d0ee59da-cb71-4409-ad4b-dabd1981eae8>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/2c5d97ac-2e58-4fab-a74a-035e0e80b64e>;
