<https://data.cultureelerfgoed.nl/term/id/cht/d61c655b-c50b-4e59-ba7d-b1ad417d5476>
  a skos:Concept;
  skos:prefLabel "mergel"@nl;
  skos:scopeNote "Mergel is een kleisoort die ijzeroxide bevat en een hoog gehalte aan calciumverbindingen. Mergelsoorten worden gebruikt als pottenbakkersklei voor laagbakkend aardewerk en voor bakstenen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b003b3b2-65d1-4aa7-bbe4-c035ae230c53>;
