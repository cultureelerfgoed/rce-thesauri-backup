<https://data.cultureelerfgoed.nl/term/id/cht/f852cab4-9ab5-42eb-90bf-018c4554d402>
  a skos:Concept;
  skos:prefLabel "Airey-woningen"@nl;
  skos:scopeNote "Airey-woningen is de naam van een type systeem- of montagebouw dat kort na de Tweede Wereldoorlog in Groot-Brittannië en Nederland op ruime schaal is toegepast. Deze geprefabriceerde woningen zijn genoemd naar de ontwerper, Sir Edwin Airey (1879-1955), ingenieur en directeur van W. Airey and Sons in Leeds. (Wikipedia)"@nl;
  skos:altLabel "Airey-woning"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/705f0a45-dba8-45ce-8937-0f9cb20c8be4>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/12bf2dc3-6a76-407a-a278-65ebe57b1274>
  a skos:Concept;
  skos:prefLabel "bakenmeesterswoningen"@nl;
  skos:scopeNote "Bakenmeesterwoningen zijn woningen voor bakenmeesters. Zij beheerden een deel van een rivier (een kwartier)."@nl;
  skos:altLabel "bakenmeesterswoning"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/68a2ee6d-9205-424e-9540-43d27b6a483f>;
