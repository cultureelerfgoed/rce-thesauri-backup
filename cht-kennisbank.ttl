  a skos:Concept;
  skos:prefLabel "pompdoeken"@nl;
  skos:scopeNote "Een pompdoek is een doek voor in de keuken, waar de kok de handen aan afdroogt, het aanrecht mee aanveegt of een pan mee aanpakt. De pompdoek wordt ook wel gebruikt om de vaat mee af te drogen, maar deze doek neemt iets minder goed vocht op dan een theedoek."@nl;
  skos:altLabel "pompdoek"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/60b07ea1-8374-4c21-897b-725c1abf219e>;
