<https://data.cultureelerfgoed.nl/term/id/cht/f4b99a00-8673-46f2-a26b-70ec8b5ec3f8>
  a skos:Concept;
  skos:prefLabel "vrije wildbanen"@nl;
  skos:scopeNote "Vrije wildbanen zijn wildbanen waar dieren in en uit kunnen. De dieren zitten dus niet gevangen binnen een raster. (Winkler Prins Encyclopaedie)"@nl;
