<https://data.cultureelerfgoed.nl/term/id/cht/844d1e5c-321e-4517-8beb-a7bcd8736546>
  a skos:Concept;
  skos:prefLabel "cavea's (theaterdeel)"@nl;
  skos:scopeNote "Ruimte voor de toeschouwers in een Romeins theater, meestal terrasvormig oplopend. (Haslinghuis)"@nl;
  skos:altLabel "cavea (theaterdeel)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b2331d07-8cfc-4ddb-ab21-ed760e7cbc9f>;
