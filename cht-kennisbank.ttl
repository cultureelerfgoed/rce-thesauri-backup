<https://data.cultureelerfgoed.nl/term/id/cht/12cb6104-9f8a-4e5a-a152-3923142bb7c1>
  a skos:Concept;
  skos:prefLabel "bundelpijlers"@nl;
  skos:scopeNote "Bundelpijlers zijn pijlers bestemd om bogen uit verschillende richtingen te ondervangen. Ze dragen veelal gordel- en scheibogen en gewelfribben. De pijlers bestaan uit een kern bezet met zuilen (in niet-klassieke zin), halfzuilen, colonetten of schalken. (Haslinghuis)"@nl;
  skos:altLabel "bundelpijler"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/40335253-e778-49c8-86c0-61f6d25d77c4>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4a9c8bb4-5bf0-4fcb-ba0b-1ff75c74b2ec>
  a skos:Concept;
  skos:prefLabel "vervuiling"@nl;
  skos:scopeNote "De invoering of aanwezigheid van schadelijke of andere ongewenste stoffen of producten in het milieu; gebruik 'milieuverontreinigende stoffen' voor de stoffen zelf. (AAT)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0e07bd39-012a-4958-90b8-ac9a877ea42e>;
