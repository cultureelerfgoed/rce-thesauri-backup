  a skos:Concept;
  skos:prefLabel "baanvakken"@nl;
  skos:scopeNote "Baanvakken zijn opeenvolgingen van aaneengesloten dienstregelpunten en vrije banen, beginnend en eindigend in een dienstregelpunt."@nl,
    "Een baanvak is een gedeelte spoor tussen twee (grotere) stations. Een baanvak kan bestaan uit een of meerdere sporen. De maximumsnelheid op een spoorlijn kan per baanvak verschillen, ieder baanvak kent zijn eigen baanvaksnelheid."@nl;
  skos:altLabel "baanvak"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ff0878fe-daaa-48c4-8117-39336ef9fa37>;
