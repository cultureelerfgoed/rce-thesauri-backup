<https://data.cultureelerfgoed.nl/term/id/cht/c61fdfcb-4010-4bb3-b596-69e4fcbf6581>
  a skos:Concept;
  skos:prefLabel "jukken (uitrusting)"@nl;
  skos:scopeNote "Werktuig, bestaande uit een houten blok met om de nek (open of sluitende) uithollingen om er ossen in te spannen of om er emmers of manden aan te dragen. (ABR)"@nl;
  skos:altLabel "juk (uitrusting)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
