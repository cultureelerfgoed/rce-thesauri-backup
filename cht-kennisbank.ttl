  a skos:Concept;
  skos:prefLabel "invoerrechten"@nl;
  skos:scopeNote "Douanerechten, bestaande uit uitvoer- en invoerrechten, zijn indirecte belastingen die geheven worden op goederen die in een land worden uitgevoerd, respectievelijk ingevoerd. In de belastingrechtswetenschap komen de begrippen invoer- en uitvoerrechten als zodanig niet meer voor. Tegenwoordig wordt daarvoor in de douanewetgeving de term douanerecht gebruikt."@nl;
  skos:altLabel "duanerechten"@nl, "invoerrecht"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9e422627-b366-4192-9001-7f7d2ac4e128>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/aef16e13-8448-4861-b66b-0cf28eb40b94>
  a skos:Concept;
  skos:prefLabel "vetkopers"@nl;
  skos:scopeNote "Vetkopers verhandelen dierlijke vetten of oliën, gebruikt voor voeding, zeep of kaarsen. Zij kopen bij slagers of boeren en verkopen aan handelaren of industrie."@nl;
  skos:altLabel "vetkoper"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db4a7619-d236-4b14-8e79-b4a6e890f677>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b0077226-dc14-454d-906f-126ece318548>
  a skos:Concept;
  skos:prefLabel "strandvonders"@nl;
  skos:scopeNote "Strandvonders zijn ambtenaren die toezicht houden op aangespoelde goederen. Zij registreren en beheren vondsten volgens strandvondersrecht."@nl;
  skos:altLabel "strandvonder"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ee07b8be-3558-4b7d-ab86-a45c3fbac0bd>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b8d9bafa-ce21-4b98-9f3c-088640131339>
  a skos:Concept;
  skos:prefLabel "schildwachten"@nl;
  skos:scopeNote "Schildwachten bewaken een locatie of persoon, vaak met ceremoniële rol. Ze staan op post bij paleizen, kazernes of herdenkingsplaatsen."@nl;
  skos:altLabel "schildwacht"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db4a7619-d236-4b14-8e79-b4a6e890f677>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/baf440ca-cfc1-4d1a-8ee7-327e0509f250>
  a skos:Concept;
  skos:prefLabel "schaatsenmakers"@nl;
  skos:scopeNote "Schaatsenmakers vervaardigen of repareren schaatsen, vaak ambachtelijk. Zij werken met hout, leer en metaal voor sport of vervoer op ijs."@nl;
  skos:altLabel "schaatsenmaker"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db4a7619-d236-4b14-8e79-b4a6e890f677>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/bcf4fa64-7ad9-488c-a2d6-91ee2004a14b>
  a skos:Concept;
  skos:prefLabel "vlaggenmakers"@nl;
  skos:scopeNote "Vlaggenmakers vervaardigen vlaggen van textiel. Ze snijden, naaien en bedrukken doek in kleuren en patronen volgens heraldiek of symboliek."@nl;
  skos:altLabel "vlaggenmaker"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db4a7619-d236-4b14-8e79-b4a6e890f677>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/bd433e71-a33c-40dd-ab4b-8fb849a0a9c3>
  a skos:Concept;
  skos:prefLabel "tukkers"@nl;
  skos:scopeNote "Tukkers zijn inwoners van Twente of mensen met een Twentse achtergrond. De term heeft een culturele en regionale betekenis."@nl;
  skos:altLabel "tukker"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db4a7619-d236-4b14-8e79-b4a6e890f677>;
