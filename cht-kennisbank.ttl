  a skos:Concept;
  skos:prefLabel "oliejassen"@nl;
  skos:scopeNote "Een oliejas is een in de scheepvaart gebruikte weerbestendige jas die vooral door vissers en zeevarenden wordt gedragen en die oorspronkelijk uit geoliede stof bestond."@nl;
  skos:altLabel "oliejas"@nl;
