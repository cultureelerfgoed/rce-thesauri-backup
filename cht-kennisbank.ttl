<https://data.cultureelerfgoed.nl/term/id/cht/cc5259e5-e924-4bf5-ae6f-1f539e369a62>
  a skos:Concept;
  skos:prefLabel "late middeleeuwen"@nl;
  skos:scopeNote "De term hoge middeleeuwen is afkomstig uit Groot-Brittannië (High Middle Ages). In Nederland is voor de periode VMED-LMEA de term volle middeleeuwen meer gangbaar. De periode tussen 900 en 1250, waarin de gezagsstructuren op een regionaal niveau vorm krijgen, er nieuw land ontgonnen wordt en een kerstening van het volk plaatsvindt. Het synoniem hoge middeleeuwen is afkomstig uit Groot-Brittannië (High Middle Ages). In Nederland is voor de periode VMED-LMEA de term volle middeleeuwen meer gangbaar."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/79e8193f-f84f-492d-8207-21411ce5e914>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/b8145565-bb26-4bd5-8826-f6210bb67533>,
    <https://data.cultureelerfgoed.nl/term/id/cht/dbec1809-0563-4971-bdd9-12961f83f9b5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c3d819c1-6705-4a9c-9527-d8b23d97e21b>
  a skos:Concept;
  skos:prefLabel "sierhagen"@nl;
  skos:scopeNote "Geschoren hagen gebruikt als sierrelict: randpalm, loofgang, prieel."@nl;
  skos:altLabel "sierhaag"@nl;
