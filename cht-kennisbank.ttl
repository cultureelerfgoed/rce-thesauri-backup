  skos:scopeNote "Gordeldekzandruggen zijn dekzandruggen die langs de rand van een hoger gelegen gebied zijn opgewaaid. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "gordeldekzandrug"@nl;
