<https://data.cultureelerfgoed.nl/term/id/cht/e1008e26-cacd-4bc2-b3b2-cca64282e734>
  a skos:Concept;
  skos:prefLabel "Emy spanten"@nl;
  skos:scopeNote "Gebogen kapspant, opgebouwd uit houten delen, liggend op elkaar gestapeld en met beugels en bouten in de kromming geklemd. Ontwikkeld c. 1825 door de Franse genieofficier E.R. Emy. In Nederland is een variant toegepast, bestaande uit twee van onderen ingezaagde en gebogen balken. Er zijn overspanningen tot 40 m verwezenlijkt. (Haslinghuis)"@nl;
  skos:altLabel "Emy spant"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c4da8b07-9847-4269-86a6-8da0ab1923f5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d7019133-394d-4105-8099-88149ef7651b>
  a skos:Concept;
  skos:prefLabel "ribben (staartversterking)"@nl;
  skos:scopeNote "Versterking van de staart van een gietijzeren as; meestal vier stuks en soms verzwaard. (Molenwoordenboek B.D. Poppen)"@nl;
  skos:altLabel "rib (staartversterking)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4e481c81-319a-44da-86bf-106f145d22c1>;
