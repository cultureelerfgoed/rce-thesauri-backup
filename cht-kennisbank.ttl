<https://data.cultureelerfgoed.nl/term/id/cht/67cb2d16-3cd1-4816-825c-97040c3a97f8>
  a skos:Concept;
  skos:prefLabel "aanlopen (blokje)"@nl;
  skos:scopeNote "Houten of ijzeren blokje dat op de zijkant van een bossing- of een sponningschaaf is aangebracht om door het hoger of lager plaatsen van dit blokje, de schaaf op een willekeurige diepte te laten uitlopen. (Haslinghuis)"@nl;
  skos:altLabel "aanloop (blokje)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
