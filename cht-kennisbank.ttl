<https://data.cultureelerfgoed.nl/term/id/cht/56d75d76-0e9d-49b3-8132-5941ee8ec713>
  a skos:Concept;
  skos:prefLabel "daglicht gelatine zilverdruk papier"@nl;
  skos:scopeNote "Zilvergelatine P.O.P. is een daglicht-gelatine-zilverdruk (DGZ) papier."@nl;
