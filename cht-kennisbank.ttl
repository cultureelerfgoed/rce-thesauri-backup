<https://data.cultureelerfgoed.nl/term/id/cht/6d888bb5-56e6-4934-9d06-1041df0f1620>
  a skos:Concept;
  skos:prefLabel "tussenvernis"@nl;
  skos:scopeNote "Een tussenvernis is een sterk verdunde vernis die op het verfoppervlak wordt aangebracht vóór het inschilderen, om de originele verf beter te kunnen zien."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6340ddd5-1366-423b-a501-88cfc45f8746>;
