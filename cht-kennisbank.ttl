<https://data.cultureelerfgoed.nl/term/id/cht/a60cf26f-b41f-4430-a327-24f14f4e2c37>
  a skos:Concept;
  skos:prefLabel "keukenartikelen"@nl;
  skos:scopeNote "Keukenartikelen zijn alle voorwerpen, die gebruikt worden in de keuken. Daarbij te denken aan pannen, meubilair, bestek, fornuis, snijplanken, ovenschalen enz."@nl;
