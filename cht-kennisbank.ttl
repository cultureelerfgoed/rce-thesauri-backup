  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/584a490f-d21b-4381-9b8e-e155eabdf1e4>
  a skos:Concept;
  skos:prefLabel "thermen"@nl;
  skos:scopeNote "Thermen is de naam voor een grote badinrichting in de Romeinse wereld. (Wikipedia)"@nl;
  skos:altLabel "thermae"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e2d10203-8bb6-4f8a-a31b-ee337ce10fe3>;
