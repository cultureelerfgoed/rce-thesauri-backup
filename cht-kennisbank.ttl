  a skos:Concept;
  skos:prefLabel "schutterijen"@nl;
  skos:scopeNote "Schutterijen zijn gewapende groepen die in de middeleeuwen tot taak hadden de stad te verdedigen en de burgers te beschermen. (De schutterij te Haarlem / C. van de Haar, 1974)"@nl;
