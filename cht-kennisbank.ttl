<https://data.cultureelerfgoed.nl/term/id/cht/6fd115f0-6785-4fa4-9346-312366aaf03e>
  a skos:Concept;
  skos:prefLabel "verde tinos"@nl;
  skos:scopeNote "verde Tinos: ophicalciet (serpentijmarmer) welke gewonnen wordt op Tinos, Griekenland. De steen heeft een donkergroene ondergrond met veel witte kristalkleurige ragfijne tot grove aders. In de kleur komt enige variatie voor."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6eb18b91-b3b4-40e1-bff5-059cd50cffe6>;
