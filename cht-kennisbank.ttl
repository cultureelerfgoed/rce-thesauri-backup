  a skos:Concept;
  skos:prefLabel "degaussen"@nl;
  skos:scopeNote "Degaussen is het geheel wissen van magnetische banden met gebruikmaking van een bulk-wisapparaat. De machine produceert een sterker magnetisch veld dan de coërcitiefkracht van het te wissen materiaal. Na degaussen kan het materiaal opnieuw gebruikt worden."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
