  a skos:Concept;
  skos:prefLabel "Spaanse hondshaaien"@nl;
  skos:scopeNote "De spaanse hondshaai (Galeus melastomus) is een kathaai die voorkomt in het noordoosten van de Atlantische Oceaan op diepten tot 1900 m. De soort kan een lengte bereiken van 90 cm. (Wikipedia)"@nl;
  skos:altLabel "Pristiurus souverbiei"@nl, "Pristiurus melastomus"@nl, "Pristiurus melanostomus"@nl,
