  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/41bca79d-4bcf-4af6-8229-3e12b29f6faa>
  a skos:Concept;
  skos:prefLabel "luchtkalk"@nl;
  skos:scopeNote "Luchtkalk is een bindmiddel dat in natte toestand verhardt door te reageren met CO2 uit de lucht. Luchtkalk kan dus niet onder water verharden en is niet geschikt voor toepassing in funderingen, waterwerken, etcetera zonder toevoeging van hydraulische toeslagstoffen (zie puzzolaancementen) zoals tras of baksteengruis. De grondstof voor luchtkalk is zuivere kalksteen of zeeschelpen (hoewel schelpkalk door lichte vervuiling eerder als licht-hydraulisch wordt aangeduid) die bij c. 1000 °C gebrand wordt. Na het branden moet de kalk geblust worden. Luchtkalk heeft een beperkte sterkteontwikkeling en is relatief elastisch."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2f06513a-a4dd-4001-9a7b-efea781fab2c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/9fc03a64-5ee3-40ef-b976-cadf493b59b8>
  a skos:Concept;
  skos:prefLabel "Franse kalk"@nl;
  skos:scopeNote "Hoogwaardige massieve talk die voorkomt in de Appalachen in de Verenigde Staten. Het kan in een vorm worden gesneden en wordt gebruikt om te merken. Het is meestal wit van kleur, maar kan ook grijze of gele onzuiverheden bevatten. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2f06513a-a4dd-4001-9a7b-efea781fab2c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b698130f-af6c-480a-9a4c-bb19eda31c5d>
  a skos:Concept;
  skos:prefLabel "traskalk"@nl;
  skos:scopeNote "Fijngemalen mengsel van tufsteen ( tras) en kalk, gebruikt als bindmiddel en toeslag in metselmortels. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2f06513a-a4dd-4001-9a7b-efea781fab2c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c7c8b644-cbcc-45f2-8d86-2541117f8849>
  a skos:Concept;
  skos:prefLabel "stuifkalk"@nl;
  skos:scopeNote "Fijn gezeefde droge poederkalk, kalk. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2f06513a-a4dd-4001-9a7b-efea781fab2c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/cd08c755-daa9-408b-97a2-85e7e4e8ef57>
  a skos:Concept;
  skos:prefLabel "hydraulische kalk"@nl;
  skos:scopeNote "Hydraulische kalk is een bindmiddel van gebrande en gebluste kalk dat door toevoeging van puzzolane stoffen als tras of door de aanwezigheid van klei of leem in de grondstof (bijvoorbeeld mergel) verhardt door reactie met water (H2O). Schelpkalk dat uit zee wordt gevist is tevens vervuild met kleine hoeveelheden zand en klei, en wordt als licht-hydraulisch gezien. In tegenstelling tot luchtkalkcement voltrekt verharding zich dus ook onder water. Naast dat het uithardt onder water, verhardt het ook sneller dan luchtkalk, is sterker dan luchtkalk en is het waterdicht.(Michiel van Hunen et al. Historisch metselwerk. Instandhouding, herstel en conservering. RCE)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2f06513a-a4dd-4001-9a7b-efea781fab2c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d28ed9ff-d0cc-419c-a360-662dc0c3d437>
  a skos:Concept;
  skos:prefLabel "Luikse kalk"@nl;
  skos:scopeNote "Steen kalk, in de omgeving van Luik gebrand. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2f06513a-a4dd-4001-9a7b-efea781fab2c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2f08b584-69a6-415c-b8b8-e1f62ffd12c6>
  a skos:Concept;
  skos:prefLabel "kettingbogen"@nl;
  skos:scopeNote "Kettingbogen zijn bogen die het omgekeerde beloop hebben van een ketting die aan twee even hoge punten is opgehangen. Dit type boog vond reeds toepassing bij de Sassaniden in Perzië in het paleis van Khusro II (590-628) te Ctesiphon.Daarom wordt ook van de Sassanidische boog gesproken. (Haslinghuis)"@nl;
  skos:altLabel "Sassanidische bogen"@nl, "Sassanidische boog"@nl, "kettingboog"@nl,
    "kettinglijnbogen"@nl, "kettinglijnboog"@nl;
