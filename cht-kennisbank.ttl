<https://data.cultureelerfgoed.nl/term/id/cht/2499f113-bceb-4c30-9811-47dc973a0430>
  a skos:Concept;
  skos:prefLabel "sikkels"@nl;
  skos:scopeNote "Werktuig met halvemaanvormig, van fijne tandjes voorzien lemmer en korte steel, waarmee men riet, paardenbonen enz. snijdt. (ABR)"@nl;
