<https://data.cultureelerfgoed.nl/term/id/cht/d4a21572-ea20-4299-80e7-32e542b8f218>
  a skos:Concept;
  skos:prefLabel "maisonettes"@nl;
  skos:scopeNote "Maisonettes zijn galerijwoning bestaande uit twee bouwlagen, waarbij woon- en slaapverdieping gescheiden zijn. De galerijen zijn doorgaans om de andere laag gesitueerd. Soms zijn de slaapkamerlagen afwisselend boven en onder de woonlagen gelegd. In dat geval zijn twee galerijen aangebracht met een tussenruimte van twee bouwlagen zonder galerij."@nl;
  skos:altLabel "maisonette"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dfe2fa22-0cbc-485a-a165-39955cfa61eb>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e677b0f0-93f2-4992-9c9c-c4f659614feb>
