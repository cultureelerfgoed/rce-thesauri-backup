<https://data.cultureelerfgoed.nl/term/id/cht/e4343f76-28b8-463e-8024-480b855aa0bb>
  a skos:Concept;
  skos:prefLabel "aanzetgroeven"@nl;
  skos:scopeNote "Verticale groef op de ronde sluitzijde van een stolpraam of -deur die dient om de overgang van binnen- en buitenschilderwerk te markeren. (Haslinghuis)"@nl;
