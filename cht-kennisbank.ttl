<https://data.cultureelerfgoed.nl/term/id/cht/7b1458ed-6820-4cd5-885a-1894b3c4c664>
  a skos:Concept;
  skos:prefLabel "handmerken"@nl;
  skos:scopeNote "Een handmerk was een persoonsgebonden merkteken dat door analfabeten in de middeleeuwen werd gebruikt om akten te 'ondertekenen'. (Wikipedia)"@nl;
  skos:altLabel "handmerk"@nl;
