<https://data.cultureelerfgoed.nl/term/id/cht/eaa87542-0e78-427b-9e72-cb4e357c075c>
  a skos:Concept;
  skos:prefLabel "priorijen"@nl;
  skos:scopeNote "Priorijen zijn kloosters waar een prior of priores met het dagelijks bestuur belast is, maar dat afhankelijk is van een abdij. (Haslinghuis)"@nl;
