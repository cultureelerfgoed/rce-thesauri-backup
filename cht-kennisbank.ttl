  a skos:Concept;
  skos:prefLabel "cichorei"@nl;
  skos:scopeNote "Cichorei is een plant waarvan de wortel wordt gedroogd en gemalen, vaak gebruikt als koffiesurrogaat of in de voedingsindustrie als vezelrijk ingrediënt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/231e97d9-93a7-470c-9213-80e2ff05de5f>;
