<https://data.cultureelerfgoed.nl/term/id/cht/396e9202-5c81-4e77-8004-3a7855de16a0>
  a skos:Concept;
  skos:prefLabel "hoedenwinkels"@nl;
  skos:scopeNote "Hoedenwinkels zijn winkels waar hoeden, hoofddeksels, worden verkocht. Vroeger droeg bijna iedereen hoeden. Welgestelde mensen vanwege de deftige uitstraling, minder welgestelde mensen tegen de kou. Hoeden werden met de hand gemaakt. Veel hoedenmakers, en –winkels, zijn verdwenen omdat hoeden tegenwoordig minder gedragen worden. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "hoedenwinkel"@nl, "hoedenzaak"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/10f47eb6-f1a9-465f-b8ab-8381925f039b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/923eb5f2-d03a-4e11-a49b-54f8a1974433>
  a skos:Concept;
