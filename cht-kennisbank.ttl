<https://data.cultureelerfgoed.nl/term/id/cht/6e12b278-adf3-4cf2-952f-e28069e437c6>
  a skos:Concept;
  skos:prefLabel "fabriekshallen"@nl;
  skos:scopeNote "Fabriekshallen zijn grote, open ruimtes binnen fabrieksgebouwen waar industriële productie plaatsvindt. Ze zijn ontworpen om zware machines en grote aantallen werknemers te huisvesten."@nl;
  skos:altLabel "fabriekshal"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/83883001-9943-4726-9ddd-3fd73c7b9c46>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/0913cde6-7c39-4b4e-8a33-5482cd60fe3a>
  a skos:Concept;
  skos:prefLabel "gootklossen"@nl;
  skos:scopeNote "Horizontale klos onder een goot, in de muur ingemetseld. Meestal geprofileerd of, zoals b.v. in Middelburg c. 1600, aan de voorzijde van houtsnijwerk voorzien. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a28cd055-1cd1-461f-bd9d-c4d301454206>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/5c51c121-fc97-489c-a4d1-239254b94270>
  a skos:Concept;
  skos:prefLabel "balusters"@nl;
  skos:scopeNote "Korte, verticale onderdelen die gebruikt worden om een trapleuning of muurkap te ondersteunen, vaak rond in dwarsdoorsnede en met een vaasvormig silhouet. Wordt ook gebruikt in meubilair, bijvoorbeeld in rugleuningen van stoelen. (AAT-Ned)"@nl;
  skos:altLabel "baluster"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4e481c81-319a-44da-86bf-106f145d22c1>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/20cf473a-5f51-4190-a3c5-6b6fb3021af0>,
    <https://data.cultureelerfgoed.nl/term/id/cht/89b28aa0-e92e-4abc-9615-8526388d7d32>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3f8f1051-f3f3-4bc9-94ac-5ee90722018d>
  a skos:Concept;
  skos:prefLabel "absorptiespectrum"@nl;
  skos:scopeNote "Het absorptiespectrum van een materiaal geeft de absorptie van golven, als functie van de frequentie. Typisch wordt het begrip gebruikt in de context van elektromagnetische golven, zoals licht."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/0951f353-9211-42f1-81d7-344cd6a33c05>
  a skos:Concept;
  skos:prefLabel "dolfinaria"@nl;
  skos:scopeNote "Een dolfinarium is een bassin voor het houden van dolfijnen. Soms worden deze zeezoogdieren gehouden in combinatie met andere dieren zoals zeeleeuwen, zeehonden, orka's en pinguïns. (Wikipedia)"@nl;
  skos:altLabel "dolfinarium"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a94cf256-3fef-4d45-b737-adc6c7083017>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e03f8051-8f53-435f-b08a-93b91b935e8d>
  a skos:Concept;
  skos:prefLabel "mijnwerkerswoningen"@nl;
  skos:scopeNote "Mijnwerkerswoningen zijn woningen voor mijnwerkers. Een groot aantal mijnwerkerswoningen vormt een mijnwerkerskolonie. Tussen 1900 en 1940 werden een aantal mijnwerkerskolonies gebouwd in Limburg. Oorspronkelijk lagen ze vaak afgelegen van de bestaande woonkernen. Om die reden waren deze kolonies voorzien van een aantal basisvoorzieningen. Inmiddels maken deze kolonies deel uit de naastgelegen grotere woonkern."@nl;
  skos:altLabel "mijnwerkerswoning"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a50c8c86-1884-468a-87aa-820867848c20>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/5557d5d3-2335-4d3d-9a5c-3ce9b8c66e23>
  a skos:Concept;
  skos:prefLabel "keienvloeren"@nl;
  skos:scopeNote "Keienvloeren zijn grindlagen die bij winderosie kunnen ontstaan wanneer lichter materiaal door de wind wordt afgevoerd. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "keienvloer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2971af0-cde7-4888-b828-33443f702e7d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/07f4a8b4-b626-42d6-b534-0aabf2e8d7ac>
  a skos:Concept;
  skos:prefLabel "Gelders-Overijsselse gevels"@nl;
  skos:scopeNote "Topgevel met in- en uitgezwenkte lijnen en overhoekse pilasters, meestal in baksteen uitgevoerd. Toegepast in de streek van de Gelderse IJssel en in Duitsland in het gebied van de Nederrijn. Ontwikkeling uit gotische gevel. (Haslinghuis)"@nl;
  skos:altLabel "Gelders-Overijsselse gevel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/075a35fd-b879-45b4-9f97-b8c1f38bcbca>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/5dbefb74-cdf8-4c22-925b-088a74df6ff4>
  a skos:Concept;
  skos:prefLabel "kopmessen"@nl;
  skos:scopeNote "(houtzaagmolen) getand mes in achterhoofd van de slede waartegen het te stulpen hout drukte."@nl;
  skos:altLabel "kopmes"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/04770e4f-1c11-40e7-a256-9de8c6d569c6>;
