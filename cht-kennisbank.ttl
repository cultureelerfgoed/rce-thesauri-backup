<https://data.cultureelerfgoed.nl/term/id/cht/9170f8de-6b36-4aa9-9078-4bb25857b4bf>
  a skos:Concept;
  skos:prefLabel "worm en pennen"@nl;
  skos:scopeNote "Stuurhuis waarin de draaiende beweging van het stuurwiel naar de wielen wordt overgebracht door een worm waarin een conische pen aangrijpt."@nl;
  skos:altLabel "worm en pen"@nl;
