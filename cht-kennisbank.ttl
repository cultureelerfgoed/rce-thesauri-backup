  a skos:Concept;
  skos:prefLabel "centen"@nl;
  skos:scopeNote "Centen zijn munteenheden van lage waarde, vaak gebruikt in de 19e en 20e eeuw."@nl;
  skos:altLabel "cent"@nl;
