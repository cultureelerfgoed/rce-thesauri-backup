  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/de1ca69a-0763-4294-830f-51d2ba8e5d17>
  a skos:Concept;
  skos:prefLabel "vissteigers"@nl;
  skos:scopeNote "Vissteigers zijn aan de waterrand aangebrachte steigers om het laden en lossen en het aan en van boord gaan te vergemakkelijken. Kleine eenvoudige steigers zijn vaak van hout. (Wikipedia)"@nl;
  skos:altLabel "vissteiger"@nl;
