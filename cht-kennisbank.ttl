<https://data.cultureelerfgoed.nl/term/id/cht/ba6808e1-a668-4192-a9e0-103a0b9a9e2c>
  a skos:Concept;
  skos:prefLabel "casementen"@nl;
  skos:scopeNote "Casementen zijn raamopeningen of vensters die scharnierend zijn en naar binnen of buiten kunnen openen. Ze zijn een belangrijk element in de studie van historische bouwtechnieken."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f6b4e26a-f95c-4539-8039-9ad242401217>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/48993076-b398-4857-af2d-30d4dd07a3e9>
  a skos:Concept;
  skos:prefLabel "casetten (schilderij onderdeel)"@nl;
  skos:scopeNote "Casetten zijn verdiepte panelen in een plafond of schilderijlijst, vaak rijkelijk versierd, en worden gebruikt om een gevoel van diepte en decoratie aan een interieur te geven."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f6b4e26a-f95c-4539-8039-9ad242401217>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

