<https://data.cultureelerfgoed.nl/term/id/cht/5a776d34-b830-481b-bcb0-b254d033c816>
  a skos:Concept;
  skos:prefLabel "gedenktafels"@nl;
  skos:scopeNote "Gedenktafels zijn oorspronkelijk beschilderde tafels of schilderijen, door iemand als blijk van dankbaarheid aan de goden en ter gedachtenis van zijn redding in een tempel opgehangen. (Van Dale)"@nl;
  skos:altLabel "gedenktafel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/abfc1bb7-04d7-43a0-9e99-dd4c5a4f2c15>;
