<https://data.cultureelerfgoed.nl/term/id/cht/a2f74e31-902c-4fd2-9677-bf5fd7a56e1e>
  a skos:Concept;
  skos:prefLabel "raapspanen"@nl;
  skos:scopeNote "Loopt naar voren enigszins toe en kan afgeronde hoeken hebben."@nl,
    "Een raapspaan is plat gereedschap met een handgreep waarmee een muur waarop kalkmortel is aangebracht wordt gladgestreken. De raapspaan loopt naar voren enigszins toe en kan afgeronde hoeken hebben."@nl;
  skos:altLabel "raapspaan"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
