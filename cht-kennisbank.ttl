<https://data.cultureelerfgoed.nl/term/id/cht/bc6c1189-faff-46f5-a341-397b67b6ea7e>
  a skos:Concept;
  skos:prefLabel "vouwstoelen"@nl;
  skos:scopeNote "Een vouwstoel is een makkelijk opvouwbare stoel, op reis, bij het kamperen (bijvoorbeeld op een camping), op het strand of bij muziekfestivals) of om ruimte te besparen in huis of in de tuin. (Wikipedia)"@nl;
  skos:altLabel "campingstoel"@nl, "campingstoelen"@nl, "klapstoel"@nl, "klapstoelen"@nl,
    "vouwstoel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b98c63d8-63af-438b-8273-a27ced25b63d>;
