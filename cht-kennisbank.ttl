<https://data.cultureelerfgoed.nl/term/id/cht/ffd34813-65c8-44e1-a4d3-3bd1c8b70321>
  a skos:Concept;
  skos:prefLabel "midden Romeinse tijd B"@nl;
  skos:scopeNote "De dateringsrange is gebaseerd op de Romeinse aardewerktypologie uit de jaren ’90. Voor de typologie is met name gebruik gemaakt van aardewerk afkomstig uit goed-gedateerde en goed-opgegraven vondstcontexten zoals Nijmegen, Vechten en Velsen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/917a0abf-d501-4bc0-afa5-e279795cede1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/563680ac-e42f-4e28-a98c-0715a16ed90b>
  a skos:Concept;
  skos:prefLabel "poelgebieden"@nl;
  skos:scopeNote "Poelgebieden zijn, in het Oudland en Middelland van Zuidwest-Nederland voorkomende vlakke, relatief laaggelegen gebieden tussen de kreekruggen; ze bestaan uitzware (kleiige) sedimenten. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "poelgebied"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2971af0-cde7-4888-b828-33443f702e7d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/464c0a81-23fd-4daf-8b74-3934b960ba3d>
  a skos:Concept;
  skos:prefLabel "boezemmolens"@nl;
  skos:scopeNote "Molen die speciaal bedoeld is om het polderwater uit te slaan naar de boezem, soms wel strijkmolen genoemd. (Molenwoordenboek G.J. Pouw)"@nl;
  skos:altLabel "boezemmolen"@nl, "strijkmolen"@nl, "strijkmolens"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0198a25a-3469-469e-8103-a613e32fcdc6>;
