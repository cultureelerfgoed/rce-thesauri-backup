  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/19994d9f-823b-42d9-bd9e-34b4ed19530c>
  a skos:Concept;
  skos:prefLabel "waskommen"@nl;
  skos:scopeNote "In volmolens, kommen waarin het laken voor de tweede maal werd gevold, onder toevoeging van water, waardoor het bij de eerste bewerking toegevoegde vuil wegspoelde."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/04770e4f-1c11-40e7-a256-9de8c6d569c6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/1d994998-2310-48d5-b763-1a26411bfdb5>
  a skos:Concept;
  skos:prefLabel "chapelles ardentes"@nl;
  skos:scopeNote "Chapelles Ardentes zijn ruimtes of kamers waarin het lichaam van een vorstelijke of ander belangrijk persoon wordt opgebaard."@nl,
    """Chapelles Ardentes zijn ruimtes of kamers waarin het lichaam van een vorstelijke of ander belangrijk persoon wordt opgebaard.
"""@nl;
  skos:altLabel "chapelle ardente"@nl;
