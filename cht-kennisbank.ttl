<https://data.cultureelerfgoed.nl/term/id/cht/56b24c9d-c80b-4891-a3fa-8ac08f979fe5>
  a skos:Concept;
  skos:prefLabel "borstwerken"@nl;
  skos:scopeNote "Het Borstwerk is een zelfstandig gedeelte van het orgel dat voorzien is van een eigen speel- en registermechaniek en bijbehorend klavier, gepositioneerd in de onderkas van het orgel ter hoogte van de klaviatuur, op borsthoogte van de organist. Vandaar de naam Borstwerk. Dit gedeelte van het orgel is aan de voorzijde veelal voorzien van afsluitbare deurtjes of snijwerk. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "borstwerk"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cf51f60b-c1bb-4c17-b938-17e1dacb6e7c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/56ca8f6f-3ae1-4722-9a38-cc95a72d4a9a>
  a skos:Concept;
  skos:prefLabel "massicot"@nl;
  skos:scopeNote "Massicot is het minerale gele loodoxide (PbO)."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
