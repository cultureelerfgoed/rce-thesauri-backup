<https://data.cultureelerfgoed.nl/term/id/cht/da227f1b-a07a-497e-be1e-86e9591e496a>
  a skos:Concept;
  skos:prefLabel "vruchtensalades"@nl;
  skos:scopeNote "Vruchtensalades zijn gerechten bestaande uit een mengsel van verschillende soorten vers of bewerkt fruit. Ze vallen onder de bredere categorie voedsel en worden vaak geserveerd als gezond bijgerecht, dessert of tussendoortje, vaak met toevoeging van een dressing of siroop."@nl;
  skos:altLabel "vruchtensalade"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/231e97d9-93a7-470c-9213-80e2ff05de5f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/68da7586-94e4-42e4-851f-76db79e0f6bc>
  a skos:Concept;
  skos:prefLabel "isolatieglas"@nl;
  skos:scopeNote "Isolatieglas, ook wel dubbel glas genoemd, bestaat uit twee of meer lagen vlakglas met een luchtdichte spouw ertussen. Het valt onder de bredere categorie vlakglas en wordt gebruikt om thermische en akoestische isolatie te verbeteren in ramen en gevels."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/963156e3-7f49-4073-ab86-cea592518c26>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/b005116d-3422-4b61-9f51-e980eb927942>,
    <https://data.cultureelerfgoed.nl/term/id/cht/86ded397-b689-456b-8f17-251751b57e2b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6bb16b11-6780-4907-9bba-c7d189cd75d7>
  a skos:Concept;
  skos:prefLabel "plaatijzer"@nl;
  skos:scopeNote "Plaatijzer is een plat gewalste ijzeren plaat die onder de bredere categorie ijzer valt. Het wordt veelvuldig gebruikt in de constructie en industrie voor de fabricage van uiteenlopende producten zoals voertuigen, machines en bouwelementen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cc981024-18ee-4175-9310-1240671abd9f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/71d4bca2-5e6b-4274-a499-b049b83ab052>
  a skos:Concept;
  skos:prefLabel "houtimitatie"@nl;
  skos:scopeNote "Houtimitatie is een materiaal dat bedoeld is om de uitstraling en textuur van echt hout na te bootsen. Dit imitatiemateriaal wordt gebruikt als goedkoper of duurzamer alternatief voor echt hout in meubels, vloeren, en decoratieve toepassingen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/8144da6b-aa29-4c48-88a7-07e150647367>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/ba8e4eff-0233-4f93-bd06-d69aeb887171>,
    <https://data.cultureelerfgoed.nl/term/id/cht/05d27361-0327-4d0f-982f-1152bdfb0832>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/05d27361-0327-4d0f-982f-1152bdfb0832>
  a skos:Concept;
  skos:prefLabel "ebbenhoutimitatie"@nl;
  skos:scopeNote "Een ebbenhoutimitatie wordt gemaakt door schilderen of aankleuren gevolgd door polijsten om ebbenhout na te bootsen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/71d4bca2-5e6b-4274-a499-b049b83ab052>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d598105d-f8ac-4c5c-9e8b-8ade830bc107>
  a skos:Concept;
  skos:prefLabel "schrijfinkten"@nl;
  skos:scopeNote "Schrijfinkten vallen onder de bredere categorie inkt en worden specifiek gebruikt voor handschriften en printen. Ze bestaan meestal uit kleurstoffen of pigmenten opgelost in een vloeistof, die snel droogt en permanent op papier of andere oppervlakken blijft."@nl;
  skos:altLabel "schrijfinkt"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c4b6fd34-b141-4107-b149-d504a6dda8a9>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b005116d-3422-4b61-9f51-e980eb927942>
  a skos:Concept;
  skos:prefLabel "triple glas"@nl;
  skos:scopeNote "Triple glas, dat onder de categorie isolatieglas valt, bestaat uit drie lagen glas met twee luchtdichte spouwen ertussen. Het biedt superieure thermische en akoestische isolatie, waardoor het ideaal is voor energie-efficiënte gebouwen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/68da7586-94e4-42e4-851f-76db79e0f6bc>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8d2677ff-7c7e-40d5-b5a2-efdc37826ed3>
  a skos:Concept;
  skos:prefLabel "museumkarton"@nl;
  skos:scopeNote "Museumkarton is een hoogwaardig, zuurvrij karton dat onder de bredere categorie karton (cardboard) valt. Het wordt gebruikt voor conservering, inlijsting, en opslag van kunstwerken en documenten vanwege zijn duurzaamheid en beschermende eigenschappen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ce064fb4-b41c-44b2-9dc7-a29d53ac4043>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/00f287cf-cfea-4351-b246-3f8dd2b9aa77>
  a skos:Concept;
  skos:prefLabel "pvc platen"@nl;
  skos:scopeNote "PVC platen zijn platte vellen van polyvinylchloride (PVC), een veelgebruikte kunststof die onder de bredere categorie kunststofplaten valt. Ze worden gebruikt in de bouw, reclame en industrie vanwege hun duurzaamheid, weerbestendigheid en eenvoudige bewerkbaarheid."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cd793303-5575-48db-a1c1-8befcb9089c4>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/217a160f-1294-45db-b889-a51020bd2be9>
  a skos:Concept;
  skos:prefLabel "plantaardige lijmen"@nl;
  skos:scopeNote "Plantaardige lijmen vallen onder organische lijm en worden verkregen uit natuurlijke bronnen zoals zetmeel en gom. Ze worden veelvuldig gebruikt in houtbewerking en de papierindustrie."@nl;
  skos:altLabel "plantaardig lijm"@nl, "plantenlijm"@nl, "plantenlijmen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a19855b1-c4a8-4892-a906-0c8bf8b777f6>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/42537d71-bb37-486d-bebb-a0058fdf8731>,
