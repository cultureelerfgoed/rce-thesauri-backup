<https://data.cultureelerfgoed.nl/term/id/cht/43b9d2a0-5cbf-4eda-93d2-88bb4e24914a>
  a skos:Concept;
  skos:prefLabel "jachthutten"@nl;
  skos:scopeNote "De jachthut is een overdekte verzamelplaats voor jagers. Vanaf de jachthut is goed zicht op de jachtplaats."@nl;
  skos:altLabel "jachthut"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cef967f0-40b3-43ab-8e48-fb7215844297>;
