  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/68dcf073-80c8-4e12-9633-61677ee0e789>
  a skos:Concept;
  skos:prefLabel "handschroeven"@nl;
  skos:scopeNote "Spanschroeven die worden gebruikt in de metaal- en houtbewerking om kleine voorwerpen vast te houden of om moeren en bouten vast te pakken. (AAT-Ned)"@nl;
  skos:altLabel "handschroef"@nl;
