<https://data.cultureelerfgoed.nl/term/id/cht/3494b3e5-0c9a-4793-aa09-91c07a501c38>
  a skos:Concept;
  skos:prefLabel "doksluizen"@nl;
  skos:scopeNote "Sluis of sluishoofd dat de afsluiting van een dok of een haven vormt. (De Binnenvaart)"@nl;
  skos:altLabel "doksluis"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6d138189-3654-4980-986e-9566ffa6ca97>;
