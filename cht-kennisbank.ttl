<https://data.cultureelerfgoed.nl/term/id/cht/9d24c0e6-e362-43e2-b837-a7f816b549ac>
  a skos:Concept;
  skos:prefLabel "jackassbark"@nl;
  skos:scopeNote "Een jackassbark, is een zeilschip met drie (of meer) masten, waarvan de voormast vierkant getuigd is en de hoofdmast gedeeltelijk vierkant getuigd (topzeil, topgallant, enz.) en gedeeltelijk voor-en-acht getuigd is (koers). De bezaanmast is voor-en-achtgetuigd."@nl;
  skos:altLabel "jackass bark"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/13a310d3-f7b9-40ed-8d95-4d3a830106ee>;
