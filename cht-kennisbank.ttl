<https://data.cultureelerfgoed.nl/term/id/cht/dbf9277c-9132-4e7c-a968-9f3594441e20>
  a skos:Concept;
  skos:prefLabel "stroperijen"@nl;
  skos:scopeNote "Stroperijen zijn illegale vangjachten, dus zonder toestemming of vergunning, op wild door middel van stropen, al of niet op verboden terrein. Stroperijen kunnen ook betrekking hebben op visserij. (Van Dale)"@nl;
  skos:altLabel "lichtbakkerij"@nl, "lichtbakkerijen"@nl, "stroperij"@nl;
