<https://data.cultureelerfgoed.nl/term/id/cht/a563b0e2-c50d-4aff-aa94-ea8f4cb006bd>
  a skos:Concept;
  skos:prefLabel "kraspennen"@nl;
  skos:scopeNote "IJzeren pen met lets minder scherpe punt dan priem."@nl, "Stalen pen voor het maken van krassen, vaak met hecht. Onder meer in de 18de en 19de eeuw gebruikt op baksteen voor nauwkeurig metselwerk."@nl;
  skos:altLabel "kraspen"@nl;
