<https://data.cultureelerfgoed.nl/term/id/cht/bc6faf56-ad6d-4907-b4c3-1ff8facb6367>
  a skos:Concept;
  skos:prefLabel "rietdaken"@nl;
  skos:scopeNote "Rietdaken zijn daken gedekt met riet, worden gedekt door rietdekkers. (Haslinghuis)"@nl;
