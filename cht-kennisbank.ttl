<https://data.cultureelerfgoed.nl/term/id/cht/c7ccd524-3326-4a84-a9da-aca090b0a646>
  a skos:Concept;
  skos:prefLabel "boorbeitels"@nl;
  skos:scopeNote "Beitel met scherpe driehoekige punt, die wordt gebruikt om dunne gaten in steen te kloppen."@nl;
  skos:altLabel "boorbeitel"@nl;
