<https://data.cultureelerfgoed.nl/term/id/cht/d5588138-52ea-43f4-9321-9918e7cfe68f>
  a skos:Concept;
  skos:prefLabel "vogelkooien"@nl;
  skos:scopeNote "Vogelkooien zijn kleine onderkomens voor vogels, vaak verplaatsbaar. Zangvogels worden veel in vogelkooien gehouden. Bekend zijn onder andere lijsterkooien, papegaaienkooien, kanariekooien."@nl;
  skos:altLabel "vogelkooi"@nl;
