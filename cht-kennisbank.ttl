<https://data.cultureelerfgoed.nl/term/id/cht/0092d369-5e34-45fe-8317-25ff7e6a2cca>
  a skos:Concept;
  skos:prefLabel "kapperswinkels"@nl;
  skos:scopeNote "Kapperswinkels zijn bedrijven van kappers; mensen die beroepshalve haren knipen en verzorgen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
