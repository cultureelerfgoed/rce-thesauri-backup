<https://data.cultureelerfgoed.nl/term/id/cht/363e46aa-b015-477c-b079-48663356220f>
  a skos:Concept;
  skos:prefLabel "fuseepennen"@nl;
  skos:scopeNote "Geharde stalen pen, waar op de fusee (en daarmee het voorwiel) rond zwenkt bij de besturing. Bij modernere uitvoeringen van onafhankelijke voorwielophanging zijn de fuseepennen door kogelgewrichten (fuseekogels) vervangen."@nl;
  skos:altLabel "fuseepen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/8af79d32-8d08-430f-8fe7-baa78d6757ee>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/364b6163-0230-4c51-87f2-9641787c8d80>
  a skos:Concept;
  skos:prefLabel "verdingen"@nl;
  skos:scopeNote "Werkcontract, overeenkomst tussen opdrachtgever en aannemer, dat kon slaan op een betaling van het hele werk of per verwerkte eenheid. (Haslinghuis)"@nl;
  skos:altLabel "verding"@nl;
