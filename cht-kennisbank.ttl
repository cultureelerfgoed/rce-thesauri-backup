<https://data.cultureelerfgoed.nl/term/id/cht/6b90dc55-82c0-49dc-84a3-d692bf53277d>
  a skos:Concept;
  skos:prefLabel "bijlanders"@nl;
  skos:scopeNote "Te gebruiken voor zeilschepen met latijnzeilen aan de grote mast en razeilen aan een kleinere bezaansmast. (AAT)"@nl;
  skos:altLabel "bijlander"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b199dc3c-159a-4eea-b04a-294bbe728e6e>;
