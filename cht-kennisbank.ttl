<https://data.cultureelerfgoed.nl/term/id/cht/cda2f855-b76a-4f1b-aa06-c76d134fcd7c>
  a skos:Concept;
  skos:prefLabel "dubbele deuren"@nl;
  skos:scopeNote "Twee deuren, die in het midden tegen elkaar sluiten. (Haslinghuis)"@nl;
  skos:altLabel "dubbele deur"@nl;
