<https://data.cultureelerfgoed.nl/term/id/cht/77fe5062-c4e4-40f0-8871-42d0459f72cb>
  a skos:Concept;
  skos:prefLabel "keperbogen"@nl;
  skos:scopeNote "Keperbogen zijn bogen die door twee schuin tegen elkaar geplaatste stenen gevormd worden. Het is uiteraard slechts een in het klein en meestal sierend toegepaste constructie. In voor- en vroegromaanse tijd gebruikt boven kleine vensters en nissen. Gedurende de hele middeleeuwen voor kaarsnissen toegepast. (Haslinghuis)"@nl;
  skos:altLabel "keperboog"@nl, "mijterbogen"@nl, "mijterboog"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/42f94d21-f2a3-40e2-bf34-cc9e17ddaaaa>;
