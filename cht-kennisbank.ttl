<https://data.cultureelerfgoed.nl/term/id/cht/141afa1e-d1bd-4319-9485-b5dcd7289e24>
  a skos:Concept;
  skos:prefLabel "mosterdlepels"@nl;
  skos:scopeNote "Kleine lepels die meestal bestaan uit een uitgerekte kom met een lang, dun handvat en die voornamelijk worden gebruikt om mosterd uit mosterdpotten te scheppen. (AAT-Ned)"@nl;
  skos:altLabel "mosterdlepel"@nl;
