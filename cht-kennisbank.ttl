<https://data.cultureelerfgoed.nl/term/id/cht/e0494ad3-9a11-4763-ac53-d367f3416cbc>
  a skos:Concept;
  skos:prefLabel "lavaborekken"@nl;
  skos:scopeNote "Een van de twee rekjes voor de twee lavabodoekjes, mogelijk voorzien van een tekstbordje met\"ante\" en \"post\", of \"ante missam\" en \"post missam\", waarmee de handdoek voor vóór en na de mis wordt aangeduid."@nl;
  skos:altLabel "lavaborek"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/02a4722d-1dff-4e0a-9519-5a4c2562a48e>;
