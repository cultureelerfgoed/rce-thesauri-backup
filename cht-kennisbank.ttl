<https://data.cultureelerfgoed.nl/term/id/cht/c400c8dc-88a9-4c11-9e31-ef3c30e95d7d>
  a skos:Concept;
  skos:prefLabel "okselbanden"@nl;
  skos:scopeNote "Binnenste steekband in een standerdmolen. Vgl. meesterband. (Haslinghuis)"@nl;
  skos:altLabel "okselband"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0f9f1f56-ffd0-4cfc-8294-96f08a2a31de>;
