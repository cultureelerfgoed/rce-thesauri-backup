<https://data.cultureelerfgoed.nl/term/id/cht/a3972ca8-001c-444e-9f38-88b173b9223c>
  a skos:Concept;
  skos:prefLabel "zendmasten"@nl;
  skos:scopeNote "Zendmasten zijn hoge bouwwerken, meestal in de vorm van betonnen torens of stalen buizenconstructies, vanwaaruit signalen door middel van kabels gedistribueerd worden. Typerend is de enorme hoogte en landelijke ligging van het bouwwerk. (Rijksdienst voor het Cultureel Erfgoed/Van Dale)"@nl;
  skos:altLabel "zendmast"@nl, "ontvangstmasten"@nl, "ontvangstmast"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e9251d88-dd54-4e65-9e36-9c19fd66a7a0>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/448cc806-8063-461e-a3a9-19ea2ee70cca>
  a skos:Concept;
  skos:prefLabel "cadeauwinkels"@nl;
  skos:scopeNote "Te gebruiken voor winkels waar artikelen worden verkocht die voornamelijk decoratief of amusant zijn en waarvan de aantrekkingskracht, meestal gebaseerd op de nieuwheid van het ontwerp, veelal van voorbijgaande aard is. (AAT)"@nl;
  skos:altLabel "cadeauwinkel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/10f47eb6-f1a9-465f-b8ab-8381925f039b>;
