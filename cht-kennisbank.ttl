  a skos:Concept;
  skos:prefLabel "troffels"@nl;
  skos:scopeNote "Een zilveren of verzilverde troffel is het ceremonieel metselgereedschap dat wordt gebruikt bij een eerste steenlegging. Een inscriptie op het blad verhaalt over de feestelijke gebeurtenis."@nl;
  skos:altLabel "troffel"@nl;
