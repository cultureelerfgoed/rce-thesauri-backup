    <https://data.cultureelerfgoed.nl/term/id/cht/d6577cbb-1dc8-4cd2-8f9e-3119c59eafe0>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/1e2b6201-c6b6-411a-ac8b-bad143d73271>
  a skos:Concept;
  skos:prefLabel "haringfuiken"@nl;
  skos:scopeNote "Op de palingfuik gelijkende fuik, maar flink forser van formaat. (De Binnenvaart)"@nl;
  skos:altLabel "haringfuik"@nl;
