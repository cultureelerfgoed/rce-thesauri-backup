<https://data.cultureelerfgoed.nl/term/id/cht/d7b4d1d3-5286-449b-9ec7-25fd4f7d8e8a>
  a skos:Concept;
  skos:prefLabel "windturbinegebouwen"@nl;
  skos:scopeNote "Bebouwing t.b.v. het opwekken van elektrische energie, waarvoor de energie geleverd wordt door wind en opgenomen door middel van wieken."@nl;
  skos:altLabel "windturbinegebouw"@nl;
