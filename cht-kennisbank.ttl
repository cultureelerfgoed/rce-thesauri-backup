<https://data.cultureelerfgoed.nl/term/id/cht/91dbb98a-611f-41ed-8145-f690ef466c5b>
  a skos:Concept;
  skos:prefLabel "blinddrukken (prent)"@nl;
  skos:scopeNote "Prenten waarin de afbeelding grotendeels wordt gevormd door oppervlakken in reliëf te drukken door middel van uithollingen van de printplaat of blokken, gewoonlijk zonder het gebruik van inkt. (AAT-Ned)"@nl;
  skos:altLabel "blinddruk"@nl, "preegdruk"@nl, "lithografische blinddrukken"@nl;
