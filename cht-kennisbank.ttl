<https://data.cultureelerfgoed.nl/term/id/cht/ea5d58c2-2f28-44a4-a6e9-89ab17401203>
  a skos:Concept;
  skos:prefLabel "gespannen (dakonderdeel)"@nl;
  skos:scopeNote "Samenstel van twee daksporen (spannen) met bijbehorende hanenbalken, blokkelen enz. ghespannen: 1394 Sluis (Z.), stadhuis. (Haslinghuis)"@nl;
  skos:altLabel "gespan (dakonderdeel)"@nl;
