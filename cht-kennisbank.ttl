<https://data.cultureelerfgoed.nl/term/id/cht/5ba87282-22a9-4f89-8dae-6927a9e88049>
  a skos:Concept;
  skos:prefLabel "loges (theateronderdeel)"@nl;
  skos:scopeNote "Loges zijn kleine afgeschoten ruimtes die aan de zij- of achterwand van een theaterzaal zijn gesitueerd. Meestal in enkele reeksen boven elkaar en plaats biedend aan vier tot zes toeschouwers. (Rijksdienst voor het Cultureel Erfgoed/Haslinghuis)"@nl;
  skos:altLabel "loge (theateronderdeel)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/3ecd1894-dca1-4341-b534-1cef52f17ca5>;
