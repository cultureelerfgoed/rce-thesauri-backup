<https://data.cultureelerfgoed.nl/term/id/cht/88037e19-75ba-47e1-8ed1-9b9f7bc9d2b9>
  a skos:Concept;
  skos:prefLabel "solitairen"@nl;
  skos:scopeNote "Solitairen zijn bomen of grote heesters individueel en vrijstaand als blikvanger geplaatst in de tuin- of parkcompositie. De solitair heeft de voor de soort karakteristieke groeivorm. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "solitair"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2971af0-cde7-4888-b828-33443f702e7d>;
