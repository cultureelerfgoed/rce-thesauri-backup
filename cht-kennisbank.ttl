  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/5fb5de5c-09a3-439f-9aeb-3cb0ec48d851>
  a skos:Concept;
  skos:prefLabel "reticules"@nl;
  skos:scopeNote "De zeer kleine damestassen voor het dragen van persoonlijke artikelen, vaak gemaakt van zachte materialen of kralen, oorspronkelijk met een trekkoord sluiting en rond de pols of in de hand.gedragen. (AAT)"@nl;
