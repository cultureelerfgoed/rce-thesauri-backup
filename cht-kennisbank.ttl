<https://data.cultureelerfgoed.nl/term/id/cht/cab37f8f-449f-4f96-b84c-89af69f1dafa>
  a skos:Concept;
  skos:prefLabel "hervormde begraafplaatsen"@nl;
  skos:scopeNote "Hervormde begraafplaatsen zijn begraafplaatsen die aangelegd en bedoeld zijn door hervormde of protestantse gemeenten voor leden van de kerk. Veel hervormde begraafplaatsen liggen naast of achter het eigen kerkgebouw. De begraafplaatsen kennen vaak een strakke, sobere aanleg. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "hervormde begraafplaats"@nl, "protestantse begraafplaats"@nl, "protestantse begraafplaatsen"@nl;
