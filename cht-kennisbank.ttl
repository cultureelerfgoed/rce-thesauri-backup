<https://data.cultureelerfgoed.nl/term/id/cht/ab22996e-9b21-44cc-8afd-943835b6d603>
  a skos:Concept;
  skos:prefLabel "invalidenliften"@nl;
  skos:scopeNote "Invalidenliften zijn speciaal ontworpen liften die toegankelijk zijn voor mensen met een lichamelijke beperking, vaak met extra ruimte en aangepaste bedieningspanelen."@nl;
  skos:altLabel "invalidenlift"@nl;
