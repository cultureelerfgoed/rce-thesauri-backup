<https://data.cultureelerfgoed.nl/term/id/cht/afd932e8-2cbb-487d-bdc0-aeb9c888d8dc>
  a skos:Concept;
  skos:prefLabel "Vroegste Dryas"@nl;
  skos:scopeNote "Vroegste Dryas is de vroegste fase van de Dryas, een koude periode aan het einde van het Pleistoceen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e98b876e-3b5f-4c2d-a45d-899a1212043c>;
