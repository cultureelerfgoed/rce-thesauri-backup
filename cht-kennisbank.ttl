<https://data.cultureelerfgoed.nl/term/id/cht/5a031ae7-7201-4a88-8205-f19f537da969>
  a skos:Concept;
  skos:prefLabel "schiften"@nl;
  skos:scopeNote "Schuin laten lopen. Vooral gezegd van baksteen. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
