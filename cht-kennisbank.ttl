<https://data.cultureelerfgoed.nl/term/id/cht/ede80f71-470d-4a5b-90a5-453898216d98>
  a skos:Concept;
  skos:prefLabel "ijsfabrieken"@nl;
  skos:scopeNote "IJsfabrieken zijn fabrieken waar op kunstmatige wijze ijs voor koeling en ijs voor consumptie wordt geproduceerd. (IJskelders, koeltechnieken van weleer / A.W. Reinink en J.G. Vermeulen, Nieuwkoop 1981)"@nl;
