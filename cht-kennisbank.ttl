<https://data.cultureelerfgoed.nl/term/id/cht/54842257-3a88-44d7-a4ba-46cf2d14b27a>
  a skos:Concept;
  skos:prefLabel "driekaarsen"@nl;
  skos:scopeNote "Stok met een drietakkige kaars die in de Paaswake aan het nieuwe vuur werd ontstoken, de kerk werd ingedragen als symbool van het licht van de verrezen Christus en werd gebruikt om de paaskaars aan te steken. (AAT-Ned)"@nl;
  skos:altLabel "driekaars"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4eccfe58-0585-4e3c-852d-3b15fc51eee3>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/57cd4888-c95b-4df6-bd6b-0615ed6658ac>
  a skos:Concept;
  skos:prefLabel "gedachteniskaarsen"@nl;
  skos:scopeNote "Kaars die wordt aangestoken bij een gedachteniskruisje of gedachtenisbordje in een gedachtenisdienst. De familie krijgt na deze dienst de kaars mee naar huis."@nl;
  skos:altLabel "gedachteniskaars"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4eccfe58-0585-4e3c-852d-3b15fc51eee3>;
