<https://data.cultureelerfgoed.nl/term/id/cht/abf6e362-afa8-442a-aeb4-acec6fbd353c>
  a skos:Concept;
  skos:prefLabel "bovenwoningen"@nl;
  skos:scopeNote "Bovenwoningen zijn woningen, waarvan de voordeur hoger liggen dan de begane grond. Vaak ligt er onder de bovenwoning een benedenwoning of een winkel of kantoor."@nl;
  skos:altLabel "bovenhuis (woning)"@nl, "bovenhuizen (woning)"@nl, "bovenwoning"@nl;
