<https://data.cultureelerfgoed.nl/term/id/cht/1a2f8478-ca87-4315-8523-b5078bcdd73f>
  a skos:Concept;
  skos:prefLabel "keperfriezen"@nl;
  skos:scopeNote "Keperfriezen zijn gevelornamenten die bestaan uit banden van schuin tegen elkaar gestelde stenen die een zigzag vormen. Het zijn romaanse siermotieven, gebruikt aan torens, daklijsten en koppellijsten tussen lisenen. (Haslinghuis)"@nl;
  skos:altLabel "keperfries"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5bdef557-b7eb-42d4-911c-aa0f050cd960>;
