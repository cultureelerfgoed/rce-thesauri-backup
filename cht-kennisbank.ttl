<https://data.cultureelerfgoed.nl/term/id/cht/4654ce80-0014-436d-b111-ec6ad5bb3f18>
  a skos:Concept;
  skos:prefLabel "balustraden"@nl;
  skos:scopeNote "Balustraden zijn de hekwerken tot borstweringshoogte, bestaande uit een rij balusters, onder en boven verbonden met een voet- en dekstuk. Bovenaan zijn de balustraden afgewerkt met een leuning. (H. Janse, ’Trap en Trede’, RV bijdrage 15, Zeist-’s-Gravenhage 1995)"@nl;
  skos:altLabel "balustrades"@nl, "balustrade"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/45db386a-7e50-4c8f-94d2-6caa48ee8f6a>;
