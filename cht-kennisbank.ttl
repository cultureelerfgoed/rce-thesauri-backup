<https://data.cultureelerfgoed.nl/term/id/cht/7fd6310a-91a0-4aba-9c8d-996003114c6f>
  a skos:Concept;
  skos:prefLabel "publieke collecties"@nl;
  skos:scopeNote "Collecties, meestal maar niet noodzakelijkerwijs in bezit van een openbare instelling, die door publieke personen toegankelijk worden gemaakt. Het vroegst bekende geval van een publieke instantie die een particuliere kunstcollectie ontving, stamt uit de 16de eeuw, toen de familie Grimani hun collectie aan de Republiek Venetië schonk. Gebruik 'privécollecties' voor particuliere collecties die niet toegankelijk zijn voor het publiek. (AAT)"@nl;
  skos:altLabel "publieke collectie"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f2a5e8ee-c4e1-4206-9151-9f9a227e9742>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/be9fce12-b3f8-43a5-9723-63c9757f0bb3>
  a skos:Concept;
  skos:prefLabel "erfgoedkaarten"@nl;
