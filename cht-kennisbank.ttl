<https://data.cultureelerfgoed.nl/term/id/cht/f3c9aa40-6c7c-4f7f-8fed-70f9b423d7a7>
  a skos:Concept;
  skos:prefLabel "Friese pannen"@nl;
  skos:scopeNote "Friese pannen zijn machinaal vervaardigde dakpannen die in verschillende vormen in de tweede helft van de 19e en de eerste helft van de 20e eeuw in Friesland gemaakt zijn. Er zijn vlakke en gegolfde modellen. Gegolfde pannen komen met twee en drie golven voor."@nl;
  skos:altLabel "Friese pan"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f1834398-e32b-4a85-acf4-7f71ab3f94d1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c01ab417-6f6e-4ec6-9b33-4cf355856ebc>
  a skos:Concept;
  skos:prefLabel "dubbele stolpen"@nl;
  skos:scopeNote "Dubbele stolpen zijn stolpen waarbij de constructie bestaat uit twee vierkanten."@nl;
  skos:altLabel "dubbele stolp"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4e1f25d9-b5cc-4169-b5ca-954f56a2ccd2>;
