<https://data.cultureelerfgoed.nl/term/id/cht/c39cba20-5a50-44b8-811a-8c9f0ea9da85>
  a skos:Concept;
  skos:prefLabel "roedeschaven"@nl;
  skos:scopeNote "Een roedeschaaf werd gebruikt om een roede van een raam van een profiel te voorzien."@nl,
