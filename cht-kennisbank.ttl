  a skos:Concept;
  skos:prefLabel "patijts"@nl;
  skos:scopeNote "Dwars op de lengterichting van een muur leggen van bakstenen. In een patijtse laag zijn aan de buitenzijde de koppen van de stenen te zien koppenlaag. Bij een muurdikte van 11/2 en meer stenen liggen de stenen achter een strekkenlaag steeds patijts. (Haslinghuis)"@nl;
  skos:altLabel "patijtse laag"@nl, "patijtse lagen"@nl;
