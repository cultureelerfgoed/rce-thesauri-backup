<https://data.cultureelerfgoed.nl/term/id/cht/3c415068-208a-41ef-aea2-25ed76b59a2d>
  a skos:Concept;
  skos:prefLabel "rinkellatten"@nl;
  skos:scopeNote "Op de rietlatten of rietsporen horizontaal bevestigde latten op de rietsporen waarop het riet (in de kap) wordt vastgebonden."@nl;
