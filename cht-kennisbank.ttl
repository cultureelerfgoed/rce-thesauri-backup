<https://data.cultureelerfgoed.nl/term/id/cht/94d31ee4-9355-4647-b824-6fea904a8b15>
  a skos:Concept;
  skos:prefLabel "dakruiters"@nl;
  skos:scopeNote "Dakruiters zijn torens, meestal van hout, die op de nok van een dak staan, meestal op een kerkdak, maar soms ook op een burgerlijk gebouw. De dakruiter heeft doorgaans een acht- of zeskante, zelden een vierkante doorsnede. Hij bestaat uit een of meer opengewerkte delen, bekroond door een spits, een opengewerkte peer of een koepel. (Haslinghuis)"@nl;
  skos:altLabel "daktorens"@nl, "daktoren"@nl, "angelustoren"@nl, "angelustorens"@nl,
    "dakruiter"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2ffb2c5-397c-47c9-bdb8-a655cd21326d>;
