<https://data.cultureelerfgoed.nl/term/id/cht/fda2ffbc-4a9e-4131-a7bf-59e8f9988010>
  a skos:Concept;
  skos:prefLabel "koffiehuizen"@nl;
  skos:scopeNote "Wordt gebruikt voor openbare gelegenheden waar koffie en andere dranken geserveerd worden en goedkoop eten; vaak de ontmoetingsplaatsen voor levendige politieke discussies; vooral populair in Europa vanaf de 17e tot de 19e eeuw. (AAT-Ned)"@nl;
  skos:altLabel "koffiehuis"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7650ee06-28e5-4178-a7c2-00b9fdfe8394>;
