    <https://data.cultureelerfgoed.nl/term/id/cht/ee3e4e9b-5541-40ad-8ee6-264519d45c90>,
    <https://data.cultureelerfgoed.nl/term/id/cht/8c5e54b2-65ab-446c-9840-6b541879ad57>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

