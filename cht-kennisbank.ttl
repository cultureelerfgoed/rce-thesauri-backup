<https://data.cultureelerfgoed.nl/term/id/cht/a23284f7-3d14-4aa7-9383-ec98d3217b25>
  a skos:Concept;
  skos:prefLabel "wolfdaken"@nl;
  skos:scopeNote "Wolfdaken zijn daken met wolfeinden. Hierbij is het dak voorzien een afschuinde kant aan de korte zijde. De helling van de afgeschuinde kant is meestal steiler dan van de aangrenzende dakvlakken een de zijkant. (Haslinghuis)"@nl;
  skos:altLabel "wolfdak"@nl, "wolfsdak"@nl, "wolfsdaken"@nl;
