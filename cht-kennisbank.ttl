<https://data.cultureelerfgoed.nl/term/id/cht/d51159bd-041e-49c0-9aef-467dc5574a49>
  a skos:Concept;
  skos:prefLabel "dellen"@nl;
  skos:scopeNote "Dellen zijn voormalige meren van zo geringe afmetingen dat ze niet als afzonderlijk eenheden zijn drooggemalen, maar nu lage delen vormen binnen grotere eenheden (West-Friesland). (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "del"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a1c22f35-960a-4152-ab5e-5652612343c8>;
