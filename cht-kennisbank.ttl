<https://data.cultureelerfgoed.nl/term/id/cht/0a4c91bf-49f7-4708-b8a2-92f81669acb1>
  a skos:Concept;
  skos:prefLabel "loopvlakprofielen"@nl;
  skos:scopeNote "Loopvlakprofielen worden in het loopvlak aangebracht om het water af te voeren en om te voldoen aan de eisen, die door het wegdek en door het betrokken voertuig worden gesteld."@nl;
  skos:altLabel "loopvlakprofiel"@nl;
