<https://data.cultureelerfgoed.nl/term/id/cht/4aacbe27-8f7e-4731-905e-4c799446761a>
  a skos:Concept;
  skos:prefLabel "gewelfhouten (verbinding)"@nl;
  skos:scopeNote "Gewelfhouten zijn gebogen korbeelvormige verbindingen tussen daksparren en bijbehorende roosterhouten of hanenbalken. (Haslinghuis)"@nl;
  skos:altLabel "gewelfhout (verbinding)"@nl, "welfhout"@nl, "welfhouten"@nl;
