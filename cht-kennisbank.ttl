<https://data.cultureelerfgoed.nl/term/id/cht/d6c3a483-b967-4262-8da8-19f93a7a6c12>
  a skos:Concept;
  skos:prefLabel "bandoprollers"@nl;
  skos:scopeNote "Bandoprollers zijn klassieke hulpmiddelen om zonweringen aan banden op te halen of neer te laten. Bandklemmen zorgen er voor dat de banden op de gewenste stand gefixeerd blijven. Zowel binnen als buiten kunnen ze worden gemonteerd. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7f511708-23af-4b2d-bf6c-c75d1b31f7b1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/bf0a2b3a-738f-423e-97ff-5c768657cfef>
  a skos:Concept;
  skos:prefLabel "hefdeuren"@nl;
  skos:scopeNote "sluisdeur, die vertikaal op en neer bewogen wordt. Vroeger ook schuifdeur genoemd. (De Binnenvaart)"@nl;
  skos:altLabel "schooffdeuren"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a5fc0cd1-ac59-400d-8ced-74746897cf25>;
