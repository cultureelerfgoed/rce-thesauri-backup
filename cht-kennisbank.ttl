  a skos:Concept;
  skos:prefLabel "kunstharsgemodificeerde cementvloeren"@nl;
  skos:scopeNote "Kunstharsgemodificeerde cementvloeren zijn gietvloeren vervaardigd van cement vermengd met epoxy van ondermeer PE (Polyethyleen), PU (Polyurethaan) en PMMA (Polymethylmetacrylaat)."@nl;
