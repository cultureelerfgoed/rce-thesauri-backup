  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/457b4fda-e41a-4436-9bab-196c91ad46bf>
  a skos:Concept;
  skos:prefLabel "vakwerk"@nl;
  skos:scopeNote "Constructie waarbij houten balken en stijlen aan de uiteinden of kruislings verbonden worden tot een onwrikbaar geheel volgens een stelsel van rechthoeken en driehoeken. Toegepast voor wanden (vakwerkbouw). De term is ontstaan na XIXm. In XIX werden veel villa’s en stadshuizen, vooral in Duitsland, Oostenrijk, Zwitserland, Frankrijk en Groot-Brittannië, in het kader van het historisme in vakwerk gebouwd. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa7202ac-68c8-4d29-9310-0421ca975837>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6d1c8b79-b685-4e38-8d8b-125fe11e8f8f>
  a skos:Concept;
  skos:prefLabel "haagen"@nl;
  skos:scopeNote "Haagen zijn wildbanen met duidelijke omheining. In plaatsnamen als Den Haag en Princenhage is haag te herkennen. (Wildparken in Nederland / H. Renes, In: Historisch-Geografisch Tijdschrift 23 (2005))"@nl;
  skos:altLabel "heeg"@nl, "heegdehaag (wildbaan)"@nl, "hegge (wildbaan)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/79977644-0d1b-4da0-b156-12fa0814b5cd>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6b5042bc-ecff-41ac-b410-a30825a5757c>
  a skos:Concept;
  skos:prefLabel "broekstukken"@nl;
  skos:scopeNote "Broekstukken zijn dakpannen voor een punt waar verschillende dakvlakken bijeenkomen."@nl;
  skos:altLabel "broekstuk"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f1834398-e32b-4a85-acf4-7f71ab3f94d1>;
