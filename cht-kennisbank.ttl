<https://data.cultureelerfgoed.nl/term/id/cht/d2070bd1-9a89-4623-b793-81f9ec1f5862>
  a skos:Concept;
  skos:prefLabel "olieverf"@nl;
  skos:scopeNote "Een verfstof waarin drogende olie als drager voor het pigment fungeert. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7a795abe-51b8-4f72-85bf-aa2ccce7ff02>;
