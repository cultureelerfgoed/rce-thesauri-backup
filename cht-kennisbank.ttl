<https://data.cultureelerfgoed.nl/term/id/cht/45494c53-bf9b-4eb7-a530-baf21de61e40>
  a skos:Concept;
  skos:prefLabel "koppelingsstelbouten"@nl;
  skos:scopeNote "Middel om de vrijeslag van de koppeling bij te stellen, wanneer de koppelingsplaten slijten."@nl;
  skos:altLabel "koppelingsstelbout"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0ef28dc0-1153-4cde-a8a4-7b2873977681>;
