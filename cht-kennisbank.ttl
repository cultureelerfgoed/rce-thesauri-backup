<https://data.cultureelerfgoed.nl/term/id/cht/0a060301-996b-4b55-9249-459e1ff21e88>
  a skos:Concept;
  skos:prefLabel "telescooparmschermen"@nl;
  skos:scopeNote "Telescooparmschermen zijn moderne zonneschermen met een grote breedte en een grote uitval. Ze bestaan uit telescooparmen en schermdoek. Ze komen in vele varianten voor, van eenvoudig tot zeer geavanceerd. De uitval is afhankelijk van de sterkte en de zwaarste van de constructie. Doorgaans zijn de schermen elektrisch bedienbaar. Ze hebben het grote voordeel dat bij elke gewenste uitval het schermdoek strak blijft staan en de constructie met behuizing een minimale ruimte inneemt. (Moderne zonwering voor historische gebouwen / B.H.J.N. Kooij, RCE brochure, Amersfoort 2013)"@nl;
  skos:altLabel "telescooparmscherm"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7f2c26e8-ee43-48d1-9797-c2e812a95a47>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/97dff264-e176-4072-99ca-77c82a1ba0e0>
  a skos:Concept;
