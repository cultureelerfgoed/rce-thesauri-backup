<https://data.cultureelerfgoed.nl/term/id/cht/0995c725-0d16-44d7-be90-9e19840ce867>
  a skos:Concept;
  skos:prefLabel "jads"@nl;
  skos:scopeNote "Een jad (Hebreeuws = hand) is het staafje waarmee de Voorlezer tijdens het voorlezen van de Tora-tekst de woorden aanwijst om ervoor te zorgen dat hij geen fouten maakt. Een jad is meestal van zilver en heeft aan het einde vaak een gesloten handje met een uitgestrekte wijsvinger."@nl;
  skos:altLabel "hand"@nl, "handen"@nl, "handje"@nl, "handjes"@nl, "jad"@nl;
