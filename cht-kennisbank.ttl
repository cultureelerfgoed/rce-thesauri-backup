<https://data.cultureelerfgoed.nl/term/id/cht/6c9b70ad-e44b-45bf-acfb-17cd84848e0c>
  a skos:Concept;
  skos:prefLabel "langspeelplaten"@nl;
  skos:scopeNote "Een langspeelplaat (microgroefplaat) is een geluidsplaat (grammofoonplaat) die meestal is gemaakt van polyvinylchloride (PVC). Deze platen kunnen de opname weergeven met een hoge kwaliteit maar kunnen gemakkelijk beschadigd worden door krassen en door vervormen door teveel warmte. (Conservation Dictionary)"@nl;
  skos:altLabel "elpee"@nl, "langspeelplaat"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b99d539a-ba19-492f-99f6-f221523f84c2>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6cdf8856-4cf3-49c5-84f3-ecea2f7ad931>
  a skos:Concept;
  skos:prefLabel "onroerend"@nl;
  skos:scopeNote "Een onroerend object, zoals een monument, bevindt zich op een vaste plek en kan niet naar een andere locatie worden verplaatst."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/96f8ea1c-ab5c-42dc-975b-8ec50ae5bc66>;
