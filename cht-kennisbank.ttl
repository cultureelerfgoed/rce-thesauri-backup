<https://data.cultureelerfgoed.nl/term/id/cht/07061fa3-9854-446d-adce-f30a7ac10f15>
  a skos:Concept;
  skos:prefLabel "archeologische perioden"@nl;
  skos:scopeNote "Archeologische perioden verwijzen naar tijdsindelingen die worden gebruikt om de opeenvolgende fasen van menselijke activiteit en materiële cultuur in Nederland te categoriseren. Deze indelingen zijn gebaseerd op stratigrafische, typologische en chronologische gegevens en omvatten bijvoorbeeld de prehistorie, Romeinse tijd en middeleeuwen. Ze helpen bij het begrijpen, onderzoeken en documenteren van cultureel erfgoed en archeologische vondsten, en vormen een essentiële basis voor het bestuderen van historische ontwikkelingen in Nederland."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/af2fa9bf-95d2-4e26-9c1b-74c32b585f27>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/6887344a-273e-43ca-8898-d4f6edd58bb8>,
    <https://data.cultureelerfgoed.nl/term/id/cht/e585b82e-6b90-4d4f-a284-63759af31a84>,
    <https://data.cultureelerfgoed.nl/term/id/cht/d22e19dd-d06e-4941-8d53-b3b12f8ac9b9>,
    <https://data.cultureelerfgoed.nl/term/id/cht/8fe70704-449f-4f8c-9c9f-ddeab0702ee0>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

