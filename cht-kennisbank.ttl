<https://data.cultureelerfgoed.nl/term/id/cht/cb154316-1170-474c-8943-5adec0bb805a>
  a skos:Concept;
  skos:prefLabel "harpoenen"@nl;
  skos:scopeNote "Pijlvormig, geweerhaakt, op een schacht gestoken spits of werptuig met een of meer lijnen dat gebruikt wordt voor de vangst van zeezoogdieren en vissen. (ABR)"@nl;
  skos:altLabel "harpoen"@nl;
