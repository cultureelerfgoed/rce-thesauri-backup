<https://data.cultureelerfgoed.nl/term/id/cht/64f1f432-e036-44dc-a6f2-c5db5f5554b3>
  a skos:Concept;
  skos:prefLabel "arkenelen"@nl;
  skos:scopeNote "Arkelachtige uitbouw, dakvenster met een topgeveltje bekroond, dergelijke omtimmering van een hijsbalk. (Haslinghuis)"@nl;
  skos:altLabel "arkeneel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ffc206d4-2de0-4cf8-9b6f-28eea013c3ef>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/aa0c952b-dba1-4c8a-83a5-9b5f7b28aaff>
  a skos:Concept;
  skos:prefLabel "kanthaken"@nl;
  skos:scopeNote "Houten hefbomen met metalen haken aan de schacht, die worden gebruikt om boomstammen te rollen. Werden later met de velhevel gecombineerd. (AAT-Ned)"@nl;
  skos:altLabel "kanthaak"@nl, "keerhaak"@nl;
