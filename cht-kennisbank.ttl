<https://data.cultureelerfgoed.nl/term/id/cht/f448d829-6e3a-4f8e-ac97-cdbc0bdbe1b8>
  a skos:Concept;
  skos:prefLabel "Araldite 2020"@nl;
  skos:scopeNote "Araldite 2020 is een tweecomponenten epoxysysteem gebruikt voor het lijmen van glas en van bij hoge temperatuur gestookte ceramiek."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/20160d9b-4e6e-4c38-8755-0a5ba1c6c894>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f448f92f-5ccd-4c01-bdc1-112f098eea63>
  a skos:Concept;
  skos:prefLabel "bureauorgels"@nl;
  skos:scopeNote "Het bureauorgel is een klein pijporgel dat ingebouwd is in een bureau of secretaire meubel. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "bureauorgel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa9cda1e-c01d-431e-9f74-51d3073b97d5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f44a9977-4241-4637-884d-0c0991aafc43>
  a skos:Concept;
  skos:prefLabel "agar-agar"@nl;
  skos:scopeNote "Agar-agar is een polysaccharide dat voorkomt in zeewier (Rhodophyceae). Het lost op in warm water; de oplossing geleert bij afkoeling. Het is als verstevigingsmiddel gebruikt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/35620ffa-f12c-4d9a-97c5-b849826f9724>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f459733c-a8b9-4e7e-8398-a12998efa08e>
  a skos:Concept;
  skos:prefLabel "trekkoppels"@nl;
  skos:scopeNote "een trekkoppel is een koppel die bediend wordt door een registerknop open te trekken waardoor twee klavieren aan elkaar gekoppeld kunnen worden door middel van een koppelmechanisme tussen of boven de klavieren. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "trekkoppel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b391ff3f-fe77-436c-89bb-21f7944fd426>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f45acd50-7842-4362-b638-314bfe867f57>
  a skos:Concept;
  skos:prefLabel "ultrasoononderzoek"@nl;
  skos:scopeNote "Ultrasoononderzoek is een als non-destructief bedoelde methode voor het opsporen van holten en scheuren in de structuur van een voorwerp of een gebouw."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f4653c9b-8c6b-4c2d-8d23-27d7747ce17f>
  a skos:Concept;
  skos:prefLabel "sticky tape syndrome"@nl;
  skos:scopeNote "Sticky tape syndrome is een hydrolysereactie van water uit de atmosfeer met de drager op geluids- en beeldbanden waardoor deze plakkerig worden hetgeen het afspelen van de band verhindert. De geluids- en beeldinformatie kan (eenmalig) worden hersteld door de band te ‘bakken’."@nl;
  skos:altLabel "sticky shed syndrome"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cea5f41e-f9e4-42a3-a2e4-b0a0977bfa39>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f474a912-508f-4a76-aa28-50b5ea0acc1a>
  a skos:Concept;
  skos:prefLabel "contactinsecticide"@nl;
  skos:scopeNote "Een contactinsecticide is een vast of vloeibaar insecticide dat een insect bij aanraking doodt. Het kan een gifstof zijn of het kan het insect fysiek beschadigen. Deze insecticides worden gebruikt om de verspreiding van insecten in een gebouw tegen te gaan."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/8eaa4297-5674-4395-b70f-745e2b3d8fc5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f47abcaf-ffb2-4e76-9d64-a425e2d20854>
  a skos:Concept;
  skos:prefLabel "compatibel"@nl;
  skos:scopeNote "Twee of meer materialen zijn compatibel, verenigbaar, als zij tegen elkaar of dichtbij elkaar kunnen worden geplaatst zonder dat er één schade lijdt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5f4c4bef-a5c2-4d8e-ad2a-88b04f93f3dc>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f47f3847-246d-499c-8ac1-55cf141c8bc1>
  a skos:Concept;
  skos:prefLabel "aanbevelingen"@nl;
  skos:scopeNote "Een aanbeveling is een formeel advies over de zorg voor een voorwerp, bijvoorbeeld op het gebied van klimaatbeheersing, het bewaren in het depot of de wijze van hanteren."@nl;
  skos:altLabel "aanbeveling"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/72cf2664-95be-48a7-86cd-ac8e220dbb99>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/1974b2a1-d834-4237-911c-ef9b2e9edd2f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f487075d-e9e0-46da-8634-df628b87aaba>
  a skos:Concept;
  skos:prefLabel "woonwagens"@nl;
  skos:scopeNote "Te gebruiken voor gesloten, niet-gemotoriseerde voertuigen die door dieren worden getrokken als rijdende woningen van bijvoorbeeld zigeuners, ketellappers of reizende kooplieden; gebruik 'campers' voor de gemotoriseerde variant. (AAT-Ned)"@nl;
  skos:altLabel "woonwagen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/27f18a43-a2aa-4b07-a601-e083756f1874>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f49b3f63-4aa7-4127-94c8-e7699ca6f979>
  a skos:Concept;
  skos:prefLabel "kwik(II)chloride"@nl;
  skos:scopeNote "Kwik(II)chloride (HgCl2) is een giftige stof die werd gebruikt als gif tegen schimmels en insecten in museumcollecties. Het valt uiteen en produceert kwik als vloeibaar metaal en damp. Het wordt niet meer gebruikt wegens de schadelijkheid voor de exemplaren/voorwerpen en het gezondheidsrisico voor de mens."@nl;
  skos:altLabel "kwik(II)chloride, sublimaat"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f4a08154-e668-4274-ba5a-4575e78e6e1c>
  a skos:Concept;
  skos:prefLabel "zijhamers"@nl;
  skos:scopeNote "Zijhamers zijn een variant van de voorhamers, met het grote verschil dat de pen evenwijdig met de steel loopt."@nl;
  skos:altLabel "zijhamer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d339743b-2655-40ed-b20b-e39879154603>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f4a651cf-4384-42a8-ab8b-987740bd1ee0>
  a skos:Concept;
  skos:prefLabel "evalueren"@nl;
  skos:scopeNote "Bij het beoordelen van een materiaal of een methode bepaalt men de geschiktheid en de doelmatigheid ervan."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/190b9fce-fb0d-4b41-b46d-e1795ae38304>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f4d0526f-32b6-4f5c-b611-5418306abd58>
  a skos:Concept;
  skos:prefLabel "begrotingen"@nl;
  skos:scopeNote "Een begroting geeft de financiële effecten van een beslissing weer. (Wikipedia)"@nl;
  skos:altLabel "begroting"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91712616-6dec-4871-8fdc-c317850c20d1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f4d17368-c2d5-4d97-a78f-573ffb684829>
  a skos:Concept;
  skos:prefLabel "moffelen"@nl;
  skos:scopeNote "Moffelen is het verhitten van een coating op een voorwerp zodat de coating uithardt en cross-linkt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f4d4e2c2-3c76-4b4f-9614-b7265a7eb571>
  a skos:Concept;
  skos:prefLabel "ontwerptekeningen"@nl;
  skos:scopeNote "Tekeningen waarin de opzet van een project uitgewerkt wordt, ongeacht of het ook daadwerkelijk uitgevoerd wordt; ze zijn gedetailleerder dan schetsen. Voor (gebrandschilderde) glas-in-loodpanelen wordt een ontwerptekening op schaal gemaakt. (Werkgroep Vlakglas)"@nl;
  skos:altLabel "ontwerptekening"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb9e1e5b-b319-4519-a4f5-0dd26dbf4524>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f4db7310-af14-41b4-8b24-05d0b16242ee>
  a skos:Concept;
  skos:prefLabel "uitgedroogd"@nl;
  skos:scopeNote "Een voorwerp wordt gedehydrateerd, uitgedroogd, als het vocht verliest of als er water uitgehaald wordt door een fysisch proces. Uitdrogen kan ook met droogmiddelen en door chemische reacties. Een voorwerp, materiaal of luchtvolume is uitgedroogd als (bijna) al het water eruit is getrokken, bijvoorbeeld door een droogmiddel dat water aantrekt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f4fca91b-0e25-4aa9-a47e-b29e4c6a813c>
  a skos:Concept;
  skos:prefLabel "standplaatsen"@nl;
  skos:scopeNote "De standplaats van een voorwerp is zijn exacte locatie in een museum, depot of tentoonstelling; in een opgraving is het de vindplaats."@nl;
  skos:altLabel "standplaats"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91b90dd9-2b48-4131-bb43-5c6cdbc6bfa7>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f52dd4a5-cf41-4a69-9f74-383fb92538ac>
  a skos:Concept;
  skos:prefLabel "zoom"@nl;
  skos:scopeNote "Een zoom is een rand die wordt gevormd door een stuk stof terug te slaan en de rand vast te naaien. Bij een schilderij is een zoom een rand die wordt gemaakt door de rand van het doek om te vouwen en door te stikken. Het schildersdoek wordt in een spanraam ingeregen met draden die door de zoom steken. (Conservation Dictionary)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f5824f95-192e-45d4-b3b0-e6748f9f2416>
  a skos:Concept;
  skos:prefLabel "parketteren"@nl;
  skos:scopeNote "Parketteren is een methode voor het vlak maken van houten panelen. Delen van het hout worden uitgesneden en nieuwe stukken of latjes worden ingezet. De methode wordt niet meer toegepast."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f5b8f980-c4ec-476c-9ddf-5d734a1053ac>
  a skos:Concept;
  skos:prefLabel "ouderdomscraquelure"@nl;
  skos:scopeNote "Een ouderdomscraquelure in een schilderij is smal en loopt recht of een beetje gekromd door alle lagen. De barst is veroorzaakt door klimaatinvloeden en door inwendige of uitwendige spanningsverschillen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/88668eb7-491c-4565-b2b1-58ecd149f506>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f5b91653-21a3-4993-a15b-90a944a868b3>
  a skos:Concept;
  skos:prefLabel "antichloor"@nl;
  skos:scopeNote "Antichloor is een chemische stof die gebruikt wordt om resten van chloorbleekmiddelen te verwijderen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/40766ec4-4368-4614-a988-c11925841758>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f5bcbdf3-b810-4cbd-bee9-63f649bda10c>
  a skos:Concept;
  skos:prefLabel "middelbare tijd"@nl;
  skos:scopeNote "De tijd die is gebaseerd op de ware zonnedag noemt men de ware zonnetijd of ware tijd. Dit is de tijd die door een zonnewijzer wordt aangewezen. Met de komst van eenparig lopende uurwerken kwam men er achter dat de zonnedag varieert gedurende het jaar. Doordat de omloopsnelheid van de aarde rond de zon niet gedurende het gehele jaar dezelfde waarde heeft, varieert de zonnetijd. Dit komt doordat de omloopbaan elliptisch is, zodat de tweede wet van Kepler opgaat. Hierop werd de middelbare zon geïntroduceerd met de middelbare zonnetijd of middelbare tijd. Het verschil tussen de ware tijd en de middelbare tijd is de tijdsvereffening.(bron:http://www.robkalmeijer.nl/wetenschap/astronomie/tijd/index.html)"@nl,
    "De tijd die is gebaseerd op de ware zonnedag noemt men de ware zonnetijd of ware tijd. Dit is de tijd die door een zonnewijzer wordt aangewezen. Met de komst van eenparig lopende uurwerken kwam men erachter dat de zonnedag varieert gedurende het jaar. Doordat de baansnelheid van de aarde rond de zon niet gedurende het gehele jaar dezelfde waarde heeft, varieert de zonnetijd. Dit komt doordat de omloopbaan elliptisch is, zodat de tweede wet van Kepler opgaat. Hierop werd de middelbare zon geïntroduceerd met de middelbare zonnetijd. Het verschil tussen de ware tijd en de middelbare tijd is de tijdsvereffening.(Bron: Wikipedia)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/929f2b49-e558-4543-a710-41a893c3c5dd>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f5cbcf45-0309-4e7d-b653-3e81c992760e>
  a skos:Concept;
  skos:prefLabel "foliëren"@nl;
  skos:scopeNote "Foliëren is het markeren van de bladzijden van een boek, meestal aan de recto zijde. Wanneer aangebracht nadat het boek is gedrukt of gebonden (bijvoorbeeld voor een conserveringsbehandeling), worden gewoonlijk beide zijden van het blad genummerd (bijvoorbeeld: 25r (recto), 25v (verso))."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f5ce4c0b-8a96-4cb9-b081-0c9c4140173e>
  a skos:Concept;
  skos:prefLabel "houtvrije pulp"@nl;
  skos:scopeNote "Houtvrije pulp is een vorm van papierpulp waarvan lignine en hemicellulose langs chemische weg opgelost en uitgespoeld zijn om de cellulose uit het hout vrij te maken. Het wordt gemaakt door houtspaanders onder druk in water met chemicaliën te koken. Het kan het zure sulfietproces of het alkalische sulfaatproces betreffen waarvan het tweede een sterkere pulp oplevert. Het product wordt vaak gebleekt. Dit is de pulp waarvan houtvrij papier wordt gemaakt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f5d7168e-074e-4756-9829-6b6f5189fb51>
  a skos:Concept;
  skos:prefLabel "doopvonten"@nl;
  skos:scopeNote "Staand bekken van koper of steen als één geheel vormgegeven. Kan worden afgedekt met een deksel. Rondom het doopvont voltrekt zich het ritueel van de doop. In het doopvont bevindt zich het doop-water dat in de Paasnacht wordt gezegend en het jaar daaropvolgend wordt gebruikt. (Religieus Erfgoedthesaurus)"@nl;
  skos:altLabel "doopvont"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/abfc1bb7-04d7-43a0-9e99-dd4c5a4f2c15>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f62c26f1-3b31-4a92-9ca2-b30e57c98cef>
  a skos:Concept;
  skos:prefLabel "scherven tapen"@nl;
  skos:scopeNote "Het tapen van glas- of ceramiekscherven gebeurt met tape of lijmpuntjes. Deze reconstructie gaat vooraf aan het capillair laten inzuigen van laagviskeuze lijm in de naden."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f63909be-f50c-4e86-b61e-6e336ac159f1>
  a skos:Concept;
  skos:prefLabel "verre cordelé (frans)"@nl;
  skos:scopeNote "Verre Cordelé of Goetheglas is mondgeblazen glas dat beperkt onregelmatigheden bevat (kan door de opdrachtgever bepaald worden) die tijdens het blazen worden verkregen door bewerking van de cilinder in een halfronde mal. Het heterogene glasmengsel zorgt voor glasslierten die een bewegingseffect aan het glas geven. Meest gangbare kleuren zijn: blank groen, en lichtgeel. Dikte varieert van 2 - 4 mm. Afmetingen: ca. 1000 x 1000 mm. Toepassing: verwerking in glas-in-lood, als losse ruiten voor historische gebouwen en kerken of anderszins. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "goetheglas (duits)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/963156e3-7f49-4073-ab86-cea592518c26>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f686d476-000f-4bc8-a39d-9b9674ae2280>
  a skos:Concept;
  skos:prefLabel "vulmateriaal"@nl;
  skos:scopeNote "Vulmateriaal is materiaal dat rondom of in een loze ruimte in het object wordt gedaan om beweging ervan te minimaliseren of te verhinderen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f68e3d0b-b724-44f2-af92-2a01eab52bc4>
  a skos:Concept;
  skos:prefLabel "drukrollen"@nl;
  skos:scopeNote "Een drukrol is een rubberen rol die zich dichtbij de capstanas van bandrecorders bevind. (Conservation Dictionary)"@nl;
  skos:altLabel "drukrol"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91712616-6dec-4871-8fdc-c317850c20d1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f6975bb5-0691-486d-bce6-6ee4b5c8c64c>
  a skos:Concept;
  skos:prefLabel "tricycleen"@nl;
  skos:scopeNote "Tricycleen (C<sub>10</sub>H<sub>16</sub>) is een vluchtige, drievoudig onverzadigde koolwaterstof. Zie vluchtig bindmiddel."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f69ed7ab-ea56-41ad-8257-a8a46a77fd94>
  a skos:Concept;
  skos:prefLabel "elektrodepotentiaal"@nl;
  skos:scopeNote "De elektrodepotentiaal is de spanning van een elektrode in een elektrochemische cel, gemeten tegen een referentie-elektrode."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cea5f41e-f9e4-42a3-a2e4-b0a0977bfa39>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f6b001d8-84cc-4493-a896-880aea9156e6>
  a skos:Concept;
  skos:prefLabel "karveel"@nl;
  skos:scopeNote "Constructiewijze, waarbij de huidplanken tegen elkaar sluiten en niet overnaads , daardmee een gladde scheepshuid vormen."@nl;
  skos:altLabel "gladboordig"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f6bcf910-708d-4ca0-b1bf-0469e219b216>
  a skos:Concept;
  skos:prefLabel "ponsen"@nl;
  skos:scopeNote "Een pons is een metalen stuk gereedschap dat aan het ene uiteinde een versiering draagt. Met de pons wordt de versiering in een vergulde gessolaag gedrukt. (Conservation Dictionary)"@nl;
  skos:altLabel "pons"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/7b922e63-150b-48cc-a9a3-cb8a79cbdbda>,
    <https://data.cultureelerfgoed.nl/term/id/cht/0c72b67f-aec1-41a6-830b-9492525b1782>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f6e62fd0-de1c-44e6-879e-b39053f02833>
  a skos:Concept;
  skos:prefLabel "breukglas"@nl;
  skos:scopeNote "Breukglas is schoon, gebroken glas van glaswerk dat tijdens de fabricage sneuvelt. Het wordt weer gesmolten met het gemeng voor een nieuwe partij glas."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dcc2121b-8394-44f7-9664-86b109d079a4>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f6ef32eb-f613-4f02-8a12-f66965b19e13>
  a skos:Concept;
  skos:prefLabel "netcraquelure"@nl;
  skos:scopeNote "Netcraquelure is een defect in een verf- of vernislaag door een slechte hechting van de bovenste laag aan de onderliggende laag. Het gevolg is een netvormig patroon van craquelures."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/88668eb7-491c-4565-b2b1-58ecd149f506>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f723bf07-33ce-4456-af7c-71e8da6b6031>
  a skos:Concept;
  skos:prefLabel "inzetcijferbakken"@nl;
  skos:scopeNote "De inzetcijferbak is de bak of kast waarin de cijfers voor het aangeven van de te zingen gezangen of psalmen tijdens de kerkdienst zijn opgeslagen."@nl;
  skos:altLabel "inzetcijferbak"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/efa1e071-9861-4eb6-85c2-8e72b3a37ba3>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f73d0d07-8e33-4f83-9021-c376ce5d29d3>
  a skos:Concept;
  skos:prefLabel "wijzersbladen"@nl;
  skos:scopeNote "Wijzersbladen zijn de afleesvlakken van zonnewijzers waarop de tijd en andere gegevens zijn af te lezen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "wijzersblad"@nl, "zonnewijzerplaat"@nl, "zonnewijzerplaten"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f9f092ea-f36e-4278-8098-12815a13e0dc>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f7414ca4-09ef-4b95-b5ff-9e1d0007e162>
  a skos:Concept;
  skos:prefLabel "schrappalen"@nl;
  skos:scopeNote "Schrappalen zijn palen of blokken waar men bij het schrappen (glad maken) van klompen vóór gaat zitten. Men klemt de klomp met de borst tegen de schrappaal vast."@nl;
  skos:altLabel "schrappaal"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f77993de-cee3-4537-8fbc-92e3271b616e>
  a skos:Concept;
  skos:prefLabel "putgravers"@nl;
  skos:scopeNote "Putgravers zijn mensen die waterputten graven en waterpompen installeren."@nl;
  skos:altLabel "putdelver"@nl, "putdelvers"@nl, "putgraver"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db4a7619-d236-4b14-8e79-b4a6e890f677>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f789651a-83dd-4655-a9f8-fb1ddb8ee087>
  a skos:Concept;
  skos:prefLabel "vijlen (activiteit)"@nl;
  skos:scopeNote "Vijlen is het koud bewerken van oppervlakken met bepaalde handgereedschappen die vijlen worden genoemd. Er zijn vele soorten vijlen, fijne, grove, smalle en brede, voor zowel metaal als voor hout."@nl;
  skos:altLabel "gevijld"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f78e6ab7-d090-492b-8383-fddd341f29d5>
  a skos:Concept;
  skos:prefLabel "photochemische degradatie"@nl;
  skos:scopeNote "Fotochemische degradatie een chemische aantasting die op gang wordt gebracht door de energie van elektromagnetische straling. Als vuistregel voor zonlicht geldt dat de aantasting voor de ene helft door UV-straling komt en voor de andere helft door zichtbaar licht. In textiel wordt de chemische bouw van de polymeren en van de kleurstoffen beschadigd."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f79cf3f8-83f5-4a35-b473-6e9ea5bc9b2c>
  a skos:Concept;
  skos:prefLabel "aanwas"@nl;
  skos:scopeNote "Aanwas (aanslag) is een niet gewenste afzetting op het oppervlak van een object of een schilderij. Het kan bijvoorbeeld vliegenpoep, stof en zouten betreffen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f7cadaf2-6ff8-4ec1-84ac-e002c6271772>
  a skos:Concept;
  skos:prefLabel "composiet"@nl;
  skos:scopeNote "Composieten zijn fabrieksmatig samengestelde isolatiematerialen, die bestaan uit twee of meer materialen die innig met elkaar zijn verbonden, met het doel betere eigenschappen te verkrijgen en om ze sneller te kunnen verwerken. Beproefde combinaties zijn onder andere houtwol en cement, asbest en cement, riet en gips, en kurk en pek. (Geschiedenis en ontwikkeling van het isoleren in Nederland : een eerste verkenning van historische isolatiematerialen en hun toepassingen in monumenten / B.H.J.N. Kooij, In: Praktijkreeks cultureel erfgoed; afl. 15, nr. 40, 2011)"@nl,
    "Een samengesteld, composiet, voorwerp is gemaakt uit twee of meer soorten materiaal."@nl;
  skos:altLabel "composieten"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/be0d2f0b-5d25-4366-8711-1f75fa33fa49>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f7dec27b-98cf-436a-a902-1ab7a3fe79ec>
  a skos:Concept;
  skos:prefLabel "restitutie"@nl;
  skos:scopeNote "Restitutie, teruggave, van een voorwerp (of collectie) is de teruggave ervan aan de mensen voor wie het een bijzondere betekenis heeft. Dit kan een individu zijn, of een groep die tot een bepaalde cultuur of religie behoort, of het land van herkomst."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/190b9fce-fb0d-4b41-b46d-e1795ae38304>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f7e6a9bb-9688-43f8-9ba9-051fa528fda9>
  a skos:Concept;
  skos:prefLabel "aanzichtjacht"@nl;
  skos:scopeNote "Aanzichtjacht is het schieten van wild vanaf een verhoging. Men bedrijft om meerdere redenen deze jachtvorm. Allereerst heeft men een beter zicht op het jachtterrein. Ten tweede kan de jager zich er goed verbergen voor het wild en ten derde dat men vanaf een verhoging schiet, is er minder kans onbedoelde objecten te raken omdat de bodem als veilige kogelvang fungeert. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fe944ecb-9c86-4a8e-87e0-f196bac83383>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f7eb91a8-bae3-4a71-8209-ae2f99e8f174>
  a skos:Concept;
  skos:prefLabel "capillair water"@nl;
  skos:scopeNote "Capillair water is de hoeveelheid water die aanwezig is in de poriënstructuur van een poreus materiaal."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0c41c9b8-fb66-48af-b44a-46dd24503c6c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f8449ffb-ae9a-4a28-b121-b3d9d0ad089b>
  a skos:Concept;
  skos:prefLabel "rijgsteek"@nl;
  skos:scopeNote "De rijgsteek is een variatie op de traditionele doorrijgsteek die wordt gebruikt om stukken stof tijdelijk aan elkaar te bevestigen zodat deze tijdens het vastnaaien niet kunnen verschuiven. In de textielconservering wordt de rijgsteek gebruikt om een voering of steunlaag aan een voorwerp vast te zetten en om een goede ondersteuning te verkrijgen over grote oppervlaktes."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f85b7f95-8158-45cb-ba00-d1ec31e5a2a1>
  a skos:Concept;
  skos:prefLabel "standaard-elektrodepotentiaal"@nl;
  skos:scopeNote "De standaard-elektrodepotentiaal van een metaal is de elektrische spanning waarbij ionen van het metaal worden gereduceerd tot de metaalvorm, onder standaardomstandigheden, ten opzichte van een standaard (referentie) waterstofelektrode."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cea5f41e-f9e4-42a3-a2e4-b0a0977bfa39>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f8607d91-dbe4-400b-92a2-ba1d47bd0bef>
  a skos:Concept;
  skos:prefLabel "pâte-de-verre"@nl;
  skos:scopeNote "Pâte-de-verre is een materiaal dat wordt gebruikt om glas te maken in mallen. Het wordt gemaakt door glas tot poeder te malen, er een vloeimiddel aan toe te voegen zodat het gemakkelijk smelt, en een kleurende stof. Het wordt in een vorm gedaan en in de oven gesmolten. Deze methode werd al toegepast in het oude Egypte en herleefde in de 19de eeuw in Frankrijk."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f87a3cea-455a-4df1-87ea-e6cd4523439c>
  a skos:Concept;
  skos:prefLabel "mandorla's"@nl;
  skos:scopeNote "Op een schilderij is een mandorla een ovaal of amandelvormige licht rondom Christus. (Conservation Dictionary)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/623e7274-a6cb-4133-b9b4-83f0db8d4f01>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f88f7718-2642-4342-8747-23250cc34f76>
  a skos:Concept;
  skos:prefLabel "calamiteitenplan (activiteit)"@nl;
  skos:scopeNote "Een calamiteitenplan is een plan waarin de eerste handelingen staan beschreven die ondernomen moeten worden (en wie ze moet uitvoeren) om de directe gevolgen van een ramp zoals brand, overstroming, zware storm, aardbeving, lekkage, inbraak en/of vandalisme te minimaliseren. Een calamiteitenplan (opgesteld door een museum) bevat de activiteiten die men onderneemt ter voorbereiding op en ter voorkoming van een calamiteit en voor de bestrijding van (de gevolgen van) een noodsituatie of een calamiteit."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/190b9fce-fb0d-4b41-b46d-e1795ae38304>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f8aff291-90b6-4770-882c-57522dfee5af>
  a skos:Concept;
  skos:prefLabel "kanaalvorming"@nl;
  skos:scopeNote "Kanaalvorming is een lijnvormig delaminatiepatroon veroorzaakt door verval van de drager."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f8c65616-199f-48d9-ac94-690beb7f1531>
  a skos:Concept;
  skos:prefLabel "malachiet"@nl;
  skos:scopeNote "Basisch kopercarbonaat, malachiet [Cu(OH)2.CuCO], is een kenmerkende component van het groene patina op koper. Het werd ook gebruikt als groen pigment in de schilderkunst. (Conservation Dictionary)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9a18ce2d-c3dd-44e4-9542-9f973f7d6c4a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f8f59bb7-b936-472b-9b6e-0271e2166736>
  a skos:Concept;
  skos:prefLabel "eiwitvernis"@nl;
  skos:scopeNote "Het gebruik van het wit van een ei als slotvernis voor schilderijen is beschreven door Cennino Cennini (eind 14e eeuw) en door Filippo Baldinucci (1681). Zie ook eiwitvernis en eiwit."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6340ddd5-1366-423b-a501-88cfc45f8746>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f90b48b5-eefc-4b73-8d28-2919e4aa8cd9>
  a skos:Concept;
  skos:prefLabel "cyanoacrylaat"@nl;
  skos:scopeNote "Een cyanoacrylaat monomeer, zoals ethyl-2 cyanoacrylaat, zal in de aanwezigheid van water polymeriseren tot een polymeer met een zeer hoog molecuulgewicht. Dit wordt gebruikt voor het lijmen van ceramiek en steen. Het polymeer wordt afgebroken in alkalisch milieu zoals dat op instabiel glas kan bestaan."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2c2e3d6f-cf42-47d6-9c1d-d30c4fdf79e5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f91e5f36-6971-4fda-9526-efe3ddb75cc8>
  a skos:Concept;
  skos:prefLabel "publiceren"@nl;
  skos:scopeNote "Publiceren is de formele verspreiding van informatie aan het publiek via een duurzaam communicatiemiddel."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/190b9fce-fb0d-4b41-b46d-e1795ae38304>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f9210dd0-d16b-40ea-8349-0967bde7e0f3>
  a skos:Concept;
  skos:prefLabel "bordijzers"@nl;
  skos:scopeNote "Een bordijzer is een platte beitel met verschillende breedtes."@nl;
  skos:altLabel "bordijzer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ceb91b0c-75e8-4063-a01d-eeb27e4e7941>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f9358134-a3a0-48bd-8a1c-18b0f68b2800>
  a skos:Concept;
  skos:prefLabel "vervalproduct"@nl;
  skos:scopeNote "Een vervalproduct is een stof die ontstaat door veranderingen in de materialen van een object."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f96715d0-63e1-4a36-9ec3-e43cb8f64dc2>
  a skos:Concept;
  skos:prefLabel "neerslagen (informatieverwerking)"@nl;
  skos:scopeNote "Ontvangen of opgemaakte informatie welke gebruikt is bij de uitvoering van bedrijfsprocessen."@nl;
  skos:altLabel "neerslag (informatieverwerking)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cea5f41e-f9e4-42a3-a2e4-b0a0977bfa39>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f96ba681-91b6-44fa-b3fa-9f8bd2f244c3>
  a skos:Concept;
  skos:prefLabel "uitsparingstechniek"@nl;
  skos:scopeNote "Om een textiel te bedrukken met de uitsparingstechniek wordt het ontwerp gedrukt met een uitsparingsubstantie (zoals was, klei, gom) die voorkomt dat de kleurstof zich op die plaatsen kan binden aan de vezels. Na het verven wordt de uitsparingsstof uitgewassen, waarmee het ongekleurde ontwerp zichtbaar wordt. Zie ook bedrukte textiel. Als een voorwerp wordt versierd met een uitsparingstechniek, wordt de versiering aangebracht met behulp van een uitsparingsstof (zoals bijvoorbeeld was, klei, gom), welke voorkomt dat een kleurstof zich aan het materiaal kan binden. Na het verven wordt de uitsparingstof verwijderd, waarmee het ongeverfde deel van het ontwerp zichtbaar wordt. Zie ook bedrukte textiel."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f9c6c82a-99bd-4237-a8e1-e1dde442b417>
  a skos:Concept;
  skos:prefLabel "sneeuwploegen"@nl;
  skos:scopeNote "Een sneeuwploeg is een hulpmiddel voor het verplaatsen van sneeuw op wegen of spoorwegen. (Wikipedia)"@nl;
  skos:altLabel "sneeuwploeg"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/86717f57-e261-465e-8f1c-bd32011f40d9>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f9f092ea-f36e-4278-8098-12815a13e0dc>
  a skos:Concept;
  skos:prefLabel "zonnewijzeronderdelen"@nl;
  skos:scopeNote "Een zonnewijzer is een instrument om met behulp van de zon de tijd aan te wijzen, meestal in de vorm van een vlak of schijf waarop de tijd valt af te lezen aan de plaats van de schaduw die een stift (de stijl) erop werpt. De oudst bekende zonnewijzer dateert van omstreeks 1500 v. Chr. en werd in Egypte gevonden. Alle onderdelen, waaruit een zonnewijzer is opgebouwd vormen samen de zonnewijzeronderdelen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ef27a877-7e1e-4ceb-914a-0319fe020061>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/61692bfe-485d-4c74-b6fe-17cef9f4ddf4>,
    <https://data.cultureelerfgoed.nl/term/id/cht/a57e52c6-0091-4f1c-b7e1-1e8b563c4108>,
    <https://data.cultureelerfgoed.nl/term/id/cht/f73d0d07-8e33-4f83-9021-c376ce5d29d3>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f9fce53a-b861-4a2e-9f53-233d8833a8e8>
  a skos:Concept;
  skos:prefLabel "gipspleister"@nl;
  skos:scopeNote "Gipspleister was een in de 19de eeuw gepatenteerd cement op basis van gips, gebruikt voor sierpleister."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1a289d6b-fbdc-4888-a953-4c046f16c89e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fa340627-3fb7-4155-95f7-788cb8c0db97>
  a skos:Concept;
  skos:prefLabel "marmergrond"@nl;
  skos:scopeNote "Een marmergrond is een verdikte vloeistof die dient om in water onoplosbare inkten te laten drijven bij het marmeren van papier. Het wordt gemaakt door polysacchariden uit Iers mos of tragantgom in water op te lossen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fa55480a-b2ed-4b00-8c92-ea8a5ffffb86>
  a skos:Concept;
  skos:prefLabel "potentiodynamisch"@nl;
  skos:scopeNote "Bij de potentiodynamische methode verandert de spanning tussen de werkelektrode en de referentie-elektrode met constante snelheid, terwijl de optredende stroomsterkte wordt gemeten."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/47e05121-f2b9-4020-a461-97319b89bf5e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fa5fd746-37c6-4972-b8b6-107acf0c389e>
  a skos:Concept;
  skos:prefLabel "iriserend"@nl;
  skos:scopeNote "Iriseren is het verschijnsel waarbij oppervlakken een verlopend kleureffect tonen, zoals bij een regenboog, als de kijkhoek of hoek van lichtinval verandert. Dit is het gevolg van interferentie. Bij glas is dit een veelvoorkomend verschijnsel door corrosie van het oppervlak, bijvoorbeeld door verblijf in de bodem. Een iriserend oppervlak kan ook geïmiteerd worden door een bewuste chemische aantasting van het glasoppervlak, bijvoorbeeld door het glas bloot te stellen aan metaalzouten."@nl;
  skos:altLabel "irisatie"@nl, "irisering"@nl, "iridiseren"@nl, "lusteren"@nl, "irisé-glas"@nl,
    "geïriseerd"@nl, "geiriseerd"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fa675025-d922-47ab-b4d6-6bf9481e4880>
  a skos:Concept;
  skos:prefLabel "overglazuur"@nl;
  skos:scopeNote "Overglazuur bij keramiek is een design dat op het glazuur is aangebracht en al dan niet wordt meegebakken. (Conservation Dictionary)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fa80205f-3c06-4a63-8b33-324ea8008cff>
  a skos:Concept;
  skos:prefLabel "megilp"@nl;
  skos:scopeNote "Megilp is een schildersmedium bestaande uit mastix opgelost in terpentijn, met een toevoeging van lijnolie. De consistentie is gelatineachtig."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/faa057b1-2fb9-4e24-af57-ca4f43eb02f8>
  a skos:Concept;
  skos:prefLabel "konijnenjachten"@nl;
  skos:scopeNote "Konijnenjachten zijn de vangjachten op konijnen, in eerste instantie ten behoeve van de vacht, later ook voor het vlees. Rond het begin van de 14de eeuw zijn konijnen in Nederland geïntroduceerd. Bekend zijn de konijnenwarandes. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "konijnenjacht"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fe944ecb-9c86-4a8e-87e0-f196bac83383>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/faa7543d-e895-4a3e-bb38-d768a9a77b9d>
  a skos:Concept;
  skos:prefLabel "boekbeslagonderdelen"@nl;
  skos:scopeNote "Onderdelen van een boekbeslag. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "boekbeslagonderdeel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c59eabb8-f7d8-4e06-8f5a-51a789bea575>;
