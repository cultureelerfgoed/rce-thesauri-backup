<https://data.cultureelerfgoed.nl/term/id/cht/aa415d09-174f-4b1e-83e3-8ac507b987c4>
  a skos:Concept;
  skos:prefLabel "plateaus"@nl;
  skos:scopeNote "Wordt gebruikt voor tafellanden of uitgestrekte, vlakke gebieden die hoger gelegen zijn dan het omringende land en aan ten minste één kant worden begrensd door een verticale wand. (AAT-Ned)"@nl,
    "Een plateau is een hoog gelegen vlak tot vrij vlak terrein. Plateaus zijn gevormd in het Pleistoceen. (Ten Cate & Maarleveld 1977)"@nl;
  skos:altLabel "plateau"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/41d0db11-7cd2-4cbb-b885-cc763b01298d>;
