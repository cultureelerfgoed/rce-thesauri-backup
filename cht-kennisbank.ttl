<https://data.cultureelerfgoed.nl/term/id/cht/8770d97d-371b-4aad-8a8c-0294cafacf87>
  a skos:Concept;
  skos:prefLabel "parkeerlichten"@nl;
  skos:scopeNote "Klein lampje aan de zijkant van de wagen, dat alleen bij stilstand mag worden gebruikt en naar voren een wit of oranje en naar achteren een helder rood of oranje licht uitstraalt. Mag in Nederland alleen voor personenwagens en alleen binnen de bebouwde kom worden gebruikt."@nl;
  skos:altLabel "parkeerlicht"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a56ec0aa-2ab9-4faf-81f2-a5516305dfeb>;
