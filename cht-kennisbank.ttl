<https://data.cultureelerfgoed.nl/term/id/cht/911fbbb2-fce2-4c7f-bc09-0c94f90da7e0>
  a skos:Concept;
  skos:prefLabel "scheepsraden"@nl;
  skos:scopeNote "Vergadering van opperoffiecieren (van een schip of vloot) om overleg te plegen betreffende de te volgen tactiek in een gevecht of voor het nemen van belangrijke beslissingen. De raad vergadert ook voor het berechten van misdrijven waarop zware straffen of de doodstraf staan. (MARDOC)"@nl;
  skos:altLabel "scheepsraad"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c04948ca-73fa-443d-b893-149802698f16>;
