<https://data.cultureelerfgoed.nl/term/id/cht/ea5e8c9e-2be2-4a75-b13b-662b867312c0>
  a skos:Concept;
  skos:prefLabel "ringveren"@nl;
  skos:scopeNote "Rondgaande verbinding tussen de schoepen van een waterrad."@nl;
  skos:altLabel "ringveer"@nl;
