<https://data.cultureelerfgoed.nl/term/id/cht/33ccce06-3f56-49c1-9268-9015610073ed>
  a skos:Concept;
  skos:prefLabel "treinremonderdelenremverstellers"@nl;
  skos:scopeNote "De remversteller, die bij zeer veel materiaal aanwezig is, kort door indraaien van een schroef de remwerkstang in."@nl;
  skos:altLabel "remversteller"@nl, "remverstellers"@nl, "treinremonderdelenremversteller"@nl;
