<https://data.cultureelerfgoed.nl/term/id/cht/c96f3c33-a0ae-48b0-b841-f9ee25028e76>
  a skos:Concept;
  skos:prefLabel "tillotson carburateurs"@nl;
  skos:scopeNote "De Tillotson carburateur werkt volgens hetzelfde principe als de Solex carburateur. Als hoofdsproeier fungeert echter een afstelbare naaldsproeier."@nl;
  skos:altLabel "tillotson carburateur"@nl;
