<https://data.cultureelerfgoed.nl/term/id/cht/9f938daa-50a5-48cf-b951-0db2f081ee92>
  a skos:Concept;
  skos:prefLabel "transparante lagen"@nl;
  skos:scopeNote "Transparante lagen (coatings) zijn visueel onopvallende lak- of vernislagen die soms worden aangebracht op metaaloppervlakken zoals zilver ter bescherming tegen corrosie"@nl;
