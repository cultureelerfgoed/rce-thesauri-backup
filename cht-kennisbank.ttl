<https://data.cultureelerfgoed.nl/term/id/cht/c11215c3-f517-4bf1-b2de-615c58356644>
  a skos:Concept;
  skos:prefLabel "turquoise"@nl;
  skos:scopeNote "Turquoise is een kleur die zich tussen blauw en groen bevindt, vaak geassocieerd met de gelijknamige edelsteen. Deze kleur wordt gewaardeerd om zijn levendigheid en wordt veel gebruikt in kunst, mode en design vanwege zijn verfrissende en kalmerende uitstraling."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ff8bfbe9-547e-492f-abd7-c7086269ffbb>;
