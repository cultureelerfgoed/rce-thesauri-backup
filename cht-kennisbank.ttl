<https://data.cultureelerfgoed.nl/term/id/cht/2b56b487-bfa3-46de-b529-6bd0f79a1a3b>
  a skos:Concept;
  skos:prefLabel "zilversmeden"@nl;
  skos:scopeNote "Metaalbewerkers die zijn gespecialiseerd in het werken met zilver, in het bijzonder in het maken van sieraden en tafelgerei. (AAT)"@nl;
