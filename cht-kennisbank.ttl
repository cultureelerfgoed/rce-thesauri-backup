<https://data.cultureelerfgoed.nl/term/id/cht/7aa69e00-3f41-4558-8d27-ca20886ad7a7>
  a skos:Concept;
  skos:prefLabel "Napoleon"@nl;
  skos:scopeNote "Polijstbare kalksteen uit het Carboon uit de omgeving van Ferques, Pas de Calais in Noord-Frankrijk. Lichtbruin-beige van kleur, sterk geaderd en gewolkt met witte vlekken. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b003b3b2-65d1-4aa7-bbe4-c035ae230c53>;
