<https://data.cultureelerfgoed.nl/term/id/cht/ec7909b3-7253-4b25-b04b-dbe7f837f85b>
  a skos:Concept;
  skos:prefLabel "koppelribben"@nl;
  skos:scopeNote "Koppelribben zijn verbindingsribben, kleine tussenribben van een veeldelig gewelf. Ze worden in het bijzonder toegepast bij stergewelven of netgewelven. (Haslinghuis)"@nl;
