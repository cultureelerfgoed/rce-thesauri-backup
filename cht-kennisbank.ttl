<https://data.cultureelerfgoed.nl/term/id/cht/5b76b9f8-76be-40c4-962e-8166eaaf4417>
  a skos:Concept;
  skos:prefLabel "lichtsterkte"@nl;
  skos:scopeNote "De lichtsterkte van een oppervlak is de lichtintensiteit die door het oppervlak wordt uitgezonden."@nl;
