  a skos:Concept;
  skos:prefLabel "Fuchtbauer graniet"@nl;
  skos:scopeNote "Fuchtbauer graniet is een robuuste granietsoort afkomstig uit de regio Fuchtbauer, veel gebruikt in bouwconstructies vanwege zijn duurzaamheid."@nl;
