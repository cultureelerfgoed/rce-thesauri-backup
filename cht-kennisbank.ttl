<https://data.cultureelerfgoed.nl/term/id/cht/c663230e-374e-4a7f-b9b8-c3314d563b4d>
  a skos:Concept;
  skos:prefLabel "stedenbouwkunde"@nl;
  skos:scopeNote "Te gebruiken voor het studiegebied dat tussen architectuur en planning valt en beide overlapt, waarin men zich vooral bezighoudt met het specifieke ontwerpen en de contekstuele integratie van bouwwerken en ruimten in de stad; omvat expertise in bijvoorbeeld landschapsarchitectuur, stadssociologie, milieupsychologie en rechten. (AAT-Ned)"@nl;
  skos:altLabel "stedenbouw"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/da33072d-ec78-44e6-aa5a-9ca956f9d2da>;
