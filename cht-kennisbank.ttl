  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/22da199c-fc79-411a-a104-89ab307b88c6>
  a skos:Concept;
  skos:prefLabel "pantserhouwitsers"@nl;
  skos:scopeNote "Een pantserhouwitser is een pantservoertuig dat uitgerust is met een krombaangeschut onder pantser. Het is een vorm van gemechaniseerde artillerie. Het kan een pantserwagen zijn of een rupsvoertuig. Het kan zowel een koepel hebben als een kazematopbouw. Het moet onderscheiden worden van zowel de tank als het gemechaniseerd geschut. (Wikipedia)"@nl;
  skos:altLabel "pantserhouwitser"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/11b95cce-c936-4de9-99bb-ec49cf73093e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3f55db56-1464-4af6-9739-5295ce8433a1>
  a skos:Concept;
  skos:prefLabel "infanteriegevechtsvoertuigen"@nl;
  skos:scopeNote "Een infanteriegevechtsvoertuig is een pantservoertuig dat speciaal ingericht is om meegenomen infanteristen de mogelijkheid te bieden via schietgaten vuur uit te brengen op de vijand. Een infanteriegevechtsvoertuig heeft daarnaast in feite haar eigen bewapening, meestal bestaand uit een lichtkaliber-kanon plus antitankwapens. (Wikipedia)"@nl;
  skos:altLabel "infanteriegevechtsvoertuig"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/11b95cce-c936-4de9-99bb-ec49cf73093e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/634a1dd8-5bb7-4a85-8651-5f9215173048>
  a skos:Concept;
  skos:prefLabel "gemechaniseerd geschut"@nl;
  skos:scopeNote "Een gemechaniseerd geschut is een rupsvoertuig zonder koepel dat voorzien is van een stuk vlakbaangeschut (kanon). Het moet dus onderscheiden worden van zowel de tank, die een 360° draaibare koepel bezit die voorzien is van een kanon, als de gemechaniseerde artillerie, die voorzien is van krombaangeschut (houwitser). (Wikipedia)"@nl;
  skos:altLabel "gemechaniseerde artillerie"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/11b95cce-c936-4de9-99bb-ec49cf73093e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8c27dcf5-bd6d-45b9-9d38-3151e28cc43f>
  a skos:Concept;
  skos:prefLabel "pantserwagens (militair)"@nl;
  skos:scopeNote "Een pantserwagen is een gepantserd militair wielvoertuig (dus zonder rupsbanden). De militaire pantserwagen dient onderscheiden te worden van de civiele pantserauto. (Wikipedia)"@nl;
  skos:altLabel "pantserwagen (militair)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/11b95cce-c936-4de9-99bb-ec49cf73093e>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/c64bc204-e71b-4b9f-a0b5-4911a46afd85>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/1ece9df2-2922-4877-b358-716c3f626f45>
  a skos:Concept;
  skos:prefLabel "stropers"@nl;
  skos:scopeNote "Stropers zijn jagers die op verboden terreinen jagen, m.n. die daarvan hun bestaan maken. Het woord heeft ook de betekenis van jagers die aan strooptochten deelnemen of daaraan deelnemen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "strooper"@nl, "stroopers"@nl, "stroper"@nl, "velddief"@nl, "velddieven"@nl,
    "wilddief"@nl, "wilddieven"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/11c19af6-272f-45db-afc7-78ff96cf1673>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/23896888-e649-476b-a6aa-9abccb663de5>
  a skos:Concept;
  skos:prefLabel "kagiedragers"@nl;
  skos:scopeNote "Kagiedragers zijn de valkeniersknechten die de kagies dragen. (Handboek der Nederlandsche taal / Jac. Van Ginneken s.j., Deel II)"@nl;
