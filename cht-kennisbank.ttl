<https://data.cultureelerfgoed.nl/term/id/cht/4b50ae9c-a6ac-46e6-afc9-dd291edb3368>
  a skos:Concept;
  skos:prefLabel "burchtpoorten"@nl;
  skos:scopeNote "Burchtpoorten zijn monumentale ingangen tot een burcht of kasteel, vaak versterkt en ontworpen om vijanden buiten te houden, en symboliseren de toegang tot een versterkte nederzetting."@nl;
