<https://data.cultureelerfgoed.nl/term/id/cht/183c7d70-3890-4a7a-be95-15896d822367>
  a skos:Concept;
  skos:prefLabel "boethuizen"@nl;
  skos:scopeNote "Boethuizen zijn huizen waarin door boetsters of boeters visnetten worden geboet. (Van Dale)"@nl;
