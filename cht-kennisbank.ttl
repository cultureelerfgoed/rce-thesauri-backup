<https://data.cultureelerfgoed.nl/term/id/cht/065cb812-60be-48d1-9bee-6e84f36f0c2f>
  a skos:Concept;
  skos:prefLabel "ijskasten"@nl;
  skos:scopeNote "IJskasten zijn kleine kasten voor het invriezen en opslaan van voedsel. Deze fabrieksmatig vervaardigde huishoudkasten werken op elektriciteit. De voorloper van de elektrische ijskast was een opslagkast waar bovenin los ijs voor koeling werd ingebracht. Dergelijke ijskasten hadden meer de functie van koelkast. (IJskelders, koeltechnieken van weleer / A.W. Reinink en J.G. Vermeulen, Nieuwkoop 1981)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eed628e6-2438-44c4-afa3-a83332aed561>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/5ff48b31-95de-4de9-94cb-f55e4756aed1>;
