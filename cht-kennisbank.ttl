  a skos:Concept;
  skos:prefLabel "koppelingsdrukgroepen"@nl;
  skos:scopeNote "Gladde, zware metalenschijf met drukveren en hefbomen, die de koppelingsplaat tegen het vliegwiel drukt."@nl;
