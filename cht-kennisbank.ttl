<https://data.cultureelerfgoed.nl/term/id/cht/9ddec464-2d25-4055-8d96-2463dafbe3a4>
  a skos:Concept;
  skos:prefLabel "loodpas"@nl;
  skos:scopeNote "Profiel-schietlood met horizontale bel-waterpas, van hout met koperen boven plaat. In lengten van 30, 50, 70 en 105 cm."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4695aefe-0a46-4c89-a933-2ae471d1f33a>;
