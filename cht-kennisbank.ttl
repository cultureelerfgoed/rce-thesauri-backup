<https://data.cultureelerfgoed.nl/term/id/cht/ebb508db-7084-4852-8a84-cfc69ba3d3ee>
  a skos:Concept;
  skos:prefLabel "ijspakhuizen"@nl;
  skos:scopeNote "IJspakhuizen zijn bovengrondse opslagplaatsen voor natuurijs. Deze pakhuizen liggen doorgaans bij grote meren waar ’s winters grote hoeveelheden ijs beschikbaar zijn. Kleine pakhuizen worden wel aangeduid als ijshokken. (IJskelders, koeltechnieken van weleer / A.W. Reinink en J.G. Vermeulen, Nieuwkoop 1981)"@nl;
  skos:altLabel "ijspakhuis"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/37ac1141-a23d-452e-b68e-5237775f8916>;
