<https://data.cultureelerfgoed.nl/term/id/cht/c82ea21d-fe65-4742-ba87-c528c830e430>
  a skos:Concept;
  skos:prefLabel "diktemeters"@nl;
  skos:scopeNote "Met een diktemeter wordt de dikte van metaalplaat gemeten."@nl;
  skos:altLabel "diktemeter"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/36963dcd-7f11-4902-8e8e-91eb92ad8ffd>;
