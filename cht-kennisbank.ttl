<https://data.cultureelerfgoed.nl/term/id/cht/bf02509e-7f16-4018-ba8b-d54a3b0d97ac>
  a skos:Concept;
  skos:prefLabel "hakkelbouten"@nl;
  skos:scopeNote "Bout met door inhakking verkregen buitenwaarts uitstekende doorns."@nl;
  skos:altLabel "hakkelbout"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c941876f-315f-4bf9-9cd4-4ee970578385>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e701b892-54d4-4e25-967d-eec9b51e3836>
  a skos:Concept;
  skos:prefLabel "tweelinghuizen"@nl;
  skos:scopeNote "Twee identieke huizen met gemeenschappelijke tussenmuur, die bouwkundig een eenheid vormen. Vaak lopen de balken door over beide huizen, op de tussenmuur lopen sleutelstukken of balkconsoles door, aan twee zijden voorzien van een profilering. Doorgaans zijn er twee afzonderlijke daken; of de onderste kapgebinten lopen door, met daarboven twee afzonderlijke spanten, gescheiden door een zakgoot. XV-XVII, voorn. in West-Nederland, ook b.v. in Blokzijl (O.). (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d648c14d-3493-4003-8aaa-11a7786f8c32>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b791bcd9-03c0-4655-a12c-e9e48b866c29>
  a skos:Concept;
  skos:prefLabel "stoeppalen"@nl;
  skos:scopeNote "Stoeppalen zijn stenen palen die de particuliere stoepen scheiden van de openbare weg. Doorgaans zijn deze palen van natuursteen, maar komen soms ook in ijzer en beton voor. Tussen de stoeppalen zijn vaak stangen of kettingen aangebracht. (Haslinghuis)"@nl;
  skos:altLabel "stoeppaal"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d0672d52-28d1-439e-9af1-9aa0a834b681>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b29fad0b-a491-4de7-961b-43baa9440f1b>
  a skos:Concept;
  skos:prefLabel "kantonpalen"@nl;
  skos:scopeNote "Kantonpalen zijn markeringspalen op wegen, die de scheiding van werkkringen aangaven voor rijkswegwerkers, destijds kantonniers genoemd. (Merkwaardige grenspalen en grensstenen / M.A. Aalbregtse, Oostburg 1974)"@nl;
  skos:altLabel "kantonpaal"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d0672d52-28d1-439e-9af1-9aa0a834b681>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fbce05c3-6c44-48b9-ae0a-4e2452486d13>
  a skos:Concept;
  skos:prefLabel "wensbomen"@nl;
  skos:scopeNote "Een boom die volgens het volksgeloof wensen kan doen uitkomen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7403e26d-cf33-4372-ad72-a2f9fcf8f63b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/1ad5a370-a49f-4abe-80f0-913b4b90b1c0>
  a skos:Concept;
  skos:prefLabel "kouddaken"@nl;
  skos:scopeNote "Kouddak is een dak waarbij de thermische isolatie zich onder de geventileerde draagconstructie is aangebracht. De waterkerende laag bevindt zich op de draagconstructie. De draagconstructie bevindt zich dus aan de koude zijde van de isolatie. (Bouwproducten / A. Blaazer, 2000)"@nl;
  skos:altLabel "kouddak"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/080607e6-0b45-4911-b9ee-7ff6e80be1ac>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/9bb23066-e5ed-4368-9548-05b8c3cc2b4d>
  a skos:Concept;
  skos:prefLabel "stoomgemalen"@nl;
  skos:scopeNote "In de loop van de 20st eeuw werden de meeste poldermolens vervangen door stoomgemalen. (Molenwoordenboek G.J. Pouw)"@nl;
  skos:altLabel "stoomgemaal"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/63e3cea6-22d0-4d8a-b79b-2b8c3d049587>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8d8f1278-2957-4e8d-8bc5-e7c973712b61>
  a skos:Concept;
  skos:prefLabel "artillerie schietkampen"@nl;
  skos:scopeNote "Artillerie schietkampen zijn militaire kampen voor het houden van schietoefeningen met zware vuurwapens. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "artillerie schietkamp"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b193549e-7463-4d6e-91aa-0b97d0810d6e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/1338838e-b660-4f73-a2af-0e39881ad72f>
  a skos:Concept;
  skos:prefLabel "midden paleolithicum"@nl;
  skos:scopeNote "Het midden-paleolithicum wordt gekenmerkt door het voorkomen van vuurstenen vuistbijlen en typische afslagen, spitsen en kernen gebaseerd op de Levallois techniek, ook bekend onder de naam Mousterien. In Nederland leefden in deze periode jagers-verzamelaars van het genus Homo Sapiens Neanderthalensis."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ddd129e3-a30f-425f-8fec-7d1b3dad8f6d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/cf6cdac8-2cc0-42b7-92ee-d15238790509>
  a skos:Concept;
  skos:prefLabel "poederblussers"@nl;
  skos:scopeNote "Poederblussers zijn brandblussers die bluspoeder gebruiken om verschillende soorten branden te blussen, inclusief branden van vaste stoffen, vloeistoffen en gassen. Ze vallen binnen de bredere categorie brandblussers."@nl;
  skos:altLabel "poederblusser"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ec4b4614-c303-4122-bd1e-c4267e9c8cfd>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/034acf09-be2e-450e-be9d-67c7d05852aa>
  a skos:Concept;
  skos:prefLabel "tongnaalden"@nl;
  skos:scopeNote "Naald met een schuine kant aan een dubbele deur. Zie tekening naald 5. Kan ook beweegbaar zijn, zoals toegepast aan schuifblinden om de kas in geopende toestand af te sluiten. (Haslinghuis)"@nl;
  skos:altLabel "tongnaald"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db29cecd-2d13-4fbe-8dc0-32eb435e5990>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ec8d5e94-4f49-4cd0-8062-6459cda3ba36>
  a skos:Concept;
  skos:prefLabel "toot"@nl;
  skos:scopeNote "Een toot is een scherpe punt tussen niet complete cirkels in het maaswerk van met name vensters. Dit is een kenmerkend element van de gotische architectuur. Toten komen voor in tootbogen, een tootboogfries, drielobben, driepassen, driebladen, vierpassen, vierbladen, veelpassen, visblazen en verschillende andere varianten.De gotische architectuur ontwikkelde zich in steeds sierlijkere vormen. Des te rijker de versieringen waren, hoe meer toten er in het maaswerk waren aangebracht."@nl;
  skos:altLabel "toten"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/8ac2d20a-46ae-451a-91fa-f0bbd3cad914>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/92b0f384-46e2-442a-927b-588ed2260323>
  a skos:Concept;
  skos:prefLabel "Danskers"@nl;
  skos:scopeNote "Toren, gebouwd als buitenverdedigingswerk naast de kastelen van de Duitse orde, b.v. in Thorn (Torun) en Marienwerder (Kwidzyn), nu in Polen gelegen. De toren is door een luchtbrug met het kasteel verbonden. Hij is bruikbaar als voorpost en uitkijktoren, ook als reduit, met een geheime ingang door een schacht in de muur. Daarbij ook gebruikt als latrine of gemaktoren ( gemak). Een dergelijke uitbouw had b.v. ook het Huis te Merwede bij Dordrecht. (Haslinghuis)"@nl;
  skos:altLabel "Dansker"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2ffb2c5-397c-47c9-bdb8-a655cd21326d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ff6354aa-1719-4a97-916c-af4c82b6d09b>
  a skos:Concept;
  skos:prefLabel "kuipplanten"@nl;
  skos:scopeNote "Kuipplanten zijn niet winterharde planten die in een houten kuip of eventueel grote pot zijn geplant en iedere winter in een vorstvrije ruimte, de oranjerie, worden geplaatst. Het houden van een collectie kuipplanten vormt een traditie op paleizen, buitenplaatsen en landgoederen. De beplanting kan bestaan uit bijvoorbeeld citrusbomen, laurier, Camellia of Agave. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "kuipplant"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2971af0-cde7-4888-b828-33443f702e7d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4d8303cb-e311-4794-876c-35fdb67ef098>
  a skos:Concept;
  skos:prefLabel "luchtboogstoelen"@nl;
  skos:scopeNote "Massieve opmetseling boven een steunbeer van een gotische kerk waarop de luchtbogen steunen. (Haslinghuis)"@nl;
  skos:altLabel "luchtboogstoel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4e481c81-319a-44da-86bf-106f145d22c1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ba55b5b4-0e1d-41bb-902c-e65a896f1b75>
  a skos:Concept;
  skos:prefLabel "zandheggen"@nl;
  skos:scopeNote "Aarden wal opgeworpen om landbouwgebieden en dorpen te beschermen tegen het stuivende zand. Door zandinvang door de begroeiing van bomen zijn de wallen vaak meters hoog geworden."@nl;
  skos:altLabel "zandgraven"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/40ffd2e2-e0d4-4ce0-8696-ba8fe5abb70d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a1c575a5-e7f3-47db-8037-190a3c58b3eb>
  a skos:Concept;
  skos:prefLabel "zelfopofferende anti-graffitisystemen"@nl;
  skos:scopeNote "Zelfopofferende systemen zijn reversibel, nauwelijks zichtbaar en dampdoorlatend. De graffiti wordt met anti-graffitilaag en al verwijderd. Dit wordt veelal gedaan met stoom. Vervolgens wordt een nieuwe anti-graffitilaag aangebracht."@nl;
  skos:altLabel "zelfopofferend anti-graffitisysteem"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5516d94a-9581-4896-9e8f-b998bbf4ebf8>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/759360ca-bfd6-4d39-9d6f-bf2f89a894c5>
  a skos:Concept;
  skos:prefLabel "dijkwoningen"@nl;
  skos:scopeNote "Dijkwoningen zijn woonhuizen of boerderijen die tegen en gedeeltelijk in een dijklichaam gebouwd zijn."@nl;
  skos:altLabel "dijkwoning"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/27a69fff-57b2-4d81-a8ae-9102d21d03e2>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/abc2adee-c464-4bca-b3b7-39a4d4784f0e>
  a skos:Concept;
  skos:prefLabel "haaghuizen"@nl;
  skos:scopeNote "Overdekte smalle open schuur met stellingen, waarin nog ongebakken, z.g. groene stenen kunnen drogen. (Haslinghuis)"@nl;
  skos:altLabel "haaghuis"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c8a9451e-9ee0-43ae-99b8-5066f8aab68b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/44e43c88-c673-4098-bda7-6551c83e6a1c>
  a skos:Concept;
  skos:prefLabel "rijksmonument"@nl;
  skos:scopeNote "Een rijksmonument is in Nederland een zaak (een bouwwerk of object, of het restant daarvan) die van algemeen belang is wegens de schoonheid, de betekenis voor de wetenschap of de cultuurhistorische waarde. Een formeel juistere aanduiding is: 'beschermd monument als bedoeld in de Erfgoedwet'. (Wikipedia)"@nl;
  skos:altLabel "rijksmonumenten"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1287327e-cb98-4a8f-b994-688eea50e08b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e5f9ae82-47a8-4c3d-9f81-e29612bb2400>
  a skos:Concept;
  skos:prefLabel "taberna's"@nl;
  skos:scopeNote "Romeinse winkel. (Haslinghuis)"@nl;
  skos:altLabel "taberna"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/10f47eb6-f1a9-465f-b8ab-8381925f039b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3e1cb79a-2244-4bdf-aa2c-4e821d56a2b1>
  a skos:Concept;
  skos:prefLabel "urinoirs"@nl;
  skos:scopeNote "Sanitair waarin urine wordt opgevangen en afgevoerd. (AAT-Ned)"@nl;
