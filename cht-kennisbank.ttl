<https://data.cultureelerfgoed.nl/term/id/cht/aa99a4d5-886d-4236-8a3e-7cfc04b7a5a6>
  a skos:Concept;
  skos:prefLabel "laagwad"@nl;
  skos:scopeNote "Het laagwad is het laagste deel van het wad waar de geulen meanderen en mosselbanken voorkomen. Het laagwad ligt beneden het niveau van gemiddeld laagwater en is dus voor het grootste deel permanent met water bedekt. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/52c8f813-6d5a-453c-ac0d-0b6d22c400ea>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/31024480-ea4e-475f-acf5-bc31d7a54a9e>
  a skos:Concept;
  skos:prefLabel "rijbanen"@nl;
  skos:scopeNote "Een rijbaan is een deel van de wegdoorsnede waarbinnen verkeer zonder fysieke obstakels te overwinnen kan wisselen van laterale positie. Een rijbaan kan uit een of meer rijstroken bestaan. (Wikipedia)"@nl;
  skos:altLabel "rijbaan"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/45a74ae2-8946-4fec-a6fb-e8cdefed17c6>;
