  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3c2de980-2550-41c8-90e0-e2078130cbdb>
  a skos:Concept;
  skos:prefLabel "locomotievenremises"@nl;
  skos:scopeNote "Wagenloodsen voor openbare (stads)vervoermiddelen, in het bijzonder voor treinen, bussen en tramwagens. (AAT)"@nl;
