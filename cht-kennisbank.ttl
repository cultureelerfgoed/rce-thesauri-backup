<https://data.cultureelerfgoed.nl/term/id/cht/f332423e-7650-4d5d-b836-c27c8f9b1bca>
  a skos:Concept;
  skos:prefLabel "artetische bronnen"@nl;
  skos:scopeNote "Artesische bronnen zijn bronnen waaruit het water spontaan naar boven komt door de hydrostatische druk op het water dat zich in een ondergronds bekken bevindt (Wikipedia)."@nl;
