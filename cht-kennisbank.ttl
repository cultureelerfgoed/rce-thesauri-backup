  a skos:Concept;
  skos:prefLabel "afsteken"@nl;
  skos:scopeNote "Uitstekend deel van het dak aan de bedrijfszijde van een Betuwse boerderij, waaronder men het hooi door een luik in de achtergevel naar binnen brengt. (Haslinghuis)"@nl;
