<https://data.cultureelerfgoed.nl/term/id/cht/c4b56223-ced3-4b68-896d-a29f4299dded>
  a skos:Concept;
  skos:prefLabel "pepermuntdoosjes"@nl;
  skos:scopeNote "Plat rond doosje om pepermuntjes in te bewaren."@nl;
  skos:altLabel "pepermuntdoosje"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/44872c69-2b39-4667-88a7-9500b45b65c9>;
