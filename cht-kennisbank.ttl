<https://data.cultureelerfgoed.nl/term/id/cht/a7b6f4e7-5424-4863-9cc3-1e0afdfff654>
  a skos:Concept;
  skos:prefLabel "pulpeten"@nl;
  skos:scopeNote "De pulpeten zijn leren zakjes in de ventielkast die ervoor zorgen dat de trekdraad luchtdicht door de bodem van de ventielkast naar de speelventielen kan worden geleid. Naastdeze leren zakjes worden soms ook nauwsluitende, met leer beklede, messingstrips toegepast, soms ook afdichtingschijfjes in lood bekleed met vilt. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "pulpeet"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cf51f60b-c1bb-4c17-b938-17e1dacb6e7c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a7cb2c38-1675-4e0e-97f7-f2f7b27b2bb4>
  a skos:Concept;
  skos:prefLabel "matteermiddel"@nl;
  skos:scopeNote "Een matteermiddel, is een middel dat wordt toegevoegd aan een bindmiddel om het minder glimmend of glanzend te maken als het is gedroogd."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/d8758ca9-f42c-435c-a05c-067ec289703b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a7cd7c3f-6e85-45f9-a8ab-2bf37da04396>
  a skos:Concept;
  skos:prefLabel "stekers (muziekinstrument)"@nl;
  skos:scopeNote "1° Verticaal onderdeel van de mechaniek, met een ronde, vierkante of zeshoekige doorsnede. De steker speelt een rol bij het overbrengen van de speelbeweging naar de toetsen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "steker"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cf51f60b-c1bb-4c17-b938-17e1dacb6e7c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a7d856d0-6dcc-4ea5-b737-0bed89da7510>
  a skos:Concept;
  skos:prefLabel "balansonderdelen"@nl;
  skos:scopeNote "Onderdelen van een balans (meetinstrument). (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "balansonderdeel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/3e9a5ba2-4b32-4074-a2c6-eaf292ad341c>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/1fd13fcd-c7f1-440b-bb3c-2f1ba88f7f4e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a826a01e-d0bc-43cd-9774-b016fca6f910>
  a skos:Concept;
  skos:prefLabel "gedenatureerd"@nl;
  skos:scopeNote "Een gedenatureerd organisch materiaal is zodanig veranderd en afgebroken dat het niet langer fysiologisch actief kan zijn."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a847d497-9ccd-4eea-8cf4-d9bef4ba9ca6>
  a skos:Concept;
  skos:prefLabel "lepidocrociet"@nl;
  skos:scopeNote "Het oranjegekleurde mineraal ijzer(III)oxy-hydroxide, lepidocrociet (γ-FeOOH), is een normaal product van ijzercorrosie. Het werd ook als pigment gebruikt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a85d72d7-8ba9-4696-8d6c-ac72598cbb6f>
  a skos:Concept;
  skos:prefLabel "kovcheg"@nl;
  skos:scopeNote "Een kovcheg is het uitgeholde of gebeeldhouwde middenveld van een icoon. De rand is dus hoger. (Conservation Dictionary)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/623e7274-a6cb-4133-b9b4-83f0db8d4f01>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a86e961a-141b-4e76-9716-f3ea2d024a15>
  a skos:Concept;
  skos:prefLabel "lunuladozen"@nl;
  skos:scopeNote "Doosje waarin de lunula met de geconsacreerde hostie voor de uitstalling in de monstrans wordt opgeborgen, wanneer deze niet in de monstrans is geplaatst. Is er sprake van een vaasvorm, dan wordt wel de term vasculum gebruikt. De lunuladoos wordt bewaard in het tabernakel."@nl;
  skos:altLabel "lunuladoos"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/44872c69-2b39-4667-88a7-9500b45b65c9>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a877cfbe-f5aa-4acc-be79-7e11d3d1e57c>
  a skos:Concept;
  skos:prefLabel "directfotografie"@nl;
  skos:scopeNote "Een directe foto is een op zilverbeeld of kleurstofdiffusie gebaseerd procédé, met een direct positief beeld, dat meteen na de belichting wordt ontwikkeld."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a87a2a53-4a6b-4c7d-8ade-f135e4e3ca7d>
  a skos:Concept;
  skos:prefLabel "uitgeklede toestand"@nl;
  skos:scopeNote "De uitgeklede toestand is een stadium in het conserveren van een schilderij. De oude retouches zijn verwijderd, leemtes zijn gekit, maar het inschilderen moet nog beginnen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c634927b-c12e-4095-93c0-15d6311e6457>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a881b787-f628-46f7-9f1e-3b451938c0bd>
  a skos:Concept;
  skos:prefLabel "gehalte"@nl;
  skos:scopeNote "Het gehalte is de relatieve hoeveelheid van iets ten opzichte van een totale kwantiteit."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/929f2b49-e558-4543-a710-41a893c3c5dd>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a8967774-790a-49f9-872f-bfc56b17d560>
  a skos:Concept;
  skos:prefLabel "koppelboren"@nl;
  skos:scopeNote "Koppelboren zijn boren waarmee kleine gaatjes (koppelgaatjes) door klompen werden geboord om ze per paar met touwtjes of ijzerdraad bijeen te kunnen binden."@nl;
  skos:altLabel "handboorkoppelboor"@nl, "handboren"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b3e6e73-95c2-4cb8-957a-8ad57d8946f9>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a8dc3e35-6f21-4004-b957-384ec504d24b>
  a skos:Concept;
  skos:prefLabel "telnik"@nl;
  skos:scopeNote "Telnik is een soort militaire kledij uit de late Oudheid of een korte militaire tuniek waarin soldaten op een icoon worden afgebeeld."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7b6aa962-9e1b-4be4-88ae-11e4b89dbc8b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a8fc43b3-ea1d-4528-b995-7acc20351b28>
  a skos:Concept;
  skos:prefLabel "metaalkleurstof"@nl;
  skos:scopeNote "Een metaalkleurstof is een synthetische beitskleurstof met een metaalatoom, dat de kleurstof aan de stof bindt. Er zijn twee types: 1:1 complexen die in zure kleurstofbaden worden gebruikt en 2:1 complexen die in vrijwel neutrale oplossingen worden toegepast. Metaalkleurstoffen worden gebruikt in het verven van wol, zijde en nylon."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a9002b3a-cc8e-438e-97db-2af94414247f>
  a skos:Concept;
  skos:prefLabel "Stabiltex"@nl;
  skos:scopeNote "Stabiltex is de oude naam voor Tetex."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/434aa0e9-f84e-4a35-a627-2a18a3379d3a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a92e9f38-9371-4408-88b2-5954f2cba8cb>
  a skos:Concept;
  skos:prefLabel "hertogdommen"@nl;
  skos:scopeNote "Een hertogdom was het gebied dat bestuurd werd door een hertog. De titel kwam oorspronkelijk vooral in het Frankische Rijk voor. De hertog (dux) oefende een provinciaal bestuur uit, direct onder de koning. Een hertogdom bestond oorspronkelijk uit een aantal graafschappen. In de Nieuwe Tijd werd de titel hertogdom verbonden aan een heerlijkheid met hoge rang, zonder soevereiniteit."@nl;
  skos:altLabel "hertogdom"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a7c9a04c-9d9f-4d7f-ac6d-a1666425909a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a9393e58-8ad9-4788-95ab-db835bb1aa78>
  a skos:Concept;
  skos:prefLabel "spiegels (bouwmateriaal)"@nl;
  skos:scopeNote "Spiegels zijn platen vlakglas die glas aan de achterzijde zijn voorzien van een reflecterende metaallaag. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/963156e3-7f49-4073-ab86-cea592518c26>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a9422de3-749b-470d-9ef6-bf81063bbe00>
  a skos:Concept;
  skos:prefLabel "dragers (kunst)"@nl;
  skos:scopeNote "Een drager is het onderliggende materiaal of de structuur die is gebruikt om een object fysieke stabiliteit te geven. Een drager is de materiële structuur waarop de grondering of de verf van een schilderij is aangebracht. Het kan een paneel zijn, een doek, een muur of enig ander vlak waarop een schilderij kan worden gemaakt. (Conservation Dictionary)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/623e7274-a6cb-4133-b9b4-83f0db8d4f01>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a9493884-f375-4497-b4c0-fe2e9572ea45>
  a skos:Concept;
  skos:prefLabel "roggestijfsel (tarwestijfsel)"@nl;
  skos:scopeNote "Rogge- of tarwestijfsel is een meer of minder viskeuze kleefstof die gemaakt wordt door kokend water over een mengsel van water en zetmeel te gieten en te roeren zonder verdere verwarming. Deze stijfsels bevatten gluten."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e4a18c83-8074-4d78-8a9c-b4c090a4d123>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a94ff38e-d836-4504-87b2-88be68f96ed3>
  a skos:Concept;
  skos:prefLabel "stroomisolatie"@nl;
  skos:scopeNote "Stroomisolatie is omhullend isolatiemateriaal toegepast bij elektriciteitsleidingen en aanverwante zaken. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "spanningsisolatie"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ad490831-5350-46ef-9ef2-642e58d6b696>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a957a623-b78e-4a2a-974a-91119123d894>
  a skos:Concept;
  skos:prefLabel "vaandelonderdelen"@nl;
  skos:scopeNote "Onderdelen van een vaandel. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "vaandelonderdeel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e52cbc47-b4ee-40f0-9034-cfed9775f402>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/de42d837-5e6d-429b-b533-a2af152ad184>,
    <https://data.cultureelerfgoed.nl/term/id/cht/5739eec1-80ef-4e98-9b9d-92debb469aa9>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a95ee0ec-14cf-4440-885d-5ddc010ac431>
  a skos:Concept;
  skos:prefLabel "koud email"@nl;
  skos:scopeNote "Koud email is een gepigmenteerd synthetisch bindmiddel voor het retoucheren van glas of ceramiek, dat niet verwarmd hoeft te worden om te drogen of uit te harden. Zie ook koud beschilderen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a98b8661-2939-4231-892a-f004157bb6ea>
  a skos:Concept;
  skos:prefLabel "chroomcassettes"@nl;
  skos:scopeNote "Een chroomcassette heeft een magnetische laag met chroomdioxide-poeder dat een betere weergave geeft dan ijzeroxide. Het wordt veel gebruikt bij het dupliceren van cassettes en ook bij sommige videocassettes. (Conservation Dictionary)"@nl;
  skos:altLabel "chroomcassette"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91712616-6dec-4871-8fdc-c317850c20d1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a9a028f8-e665-4ce4-a9ae-b4255ced22a1>
  a skos:Concept;
  skos:prefLabel "signaalbehandeling"@nl;
  skos:scopeNote "Signaalbehandeling is het bewerken van geluids- of beeldinformatie om ongewenste ruis te verwijderen of om geluidseffecten zoals galm toe te voegen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/36f5e5ab-2892-4a9f-9876-6ce595bdc501>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a9cb058d-514c-4901-9ef0-4baac8ee8893>
  a skos:Concept;
  skos:prefLabel "tacetten"@nl;
  skos:scopeNote "Tacet betekend letterlijk hij zwijgt, meestal een knop die is geplaatst zonder achterliggende mechaniek maar puur voor de symmetrie van het registerknoppen paneel. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "tacet"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cf51f60b-c1bb-4c17-b938-17e1dacb6e7c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a9e605f3-9e7b-44d3-b7c2-a1cda0face08>
  a skos:Concept;
  skos:prefLabel "beheerregimes"@nl;
  skos:scopeNote "Een verzameling van Rijksbrede normen en (beheer)regels voor het informatiebeheer."@nl;
  skos:altLabel "beheerregime"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/72cf2664-95be-48a7-86cd-ac8e220dbb99>;
