<https://data.cultureelerfgoed.nl/term/id/cht/be9d71a6-fafa-4608-8260-a13fe61bfc13>
  a skos:Concept;
  skos:prefLabel "bosschages"@nl;
  skos:scopeNote "Bosschages zijn kleine bossen of grote boomgroepen, vaak als onderdeel van de compositie in een groenaanleg. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "bosschage"@nl;
