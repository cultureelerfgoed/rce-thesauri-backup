  a skos:Concept;
  skos:prefLabel "arreteerkogels"@nl;
  skos:scopeNote "Een door een veer belaste kogel of pennetje, dat ingrijpt op een groef in de baladeurasje van een versnellingsbak om een ingeschakelde versnelling in de juiste stand te houden."@nl;
  skos:altLabel "arreteerkogel"@nl;
