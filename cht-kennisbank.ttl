  a skos:Concept;
  skos:prefLabel "voertuigbrand"@nl;
  skos:scopeNote "Voertuigbrand verwijst naar het fenomeen waarbij een voertuig in brand staat, waarbij specifieke brandbestrijdingsmethoden en -middelen worden ingezet om de brand te blussen. Dit valt onder de bredere categorie brandbestrijding."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9ab20125-cdf7-4f9c-b12c-a1b8ebfa03d9>;
