<https://data.cultureelerfgoed.nl/term/id/cht/99c027bb-7d17-47a1-98c6-eb0e5a1d7341>
  a skos:Concept;
  skos:prefLabel "schoorsteenhalzen"@nl;
  skos:scopeNote "Schoorsteenhalzen zijn de smalste delen van een schoorsteenpijp, tussen de samenkomst of samentrekking boven de haardstede en de eigenlijke schoorsteenpijp. Vaak op het punt waar de klep zich bevindt. (AAT-Ned)"@nl;
  skos:altLabel "schoorsteenhals"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/94fc1175-b052-4928-9877-03554fc9a74a>;
