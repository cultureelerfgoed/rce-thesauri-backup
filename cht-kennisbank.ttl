<https://data.cultureelerfgoed.nl/term/id/cht/7e95d102-4b89-412e-9e78-3e927d1fb526>
  a skos:Concept;
  skos:prefLabel "parkweiden"@nl;
  skos:scopeNote "Parkweiden zijn graslanden die onderdeel zijn van een ontworpen landschapspark en zo bijdragen aan het pittoresk effect en de plattelands-idylle. De parkweide kan worden begraasd of als hooiland worden beheerd. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "parkweide"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4e188c67-9c81-4381-8ab8-72019092215d>;
