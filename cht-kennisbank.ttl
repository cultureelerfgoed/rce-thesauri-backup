<https://data.cultureelerfgoed.nl/term/id/cht/5cbfccac-c41f-4313-92fb-35f943d4a024>
  a skos:Concept;
  skos:prefLabel "Koningin (titel)"@nl;
  skos:scopeNote "Een koningin is ófwel het vrouwelijke staatshoofd van een koninkrijk, ófwel de gemalin van de koning die die positie bekleedt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db4a7619-d236-4b14-8e79-b4a6e890f677>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ebb12a49-72b8-4fe3-bd19-56998c574c12>
  a skos:Concept;
  skos:prefLabel "armluchters"@nl;
  skos:scopeNote "Wandkandelaars of andere steunen, specifiek voor kaarsen en bedoeld om aan de muur te worden bevestigd. (AAT)"@nl;
  skos:altLabel "armluchter"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c54d75d4-df7d-4114-b50d-f0270df8a38a>;
