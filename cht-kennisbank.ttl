<https://data.cultureelerfgoed.nl/term/id/cht/c3842e6a-1b9a-444d-8dc1-f5f1676568ff>
  a skos:Concept;
  skos:prefLabel "kerfsnijder"@nl;
  skos:scopeNote "Kerfsnijders maken inkepingen of versieringen in houten of metalen oppervlakken. Zij werken met mes of guts voor ornament, identificatie of maatvoering."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db4a7619-d236-4b14-8e79-b4a6e890f677>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c69c3782-2d4d-432a-be12-0b36707a8bd3>
  a skos:Concept;
  skos:prefLabel "dozenfabrikanten"@nl;
  skos:scopeNote "Dozenfabrikanten maken verpakkingsdozen van karton, hout of metaal. Zij produceren standaard- of maatwerkdozen voor opslag en transport."@nl;
  skos:altLabel "dozenfabrikant"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db4a7619-d236-4b14-8e79-b4a6e890f677>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c9fc22bd-1388-4561-b433-682f9249de25>
  a skos:Concept;
  skos:prefLabel "theestoven"@nl;
  skos:scopeNote "Een theestoof is een kleine verhoging of houder, vaak van gietijzer, met ruimte voor een warmtebron onderin. Wordt gebruikt om een theepot warm te houden tijdens het serveren."@nl;
  skos:altLabel "theestoof"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/86fd1112-036e-4dc4-a246-cdbc6395cb41>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/cb702bc4-b216-4ebc-bad7-b91c273f0e8a>
  a skos:Concept;
  skos:prefLabel "patentkohieren"@nl;
  skos:scopeNote "Een kohier is een administratief stuk, dat diende ter optekening van de gegevens die aan de basis van een bepaalde belasting lagen."@nl;
  skos:altLabel "patentkohier"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9e422627-b366-4192-9001-7f7d2ac4e128>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ccb88119-cb34-40c4-b766-e39fb233030c>
  a skos:Concept;
  skos:prefLabel "breipendoppen"@nl;
  skos:scopeNote "Een breipendop is een afsluitdop die op het uiteinde van een breipen wordt geplaatst om te voorkomen dat steken van de pen glijden. Gemaakt van rubber, kunststof of kurk."@nl;
  skos:altLabel "breipendop"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a5d9a31e-2b2a-4690-b065-aa8dbb3d311c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d208d8a5-af25-439b-a6af-dba5ee5afd2c>
  a skos:Concept;
  skos:prefLabel "tafelschuiers"@nl;
  skos:scopeNote "Een tafelschuier is een handveger, vaak van haar of kunststof, bedoeld om kruimels van een tafel te vegen. Wordt vaak gebruikt in combinatie met een kruimellade of opvangblik."@nl;
  skos:altLabel "tafelschuier"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d65509d7-9312-4810-b564-b102f7269f8a>
  a skos:Concept;
  skos:prefLabel "wijnhandelaars"@nl;
  skos:scopeNote "Wijnhandelaars kopen en verkopen wijn. Ze bemiddelen tussen producenten en afnemers, proeven, selecteren en verhandelen wijnen voor horeca of consumenten."@nl;
  skos:altLabel "wijnhandelaar"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db4a7619-d236-4b14-8e79-b4a6e890f677>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/daa4b91a-238d-4d44-9a88-d83f8e940f13>
  a skos:Concept;
  skos:prefLabel "aardappelschalen"@nl;
  skos:scopeNote "Een aardappelschaal is een schaal waarin gekookte aardappelen worden geserveerd of warm gehouden. Gemaakt van aardewerk, porselein of glas, vaak als onderdeel van een servies."@nl;
  skos:altLabel "aardappelschaal"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ea11453f-a19b-4f5f-b98e-31bbe06d620b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/df8bdf7d-11fb-448a-be16-56d0e7718c31>
  a skos:Concept;
  skos:prefLabel "ziektekostenverzekeringen"@nl;
  skos:scopeNote "De ziektekostenverzekering is een verzekering die de meeste kosten van medisch advies, behandelingen, medicijnen, het gebruik van hulpmiddelen of andere voorzieningen op grond van een medische noodzaak vergoedt."@nl;
  skos:altLabel "ziektekostenverzekering"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bd41b809-2b5a-422e-bbdd-85a6bdd30039>;
