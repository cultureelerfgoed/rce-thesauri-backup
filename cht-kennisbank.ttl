<https://data.cultureelerfgoed.nl/term/id/cht/e37f5187-02db-4ae2-a45c-817042980a35>
  a skos:Concept;
  skos:prefLabel "vrieskamers"@nl;
  skos:scopeNote "Vrieskamers zijn koelkamers waarvan de gehele ruimten op een temperatuur onder het vriespunt wordt gehouden. De lage temperatuur wordt verzorgd door koelinstallaties. (WP Bouwkundige Encyclopedie 1965)"@nl;
  skos:altLabel "vrieskamer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5f973f74-2afb-4d34-96af-8bf888b93318>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/30892dbb-39a4-43c0-94a7-e0d9ce050532>
  a skos:Concept;
  skos:prefLabel "gortkuipjes"@nl;
  skos:scopeNote "(in Zaanse pelmolens) Een driewielig houten karretje waarin de gort door de molen werd getransporteerd. Het kon ongeveer 7 à 8 schepel gort of meel bevatten."@nl;
  skos:altLabel "gortkuipje"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/04770e4f-1c11-40e7-a256-9de8c6d569c6>;
