<https://data.cultureelerfgoed.nl/term/id/cht/36f8ac03-a4c6-4f84-9de8-09573c2a916d>
  a skos:Concept;
  skos:prefLabel "astronomie"@nl;
  skos:scopeNote "De wetenschap die zich bezighoudt met het materiële heelal voorbij de atmosfeer van de aarde. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/da33072d-ec78-44e6-aa5a-9ca956f9d2da>;
