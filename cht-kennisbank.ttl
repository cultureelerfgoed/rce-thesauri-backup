<https://data.cultureelerfgoed.nl/term/id/cht/3bc16f93-b56e-4b29-beaa-e71a32111ac7>
  a skos:Concept;
  skos:prefLabel "syters"@nl;
  skos:scopeNote "Kerkelijke schatkamer, archief, sacristie. In Nederland in Utrecht (Klaaskerk) en Woerden aangewezen. In Duitsland als ‘Zitter’ of ‘Sy(n)ter’ vermeld in Quedlinburg, Halberstadt, Maagdenburg. Oorspr. een verholen vertrek tussen twee muren, gewelfd en getralied. Vgl. tresorie. zeta. (Haslinghuis)"@nl;
  skos:altLabel "syter"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/740ab2ca-98ca-458f-a83d-24acfb1c75d3>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/50d7170d-e8e1-4275-a21a-fcf1f02464d8>
  a skos:Concept;
  skos:prefLabel "leshuizen"@nl;
  skos:scopeNote "Gebouw waarin kalk geblust wordt, behorend tot een kalkbranderij; blussen. (Haslinghuis)"@nl;
  skos:altLabel "leshuis"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a752382f-2254-4aba-b325-7d966c4c40f8>;
