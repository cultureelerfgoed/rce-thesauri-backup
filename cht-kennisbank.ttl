  a skos:Concept;
  skos:prefLabel "atlanten"@nl;
  skos:scopeNote "Mannelijke figuren, gewoonlijk (deels) naakt, die worden gebruikt als (schijnbaar) dragend element. Ze worden soms aangetroffen op meubilair vanaf de 16de eeuw. (AAT-Ned)"@nl;
