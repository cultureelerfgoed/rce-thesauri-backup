<https://data.cultureelerfgoed.nl/term/id/cht/0a335e7d-f667-4877-b2e4-c6316868a355>
  a skos:Concept;
  skos:prefLabel "streekeigen"@nl;
  skos:scopeNote "Tot de streek behorend."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/89ed94da-29b8-42cc-a5f4-444abc4255c5>;
