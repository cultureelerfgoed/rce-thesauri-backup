<https://data.cultureelerfgoed.nl/term/id/cht/e0b6c600-85ec-44cc-8ea2-4830950954ea>
  a skos:Concept;
  skos:prefLabel "orliëtblokken"@nl;
  skos:scopeNote "Blokken die in de 16e en begin 17e eeuw met een strop en een knevel aan beide kanten van het bramezelshoofd in een ezelsoor hingen en dienden voor het doorvoeren van de marstoppenanten die tevens als bramschoot dienden. (MARDOC)"@nl;
  skos:altLabel "orliëtblok"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/97c5763d-1e8f-45ba-a80c-16f6b520af8a>;
