<https://data.cultureelerfgoed.nl/term/id/cht/efe4bc03-c4f6-479a-92d2-5e9c7ad47b1c>
  a skos:Concept;
  skos:prefLabel "tweekleurenautotypieën"@nl;
  skos:scopeNote "Autotypieën in twee drukgangen en vanaf twee drukplaten gedrukt (ieder met een eigen rasterstand en iedere druk in een andere kleur). Deze tweekleurenautotypie werd ook wel 'duplex' genoemd. (Project Fotografie)"@nl;
  skos:altLabel "tweekleurenautotypie"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fd69bda4-88da-4b39-9ec0-b58e9645d6b7>;
