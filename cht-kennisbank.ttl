<https://data.cultureelerfgoed.nl/term/id/cht/df2f4f8a-a9f1-46f0-b802-28ac70dc2fc6>
  a skos:Concept;
  skos:prefLabel "onderpannen"@nl;
  skos:scopeNote "Onderpannen zijn machinaal vervaardigde dakpannen waarbij de golf aan de onderzijde is afgesloten om het inkijken te beletten."@nl;
