  a skos:Concept;
  skos:prefLabel "jukbenen"@nl;
  skos:scopeNote "Een jukbeen is een onderdeel van een jukspant. Het is een been van een juk. (Historische houtconstructies in Nederland / G. Behrends, 1996)"@nl;
