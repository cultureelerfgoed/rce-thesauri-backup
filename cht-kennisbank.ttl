  a skos:Concept;
  skos:prefLabel "boterspanen"@nl;
  skos:scopeNote "Een boterspaan is een houten spatel met een handgreep en schep en werd gebruikt om boter mee te scheppen. Boter werd pas vanaf de zestiende eeuw gegeten, daarvoor werd van boter zalf gemaakt. De ribbels op de schep zorgden ervoor dat de boter makkelijker van de spaan kwam en niet bleef kleven. (https://geschiedenislokaal023.nl/bronnen/boterspaan)"@nl;
