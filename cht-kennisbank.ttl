<https://data.cultureelerfgoed.nl/term/id/cht/d824cf90-3c33-4cff-9acd-a97b60c6701b>
  a skos:Concept;
  skos:prefLabel "rimoniemen"@nl;
  skos:scopeNote "Rimoniem (Rimon: Hebreeuws = granaatapppel) zijn zilveren siertorens die als versiering geplaatst worden op de atsee chajiem, de stokken waaraan het Sefer Tora bevestigd is. Deze zilveren voorwerpen worden rimoniem genoemd, als verwijzing naar de granaatappels die in de oudheid op de stokken geplaatst werden."@nl;
  skos:altLabel "siertoren"@nl, "siertorens"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/abfc1bb7-04d7-43a0-9e99-dd4c5a4f2c15>;
