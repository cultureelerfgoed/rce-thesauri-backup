<https://data.cultureelerfgoed.nl/term/id/cht/c5cb1505-4700-49b8-b46c-5e5f62caf6de>
  a skos:Concept;
  skos:prefLabel "varkensmesterijen"@nl;
  skos:scopeNote "Varkensmesterijen zijn bedrijven, werkplaatsen of fabrieken waarin het mesten van varkens als bedrijf wordt uitgeoefend."@nl;
  skos:altLabel "varkensmesterij"@nl;
