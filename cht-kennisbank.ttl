<https://data.cultureelerfgoed.nl/term/id/cht/5c4e19e7-a9ea-4e4e-96f9-b560d0e347a4>
  a skos:Concept;
  skos:prefLabel "ontzet"@nl;
  skos:scopeNote "Uit het verband geraakt, ingezakt, gescheurd (van een fundament, muur of pijler). (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
