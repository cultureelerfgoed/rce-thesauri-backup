<https://data.cultureelerfgoed.nl/term/id/cht/909cb049-e0be-4b8a-a23e-c0751a1d8751>
  a skos:Concept;
  skos:prefLabel "portierswoningen"@nl;
  skos:scopeNote "Portierswoningen zijn woningen bestemd voor portiers. Portierswoningen komen op verschillende soorten terreinen voor. Ze staan vrijwel altijd aan langs de ontsluitingsweg van het desbetreffende terrein in de buurt van de entree. Hierbij moet worden gedacht aan fabrieksterreinen, landgoederen, overheidsgebouwen en militaire terreinen."@nl;
  skos:altLabel "portierswoning"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/68a2ee6d-9205-424e-9540-43d27b6a483f>;
