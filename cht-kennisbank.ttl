<https://data.cultureelerfgoed.nl/term/id/cht/05799e5e-ba6a-4634-b05d-130697f71b1c>
  a skos:Concept;
  skos:prefLabel "opstuiken"@nl;
  skos:scopeNote "Opstuiken is het verdikken en verkorten van ijzeren stukken. Het is het tegenovergestelde van pletten."@nl;
  skos:altLabel "opgestuikt"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
