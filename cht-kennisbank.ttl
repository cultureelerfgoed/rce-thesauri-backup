<https://data.cultureelerfgoed.nl/term/id/cht/d0c89e84-334b-4733-8577-ba763cb220fd>
  a skos:Concept;
  skos:prefLabel "ferguson formula vierwielaandrijvingen"@nl;
  skos:scopeNote "Bij een Ferguson Formula vierwielaandrijving verdeelt het hoofddifferentieel het koppel over de voor- en achterwielen en staat deze toe in snelheid te verschillen."@nl;
  skos:altLabel "ferguson formula vierwielaandrijving"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e6c1c6ad-16ca-4cdc-b819-640c08f2cac4>;
