<https://data.cultureelerfgoed.nl/term/id/cht/e3805d9e-b07d-4cbf-b07e-23b49dc7b59a>
  a skos:Concept;
  skos:prefLabel "katoenfabrieken"@nl;
  skos:scopeNote "Installaties voor de verwerking van katoen en de vervaardiging van katoenen stoffen, met inbegrip van spin- en weefmachines. Dergelijke fabrieken floreerden vooral van 1775 tot 1930. (AAT)"@nl;
  skos:altLabel "katoenfabriek"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a752382f-2254-4aba-b325-7d966c4c40f8>;
