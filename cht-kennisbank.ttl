<https://data.cultureelerfgoed.nl/term/id/cht/df0043b6-b069-4adc-89c2-3d863d3b77e3>
  a skos:Concept;
  skos:prefLabel "parabolische bogen"@nl;
  skos:scopeNote "Parabolische bogen zijn bogen waarbij de boogdelen een stompe hoek met de rechtstanden vormen. Het zijn boogvormen die resulteren uit de constructie van bepaalde kruisgewelven. (Haslinghuis)"@nl;
  skos:altLabel "parabolische boog"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/42f94d21-f2a3-40e2-bf34-cc9e17ddaaaa>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/56e83b62-d9ea-4bea-a6de-3816a1209be0>
  a skos:Concept;
  skos:prefLabel "Ethafoam"@nl;
  skos:scopeNote "Ethafoam is een duurzaam en stevig schuim met een dichte celstructuur gemaakt van polyetheen. Het wordt gebruikt voor het maken van steunen voor driedimensionale voorwerpen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bf280a55-8b8c-432e-92ff-ab95115e4b39>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

