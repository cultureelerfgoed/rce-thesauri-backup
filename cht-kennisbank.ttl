  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f7275648-7473-48c8-a2bb-05eb29ffeded>
  a skos:Concept;
  skos:prefLabel "communiesluiers"@nl;
  skos:scopeNote "Sluier gedragen door de communicante tijdens de eerste of de plechtige communie. Vormt/vormde een set met een witte communiejurk."@nl;
  skos:altLabel "communiesluier"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5dec9aa2-5ced-4f77-b929-c043b90b2a8f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4cf2e196-0d70-4f5b-a9b8-19a1b45743a1>
  a skos:Concept;
  skos:prefLabel "vissersringen"@nl;
  skos:scopeNote "Vissersring is de pauselijke zegelring met een voorstelling van Petrus die een visnet ophaalt, en Paulus. (Van Dale)"@nl;
  skos:altLabel "vissersring"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c44b0e6b-d22e-42d1-97ca-8c0a0aa64065>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/856803e9-6e98-43c3-95d6-afffec3e1227>
  a skos:Concept;
  skos:prefLabel "tassen (gereedschap)"@nl;
  skos:scopeNote "Tassen zijn ijzeren aambeeld-hulpstukken met vierkante baan die in een opening in het bovenvlak van een aambeeld geplaatst kunnen worden, om meer verfijnd smeedwerk te verrichten."@nl;
  skos:altLabel "tas (gereedschap)"@nl;
