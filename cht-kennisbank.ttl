  a skos:Concept;
  skos:prefLabel "stormballen"@nl;
  skos:scopeNote "Bolvormige mand aan een mast of paal gehesen als waarschuwingsteken voor bijv. kustvaarders dat er een storm te verwachten is. ([vrij naar] Van Dale groot woordenboek, 13e uitg., 1999)"@nl,
