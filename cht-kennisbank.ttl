  a skos:Concept;
  skos:prefLabel "vlinderjachten"@nl;
  skos:scopeNote "Het vlinderjacht was een inzending van Johannes Olij uit Sneek voor een prijsvraag van het K.V.N.W.V., waarbij de deelnemers gevraagd werd een zeiljacht te ontwerpen met een zeiloppervlak van 12 m² (Fries Scheepvaartmuseum)"@nl;
