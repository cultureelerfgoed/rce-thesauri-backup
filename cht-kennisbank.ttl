<https://data.cultureelerfgoed.nl/term/id/cht/a7c9a04c-9d9f-4d7f-ac6d-a1666425909a>
  a skos:Concept;
  skos:prefLabel "heerlijkheden"@nl;
  skos:scopeNote "Te gebruiken voor het gehele landgoed van een edelman, vooral een feodaal edelman. (AAT-Ned)"@nl;
  skos:altLabel "heerlijkheid"@nl;
