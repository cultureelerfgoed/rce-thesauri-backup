<https://data.cultureelerfgoed.nl/term/id/cht/f1bb456d-8e91-4148-b22c-a5f91f65228c>
  a skos:Concept;
  skos:prefLabel "drukplaten (vervoer)"@nl;
  skos:scopeNote "Een door veren belaste ijzeren schijf, die de koppelingsplaat tegen het vliegwiel klemt, om de drijfkracht van de motor naar de versnellingsbak over te brengen."@nl;
  skos:altLabel "drukplaat (vervoer)"@nl;
