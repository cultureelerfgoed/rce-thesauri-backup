  a skos:Concept;
  skos:prefLabel "schoolgebouwen"@nl;
  skos:scopeNote "Gebouwen waarin scholen zijn ondergebracht, meestal lagere scholen, als zodanig ontworpen of aan dit doel aangepast. (AAT)"@nl,
