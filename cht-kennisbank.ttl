<https://data.cultureelerfgoed.nl/term/id/cht/6b13f118-f0d5-40ce-89b4-47065a8e5d00>
  a skos:Concept;
  skos:prefLabel "duiventillen"@nl;
  skos:scopeNote "Duiventillen zijn stenen of houten gebouwtjes, gebouwd op stenen of houten kolommen of aan een gebouw bevestigd, voor het houden van duiven. Ze zijn vaak mooi vorm gegeven, maar ze zijn doorgaans kleiner en lichter gebouwd dan duiventorens."@nl;
  skos:altLabel "duiventil"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/41ae98cd-0cc4-438a-8032-3c6ee1429b8d>;
