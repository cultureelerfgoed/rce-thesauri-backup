<https://data.cultureelerfgoed.nl/term/id/cht/dec813e6-88ad-40bb-9ed2-e3da0a2fbd5f>
  a skos:Concept;
  skos:prefLabel "steenrepen"@nl;
  skos:scopeNote "Dik touw waarmee de steen in een standerdmolen werd opgetakeld om te worden gebild."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/04770e4f-1c11-40e7-a256-9de8c6d569c6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a6675b2c-39c5-4b47-9051-0a889ce30c6f>
  a skos:Concept;
  skos:prefLabel "landschapstypen"@nl;
  skos:scopeNote "Landschapstypen zijn typen landschap met een specifieke, karakteristieke combinatie van landschapskenmerken en landschapselementen, die in een bepaalde samenhang voorkomen als gevolg van natuurlijke omstandigheden en het menselijk gebruik. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2971af0-cde7-4888-b828-33443f702e7d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ba0229a1-0750-4d24-91ed-638d1037d893>
  a skos:Concept;
  skos:prefLabel "eekschuren"@nl;
  skos:scopeNote "Eekschuren zijn schuren die gebruikt worden voor het drogen van eikenschors. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "eekschuur"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0498e646-25be-4d7f-abf3-6eadf9753117>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/97b172cb-63cf-4e48-a55b-9173cffe2ef2>
  a skos:Concept;
  skos:prefLabel "jachtkamers"@nl;
  skos:scopeNote "Jachtkamers zijn kamers in kastelen, jachthuizen etc. die ingericht zijn met jachttrofeeën en jachtattributen. Vaak zijn er ook opgezette dieren, foto's en prenten aanwezig . (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "jachtkamer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5f973f74-2afb-4d34-96af-8bf888b93318>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/0a5d10ab-59c0-4cc1-9209-b5d85996aa4a>
  a skos:Concept;
  skos:prefLabel "sportfondsenbaden"@nl;
  skos:scopeNote "Sportfondsenbaden zijn badinrichtingen die zijn gebouwd met behulp van fondsen, vaak gericht op het bevorderen van volksgezondheid en sport. Deze baden beschikken meestal over meerdere zwembaden, waaronder sport- en recreatiebaden, en worden vaak gecombineerd met andere sportfaciliteiten zoals gymzalen. Gebouwtypische kenmerken zijn grote zwemhallen, kleedruimtes, doucheruimtes, en tribunes voor toeschouwers. De architectuur is functioneel, met een nadruk op duurzaamheid en hygiëne. Sportfondsenbaden zijn vaak gemeentelijk eigendom en dienen een breed publiek."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e2d10203-8bb6-4f8a-a31b-ee337ce10fe3>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/36a08844-fcb2-4a68-8321-c65206906bd0>
  a skos:Concept;
  skos:prefLabel "sanidien"@nl;
  skos:scopeNote "Het mineraal sanidien is een kalium-natrium-aluminium-tectosilicaat met de chemische formule (K,Na)(Si,Al)4O8."@nl;
  skos:altLabel "sanidienkristal"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/699cbc4f-32d4-483d-b734-1d8399c89c18>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/9100eb62-da34-46c4-a591-836064064ad0>
  a skos:Concept;
  skos:prefLabel "jukspantonderdelen"@nl;
  skos:scopeNote "Onderdelen van een jukspant. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "jukspantonderdeel"@nl;
