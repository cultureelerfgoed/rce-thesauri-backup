  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/40ecda5e-2512-4344-891e-ed4d43c15e12>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/737d5688-1e83-4274-888c-92e6cfec443f>
  a skos:Concept;
  skos:prefLabel "primaire wikkelingen"@nl;
  skos:scopeNote "Deel van de bobine waar de laagspanningsstroom van de accu doorheen vloeit."@nl;
  skos:altLabel "primaire wikkeling"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/40ecda5e-2512-4344-891e-ed4d43c15e12>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c2d9d8e2-219a-4c48-95ec-a763f1246f07>
  a skos:Concept;
  skos:prefLabel "secundair circuits"@nl;
  skos:scopeNote "Hoogspanningsgedeelte aan een ontstekingsinstallatie. Omvat de secundaire wikkeling in de bobine, de verdeler, rotor en verdeelkap, de bougiekabels en de bougies."@nl;
  skos:altLabel "secundair circuit"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/40ecda5e-2512-4344-891e-ed4d43c15e12>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ff727efc-7af9-4ce6-9b04-669e205293f5>
  a skos:Concept;
  skos:prefLabel "bobinekabels"@nl;
  skos:scopeNote "Als de onderbrekerpunten in de stroomverdeler openen wordt de accustrrom door de primaire wikkeling uitgeschakeld en valt het magnetisch veld weg. Daardoor wordt een hoogspanning in de secundaire wikkeling van de bobine opgewekt. Deze stroom vloeit via de bobinekabel naar de centrale koolborstel in de verdelerkap en vervolgens via de rotor naar een van de contacten voor de bougies."@nl;
  skos:altLabel "bobinekabel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/40ecda5e-2512-4344-891e-ed4d43c15e12>;
