<https://data.cultureelerfgoed.nl/term/id/cht/c97b99ad-149c-4ba0-b656-f40dca008ef0>
  a skos:Concept;
  skos:prefLabel "katblokken"@nl;
  skos:scopeNote "Het onderste blok van een kattakel doorgaans een drieschijfsblok (voor lichtere takels een eenschijfs- tot tweeschijfsblok) dat aan het beslag een grote ijzeren haak draagt. (MARDOC)"@nl;
  skos:altLabel "katblok"@nl;
