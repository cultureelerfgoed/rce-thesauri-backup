  a skos:Concept;
  skos:prefLabel "veelhoekig verband"@nl;
  skos:scopeNote "Veelhoekig verband is een primitief onregelmatig metselverband waarbij polygonale blokken steen (m.n. basalt) op elkaar gestapeld worden. Dit wordt toegepast bij kademuren, landhoofden e.d.. (Haslinghuis)"@nl;
