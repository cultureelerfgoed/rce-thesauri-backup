<https://data.cultureelerfgoed.nl/term/id/cht/edbac143-7490-4fd5-b08c-8a378a340f55>
  a skos:Concept;
  skos:prefLabel "schoffeyen"@nl;
  skos:scopeNote "Schofheye, trekhei, houten stellage waarin een heiblok met behulp van haken aan een katrol was opgehangen. Als het toestel werkte, gleed het zware heiblok tussen de geleiders, het schoof op en neer. (Haslinghuis)"@nl;
  skos:altLabel "schoffeye"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
