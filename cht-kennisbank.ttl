  a skos:Concept;
  skos:prefLabel "koffiefilterpotten"@nl;
  skos:scopeNote "Koffiepotten met een opzetfilter of een mousseline zakje dat aan een uitneembare rand in de pot hangt, soms voorzien van een komfoor. (AAT-Ned)"@nl;
