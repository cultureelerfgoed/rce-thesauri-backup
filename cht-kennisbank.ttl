  a skos:Concept;
  skos:prefLabel "nuldimensionaal"@nl;
  skos:scopeNote "Nuldimensionaal of 0D is een voorstelling zonder dimensies: er bestaat geen lengte, breedte of hoogte. (Wikipedia)"@nl;
