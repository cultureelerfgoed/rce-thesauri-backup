<https://data.cultureelerfgoed.nl/term/id/cht/249180c7-853a-4d0b-a20e-6f912f13b4d2>
  a skos:Concept;
  skos:prefLabel "virginalen"@nl;
  skos:scopeNote "Klavecimbels, meestal rechthoekig, met 1 toetsenbord, waarbij de snaren in een rechte hoek tot de toetsen lopen. (AAT-Ned)"@nl;
  skos:altLabel "virginaal"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/79e86861-04cb-4eea-8026-8958469ecc29>;
