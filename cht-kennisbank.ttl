<https://data.cultureelerfgoed.nl/term/id/cht/8d92950f-f894-434e-b35f-36834138e508>
  a skos:Concept;
  skos:prefLabel "sefrein"@nl;
  skos:scopeNote "Afschuining van een lijst waar deze onder verstek bewerkt of omgestoken moet worden. Ook: severein, soeverein, soffrein, souverein. (Haslinghuis)"@nl;
