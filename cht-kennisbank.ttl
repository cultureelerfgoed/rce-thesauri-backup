    <https://data.cultureelerfgoed.nl/term/id/cht/3efed9ee-87a1-4a39-9720-511edf66a01b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d259bf03-9815-4f35-8334-d4b0a439e1bd>
  a skos:Concept;
  skos:prefLabel "raffia"@nl;
  skos:scopeNote "Stevige vezel van de bladstelen van de raffiapalm; wordt gebruikt om te weven, manden te vlechten en voor andere toepassingen. (Toegepaste Kunst Project, RKD)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d392ecd6-f402-4136-9dea-467467620f69>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d51c3e1d-4e67-49dd-99be-4710faaa7b74>
  a skos:Concept;
  skos:prefLabel "lapis lazuli"@nl;
  skos:scopeNote "Een korrelig, kristallijn gesteente dat voornamelijk bestaat uit lazuriet en calciet. Dit is een oude benaming voor de edelsteensoort lazuriet. (Toegepaste Kunst Project, RKD)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d39fdd23-2fca-43cd-8423-64203a76ab01>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/db17838c-5d6a-48b5-b865-930534761d2d>
  a skos:Concept;
  skos:prefLabel "azijnhout"@nl;
  skos:scopeNote "Van de wintergroenen of hulseik uit het Middelandse-zeegebied, voornamelijk uit Spanje en Griekenland. (Bouwmaterialen : encyclopaedische gids voor theorie en practijk / P.W. Scharroo, 3e herz. en verm. dr.)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/db9ab109-92ec-42f9-a093-ddda987fcc01>
  a skos:Concept;
  skos:prefLabel "lusters (druppel)"@nl;
  skos:scopeNote "Gladde of gefacetteerde hangende druppels, van glas of kristal, die in allerlei vormen gemaakt worden. Wordt vooral gebruikt om kroonluchters en kandelabers te versieren. Voor gelijksoortige druppels met een driehoekige vorm wordt 'prisma's' gebruikt. (Toegepaste Kunst Project, RKD)"@nl;
  skos:altLabel "luster (druppel)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/57f8835b-f52d-4165-a4dc-f73a128e8951>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f224a80a-5ef8-41cc-b9b5-ff800f2bba27>
  a skos:Concept;
  skos:prefLabel "ijzerdraad"@nl;
  skos:scopeNote "IJzerdraad is draad vervaardigd uit ongelegeerd staal met een koolstofgehalte van minder dan 0,25 %. Bij een koolstofgehalte van 0,25 tot 1,00 % is er sprake van staaldraad. (Wikipedia)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cc981024-18ee-4175-9310-1240671abd9f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f3be1b28-61ed-4447-87df-d5a9c70b224a>
  a skos:Concept;
  skos:prefLabel "bamboe"@nl;
  skos:scopeNote "Elk van de houtachtige of boomachtige tropische en semitropische grassen van het genus Bambusa, Phyllosyachys, Dendrocalamus en gerelateerde genera, met houtachtige, holle stengels en gesteelde bladeren. Bamboe bloeit pas na jaren groeien. De stam wordt gebruikt als bouwmateriaal en om meubels van te vervaardigen. (Toegepaste Kunst Project, RKD)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/02cb0c53-48f9-4975-964c-62ce8a3b72e0>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fac0cd3e-93dd-41ae-909c-80398ab53aab>
  a skos:Concept;
  skos:prefLabel "citroenhout"@nl;
  skos:scopeNote "Hout van de boom behorende tot de soort Calycophyllum candidissimum, inheems in Cuba, Mexico, Colombia en Venezuela. Het kernhout is niet duurzaam en varieert in kleur van lichtbruin tot licht geelachtig bruin. Het wordt gebruikt voor het maken van schietbogen, vishengels en handvatten voor gereedschap. (Toegepaste Kunst Project, RKD)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ff5732ad-83df-44be-87a2-915ea6ca38fa>
  a skos:Concept;
  skos:prefLabel "engobe"@nl;
  skos:scopeNote "Fijne klei die, wanneer gemengd met water, resulteert in een romige vloeistof; wordt gebruikt bij het gieten, glazuren, versieren en repareren van keramiek. In de oorspronkelijke staat is het flexibel genoeg om te kunnen worden gebruikt voor glazuren en versieren zonder de hulp van toevoegsels. Gebruik 'slibglazuur' voor keramisch glazuur met een hoog gehalte aan slib. (Toegepaste Kunst Project, RKD)"@nl;
  skos:altLabel "slibgoed"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cbf4bd02-8195-4157-a9ad-a2fb0c0c7ccc>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/99d4f437-e62f-42a4-b316-72fe8b1ca7a4>
  a skos:Concept;
  skos:prefLabel "privaatrechtelijke belemmering"@nl;
  skos:scopeNote "Een Privaatrechtelijke belemmering is een gedoogplicht ten behoeve van openbare werken die door het Rijk, de provincie of door een waterschap kan worden gevestigd op onroerende zaken."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f8b202ae-1359-488c-a357-f47b89f2b1c6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/5264eb15-6fb6-492b-bee6-5011fe7d3fb1>
  a skos:Concept;
  skos:prefLabel "buizenchassis"@nl;
  skos:scopeNote "Chassis opgebouwd uit aantal stalenbuizen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/8137260e-cf50-4c85-ac3a-4a457e803c4d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/5271668a-7616-4d3b-9f6a-593ad785845b>
  a skos:Concept;
  skos:prefLabel "sigarenpijpjes"@nl;
  skos:scopeNote "Holle, cilindervormige voorwerpen die worden gebruikt om een sigaar te houden terwijl deze wordt gerookt. (AAT-Ned)"@nl;
  skos:altLabel "sigarenpijpje"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/52767ca8-cdcb-4820-85df-fddc42f62ede>
  a skos:Concept;
  skos:prefLabel "paspoppen"@nl;
  skos:scopeNote "Driedimensionale voorstellingen van menselijke figuren om kledingstukken passend te maken of om kledingstukken te tonen. Gebruik 'fantomen' voor driedimensionale voorstellingen van het menselijk lichaam of delen daarvan gebruikt voor het onderwijzen van anatomie of het demonstreren of oefenen van medische handelingen. Gebruik 'ledenpoppen' voor driedimsionale voorstellingen van menselijke of dierlijke figuren met gewrichten die door kunstenaars worden gebruikt. (AAT-Ned)"@nl;
  skos:altLabel "paspop"@nl;
