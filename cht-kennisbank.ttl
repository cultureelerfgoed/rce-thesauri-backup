<https://data.cultureelerfgoed.nl/term/id/cht/70b2da84-0d06-438f-a809-5d76078d4fa4>
  a skos:Concept;
  skos:prefLabel "dakbedekking"@nl;
  skos:scopeNote "Dakbedekkingen zijn materialen en constructies waarmee een dak is afgedekt om te voorkomen dat er water binnen kan komen. Een dakbedekking kan zijn van plantaardig materiaal (riet, stro, houten spanen), gebakken materiaal (dakpannen en -tegels), leien, metaalplaten (lood, koper, zink), bitumineus materiaal of kunststof. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a0acd078-be4a-480b-801a-7b875b234b38>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/1b152bba-8b3e-4b2e-a1a7-275f0695acc6>,
