<https://data.cultureelerfgoed.nl/term/id/cht/fdf1da1d-cfa4-4587-b031-91f500fe8855>
  a skos:Concept;
  skos:prefLabel "twee-staps-verlijming"@nl;
  skos:scopeNote "Twee-staps-verlijming is een techniek voor het herstel van gebarsten ceramiek. De vervormde delen worden onder druk passend gemaakt en vervolgens in de goede volgorde verlijmd."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
