<https://data.cultureelerfgoed.nl/term/id/cht/00e1e9f5-2cef-4378-8d04-3efa7c79429b>
  a skos:Concept;
  skos:prefLabel "platenhoezen"@nl;
  skos:scopeNote "Beschermende envelopachtige houders voor grammofoonplaten, meestal van zwaar papier of karton, waarop vaak afbeeldingen en infoRMtie met betrekking tot de plaat staat afgedrukt. (Project Fotografie)"@nl;
