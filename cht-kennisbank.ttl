    <https://data.cultureelerfgoed.nl/term/id/cht/e7776571-fa43-49be-b28a-0033486cce12>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/19ee028f-0fc1-4e82-a176-56a8032347c8>
  a skos:Concept;
  skos:prefLabel "insectenvallen"@nl;
  skos:scopeNote "Een insectenval is een kleine doos waarin insecten worden gevangen om de aard en de ernst van de plaag te bepalen. De val is gewoonlijk gemaakt van plakkerig karton, waaraan het insect vastkleeft en kan voorzien zijn van een lokmiddel zoals een feromoon, of van een vergif. (Conservation Dictionary)"@nl;
  skos:altLabel "insectenval"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/056e0eda-d35f-4cd0-b4f8-390deac9e53a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/1a5a3b4f-10cc-496c-ba64-810acf4b1651>
  a skos:Concept;
  skos:prefLabel "verontreinigen"@nl;
  skos:scopeNote "Verontreinigen is het aanbrengen van een verontreinigende stof in of aan een voorwerp of een monster."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/1a8da8af-db0d-4475-8a98-6447dcef2beb>
  a skos:Concept;
  skos:prefLabel "concentratie-polarisatie"@nl;
  skos:scopeNote "Concentratie-polarisatie is polarisatie in een galvanische cel die wordt veroorzaakt door veranderingen in de concentratie van ionen bij de elektrodes door de steeds doorgaande elektrochemische reactie in de cel."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/1a9187ab-647e-4c5d-a85b-ebda73024181>
  a skos:Concept;
  skos:prefLabel "Hongaars"@nl;
  skos:scopeNote "Het Hongaars (magyar, magyarul, magyar nyelv) is de officiële taal van Hongarije en daarnaast de taal van de Hongaarse minderheden in de omringende landen. De taal heeft nu in totaal ongeveer 14,5 miljoen sprekers, waarvan 9,9 miljoen in Hongarije. Het is daarmee de op één (het Turks) na grootste taal in Europa die niet tot de Indo-Europese talen behoort."@nl;
  skos:altLabel "Hongaarse"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ba8a0df0-e7c1-48f4-ab90-dfde6c264f0e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/1aa0b09c-439c-469e-ac5a-1ae980652813>
  a skos:Concept;
  skos:prefLabel "classificaties"@nl;
  skos:scopeNote "Systematische identificatie en ordening van bedrijfsprocessen, activiteiten en/of informatie in categorieën overeenkomstig logisch gestructureerde conventies, methoden en procedureregels weergegeven in een classificatiesysteem."@nl;
  skos:altLabel "classificatie"@nl, "classificatiesysteem"@nl, "classificatiesystemen"@nl;
