<https://data.cultureelerfgoed.nl/term/id/cht/aacf2afe-be61-4e54-880f-dd136038a143>
  a skos:Concept;
  skos:prefLabel "rietheuvels"@nl;
  skos:scopeNote "Een rietheuvel is een buitendijks gelegen heuveltje. Het wordt gebruikt voor de opslag van riet, totdat het aan het einde van het snijseizoen naar de vaste wal werd getransporteerd. Op de heuvels werden ook wel tijdelijke eenvoudige onderkomens neergezet voor rietsnijders."@nl;
  skos:altLabel "rietheuvel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2971af0-cde7-4888-b828-33443f702e7d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b5b6f160-daec-4a9c-8da8-57bba80ad2dd>
