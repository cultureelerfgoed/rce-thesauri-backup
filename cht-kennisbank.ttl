<https://data.cultureelerfgoed.nl/term/id/cht/71e1af4e-5f1d-412a-a659-a8304b5fbedd>
  a skos:Concept;
  skos:prefLabel "PVC banden"@nl;
  skos:scopeNote "PVC band (polyvinylchloride) is een magnetische geluidsband gemaakt van PVC met weekmakers. Deze bandsoort wordt veel gebruikt door radiotechnici omdat zij sterker is dan acetaatband. (Conservation Dictionary)"@nl;
  skos:altLabel "PVC band"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/088271ca-0c1d-43b3-bcf8-36d2b1d38dfa>;
