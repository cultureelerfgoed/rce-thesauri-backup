  skos:scopeNote "Nis in metselwerk, voorn. om materiaal te sparen, maar ook als accentuering van de gevelindeling. (Haslinghuis)"@nl;
  skos:altLabel "spaarnis"@nl, "spaarveld"@nl, "spaarvelden"@nl;
