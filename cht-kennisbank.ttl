  a skos:Concept;
  skos:prefLabel "Dutchmannen"@nl;
  skos:scopeNote "Dutchmannen zijn een soort drijfborden, in de vorm van ronde houten kloppers met een lengte van ca. 55 cm, gebruikt bij het aandrijven van de killen. (Deze drijfborden werden praktisch alleen in Engeland gebruikt) (Het weke dak: riet- en strobedekkingen / , RV bijdrage 11, Zeist 1990)"@nl;
  skos:altLabel "Dutchman"@nl;
