  a skos:Concept;
  skos:prefLabel "kabelremmen"@nl;
  skos:scopeNote "Remmen die met kabels worden bediend, in tegenstelling tot remstangen of hydraulische druk. De meeste handremmen worden door middel van kabels bediend."@nl;
