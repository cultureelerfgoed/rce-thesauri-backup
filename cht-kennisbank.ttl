<https://data.cultureelerfgoed.nl/term/id/cht/808f8f02-aad0-470a-af4e-b48efe52dc57>
  a skos:Concept;
  skos:prefLabel "stadskantoren"@nl;
  skos:scopeNote "Stadskantoren zijn gebouwen waar diensten van het stadsbestuur gevestigd zijn."@nl;
  skos:altLabel "stadskantoor"@nl;
