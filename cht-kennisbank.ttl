<https://data.cultureelerfgoed.nl/term/id/cht/3c1cb869-580f-4c20-a8ce-0d07f62cc23d>
  a skos:Concept;
  skos:prefLabel "spiegelgewelven"@nl;
  skos:scopeNote "Spiegelgewelven zijn ribloze gewelven waarbij het bovenste deel als het ware is afgesneden en er een vlak middendeel is. Het spiegelgewelf ontstaat als men een tongewelf of kloostergewelf laat snijden door een horizontaal vlak. Dat dekt dan de welving als spiegel af. Als het vlak flauw gebogen wordt, kan het gemetseld worden, anders wordt het een schijngewelf in hout of stuc. (Haslinghuis)"@nl;
  skos:altLabel "spiegelgewelf"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/02e2289e-bbb7-4233-9e02-fd95935f4e28>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b53b64a8-bf29-4d4c-b138-d934da644d71>
  a skos:Concept;
  skos:prefLabel "spilkalven (koningsspil)"@nl;
  skos:scopeNote "Zware horizontale lagerbalk waarin de taats van de koningsspil wordt gelagerd."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/650ab4b1-e8ab-4c49-9195-8401d4a6cd6e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/bca1ae53-cd6d-47a4-97dd-cf3587abb28d>
  a skos:Concept;
  skos:prefLabel "waaierijen"@nl;
  skos:scopeNote "In pelmolens, inrichting waarin het eerste afpelsel van de gerst voornamelijk doppen - werd uitgewaaid."@nl;
  skos:altLabel "waaierij"@nl, "waaierijkast"@nl;
