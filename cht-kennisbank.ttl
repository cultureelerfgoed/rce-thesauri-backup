<https://data.cultureelerfgoed.nl/term/id/cht/4ff6f25a-460f-4c97-9775-806fef653499>
  a skos:Concept;
  skos:prefLabel "porseleinfotografie"@nl;
  skos:scopeNote "Porseleinfotografie is een vorm van fotokeramiek waarvoor vaak dure technieken zoals de substitutiemanier en een kooldrukvariant met speciaal voor fotokeramiek en fotoporselein ontworpen pigmentpapier toegepast. (Project Fotografie)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cf4b499a-36f0-45b7-8200-9b6a2a988f7d>;
