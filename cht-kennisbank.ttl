<https://data.cultureelerfgoed.nl/term/id/cht/5a7e4e0e-5952-4250-84c0-0ca1e39373c7>
  a skos:Concept;
  skos:prefLabel "leien van Fumay"@nl;
  skos:scopeNote "Leien van Fumay zijn leien die zijn gewonnen in de omgeving van Fumay (Frankrijk) aan de Maas. Ze kleuren meestal paarsrood of groen. De laatste groeven in Fumay zijn in 1971 gesloten. (Haslinghuis)"@nl;
  skos:altLabel "lei van Fumay"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bc50e54d-2c3e-4b8e-8b4f-ab865b297b08>;
