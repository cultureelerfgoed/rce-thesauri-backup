  a skos:Concept;
  skos:prefLabel "schutsluizen met spaarkommen"@nl;
  skos:scopeNote "Een schutsluis met spaarkomen is een sluis die het schutwater voor een gedeelte opvangt in spaarkommen of spaarbekkens."@nl;
