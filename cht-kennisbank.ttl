  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8871ffe4-9de3-489a-8a9b-ea917ea9bd2e>
  a skos:Concept;
  skos:prefLabel "wiskunde"@nl;
  skos:scopeNote "Wetenschap van cijfers, grootheden, in symbolen uitgedrukte kwantiteiten, vormen en figuren, inclusief de verhoudingen daartussen en bewerkingen die ermee worden uitgevoerd. (AAT)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/da33072d-ec78-44e6-aa5a-9ca956f9d2da>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/7413952e-3351-4235-8472-19bbefd30a5b>;
