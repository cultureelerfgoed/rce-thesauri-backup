  a skos:Concept;
  skos:prefLabel "kajuitzeiljachten"@nl;
  skos:scopeNote "Motorsloepen met een hoge, van ramen voorziene kajuit die bijna een meter boven de romp kan uitsteken en genoeg ruimte biedt om rechtop te staan. (AAT)"@nl;
