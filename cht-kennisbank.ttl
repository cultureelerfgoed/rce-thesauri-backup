<https://data.cultureelerfgoed.nl/term/id/cht/0962a152-dbd0-41e0-a1c5-4574cd6c8025>
  a skos:Concept;
  skos:prefLabel "putgalgen"@nl;
  skos:scopeNote "Putgalgen zijn hulpmiddelen om emmers water uit een put te tillen, bestaande uit een paal met gaffel met daarop rustende zengel of boom die aan het ene einde een puthaak en aan het andere einde een tegenwicht heeft."@nl;
  skos:altLabel "putgalg"@nl, "putsteiger"@nl, "putsteigers"@nl;
