<https://data.cultureelerfgoed.nl/term/id/cht/b2adca31-651a-467d-8706-3fc8862bc89b>
  a skos:Concept;
  skos:prefLabel "pootstijlen"@nl;
  skos:scopeNote "Schuinstaande stijl van een pootgebint. (Haslinghuis)"@nl;
  skos:altLabel "pootstijl"@nl;
