<https://data.cultureelerfgoed.nl/term/id/cht/a076886d-6b66-4a17-91e0-8fe381cb1283>
  a skos:Concept;
  skos:prefLabel "paardenrenbanen"@nl;
  skos:scopeNote "Paardenrenbanen zijn locaties waar verschillende soorten racewedstrijden met getrainde paarden worden gehouden."@nl;
