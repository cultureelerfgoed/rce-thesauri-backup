<https://data.cultureelerfgoed.nl/term/id/cht/49a75eff-481a-40e9-ac62-657a2108a84e>
  a skos:Concept;
  skos:prefLabel "uitlaatpijpen"@nl;
  skos:scopeNote "Via een uitlaatpijp en knaldemper(s) worden de uitlaatgassen afgevoerd richting buitenlucht."@nl;
