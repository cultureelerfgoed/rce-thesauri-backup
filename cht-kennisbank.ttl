  a skos:Concept;
  skos:prefLabel "trapkokers"@nl;
  skos:scopeNote "Trapkokers zijn cilindervormige of rechthoekige ruimten waarin de trappen van een huis zijn gebouwd. Zij zijn minder ruim dan trappenhuizen."@nl;
