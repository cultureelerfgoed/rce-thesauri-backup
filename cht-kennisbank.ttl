<https://data.cultureelerfgoed.nl/term/id/cht/4352143e-15ef-450a-bd00-8c8196409af4>
  a skos:Concept;
  skos:prefLabel "kuilstenen"@nl;
  skos:scopeNote "Kuilstenen worden gebruikt bij de visvangst: kuilnetten zijn trechtervormige netten met een brede opening. Schepen trokken ze door het water. Om een kuilnet op de juiste diepte te houden- verzwaarden de vissers hun netten. Vaak gebruiken ze zwerfkeien of stenen(bron: Maritiem Digitaal)"@nl;
  skos:altLabel "kuilsteen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
