<https://data.cultureelerfgoed.nl/term/id/cht/0bb90570-18c2-4acc-9cb0-e064b726f2bf>
  a skos:Concept;
  skos:prefLabel "watertorenreservoirs"@nl;
  skos:scopeNote "Watertorenreservoirs bevatten een buffervoorraad water. Vanuit het reservoir wordt het water transporteren leidingen het water naar het verzorgingsgebied zoals woonhuizen of fabrieken. (Een toekomst voor watertorens, p. 54)"@nl;
  skos:altLabel "watertorenreservoir"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b3330446-f4d3-4e0c-8b9d-1dd8d2259419>;
