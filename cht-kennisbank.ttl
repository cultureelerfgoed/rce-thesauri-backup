<https://data.cultureelerfgoed.nl/term/id/cht/0806e989-fc62-4e1d-9e7b-d1b14df164a7>
  a skos:Concept;
  skos:prefLabel "tandradspoorwegen"@nl;
  skos:scopeNote "Een tandradspoorweg is een spoorweg met een extra rail in het midden met de vorm van een tandheugel. (Wikipedia)"@nl;
