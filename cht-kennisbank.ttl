  a skos:Concept;
  skos:prefLabel "vellen"@nl;
  skos:scopeNote "Er wordt een flexibel vel gelegd over een schilderij dat wordt behandeld op een lagedruktafel of een verwarmde vacuümtafel. Allerlei materialen worden gebruikt, maar meestal Melinex. (Conservation Dictionary)"@nl;
  skos:altLabel "vel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
