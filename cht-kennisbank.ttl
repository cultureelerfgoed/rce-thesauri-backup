<https://data.cultureelerfgoed.nl/term/id/cht/61a244ac-8613-4553-88cf-dd0896661503>
  a skos:Concept;
  skos:prefLabel "merbau"@nl;
  skos:scopeNote "Merbau is een houtsoort die wordt geleverd door bomen van het geslacht Intsia (familie Leguminosae), die van nature voorkomen in Zuidoost-Azië en op tropische eilanden van de Grote Oceaan. (Wikipedia)"@nl;
  skos:altLabel "merbauhout"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/648fa06d-d865-4deb-a3ff-b7e4f0d97a34>
  a skos:Concept;
  skos:prefLabel "kristal (glas)"@nl;
  skos:scopeNote "Fijngesneden glas met een hoge mate van doorzichtigheid en een hoog loodoxidegehalte (Toegepaste Kunst Project, RKD)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dcc2121b-8394-44f7-9664-86b109d079a4>;
