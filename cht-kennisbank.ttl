<https://data.cultureelerfgoed.nl/term/id/cht/626663d5-d293-4445-b0ec-4a6bf123ed85>
  a skos:Concept;
  skos:prefLabel "reeën"@nl;
  skos:scopeNote "Reeën (Capreolus) zijn een geslacht van kleine hertachtigen die voorkomen in Europa en het noorden van Azië. Er zijn twee soorten: het ree (Capreolus capreolus) uit Europa en het Siberische ree (Capreolus pygargus) uit Azië. (Wikipedia)"@nl;
  skos:altLabel "Capreolus"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c03aa38e-bd58-4b3f-8140-d61a8c65e71c>;
