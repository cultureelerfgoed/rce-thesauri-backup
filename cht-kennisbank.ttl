<https://data.cultureelerfgoed.nl/term/id/cht/c8eb4101-e935-4c70-b464-dbf56c1d3abb>
  a skos:Concept;
  skos:prefLabel "draaireepsblokken"@nl;
  skos:scopeNote "Dubbele blokken die aan de tamp van de draaireep vastzitten en het bovenblok vormen van de marse- en bramvaltalie waarmee de marseraas en de bramraas worden gehesen en gestreken. (MARDOC)"@nl;
  skos:altLabel "draaireepsblok"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/97c5763d-1e8f-45ba-a80c-16f6b520af8a>;
