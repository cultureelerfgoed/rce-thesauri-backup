<https://data.cultureelerfgoed.nl/term/id/cht/236cff6a-4f69-43c6-aa31-750f940f149b>
  a skos:Concept;
  skos:prefLabel "parlevinkers"@nl;
  skos:scopeNote "Kleine open boten die artikelen en levensmiddelen vervoeren om te verkopen aan schepen in de haven; nemen ook vuilnis mee aan land. (aatned.nl)"@nl;
  skos:altLabel "parlevinker"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e97ae78d-72f9-4332-bca2-b8e78ceb0fa1>;
