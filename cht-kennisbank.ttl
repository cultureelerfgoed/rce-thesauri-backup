<https://data.cultureelerfgoed.nl/term/id/cht/d421dbea-1169-45c6-8f7e-7572887f6e10>
  a skos:Concept;
  skos:prefLabel "mistlampen"@nl;
  skos:scopeNote "Lampen, die laag aan de voorzijde van de wagen worden gemonteerd. Geven brede- en van boven afgeplatte stralenbundels, die naar beneden moeten zijn gericht. Wettelijk voorgeschreven aantal: twee."@nl;
  skos:altLabel "mistlamp"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a56ec0aa-2ab9-4faf-81f2-a5516305dfeb>;
