<https://data.cultureelerfgoed.nl/term/id/cht/7c6048fc-abeb-4e3b-9e58-753a2a3f4a39>
  a skos:Concept;
  skos:prefLabel "sterrenbossen"@nl;
  skos:scopeNote "Sterrenbossen zijn bossen aangelegd in de zeventiende en achttiende eeuw voor hakhout, productie of de jacht. Het sterrenbos is kruisgewijs of diagonaalsgewijs doorsneden met lanen en werd ook gebruikt om in te wandelen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "sterrebossen"@nl, "sterrebos"@nl, "sterrenbos"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/17631bfa-4960-4bcb-a0dd-62bfd86b5bfe>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/50aa8760-61e7-4635-9060-1f191570b490>
  a skos:Concept;
  skos:prefLabel "zangkoren"@nl;
  skos:scopeNote "Ruimten in christelijke kerken, doorgaans tussen de altaarruimte of het heiligdom en het schip, gereserveerd voor koorzangers. Voor ruimten die de altaarruimte en het zangkoor, als dat aanwezig is, omvatten wordt 'koren' gebruikt. Voor verhoogde platforms van waar af een koor, vaak bestaand uit leken, zingt wordt 'koorgalerijen' gebruikt. (AAT)"@nl;
  skos:altLabel "koor (zang)"@nl, "koren (zang)"@nl, "zangkoor"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c04948ca-73fa-443d-b893-149802698f16>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/795b91da-10cc-4deb-8d5c-e7485b662c5a>
