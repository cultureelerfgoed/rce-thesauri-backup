<https://data.cultureelerfgoed.nl/term/id/cht/178337e4-0316-402f-bdea-8e360d66ef75>
  a skos:Concept;
  skos:prefLabel "kokerbijlen"@nl;
  skos:scopeNote "Holle bijl waarin houten steel werd geschacht, vaak voorzien van oor waaraan het bevestigingsmateriaal werd vastgezet, zodat de bijl was gezekerd (borg). Meest voorkomend bronzen bijltype (honderden exemplaren van bekend in Nederland). Naast geimporteerde exemplaren, duidelijke regionale groepen te onderscheiden. Brons (late bronstijd tot in de vroege ijzertijd) en ijzer (vroege ijzertijd). Van ijzer zijn maar een klein aantal kokerbijlen bekend. Heeft onder andere met slechtere bewaarmogelijkheden te maken. (ABR)"@nl;
  skos:altLabel "kokerbijl"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/62e02a4b-4af5-491f-a78f-e2b60621021e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3648aa62-51aa-41b6-8152-61c9caab7fce>
  a skos:Concept;
  skos:prefLabel "hongersnoden"@nl;
  skos:scopeNote "Nijpend gebrek aan voedsel in een gehele landstreek algemene schaarste van levensmiddelen. (MARDOC)"@nl;
  skos:altLabel "hongersnood"@nl;
