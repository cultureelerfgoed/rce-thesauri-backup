<https://data.cultureelerfgoed.nl/term/id/cht/58afdbfe-6f17-42ca-8edf-b9607d54f8e1>
  a skos:Concept;
  skos:prefLabel "huifopleggers"@nl;
  skos:scopeNote "Huifoplegger: Oplegger met vaste zeilenhuif, kan ook gebruikt worden voor zij- en dakbeladingen. Lengte van laadvloer 13,6 meter, hoogte 2,55 – 2,70 meter, breedte 2,55 meter"@nl;
  skos:altLabel "huifoplegger"@nl;
