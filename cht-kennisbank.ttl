<https://data.cultureelerfgoed.nl/term/id/cht/fce24add-b40b-40e0-8e3d-9dac490d1ca5>
  a skos:Concept;
  skos:prefLabel "halfspanten"@nl;
  skos:scopeNote "Spant dat bestaat uit een helft van een normaal spant."@nl;
  skos:altLabel "halfspant"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/77f91bd1-4367-448a-903c-da826fa40e88>;
