<https://data.cultureelerfgoed.nl/term/id/cht/128e20f8-586b-4c82-8c40-e6646b8587c9>
  a skos:Concept;
  skos:prefLabel "zwetend ijzer"@nl;
  skos:scopeNote "Zwetend ijzer is een verschijnsel dat duidt op actieve corrosie van archeologisch ijzer dat chloorconcentraties bevat."@nl;
