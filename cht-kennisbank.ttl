  a skos:Concept;
  skos:prefLabel "dobbers"@nl;
  skos:scopeNote "Houtje met twee even lange lijnen; aan de ene lijn zat een stuk baksteen, aan de andere lijn een haak met aas; hiermee werd gevist op paling."@nl;
  skos:altLabel "dobber"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/77f91bd1-4367-448a-903c-da826fa40e88>;
