<https://data.cultureelerfgoed.nl/term/id/cht/22acdc6b-e92d-43fd-8eba-ebb197981fb4>
  a skos:Concept;
  skos:prefLabel "doorgaande sporen"@nl;
  skos:scopeNote "Doorgaande sporen zijn sporen waarover de treinen en trams het station of remise binnenkomen en in dezelfde richting kunnen verlaten zonder te hoeven keren of van spoor te wisselen."@nl;
  skos:altLabel "doorgaande spoor"@nl;
