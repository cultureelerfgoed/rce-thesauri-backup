<https://data.cultureelerfgoed.nl/term/id/cht/2352943f-5ec6-4d0e-8bf2-b719f711c007>
  a skos:Concept;
  skos:prefLabel "rechtbanken"@nl;
  skos:scopeNote "Aantal personen dat wettig gezag heeft om alle zaken te horen en te beoordelen, of het nu gaat om militaire of kerkelijke zaken of zaken met betrekking tot het wettelijk recht of het gewoonterecht van het land. (AAT)"@nl;
  skos:altLabel "rechtbank"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7fb109dc-fc0b-471d-a0aa-c08426de142a>;
