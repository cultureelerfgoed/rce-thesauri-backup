<https://data.cultureelerfgoed.nl/term/id/cht/574a440a-dd4b-40bb-b929-67c6c92372e7>
  a skos:Concept;
  skos:prefLabel "duplicaatnegatieven"@nl;
  skos:scopeNote "Duplicaatnegatieven zijn kopieën van originele fotografische negatieven, vaak gemaakt voor archivering of om meerdere afdrukken te kunnen maken zonder het originele negatief te beschadigen."@nl;
  skos:altLabel "duplicaatnegatief"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/997d625e-f272-47cd-be0b-00e681876dde>;
