<https://data.cultureelerfgoed.nl/term/id/cht/fdf621a7-8d9c-4e63-ae80-a00899230fbe>
  a skos:Concept;
  skos:prefLabel "opliggende bindingen"@nl;
  skos:scopeNote "Een opliggende binding bestaat uit een touw waaraan de katernen van een boek genaaid worden. Bij een bekleed boek is de opliggende binding zichtbaar als ribben op de rug van het boek. (Conservation Dictionary)"@nl;
  skos:altLabel "opliggende binding"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cf6bc0f3-9144-4847-8578-4e2227470cdd>;
