  a skos:Concept;
  skos:prefLabel "corrosieproducten"@nl;
  skos:scopeNote "Een corrosieproduct is de stof die wordt gevormd als een materiaal reageert met water, zuurstof, elektrolyten of bacteriën."@nl;
