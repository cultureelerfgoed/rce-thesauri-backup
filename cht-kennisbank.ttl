  a skos:Concept;
  skos:prefLabel "smokkelen"@nl;
  skos:scopeNote "Verboden goederen of goederen waarvoor rechten betaald moeten worden heimelijk vervoeren, inzonderheid over de grens brengen, in- en uitvoeren. (MARDOC)"@nl,
