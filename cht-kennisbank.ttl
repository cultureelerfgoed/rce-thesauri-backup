<https://data.cultureelerfgoed.nl/term/id/cht/912e3668-0168-429c-ac0b-9573525374db>
  a skos:Concept;
  skos:prefLabel "walvissloepen"@nl;
  skos:scopeNote "Te gebruiken voor open, voor en achter gelijke roeiboten met een ronde bodem en meestal met een 7,5 tot 10,5 m breed zeil, die oorspronkelijk ontworpen zijn om walvissen te harpoeneren; staan vaak op grotere schepen maar kunnen ook vanaf de kust uitvaren en hun werk doen. (MARDOC)"@nl;
  skos:altLabel "whaleboat"@nl, "walvissloep"@nl;
