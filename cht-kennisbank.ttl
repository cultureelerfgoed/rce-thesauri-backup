<https://data.cultureelerfgoed.nl/term/id/cht/3dd2b43b-20bd-45cb-a018-ef1ef892ed4a>
  a skos:Concept;
  skos:prefLabel "geologie"@nl;
  skos:scopeNote "De wetenschap die zich bezighoudt met de fysische geschiedenis van de aarde, de stenen waar zij uit bestaat en de fysische veranderingen waar zij aan onderhevig is en is geweest. (AAT)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1b8bd4e8-d51c-4ae2-8c16-c56751e2c470>;
