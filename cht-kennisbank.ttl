<https://data.cultureelerfgoed.nl/term/id/cht/b516df94-2988-4424-974f-15e2019f8741>
  a skos:Concept;
  skos:prefLabel "nieuwsbrieven"@nl;
  skos:scopeNote "Rapporten in manuscriptvorm uit de 17e en 18e eeuw, die werden geproduceerd voor speciale abonnees en die onregelmatig of wekelijks werden uitgegeven. In de 20e eeuw zijn het periodieke rapporten over de activiteiten van een bedrijf of organisatie. (AAT-Ned)"@nl;
  skos:altLabel "nieuwsbrief"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5ca2d7f5-2655-4122-9d9e-0cc10688d0e3>;
