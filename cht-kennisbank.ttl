<https://data.cultureelerfgoed.nl/term/id/cht/2aa76924-e968-4c7f-afc0-a245012c8c4d>
  a skos:Concept;
  skos:prefLabel "Vrije Evangelische Gemeente"@nl;
  skos:scopeNote "Vrije Evangelische Gemeente is een algemene term voor protestantse kerkelijke gemeenschappen die zich kenmerken door hun onafhankelijkheid, evangelische leer en vrijheid van liturgische en theologische dogma's. De gemeentes leggen de nadruk op een persoonlijke relatie met God en bijbelgetrouwheid."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1270db19-bfd0-4b46-abc2-6f44fe8c7f4c>;
