  a skos:Concept;
  skos:prefLabel "Engelse spanten"@nl;
  skos:scopeNote "Vakwerkspant met N-vormig patroon van wandstaven, bestaande uit verticalen met daartussen diagonalen. (Haslinghuis)"@nl;
  skos:altLabel "Engels spant"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c4da8b07-9847-4269-86a6-8da0ab1923f5>;
