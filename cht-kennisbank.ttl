<https://data.cultureelerfgoed.nl/term/id/cht/a197dab9-1d99-41fd-a460-b459e5a22824>
  a skos:Concept;
  skos:prefLabel "vleeszijde"@nl;
  skos:scopeNote "De vleeszijde van leer is de kant waar de huid aan het lichaam van het dier verbonden is geweest."@nl;
