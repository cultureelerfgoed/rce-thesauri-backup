<https://data.cultureelerfgoed.nl/term/id/cht/fcc18e62-6218-4940-b83d-2f86256b4cfb>
  a skos:Concept;
  skos:prefLabel "Iers zwart marmer"@nl;
  skos:scopeNote "Een compact marmer dat te vinden is in de graafschappen Galway en Kilkenny in Ierland en dat wordt beschouwd als een van de beste zwarte marmers. (AAT-Ned)"@nl;
