<https://data.cultureelerfgoed.nl/term/id/cht/81a1d303-eed2-427e-af9a-684cb2f7d09d>
  a skos:Concept;
  skos:prefLabel "ploegpuntbeschermers"@nl;
  skos:scopeNote "Plat ijzeren voorwerp met twee parallelle omgevouwen randen. Het snijdende onderdeel van ploegschaar. Eén exemplaar bekend, dateert uit de derde eeuw voor Chr. (Louwe Kooijmans et al. 2005: 616). (ABR)"@nl;
  skos:altLabel "ploegpuntbeschermer"@nl, "ploegschoen"@nl, "ploegschoenen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/beb84149-ddcd-42a4-b46c-b57b79826540>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a13d2a5b-d401-4626-95e5-484f79e80cfa>
  a skos:Concept;
  skos:prefLabel "keerploegen"@nl;
  skos:scopeNote "Landbouwwerktuig om de grond te keren. (ABR)"@nl, "De keerploeg was een belangrijke verbetering op landbouwgebied na de vele eeuwen lang gebruikte haakploeg. Een haakploeg woelt de grond slechts los terwijl de keerploeg de bodem opensnijdt en omkeert in de bij de vorige ploeggang gemaakte vore. (MARDOC)"@nl;
  skos:altLabel "keerploeg"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bc40d421-9c3e-4805-8352-55b3bbc510e5>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/ec2605e3-bf8c-4c24-b7a2-d2cce136e590>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f8ace691-8cd5-499e-83b1-c16fdef06f1c>
  a skos:Concept;
  skos:prefLabel "vetvangers"@nl;
  skos:scopeNote "Ondiepe houders van metaal om druipend braadvet op te vangen uit vlees dat geroosterd wordt. (AAT-Ned)"@nl;
  skos:altLabel "vetvanger"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
