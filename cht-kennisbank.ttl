<https://data.cultureelerfgoed.nl/term/id/cht/41ec87a6-4bd9-408c-baed-2acbffb29cf7>
  a skos:Concept;
  skos:prefLabel "ijsstadions"@nl;
  skos:scopeNote "IJsstadions zijn stadions voor de ijssport, zoals ijshockey, kunstrijden en schaatsenrijden. (Van Dale)"@nl;
