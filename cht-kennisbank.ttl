<https://data.cultureelerfgoed.nl/term/id/cht/528582f4-16e1-4b39-bfd0-6bdd4eb7fb33>
  a skos:Concept;
  skos:prefLabel "verbanden"@nl;
  skos:scopeNote "Verbanden zijn verbindingen, samenvoegingen tot een onwrikbaar geheel. Bij houtbouw ook wel enigszins minder vast. Het samenvoegen van stenen heet metselverband. (Haslinghuis)"@nl;
