<https://data.cultureelerfgoed.nl/term/id/cht/c3b39c24-01d7-4938-b7f0-187427c8a952>
  a skos:Concept;
  skos:prefLabel "radiostudio's"@nl;
  skos:scopeNote "Radiostudio’s zijn geluiddichte ruimtes vanwaaruit radio-uitzendingen plaatshebben. De ruimte is zodanig ingericht dat meerdere mensen tegelijkertijd radio kunnen maken. Hierbij wordt gebruik gemaakt van apparatuur als mengpanelen, computers en microfoons. (Rijksdienst voor het Cultureel Erfgoed/Van Dale)"@nl;
  skos:altLabel "radiostudio"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ff29918e-4505-4941-921b-543597c74c7d>;
