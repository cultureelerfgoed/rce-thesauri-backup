<https://data.cultureelerfgoed.nl/term/id/cht/f982cdc8-85d7-4a15-b641-db4bec010473>
  a skos:Concept;
  skos:prefLabel "stokprofielen"@nl;
  skos:scopeNote "Stokprofielen zijn doorgestoken profielen, gevormd door staven of kralen die elkaar bij de uiteinden snijden. Deze profielen zijn eigen aan de zeer late gotiek, plateresco- en Manuelstijl en komen voor in de omlijsting van vensters, ingangen e.d. (Haslinghuis)"@nl;
  skos:altLabel "doorgestoken profiel"@nl, "doorgestoken profielen"@nl, "stokprofiel"@nl;
