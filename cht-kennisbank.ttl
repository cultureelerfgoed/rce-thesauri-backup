<https://data.cultureelerfgoed.nl/term/id/cht/4a08e861-d570-43cc-9577-dbb9ad2b8a97>
  a skos:Concept;
  skos:prefLabel "vensterbanken (onderdorpel)"@nl;
  skos:scopeNote "Verbrede onderdorpel van een venster. vensterdampenant, gedeelte van een muur tussen twee vensters waarvan de hoogte groter is dan de breedte. (Haslinghuis)"@nl;
  skos:altLabel "vensterbank (onderdorpel)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/821a12c5-d8e8-406e-968a-262eaa768828>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/12ea5984-01ec-4eec-81a2-e9f19eb16dc7>
  a skos:Concept;
  skos:prefLabel "gordingen (koppeling)"@nl;
  skos:scopeNote "Koppeling van hout tussen twee stenen elementen, b.v. trekstang tussen twee kolommen. (Haslinghuis)"@nl;
  skos:altLabel "gording (koppeling)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4e481c81-319a-44da-86bf-106f145d22c1>;
