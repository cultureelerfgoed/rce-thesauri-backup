<https://data.cultureelerfgoed.nl/term/id/cht/f7f4e34a-1854-4894-ad4e-bd45fc8cfe0a>
  a skos:Concept;
  skos:prefLabel "theekommen"@nl;
  skos:scopeNote "Kopjes van handformaat zonder handvat om thee uit te drinken; soms met bijbehorend schoteltje. (AAT-Ned)"@nl;
