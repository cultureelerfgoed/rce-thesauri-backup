<https://data.cultureelerfgoed.nl/term/id/cht/bd35e798-2d2d-4fdd-a5d3-9bd7d1be327d>
  a skos:Concept;
  skos:prefLabel "vis (voeding)"@nl;
  skos:scopeNote "Vis als voedsel kan onderscheiden worden in zoutwatervis, zoetwatervis en trekvis. Deze kunnen vervolgens weer worden onderverdeeld in magere- en vette vis. Platvis en rondvis is een indeling naar vorm.Van de ongeveer 30.000 soorten vissen wordt een betrekkelijk klein aantal gevangen en bereid als voedsel. Andere zeedieren als kreeft, mosselen en inktvis worden ook wel als 'vis' aangeduid, hoewel deze dieren biologisch geen vissen zijn."@nl;
  skos:altLabel "Visdag"@nl, "Vrijdag visdag (dag)"@nl, "Visgerecht"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/231e97d9-93a7-470c-9213-80e2ff05de5f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/7fa4c2b6-1b81-48dd-99e8-e77cb2208d66>
  a skos:Concept;
  skos:prefLabel "trisponders"@nl;
  skos:scopeNote "Trisponders zijn automatische plaatsbepalingsystemen, die werken met radiogolven. (voorgrondradar) (Rijksdienst voor het Cultureel Erfgoed)"@nl;
