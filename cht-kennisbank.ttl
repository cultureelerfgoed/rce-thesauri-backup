<https://data.cultureelerfgoed.nl/term/id/cht/3b8a03ee-5f2a-4984-a253-7d35133300b5>
  a skos:Concept;
  skos:prefLabel "ecomuseums"@nl;
  skos:scopeNote "Een ecomuseum is een museum dat de plaatselijke omgeving als onderwerp heeft, zowel de in cultuur gebrachte als de natuurlijke omgeving. (Conservation Dictionary)"@nl,
    "Ecomusea zijn ontstaan in Frankrijk. De term \"eco\" is een verkorte vorm voor \"ecologie\", maar het verwijst vooral naar een nieuw idee van holistische interpretatie van cultureel erfgoed, in tegenstelling tot de nadruk op specifieke objecten, uitgevoerd door de traditionele musea.(wikipedia)"@nl;
  skos:altLabel "ecomusea"@nl, "ecomuseum"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2971af0-cde7-4888-b828-33443f702e7d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ddc25cd3-b4e4-42df-b553-bd077670c879>
  a skos:Concept;
  skos:prefLabel "Engels verband"@nl;
