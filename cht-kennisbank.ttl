<https://data.cultureelerfgoed.nl/term/id/cht/a30b8ebe-fb34-41ff-aa2f-b68c9e4bb1b1>
  a skos:Concept;
  skos:prefLabel "vochtschermen"@nl;
  skos:scopeNote "Een vochtscherm is een ondoordringbaar materiaal dat wordt aangebracht bij de bouw van een nieuw gebouw of dat wordt ingebracht in een bestaand gebouw om het optrekken van vocht vanuit de bodem tegen te gaan. Het scherm kan een plak waterdicht materiaal zijn, zoals lood, of een hydrofoob impregnatiemiddel dat in een bouwelement wordt geïnjecteerd (Conservation Dictionary)"@nl;
  skos:altLabel "DPC"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4e481c81-319a-44da-86bf-106f145d22c1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/04c3dbbf-05f7-4566-ad5e-98922ba14dca>
  a skos:Concept;
