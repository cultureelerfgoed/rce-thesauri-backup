<https://data.cultureelerfgoed.nl/term/id/cht/bc31413e-cadb-4a0d-acc6-94469fc1436e>
  a skos:Concept;
  skos:prefLabel "bovenbouw (bruggen)"@nl;
  skos:scopeNote "Het gedeelte van een brug dat op de onderbouw rust. Dit omvat onder meer het rijdek en de leuningen."@nl;
