<https://data.cultureelerfgoed.nl/term/id/cht/eae592a5-2644-45c2-bce1-393cdc0b969e>
  a skos:Concept;
  skos:prefLabel "zuigerveren"@nl;
  skos:scopeNote "Dunne metalen, gespleten ringen, gewoonlijk van gietijzer, die in groeven rondom de zuiger passen en ervoor dienen om een afdichting tegen de cilinderwand te vormen. Er zijn twee soorten: compressieveren en olieschraapveren."@nl;
  skos:altLabel "zuigerveer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/191e6fab-4b8b-49ae-87f9-85763bf6a904>;
