<https://data.cultureelerfgoed.nl/term/id/cht/8de2e35e-beea-4213-993a-ffa3e546980c>
  a skos:Concept;
  skos:prefLabel "sleepboten"@nl;
  skos:scopeNote "Vrij kleine, krachtige schepen, die worden gebruikt om schepen op zee en dekschuiten te slepen, of om te assisteren in en rond een haven, bijvoorbeeld bij het aanleggen. Gebruik 'duwboten' voor koopvaardijschepen die hele groepen dekschuiten slepen. (aatned.nl)"@nl;
  skos:altLabel "sleepboot"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5a8990ab-91f5-4521-a246-a8705a599af2>;
