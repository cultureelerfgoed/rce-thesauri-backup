<https://data.cultureelerfgoed.nl/term/id/cht/093b1487-ff86-453d-9eb2-228b98cf62e5>
  a skos:Concept;
  skos:prefLabel "containerschepen"@nl;
  skos:scopeNote "Een containerschip is een vrachtschip, een vervoermiddel voor zeecontainers."@nl,
    "Te gebruiken voor schepen die zijn ontworpen om vracht te vervoeren in gestandaardiseerde, verzegelbare en voor hergebruik geschikte containers, die vaste afmetingen hebben en zijn ontworpen om op elkaar te worden gestapeld en aan elkaar te worden vastgezet. (AAT)"@nl;
  skos:altLabel "containerschip"@nl;
