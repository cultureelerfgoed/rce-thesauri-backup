<https://data.cultureelerfgoed.nl/term/id/cht/4d8b86b3-6a43-48a6-b700-1ad882732b41>
  a skos:Concept;
  skos:prefLabel "uitmetselingen"@nl;
  skos:scopeNote "Metselwerk dat vooruitspringt uit een muurvlak. Dat kan zijn ter verzwaring (liseen, steunbeer) of ter ondervanging van een arkel, balkon, weergang enz.. (Haslinghuis)"@nl;
  skos:altLabel "uitmetseling"@nl;
