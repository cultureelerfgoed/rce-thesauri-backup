<https://data.cultureelerfgoed.nl/term/id/cht/c080da3c-0a07-40bc-b18b-0cccd0058dd0>
  a skos:Concept;
  skos:prefLabel "Qom-tapijten"@nl;
  skos:scopeNote "Qom-tapijten zijn perzische tapijten uit de stad Qom in Iran. Ze zijn bekend om hun hoge knoopdichtheid en het gebruik van fijne zijde, vaak met florale en klassieke Perzische patronen. Deze tapijten zijn zeer gewaardeerd door verzamelaars."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c3f9ef98-ae46-42e6-af2a-29a0f0b9fb84>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/982eb5c5-81a2-4685-b2d6-df2b5338ea60>
  a skos:Concept;
  skos:prefLabel "Shiraz-tapijten"@nl;
  skos:scopeNote "Shiraz-tapijten vallen onder de perzische tapijten en komen uit de regio Shiraz in Iran. Deze tapijten zijn vaak voorzien van tribale ontwerpen, gemaakt door de nomaden die in de omgeving van Shiraz leven."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c3f9ef98-ae46-42e6-af2a-29a0f0b9fb84>;
