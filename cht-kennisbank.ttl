<https://data.cultureelerfgoed.nl/term/id/cht/cbf2d65a-7f31-4df3-915b-b38afefbc5ef>
  a skos:Concept;
  skos:prefLabel "molenkasten"@nl;
  skos:scopeNote "Kas het bovenste lichaam van een standerdmolen, waarin zich het gaande werk bevindt. De kast kan om de standerd gedraaid worden om de molen op de wind te zetten. Ook: kas, kot als verkleinwoord ‘kastje’ gebruikt bij een roedekruising of tuimeling, als in de verticale roede het profiel is doorgestoken tot de halve diepte van de overgebleven dagkant. Zie tekening tuimeling."@nl;
  skos:altLabel "kas (molenkast)"@nl, "kassen (molenkast)"@nl, "kast (molenkast)"@nl,
    "kasten (molenkast)"@nl, "kot"@nl, "kot (molenkast)"@nl, "kotten (molenkast)"@nl,
    "molenkast"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/04770e4f-1c11-40e7-a256-9de8c6d569c6>;
