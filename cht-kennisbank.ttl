<https://data.cultureelerfgoed.nl/term/id/cht/68531e39-13f8-4303-95a4-9a6d71971320>
  a skos:Concept;
  skos:prefLabel "steektrappen"@nl;
  skos:scopeNote "Steektrappen zijn trappen waarvan alle treden in of op twee evenwijdige zijvlakken steunen. Ze onderscheiden zich van laddertrappen door bredere treden, bomen en een geringere helling."@nl;
  skos:altLabel "steektrap"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4568d082-f2fd-4dfb-b1b9-4d71334e1d9a>;
