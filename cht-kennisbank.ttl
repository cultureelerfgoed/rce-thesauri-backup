<https://data.cultureelerfgoed.nl/term/id/cht/5a36c0b7-4ed3-40c4-b4e6-6b05c571c4e2>
  a skos:Concept;
  skos:prefLabel "ceremoniale episcoporums"@nl;
  skos:scopeNote "Liturgisch boek, waarin rituele voorschriften voor de bisschoppen zijn beschreven, betreffende kerkelijke en burgerlijke plechtigheden en van algemene aard. Komt voor als handschrift en als gedrukt boek. (Religieus Erfgoedthesaurus)"@nl;
  skos:altLabel "ceremoniale episcoporum"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b2619bd2-0cdc-4fb1-9998-a69d9ab08421>;
