  a skos:Concept;
  skos:prefLabel "dissipatieve constructieonderdelen"@nl;
  skos:scopeNote "Constructieonderdelen die in staat zijn om energie te dissiperen door middel van ductiel hysteresisresponsgedrag. Hysteresis is het constructief gedrag waarbij momenten afwisselend toenemen, afnemen en van teken"@nl;
  skos:altLabel "dissipatief constructieonderdeel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4e481c81-319a-44da-86bf-106f145d22c1>;
