<https://data.cultureelerfgoed.nl/term/id/cht/8a2cca1d-f3dd-479c-9b2d-14da89d15a88>
  a skos:Concept;
  skos:prefLabel "scheepvaartroutes"@nl;
  skos:scopeNote "Vaarweg, koers, richting over zee, langs kusten en door vaarwateren van de ene plaats naar de andere op de veiligste, snelste en meest economische manier; een vaste of gebruikelijke route."@nl;
  skos:altLabel "scheepvaartroute"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/98c12193-433b-40dc-9ee3-5dcc5a6e8256>;
