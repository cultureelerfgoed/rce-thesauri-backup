<https://data.cultureelerfgoed.nl/term/id/cht/e1e1570b-0ad8-4fb2-ab7e-596af0cb1209>
  a skos:Concept;
  skos:prefLabel "engienen"@nl;
  skos:scopeNote "Werktuig, soms in de zin van bouwkraan. In 1321 gingen twee meesters die bezig waren aan het Belfort van Gent naar Brussel en Mechelen omme te beziene hoe dat sij adden ghesteld de engiene van haren werke. Soms torenuurwerk (1464 Damme, stadhuis). (Haslinghuis)"@nl;
  skos:altLabel "engien"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ad46daff-09b1-4796-9929-c05f129dd72f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e33a6aea-ed82-4567-bd55-8ee1039f5e4a>
  a skos:Concept;
  skos:prefLabel "potscheuren"@nl;
  skos:scopeNote "Steentje van gesinterd gebakken materiaal, c. 2 X 10 X 2 cm, afstandhouder tussen gestapelde potten in een bakoven, gebruikt als vloermateriaal (zie) gres. (Haslinghuis)"@nl;
  skos:altLabel "potscheur"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e7140107-e3ef-451f-bd4a-bd391f5b28ac>
  a skos:Concept;
  skos:prefLabel "Basècles"@nl;
  skos:scopeNote "Kolenkalksteen, gewonnen halverwege tussen Doornik en Bergen (Henegouwen). (Haslinghuis)"@nl;
