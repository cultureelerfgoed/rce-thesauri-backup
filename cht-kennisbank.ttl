<https://data.cultureelerfgoed.nl/term/id/cht/7287a215-cee0-41d3-8756-231dbb5ed045>
  a skos:Concept;
  skos:prefLabel "drukringen"@nl;
  skos:scopeNote "Deel van het ontkoppelingsmechanisme. Koolring die de druk op het koppelingspedaal overbrengt op het drukgroepmechanisme."@nl;
  skos:altLabel "drukring"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0ef28dc0-1153-4cde-a8a4-7b2873977681>;
