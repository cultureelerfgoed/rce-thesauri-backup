<https://data.cultureelerfgoed.nl/term/id/cht/938ca031-2904-4f63-986f-14af5f6d5d63>
  a skos:Concept;
  skos:prefLabel "bijboten"@nl;
  skos:scopeNote "Kleine open boot die achter een groot schip wordt meegesleept."@nl;
  skos:altLabel "bij-boot"@nl, "bij-boten"@nl, "bijboot"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ffab7ecd-8caa-4191-a63f-ac8ed9258b19>;
