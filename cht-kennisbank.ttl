<https://data.cultureelerfgoed.nl/term/id/cht/49885030-0103-445d-a544-6e26cee75fcd>
  a skos:Concept;
  skos:prefLabel "rivierduinen"@nl;
  skos:scopeNote "Een rivierduin is een duin die aan het eind van het Pleistoceen, in de Jonge Dryas (12.900-11.700 voor heden), langs de grote rivieren ontstaat door opwaaiing van zand uit droogliggende delen van vlechtende rivieren. (Weerts & Bazelmans 2011)"@nl;
  skos:altLabel "rivierduin"@nl, "beekduinen"@nl, "beekduin"@nl;
