  a skos:Concept;
  skos:prefLabel "motorfietsmotoren"@nl;
  skos:scopeNote "De motorfietsmotor is de krachtbron voor en motorfiets. Deze kan bestaan uit een diverse soorten motoren. Van 1 tot 4 cilinders. Van luchtgekoeld tot koelstofgekoeld."@nl;
