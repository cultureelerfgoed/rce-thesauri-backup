<https://data.cultureelerfgoed.nl/term/id/cht/a3d4ee9c-966b-4955-9f87-9492c389f5bb>
  a skos:Concept;
  skos:prefLabel "zinkscharen"@nl;
  skos:scopeNote "Vrijwel gelijk aan de loodschaar met enigszins dunnere schaarbladen, die het knippen in zink mogelijk maken. Andere naam: handschaar."@nl;
  skos:altLabel "handschaar"@nl, "zinkschaar"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6d0a91a3-b717-4040-b93e-0a908f9d3c7b>;
