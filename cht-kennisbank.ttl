<https://data.cultureelerfgoed.nl/term/id/cht/8fa6d192-51e0-4c4a-be78-ee12302c7707>
  a skos:Concept;
  skos:prefLabel "warmwaterkruiken"@nl;
  skos:scopeNote "Een warmwaterkruik is een fles of zak die met heet water wordt gevuld om warmte af te geven in bed of op het lichaam."@nl;
  skos:altLabel "warmwaterkruik"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e677977f-f707-46c7-8471-aed0f9e9e470>;
