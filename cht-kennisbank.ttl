<https://data.cultureelerfgoed.nl/term/id/cht/ba1abed0-85df-411f-b602-4d2000b7cdfc>
  a skos:Concept;
  skos:prefLabel "schoorbruggen"@nl;
  skos:scopeNote "Schoorbruggen zijn balkbruggen waarbij de ligger wordt ondersteund door schoren. Schoren worden vaak toegepast om de verstijvingsligger niet te laten doorbuigen bij grote afstanden. (Typologie van stalen bruggen / H. de Jong , 1996)"@nl;
  skos:altLabel "schoorbrug"@nl;
