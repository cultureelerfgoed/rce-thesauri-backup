<https://data.cultureelerfgoed.nl/term/id/cht/b898a355-b774-4935-abdd-029a39c30f13>
  a skos:Concept;
  skos:prefLabel "Polonceauspanten"@nl;
  skos:scopeNote "Kapspant, opgebouwd uit twee onderspannen driehoekige liggers, verbonden door een trekstaaf. Het principe werd ontwikkeld door de Franse ingenieur Polonceau (1840). Soms van hout maar meestal van ijzer, af en toe met houten drukstaven. Speciaal voor grote overspanningen, zoals markthallen, fabrieksgebouwen en stationsoverkappingen. (Haslinghuis)"@nl;
  skos:altLabel "Polonceauspant"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c4da8b07-9847-4269-86a6-8da0ab1923f5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

