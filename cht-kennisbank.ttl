<https://data.cultureelerfgoed.nl/term/id/cht/65da09fa-7564-417c-a889-7ca8f7657e80>
  a skos:Concept;
  skos:prefLabel "radiokoolstofdatering"@nl;
  skos:scopeNote "C14-dateringen zijn de bepalingen van het gehalte aan radio-actieve koolstof, of 14C, van organisch materiaal (hout, houtskool, veen, schelpen e.d.) waaruit de 14C-ouderdom kan worden afgeleid. Deze ouderdom wordt opgegeven in jaren voor 1950 na Chr. (jaren BP) met daaraan toegevoegd de aan de meting verbonden mogelijke afwijking (standaarddeviatie).(Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "C14-datering"@nl, "Koolstofmethode"@nl, "Koolstofdatering"@nl, "C-14-datering"@nl,
