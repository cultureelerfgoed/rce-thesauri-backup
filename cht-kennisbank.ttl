  a skos:Concept;
  skos:prefLabel "tra's"@nl;
  skos:scopeNote "Een tra is een weg rond of door een malebos. Tra’s waren bestemd om hout afkomstig uit het bos te kunnen afvoeren."@nl,
    "Een tra is een weg rond of door een malebos. Tra’s waren bestemd om hout afkomstig uit het bos te kunnen afvoeren. (Thesaurus landschap)"@nl;
