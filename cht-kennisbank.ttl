<https://data.cultureelerfgoed.nl/term/id/cht/8da1933d-6514-4ec2-9326-44a4bf032a90>
  a skos:Concept;
  skos:prefLabel "raadhuizen"@nl;
  skos:scopeNote "Gebouw waar burgemeester en vroedschap, de raad, bijeenkwam, en waar door de schout of vierschaar recht werd gesproken, rechthuis. De naam werd ook in steden gebruikt. (Haslinghuis)"@nl;
  skos:altLabel "raadhuis"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a0b6bec9-cb1d-43c2-8f3e-0e955674b26f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/895e6cea-59e7-448e-82db-271c1a3e5e18>
  a skos:Concept;
  skos:prefLabel "regeringsgebouwen"@nl;
  skos:scopeNote "Regeringsgebouwen zijn gebouwen waarin de regering van het land gevestigd is. Een voorbeeld zijn de regeringsgebouwen aan het Binnenhof in Den Haag."@nl;
  skos:altLabel "regeringsgebouw"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a0b6bec9-cb1d-43c2-8f3e-0e955674b26f>;
