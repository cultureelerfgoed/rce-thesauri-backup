<https://data.cultureelerfgoed.nl/term/id/cht/393d4dc4-8cb3-4a02-9d9c-51fcc5050a6f>
  a skos:Concept;
  skos:prefLabel "kallitypieën"@nl;
  skos:scopeNote "Fotografische afdrukken gebaseerd op de lichtgevoeligheid van ijzerzouten die naast zilverzouten in de emulsie voorkomen. Het beeldvormende zilver ontstaat onder invloed van de belichte ijzerzouten. Na het ontwikkelen ontstaat een metalliek zilveren afbeelding. Met verschillende ontwikkelaars kan men ook zwarte, bruine, paarse of kastanjebruine tonen aanbrengen. (Project Fotografie)"@nl;
  skos:altLabel "kallitypie"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7737d3fa-a323-4c1b-b9d2-19dcade69828>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/7943b7b4-9dd1-47e6-a7ba-b68df4112445>
  a skos:Concept;
  skos:prefLabel "kanthouten"@nl;
  skos:scopeNote "Gekantrecht hout, vierkant beslagen of bekapte balken. (Haslinghuis)"@nl;
  skos:altLabel "kanthout"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/650ab4b1-e8ab-4c49-9195-8401d4a6cd6e>;
