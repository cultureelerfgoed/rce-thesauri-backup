<https://data.cultureelerfgoed.nl/term/id/cht/19bf4fb7-5780-4cca-bf90-0325a1be6674>
  a skos:Concept;
  skos:prefLabel "wethouders"@nl;
  skos:scopeNote "Wethouders maken deel uit van het college van B&W en voeren bestuurlijke taken uit binnen een gemeente. Ze zijn politiek verantwoordelijk voor beleidsterreinen."@nl;
  skos:altLabel "wethouder"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db4a7619-d236-4b14-8e79-b4a6e890f677>;
