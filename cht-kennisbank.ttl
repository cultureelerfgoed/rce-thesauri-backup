<https://data.cultureelerfgoed.nl/term/id/cht/773550a4-3424-4f55-a31f-87617bd963cf>
  a skos:Concept;
  skos:prefLabel "fluorescentielampen"@nl;
  skos:scopeNote "Een fluorescentielamp geeft hoofdzakelijk licht in de vorm van fluorescentie. In een buislamp wordt UV-straling opgewekt door middel van elektrische ontlading in kwikdamp. De binnenwand van de buis is bekleed met een stof die in het zichtbare gebied fluoresceert. (Conservation Dictionary)"@nl;
  skos:altLabel "TL-buis"@nl, "TL-buizen"@nl, "TL-lamp"@nl, "TL-lampen"@nl, "fluorescentielamp"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d8f707ff-1866-4890-a94c-c0fe554bf797>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

