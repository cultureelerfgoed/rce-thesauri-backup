  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/dcb30c0e-2a06-4935-a5f1-f29b8b346ffb>
  a skos:Concept;
  skos:prefLabel "software"@nl;
  skos:scopeNote "Verzamelnaam voor de besturings- en toepassingsprogramma's, procedures en bijbehorende documentatie die betrekking hebben op de werking van een computersysteem. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91712616-6dec-4871-8fdc-c317850c20d1>;
