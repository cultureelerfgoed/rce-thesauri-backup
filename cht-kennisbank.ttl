<https://data.cultureelerfgoed.nl/term/id/cht/3b50d584-137c-4e75-ab40-3c25ab6fd267>
  a skos:Concept;
  skos:prefLabel "onderglazuren"@nl;
  skos:scopeNote "Bij keramiek, het aanbrengen van kleur op het oppervlak van een kleilichaam voordat een transparant glazuur wordt aangebracht. (Toegepaste Kunst Project, RKD)"@nl;
  skos:altLabel "onderglazuur"@nl;
