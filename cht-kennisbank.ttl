<https://data.cultureelerfgoed.nl/term/id/cht/0611efff-5bc3-4212-b1cd-59509cf1ce46>
  a skos:Concept;
  skos:prefLabel "torenverbanden"@nl;
  skos:scopeNote "Houtconstructie in een stenen torenromp. Bestaat uit draagbalken, muurstijlen, sleutelstukken en korbelen. Er kunnen meer lagen torenverband voorkomen. Biedt tevens de gelegenheid een vloer aan te brengen en een klokkenstoel te plaatsen. (Haslinghuis)"@nl;
  skos:altLabel "torenverband"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa7202ac-68c8-4d29-9310-0421ca975837>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/835c2a70-a059-4104-a9a3-e3fa46433876>
  a skos:Concept;
