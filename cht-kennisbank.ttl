<https://data.cultureelerfgoed.nl/term/id/cht/863aab7e-5c8a-4e39-bb79-c627eed749e1>
  a skos:Concept;
  skos:prefLabel "ijzergieterijen"@nl;
  skos:scopeNote "Een ijzergieterij is een gieterij, waar gietijzer wordt gesmolten en in gietvormen wordt gegoten zodat producten in de gewenste vorm ontstaan. (Wikipedia)"@nl;
  skos:altLabel "ijzergieterij"@nl;
