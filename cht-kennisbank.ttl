  a skos:Concept;
  skos:prefLabel "landinrichtingsgebied"@nl;
  skos:scopeNote "Een Landinrichtingsgebied is een gebied waar maatregelen voorzien zijn voor herinrichting van het landelijk gebied."@nl;
