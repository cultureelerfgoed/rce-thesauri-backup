  a skos:Concept;
  skos:prefLabel "weesmeisjes"@nl;
  skos:scopeNote "Weesmeisjes zijn meisjes zonder ouders, vaak opgegroeid in weeshuizen. Ze komen in erfgoedcontext voor in instellingen, kleding of gebruiksvoorwerpen."@nl;
