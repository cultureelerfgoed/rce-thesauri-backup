<https://data.cultureelerfgoed.nl/term/id/cht/28170918-1bc7-4990-9b37-b95f0f161b09>
  a skos:Concept;
  skos:prefLabel "remdrukbegrenzers"@nl;
  skos:scopeNote "Klep die soms in de leiding van hydraulische achterwielremmen wordt aangebracht om overmatige druk op deze remmen te voorkomen. Daardoor wordt het risico van blokkerende achterwielen beperkt en de kans op slippen belangrijk minder."@nl;
  skos:altLabel "remdrukbegrenzer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1e2b9f9b-d492-4ac8-a977-fdb0161b1268>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/28d6729c-5494-44a4-94d6-823528692346>
  a skos:Concept;
  skos:prefLabel "remschoenen"@nl;
  skos:scopeNote "Halfcirkelvormig metalen deel, waarop de remvoering wordt geklonken of gelijmd."@nl;
