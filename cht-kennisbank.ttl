  a skos:Concept;
  skos:prefLabel "doezelen"@nl;
  skos:scopeNote "Een tekentechniek, waarbij gebruik wordt gemaakt van een sigaarvormig hulpstuk, doezelaar genaamd, om houtskool, zacht potlood, pastel, krijt of crayon te mengen of uit te wrijven. (AAT-Ned)"@nl;
