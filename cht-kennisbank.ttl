<https://data.cultureelerfgoed.nl/term/id/cht/1411449e-54f8-47e8-97fe-2b450a20fe7b>
  a skos:Concept;
  skos:prefLabel "koude bedoeking"@nl;
  skos:scopeNote "Koude bedoeking is een manier van bedoeken waarbij de lijm droogt doordat het oplosmiddel verdampt of waarbij oplosmiddel wordt gebruikt om de lijm te activeren, in plaats van warmte."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c97ae635-f11e-47bd-821a-c5addc39676b>
