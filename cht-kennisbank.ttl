<https://data.cultureelerfgoed.nl/term/id/cht/eb54750e-eee2-43c9-9720-0bb0da2b0003>
  a skos:Concept;
  skos:prefLabel "stadskastelen"@nl;
  skos:scopeNote "Groot stenen huis van het patriciaat binnen de ommuring van een stad, dat hoogstens de suggestie van verdedigbaarheid wekt. In Nederland m.n. in Utrecht, enkele in ’s-Hertogenbosch. (Haslinghuis)"@nl;
  skos:altLabel "stadskasteel"@nl;
