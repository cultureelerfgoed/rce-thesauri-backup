<https://data.cultureelerfgoed.nl/term/id/cht/91caa0a5-282e-4fe4-86ab-0f652bd34fab>
  a skos:Concept;
  skos:prefLabel "schenkels (gewelf)"@nl;
  skos:scopeNote "Schenkels zijn gebogen delen van spitsbogen, gehouwen stukken steen voor gewelfribben. (Haslinghuis)"@nl;
  skos:altLabel "schenkel (gewelf)"@nl, "schinkel"@nl, "schinkels"@nl;
