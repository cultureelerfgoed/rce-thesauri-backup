  a skos:Concept;
  skos:prefLabel "weerstations"@nl;
  skos:scopeNote "Een weerstation is een verzameling instrumenten die het weer kunnen meten. Zo'n weerstation wordt vaak handmatig, maar tegenwoordig ook wel automatisch uitgelezen. (Wikipedia)"@nl;
