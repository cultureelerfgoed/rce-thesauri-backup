  a skos:Concept;
  skos:prefLabel "Médéarder zandsteen"@nl;
  skos:scopeNote "Médéarder zandsteen is een zandsteensoort uit de Médéa-regio in Algerije, bekend om zijn fijne structuur en veel gebruikt in historische bouwwerken."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/07067413-15a3-4210-a2ca-5fa80893357d>;
