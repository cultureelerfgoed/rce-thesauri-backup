<https://data.cultureelerfgoed.nl/term/id/cht/62dcb018-bbd3-404c-9a35-10fb6bed3f8e>
  a skos:Concept;
  skos:prefLabel "haardstoven"@nl;
  skos:scopeNote "Haardstoven zijn stookplaatsen om te drogen en te koken. Soms is op de vloer een extra natuurstenen plaat aangebracht. (Haslinghuis)"@nl;
  skos:altLabel "haardstoof"@nl;
