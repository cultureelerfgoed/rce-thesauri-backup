<https://data.cultureelerfgoed.nl/term/id/cht/38c312b6-2dac-4155-b4e3-362b88ba6d2e>
  a skos:Concept;
  skos:prefLabel "logies"@nl;
  skos:scopeNote "Particuliere adressen waar men kan logeren en ontbijten. (AAT-Ned)"@nl;
  skos:altLabel "logie"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/97bea71b-c464-4211-8298-711d35553269>;
