<https://data.cultureelerfgoed.nl/term/id/cht/815bce3d-58d7-4700-af8f-c6dae58f6585>
  a skos:Concept;
  skos:prefLabel "jaarbeurzen"@nl;
  skos:scopeNote "Presentaties van de producten en diensten van een bepaalde markt of tak van industrie. Het bezoek is meestal beperkt tot de leden van de desbetreffende handel. (AAT-Ned)"@nl;
  skos:altLabel "jaarbeurs"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a07885e8-5c02-43c2-9cfc-d7e078de86bf>;
