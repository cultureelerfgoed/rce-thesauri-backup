<https://data.cultureelerfgoed.nl/term/id/cht/ce60cff6-1584-4d96-b830-78a256a268f9>
  a skos:Concept;
  skos:prefLabel "culturele centra"@nl;
  skos:scopeNote "Culturele centra zijn complexen van ruimten verrichtingen en samenkomsten van culturele aard, zoals tentoonstellingen, muziek, sport- en spelbeoefening, theatervoorstellingen enz. Eind jaren zestig kwam het ‘cultureel centrum’ in zwang. Aanvankelijk werden voor dat doel leegstaande panden in gebruik genomen, later werd er speciaal voor gebouwd. Meestal werden dit soort gebouwen uitgevoerd als ‘multifunctionele centra’. (Bosma)"@nl;
  skos:altLabel "cultureel centrum"@nl, "cultuurcentra"@nl, "cultuurcentrum"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e9251d88-dd54-4e65-9e36-9c19fd66a7a0>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/eba7a436-0eb1-4623-af1e-4a3ba430a573>,
    <https://data.cultureelerfgoed.nl/term/id/cht/966b9fcc-87e9-4145-9202-6ee91857a922>;
