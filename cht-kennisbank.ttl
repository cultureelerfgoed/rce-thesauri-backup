<https://data.cultureelerfgoed.nl/term/id/cht/51b977a5-0929-4f33-96c8-efd2257e8d1d>
  a skos:Concept;
  skos:prefLabel "verwaarlozing"@nl;
  skos:scopeNote "Verwaarlozing is een bewust of onbewust gebrek aan zorg voor een object, wat vaak leidt tot verval ervan."@nl;
