<https://data.cultureelerfgoed.nl/term/id/cht/19d25461-6512-4a0e-b6fa-cd18dad57aa0>
  a skos:Concept;
  skos:prefLabel "gewelfvelden"@nl;
  skos:scopeNote "Gewelfvelden zijn de delen van een plattegrond die door een gewelf worden overspannen. (Haslinghuis)"@nl;
  skos:altLabel "gewelfveld"@nl;
