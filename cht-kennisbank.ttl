<https://data.cultureelerfgoed.nl/term/id/cht/d62a2380-485e-44d8-a762-aefe23e47a78>
  a skos:Concept;
  skos:prefLabel "kimlatten"@nl;
  skos:scopeNote "Op doorsnede meestal enigzins ruitvormige lat die (het breeuwsel in) de kimnaad afsluit en met houten en/of ijzeren nagels aan zowel de vlak- als de boordgang is vastgezet."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/333dad79-4b9e-4c77-924e-c4455b781628>;
