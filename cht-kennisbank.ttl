<https://data.cultureelerfgoed.nl/term/id/cht/37816505-0894-49d6-80b0-c42e7e7c096f>
  a skos:Concept;
  skos:prefLabel "voorpaden"@nl;
  skos:scopeNote "Gelijkstraatse, althans weinig verhoogde, vaak door palen, stangen en kettingen afgezette stoep langs een voorgevel, b.v. voor het stadhuis van Nijmegen. In Brussel vroeger voorvanc."@nl;
  skos:altLabel "voorpad"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e719e1d0-27d2-44f7-8d6e-a2e0ed1df73f>;
