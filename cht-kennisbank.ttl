<https://data.cultureelerfgoed.nl/term/id/cht/d9d40bd8-497c-4064-b782-2c16b9ced316>
  a skos:Concept;
  skos:prefLabel "klimaat"@nl;
  skos:scopeNote "De atmosferische variaties op een specifieke geografische locatie op langere termijn. Gebruik 'weer' voor de atmosferische toestand op korte termijn. (AAT-ned)"@nl,
    "Het milieu in een gebouw is de atmosfeer die erin heerst."@nl, "Het milieu rond een voorwerp of een collectie is de atmosfeer waarin ze zich bevinden."@nl,
    "De omgeving van een gebied bestaat uit de natuurlijke en door de mens aangelegde kenmerken in het gebied."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/de1b7736-5d45-413a-925f-2ae733f8836f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/cef9de71-b81c-478d-8a15-edd2dba99b84>
  a skos:Concept;
  skos:prefLabel "kookbeitels"@nl;
  skos:scopeNote "Beitels waarmee de naden van ijzeren of stalen platen worden dichtgeslagen. (MARDOC)"@nl;
  skos:altLabel "kookbeitel"@nl;
