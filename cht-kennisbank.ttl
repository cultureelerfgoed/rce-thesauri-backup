  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/558f7164-1d56-48db-99e0-45008a468678>
  a skos:Concept;
  skos:prefLabel "merkels"@nl;
  skos:scopeNote "Dunne rechte balk met gootje onder de naden tussen de luiken op binnenschepen op de Rijn en in zuidelijk Nederland."@nl;
  skos:altLabel "merkel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/650ab4b1-e8ab-4c49-9195-8401d4a6cd6e>;
