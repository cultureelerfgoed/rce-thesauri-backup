  a skos:Concept;
  skos:prefLabel "draIon"@nl;
  skos:scopeNote "DraIon is een synthetische vezel, gemaakt van polyacrylonitril, die bekend staat om zijn zachtheid, lichtgewicht karakter en weerstand tegen slijtage, vaak gebruikt in textiel zoals kleding en tapijten."@nl;
