<https://data.cultureelerfgoed.nl/term/id/cht/fcef94a2-bbf2-4dbb-8417-bf8fcde53651>
  a skos:Concept;
  skos:prefLabel "handboormachines"@nl;
  skos:scopeNote "Handbediend boorgereedschap dat bestaat uit een stalen buis die een as bevat, met aan de ene kant een handvat en aan de andere kant een spankop met het boorijzer. (AAT)"@nl;
