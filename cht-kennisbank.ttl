<https://data.cultureelerfgoed.nl/term/id/cht/8d85724b-d8b5-4306-898d-3d4740bfc532>
  a skos:Concept;
  skos:prefLabel "holken"@nl;
  skos:scopeNote "Bepaald (nog) niet nauw omschreven scheepstype."@nl;
  skos:altLabel "holk"@nl;
