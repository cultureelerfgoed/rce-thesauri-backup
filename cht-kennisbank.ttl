  a skos:Concept;
  skos:prefLabel "Doornikse steen"@nl;
  skos:scopeNote "Doornikse steen is een zwartblauwe, gelaagde kalksteensoort, die in de omgeving van Doornik wordt gewonnen. Door verwering wordt de steen zilvergrijs. (Wikipedia)"@nl;
