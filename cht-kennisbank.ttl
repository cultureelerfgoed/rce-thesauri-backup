<https://data.cultureelerfgoed.nl/term/id/cht/9e489e10-e45a-4c4a-8427-967d620a9eca>
  a skos:Concept;
  skos:prefLabel "katankers"@nl;
  skos:scopeNote "Loopanker, dijkanker, klein draagbaar anker met één arm bijvoorbeeld om langs een dijk te meren waar meerpalen ontbreken bij het ankeren wordt de ene arm in de grond geslagen."@nl;
  skos:altLabel "katanker"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eaa093ba-cf85-4d23-a913-9f645fc45b21>;
