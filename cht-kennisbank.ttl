<https://data.cultureelerfgoed.nl/term/id/cht/ca497488-b157-45e1-b518-0cb1c6412594>
  a skos:Concept;
  skos:prefLabel "diafragma's"@nl;
  skos:scopeNote "Dwars over een ruimte gespannen boog met daarop opgetrokken muur die de traveeën scheidt, de zijwanden verstijft en de kap ondersteunt. In VI reeds toegepast in Syrië, maar in de romaanse bouwkunst vrij regelmatig voorkomend. (Haslinghuis)"@nl;
  skos:altLabel "diafragma"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/42f94d21-f2a3-40e2-bf34-cc9e17ddaaaa>;
