<https://data.cultureelerfgoed.nl/term/id/cht/048aa785-9819-41c2-99d9-9ffa90b54e44>
  a skos:Concept;
  skos:prefLabel "afweermiddel"@nl;
  skos:scopeNote "Een afweermiddel voor insecten is een chemische stof die in een ruimte verdampt en die insecten belet de ruimte binnen te komen. Veel van deze stoffen hebben maar weinig succes en zijn giftig voor mensen, zoals paradichloorbenzeen en naftaleen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/04937815-528d-49a8-887c-ee0431209a8d>
  a skos:Concept;
  skos:prefLabel "aanbestedingsrechten"@nl;
