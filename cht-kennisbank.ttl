<https://data.cultureelerfgoed.nl/term/id/cht/0405677b-3a77-4026-a3df-3f6e9e970694>
  a skos:Concept;
  skos:prefLabel "brochéweefsels"@nl;
  skos:scopeNote "Een brochéweefsel is een weeftechniek waarbij een of meer extra inslagdraden worden ingevoerd in het grondweefsel om zo een decoratief effect te krijgen. De toegevoegde inslagdraden lopen alleen over de breedte van het patroon. (Conservation Dictionary)"@nl;
  skos:altLabel "brochéweefsel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/86d3631a-1f3f-4b51-bbbb-dadebc310ecc>;
