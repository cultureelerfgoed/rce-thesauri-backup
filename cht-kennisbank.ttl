<https://data.cultureelerfgoed.nl/term/id/cht/9f11c41b-4ef5-4bbb-aad4-9faea7dd07a6>
  a skos:Concept;
  skos:prefLabel "tankmuren"@nl;
  skos:scopeNote "Een tankmuur is een betonnen muur van zodanige hoogte en zwaarte dat deze niet door tanks kan worden overschreden."@nl;
  skos:altLabel "anti-tankmuren"@nl, "anti-tankmuur"@nl, "tankmuur"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/17b8c913-3ae6-470b-8c5e-9561231be495>;
