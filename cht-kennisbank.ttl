<https://data.cultureelerfgoed.nl/term/id/cht/9d5fda2e-7038-4805-ac65-c1f0eb6879e9>
  a skos:Concept;
  skos:prefLabel "luchtvaartuigen"@nl;
  skos:scopeNote "Een luchtvaartuig is een voertuig dat in staat is om zich voort te bewegen door de aardatmosfeer of door elk soort atmosfeer. Alle menselijke activiteit rondom luchtvaartuigen wordt luchtvaart genoemd. (Wikipedia)"@nl,
    "Objecten oorspronkelijk gemaakt om mensen of goederen te vervoeren boven het oppervlak van de aarde, maar binnen de grenzen van de atmosfeer van de aarde. (Nomenclature 3.0 for Museum Cataloging)"@nl;
  skos:altLabel "luchtvaartuig"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c55c9e1b-b4dd-469c-a2fa-98e049fdb9f3>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/4c255542-e846-479d-b1a5-4331d19195cb>,
    <https://data.cultureelerfgoed.nl/term/id/cht/9951d2c0-b8a5-48e0-8fcd-49403526edf9>,
    <https://data.cultureelerfgoed.nl/term/id/cht/d39bc00a-0a31-4510-ba12-0fc802eb06ea>,
    <https://data.cultureelerfgoed.nl/term/id/cht/17a8a947-b6e0-4174-b9bd-dea3671fb1ad>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/5cca7468-6aae-4f4b-9dea-27dfb8e64b1e>
  a skos:Concept;
  skos:prefLabel "schulpboren"@nl;
  skos:scopeNote "Grote avegaar, waarmee geboorde gaten verwijd worden. (Haslinghuis)"@nl;
