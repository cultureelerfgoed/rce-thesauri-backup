<https://data.cultureelerfgoed.nl/term/id/cht/b471264d-37a5-4af7-8ccd-21af08b6cccb>
  a skos:Concept;
  skos:prefLabel "weekbladen"@nl;
  skos:scopeNote "Een op de nieuwsvoorziening en vaak speciaal op de achtergronden van het nieuws uit het dagblad gericht periodiek met een wekelijkse frequentie en een sterke continuïteit in verschijningsvorm.(Encyclo.nl)"@nl;
  skos:altLabel "weekblad"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91712616-6dec-4871-8fdc-c317850c20d1>;
