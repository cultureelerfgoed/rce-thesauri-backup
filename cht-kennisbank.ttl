<https://data.cultureelerfgoed.nl/term/id/cht/10872eca-a7bb-44da-9be9-722ecddfe788>
  a skos:Concept;
  skos:prefLabel "Labrador"@nl;
  skos:scopeNote "Dieptegesteente uit Zuid-Noorwegen, grijsblauw of donker blauwgroen van kleur. Bevat grote veldspaatkristallen met parelmoerglans. Vanwege de decoratieve werking wordt de steen meestal gepolijst toegepast. In Nederland in gebruikt sedert begin XX. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/160dd0cb-52ec-4320-82a0-16cad8889f5d>;
