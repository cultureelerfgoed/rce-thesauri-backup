<https://data.cultureelerfgoed.nl/term/id/cht/d6fcd6e7-cac0-4c25-b6fd-c377e97ce9aa>
  a skos:Concept;
  skos:prefLabel "refugiehuizen"@nl;
  skos:scopeNote "Refugiehuizen zijn vluchthuizen in een stad, waar buiten de wallen gevestigde kloosterlingen in tijden van oorlog en plundering de wijk konden nemen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "refugia"@nl, "refugiehuis"@nl, "refugium"@nl, "refugiums"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1f045186-ba15-4937-a311-de50437f32d4>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/923ba596-bc30-44f5-a26c-cac680e3808d>
  a skos:Concept;
  skos:prefLabel "kunststoffen"@nl;
  skos:scopeNote "Verbinding bestaande uit grote moleculen (polymere verbinding), gemaakt van natuurlijke producten (bijv. cellulose) of zuiver chemisch. Er bestaan drie soorten kunststof: thermoplasten, thermoharders, en elastomeren. Niet te verwarren met plastic, dat hier gebruikt wordt als synoniem voor thermoplast. (Project Fotografie)"@nl,
    "Kunststoffen zijn chemische verbindingen die door niet-natuurlijke scheikundige processen worden gemaakt. (Wikipedia)"@nl;
  skos:altLabel "kunststof"@nl, "plastic"@nl, "plastics"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2c2e3d6f-cf42-47d6-9c1d-d30c4fdf79e5>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/1b9670bd-9f3e-4545-83e5-48fc7e9ff7b1>,
