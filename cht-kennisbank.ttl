<https://data.cultureelerfgoed.nl/term/id/cht/3cd62913-1580-41f1-94c7-30649a25605e>
  a skos:Concept;
  skos:prefLabel "anisotroop"@nl;
  skos:scopeNote "Een anisotrope eigenschap van een materiaal is een eigenschap die varieert al naar gelang de richting in het materiaal waarin zij gemeten wordt."@nl;
