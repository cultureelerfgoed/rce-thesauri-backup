<https://data.cultureelerfgoed.nl/term/id/cht/6a4afb6e-f44e-4270-a582-794ad5013fbe>
  a skos:Concept;
  skos:prefLabel "moernering"@nl;
  skos:scopeNote "Moernering is het afgraven van veen onder klei ten behoeve van brandstof en/of het winnen van zout. Dit procede begint methet afgraven van moer, ooit door de zee overspoeld veen, om daaruit door verbranding zout te kunnen winnen (Wikipedia)."@nl;
  skos:altLabel "selnering"@nl, "darinkdelving"@nl, "darinc-delving"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/66fab72b-9294-4f5e-ad4a-0f2f1fa97e1c>
  a skos:Concept;
  skos:prefLabel "aquaria"@nl;
  skos:scopeNote "Aquaria zijn glazen bakken met water waarin men levende waterdieren en waterplanten houdt en kan kweken."@nl;
  skos:altLabel "aquarium"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/41ae98cd-0cc4-438a-8032-3c6ee1429b8d>;
