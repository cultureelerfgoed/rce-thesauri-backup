  a skos:Concept;
  skos:prefLabel "diefkettingen"@nl;
  skos:scopeNote "Korte ketting aan deur, vastgezet aan een oog in de muur, teneinde te voorkomen dat de deur ongewenst wijd wordt opengedaan. (Haslinghuis)"@nl;
