<https://data.cultureelerfgoed.nl/term/id/cht/98c57c4c-6517-44ff-9e91-52cddd68142e>
  a skos:Concept;
  skos:prefLabel "schooltuinen"@nl;
  skos:scopeNote "Schooltuinen zijn tuinen meestal op loopafstand van een school aangelegd ten behoeve van educatie voor jonge kinderen of onderwijs in de plantkunde, en waarin de leerlingen meestal ook werken. Het woord wordt ook wel gebruikt voor een tuin gelegen bij een schoolgebouw, voor sier of ontspanning, zonder specifiek educatief doel. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "schooltuin"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c2fcf3dc-6efd-4c88-afcf-287b680894ff>;
