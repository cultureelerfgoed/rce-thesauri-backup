  a skos:Concept;
  skos:prefLabel "plooiijzers"@nl;
  skos:scopeNote "Een plooiijzer is samengesteld uit een ronde ijzeren staaf gestoken in houten handvat. Het ijzer gedeelte werd in een vuur opgewarmd. Met de verwarmde staaf werden de plooien in de klederdracht mutsen gestreken. (Kijk- en Luistermuseum)"@nl;
  skos:altLabel "plooi-ijzer"@nl;
