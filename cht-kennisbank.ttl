<https://data.cultureelerfgoed.nl/term/id/cht/f5f5f891-718e-4062-947d-3ad61dd7c595>
  a skos:Concept;
  skos:prefLabel "vissnikken"@nl;
  skos:scopeNote "Nederlandse vissersvaartuigen, vooral van Friesland en Groningen, die al in de 13e eeuw werden vermeld. Het was een rondgebouwd vaartuig, voorzien van een bun en geheel gedekt. (aatned.nl)"@nl;
  skos:altLabel "vissnik"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/3f1ace50-e981-4b2e-9b9b-4bfa2cf0b576>;
