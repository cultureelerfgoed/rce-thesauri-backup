<https://data.cultureelerfgoed.nl/term/id/cht/4180e640-dec8-4193-b79a-c40a22e79a8e>
  a skos:Concept;
  skos:prefLabel "Felsrechteckbijlen"@nl;
  skos:scopeNote "Felsrechteckbijlen zijn Neolithische stenen bijlen met een rechthoekige dwarsdoorsnede. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "Felsrechteckbijl"@nl;
