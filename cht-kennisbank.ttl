  a skos:Concept;
  skos:prefLabel "buitenluiken"@nl;
  skos:scopeNote "Buitenluiken zijn houten luiken die aan de buitenzijde van een gebouw zijn geplaatst. Er bestaan verschillende typen en uitvoeringen. (Historische zonwering / B.H.J.N. Kooij, RCE Brochure, Amersfoort, 2012)"@nl;
