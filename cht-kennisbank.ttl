  a skos:Concept;
  skos:prefLabel "pila"@nl;
  skos:scopeNote "Werpsperen, doorgaans met een lange, smalle kop, bevestigd aan de stok door middel van een flens of een holte, en een gewicht onder de kop aan de stok om evenwicht en baan te verbeteren; behorend tot de uitrusting van Romeinse soldaten vanaf de Republikeinse periode tot de 4e of 5e eeuw nc. (AAT-Ned)"@nl;
  skos:altLabel "pilum"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bfa5acbd-ed55-4787-a217-db06688d2331>;
