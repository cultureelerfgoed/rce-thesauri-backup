<https://data.cultureelerfgoed.nl/term/id/cht/65dc121c-8d46-4cc3-9574-e0d64b39c87e>
  a skos:Concept;
  skos:prefLabel "boekenhout"@nl;
  skos:scopeNote "Boekenhout is wit beukenhout, afkomstig van de haagbeuk. Dit hout is geelwit van kleur en is geïmporteerd uit Frankrijk. Het wordt gebruikt waar taai hout van niet te grote afmetingen nodig is, bv voor gereedschappen. (Haslinghuis)"@nl;
  skos:altLabel "boeken (hout)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7ebaf5a0-7a95-4ae0-81ee-2db87df90041>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d6e6774b-b67c-4a65-bca3-7f109715d43d>
  a skos:Concept;
  skos:prefLabel "rouwkoetsen"@nl;
