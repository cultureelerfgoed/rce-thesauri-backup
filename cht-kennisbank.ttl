<https://data.cultureelerfgoed.nl/term/id/cht/aa745cfd-845b-4864-a8d1-5e5305f90d3d>
  a skos:Concept;
  skos:prefLabel "gewelfd deksel met verdikte rand bolvormige knop, rustend op vlakke ring"@nl;
  skos:scopeNote "Een gewelfd deksel met verdikte rand en bolvormige knop rustend op een vlakke ring, biedt een stevige en decoratieve afsluiting voor het object, met een prominente knop als centraal visueel element."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/8d6b3fe8-d27c-4f23-9e4b-483e5ac1b6e2>;
