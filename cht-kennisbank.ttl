  a skos:Concept;
  skos:prefLabel "mijnenvegers"@nl;
  skos:scopeNote "Schepen die speciaal zijn ontworpen of aangepast om mijnen op zee op te ruimen of te vernietigen. (AAT)"@nl,
    "Minensuchboot is een Duitse term voor mijnenveger. Het kon gaan om een vissersschip dat omgebouwd was tot mijnenveger of om een specifiek door de marine gebouwd schip met mijnenveeguitrusting."@nl;
  skos:altLabel "minensuchboten"@nl, "mijnenveger"@nl, "minensuchboot"@nl;
