<https://data.cultureelerfgoed.nl/term/id/cht/d08631ea-8332-47ad-a7cf-5cedc63e93fc>
  a skos:Concept;
  skos:prefLabel "glijbanen"@nl;
  skos:scopeNote "Glijbanen zijn speeltoestellen die ondermeer te vinden zijn in zwembaden bestaande uit een ladder of trap om omhoog te klimmen en een brede, gladde `buis' om naar beneden te glijden. (Wikipedia)"@nl;
  skos:altLabel "glijbaan"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
