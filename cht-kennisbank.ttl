<https://data.cultureelerfgoed.nl/term/id/cht/d07a2442-503e-4b2e-981d-7b71187a688e>
  a skos:Concept;
  skos:prefLabel "oliepompen"@nl;
  skos:scopeNote "In oliemolens, pompen waarmee de olie uit de oliebakken in vaten werd overgebracht."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/04770e4f-1c11-40e7-a256-9de8c6d569c6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/721c4664-55e5-4989-95e3-221d79dd2fda>
  a skos:Concept;
  skos:prefLabel "peerdjes"@nl;
  skos:scopeNote "(in Groninger pelmolens) Twee stukjes kops azijnhout, meestal van oude kammen gemaakt en van dezelfde breedte als het middendeel van de rijn, die tijdens het lichten van de pelsteen onder de rijn worden gezet, waarna de bolspil er door middel van het nokiezer en een voorhamer uitgeslagen kan worden. Ze voorkomen dat de rijn uit de steen breekt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/04770e4f-1c11-40e7-a256-9de8c6d569c6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/09cfd09d-5678-4a49-9dce-b7341fb4f472>
  a skos:Concept;
  skos:prefLabel "buurtposten"@nl;
  skos:scopeNote "Buurtposten zijn gebouwen waar activiteiten voor een buurt plaatsvinden. Vaak kunnen er door buurtbewoners ruimten gehuurd worden."@nl;
