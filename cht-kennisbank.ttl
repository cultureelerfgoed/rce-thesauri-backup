<https://data.cultureelerfgoed.nl/term/id/cht/680a53b0-de1d-48de-8490-fc9cd0f3d09f>
  a skos:Concept;
  skos:prefLabel "bijgeloof"@nl;
  skos:scopeNote "Geloof aan bovennatuurlijke werkingen of verschijnselen, m.n. zulke die in het menselijk leven ingrijpen; ook daaruit voortvloeiende praktijk."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bcf326d7-26b6-436b-be7e-8690d32de16d>;
