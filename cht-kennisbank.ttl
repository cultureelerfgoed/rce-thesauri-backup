<https://data.cultureelerfgoed.nl/term/id/cht/e4fd6160-a117-498f-9afd-27735b18e98e>
  a skos:Concept;
  skos:prefLabel "varkensstallen"@nl;
  skos:scopeNote "Stallen voor het onderbrengen van varkens. (AAT-Ned)"@nl, "Varkenshokken zijn de hokken waarin de varkens zich bevinden. Dat kan een ruimte zijn in de boerderij, maar kan ook een apart gebouw zijn. Vooral aan het einde van de 19de eeuw ontstonden veel aparte gebouwtjes voor de varkens. Vanaf die tijd ging men meer varkens houden, waardoor zij een eigen gebouw kregen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "varkenshok"@nl, "varkenshokken"@nl, "varkenskooi"@nl, "varkenskooien"@nl,
    "varkenskot"@nl, "varkenskotten"@nl, "varkensschuren"@nl, "varkensschuur"@nl, "varkensstal"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/97bf4efc-cf4f-4e60-b795-589029bb6b37>;
