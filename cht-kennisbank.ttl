<https://data.cultureelerfgoed.nl/term/id/cht/92fc5d6b-762f-4e3a-829c-ba04255a7c62>
  a skos:Concept;
  skos:prefLabel "blushuizen"@nl;
  skos:scopeNote "Gebouwen waar brandweerauto's, brandbestrijdingsapparatuur zijn ondergebracht en meestal ook de brandweermannen, die dienst hebben. (AAT-Ned)"@nl;
