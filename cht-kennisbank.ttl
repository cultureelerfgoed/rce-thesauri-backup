<https://data.cultureelerfgoed.nl/term/id/cht/37d61e03-15c6-4c6b-b4a0-5e722c7b69ea>
  a skos:Concept;
  skos:prefLabel "strijdhamers"@nl;
  skos:scopeNote "Wordt met name gebruikt voor Europese slagwapens met een zware kop, meestal met een stompe of puntige kant en met tenminste één blad of pin aan de andere kant van de kop of bovenop de staf; ze kwamen voor in verschillende typen van de 13e tot de 17e eeuw. Wordt ook meer algemeen gebruikt voor hamers die als gevechtswapens werden gebruikt in bijna alle delen van de wereld sinds de steentijd. (AAT-Ned)"@nl;
  skos:altLabel "strijdhamer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b1288dff-d822-439e-bc0e-bb9427371a0a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/37d9115c-8f72-4ca9-aa38-968d9d92b79a>
  a skos:Concept;
