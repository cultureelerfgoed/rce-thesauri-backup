  a skos:Concept;
  skos:prefLabel "aluminium gevelplaten"@nl;
  skos:scopeNote "Aluminium gevelplaten zijn dunne metalen platen die worden gebruikt als bekleding voor gebouwen, gewaardeerd om hun duurzaamheid, lichtgewicht en corrosiebestendigheid."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2f015793-fc1f-4f76-bed5-1022c2bd15c4>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/551c4c53-827d-450d-b49e-261767e5590e>
  a skos:Concept;
  skos:prefLabel "archeologisch materiaal"@nl;
  skos:scopeNote "Archeologisch materiaal verwijst naar objecten en resten die zijn opgegraven uit archeologische vindplaatsen, en die waardevolle informatie bieden over vroegere beschavingen en hun leefomstandigheden."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/0892941b-623d-4daf-8141-cea269f949d9>
  a skos:Concept;
  skos:prefLabel "arseen"@nl;
  skos:scopeNote "Arseen is een giftig metalloid dat in verschillende vormen voorkomt en in de geschiedenis veelvuldig werd gebruikt in pesticiden en conserveringsmiddelen, ondanks de ernstige gezondheidsrisico's."@nl;
  skos:altLabel "arseenvergiftiging"@nl, "arsenicum"@nl, "arsenikum"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/227f7088-c0cb-4d83-afc8-a29e130c95d5>
  a skos:Concept;
  skos:prefLabel "arseenzeep"@nl;
  skos:scopeNote "Arseenzeep is een mengsel van arseenoxide (rattenkruid) en zeep, dat werd gebruikt bij het prepareren en conserveren van huiden en balgjes."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2a95064-a74d-4752-8765-22ed1c4d4110>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/efc1c6bc-edce-4bd9-b7b3-7a5cecd16b40>
  a skos:Concept;
  skos:prefLabel "asbestplaten"@nl;
  skos:scopeNote "Asbestplaten zijn mineraalplaten die gemaakt zijn van asbestvezels, vroeger veel gebruikt in de bouw vanwege hun brandwerende eigenschappen, maar nu grotendeels verboden vanwege de gezondheidsrisico's."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1aacc3bd-faad-4a82-a29a-0f0309834a3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/83bd864b-21c8-4ade-8127-7c34199065d6>
  a skos:Concept;
  skos:prefLabel "baallinnen"@nl;
  skos:scopeNote "Baallinnen is een type linnen dat vaak in grote balen wordt verpakt en gebruikt voor diverse toepassingen, zoals kleding, beddengoed en huishoudtextiel."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f3fcf01e-bb07-49f2-b7e6-e4741c6ff52e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/425cfadf-1305-4666-b5ad-439b07be74d5>
  a skos:Concept;
  skos:prefLabel "baksteenonderdelen"@nl;
  skos:scopeNote "Baksteenonderdelen zijn componenten van bakstenen, zoals halve of gebroken stukken, die vaak gebruikt worden voor specifieke constructiedoeleinden of restauraties."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bbe4a82c-d0af-42c9-86c2-cca2e9560bac>;
