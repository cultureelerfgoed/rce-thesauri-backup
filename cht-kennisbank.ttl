<https://data.cultureelerfgoed.nl/term/id/cht/2a057888-6046-402e-9c26-a34c1e1919bf>
  a skos:Concept;
  skos:prefLabel "draaitabernakels"@nl;
  skos:scopeNote "Altaarkast met een draaibare inrichting, meestal verdeeld in twee of drie compar-timenten. In één deel wordt het vaatwerk met de gecon-sacreerde hosties bewaard, een tweede deel kan als expositietroon voor de monstrans of de expositie-ciorie worden gebruikt en het derde deel bevat een geschilderde of gebeeldhouwde voorstelling, bijvoorbeeld de gekruisigde Christus. Wordt in Vlaanderen ook wel trommeltabernakel genoemd."@nl;
  skos:altLabel "draaitabernakel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/53d2c7d7-fa80-4795-ae8f-705886c4a4ae>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2a0d79cf-bf4c-418b-bb90-e2c6a1cc05d2>
  a skos:Concept;
