<https://data.cultureelerfgoed.nl/term/id/cht/b9095669-723b-46ab-996a-94dcc7cd7230>
  a skos:Concept;
  skos:prefLabel "conserveringsmethode"@nl;
  skos:scopeNote "Een conserveringsmethode is een algemeen aanvaarde werkwijze bij de conservering."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
