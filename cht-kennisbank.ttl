<https://data.cultureelerfgoed.nl/term/id/cht/fbc86a37-e908-457a-9224-55b0730e817b>
  a skos:Concept;
  skos:prefLabel "raamroeden"@nl;
  skos:scopeNote "Houten of metalen element van relatief geringe doorsnede in een venster of raam. Daarin is het glas bevestigd. De kruising van twee roeden heet tuimeling. (Haslinghuis)"@nl;
  skos:altLabel "mullion"@nl, "raamroede"@nl;
