<https://data.cultureelerfgoed.nl/term/id/cht/82771707-fc44-48b5-bcf6-fec9ee35e7f8>
  a skos:Concept;
  skos:prefLabel "snijplanken"@nl;
  skos:scopeNote "Planken die van hout, plastic of ander synthetisch materiaal zijn gemaakt en die bij het snijden van voedsel als ondergrond worden gebruikt. (AAT-Ned)"@nl;
