<https://data.cultureelerfgoed.nl/term/id/cht/a4a8211e-753f-40a1-b340-01c4bf6d549f>
  a skos:Concept;
  skos:prefLabel "jong paleolithicum"@nl;
  skos:scopeNote "Het laat-paleolithicum wordt gedefinieerd op basis van het voorkomen van diverse vuurstenen en benen spitstypen. Deze artefacten zijn geproduceerd met een klingtechniek op basis van speciaal geprepareerde kernen. De eerste mensen van het geslacht Homo Sapiens Sapiens zijn eveneens in deze periode te dateren. Synoniem met de term jong-paleolithicum."@nl;
  skos:altLabel "laat paleolithicum"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ddd129e3-a30f-425f-8fec-7d1b3dad8f6d>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/edb91ec9-8afb-424f-b801-da99f84da3be>,
    <https://data.cultureelerfgoed.nl/term/id/cht/1303e09e-e5ae-459d-b3a2-73f1d4c4e0a4>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

