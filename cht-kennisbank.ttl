<https://data.cultureelerfgoed.nl/term/id/cht/371139a3-d124-4873-8108-a7e765a7554a>
  a skos:Concept;
  skos:prefLabel "kathodische bescherming"@nl;
  skos:scopeNote "Kathodische bescherming is het beschermen van metaal zoals muurankers en doken tegen corrosie door het elektrisch te verbinden met een minder edel metaal dat gemakkelijker wordt geoxideerd (de opgeofferde anode). Een eenvoudig voorbeeld is verzinkt ijzer."@nl;
  skos:altLabel "kathodisch systeem"@nl, "galvanische kathodische bescherming"@nl, "GCP"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/254738f7-c253-4dfe-a5ce-c6bca0846c83>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/1631b64f-545d-45fe-a6c6-c92123e816ff>,
    <https://data.cultureelerfgoed.nl/term/id/cht/f96c96f1-bdf9-4a72-980d-07dffa93d9c9>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/13766238-3f9c-420a-b2ee-d764ee47d1cc>
  a skos:Concept;
  skos:prefLabel "sassinetten"@nl;
  skos:scopeNote "Sassinetten behoren tot de groep van historische binnenzonweringen. Deze oude en ook zeldzaam geworden vorm van zonwering bestaat uit een soort houten raamwerk, soms gestileerd en soms beschilderd, dat bespannen is met zijde. Later in de tijd zijn ook andere materialen dan zijde toegepast. Sassinetten worden doorgaans aan de binnenzijde van schuiframen geplaatst."@nl;
  skos:altLabel "sassinet"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e49be3a1-a12f-463f-b631-fc32395e68c3>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/5ff1a521-07fb-44a6-ba21-4483e4fabfdf>
  a skos:Concept;
  skos:prefLabel "verkeershallen"@nl;
  skos:scopeNote "Verkeershallen zijn grote, open ruimtes in gebouwen die dienen als centrale verkeersaders, waar mensen samenkomen, zoals in treinstations, luchthavens, of stadions."@nl;
  skos:altLabel "verkeershal"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/83883001-9943-4726-9ddd-3fd73c7b9c46>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b4c622e9-67ae-4482-855f-c59e7314e355>
  a skos:Concept;
  skos:prefLabel "kruisende deuren"@nl;
  skos:scopeNote "Kruisende deuren bijzondere constructie met 4 draaideuren, waarbij men de druk op het lage paar gebruikt, om het hoge paar gecontroleerd te openen. (De Binnenvaart)"@nl;
  skos:altLabel "kruisende deur"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a5fc0cd1-ac59-400d-8ced-74746897cf25>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/88da58f7-a0d0-4275-9494-68c692a388d1>
  a skos:Concept;
  skos:prefLabel "aalmoezeniershuizen"@nl;
  skos:scopeNote "Aalmoezeniershuizen zijn gestichten van liefdadigheid, bestuurd door aalmoezeniers, die de bedeling van behoeftige oude lieden en kinderen leidden. Grote middeleeuwse kloosters hadden een dicht bij de publieke ontvangstzaal ( auditorium) of het gastenhuis gelegen ‘elemosynaria’, d.w.z. aalmoezenierskamer. Aan het hoofd stond een college van Armenvaders of Aalmoezeniers, die toezicht hadden op uitbestede kinderen, uitdeling van levensmiddelen e.d.. In het huis werden ook bedelaars opgenomen. In 1663 werd besloten de vondelingen en wezen niet meer bij particulieren uit te besteden, maar de opvoeding in eigen beheer te nemen en daartoe een Aalmoezeniersweeshuis in te richten."@nl;
  skos:altLabel "aalmoezeniershuis"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7efa4296-bca6-4fde-a258-8c07c2c93f5b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c6ce2ca6-7bdc-4990-a43c-796aa8d8a396>
  a skos:Concept;
  skos:prefLabel "beslagwerk"@nl;
  skos:scopeNote "Beslagwerk is een ornament in gevels dat ontleend is aan ijzeren sierbeslag. Het komt veel voor in de voorbeeldboeken van Hans Vredeman de Vries. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0b8e500e-d40f-4be2-85de-5fe442c59d20>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/42b21030-3e8b-4787-a52f-e785fc8e09b3>
