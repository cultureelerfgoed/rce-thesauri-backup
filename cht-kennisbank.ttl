<https://data.cultureelerfgoed.nl/term/id/cht/32f15696-f51b-4af6-b9fa-4f5243de9965>
  a skos:Concept;
  skos:prefLabel "gongen"@nl;
  skos:scopeNote "Metalen, vrijhangend bekken of een staand klokvormig bekken op een voet. Wordt aangeslagen met een met stof of leer omwonden stok. Wordt gebruikt als sacristiebel of altaarbel."@nl;
  skos:altLabel "gong"@nl;
