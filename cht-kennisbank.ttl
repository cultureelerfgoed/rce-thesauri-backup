<https://data.cultureelerfgoed.nl/term/id/cht/d0672d52-28d1-439e-9af1-9aa0a834b681>
  a skos:Concept;
  skos:prefLabel "grenspalen"@nl;
  skos:scopeNote "Grenspalen zijn bewerkte stenen palen met officieel karakter, dienend om een grensscheiding aan te duiden tussen twee gebieden, zoals staten, gewesten, steden, rechtsgebieden, landgoederen, jachtgebieden etc. Grenspalen komen ook in gietijzer en in hout voor. Ze zijn veelal voorzien van aanduidingen in de vorm van wapenschilden, opschriften, nummers, jaartallen etc. (Haslinghuis/Grenspalen in Nederland / T. Brouwer, Zutphen 1978)"@nl;
  skos:altLabel "gebiedspaal"@nl, "gebiedspalen"@nl, "grenspaal"@nl, "limietpaal (grens)"@nl,
