<https://data.cultureelerfgoed.nl/term/id/cht/25a56ef5-cd64-44f5-98ba-c02625c22189>
  a skos:Concept;
  skos:prefLabel "brandweergarages"@nl;
  skos:scopeNote "Brandweergarages zijn gebouwen waarin de brandweer gevestigd is. Hierin bevinden zich de brandweerwagens en er zijn ook ruimtes voor het personeel."@nl;
  skos:altLabel "brandweergarage"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/8ff0dcfb-21fd-4852-a452-e3a9b4bdecc7>;
