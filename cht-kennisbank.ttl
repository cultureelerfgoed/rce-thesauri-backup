  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/56cd8b9c-15d5-499d-93ef-b0fcb8011848>
  a skos:Concept;
  skos:prefLabel "vuurkorven"@nl;
  skos:scopeNote "Een vuurkorf is een ijzeren mand waarin mensen in de openlucht houtblokken kunnen stoken om zo een sfeervol vuur te maken. (Wikipedia)"@nl,
    "Vuurkorven zijn losse gietijzeren onderdelen van kachels, bestaande uit één geheel bestaande combinaties van roosters en vuurkamers. Ze zijn uitneembaar. In openhaarden en schouwen past men vaak losse vuurkorven toe. (Kachels / R. Rook, Utrecht/Aartselaar, 1985)"@nl;
  skos:altLabel "vuurkolf"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e3bc04b1-00de-4790-a1a9-f569caa26822>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c28c70b7-3e33-42a1-9a4b-0f4759f1ad68>
  a skos:Concept;
  skos:prefLabel "zandkribben"@nl;
  skos:scopeNote "Zandkribben zijn aangelegde schermen van takken, eikenhakhot of dennen tegen het verstuiven van zand. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "zandkribbe"@nl, "takkenschermen"@nl, "takkenscherm"@nl;
