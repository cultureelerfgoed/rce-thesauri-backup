  a skos:Concept;
  skos:prefLabel "eerste luitenant"@nl;
  skos:scopeNote "Eerste luitenant bij de marechaussee is een subalterne officiersrang, verantwoordelijk voor het aansturen van eenheden en het uitvoeren van tactische bevelen binnen operationele kaders. Deze rang bevindt zich net boven tweede luitenant en is vaak de eerste leidinggevende positie waar men de verantwoordelijkheid draagt voor zowel mensen als materieel."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ebe46e17-3cf8-4ae7-bdd9-1fc9394e9b47>;
