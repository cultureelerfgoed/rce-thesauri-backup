<https://data.cultureelerfgoed.nl/term/id/cht/69268789-1680-428f-ad70-cbb06ab2ac27>
  a skos:Concept;
  skos:prefLabel "dichters"@nl;
  skos:scopeNote "Auteurs van composities die zich kenmerken door verdichte taal die is gekozen vanwege de klank, de suggestieve kracht en de betekenis. (AAT)"@nl;
  skos:altLabel "dichter"@nl;
