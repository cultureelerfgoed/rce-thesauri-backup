<https://data.cultureelerfgoed.nl/term/id/cht/37618803-ce35-4cf0-a51c-8d5bba3a737e>
  a skos:Concept;
  skos:prefLabel "schuifhekken"@nl;
  skos:scopeNote "Schuifhekken, nauw verwant aan rolluiken en rolhekken, zijn beveiligingshekken die kunnen worden weggeschoven, al of niet mechanisch. (Moderne zonwering voor historische gebouwen / B.H.J.N. Kooij, RCE brochure, Amersfoort 2013)"@nl;
  skos:altLabel "schuifhek"@nl;
