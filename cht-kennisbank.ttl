<https://data.cultureelerfgoed.nl/term/id/cht/6626ed4e-3a26-46ab-b809-931af06b671b>
  a skos:Concept;
  skos:prefLabel "mansardedaken"@nl;
  skos:scopeNote "Mansardedaken zijn daken met steile ondervlakken en licht hellende bovenvlakken. Het tegenovergestelde van een mansardedak is het doorzalende dak."@nl;
  skos:altLabel "gebroken dak"@nl, "gebroken daken"@nl, "mansardedak"@nl;
