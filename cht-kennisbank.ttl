<https://data.cultureelerfgoed.nl/term/id/cht/07e55cea-d2ea-420d-838a-3427ff804ae0>
  a skos:Concept;
  skos:prefLabel "rouwdrachten"@nl;
  skos:scopeNote "Kledingvariant waarbij gedurende een vastgestelde periode rouw wordt getoond over het verscheiden van een directe bloedverwant (eerste- of tweede graad). Zie ook 'lichte rouw', 'halve rouw' en 'zware rouw'. (AAT)"@nl;
  skos:altLabel "rouwdracht"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5dec9aa2-5ced-4f77-b929-c043b90b2a8f>;
