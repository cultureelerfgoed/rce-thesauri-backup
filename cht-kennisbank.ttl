<https://data.cultureelerfgoed.nl/term/id/cht/1f3401e1-82ed-4f85-be15-68928171b051>
  a skos:Concept;
  skos:prefLabel "drijfsteen"@nl;
  skos:scopeNote "Lichte bouwsteen, gemaakt van lichtgewicht toeslagstoffen zoals bims (vulkanisch puimsteengruis), gebonden met portlandcement. De steen blijft door de in bims opgesloten lucht op water drijven, in tegenstelling tot de met hoogovenslakken gemaakte stenen. In de volksmond wordt drijfsteen wel tufsteen genoemd. Ook: zwemsteen. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dbd21141-8f4c-4f1e-b49c-6621d2687a38>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/dbd21141-8f4c-4f1e-b49c-6621d2687a38>
  a skos:Concept;
  skos:prefLabel "kunststeen"@nl;
  skos:scopeNote "Kunststeen is een gegoten imitatie van echte steen en wordt gemaakt van beton waarop stof of brokjes zijn gehecht van de te imiteren steensoort. (Conservation Dictionary)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a84ab8b6-24c6-493d-939d-102bb982bd91>;
