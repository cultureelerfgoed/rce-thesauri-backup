  a skos:Concept;
  skos:prefLabel "rentmeesterswoningen"@nl;
  skos:scopeNote "Rentmeesterwoningen zijn woningen bestemd voor rentmeesters. Deze woningen bevinden zich veelal op landgoederen."@nl;
