<https://data.cultureelerfgoed.nl/term/id/cht/ee3ddfde-d8bc-4333-ad4a-3b867ac1a22a>
  a skos:Concept;
  skos:prefLabel "wijnkoelers"@nl;
  skos:scopeNote "Houders voor koud water en ijs voor het koelen van één of meer wijnflessen; in de vorm van een emmer of urn voor gebruik op tafel of aanrecht; of in de vorm van een grote ovale bak en soms gecombineerd met een wijnfontein. (AAT-Ned)"@nl;
  skos:altLabel "wijnkoeler"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
