  a skos:Concept;
  skos:prefLabel "strijkglazen"@nl;
  skos:scopeNote "Het strijkglas is een glazen bol en werd gebruikt voor het glad strijken van verschillende kledingstoffen. De bollen konden ook van steen zijn. De warmte ontstond bij de wrijving en van het lichaam, via de hand. (bron: Geschiedenislokaal023)"@nl;
  skos:altLabel "strijkglas"@nl;
