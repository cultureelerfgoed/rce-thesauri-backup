  a skos:Concept;
  skos:prefLabel "matriet"@nl;
  skos:scopeNote "Matriet is lang riet dat gebruikt wordt voor de spreilaag bij rieten daken. Ook toegepast bij rietmatten en stucplafonds."@nl;
