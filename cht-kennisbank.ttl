<https://data.cultureelerfgoed.nl/term/id/cht/5bcd9826-2ef4-4f30-b270-b41c5973a508>
  a skos:Concept;
  skos:prefLabel "huiszittenhuizen"@nl;
  skos:scopeNote "Huiszittenshuizen gebouwen waar de huiszittenmeesters (bestuurders van een liefdadige stichting ten bate van ‘thuis zittende’ armen) hun uitdeling van spijzen, kleren en brandstof hielden en vergaderden."@nl;
  skos:altLabel "huiszittenhuis"@nl;
