<https://data.cultureelerfgoed.nl/term/id/cht/b979c151-5fcf-4e13-a384-597eba44be3d>
  a skos:Concept;
  skos:prefLabel "oerlaag"@nl;
  skos:scopeNote "De oerlaag is een laag die is ontstaan door uitspoeling van organische- en ijzer-deeltjes uit de bovenlaag. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
