  a skos:Concept;
  skos:prefLabel "losangen"@nl;
  skos:scopeNote "Ruitvormig zinken dakbedekkingselement. Maten: 38 X 20, 43 X 22, 50 X 25, 58 X 29 cm. Er zijn ook zeshoekige losanges toegepast (systeem Baillot). Losanges worden met klangen aan het dakbeschot bevestigd. Vooral toegepast in XIXb. (Haslinghuis)"@nl;
  skos:altLabel "losange"@nl;
