<https://data.cultureelerfgoed.nl/term/id/cht/0221b6ac-a646-4123-91ec-f985dd06cf95>
  a skos:Concept;
  skos:prefLabel "koplopers"@nl;
  skos:scopeNote "Intercitymaterieel (kortweg ICM) is een treinstel van NS Reizigers dat voornamelijk gebruikt wordt in Intercitytreindiensten. De materieelnaam is Plan Z. De trein kreeg de bijnaam Koploper, vanwege de zogenaamde doorloopkop."@nl;
  skos:altLabel "icm"@nl, "intercity materieel"@nl, "koploper"@nl, "plan z"@nl;
