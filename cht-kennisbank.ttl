<https://data.cultureelerfgoed.nl/term/id/cht/ebbc928f-6fcd-4eb8-9eac-1d2a8fe2cf2c>
  a skos:Concept;
  skos:prefLabel "rikrakken"@nl;
  skos:scopeNote "Rikrakken zijn hefwerktuigen voor een éénroedige hooiberg, één rikrak bestaat uit twee met een klos verbonden planken met verspringende gaten en een hefboom. (Hooibergen in Nederland / Jurgens, Suzan, Marten Jansen en Wim Lanphen, Kampen: IJsselacademie, 2008)"@nl;
  skos:altLabel "rikrak"@nl, "verstekhaal"@nl, "verstelhalen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b11f6c4a-9652-41d8-8a53-411ec8e2f946>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f9d398c9-d472-46ad-be42-ac29825afc8c>
  a skos:Concept;
  skos:prefLabel "jachtstoeten"@nl;
  skos:scopeNote "Jachtstoeten zijn gezelschappen jagers met hun paarden, bedienden en gevolg. (Van Dale)"@nl;
