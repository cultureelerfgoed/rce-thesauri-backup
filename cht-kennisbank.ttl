<https://data.cultureelerfgoed.nl/term/id/cht/d49bcafb-b111-4df7-98ed-b3ec1591f10f>
  a skos:Concept;
  skos:prefLabel "draadklinken"@nl;
  skos:scopeNote "Langwerpig of rond plaatje met aan de rand cirkelvormige uitsparingen waarmee de doorsnede van een draadnagel kan worden gemeten. (Haslinghuis)"@nl;
  skos:altLabel "draadklink"@nl, "draadmal"@nl, "draadmallen"@nl, "ijkmaat"@nl, "ijkmaten"@nl,
    "kaliber"@nl, "kalibers"@nl, "voelmaat"@nl, "voelmaten"@nl;
