<https://data.cultureelerfgoed.nl/term/id/cht/15e46246-2b10-4630-81fe-ab773813a67d>
  a skos:Concept;
  skos:prefLabel "dekhamers"@nl;
  skos:scopeNote "Dekhamers zijn speciale rietdekkershamers met een houten stee, waarop een ijzeren hamereind in combinatie met een bijlvormig deel is gemonteerd. In het bijlvormige deel zit een uitkeping voor het uittrekken van spijkers. De rietdekker gebruikt de dekhamer bij het herstellen of vervangen van rietlatten. (Van aaks tot zwei / H. Janse)"@nl;
  skos:altLabel "dekhamer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d339743b-2655-40ed-b20b-e39879154603>;
