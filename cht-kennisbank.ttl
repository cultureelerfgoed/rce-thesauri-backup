<https://data.cultureelerfgoed.nl/term/id/cht/23729fa3-8409-4464-8cfe-5027092fe0d7>
  a skos:Concept;
  skos:prefLabel "kameneien (schoorsteen)"@nl;
  skos:scopeNote "Kameneien zijn schoorstenen, buitendakse kanalen. (Haslinghuis)"@nl;
  skos:altLabel "kamenei (schoorsteen)"@nl, "kemenye (schoorsteen)"@nl, "kemyneye (schoorsteen)"@nl;
