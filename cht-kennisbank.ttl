<https://data.cultureelerfgoed.nl/term/id/cht/021c78bd-8062-4b70-8831-dd80485b0d9a>
  a skos:Concept;
  skos:prefLabel "kuilers"@nl;
  skos:scopeNote "Kuilers zijn vissers die met een kuil vissen. Een kuil is een zakvormig visnet die uitgezet of gewoonlijk voortgesleept wordt. Dit doorgaans zeer fijnmazige visnet wordt opengehouden door uitstaande touwen of hoepels. Kuilen zijn er in verschillende soorten. (Van Dale)"@nl;
  skos:altLabel "kuiler"@nl, "kuilvisser"@nl, "kuilvissers"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f4d24936-e84c-4a17-b8a2-cbfdb5b6e242>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/021f5d8a-f524-48d2-91da-b5c50ce7db11>
  a skos:Concept;
