<https://data.cultureelerfgoed.nl/term/id/cht/5d4ba32f-d92a-4ffe-b9a3-7196353359c5>
  a skos:Concept;
  skos:prefLabel "briefpanelen"@nl;
  skos:scopeNote "Briefpanelen zijn decoratieve houten of metalen panelen waarop inscripties of teksten zijn aangebracht, vaak gebruikt in historische gebouwen of meubels als decoratief element."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c73812ab-878b-4d67-ab18-273bcaf39d4a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/85cb3fa4-814e-450e-9f3e-8c3466a6d1e8>
  a skos:Concept;
  skos:prefLabel "buidelboeken"@nl;
  skos:scopeNote "Buidelboeken zijn kleine, draagbare boeken die in een buidel of tas worden bewaard, vaak gebruikt in de middeleeuwen voor persoonlijke devotie of praktische informatie."@nl;
  skos:altLabel "buidelboek"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b2619bd2-0cdc-4fb1-9998-a69d9ab08421>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3cbdd20d-78ff-42af-bc29-ee19a56b380f>
  a skos:Concept;
  skos:prefLabel "burgerboeken"@nl;
  skos:scopeNote "Burgerboeken zijn registers waarin de namen en gegevens van burgers van een stad of gemeenschap worden bijgehouden. Ze zijn belangrijke bronnen voor genealogisch en historisch onderzoek."@nl;
  skos:altLabel "burgerboek"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b2619bd2-0cdc-4fb1-9998-a69d9ab08421>;
