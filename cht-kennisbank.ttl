<https://data.cultureelerfgoed.nl/term/id/cht/7ceb2f41-90c9-499b-8be7-8719859aa990>
  a skos:Concept;
  skos:prefLabel "beschermde goederen"@nl;
  skos:scopeNote "Een beschermd goed is een onroerend goed dat van algemeen belang is vanwege zijn erfgoedwaarde. Cultuurgoederen die blijvend verbonden zijn met het monument maken altijd deel uit van de bescherming."@nl;
  skos:altLabel "beschermd goed"@nl;
