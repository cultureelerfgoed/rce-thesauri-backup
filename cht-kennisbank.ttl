<https://data.cultureelerfgoed.nl/term/id/cht/07bbde14-2632-4b85-9a6b-dd73d893a18a>
  a skos:Concept;
  skos:prefLabel "psalmborden"@nl;
  skos:scopeNote "Aankondigingsbord voor de psalmen die in de eredienst zullen worden gezongen. Is veelal bevestigd aan kerkmuur, zuil of preekstoel. (Religieus Erfgoedthesaurus)"@nl;
  skos:altLabel "psalmbord"@nl;
