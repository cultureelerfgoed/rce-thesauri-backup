<https://data.cultureelerfgoed.nl/term/id/cht/cc1aa02f-e559-4733-810a-5a8ef7014019>
  a skos:Concept;
  skos:prefLabel "Isfahan-tapijten"@nl;
  skos:scopeNote "Isfahan-tapijten zijn perzische tapijten van hoge kwaliteit, afkomstig uit de stad Isfahan in Iran. Ze worden gewaardeerd om hun verfijnde, gedetailleerde ontwerpen en gebruik van zijde en wol, vaak met klassieke Perzische motieven."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c3f9ef98-ae46-42e6-af2a-29a0f0b9fb84>;
