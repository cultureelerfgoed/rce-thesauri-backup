  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6c6a94e6-a741-42de-9983-8385f6a7c89d>
  a skos:Concept;
  skos:prefLabel "hoekers"@nl;
  skos:scopeNote "Een robuust gladboordig rondspant kielschip met scherpe lijnen in het achterschip. Als vissersschip zo genoemd omdat het met hoekwant viste, waarbij in het laatst van de 18e eeuw ook de naam 'hoekerbuis' opduikt voor een buis met bun zoals de hoekers. Men noemde dat 'kweeën'. De benaming hoeker is zoals gezegd ontleend aan de visserijmethode die werd bedreven: het vissen met haken of houcken. (vaartips.nl)"@nl,
    "Klein tot middelgroot zeeschip van in de Middeleeuwen tot in de 19de eeuw vooral in de Nederlanden gebruikt voor de visserij en koopvaardij. (MARDOC)"@nl;
  skos:altLabel "hoeker"@nl, "koopvaardijhoekers"@nl, "koopvaardijhoeker"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/32d80748-50d1-4c9c-b06d-dfca42e46ac6>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/189df523-f1e7-414d-9d04-f1a8abae0990>,
    <https://data.cultureelerfgoed.nl/term/id/cht/b2e4b2a3-5df6-4dcd-bdf2-59d4134d259c>,
    <https://data.cultureelerfgoed.nl/term/id/cht/4bd80829-631c-45d3-9009-c8ae0e8b1b58>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/742a5ece-dcae-480a-aa67-68c6994a94f0>
  a skos:Concept;
  skos:prefLabel "Thames barges"@nl;
  skos:scopeNote "Vrachtvaarder van de Engelse zuidoostkust, waarvan meerdere typen bestaan; zij waren alle platboomd m.e. doorgaans rechte of licht gebogen steven en een vlakke, hartvormige spiegel, hoewel sommige ook een rond overhangend achterschip hadden; zij voeren alle zwaarden; de river barge was het meest voorkomende type."@nl;
  skos:altLabel "Thames barge"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/32d80748-50d1-4c9c-b06d-dfca42e46ac6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

