<https://data.cultureelerfgoed.nl/term/id/cht/769a05df-cd60-4043-87ee-7de768efc677>
  a skos:Concept;
  skos:prefLabel "blindeninstituten"@nl;
  skos:scopeNote "Blindeninstuten zijn gebouwcomplexen waar blinden en slechtzienden zowel onderwijs als huisvesting krijgen. Deze instituten onststonden veelal vanuit kerkelijke initiatieven vanaf de tweede helft van de 19e eeuw. De internaatfunctie van blindeninstituten nam vanaf de tweede helft van de 20e eeuw sterk af."@nl;
  skos:altLabel "blindeninstituut"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7d637918-2d8b-4d8b-8fba-2ad9546fc879>;
