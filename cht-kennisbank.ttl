<https://data.cultureelerfgoed.nl/term/id/cht/8870799b-487f-455c-822a-21dc94eaf501>
  a skos:Concept;
  skos:prefLabel "winkelcentra"@nl;
  skos:scopeNote "Winkelcentra zijn ruimtelijk geconcentreerde groepen van winkels die als eenheid zijn ontworpen en beheerd worden. (Het winkellandschap van Amsterdam : stedelijke structuur en winkelbedrijf in de vroegmoderne en moderne tijd, 1550-2000)"@nl;
  skos:altLabel "winkelcentrum"@nl, "winkelcentrums"@nl;
