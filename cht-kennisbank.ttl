<https://data.cultureelerfgoed.nl/term/id/cht/5de02d4b-1524-4788-872b-51616ee84287>
  a skos:Concept;
  skos:prefLabel "vlotternaalden"@nl;
  skos:scopeNote "Kleine naald in de benzinetoevoeropening van de carburateur, die op een zitting afdicht wanneer de vlotter rijst en die de benzinetoevoer afsluit als de vlotterkamer vol is."@nl;
  skos:altLabel "vlotternaald"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0a0b798b-453c-43ca-a048-174acb18a717>;
