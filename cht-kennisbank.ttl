<https://data.cultureelerfgoed.nl/term/id/cht/dd23fd64-6e57-4513-a5cb-b53cc2a3da84>
  a skos:Concept;
  skos:prefLabel "vlies"@nl;
  skos:scopeNote "De wollen vacht die schapen en soortgelijke dieren bedekt. Ook: de afgeschoren samenhangende wollaag. (AAT-Ned)"@nl;
  skos:altLabel "schapenvacht"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/dece9d19-43a5-47ca-a623-277a3f815e9c>
  a skos:Concept;
  skos:prefLabel "Sierra Leone kopal"@nl;
  skos:scopeNote "Een halfharde, lichtgele variëteit van kopalhars die wordt verkregen uit bomen van het geslacht Copaifera, die in Sierra Leone, Guinee en Ghana voorkomen. Het wordt gebruikt in vernis. Een middelharde, lichtgele variëteit van kopalhars, verkregen van bomen van het geslacht Copaifera, die inheems zijn in Sierra Leone, Guinee en Ghana. Het wordt gebruikt in vernis. (AAT)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ad635d83-8d1a-40e6-9a77-11112282c45d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/def1ca56-fa38-4585-a9fc-22e950243dd9>
  a skos:Concept;
  skos:prefLabel "blokfluiten"@nl;
  skos:scopeNote "Europese, doorgaans houten bekfluiten met zeven vingergaten en één duimgat. (AAT-Ned)"@nl;
  skos:altLabel "blokfluit"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb8452c9-b583-46e0-9d75-37a16e210a13>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e018892e-2ab6-44cf-9b6d-97bf8dbd38d8>
  a skos:Concept;
  skos:prefLabel "lepelrekken"@nl;
  skos:scopeNote "Houders op een voet, met in het midden een kolom, waaraan lepels kunnen worden opgehangen. Gebruik 'lepelvaasjes' voor kleine vazen met een geschulpte rand waarin lepels worden bewaard. (AAT-Ned)"@nl;
  skos:altLabel "lepelrek"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e03ebfe2-387b-40f4-813b-209937368273>
  a skos:Concept;
  skos:prefLabel "seriepublicaties"@nl;
  skos:scopeNote "Publicaties in een medium die worden uitgegeven in opeenvolgende delen, die genummerd of chronologisch zijn, en die zijn bedoeld om voor onbepaalde tijd door te lopen. (AAT-Ned)"@nl;
  skos:altLabel "seriepublicatie"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91712616-6dec-4871-8fdc-c317850c20d1>;
