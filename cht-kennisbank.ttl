  a skos:Concept;
  skos:prefLabel "iepenhout"@nl;
  skos:scopeNote "Iepenhout is een inheemse houtsoort dat afkomstig is van de iep. Het hout is zeer taai, vrij hard en wordt weinig gebruikt als timmerhout omdat het snel door houtworm wordt aangetast als het niet regelmatig in trilling wordt gebracht. (Haslinghuis)"@nl;
