  skos:scopeNote "Lange, smalle gutsen waarmee groeven worden gemaakt; ze zijn gewoonlijk aan de buitenkant afgeschuind, hoewel ze ook aan de binnenkant kunnen zijn geslepen. (AAT)"@nl;
  skos:altLabel "steekguts"@nl;
