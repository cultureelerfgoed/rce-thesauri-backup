<https://data.cultureelerfgoed.nl/term/id/cht/5d289606-94a9-4cce-9bc4-d9439c8e0d1a>
  a skos:Concept;
  skos:prefLabel "beugsloepen"@nl;
  skos:scopeNote "In de 19e eeuw kwamen de beugsloepen in zwang. Ze waren slank, hadden twee masten, zeilden goed en hebben zich vooral in Middelharnis, Pernis en Zwartewaal nog lang gehandhaafd. Later bouwde men ze van staal in plaats van hout; zij waren echter uitsluitend voor de beugvisserij ingericht, hun masten konden niet gestreken worden."@nl;
  skos:altLabel "beugsloep"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fefa35fc-3433-4b92-b11d-30601b115ae7>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6bcfd463-fc3f-4a52-bbde-5cc5eceee10e>
  a skos:Concept;
  skos:prefLabel "mijnenleggers"@nl;
