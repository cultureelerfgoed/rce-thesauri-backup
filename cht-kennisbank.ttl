<https://data.cultureelerfgoed.nl/term/id/cht/e11aeee0-2a74-4328-a6be-ad58ee3b02f3>
  a skos:Concept;
  skos:prefLabel "waslaag"@nl;
  skos:scopeNote "(dunne) beschermende laag was."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/23f4a4f6-51d8-47e6-9dc0-15f0647bfc02>;
