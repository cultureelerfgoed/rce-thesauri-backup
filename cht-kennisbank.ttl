<https://data.cultureelerfgoed.nl/term/id/cht/1012886b-7b25-4882-886e-32c012ec7996>
  a skos:Concept;
  skos:prefLabel "vogelbekstroomlijnen"@nl;
  skos:scopeNote "Een vogelbekstroomlijn is een race kuip voor motorfietsen, die leek op de top alf, maar een klein spatbordje aan de voorkant had dat op een vogelbek leek."@nl;
  skos:altLabel "vogelbekstroomlijn"@nl;
