<https://data.cultureelerfgoed.nl/term/id/cht/d5c533a0-19b2-46df-a2da-a5599489785f>
  a skos:Concept;
  skos:prefLabel "bungalows"@nl;
  skos:scopeNote "Bungalows zijn vrijstaande eengezinshuizen, waarvan alle vertrekken op één niveau liggen, met plat dak of geringe dakhelling. Wordt ook gebruikt als vakantiehuisje."@nl;
  skos:altLabel "bungalow"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/27a69fff-57b2-4d81-a8ae-9102d21d03e2>;
