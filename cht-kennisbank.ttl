  a skos:Concept;
  skos:prefLabel "veelluiken"@nl;
  skos:scopeNote "Beeldend werk dat uit meer dan drie naast elkaar gehangen delen bestaat. Het is meestal gebeeldhouwd of geschilderd en komt voor als altaarstuk."@nl,
