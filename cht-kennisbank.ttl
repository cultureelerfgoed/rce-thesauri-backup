  a skos:Concept;
  skos:prefLabel "opalescent"@nl;
  skos:scopeNote "Opalescenten, opaliserende middelen, zijn stoffen die glas ondoorzichtig maken. De Romeinen gebruikten calciumantimonaat. Rond 500 na Chr. was tinoxide in gebruik. In de 18de eeuw werd dit opgevolgd door calciumfluoride en loodarsenaat."@nl,
    "Een opalescent is een middel waarmee men normaliter doorzichtig materiaal zoals ruiten, glaswerk of vernis ondoorschijnend kan maken."@nl;
  skos:altLabel "opalescenten"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

