<https://data.cultureelerfgoed.nl/term/id/cht/cf0631cc-91f7-4152-8eeb-c2122e34d48e>
  a skos:Concept;
  skos:prefLabel "asfaltbitumen"@nl;
  skos:scopeNote "Asfaltbitumen is een algemene benaming voor een groep bouwproducten op basis van natuurasfalt of penetratiebitumen. Bij gebouwen wordt het zwarte materiaal onder andere toegepast op daken en in de wegenbouw bij het aanleggen van asfaltwegen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d4b495e6-c842-428a-ab14-7f818b1efa66>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f4053914-3cc4-4ad0-9fc4-8256266da0d4>
  a skos:Concept;
  skos:prefLabel "teerbitumen"@nl;
  skos:scopeNote "Teerbitumen is een algemene benaming voor een groep bouwproducten op basis van steenkoolteer of houtteer. Teerproducten worden onder andere door destillatie gefabriceerd."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d4b495e6-c842-428a-ab14-7f818b1efa66>;
