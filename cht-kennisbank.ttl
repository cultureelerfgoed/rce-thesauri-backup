  skos:scopeNote "Trompetgewelven zijn waaiergewelven zonder ribben, een decoratieve gewelfvorm die veel voorkomt in de Engelse late gotiek. (Haslinghuis)"@nl;
  skos:altLabel "trompetgewelf"@nl;
