  a skos:Concept;
  skos:prefLabel "pijpenpotten"@nl;
  skos:scopeNote "In een pijpenpot werden de kleipijpen geplaatst en vervolgens gebakken. De pot is inwendig gevoerd met een laag pijpaarde om de pijpen tijdens het bakken wit te houden.(Museum Rotterdam)"@nl;
  skos:altLabel "pijpenpot"@nl;
