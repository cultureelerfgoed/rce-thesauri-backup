<https://data.cultureelerfgoed.nl/term/id/cht/e6cc44c3-be2f-4436-ac8e-dfe1ff107087>
  a skos:Concept;
  skos:prefLabel "midden neolithicum"@nl;
  skos:scopeNote "Het midden-neolithicum wordt gekenmerkt door de overgang van Rössen naar de Michelsberg cultuur in Zuid Nederland. In West, Midden en Noord Nederland vinden we de overgang naar een ‘extended broad spectrum economy’, waarbij binnen de voedselvoorziening landbouw en veeteelt steeds meer als aanvulling gebruikt worden op de mesolithische leefwijze van jagen, vissen en voedsel verzamelen. In de latere fases van het midden-neolithicum worden in Noord Nederland de Hunebedden gebouwd."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c4ab6f91-0e1c-498b-8077-ebf8dc2cfda9>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/55d4bbcb-faf0-44ee-a95e-a98addb2e3ff>,
    <https://data.cultureelerfgoed.nl/term/id/cht/58777e10-52fd-47cd-a2fa-4dae63819cc6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e50be535-bf02-45eb-bd65-284e31fcbf27>
  a skos:Concept;
  skos:prefLabel "vijfroeders"@nl;
