<https://data.cultureelerfgoed.nl/term/id/cht/cb108e9b-1f5d-4072-a99e-539ea646632a>
  a skos:Concept;
  skos:prefLabel "stekelroggen"@nl;
  skos:scopeNote "Familie van roggen bij welke boven- en onderkant van het lichaam met harde en puntige doorntjes bezaaid zijn. De stekelrog of gewone rog (Raja clavata) is een rog uit de familie Rajidae. (Wikipedia/MARDOC)"@nl;
  skos:altLabel "Raja bonaespeiensis"@nl, "Raja pontica"@nl, "Raia aspera"@nl, "Raia rubus"@nl,
    "Raja aspera"@nl, "Cephaleutherus maculatus"@nl, "Raia rhizacanthus"@nl, "Raja leiobatos"@nl,
    "Hieroptera abredonensis"@nl, "Raja clavata"@nl, "Raja rubus"@nl, "stekelrog"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/78672fa4-8815-4427-995e-21a2cc90bd39>;
