<https://data.cultureelerfgoed.nl/term/id/cht/0cd9e0cb-0d7f-44cb-8882-864dd8a0a673>
  a skos:Concept;
  skos:prefLabel "vissershuizen"@nl;
  skos:scopeNote "Vissershuizen zijn de huizen van vissers en hun gezinnen. Vaak zijn er ook bedrijfsruimten aanwezig om vis te verwerken, gereedschap op te slaan en gereedschap, zoals netten, te repareren. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "visserswoningen"@nl, "vissershuis"@nl, "visserswoning"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b394b67c-f229-46f4-afe1-bc234818ca26>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/bf0be890-56d3-4f65-89ed-7c3ae8926587>
  a skos:Concept;
  skos:prefLabel "molenaarswoningen"@nl;
  skos:scopeNote "Een molenaarswoning is een woning voor de molenaar, meestal gelegen naast of in de directe nabijheid van een molen. Deze woningen zijn functioneel ontworpen en bieden onderdak aan de molenaar en zijn gezin, zodat zij dicht bij de molen konden werken en toezicht houden. Molenaarswoningen bestaan vaak uit één bouwlaag met een kap en zijn traditioneel gebouwd."@nl;
  skos:altLabel "molenaarshuizen"@nl, "molenaarswoning"@nl, "molenaarshuis"@nl, "molenhuis"@nl,
    "molenhuizen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/68a2ee6d-9205-424e-9540-43d27b6a483f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/342e4a2c-1c9f-400c-810d-9f0babe71827>
  a skos:Concept;
  skos:prefLabel "kilometerpalen"@nl;
  skos:scopeNote "Paal waarop de kilometrering van een weg wordt aangegeven. (BRT)"@nl;
  skos:altLabel "kilometerpaal"@nl;
