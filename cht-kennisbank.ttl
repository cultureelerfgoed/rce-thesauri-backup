  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fab4313d-4d0d-4d8e-9123-f03b13cd13fb>
  a skos:Concept;
  skos:prefLabel "knipsters"@nl;
  skos:scopeNote "Knipsters knippen stoffen of textiel in patronen voor kledingproductie. Zij werken in naaiateliers of confectie-industrie, vaak op basis van maatvoering en snijtekeningen."@nl;
  skos:altLabel "knipster"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db4a7619-d236-4b14-8e79-b4a6e890f677>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/faf8720c-5351-451c-8ae0-f8e6be079810>
  a skos:Concept;
  skos:prefLabel "bouwkundig tekenaars"@nl;
  skos:scopeNote "Bouwkundig tekenaars maken technische tekeningen voor bouwprojecten. Zij vertalen ontwerpen van architecten naar werktekeningen met maatvoering en details."@nl;
  skos:altLabel "bouwkundig tekenaar"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db4a7619-d236-4b14-8e79-b4a6e890f677>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/cc138b5c-aac1-4e27-913f-d9761d4f0cb0>
  a skos:Concept;
  skos:prefLabel "gasstellen"@nl;
  skos:scopeNote "Een gasstel is een kooktoestel met een of meer branders, werkend op gas. Wordt gebruikt om voedsel te bereiden in keukens of buitenshuis, bijvoorbeeld bij kamperen."@nl;
  skos:altLabel "gasstel"@nl;
