<https://data.cultureelerfgoed.nl/term/id/cht/1ac5a157-1acc-46c8-a63c-a2b4c7415008>
  a skos:Concept;
  skos:prefLabel "administratiekosten"@nl;
  skos:scopeNote "Administratiekosten zijn de onkosten voor administratie."@nl, "Administratiekosten zijn de kosten, die b.v. een geldverstrekker of dienstvelener in rekening brengt voor een administratieve afhandeling. (bron: encyclo.nl)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a1cfbaa8-218d-412b-a1e3-d539aedf8cf2>;
