<https://data.cultureelerfgoed.nl/term/id/cht/8ec2fc9f-814c-495d-b7e3-b38b394fbb60>
  a skos:Concept;
  skos:prefLabel "transporthelikopters"@nl;
  skos:scopeNote "Een transporthelikopter is een helikopter die wordt gebruikt voor het transport van militair materieel en troepen."@nl;
  skos:altLabel "transporthelikopter"@nl;
