<https://data.cultureelerfgoed.nl/term/id/cht/3ce45b0a-d1ed-4561-aa1f-5023c4b54ff0>
  a skos:Concept;
  skos:prefLabel "veldpodzol"@nl;
  skos:scopeNote "Humuspodzolgronden met een humushoudende bovengrond dunner dan 30cm. Dergelijke gronden worden hoofdzakelijk aangetroffen in jonge ontginningsgebieden. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d5b3a28d-a8aa-4754-8988-6b22cc481348>;
