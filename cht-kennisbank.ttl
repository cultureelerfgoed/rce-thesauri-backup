<https://data.cultureelerfgoed.nl/term/id/cht/d4552b9f-db61-4164-8b4a-6c593022bddb>
  a skos:Concept;
  skos:prefLabel "duveljagers"@nl;
  skos:scopeNote "Duveljagers zijn profilering aan houten ramen, kozijnen, schilderijlijsten en balken, bestaande uit een ingesnoerde kwartronde overgang tussen twee haaks op elkaar staande vlakken, toegepast sinds midden 18e eeuw. De profilering wordt gemaakt met een klein beukenhouten schaafje, een duveljager, waarmee een leerjongen (duvelstoejager) oefende. (Haslinghuis)"@nl;
  skos:altLabel "duivejager"@nl, "duivejagers"@nl, "duveljager"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/50a5ae33-53bb-4d8c-bc1c-6bf463de641c>;
