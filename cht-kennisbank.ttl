<https://data.cultureelerfgoed.nl/term/id/cht/97b3c64b-a0c5-4d4f-8d4c-983ba7679612>
  a skos:Concept;
  skos:prefLabel "directoria"@nl;
  skos:scopeNote "Kerkelijke kalender, waarin dag voor dag is aangetekend welke zon- of feestdag moet worden gevierd, welk misformulier en welke liturgische kleur van de dag moet worden gebruikt en hoe de getijden moeten worden gebeden. Het boek komt alleen voor in gedrukte vorm. (Religieus Erfgoedthesaurus)"@nl;
  skos:altLabel "directorium"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b2619bd2-0cdc-4fb1-9998-a69d9ab08421>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/98710de8-d0d1-4d6b-ab3a-0e49c3ce0688>
