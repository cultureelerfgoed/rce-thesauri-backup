<https://data.cultureelerfgoed.nl/term/id/cht/063ab54b-4fff-489a-b2f1-c29075a04340>
  a skos:Concept;
  skos:prefLabel "driescharnierspanten"@nl;
  skos:scopeNote "Spant, bestaande uit twee gebogen of geknikte delen die beweeglijk op de ondergrond rusten en ook aan de bovenkant beweeglijk tegen elkaar staan. In hout, ijzer en beton sedert begin XX. scharnier 2. (Haslinghuis)"@nl;
  skos:altLabel "driescharnierspant"@nl;
