  a skos:Concept;
  skos:prefLabel "driedekkers"@nl;
  skos:scopeNote "Op het eind van de 18e eeuw volgde een ontwikkeling uit het retourschip waarbij de kuil tussen bakdek en halfdek werd afgesloten. Zo ontstond er een derde doorlopend dek; vandaar de naam. (MARDOC)"@nl,
    "Schip, waarbij de ruimte tussen bakdek en halfdek doorlopend is overdekt en geen sprake is van een kuil."@nl;
  skos:altLabel "driedekker"@nl;
