<https://data.cultureelerfgoed.nl/term/id/cht/aff33552-3986-4e41-969c-203b84605324>
  a skos:Concept;
  skos:prefLabel "spieringen"@nl;
  skos:scopeNote "Spieringen (Osmeridae) zijn een familie van kleine anadrome en straalvinnige vissen uit de orde van de Spieringachtigen (Osmeriformes). De familie bestaat uit zo'n 16 soorten in zes geslachten. (Wikipedia)"@nl;
  skos:altLabel "Osmeridae"@nl, "spiering"@nl;
