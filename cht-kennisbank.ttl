<https://data.cultureelerfgoed.nl/term/id/cht/f01e0c69-b2c7-4c74-afe0-cd2531e20a09>
  a skos:Concept;
  skos:prefLabel "kruispannen"@nl;
  skos:scopeNote "Kruispannen zijn machinaal vervaardigde dakpannen met kop- en zijsluiting, die in opvolgende lagen een halve pan verschuiven. Ze zijn te herkennen aan de kruislingse ligging en de knobbel midden aan de onderkant, waarmee de pan over de wel van de onderliggende pannen ligt. Meestal tussen ca. 1880 en 1940 in Echt (L.) gefabriceerd en daarom ook Echter pannen genoemd."@nl;
  skos:altLabel "Echter pan"@nl, "Echter pannen"@nl, "bouletpan"@nl, "bouletpannen"@nl,
    "kruispan"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f1834398-e32b-4a85-acf4-7f71ab3f94d1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/043c38f3-18de-4bab-9ef0-4d490e9c79f5>
  a skos:Concept;
  skos:prefLabel "chine collé"@nl;
  skos:scopeNote "Een verstevigingstechniek die wordt gebruikt bij het drukken, waarbij een dun vel papier, oorspronkelijk Chinees paper, op een zwaarder, ondersteunend vel wordt geplakt en tegelijkertijd wordt afgedrukt. (Project Fotografie)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2d28d9aa-77e8-40ab-b0fe-f04d99f57955>;
