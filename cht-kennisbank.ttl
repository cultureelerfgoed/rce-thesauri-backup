<https://data.cultureelerfgoed.nl/term/id/cht/775117c7-3ece-4bb8-964b-86e0a661bf0f>
  a skos:Concept;
  skos:prefLabel "wintertuinen"@nl;
  skos:scopeNote "Wintertuinen zijn verwarmbare verblijfruimtes behorend bij een landhuis of hotel, doorgaans met bovenlicht en veel glas, waar exotische planten staan opgesteld. Het kan een vrijstaand gebouw zijn of een aanbouw. (Haslinghuis)"@nl;
  skos:altLabel "wintertuin"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b8604da5-da46-49e4-98cb-978c7b3880f3>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ca2ecdc0-54fc-4162-9acc-9b23dc0f8490>
  a skos:Concept;
  skos:prefLabel "wijngaarden"@nl;
  skos:scopeNote "De wijngaard is een stuk grond, waar druiven geteeld worden voor de wijnproductie."@nl;
