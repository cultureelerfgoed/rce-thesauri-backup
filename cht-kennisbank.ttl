<https://data.cultureelerfgoed.nl/term/id/cht/11346d37-d832-4677-bfec-abf233d7103b>
  a skos:Concept;
  skos:prefLabel "hoofdofficieren (luchtmacht)"@nl;
  skos:scopeNote "Hoofdofficieren bij de luchtmacht vormen een middelhoge officiersrang die verantwoordelijk is voor het beheer en de leiding van luchtoperaties en squadroncommandanten."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/144883a5-7f82-404f-9698-f1e7f7fec8a5>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/fe492022-88dd-4c51-a179-e7d8d693fa17>,
