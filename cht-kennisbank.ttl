<https://data.cultureelerfgoed.nl/term/id/cht/7f1328af-82b5-4931-b0b8-f41f628c5ec7>
  a skos:Concept;
  skos:prefLabel "bijenschuren"@nl;
  skos:scopeNote "Bijenschuren zijn eenvoudige schuurtjes waarin de bijenkorven staan. (Agriwiki)"@nl,
    "Plaats waar een imker een aantal bijenkorven of –kasten heeft staan, meestal beschut door een wal en/of afdak en omgeven door voor de bijen aantrekkelijke beplanting (drachtplanten). (Thesaurus landschap)"@nl;
  skos:altLabel "bijenschuur"@nl, "bijenstal"@nl, "bijenstallen"@nl, "iemenschuren"@nl,
    "iemenschuur"@nl;
