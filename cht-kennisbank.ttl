<https://data.cultureelerfgoed.nl/term/id/cht/60273745-2326-4a7c-ba5f-7dfcca4474fa>
  a skos:Concept;
  skos:prefLabel "rietvorsten"@nl;
  skos:scopeNote "Een dakpan die bij een rieten dak als nokafwerking (nokvorst) wordt toegepast. De nokafwerking van een rieten dak wordt meestal gerealiseerd met rode of zwarte vorstpannen. Een speciaal hiervoor gemaakte halfronde pan, die voor een mooie afwerking van het dak zorgt. Deze pannen worden gelegd in specie met tussen de pannen een mooie halfronde voeg. (joostdevree)"@nl;
  skos:altLabel "rietvorst"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/33555589-3dce-4f0a-a54c-83480a1ee810>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/9daafa9c-63e4-48db-8fdc-3cd7e13e8f5c>,
    <https://data.cultureelerfgoed.nl/term/id/cht/9f593ce6-cc37-4fc4-944d-c730340bc538>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/63ffd12f-3ece-493b-a9f7-819506522ac7>
  a skos:Concept;
  skos:prefLabel "ornamentvorsten"@nl;
  skos:scopeNote "Ornamentvorsten zijn vorstpannen met aan de bovenzijde een groef, waarin vorstkam-elementen kunnen worden geplaatst."@nl;
  skos:altLabel "ornamentvorst"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/33555589-3dce-4f0a-a54c-83480a1ee810>;
