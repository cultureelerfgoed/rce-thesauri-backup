<https://data.cultureelerfgoed.nl/term/id/cht/ae6c2014-de6c-4ef6-a519-5215bb4a7112>
  a skos:Concept;
  skos:prefLabel "Duitse spanten"@nl;
  skos:scopeNote "Spant waarbij vanuit een centraal gelegen knooppunt staven naar de top, voeten en andere punten van de spantbenen lopen. (Haslinghuis)"@nl;
  skos:altLabel "Duitse spant"@nl;
