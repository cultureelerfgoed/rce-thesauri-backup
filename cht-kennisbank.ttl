<https://data.cultureelerfgoed.nl/term/id/cht/a9f64cf9-54de-469f-8dc7-99f04e0aa189>
  a skos:Concept;
  skos:prefLabel "activeringsanalyse"@nl;
  skos:scopeNote "Een onderzoeksmethode voor het zoeken van chemische elementen in een materiaal door het materiaal te beschieten met neutronen, met geladen deeltjes zoals protonen, of met gammafotonen. (AAT)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c31c17cc-ac7d-4a4e-bc63-41f888e1a047>;
