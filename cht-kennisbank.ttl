<https://data.cultureelerfgoed.nl/term/id/cht/1cb09375-73fd-48af-ad47-b1ca8cfe258d>
  a skos:Concept;
  skos:prefLabel "generaliteitspalen"@nl;
  skos:scopeNote "Generaliteitspalen zijn grenspalen die de bezittingen van de generaliteit aanduiden. Onder generaliteit worden de acties en bezittingen van de Staten-Generaal aangeduid. De Staten-Generaal waren in de Republiek der Zeven Verenigde Provinciën (1588-1795) uitgegroeid tot de centrale regering. (Wikipedia)"@nl;
  skos:altLabel "generaliteitspaal"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d0672d52-28d1-439e-9af1-9aa0a834b681>;
