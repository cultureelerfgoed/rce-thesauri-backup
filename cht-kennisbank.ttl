<https://data.cultureelerfgoed.nl/term/id/cht/2ba89a27-f47e-4e92-9c05-5c37f89ca874>
  a skos:Concept;
  skos:prefLabel "clumpen"@nl;
  skos:scopeNote "Een schor is een buitendijks gebied dat alleen bij uitzonderlijk hoog water overstroomt. Een schordijk is een zeer lage dijk aan de waterzijde van de schor. Bij hoog water blijft er daardoor veel slib achter in de schor."@nl;
  skos:altLabel "boomclump"@nl, "boomclumpen"@nl, "clump"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2971af0-cde7-4888-b828-33443f702e7d>;
