<https://data.cultureelerfgoed.nl/term/id/cht/026aee38-538e-4801-b6dc-6e51bfc8c2e6>
  a skos:Concept;
  skos:prefLabel "foyers"@nl;
  skos:scopeNote "Foyers zijn zalen waar de bezoekers van een theater zich verpozen. Dergelijke zalen bestaan ook voor artiesten. (Haslinghuis)"@nl;
  skos:altLabel "foyer"@nl, "wandelzaal (theaters)"@nl, "wandelzalen (theaters)"@nl;
