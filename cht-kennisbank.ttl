  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e243aa02-8016-4585-b202-0851a7707032>
  a skos:Concept;
  skos:prefLabel "optische en visuele kenmerken"@nl;
  skos:scopeNote "Optische en visuele kenmerken zijn eigenschappen van objecten die hun interactie met licht en hun visuele waarneming bepalen, zoals kleur, helderheid, reflectie en doorzichtigheid."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/ff8bfbe9-547e-492f-abd7-c7086269ffbb>,
