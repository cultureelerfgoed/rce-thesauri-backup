<https://data.cultureelerfgoed.nl/term/id/cht/34dbc15c-6620-4b8e-9e08-d632b56f497b>
  a skos:Concept;
  skos:prefLabel "blokverbanden (siermetselwerk)"@nl;
  skos:scopeNote "Metselwerk, sierverband (metselverband) van beurtelings in blokken aangebrachte groepen koppen en strekken, soms als klamplaag. O.a. ter versiering van boogvelden en vloeren. Eigenlijk kan men niet van verband spreken, omdat er geen onwrikbaar geheel van bakstenen ontstaat. (Haslinghuis)"@nl;
  skos:altLabel "blokverband (siermetselwerk)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d9206cdd-5dbc-493a-9b4c-ba40bcff3bb9>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d9206cdd-5dbc-493a-9b4c-ba40bcff3bb9>
  a skos:Concept;
  skos:prefLabel "siermetselwerk"@nl;
  skos:scopeNote "Gevelmetselwerk waarin patronen zijn gemaakt met vaak anders gekleurde bakstenen. (Haslinghuis)"@nl;
