<https://data.cultureelerfgoed.nl/term/id/cht/8f2eff7c-bbf0-4d13-bfa1-83f03d495a99>
  a skos:Concept;
  skos:prefLabel "gevelhaken"@nl;
  skos:scopeNote "Dubbel omgebogen stalen haak, waarmee het gewicht van een gevelonderdeel overgebracht kan worden op een stut, waarna het gedeelte van de gevel onder de haak of een reeks haken kan worden weggebroken. (Haslinghuis)"@nl;
  skos:altLabel "gevelhaak"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aefdd718-b34b-4024-9583-123686fbc209>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8f4bb764-9e28-4757-8ea0-133bc12de820>
  a skos:Concept;
  skos:prefLabel "slangenboren"@nl;
  skos:scopeNote "Boorijzer met spiraal onderaan, omgeven door snijmessen en een wijde spiraal naar boven. (Haslinghuis)"@nl;
