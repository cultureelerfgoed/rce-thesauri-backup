<https://data.cultureelerfgoed.nl/term/id/cht/960db084-a70c-4bd7-b7a5-55fd1fa0f32d>
  a skos:Concept;
  skos:prefLabel "langhuisstolpen"@nl;
  skos:scopeNote "Langhuisstolpen zijn stolpen met aan de voorzijde een uitgebouwd woonhuis, ook wel voorend genoemd. Doorgaans liggen woonhuis en stal in elkaars verlengde."@nl;
  skos:altLabel "langhuisstelp"@nl, "langhuisstelpen"@nl, "langhuisstolp"@nl;
