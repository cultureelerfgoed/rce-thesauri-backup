<https://data.cultureelerfgoed.nl/term/id/cht/7b9dcc2b-3848-4253-94fc-a97782832c3e>
  a skos:Concept;
  skos:prefLabel "witstoelen"@nl;
  skos:scopeNote "Hangsteiger. Houten constructie met raderinrichting waarin de schilder stond bij het witten van de kerkgewelven. De witstoel hing aan touwen die door de gewelven heen aan de dakconstructie bevestigd waren. Het enige zo genoemde exemplaar staat in de Onze-Lieve-Vrouwekerk te Breda, en stamt uit 1754."@nl;
  skos:altLabel "witstoel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
