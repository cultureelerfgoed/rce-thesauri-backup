<https://data.cultureelerfgoed.nl/term/id/cht/a3d6f13d-d13b-4d37-9282-d77dcb421669>
  a skos:Concept;
  skos:prefLabel "media (schilder- en tekenmateriaal)"@nl;
  skos:scopeNote "Te gebruiken voor de materialen die worden gebruikt bij het vervaardigen van een kunstwerk, zoals inkt op papier of papier-maché; vaak wordt een bepaalde techniek of technieken direct geassocieerd met de materialen. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a4eede1e-43fc-485d-bb85-c92c4459793d>
  a skos:Concept;
  skos:prefLabel "dessertborden"@nl;
  skos:scopeNote "Borden voor een individuele portie van de dessertgang van een maaltijd, gelijk aan platte borden, maar dan kleiner. (AAT-Ned)"@nl;
  skos:altLabel "dessertbord"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e1f4015f-e923-4852-ad1f-2e19995b406c>;
