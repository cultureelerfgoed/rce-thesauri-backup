<https://data.cultureelerfgoed.nl/term/id/cht/94e0f322-bc21-4592-961f-0a8a89d0a884>
  a skos:Concept;
  skos:prefLabel "grootlichten"@nl;
  skos:scopeNote "Grootlicht vormt de omschrijving, waarbij de stralenbundel van de koplampen ongehinderd naar voren schijnt."@nl;
  skos:altLabel "grootlicht"@nl;
