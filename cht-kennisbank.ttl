  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/1208677a-b5f1-43bb-b904-17a01d02e8f3>
  a skos:Concept;
  skos:prefLabel "petroleumgas"@nl;
  skos:scopeNote "Petroleumgas, onderdeel van de groep petroleumproducten, is een gasvormig mengsel van koolwaterstoffen dat vrijkomt bij de raffinage van aardolie. Het wordt veelvuldig gebruikt als brandstof en in de chemische industrie."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/79a3c2cb-a3ed-493a-865d-6da68c845f89>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8caf5937-3be9-472a-86ad-0602ce4018ce>
  a skos:Concept;
  skos:prefLabel "houtachtig plaatmateriaal"@nl;
  skos:scopeNote "Houtachtig plaatmateriaal, een vorm van plaatmaterialen, omvat producten zoals multiplex en MDF, die worden vervaardigd uit houtvezels of houtlagen voor gebruik in bouw en meubels."@nl;
