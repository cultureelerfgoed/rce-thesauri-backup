<https://data.cultureelerfgoed.nl/term/id/cht/01c6a6a8-ca44-432d-a8e8-65f254b4fb35>
  a skos:Concept;
  skos:prefLabel "luchthavencomplexen"@nl;
  skos:scopeNote "Verwijst meestal naar grote percelen open, vlak land waarop start- en landingsbanen, hangars, stationsgebouwen en andere bouwwerken zijn verrezen, bestemd voor het opstijgen, landen, laden en lossen en onderhouden van vliegtuigen. Zie 'vliegvelden' voor kleinere complexen die wel een start- en landingsbaan hebben, maar geen of weinig andere voorzieningen. (AAT-Ned)"@nl;
  skos:altLabel "luchthavencomplex"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/89af9530-a005-4f58-8b7f-b0658391fe4a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/0630caba-5c56-40ae-bbbd-f7c36b228d48>
  a skos:Concept;
  skos:prefLabel "rijbanen voor vliegverkeer"@nl;
  skos:scopeNote "Weg, bestemd voor luchtvaartuigen."@nl;
  skos:altLabel "rijbaan voor vliegverkeer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/31024480-ea4e-475f-acf5-bc31d7a54a9e>;
