  a skos:Concept;
  skos:prefLabel "diafragmaveren"@nl;
  skos:scopeNote "Veer in de vorm van een ring met radiaal naar binnen wijzende vingers. Wordt in de plaats van drukveren in toenemende mate voor koppelingen gebruikt."@nl;
