<https://data.cultureelerfgoed.nl/term/id/cht/9e3ca10c-38b7-48cb-9e03-284a0bd3a991>
  a skos:Concept;
  skos:prefLabel "actieve kool"@nl;
  skos:scopeNote "Actieve kool is koolstof met een groot inwendig oppervlak dat behandeld is om het zeer adsorberend te maken. Het wordt gebruikt voor het afvangen van vluchtige verontreinigingen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/21cde8aa-1fd4-431d-be6d-e6e72631ecdb>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/9e741afc-dde8-439e-b8f0-e550fb752e6e>
  a skos:Concept;
  skos:prefLabel "meteorologische instrumenten"@nl;
  skos:scopeNote "Een weerstation is een verzameling meteorologische instrumenten die het weer kunnen meten. Zo'n weerstation wordt vaak handmatig, maar tegenwoordig ook wel automatisch uitgelezen. (Wikipedia)"@nl;
  skos:altLabel "meteorologisch instrument"@nl;
