<https://data.cultureelerfgoed.nl/term/id/cht/ecd841f2-08c6-4801-8572-bb7527b9bbc5>
  a skos:Concept;
  skos:prefLabel "Oost-Indiëvaarders"@nl;
  skos:scopeNote "Oostindiëvaarder of Oostinjevaarder was de verzamelnaam voor alle soorten schepen (en hun bemanning) die vanaf de 17e eeuw tot in de 19e eeuw op 'De Oost' voeren. Volgens VOC archieven zijn er zo'n 4800 reizen naar de Oost gemaakt. (aatned.nl)"@nl;
  skos:altLabel "Oost-Indiëvaarder"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/32d80748-50d1-4c9c-b06d-dfca42e46ac6>;
