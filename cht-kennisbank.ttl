  a skos:Concept;
  skos:prefLabel "zijmorenes"@nl;
  skos:scopeNote "Een zijmorene is de benaming voor de puinmassa's die door een gletsjer worden afgezet in een andere richting dan die van de gletsjer zelf. (Wikipedia)"@nl;
  skos:altLabel "zijmorene"@nl;
