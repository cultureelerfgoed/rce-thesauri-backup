<https://data.cultureelerfgoed.nl/term/id/cht/8759f622-f4bf-49e7-8d08-5659842beab3>
  a skos:Concept;
  skos:prefLabel "drijvers (vangtuig)"@nl;
  skos:scopeNote "Vlotter, dobber: klein drijflichaam, meestal gebruikt voor kleine netten, markeringen en vislijnen. (De Binnenvaart)"@nl;
