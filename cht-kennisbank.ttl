<https://data.cultureelerfgoed.nl/term/id/cht/51121c7f-7cd8-4970-926c-0ee4f2dc2ffe>
  a skos:Concept;
  skos:prefLabel "afsluiting"@nl;
  skos:scopeNote "Hekwerk, borstwering van hout, steen of ijzer, o.a. om een kapel van de hoofdruimte van een kerk af te scheiden. Bij een koor onderscheidt men het koorhek van de koorafsluiting. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/df4db7b4-3b69-49a2-9068-13034f1a068f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/56133cf2-e496-4a5e-9166-c675a6e9ec02>
  a skos:Concept;
  skos:prefLabel "Neobarok"@nl;
  skos:scopeNote "De Neobarok inspireert zich op de barokke architectuur.(ca. 1840 tot het interbellum)"@nl;
  skos:altLabel "Neo-barok"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/53be61c5-deb7-4a04-8792-fc0718de4136>;
