  a skos:Concept;
  skos:prefLabel "grotmolens"@nl;
  skos:scopeNote "Molen waarbij kleine transport scheepjes binnen kunnen varen om maalgoed te brengen en meel weer mee te nemen. (Molenwoordenboek G.J. Pouw)"@nl;
