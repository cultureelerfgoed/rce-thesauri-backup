  a skos:Concept;
  skos:prefLabel "secundaire dragers"@nl;
  skos:scopeNote "Materiaal waaraan een primaire drager voor een werk wordt bevestigd. Het onderscheidende 'secundaire drager' wordt meestal gereserveerd voor situaties waarbij er ook een andere 'primaire drager' wordt gebruikt. Krijt kan bijvoorbeeld worden aangebracht op papier als primaire drager, waarmee een tekening ontstaat. De papierdrager kan vervolgens op karton als secundaire drager worden geplaatst. (Project Fotografie)"@nl;
  skos:altLabel "secundaire drager"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

