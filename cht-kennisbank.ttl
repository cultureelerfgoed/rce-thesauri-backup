  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c9d1d07d-c21f-4237-8a65-52aba88c67e5>
  a skos:Concept;
  skos:prefLabel "drachmen"@nl;
  skos:scopeNote "Kleine zilveren Griekse munten die oorspronkelijk gelijk waren aan zes obolen; ze werden in de 6e eeuw v.C. uitgegeven en daarna gebruikt door de Parthen en de Sassaniden tot de 7e eeuw n.C. (AAT)"@nl;
  skos:altLabel "drachme"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/306df5ea-fa8e-4352-bb98-55b82d1445dd>;
