  a skos:Concept;
  skos:prefLabel "zeerecht"@nl;
  skos:scopeNote "Het geheel van regelingen met betrekking tot de rechten en verplichtingen die uit de zeevaart voortvloeien, zowel van privaatrechterlijke als publiekrechterlijke aard."@nl;
