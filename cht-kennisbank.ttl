<https://data.cultureelerfgoed.nl/term/id/cht/7d866151-1695-43b6-b16d-901ab24d961c>
  a skos:Concept;
  skos:prefLabel "hostiestekers"@nl;
  skos:scopeNote "Metalen pons met houten handvat waarmee hosties uit ouwel werden gestoken. Sommige kloosters hadden een afzonderlijk vertrek voor een hostiestekerij. Het handmatige hostiesteken werd later overgenomen door hostiesteekmachines."@nl;
  skos:altLabel "hostiesteker"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/abfc1bb7-04d7-43a0-9e99-dd4c5a4f2c15>;
