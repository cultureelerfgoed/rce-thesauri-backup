<https://data.cultureelerfgoed.nl/term/id/cht/d02d3b6a-484b-4c28-8f86-ac99c41174c6>
  a skos:Concept;
  skos:prefLabel "xenodochia"@nl;
  skos:scopeNote "Gasthuis, hospitaal. In de Middeleeuwen. even buiten de klooster- en stadsmuren gelegen onderkomen voor reizigers, pelgrims en andere daklozen, baaierd. Het concilie van Nicea (325) schreef voor elke stad de oprichting van een xenodochium voor. (Haslinghuis)"@nl;
  skos:altLabel "xenodochium"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/488e9a8c-652e-425b-904c-e779e39b8779>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d720894a-5d4d-4d08-80fe-0fd56758a6f0>
  a skos:Concept;
