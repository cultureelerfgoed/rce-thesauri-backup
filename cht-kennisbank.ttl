<https://data.cultureelerfgoed.nl/term/id/cht/b64dc29e-dbbd-4578-85c7-7d8defe97171>
  a skos:Concept;
  skos:prefLabel "maillots"@nl;
  skos:scopeNote "Zware, ondoorzichtige kousen die aan één stuk geweven zijn met een slip. Gebruik 'panties' voor dunne kousen die uit één stuk gewoven zijn met een slip. Gebruik 'tricots' voor nauwsluitende combinaisons uit één geheel."@nl;
  skos:altLabel "maillot"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4e5fc3fa-a48d-4808-9513-ab98fb2610f2>;
