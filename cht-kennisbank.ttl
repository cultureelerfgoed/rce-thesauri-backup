  a skos:Concept;
  skos:prefLabel "plantaardige vezel"@nl;
  skos:scopeNote "Plantaardige vezels zijn vezels afkomstig van planten, zoals katoen en jute, gebruikt in textiel en andere industriële toepassingen vanwege hun duurzaamheid en milieuvriendelijkheid."@nl;
