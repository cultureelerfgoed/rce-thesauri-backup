<https://data.cultureelerfgoed.nl/term/id/cht/70451746-6a04-4d91-a9dc-2081172ba245>
  a skos:Concept;
  skos:prefLabel "Ludovicipannen"@nl;
  skos:scopeNote "Ludovicipannen zijn machinaal vervaardigde dakpannen met kop- en zijsluiting. De pannen werden gemaakt door het bedrijf Falzziegelwerke Carl Ludowici (1883-1972) in Jockgrim. De familie was afkomstig uit Italië en heette eigenlijk Ludovisi. Ze lijken op muldenpannen."@nl;
  skos:altLabel "Ludovicipan"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f1834398-e32b-4a85-acf4-7f71ab3f94d1>;
