  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/681382f3-cdb7-49f4-9bee-0633e921d846>
  a skos:Concept;
  skos:prefLabel "modelleren"@nl;
