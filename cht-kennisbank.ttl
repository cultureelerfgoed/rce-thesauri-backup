  a skos:Concept;
  skos:prefLabel "dameskleding"@nl;
  skos:scopeNote "Kleding ontworpen voor of gedragen door vrouwen, vaak gebruikt in commerciële context. (AAT-Ned)"@nl;
  skos:altLabel "vrouwenkleding"@nl;
