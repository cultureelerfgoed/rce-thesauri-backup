  a skos:Concept;
  skos:prefLabel "uniform resource locator"@nl;
  skos:scopeNote "Een Uniform Resource Locator (afgekort URL) is een gestructureerde naam die verwijst naar een stuk data. Voorbeelden zijn het unieke adres waarmee de locatie van een webpagina op internet wordt aangegeven of een e-mailadres. In de naam is alle informatie opgenomen over de benodigde techniek om de betreffende gegevens te bereiken. De URL is een bijzondere vorm van de URI."@nl;
  skos:altLabel "URL"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/31bf5543-c7d0-4c15-a603-9ce921a9607d>;
