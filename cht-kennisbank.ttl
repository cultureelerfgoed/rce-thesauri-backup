<https://data.cultureelerfgoed.nl/term/id/cht/2ccbf890-cb19-46ee-bd0c-99a6ca55fa27>
  a skos:Concept;
  skos:prefLabel "zetboorden"@nl;
  skos:scopeNote "Wegneembare plank of boord, die tijdelijk op het boeisel of een lage verschansing van een vaartuig wordt geplaatst om het vrijboord te verhogen en zo de golfslag en het buiswater te weren."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/333dad79-4b9e-4c77-924e-c4455b781628>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fd2bcb16-75ec-4023-a8a3-2a5b3fc3a011>
  a skos:Concept;
  skos:prefLabel "aardappelkuilen"@nl;
  skos:scopeNote "De aardappelkuil is een plek waar aardappelen vorstvrij werden opgeslagen. De aardappelkuil werd gegraven tot een halve meter diep, dieper mocht niet vanwege het grondwater, dan kwam er een laag stro, daarop de aardappels, hierop weer een flinke laag stro. Dan werd alles afgedekt met een flinke laag zand."@nl;
  skos:altLabel "aardappelkuil"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2971af0-cde7-4888-b828-33443f702e7d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

