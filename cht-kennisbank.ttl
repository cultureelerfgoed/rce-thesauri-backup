<https://data.cultureelerfgoed.nl/term/id/cht/20b5ae7a-3b6b-4642-b8ae-f603430f3b31>
  a skos:Concept;
  skos:prefLabel "eilandstations"@nl;
  skos:scopeNote "Eilandstations zijn emplacementstypen waarbij het station op een eilandperron is gesitueerd. Ze liggen vaak bij de kruising van de spoorbaan met een verbindingsweg tussen twee dorpen. De toegang tot het perron ligt op de overweg tussen beide sporen in. Dit type station wordt vaak in kleine dorpen toegepast."@nl;
  skos:altLabel "eilandstation"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/67b80a83-1ca9-45af-b266-d33d8bb13797>;
