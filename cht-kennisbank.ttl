<https://data.cultureelerfgoed.nl/term/id/cht/04943121-b0f2-422b-8dfd-d4b49d4309bc>
  a skos:Concept;
  skos:prefLabel "baleinwalvissen"@nl;
  skos:scopeNote "Baleinwalvissen zijn een groep binnen de walvissen die zich onderscheiden door het gebruik van baleinen in plaats van tanden om voedsel uit het water te filteren. Deze grote zeezoogdieren voeden zich voornamelijk met plankton en kleine vissen."@nl;
  skos:altLabel "baardwalvis"@nl, "baardwalvissen"@nl, "baleinwalvis"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/83b98f25-2272-457f-88ca-ebb148aa04d5>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/4f9503f7-845e-4613-bf2b-44c5e4160c9d>,
    <https://data.cultureelerfgoed.nl/term/id/cht/d9dc3b61-ad1a-4fbf-8665-7ff2ae9aad49>,
