<https://data.cultureelerfgoed.nl/term/id/cht/8ff0dcfb-21fd-4852-a452-e3a9b4bdecc7>
  a skos:Concept;
  skos:prefLabel "garages"@nl;
  skos:scopeNote "Gebruik voor gebouwen of delen van gebouwen waar motorvoertuigen worden geparkeerd of gehuisvest, meestal tijdelijk; gebruik 'benzinestations' voor gebouwen waar benzine, smeeroliën en andere koopwaar voor motorvoertuigen worden verkocht. (AAT-Ned)"@nl;
