    <https://data.cultureelerfgoed.nl/term/id/cht/4eca6e3a-96ff-4943-a6d7-4bc5710bbd45>,
    <https://data.cultureelerfgoed.nl/term/id/cht/ec711282-0697-4a64-b574-658bc32a2607>,
    <https://data.cultureelerfgoed.nl/term/id/cht/519face4-f82f-4296-aa30-8a728c7dc55c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d601edd6-b469-4d94-b615-bdfc3072c134>
  a skos:Concept;
  skos:prefLabel "aminohars"@nl;
  skos:scopeNote "Een aminohars is een thermohardend polymeer gemaakt uit een monomeer met aminogroepen, zoals ureum en melamine, dat men laat reageren met formaldehyde. De stof wordt gewoonlijk toegepast als oligomeer dat ter plaatse verder reageert. Aminoharsen werden gebruikt als verstevigingsmiddelen. Ze worden nu gebruikt voor de restauratie van deklagen op ceramiek."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f441e935-eea6-4606-9017-ce0b579c91e7>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d6116882-235f-4a11-b620-280876fb914c>
  a skos:Concept;
  skos:prefLabel "Rupert's druppels"@nl;
  skos:scopeNote "Rupert's druppels zijn holle glaasjes in de vorm van kikkervisjes, van ongeveer 50 mm lang, met een bol uiteinde, uitlopend in een dunne, gebogen staart. Ze zijn gemaakt door een beetje gesmolten glas in koud water te laten vallen en het te laten afkoelen. Ze kunnen wel tegen een tik op het bolle eind, maar als de staart wordt gebroken of gekrast, ontploft het ding met veel geluid tot een fijn poeder, ten gevolge van de inwendige spanningen. (Conservation Dictionary)"@nl;
  skos:altLabel "Prins Rupert's druppels"@nl, "Rupert's druppel"@nl, "knapglaasje"@nl,
    "knapglaasjes"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d604b9dd-f176-4223-96a0-746f3cee3415>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d64ac3de-ab07-4eb1-837f-afb83eb7bead>
  a skos:Concept;
  skos:prefLabel "kunstmatige veroudering"@nl;
  skos:scopeNote "Kunstmatig verouderen is een manier om de verouderingstijd van monsters te bekorten door ze bloot te stellen aan meer drastische omstandigheden dan ze normaal zouden ondervinden, zoals verhoogde vochtigheid, temperatuur en/of sterk vervuilde lucht. Als de snelheid van de verouderingsreactie van de eerste orde is of als zodanig kan worden beschouwd, kan de vergelijking van Arrhenius worden gebruikt om de vervalsnelheid bij normale temperatuur te berekenen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d65c02ab-7df8-4d04-8ef3-a4246ef35cc7>
  a skos:Concept;
  skos:prefLabel "vlakplaten"@nl;
  skos:scopeNote "Vlakplaten zijn dikke, zware ijzeren of granieten platen van zuiver rechthoekige vorm, waarvan het bovenvlak en de zijkanten geschaafd of geslepen zijn. Zij dienen bij het afschrijven van verschillende stukken als onderlegger en bij het vlakken van onderdelen."@nl;
  skos:altLabel "richtplaat"@nl, "richtplaten"@nl, "vlakplaat"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d683882c-d17d-4cd9-ae13-756742749f68>
  a skos:Concept;
  skos:prefLabel "Esperanto"@nl;
  skos:scopeNote "Esperanto is een door Lejzer Zamenhof ontworpen, relatief gemakkelijk te leren, politiek neutrale, internationale taal (kunsttaal). In 1887 publiceerde hij onder het pseudoniem Dr. Esperanto - \"iemand die hoopt\" - het eerste boek over de taal met de titel: La internacia lingvo (de internationale taal). De taal werd echter bekend onder Zamenhofs pseudoniem en kreeg zo de naam Esperanto."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ba8a0df0-e7c1-48f4-ab90-dfde6c264f0e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d6e4c18a-ccf3-4b2e-bc7e-5313307f642e>
  a skos:Concept;
  skos:prefLabel "balustradeorgels"@nl;
  skos:scopeNote "Het balustradeorgel is een pijporgel dat met de voorzijde een geheel uit maakt met de balustrade van het orgelbalkon. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "balustradeorgel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa9cda1e-c01d-431e-9f74-51d3073b97d5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d70e8d8f-1de6-4f5e-9488-a53833d4ed05>
  a skos:Concept;
  skos:prefLabel "geïmpregneerde draden"@nl;
  skos:scopeNote "Geïmpregneerde draden zijn korte stukken draad of filament waarop een lijm is aangebracht. In de textielconservering worden ze gebruikt om beschadigde delen te consolideren of te ondersteunen, wanneer een steunlaag geen geschikte oplossing biedt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d7114fe0-366a-437e-b9cf-77bd288753cb>
  a skos:Concept;
  skos:prefLabel "krampistolen"@nl;
  skos:scopeNote "Een krampistool is een stuk gereedschap dat wordt gebruikt om een lijst in elkaar te zetten door metalen krammen in de achterkant van de versteknaad te schieten."@nl;
  skos:altLabel "krampistool"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d7326d12-68af-4ff6-804a-212f72e09a1a>
  a skos:Concept;
  skos:prefLabel "ophangsystemen"@nl;
  skos:scopeNote "Een ophangsysteem is een methode om vlakke textiel zoals wandtapijten op te hangen. In de textielconservering wordt klittenband het meest gebruikt. (Conservation Dictionary)"@nl;
  skos:altLabel "ophangsysteem"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
