<https://data.cultureelerfgoed.nl/term/id/cht/325f8fba-8208-4cb0-b72b-034494371210>
  a skos:Concept;
  skos:prefLabel "tierceronnen"@nl;
  skos:scopeNote "Tiercerons zijn hulpribben, steekribben in een gewelf. De tierceron gaat van een kapiteel of andere drager op en loopt schuin, ook tov de hoofddiagonalen. Hij komt niet uit in een sluitsteen in het midden, maar ontmoet een diagonale rib en een andere tierceron. Tiercerons komen voor in een stergewelf. (Haslinghuis)"@nl;
  skos:altLabel "hulprib"@nl, "hulpribben"@nl, "tierceron"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24a2dbd2-9ed8-47e4-84e4-6110c92ac21e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/5457c589-0446-4a62-9f02-646b2b135a97>
  a skos:Concept;
  skos:prefLabel "barkoenen"@nl;
  skos:scopeNote "Zware eiken rib, c. 15 x 15 cm in doorsnede en 2,5 tot 4 m lang, die o.a. in vloerconstructies gebruikt werd. (Haslinghuis)"@nl;
  skos:altLabel "barkoen"@nl;
