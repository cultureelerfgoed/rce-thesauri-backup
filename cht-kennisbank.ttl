<https://data.cultureelerfgoed.nl/term/id/cht/22da5d86-639f-48c7-adcf-3c939132566e>
  a skos:Concept;
  skos:prefLabel "bouwtekeningen-werktuigbouw"@nl;
  skos:scopeNote "Bouwtekeningen-werktuigbouw zijn technische tekeningen die betrekking hebben op de constructie en assemblage van machines en werktuigen. Ze zijn cruciaal voor de mechanische ingenieurskunde."@nl;
  skos:altLabel "bouwtekening-werktuigbouw"@nl;
