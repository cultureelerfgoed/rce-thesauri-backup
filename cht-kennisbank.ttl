<https://data.cultureelerfgoed.nl/term/id/cht/f24d4421-3615-4654-8586-ee5d49fa31a1>
  a skos:Concept;
  skos:prefLabel "schakelmechanismes"@nl;
  skos:scopeNote "Mechanisme in een versnellingsbak, waarmee met de hand of automatisch de gewenste versnelling wordt gekozen."@nl;
