<https://data.cultureelerfgoed.nl/term/id/cht/58767e4c-e07b-41c9-9d06-3601f0f01420>
  a skos:Concept;
  skos:prefLabel "balkons"@nl;
  skos:scopeNote "Open platform dat niet gelijkvloers voor een muur is aangebracht. Is door een borstwering of balustrade afgesloten en via een deur toegankelijk uit de daaraan grenzende binnenruimte. Onderscheidt zich van een erker doordat het geen integrerend deel uitmaakt van de ruimte waarvoor het is aangebouwd en van de loggia omdat het buiten het hoofdbouwwerk is aangebracht. (Haslinghuis)"@nl;
  skos:altLabel "balkon"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b2331d07-8cfc-4ddb-ab21-ed760e7cbc9f>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/d9b0e46d-09f6-43ab-816c-b6fa0b4f16e4>,
    <https://data.cultureelerfgoed.nl/term/id/cht/4e1efe9a-13f8-459f-b6ac-94c3e8ef72ae>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/04d2ab96-9e01-4a42-b001-cfaea7040862>
  a skos:Concept;
