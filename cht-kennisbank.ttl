  a skos:Concept;
  skos:prefLabel "bestekladen"@nl;
  skos:scopeNote "Een besteklade is een lade of inzet met vakken, bedoeld om bestek overzichtelijk te ordenen. U vindt deze vaak in keukenkasten of -lades, met aparte ruimten voor messen, vorken, lepels en andere eetgerei."@nl;
  skos:altLabel "bestekbak"@nl, "bestekbakken"@nl, "besteklade"@nl;
