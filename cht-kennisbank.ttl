<https://data.cultureelerfgoed.nl/term/id/cht/b568c221-1075-4633-8b29-dbce0e8060cb>
  a skos:Concept;
  skos:prefLabel "schootzijden"@nl;
  skos:scopeNote "De holle lijn der hekkenlatten, die voor elk molentype verschilde."@nl;
  skos:altLabel "schootzijde"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/04770e4f-1c11-40e7-a256-9de8c6d569c6>;
