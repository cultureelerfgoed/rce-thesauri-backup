<https://data.cultureelerfgoed.nl/term/id/cht/ec63263a-e356-4b6d-9844-53d9be62f5f3>
  a skos:Concept;
  skos:prefLabel "achteruitkijkspiegels"@nl;
  skos:scopeNote "Spiegel, die binnen in de wagen of op het spatscherm is gemonteerd en de bestuurder in staat stelt achter zich te kijken, zonder zijn hoofd te draaien."@nl;
  skos:altLabel "achteruitkijkspiegel"@nl, "binnenspiegel"@nl;
