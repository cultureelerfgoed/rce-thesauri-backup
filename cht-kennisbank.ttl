<https://data.cultureelerfgoed.nl/term/id/cht/4c8f452b-1782-47cc-8e07-db7c2c7d34da>
  a skos:Concept;
  skos:prefLabel "imitatiemunten"@nl;
  skos:scopeNote "Imitatie, nabootsing van een succesvol munttype, bedoeld om deze naast het origineel in omloop te brengen. Bij latere nabootsing gaat het niet om munten voor de circulatie en kan daarom beter van namaak worden gesproken.(bron: wiki.muntenenpapiergeld.nl)"@nl;
  skos:altLabel "imitatiemunt"@nl, "valse munt"@nl, "valse munten"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/306df5ea-fa8e-4352-bb98-55b82d1445dd>;
