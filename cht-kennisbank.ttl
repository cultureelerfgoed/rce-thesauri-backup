<https://data.cultureelerfgoed.nl/term/id/cht/709d7f62-d6f5-4e9a-bf74-af58980813ac>
  a skos:Concept;
  skos:prefLabel "zittingrails"@nl;
  skos:scopeNote "Rails waarop de voorzittingen naar voren en achteren kunnen worden geschoven om een gemakkelijke zitpositie te nemen."@nl;
