<https://data.cultureelerfgoed.nl/term/id/cht/85643734-af2f-4e42-b9e2-c8d2e549ccc3>
  a skos:Concept;
  skos:prefLabel "blindenkasten"@nl;
  skos:scopeNote "Blindenkasten zijn uitgespaarde kasten in vensterbetimmeringen waarin vouwblinden kunnen worden weggedraaid. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eed628e6-2438-44c4-afa3-a83332aed561>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/856fdc78-ed40-47f2-b9af-97206b435e10>
  a skos:Concept;
  skos:prefLabel "gedenkbladen"@nl;
  skos:scopeNote "Blad papier waarop een of meer belangrijke gebeurtenissen ter nagedachtenis opgetekend zijn."@nl;
  skos:altLabel "gedenkblad"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91712616-6dec-4871-8fdc-c317850c20d1>;
