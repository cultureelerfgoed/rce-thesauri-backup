  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/9a49d45f-3ae2-4bc1-b97d-339dd7609640>
  a skos:Concept;
  skos:prefLabel "nokstijlspanten"@nl;
  skos:scopeNote "Nokstijlspanten zijn nokspanten waarbij er een stijl onder de nok van het dak is, waarin beide benen zijn gepend. (Historische houtconstructies in Nederland / G. Behrends, 1996)"@nl;
  skos:altLabel "nokstijlspant"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/63a55de7-55fb-427d-af9d-3924aa90f6c1>;
