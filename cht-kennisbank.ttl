<https://data.cultureelerfgoed.nl/term/id/cht/8b7f0da9-6a03-4b6b-be87-622eedd33564>
  a skos:Concept;
  skos:prefLabel "Bergse ankernagels"@nl;
  skos:scopeNote "Machinaal gesmede ijzeren ankernagel, van c. 1900 tot 1940 ingevoerd uit Zweden. Werd geleverd met kruiskop en verzonken kop, 1 tot 4 duim lang, 10 pond tot 40 pond/1000. Ook: bandnagel, plaatspijker. (Haslinghuis)"@nl;
  skos:altLabel "Bergse ankernagel"@nl;
