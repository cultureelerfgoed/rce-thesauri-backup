<https://data.cultureelerfgoed.nl/term/id/cht/c7a8562a-9f26-4298-99db-fe2a4f6a03bc>
  a skos:Concept;
  skos:prefLabel "werktafels"@nl;
  skos:scopeNote "Tafels waarin werkmateriaal en gereedschap wordt opgeborgen, met name de kleine tafeltjes met laatjes en vaak een neerhangende stoffen zak voor naaiwerk. (AAT-Ned)"@nl;
  skos:altLabel "werktafel"@nl;
