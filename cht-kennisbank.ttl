<https://data.cultureelerfgoed.nl/term/id/cht/e128ed74-89cc-4ae1-a191-1254911f84c4>
  a skos:Concept;
  skos:prefLabel "recreatiebouwwerken"@nl;
  skos:scopeNote "Gebouwen bedoeld voor amusement, lichaamsbeweging, sporten of een andere vorm van vrijetijdsbesteding of die uitrustingen hiervoor bevatten. (AAT)"@nl;
  skos:altLabel "recreatiebouwwerk"@nl;
