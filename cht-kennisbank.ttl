<https://data.cultureelerfgoed.nl/term/id/cht/9219fe86-c9b1-4928-96bb-301c4aec1cb9>
  a skos:Concept;
  skos:prefLabel "roeischouwen"@nl;
  skos:scopeNote "Roeiboot in Zuid-Holland met voor en achter hoog oplopend vlak waarop aan de einden zeshoekige borden staan; de zijden vallen naar buiten en zijn met hun einden tegen de borden gespijkerd; de boeisels daarboven vallen iets naar binnen of naar buiten."@nl;
  skos:altLabel "roeischouw"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7eb9a2e6-dbec-47eb-a0f2-e5b6636620e5>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/53dd5a74-3ae8-41f1-aa0b-7bbef1df5523>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6302d3c5-1e36-4efa-b681-4bd8d5b3ea8d>
  a skos:Concept;
  skos:prefLabel "Aquazol"@nl;
  skos:scopeNote "Handelsmerknaam voor een reeks polyoxazolineverbindingen die op de markt worden gebracht als hoogwaardige, in water oplosbare polymeren met vele toepassingen. Bij conservering worden Aquazol-verbindingen toegepast op een breed scala van objectmaterialen als consolidatiemiddel, kleefstof, inkleurmedium, vulmateriaal en barrièrecoating.  (AAT)"@nl;
  skos:altLabel "Aquazol (TM)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bc3bcd42-fb5e-424f-8dec-e20637dc520f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/50971002-bbf1-4d0d-bcbb-ccb3b57c7989>
  a skos:Concept;
  skos:prefLabel "overmaadse vletten"@nl;
  skos:scopeNote "Rondspantboot, overnaards."@nl;
  skos:altLabel "overmaadse vlet"@nl;
