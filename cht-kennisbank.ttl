<https://data.cultureelerfgoed.nl/term/id/cht/e04ffb00-feb8-4d97-b074-a17b5fece022>
  a skos:Concept;
  skos:prefLabel "bovenassen"@nl;
  skos:scopeNote "As in een windmolen waarin aan de voorzijde de roeden bevestigd zijn askop en aan de achterzijde het kamwiel dat de verticale as van de molen aandrijft. Behoort tot het gaande werk. (Haslinghuis)"@nl;
  skos:altLabel "bovenas"@nl, "molenas"@nl, "molenassen"@nl, "wiekenas"@nl, "wiekenassen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a808bf14-1c8b-4d62-8c13-a8b335c1c3f8>;
