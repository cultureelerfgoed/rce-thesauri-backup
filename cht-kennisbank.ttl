<https://data.cultureelerfgoed.nl/term/id/cht/b98ff1f3-f1a4-49cd-8582-b9e88229d75d>
  a skos:Concept;
  skos:prefLabel "natriumsilicaat"@nl;
  skos:scopeNote "Natriumsilicaat is een oplosbaar natriumzout van kiezelzuur, met als brutoformule Na2SiO3 (in watervrije toestand). (Wikipedia)"@nl;
