<https://data.cultureelerfgoed.nl/term/id/cht/04f052e7-c3d7-43c8-b018-e51cc9af2a9f>
  a skos:Concept;
  skos:prefLabel "flyscreens"@nl;
  skos:scopeNote "Een Flyscreen (vliegenscherm) is een klein, rudimentair stuurkuipje op een motorfiets dat de rijwind (en daarmee ook de vliegen) langs en over de rijder moet sturen."@nl;
  skos:altLabel "flyscreen"@nl, "vliegenscherm"@nl, "vliegenschermen"@nl;
