<https://data.cultureelerfgoed.nl/term/id/cht/ac3bc46f-4329-49e1-853c-4ee754dae1d0>
  a skos:Concept;
  skos:prefLabel "polair oplosmiddel"@nl;
  skos:scopeNote "Polaire stoffen lossen goed op in een polair oplosmiddel; water is het meest polaire oplosmiddel en het mengt dus goed met andere polaire stoffen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9fc66d89-a20e-4145-864f-025c2a22b299>;
