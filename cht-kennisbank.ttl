<https://data.cultureelerfgoed.nl/term/id/cht/5f07a45e-2c84-4f66-8c39-6a13ace17f48>
  a skos:Concept;
  skos:prefLabel "laag van Usselo"@nl;
  skos:scopeNote "Bodemrestant uit het Allerød-interstadiaal. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2971af0-cde7-4888-b828-33443f702e7d>;
