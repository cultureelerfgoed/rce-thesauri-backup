<https://data.cultureelerfgoed.nl/term/id/cht/e28c617e-1ec9-45ce-88a9-4fdf65062430>
  a skos:Concept;
  skos:prefLabel "eutroof veen"@nl;
  skos:scopeNote "Eutroof veen is veen dat in een voedselrijk en nat milieu is ontstaan. Vaak staan deze venen onder invloed van voedselrijk rivier- of zeewater. Voorbeelden van eutrofe veentypen zijn rietveen en bosveen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/626077f4-772b-4c36-9f6b-e72a4c9d28fa>;
