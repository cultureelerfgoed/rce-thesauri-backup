<https://data.cultureelerfgoed.nl/term/id/cht/47c7555d-4101-42a4-846f-b1b29f0d7f16>
  a skos:Concept;
  skos:prefLabel "onderschoeren"@nl;
  skos:scopeNote "Bij een hallenhuis in het oostelijk grensgebied van Nederland de terugliggende doorgang in de gevel aan de bedrijfszijde. (Haslinghuis)"@nl;
  skos:altLabel "onderschoer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4e481c81-319a-44da-86bf-106f145d22c1>;
