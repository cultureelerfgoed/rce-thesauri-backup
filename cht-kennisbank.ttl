<https://data.cultureelerfgoed.nl/term/id/cht/1f32f589-e716-423f-992c-ac9cbad28039>
  a skos:Concept;
  skos:prefLabel "embrasses"@nl;
  skos:scopeNote "Embrasses zijn koorden met kwasten die dienen om gordijnen in open stand zijwaarts bijeen te houden. De koorden zitten aan haken in de vensters vast of aan patères. (Het Nederlandse interieur in beeld / C. Willemijn Fock e.a., Zwolle 2001)"@nl;
  skos:altLabel "embrasse"@nl;
