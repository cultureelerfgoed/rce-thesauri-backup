<https://data.cultureelerfgoed.nl/term/id/cht/55017c3b-569a-4cae-83a6-2672bf78bda9>
  a skos:Concept;
  skos:prefLabel "mariaglas"@nl;
  skos:scopeNote "Mariaglas werd in het begin van onze jaartelling (14 tot 37) in Italië door Tiberius Iulius Caesar Augustus gebruikt als een soort glas voor broeibakken op wielen (horte pensiles). Het bestond uit lichtdoorlatende platen van mica (muscoviet), alabaster (calciet), of talk. (Wikipedia)"@nl;
  skos:altLabel "lapis speculare"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2a9a5a20-6d87-45d4-ae8e-078e174b7c12>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2a9ff69d-adaa-4e19-bbcf-0f6275096eba>
  a skos:Concept;
  skos:prefLabel "hekboten"@nl;
  skos:scopeNote "Soort koopvaardijschip uit de 17de en 18de eeuw vooral gebruikt in Nederland maar eveneens in Duitsland en Scandinavië. (MARDOC)"@nl;
  skos:altLabel "hekboot"@nl, "hekschip"@nl, "hekschepen"@nl;
