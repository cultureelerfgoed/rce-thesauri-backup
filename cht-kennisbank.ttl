<https://data.cultureelerfgoed.nl/term/id/cht/5b47e45a-2ee5-4ea8-8322-bfc1a9ef781e>
  a skos:Concept;
  skos:prefLabel "klinknagels"@nl;
  skos:scopeNote "Een klinknagel is een kleine metalen pen die door gaatjes in metalen werkstukken gaat en die meestal in roodgloeiende vorm aan beide uiteinden wordt platgeslagen om de werkstukken voorgoed aan elkaar te verbinden. (Conservation Dictionary)"@nl;
  skos:altLabel "klinknagel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6f8bf719-083b-482e-bc3d-85e91fbabcdf>;
