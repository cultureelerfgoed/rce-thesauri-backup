  a skos:Concept;
  skos:prefLabel "paltrokken"@nl;
  skos:scopeNote "Specifiek type zaagmolen geïntroduceerd eind 17e eeuw. (Molenwoordenboek G.J. Pouw)"@nl,
    "Windmolen van het type onderkruier, voor het zagen van boomstammen en bekantrecht hout, waarvan de houten romp de vorm van een ‘Pfalzrock’ (een lange mantel) heeft. Omstreeks 1600 in de Zaanstreek ontwikkeld. (Haslinghuis)"@nl;
