<https://data.cultureelerfgoed.nl/term/id/cht/a804f575-d2d5-401d-a574-e704afe0c1f0>
  a skos:Concept;
  skos:prefLabel "folklore"@nl;
  skos:scopeNote "Traditionele en expressieve vormen van cultuur zoals zang, vertelling, dans, ritueel, handwerk, kunst, eetgewoonten, klederdracht, gebruiken, godsdienst, architectuur en vakkundigheid en van de ontwikkelingen en betekenissen die hieraan ten grondslag liggen. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/df4db7b4-3b69-49a2-9068-13034f1a068f>;
