<https://data.cultureelerfgoed.nl/term/id/cht/ab82d0e1-b018-4ad9-9f18-1537abc83aae>
  a skos:Concept;
  skos:prefLabel "roterende motoren"@nl;
  skos:scopeNote "Motor waarvan de beweging, die uit de ontwikkelde kracht voortvloeit, roterend is en niet op- en neergaand. Zie ook Wankelmotor"@nl;
  skos:altLabel "rotatiemotor"@nl, "roterende motor"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/44ac60de-195d-45b2-8cf8-a46deb19ef7f>;
