<https://data.cultureelerfgoed.nl/term/id/cht/5ad328c6-0a9c-4d54-8f41-656b0953a71e>
  a skos:Concept;
  skos:prefLabel "Blasiuskaarsen"@nl;
  skos:scopeNote "Kaars voor de Blasiuskandelaar, als zodanig herkenbaar door het opschrift \"Blasiuskaars\"."@nl;
  skos:altLabel "Blasiuskaars"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4eccfe58-0585-4e3c-852d-3b15fc51eee3>;
