  a skos:Concept;
  skos:prefLabel "onderbroeken"@nl;
  skos:scopeNote "Kledingstukken die op het lichaam en onder basiskleding worden gedragen, met openingen voor de benen of korte of lange pijpen. (AAT-Ned)"@nl;
  skos:altLabel "onderbroek"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5dec9aa2-5ced-4f77-b929-c043b90b2a8f>;
