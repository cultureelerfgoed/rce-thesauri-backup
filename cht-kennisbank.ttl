<https://data.cultureelerfgoed.nl/term/id/cht/753df04a-cdf0-4d3f-bfd2-9d3c0aa97a78>
  a skos:Concept;
  skos:prefLabel "pompwielen"@nl;
  skos:scopeNote "Aandrijvend wiel van een vloeistofkoppeling of van een koppelomvormer. Is voorzien van schoepen om de vloeistof in beweging te brengen. (ANWB / Het Beste Autohandboek 1972)"@nl,
    "Wiel op het krukasje voor de pompstokken in de papiermolen. (Molenwoordenboek B.D. Poppen)"@nl;
  skos:altLabel "impeller"@nl, "pompwiel"@nl;
