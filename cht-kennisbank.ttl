<https://data.cultureelerfgoed.nl/term/id/cht/12c1e893-a6df-49a4-98d5-be2f5db7c93d>
  a skos:Concept;
  skos:prefLabel "voogdij"@nl;
  skos:scopeNote "Voogdij is het gezag uitgeoefend over een minderjarige door een ander dan een ouder."@nl;
