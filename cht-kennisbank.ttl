    "wiel (landschapselement)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2971af0-cde7-4888-b828-33443f702e7d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d850962a-fb1d-4859-9926-f2423bce266d>
  a skos:Concept;
  skos:prefLabel "uitgeverijen"@nl;
  skos:scopeNote "Mensen, bedrijven of rechtspersonen die verantwoordelijk zijn voor het op de markt brengen van een boek of ander werk voor de verkoop of distributie aan het publiek. Gebruik 'boekverkopers' voor personen die actief waren voor 1800. (AAT-Ned)"@nl;
