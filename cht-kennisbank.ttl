    <https://data.cultureelerfgoed.nl/term/id/cht/2bf9edfa-72f8-464d-b954-3afec9555706>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/bf0d6dee-99b9-44e8-b61b-369ba2a50402>
  a skos:Concept;
  skos:prefLabel "fotografische procedés"@nl;
  skos:scopeNote "Procedés waarbij lichtgevoelige materialen worden gebruikt om een beeld te produceren. (Project Fotografie)"@nl,
