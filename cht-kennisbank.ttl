<https://data.cultureelerfgoed.nl/term/id/cht/43243bc0-662e-4c4c-a559-3156601ffc69>
  a skos:Concept;
  skos:prefLabel "collectietuinen"@nl;
  skos:scopeNote "Collectietuinen zijn tuinen waarin voor plezier of uit wetenschappelijk oogpunt zoveel mogelijk levende bomen of planten van een bepaalde familie of soort bijeen zijn gebracht. Voorbeelden van soorten collectietuinen zijn de botanische tuin, het arboretum, het pinetum en een alpinum. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "collectietuin"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c2fcf3dc-6efd-4c88-afcf-287b680894ff>;
