<https://data.cultureelerfgoed.nl/term/id/cht/a171ca9e-c3c4-4906-b3ec-2aa9b72d5e3c>
  a skos:Concept;
  skos:prefLabel "smeden (rol)"@nl;
  skos:scopeNote "Smeden bewerken metaal door het te verhitten en te vormen. Zij maken gereedschap, beslag of constructieonderdelen in een smidse of werkplaats."@nl;
  skos:altLabel "ijzersmid"@nl, "smid"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db4a7619-d236-4b14-8e79-b4a6e890f677>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/830895a7-05af-4138-923c-c7812a743e6a>,
    <https://data.cultureelerfgoed.nl/term/id/cht/838074e8-d961-4eff-9611-7bf563f49d2f>,
    <https://data.cultureelerfgoed.nl/term/id/cht/e977b412-8eea-4f3f-8b68-74204cd1cbe6>;
