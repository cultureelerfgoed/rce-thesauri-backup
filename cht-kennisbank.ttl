<https://data.cultureelerfgoed.nl/term/id/cht/9a110f56-1fcc-4be7-b263-508c00f58ffb>
  a skos:Concept;
  skos:prefLabel "draad (materiaal)"@nl;
  skos:scopeNote "Enkelvoudige fijne vezels, groepen van dergelijke vezels die stevig zijn samengedraaid of vezelige lengtes gevormd door het spinnen en twijnen van korte vezels tot een onafgebroken streng. (AAT)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/86d3631a-1f3f-4b51-bbbb-dadebc310ecc>;
