<https://data.cultureelerfgoed.nl/term/id/cht/ea5261b0-1b28-4985-a076-864a2c5c1825>
  a skos:Concept;
  skos:prefLabel "ezelstorens"@nl;
  skos:scopeNote "Toren zoals in Worms, Spiers en Regensburg, die een spiraalsgewijs stijgende opgang bevat waarlangs, naar de overlevering wil, ezels de bouwstoffen naar boven droegen. (Haslinghuis)"@nl;
  skos:altLabel "ezelstoren"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2ffb2c5-397c-47c9-bdb8-a655cd21326d>;
