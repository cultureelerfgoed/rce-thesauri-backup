  a skos:Concept;
  skos:prefLabel "fotoarchief"@nl;
  skos:scopeNote "Geheel van fotografische documenten met betrekking tot een cultuurgoed"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c7d5cabc-28d8-4bdd-b595-9039fe07a4ae>;
