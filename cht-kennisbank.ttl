  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b95d94f1-d5d4-4380-b9a0-7740d8460442>
  a skos:Concept;
  skos:prefLabel "statue-colonnes"@nl;
  skos:scopeNote "Overgangsvorm naar het vrijstaande beeld in de (Franse) vroeggotische portaalarchitectuur. Het functionele van de zuil of colonnet, verwerkt tot sculptuur, is er nog in bewaard. Overslanke figuren zijn nog dragers van de archivolten. Voorb.: ‘Portail royal’ van de kathedraal van Chartres (1150 e.v.). In het middenportaal staan de schachtfiguren nog onder kapitelen, in de zijportalen zijn zij al door baldakijnen bekroond en meer los staand. In Nederland aan het Bergportaal van de St.-Servaas in Maastricht. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/671ac6c1-7c99-4ee5-8daf-8d2ed0e14402>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c0a0fd7c-744a-4d1a-aa87-023ed167ca4e>
  a skos:Concept;
  skos:prefLabel "wandsculpturen"@nl;
  skos:scopeNote "Beeldhouwwerken vanaf het midden van de 20e eeuw die tegen een muur zijn aangebracht. (AAT-Ned)"@nl;
