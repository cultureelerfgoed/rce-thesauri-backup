<https://data.cultureelerfgoed.nl/term/id/cht/b88df630-bcc8-4821-ae43-7052b01e563b>
  a skos:Concept;
  skos:prefLabel "Beet Hamidrasj"@nl;
  skos:scopeNote "Beet Hamidrasj (Hebreeuws) betekent huis van studie. Het is een ruimte die tot de synagoge behoort waar Joodse geschriften worden bestudeerd. Een Beet Hamidrasj kan ook een afzonderlijke ruimte zijn, los van de synagoge."@nl;
  skos:altLabel "huis van studie"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1f045186-ba15-4937-a311-de50437f32d4>;
