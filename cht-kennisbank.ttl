<https://data.cultureelerfgoed.nl/term/id/cht/538832db-ad95-4a3d-b747-709852435379>
  a skos:Concept;
  skos:prefLabel "pestbosjes"@nl;
  skos:scopeNote "Een pestbosje is een klein, met bomen begroeid stuk land waarin dieren zijn begraven die aan een besmettelijke ziekte zijn bezweken."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2971af0-cde7-4888-b828-33443f702e7d>;
