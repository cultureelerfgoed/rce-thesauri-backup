<https://data.cultureelerfgoed.nl/term/id/cht/4fb92b5e-1067-4ce6-8b0e-748f837c5d5a>
  a skos:Concept;
  skos:prefLabel "corpora"@nl;
  skos:scopeNote "Beeld van het lichaam van Christus, meestal hangend aan een kruis. Een corpus wordt ook wel zonder kruis aan de muur bevestigd. (Religieus Erfgoedthesaurus)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0741920b-94c2-4d93-9deb-71701a77f520>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/623ce446-0dc4-467a-8cc1-028a51fd459b>
  a skos:Concept;
  skos:prefLabel "kerkbeelden"@nl;
  skos:scopeNote "Religieus beeldhouwwerk."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0741920b-94c2-4d93-9deb-71701a77f520>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/688ade08-7cda-40bd-aa18-ad482da19f48>
  a skos:Concept;
  skos:prefLabel "Marianums"@nl;
  skos:scopeNote "Twee ruggelings tegen elkaar geplaatste Mariabeelden omgeven door stralen in een krans van rozen. Maria houdt het Kind in de armen, staat op wolken, of staat, naar het visioen van Johannes op de maansikkel en vertrapt de slang. Het van oorsprong laatmiddeleeuwse Marianum hangt af van het gewelf van de kerk, zichtbaar voor de geestelijkheid in het koor en het kerkvolk in het schip. (Religieus Erfgoedthesaurus)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0741920b-94c2-4d93-9deb-71701a77f520>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/7fccccb7-e26e-4f69-9332-40411abcff27>
  a skos:Concept;
  skos:prefLabel "stolpbeelden"@nl;
  skos:scopeNote "Beeld van was, biscuit of porselein, dat zijn plaats onder een stolp heeft, meestal een beeld van Maria, maar ook van Jozef of een of meer heiligen. Het stolpbeeld kan een gekleed staakbeeld zijn. Ter weerszijden van het Mariabeeld een vaasje met bloemen van stof of was of een ereboog van bloemen rondom haar. De vaasjes soms ook onder afzonderlijke stolpen. (Religieus Erfgoedthesaurus)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0741920b-94c2-4d93-9deb-71701a77f520>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8ef1267b-4508-4d63-bd80-d95ab0980611>
  a skos:Concept;
  skos:prefLabel "staakbeelden"@nl;
  skos:scopeNote "Beeld, waarvan de romp en/of het onderlichaam uit één of meer staken bestaat en waarvan alleen hoofd, handen en soms voeten zijn af-gewerkt. Bestemd om te worden aangekleed. Het staakbeeld dat Maria voorstelt, wordt ook wel staakmadonna genoemd. (Religieus Erfgoedthesaurus)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0741920b-94c2-4d93-9deb-71701a77f520>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ac1c1221-0f2b-4fdc-8f01-d243ce370182>
  a skos:Concept;
  skos:prefLabel "reliekbeelden"@nl;
  skos:scopeNote "Beeld met een holle ruimte waarin een reliek is ondergebracht. (Religieus Erfgoedthesaurus)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0741920b-94c2-4d93-9deb-71701a77f520>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b95c4a08-8943-43a8-91a9-0cd883a306f5>
  a skos:Concept;
  skos:prefLabel "fratskoppen"@nl;
  skos:scopeNote "Gebeeldhouwde kop met karikaturale eigenschappen, o.a. als kraagstenen in de late gotiek. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0741920b-94c2-4d93-9deb-71701a77f520>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c197d20c-c203-4516-8f96-bbe807861c24>
  a skos:Concept;
  skos:prefLabel "beeldengroepen (ceremonieel)"@nl;
  skos:scopeNote "Twee of meer beelden die gezamenlijk een onderwerp uitbeelden."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0741920b-94c2-4d93-9deb-71701a77f520>;
