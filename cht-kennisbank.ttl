<https://data.cultureelerfgoed.nl/term/id/cht/63361d65-8cd1-4c79-a28d-07b998074156>
  a skos:Concept;
  skos:prefLabel "spieën (bouwelement)"@nl;
  skos:scopeNote "Een spie is een uitneembaar verbindingsmiddel dat wordt toegepast bij verbindingen tussen een as en een naaf of voor het vastzetten van een spijlbout. (Wikipedia)"@nl;
  skos:altLabel "spie (bouwelement)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4e481c81-319a-44da-86bf-106f145d22c1>;
