  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/06fd83d2-ec9a-4a2c-9fe2-7020d65be490>
  a skos:Concept;
  skos:prefLabel "motorkapsluitingen"@nl;
  skos:scopeNote "De motorkapsluiting vormt het slot van de motorkap. De sluiting kan veelal vanuit het interieur worden bediend."@nl;
  skos:altLabel "motorkapsluiting"@nl;
