  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ef44ba74-5c91-45f1-8eda-94697e339b32>
  a skos:Concept;
  skos:prefLabel "voetremmen"@nl;
  skos:scopeNote "Hoofdrem van een voertuig, die met een pedaal op de vloer bediend wordt."@nl;
  skos:altLabel "voetrem"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/92b9f434-a090-4683-bc64-fe612cc8b5dd>;
