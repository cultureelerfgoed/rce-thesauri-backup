<https://data.cultureelerfgoed.nl/term/id/cht/135d44cd-89c9-43f8-be48-a00152d8230f>
  a skos:Concept;
  skos:prefLabel "parijse wolven"@nl;
  skos:scopeNote "Werkt als een steenschaar maar klemt zich vast aan de binnenkant van een zwaluwstaartvormig gat. Aan de bovenzijde is een ring."@nl;
  skos:altLabel "parijse wolf"@nl;
