<https://data.cultureelerfgoed.nl/term/id/cht/19c7f4b5-6166-49e2-8fd1-8af92e478b0f>
  a skos:Concept;
  skos:prefLabel "wener vloeren"@nl;
  skos:scopeNote "Wener vloeren zijn houten dekvloeren waarbij korte planken van balk tot balk onder een hoek van 45° op een balkenvloer worden gelegd. De uiteinden van de planken worden onder verstek of in keper- of visgraatverband tegen elkaar gelegd, soms ook wel onder verstek tegen een plank die in de lengterichting op de balk is gelegd. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "wener vloer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b629abd3-dd84-473d-a151-6e8ddcbc61c6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f690dd1f-b106-46cd-a483-1c1b8285b8e5>
  a skos:Concept;
