<https://data.cultureelerfgoed.nl/term/id/cht/e2c27540-fa46-44bf-bdc8-689d382a4a28>
  a skos:Concept;
  skos:prefLabel "goudenregenhout"@nl;
  skos:scopeNote "Hout van een van de grotere variëteiten van het genus van bomen en struiken met dezelfde naam, donker groenachtig bruin of roodbruin van kleur, fijn generfd en zeer goed te polijsten; wordt vooral gebruikt voor schrijn- en inlegwerk. (AAT)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ba6bdd8e-2f33-4268-a6a0-791e94a6a782>;
