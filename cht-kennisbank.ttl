<https://data.cultureelerfgoed.nl/term/id/cht/f06904f5-abd1-4656-afb0-1af989b710de>
  a skos:Concept;
  skos:prefLabel "gasballonnen"@nl;
  skos:scopeNote "Een duurdere methode is een gasballon. De envelop is bolvormig, met een aanhangsel (de 'vulslurf') aan de onderkant. De vulslurf dient in de eerste plaats om de envelop met gas te vullen."@nl;
  skos:altLabel "gasballon"@nl;
