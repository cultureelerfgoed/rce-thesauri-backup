<https://data.cultureelerfgoed.nl/term/id/cht/fad9b386-338a-422f-8cb6-252702e31755>
  a skos:Concept;
  skos:prefLabel "karmijn"@nl;
  skos:scopeNote "Cochenille is een rode organische kleurstof die karmijnzuur bevat, geëxtraheerd uit de schildluis, Coccus cacti. Het wordt gebruikt als textielverfstof en om karmijnrood te maken. Het kwam in de 16e eeuw in de plaats van kermes als belangrijkste rode kleurstof. (bouwmaterie, Conservation Dictionary)"@nl;
  skos:altLabel "cochenille"@nl, "karmijnrood"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/32322bbf-0d46-4bd5-a5a5-1aecbb11da09>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/faf8404d-f3bf-46f2-9471-8ebc656ad4cf>
  a skos:Concept;
  skos:prefLabel "conserveermiddel"@nl;
  skos:scopeNote "Een conserveermiddel voor een geprepareerd dier is een stof die de huid in conditie houdt en die insecten afweert."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4c8b3905-3d3d-4f73-be92-a33a95f378fd>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/74e9842e-3eb9-47ce-94bb-a233bea3ed3b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fafe0d77-3daf-4b0f-900e-1d08cf87de34>
  a skos:Concept;
  skos:prefLabel "duplicaat positief"@nl;
  skos:scopeNote "Zie duplicaat negatief. (Conservation Dictionary)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/3b2c274c-e422-4863-b520-98d6d80e2f89>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fb1ee421-4384-49fe-ad80-10ecb5ea764f>
  a skos:Concept;
  skos:prefLabel "interne spanning"@nl;
  skos:scopeNote "Interne spanning is de kracht die binnen een materiaal werkt en die vervorming of breuk kan veroorzaken."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5f4c4bef-a5c2-4d8e-ad2a-88b04f93f3dc>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fb3fbb64-df8a-49ab-b18f-bf859a7fd83d>
  a skos:Concept;
  skos:prefLabel "irreversibel"@nl;
  skos:scopeNote "Een irreversibele behandeling van een object kan niet ongedaan gemaakt worden, bijvoorbeeld vanwege veranderingen aan het object of omdat een toegevoegd materiaal niet verwijderd kan worden."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fb6447da-f8e8-4c46-a98e-b7bfcd27a3d7>
  a skos:Concept;
  skos:prefLabel "insluitsel"@nl;
  skos:scopeNote "Een insluitsel is een materiaaldeeltje opgesloten in een ander materiaal, zoals koolstof in staal of fijngestampte schelpen in keramiek."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fbb76483-40c2-4381-a754-7dbbb9bb7d94>
  a skos:Concept;
  skos:prefLabel "calqueerzakjes"@nl;
  skos:scopeNote "Een calqueerzakje is een zakje met vergulderswit dat bij een olievergulding wordt gebruikt. Delen van het oppervlak worden met wit bepoederd om te kunnen onderscheiden welke delen wel en welke delen niet moeten worden verguld. (Conservation Dictionary)"@nl;
  skos:altLabel "calqueerzakje"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fbc6ab61-4c7a-4a07-8e73-7b241720aed3>
  a skos:Concept;
  skos:prefLabel "verstevigen"@nl;
  skos:scopeNote "Verstevigen is een behandeling die erop gericht is de mechanische sterkte van een poreus of gebroken voorwerp te vergroten door het inbrengen van een vloeistof die in het voorwerp uithardt. Het verstevigen van een voorwerp of een onderdeel ervan is het toevoegen van materiaal dat wordt verbonden met het origineel om het te versterken of te ondersteunen."@nl;
  skos:altLabel "versteviging"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fbfb591f-1073-4d3c-b041-33ab715cd110>
  a skos:Concept;
  skos:prefLabel "rijtuigonderdelen"@nl;
  skos:scopeNote "Onderdelen van een rijtuig. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "rijtuigonderdeel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/feb50453-4925-49d0-a20e-39d63bed2a0f>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/79743a66-d39c-4d04-bc42-4e7ceaf6a856>,
    <https://data.cultureelerfgoed.nl/term/id/cht/d8ff15da-96b6-4b46-b526-b991c36b3016>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fc16213f-b9d0-460a-99b5-0e380615b955>
  a skos:Concept;
  skos:prefLabel "bevochtigingskamers"@nl;
  skos:scopeNote "Een bevochtigingskamer is een afgesloten ruimte waarbinnen een bepaalde vochtigheidsgraad gehandhaafd wordt. Zo’n kamer wordt gebruikt om een constant vochtgehalte in een voorwerp te realiseren voor behandelings- of onderzoeksdoeleinden. (Conservation Dictionary)"@nl;
  skos:altLabel "bevochtigingskamer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fce5cfe3-add5-4cbd-9cd5-ae4e31000cd6>
  a skos:Concept;
  skos:prefLabel "weerkaatsende lagen"@nl;
  skos:scopeNote "De weerkaatsende laag van een CD of minidisc is een spiegelende laag waarop het licht van een laserstraal weerkaatst. De weerkaatsende laag wordt zodanig bewerkt dat zij leesbare digitale informatie bevat. De weerkaatsende laag bestaat meestal uit aluminium, hoewel zilver en goud ook worden toegepast. (Conservation Dictionary)"@nl;
  skos:altLabel "weerkaatsende laag"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91712616-6dec-4871-8fdc-c317850c20d1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fd530211-6fbb-4f77-ad4e-1bbbb60a6b00>
  a skos:Concept;
  skos:prefLabel "benzinemeteronderdelen"@nl;
  skos:scopeNote "Onderdelen van een benzinemeter. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "benzinemeteronderdeel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4caeb6fd-df0e-444e-bcd4-ca112fdf1c59>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/30bf06d8-f0c2-4c88-b3be-05807e6d9946>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fd72161f-a5e0-4e6a-884a-2f5bced87295>
  a skos:Concept;
  skos:prefLabel "vochtigheidsmeters"@nl;
  skos:scopeNote "Een vochtigheidsmeter, psychrometer, is een instrument voor het meten van de luchtvochtigheid door middel van het meten van het afkoelende effect van het verdampen van water. Een slingerpsychrometer is het gestandaardiseerde instrument voor het verkrijgen van een juiste meting van de relatieve vochtigheid. (Conservation Dictionary)"@nl;
  skos:altLabel "vochtigheidsmeter"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/36963dcd-7f11-4902-8e8e-91eb92ad8ffd>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fd962b2c-624c-4a9e-a33c-a57d26d37f20>
  a skos:Concept;
  skos:prefLabel "melodiekoppels"@nl;
  skos:scopeNote "een melodiekoppel maakt het mogelijk om toetsen van een hoger octaaf te laten meeklinken met die van het zich daaronder bevindende octaaf. Deze functie werkt in ingeschakelde toestand uitsluitend op de hoogst ingedrukte toets. Door het inschakelen wordt deze hoogste toets gekoppeld aan dezelfde toets een octaaf hoger waardoor de melodie lijn wordt versterkt. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "melodiekoppel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b391ff3f-fe77-436c-89bb-21f7944fd426>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fda73afe-debd-4baa-882c-faa4ba2c4468>
  a skos:Concept;
  skos:prefLabel "zelfklevend plakband"@nl;
  skos:scopeNote "Zelfklevend plakband is plakband met een halfvloeibare lijmlaag die aan een oppervlak hecht als er druk op wordt uitgeoefend. Het plakband wordt gebruikt als tijdelijke hechting voor fragmenten terwijl men een definitieve lijm aanbrengt of voor het droog plakken van een gebroken voorwerp. De meest gebruikelijke kleefstoffen zijn op basis van (natuur)rubber of acrylaat en deze zijn vaak instabiel en veroorzaken verkleuringen. In het algemeen zijn de gebruikte kleefstoffen niet bruikbaar voor conserveringsdoeleinden."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7c891c96-a180-41dc-99a5-f2118313bc35>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fdb11a0a-7832-4afa-8143-12147bd36671>
  a skos:Concept;
  skos:prefLabel "transmissieverhoudingen"@nl;
  skos:scopeNote "De transmissieverhouding van een transparant materiaal is de verhouding tussen doorvallend licht en opvallend licht."@nl;
  skos:altLabel "transmissieverhouding"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/929f2b49-e558-4543-a710-41a893c3c5dd>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/feedaba7-22aa-41c0-a729-9e55731b4330>
  a skos:Concept;
  skos:prefLabel "gietblazen"@nl;
  skos:scopeNote "Gietblazen zijn kleine holtes in het oppervlak van gegoten metalen voorwerpen die zijn ontstaan door vocht in de gietmal dat verdampte bij contact met het gesmolten metaal."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ff62c4eb-1c34-4f9d-b72e-321e90fb3abf>
  a skos:Concept;
  skos:prefLabel "vluchtig bindmiddel"@nl;
  skos:scopeNote "Een vluchtig bindmiddel is een tijdelijke coating of verstevigingsmiddel dat door verdamping verdwijnt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9f58d5df-859f-4b37-9b66-5cc282f4d4f6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ff6452ce-35b1-4121-bac4-91335e0ed699>
  a skos:Concept;
  skos:prefLabel "onthard water"@nl;
  skos:scopeNote "Onthard water is water waarin de opgeloste calcium- en magnesiumionen, die de hardheid van water veroorzaken, inactief zijn gemaakt. Dit wordt bereikt door ionenwisseling, met een onthardingsapparaat of door het toevoegen van een complexvormer. Zie ook gezuiverd water."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0c41c9b8-fb66-48af-b44a-46dd24503c6c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ff6e35ad-5434-4f2a-8a49-2f37d7b9b139>
  a skos:Concept;
  skos:prefLabel "insijpelend regenwater"@nl;
  skos:scopeNote "Insijpelend regenwater is regenwater dat doordringt in de structuur van een gebouw."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0c41c9b8-fb66-48af-b44a-46dd24503c6c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

