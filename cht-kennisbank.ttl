  a skos:Concept;
  skos:prefLabel "standaardgewichten"@nl;
  skos:scopeNote "Standaardgewichten zijn gewichten die als standaard worden gebruikt. De dagelijks gebruikte gewichten worden regelmatig op de standaardgewichten geijkt. (Het waagstuk. Wegen en waaggebouwen in Nederland, div. auteurs, Amsterdam 1990)"@nl;
