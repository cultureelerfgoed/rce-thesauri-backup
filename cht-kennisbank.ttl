<https://data.cultureelerfgoed.nl/term/id/cht/2aa37e92-118d-451a-a409-fba79379cb35>
  a skos:Concept;
  skos:prefLabel "gootijzers (gereedschap)"@nl;
  skos:scopeNote "Gootijzers zijn handgereedschappen van de rietdekkers, circa 65 cm lange, gootvormige ijzers met handvat. Ze zijn onmisbaar bij de goot-en-naald bindmethode."@nl;
  skos:altLabel "gootijzer (gereedschap)"@nl, "keu"@nl, "goot"@nl, "gootnaald"@nl, "gootnaalden"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2aa5db29-6714-41fb-a01d-b479e16e0193>
  a skos:Concept;
  skos:prefLabel "kalkbranders"@nl;
  skos:scopeNote "Man die kalk brandt uit kalksteen of schelpen. Dat gebeurde meestal in een kalkoven. (Haslinghuis)"@nl;
  skos:altLabel "kalkbrander"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db4a7619-d236-4b14-8e79-b4a6e890f677>;
