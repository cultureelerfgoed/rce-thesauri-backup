<https://data.cultureelerfgoed.nl/term/id/cht/314c8890-f3bb-4014-a011-320ba130667e>
  a skos:Concept;
  skos:prefLabel "slijten"@nl;
  skos:scopeNote "Een voorwerp slijt wanneer delen ervan kaal worden of door het gebruik vergaan."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fba63d82-3ed8-4a47-b47b-7ae9e750855f>;
