<https://data.cultureelerfgoed.nl/term/id/cht/297a4525-ccd2-471d-9c1e-b62e897bd720>
  a skos:Concept;
  skos:prefLabel "kralen (profielen)"@nl;
  skos:scopeNote "Kralen zijn rondstaven, profielen die in doorsnede meer dan halfrond zijn. Ze komen voor aan gewelfribben, dagkanten van bogen, portalen, vensters en nissen, ook veelvoorkomend in bakstenen kerken in Noord-Nederland. Rijkere voorbeelden (gewonden, zigzag gebroken) zijn aan te treffen in de romaanse bouwkunst van Normandië. Het kunnen ook eenvoudige, meer dan kwartronde randprofileringen van houten onderdelen zijn. (Haslinghuis)"@nl;
  skos:altLabel "kraal (profielen)"@nl, "rondstaafprofiel"@nl, "rondstaafprofielen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/50a5ae33-53bb-4d8c-bc1c-6bf463de641c>;
