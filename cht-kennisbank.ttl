<https://data.cultureelerfgoed.nl/term/id/cht/139175ee-d20b-4f05-ad68-18cf38fb65c9>
  a skos:Concept;
  skos:prefLabel "kogels (munitie)"@nl;
  skos:scopeNote "Vroeger bolvormig, thans langwerpig, cilindervormig, massief projectiel met min of meer spitse punt, soms voorzien van een stalen mantel, waarmee uit handvuurwapens geschoten wordt, vroeger ook uit kanonnen. (ABR)"@nl;
  skos:altLabel "kogel (munitie)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ebfa317e-7e97-4687-9a1f-453eba974e0c>;
