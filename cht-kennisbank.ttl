<https://data.cultureelerfgoed.nl/term/id/cht/7b6aa962-9e1b-4be4-88ae-11e4b89dbc8b>
  a skos:Concept;
  skos:prefLabel "persoonlijke voorwerpen"@nl;
  skos:scopeNote "Individuele bezittingen die gebruikt worden voor persoonlijke hygiëne, verzorging, en dagelijks gebruik. Voorbeelden zijn sieraden, horloges, brillen, mobiele telefoons, sleutels, portemonnees, handtassen, kleding, schoeisel, verzorgingsproducten (zoals tandenborstels, kammen, make-up), en persoonlijke documenten (zoals identiteitsbewijzen en bankkaarten)."@nl;
  skos:altLabel "persoonlijke gebruiksvoorwerpen"@nl, "persoonlijke accessoires"@nl;
