<https://data.cultureelerfgoed.nl/term/id/cht/8bb157de-6d83-412f-af18-ad06a6356c56>
  a skos:Concept;
  skos:prefLabel "cementtegels"@nl;
  skos:scopeNote "Cementtegels zijn tegels vervaardigd van cement, zand en een toeslagmateriaal, bijvoorbeeld grind. De tegels worden gegoten (nat) of - voor een betere kwaliteit - met een hydraulische pers machinaal geperst (droog) met als basis een mengsel van cement en kleurstof, marmergruis of steenmeel. De gegoten tegels werden ook geperst, maar met minder hoge druk. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "cementtegel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/56e6915e-ebea-45b9-b489-d4ba62566356>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/452e08a8-bdb5-4f54-af1b-a6fad24369e9>
  a skos:Concept;
