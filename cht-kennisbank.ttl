  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/dc17e2b9-b5ef-4a53-bc6b-f349734d6db0>
  a skos:Concept;
  skos:prefLabel "mispelhout"@nl;
  skos:scopeNote "Mispelhout is taai hout van de mispel, een soort uit de appelfamilie, waarvan de vruchten pas eetbaar zijn als ze (spreekwoordelijk) beurs zijn. In de late Middeleeuwen gebruikte men dit hout oa voor kammen en molenraderen. (Haslinghuis)"@nl;
  skos:altLabel "mispel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e18fb4b8-6e86-4982-8f70-c00d01cd8635>
  a skos:Concept;
  skos:prefLabel "Ghisekenhout"@nl;
