<https://data.cultureelerfgoed.nl/term/id/cht/41cccb6d-71f5-4904-aa87-2dd064eedbc8>
  a skos:Concept;
  skos:prefLabel "snorfietsen"@nl;
  skos:scopeNote "De snorfiets is een bromfiets met een maximale constructiesnelheid van 25 km/uur die in 1974 is geïntroduceerd. (Wikipedia)"@nl;
  skos:altLabel "snorfiets"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ae909e7a-167a-4843-ab55-700118b84e7b>;
