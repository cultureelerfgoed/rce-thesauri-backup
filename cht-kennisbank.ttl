<https://data.cultureelerfgoed.nl/term/id/cht/3ed72786-9a26-4b7b-b80f-33c635616f05>
  a skos:Concept;
  skos:prefLabel "singels"@nl;
  skos:scopeNote "Singels bestaan uit een strook grond rondom een centraal terrein met loofhout beplant. Een singel kan ook de beplante (buiten)zijde van een gracht zijn. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "singel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2971af0-cde7-4888-b828-33443f702e7d>;
