<https://data.cultureelerfgoed.nl/term/id/cht/19d0aca8-16a4-4e60-88f2-a84af0698410>
  a skos:Concept;
  skos:prefLabel "bergères (stoel)"@nl;
  skos:scopeNote "Gestoffeerde leunstoelen die verschillen van andere leunstoelen omdat ze tussen de armleuning en de zitting zijn gestoffeerd. (AAT-Ned)"@nl;
  skos:altLabel "bergère (stoel)"@nl;
