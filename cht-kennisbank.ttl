<https://data.cultureelerfgoed.nl/term/id/cht/0147b16b-ed98-4ea0-81e3-47c0e952b5dc>
  a skos:Concept;
  skos:prefLabel "rolprinten"@nl;
  skos:scopeNote "Rolprint is een versieringstechniek die gebruikt maakt van rollers waarin het ontwerp is gegraveerd. Met deze rollers wordt een gekleurd ontwerp op textiel aangebracht. De textiel wordt tussen een aandrukrol en een aantal ontwerprollen doorgevoerd. Het aantal ontwerprollen wordt bepaald door het aantal kleuren in het ontwerp. (Conservation Dictionary)"@nl;
  skos:altLabel "rolprint"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/0148dbb9-1e86-4a3a-8814-5acae348d7ce>
  a skos:Concept;
  skos:prefLabel "kinderstoelen"@nl;
  skos:scopeNote "Stoelen voor kinderen met lange poten, een etensblad en een voetensteun. (AAT-Ned)"@nl;
  skos:altLabel "kinderstoel"@nl;
