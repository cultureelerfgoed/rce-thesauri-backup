  a skos:Concept;
  skos:prefLabel "markiezen (afdak)"@nl;
  skos:scopeNote "Afdak (van hout, glas, ijzer) als beschutting boven een buitendeur, (in XVIII) het uitklappende deel van een officierstent. (Haslinghuis)"@nl;
