  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c55c085b-ef3d-4d1d-a301-eb919b0debf3>
  a skos:Concept;
  skos:prefLabel "schroei"@nl;
  skos:scopeNote "Rimpels zijn kleine golven en vouwen die zijn ontstaan door zwelling van de oppervlaktelaag of door krimp van de ondergrond. Dit kan komen door verschil in vochtabsorptie in bijvoorbeeld huid of gefineerd hout of door krimp in de drager van een verflaag."@nl,
    "Rimpeling is een kleinschalig golfpatroon in de verflaag als gevolg van een te groot bindmiddelgehalte in de verf."@nl,
    "Het verschijnen van oneven (kleine) vouwen, groeven en richels met gevolg een golvende laag in de verflaag, meestal in pasteuse verf."@nl;
  skos:altLabel "rimpels"@nl, "rimpeling"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/19a4249c-f03b-4c4c-9806-45c04fb0bceb>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e3ad75c3-0df0-4fcc-b59e-db7d7c8a1871>
  a skos:Concept;
  skos:prefLabel "opvullen (procedé)"@nl;
  skos:scopeNote "Het procédé van het vullen, vooral door de inhoud goed samen te persen. (AAT-Ned)"@nl,
    "Het gebruik van een zacht materiaal of massa om op te vullen of te verhogen, te verzachten, dan wel te beschermen. (AAT-Ned)"@nl;
  skos:altLabel "opvullen (bekledingstechniek)"@nl, "opgevuld (bekledingstechniek)"@nl,
    "opgevuld"@nl;
