<https://data.cultureelerfgoed.nl/term/id/cht/8407a184-a3c4-4e4c-b8f3-db5b47918cd6>
  a skos:Concept;
  skos:prefLabel "visnetten"@nl;
  skos:scopeNote "Visnetten zijn netten waar vissers vis mee proberen te vangen. Oorspronkelijk gebeurde dat met kleine netten en kleine boten. Tegenwoordig worden grote boten met netten met forse afmetingen ingezet. (Van Dale)"@nl;
  skos:altLabel "visgaas"@nl, "visgazen"@nl, "visnet"@nl;
