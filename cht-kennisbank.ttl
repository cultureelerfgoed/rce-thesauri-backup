<https://data.cultureelerfgoed.nl/term/id/cht/3147f111-1540-46a6-86e9-ce6d89178261>
  a skos:Concept;
  skos:prefLabel "spouwlatten"@nl;
  skos:scopeNote "Spouwlatten zijn houten latten die in de spouw bij vensteropeningen worden gezet om de spouwen dicht te zetten en om kozijnen bouwtechnisch goed te kunnen plaatsen en te verankeren."@nl;
  skos:altLabel "spouwlat"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9a74028b-5750-47f9-a16f-b6772f361572>;
