<https://data.cultureelerfgoed.nl/term/id/cht/533063c6-014d-446e-9cf3-057f8e577cac>
  a skos:Concept;
  skos:prefLabel "kettingspanners"@nl;
  skos:scopeNote "Apparaat om de aandrijvende ketting op de juiste spanning te houden."@nl;
  skos:altLabel "kettingspanner"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/368b697c-012d-4bd6-bb52-e0ff4a9cefa9>;
