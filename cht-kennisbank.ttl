<https://data.cultureelerfgoed.nl/term/id/cht/6cce0d89-2237-4512-8772-b9f45050a55e>
  a skos:Concept;
  skos:prefLabel "vierkante motoren"@nl;
  skos:scopeNote "Motor waarvan de slag van de zuiger gelijk is aan de boring of de diameter van de cilinder."@nl;
  skos:altLabel "vierkante motor"@nl;
