<https://data.cultureelerfgoed.nl/term/id/cht/ed104c06-1901-4db2-8030-9cfc2f217d8c>
  a skos:Concept;
  skos:prefLabel "vakscholen"@nl;
  skos:scopeNote "Scholen die onderwijs bieden voor één of meer geschoolde of halfgeschoolde ambachten of beroepen. (AAT)"@nl,
    "Onderwijsinstellingen die onderwijs bieden voor één of meer geschoolde of halfgeschoolde ambachten of beroepen. Gebruik 'technische hogescholen' voor onderwijsinstellingen voor technisch onderwijs. (AAT)"@nl;
