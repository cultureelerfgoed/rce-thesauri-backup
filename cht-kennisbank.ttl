<https://data.cultureelerfgoed.nl/term/id/cht/7724ac6d-3681-4bff-9e8d-ed6bd833130e>
  a skos:Concept;
  skos:prefLabel "midden bronstijd"@nl;
  skos:scopeNote "De midden-bronstijd wordt gekenmerkt door een verandering in aardewerkstijl (Hilversum-aardewerk), en de opkomst van een verscheidenheid aan bronzen artefacten, vermoedelijk afkomstig uit Groot-Brittannië en Centraal Europa. Dit is tevens de periode waaruit de meeste grafheuvels en begravingen bekend zijn en regelmatige, gestructureerde huisplattegronden dateren."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/929141df-23b4-4415-bab2-5bd5c715ed01>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/95dcba86-f259-4ac5-b7b0-8ca9669eeb06>,
