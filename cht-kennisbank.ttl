<https://data.cultureelerfgoed.nl/term/id/cht/39e52cca-2caf-4321-9f4a-8371ac6038e0>
  a skos:Concept;
  skos:prefLabel "busten"@nl;
  skos:scopeNote "Beeld, een mens voorstellend van kruin tot borsthoogte. (Religieus Erfgoedthesaurus)"@nl;
  skos:altLabel "buste"@nl, "borstbeeld"@nl, "borstbeelden"@nl;
