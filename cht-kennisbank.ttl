<https://data.cultureelerfgoed.nl/term/id/cht/59c8472c-a6d7-458b-b25e-dcf70f779a27>
  a skos:Concept;
  skos:prefLabel "pic"@nl;
  skos:scopeNote "Van een langwerpige kern gemaakt staafvormig (vuur)stenen werktuig, met één of twee puntige uiteinden, waarmee de knollen vuursteen uit de omringende kalk konden worden gehakt (gebruikt in de vuursteenmijnbouw). (ABR)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
