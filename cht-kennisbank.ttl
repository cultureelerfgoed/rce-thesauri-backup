<https://data.cultureelerfgoed.nl/term/id/cht/72a2e559-30c0-414b-80f0-532ecc7d7588>
  a skos:Concept;
  skos:prefLabel "schanskleden"@nl;
  skos:scopeNote "Zeildoeken kleden die over de verschansing of over de mars werden gelegd om er zich tijdens het gevecht achter te verschuilen en het dek aan het gezicht van de vijand te onttrekken. Sedert de middeleeuwen werden schanskleden ook gebruikt als versiering. (MARDOC)"@nl;
  skos:altLabel "schanskleed"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/77f91bd1-4367-448a-903c-da826fa40e88>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/9d988b04-36cf-4947-96f8-e573964b63f3>
  a skos:Concept;
  skos:prefLabel "gipszagen (medisch gereedschap)"@nl;
