<https://data.cultureelerfgoed.nl/term/id/cht/87a120ba-5ba4-4b0e-9d32-22b2cecd4d31>
  a skos:Concept;
  skos:prefLabel "aanzetstenen (hoekblok)"@nl;
  skos:scopeNote "Aanzetstenen zijn hoekblokken waarop of waartegen een gewelf of een vensterboog begint en waarvan het bovenvlak helt volgens de radiaal daarvan. Aanzetstenen zijn doorgaans uitgevoerd in natuursteen. (Haslinghuis)"@nl;
  skos:altLabel "aanzetsteen (hoekblok)"@nl, "aanzetstuk (hoekblok)"@nl, "aanzetstukken (hoekblok)"@nl;
