<https://data.cultureelerfgoed.nl/term/id/cht/da4445c1-de0c-4077-9bd6-a646f42f3525>
  a skos:Concept;
  skos:prefLabel "apophysis"@nl;
  skos:scopeNote "Apophysis zijn aflopen, kwartholle profielen als overgang van een zuilschacht naar het onderste profiel van een kapiteel. Oorspr. Grieks apophyge. (Haslinghuis)"@nl;
  skos:altLabel "apohyge"@nl;
