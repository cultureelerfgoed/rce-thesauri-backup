  a skos:Concept;
  skos:prefLabel "diepdrukken"@nl;
  skos:scopeNote "Diepdruk (ook wel koperdiepdruk) is een grafische druktechniek. Deze techniek kenmerkt zich door het gebruik van een drukplaat (inktoverbrenger) waarin kleine verdiepte uitsparingen de inkt vasthouden. (Wikipedia)"@nl;
