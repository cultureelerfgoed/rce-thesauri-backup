<https://data.cultureelerfgoed.nl/term/id/cht/ffcdf29d-f436-49c8-b0f1-e647a3592f49>
  a skos:Concept;
  skos:prefLabel "betonvloeren"@nl;
  skos:scopeNote "Betonvloeren zijn vloeren die op de een of andere manier zijn vervaardigd uit (gewapend) beton. In de meeste gevallen gaat het om draagvloeren. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "betonvloer"@nl;
