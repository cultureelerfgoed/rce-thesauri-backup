<https://data.cultureelerfgoed.nl/term/id/cht/f8c8e614-e2d5-4fb9-a39e-ea8cffc8143b>
  a skos:Concept;
  skos:prefLabel "Jura turpentine"@nl;
  skos:scopeNote "Een aromatische oleohars verkregen uit de rode den, Pinus resinosa, van bomen in de Vogezen in Frankrijk. Een aromatische oleohars die wordt verkregen uit de rode den, Pinus resinosa, van bomen in de Vogezen in Frankrijk. (AAT)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e5bf910a-6164-428e-8627-7b01998a52af>;
