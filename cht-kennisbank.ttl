<https://data.cultureelerfgoed.nl/term/id/cht/1373a5cb-78b7-4727-a679-7bef19ba8de3>
  a skos:Concept;
  skos:prefLabel "verwekingspunt"@nl;
  skos:scopeNote "Het verwekingspunt is een specifieke waarde van de viscositeit van gesmolten glas. Het ligt bij 6 x 106 Nsm-2. Het gebied waarin glas kan worden bewerkt is het temperatuurgebied tussen het verwekingspunt en het bewerkingspunt (103 Nsm-2)."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/929f2b49-e558-4543-a710-41a893c3c5dd>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/137a14d9-fa4b-465b-b165-5ba0dbcdca46>
  a skos:Concept;
  skos:prefLabel "alcohol"@nl;
  skos:scopeNote "Een alcohol is een organische stof die een hydroxylgroep bevat."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/4aa80fe7-54cc-409d-9c50-a0d1b73a0bf2>,
    <https://data.cultureelerfgoed.nl/term/id/cht/d1aa4658-8e2a-426a-a100-ff3867cf1fb3>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4aa80fe7-54cc-409d-9c50-a0d1b73a0bf2>
  a skos:Concept;
  skos:prefLabel "gedenatureerde alcohol"@nl;
  skos:scopeNote "Gedenatureerde alcohol is ethanol waaraan giftige stoffen zijn toegevoegd om de alcohol ongeschikt te maken voor menselijke consumptie. Hiervoor wordt vaak methanol of propanol gebruikt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/137a14d9-fa4b-465b-b165-5ba0dbcdca46>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d1aa4658-8e2a-426a-a100-ff3867cf1fb3>
  a skos:Concept;
  skos:prefLabel "mentol"@nl;
  skos:scopeNote "Mentol (C<sub>10</sub>H<sub>19</sub>OH) is een isoprenoide alcohol; het is de hoofdcomponent van pepermuntolie (smeltpunt 42 °C). Zie vluchtig bindmiddel."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/137a14d9-fa4b-465b-b165-5ba0dbcdca46>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/137be9d4-0740-47f8-884c-c92402ea9741>
  a skos:Concept;
  skos:prefLabel "luchtcorrectiesproeiers"@nl;
  skos:scopeNote "De luchtcorrectiesproeier bestaat uit twee pijpjes in elkaar geschoven. In beide pijpjes wordt benzine toegevoerd, alvorens de benzine aan de venturi wordt afgeleverd. Wanneer de snelheid van de motor toeneemt, stroomt lucht via de luchtcorrectiesproeier in het binnenste buisjes, waarin een aantal gaatjes is gemengd, waardoor het mengsel armer wordt."@nl;
  skos:altLabel "luchtcorrectiesproeier"@nl, "mengbuis"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/518b8352-7764-4bc1-b0f4-bc91f1220053>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/138aeb2a-786b-4e47-a657-468c4e0b4cab>
  a skos:Concept;
  skos:prefLabel "bruiloftskleding"@nl;
  skos:scopeNote "Speciaal ontworpen kleding of kledingsstukken die op de bruiloft worden gedragen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5dec9aa2-5ced-4f77-b929-c043b90b2a8f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/13980608-fcc9-46c1-9857-c3b84a5f8693>
  a skos:Concept;
  skos:prefLabel "notenhout"@nl;
  skos:scopeNote "Notenhout is hout van de notenboom. Het hout is fraai gevlamd, paarsig bruin, vast en duurzaam en niet te hard. Daarom is dit hout geschikt voor snij- en beeldhouwwerk en meubels. Notenhout komt voor een deel uit Nederland, maar het meeste wordt ingevoerd uit Frankrijk, Italië en de Verenigde Staten. Vooral de 'wolkige' wortelnoten van de worteldelen was zeer geliefd voor fineer. (Haslinghuis)"@nl;
  skos:altLabel "notehout"@nl, "noten (hout)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ba6bdd8e-2f33-4268-a6a0-791e94a6a782>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/dec01d69-b5c4-47fd-8e66-433bbc543b63>,
    <https://data.cultureelerfgoed.nl/term/id/cht/1a47e066-995f-4195-98d3-dbda07a0755d>,
    <https://data.cultureelerfgoed.nl/term/id/cht/5779a4da-29d1-410a-b085-c34e1d205893>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/1a47e066-995f-4195-98d3-dbda07a0755d>
  a skos:Concept;
  skos:prefLabel "wortelnotenhout"@nl;
  skos:scopeNote "Wortelhout van de notenboom."@nl;
  skos:altLabel "wortelnotehout"@nl, "notenwortelhout"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/13980608-fcc9-46c1-9857-c3b84a5f8693>;
