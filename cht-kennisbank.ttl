<https://data.cultureelerfgoed.nl/term/id/cht/53ef04ef-8a07-4a34-92a4-88ad8e6e1781>
  a skos:Concept;
  skos:prefLabel "sprinklerinstallaties"@nl;
  skos:scopeNote "Een sprinkler (installatie) is een automatische blusinstallaties die een brand geheel automatisch bestrijdt doordat de sprinklerkop opent door warmte en water vrij geeft."@nl;
  skos:altLabel "sprinklerinstallatie"@nl, "sprinklers"@nl, "sprinkler"@nl;
