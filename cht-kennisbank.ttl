  a skos:Concept;
  skos:prefLabel "woningbouw"@nl;
  skos:scopeNote "Het bouwen van gebouwen met een woningfunctie, in het bijz. in grote aantallen tegelijk. Begrip in gebruik sedert in XIXb blokken woningen werden gebouwd. (Haslinghuis)"@nl;
