  skos:prefLabel "street art"@nl;
  skos:scopeNote "Een veelzijdige categorie beeldende kunst gemaakt in openbare ruimtes, waaronder Graffiti, maar ook andere vormen zoals muurschilderingen en installaties."@nl;
