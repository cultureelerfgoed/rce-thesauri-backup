<https://data.cultureelerfgoed.nl/term/id/cht/4afd7eb1-87ca-42d3-a75d-4380a9d001d6>
  a skos:Concept;
  skos:prefLabel "allroad motorfietsen"@nl;
  skos:scopeNote "Zoals de naam al zegt zijn deze motorfietsen eigenlijk geschikt voor 'alle wegen'. Ze zijn ontstaan doordat motorrijders hun offroadmotoren op de openbare weg gingen gebruiken."@nl;
  skos:altLabel "allroad motorfiets"@nl;
