<https://data.cultureelerfgoed.nl/term/id/cht/7f9569e6-dc5c-4435-8929-b04ac9675ac9>
  a skos:Concept;
  skos:prefLabel "gietmallen"@nl;
  skos:scopeNote "Gietvorm voor loden glasroeden: Bestaat uit twee ijzeren helften, die aan de onderzijde draaiend aan elkaar bevestigd zijn. Ze worden klemmend op elkaar bevestigd. In gesloten toestand blijven twee H-vormige sleuven vrij. Daarin wordt vloeibaar lood gegoten. Na afkoeling worden de twee helften van elkaar gedraaid en komen de ruwe loodstrippen vrij (Van aaks tot zwei)."@nl;
  skos:altLabel "gietmal"@nl, "gietvorm"@nl, "gietvormen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f49473cf-3321-44b9-b084-1a570cdab368>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/803f50ac-8747-4d47-8b50-696b9c45538e>
  a skos:Concept;
  skos:prefLabel "ribbenhamers"@nl;
  skos:scopeNote "Zware moker met ribben op beide koppen. Wordt gebruikt voor de kathedraalslag."@nl;
  skos:altLabel "ribbenhamer"@nl;
