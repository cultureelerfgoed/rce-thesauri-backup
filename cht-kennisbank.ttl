<https://data.cultureelerfgoed.nl/term/id/cht/64f9bcfa-b366-4cb2-a4dc-208397ae9a72>
  a skos:Concept;
  skos:prefLabel "balkdelen"@nl;
  skos:scopeNote "In Nederland uit ingevoerde balken van naaldhout gezaagde deel, lat of plank. (Haslinghuis)"@nl;
