<https://data.cultureelerfgoed.nl/term/id/cht/79b17efa-451e-4660-bd5d-6d6b6ff2791a>
  a skos:Concept;
  skos:prefLabel "Turkse driehoeken"@nl;
  skos:scopeNote "Overkragend stuk dat een driehoekig vlak vertoont en toegepast wordt als verklimming of overgangslid naar een koepelvorm ( pendentief). Gewoonlijk meer decoratief, gestuct of geschilderd en onderverdeeld in kleinere driehoeken, waarbij een soortgelijk fries aansluit. (Haslinghuis)"@nl;
  skos:altLabel "Turkse driehoek"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4e481c81-319a-44da-86bf-106f145d22c1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/bd554f30-bdfd-4662-b508-352f76139c44>
  a skos:Concept;
  skos:prefLabel "Engelse tuinen"@nl;
  skos:scopeNote "Engelse tuinen zijn landschapstuinen, die in mode waren in de late achttiende eeuw en het begin van de negentiende eeuw. Het concept leunt op de voorstelling van romantische, parkachtige landschappen met verrassende doorkijkjes. In de praktijk wordt dit doorgaans gestalte gegeven door de aanleg van grasvelden, liefst op heuvelachtig terrein, slingerende paden en boomgroepen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "Engelse tuin"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d24939f9-6831-4b70-80fc-c3a3531784a9>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ec0f4960-d3b7-43e6-a966-fa9e231cddb2>
  a skos:Concept;
  skos:prefLabel "veenstromen"@nl;
