<https://data.cultureelerfgoed.nl/term/id/cht/12851d95-b7fd-4377-8e03-f35d07d77ba2>
  a skos:Concept;
  skos:prefLabel "cathedrae"@nl;
  skos:scopeNote "Bisschopszetel, in een oudchristelijke basiliek gemaakt van steen en geplaatst op een podium tegen de muur van de apsis. Later, i.v.m. de omdraaiing van het altaar, aan de Evangeliezijde van het koor geplaatst, vervaardigd van ivoor, hout of brons en in het koorgestoelte opgenomen. Er zijn uit vroegchristelijke, romaanse en gotische tijd enkele cathedra’s bewaard gebleven (Vaison, Avignon, Vienne, Bordeaux). (Haslinghuis)"@nl;
  skos:altLabel "cathedra"@nl, "katheder (bisschopszetel)"@nl, "katheders (bisschopszetel)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/76109138-ac33-4dbf-b858-9e83f625e78d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/18c120db-82ba-4ca8-93a8-dc5621663f72>
  a skos:Concept;
