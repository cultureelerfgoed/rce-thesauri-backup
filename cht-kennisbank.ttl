  a skos:Concept;
  skos:prefLabel "bovenhuizen (molen)"@nl;
  skos:scopeNote "Bovenbouw van een wipmolen. Het is een houten kast met een rechthoekige horizontale doorsnede en een gewelfd houten dak. De kast bestaat uit een geraamte van stijlen en balken dat aan de buitenzijde beschoten is met kleedhout. (Haslinghuis)"@nl;
  skos:altLabel "bovenhuis (molen)"@nl;
