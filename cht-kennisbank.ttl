  a skos:Concept;
  skos:prefLabel "bladzijden"@nl;
  skos:scopeNote "De afzonderlijke zijden van bladen die ontstaan bij het vouwen van een blad, van bijvoorbeeld papier of perkament, dat leeg kan zijn, beschreven, bedrukt of op een andere manier gevuld. Een pagina verschilt daarin van een 'folio', dat een folio alleen aan de voorzijde is genummerd. (AAT-Ned)"@nl;
  skos:altLabel "pagina"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91712616-6dec-4871-8fdc-c317850c20d1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/da15c031-fe3c-4127-8058-a2f11af4ddc9>
  a skos:Concept;
  skos:prefLabel "staven (materiaal)"@nl;
  skos:scopeNote "Netwerken van kleine, lichte staven van hout, metaal of ander materiaal, die elkaar op regelmatige afstanden kruisen, gewoonlijk diagonaal. (AAT-Ned)"@nl;
  skos:altLabel "staaf (materiaal)"@nl;
