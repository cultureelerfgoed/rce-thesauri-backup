<https://data.cultureelerfgoed.nl/term/id/cht/c5abf457-96fc-475a-bcce-26c6b69f35dc>
  a skos:Concept;
  skos:prefLabel "moffelovens"@nl;
  skos:scopeNote "Een moffeloven is een kleine oven voor het bij lagere temperatuur (opnieuw) branden/verhitten van aardewerk en glas, met name bij het emailleren en vuurvergulden. De bereikte temperatuur gaat van 700 tot 900 °C. (Conservation Dictionary)"@nl;
  skos:altLabel "moffeloven"@nl;
