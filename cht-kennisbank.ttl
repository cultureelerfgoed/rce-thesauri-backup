<https://data.cultureelerfgoed.nl/term/id/cht/1908c535-c89b-40e5-96dd-fea188817e9d>
  a skos:Concept;
  skos:prefLabel "stylolieten"@nl;
  skos:scopeNote "stylolieten: gebrek in de vorm van een grillig vertand grensvlak in kalksteen."@nl;
