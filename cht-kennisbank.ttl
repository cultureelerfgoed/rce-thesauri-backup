<https://data.cultureelerfgoed.nl/term/id/cht/487c09ef-5caf-45c6-9be4-16f0316a902b>
  a skos:Concept;
  skos:prefLabel "latwerken (tuinarchitectuur)"@nl;
  skos:scopeNote "Latwerken zijn tuinornamenten geconstrueerd van dunne latten waarlangs klimplanten of twijgen van bomen of heesters worden geleid. In de Frans classicistische tuinen gebruikte men latwerk om besloten ruimten te creëren. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "latwerk (tuinarchitectuur)"@nl, "treillage"@nl, "treillages"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2971af0-cde7-4888-b828-33443f702e7d>;
