<https://data.cultureelerfgoed.nl/term/id/cht/41bc9fc2-072f-48e0-aed1-1020c31a1787>
  a skos:Concept;
  skos:prefLabel "luikisolatie"@nl;
  skos:scopeNote "Luikisolatie is isolatie verwerkt in een los of vast luik. (Geschiedenis en ontwikkeling van het isoleren in Nederland : een eerste verkenning van historische isolatiematerialen en hun toepassingen in monumenten / B.H.J.N. Kooij, In: Praktijkreeks cultureel erfgoed; afl. 15, nr. 40, 2011)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ad490831-5350-46ef-9ef2-642e58d6b696>;
