<https://data.cultureelerfgoed.nl/term/id/cht/e048b73f-6a1e-48d6-aa3a-29195be5a5de>
  a skos:Concept;
  skos:prefLabel "spitlagers"@nl;
  skos:scopeNote "Een spitlager is het lager waarop het spit ronddraait. In de Middeleeuwen was dit een stenen lager."@nl;
  skos:altLabel "spitlager"@nl;
