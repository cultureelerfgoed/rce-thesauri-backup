<https://data.cultureelerfgoed.nl/term/id/cht/901e5f9c-ab3f-4d6b-bf07-d816f2b95ea4>
  a skos:Concept;
  skos:prefLabel "bloemenmahoniehout"@nl;
  skos:scopeNote "Bloemenmahoniehout is een variëteit van mahoniehout dat bekend staat om zijn opvallende, bloemachtige patronen, gewaardeerd voor het maken van luxe meubels en fineerwerk."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0d026114-0c6a-4a2a-ab20-e87bdc76c5c1>;
