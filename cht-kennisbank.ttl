<https://data.cultureelerfgoed.nl/term/id/cht/66d84822-a384-475b-9c31-e29f1f918594>
  a skos:Concept;
  skos:prefLabel "bitumineuze platen"@nl;
  skos:scopeNote "Bitumineuze platen zijn kunststofplaten die doordrenkt zijn met bitumen, vaak gebruikt als dakbedekking of waterdichte laag vanwege hun uitstekende weerbestendigheid en flexibiliteit."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cd793303-5575-48db-a1c1-8befcb9089c4>;
