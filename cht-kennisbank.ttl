<https://data.cultureelerfgoed.nl/term/id/cht/bbb22804-ab02-410c-b3fd-cf161097e433>
  a skos:Concept;
  skos:prefLabel "jaaghouten"@nl;
  skos:scopeNote "Los rondhout dat op biesboschaken werd gebruikt om de jager uit te zetten."@nl,
    "Rondhout dat bij zeeschepen op de boegspriet werd vastgezet, om deze langer te maken."@nl,
