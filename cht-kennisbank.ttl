<https://data.cultureelerfgoed.nl/term/id/cht/023c54af-b532-4c9c-9e45-edfecd41fb7c>
  a skos:Concept;
  skos:prefLabel "pijlstaartroggen"@nl;
  skos:scopeNote "Pijlstaartroggen (Dasyatidae) zijn een familie van roggen die veelal voorkomen in de tropische kustwateren. Daarnaast zijn er ook soorten bekend die voorkomen in zoete wateren. (Wikipedia)"@nl;
  skos:altLabel "Dasyatidae"@nl, "pijlstaartrog"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/78672fa4-8815-4427-995e-21a2cc90bd39>;
