<https://data.cultureelerfgoed.nl/term/id/cht/783b880a-50ca-488c-8c56-c85d30da89ed>
  a skos:Concept;
  skos:prefLabel "bedieningskoffers"@nl;
  skos:scopeNote "Koffer waarin zich zowel het vaatje met de ziekenolie als het ziekendoosje bevindt. Wordt door de priester meegenomen naar zieken of stervenden om deze het sacrament van de zieken toe te dienen. Vlaams: berechtingskoffer"@nl;
  skos:altLabel "berechtingskoffers"@nl, "bedieningskoffer"@nl, "berechtingskoffer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0e7caf40-0b58-4424-9632-4a92743854af>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a6f312a3-0d37-4e7c-b8d5-89795ad858c7>
  a skos:Concept;
  skos:prefLabel "hutkoffers (houder)"@nl;
  skos:scopeNote "Onbuigzame, doosachtige houders, meestal groot en vaak versterkt, voor het inpakken van kleren en andere persoonlijke bezittingen of artikelen voor op reis of opslag. (AAT-Ned)"@nl;
  skos:altLabel "hutkoffer (houder)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0e7caf40-0b58-4424-9632-4a92743854af>;
