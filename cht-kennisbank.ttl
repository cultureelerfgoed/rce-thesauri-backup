  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a79b1425-635d-44c8-8869-8ae8312027ff>
  a skos:Concept;
  skos:prefLabel "beschermde stads- of dorpsgezichten"@nl;
  skos:scopeNote "Een beschermd stads- of dorpsgezicht is een gebied binnen een stad of dorp met een bijzonder cultuurhistorisch karakter. Door deze bescherming blijft het cultuurhistorische karakter behouden."@nl,
    "Een beschermd stads- of dorpsgezicht is een gebied dat is aangewezen wegens zijn bijzondere waarde op het gebied van bouwkunst en geschiedenis."@nl;
  skos:altLabel "beschermd stads- of dorpsgezicht"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b97ac49e-c7e1-49fb-8173-b4a3866c14c6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f1fb556d-570b-4797-a831-1523fc387bf2>
  a skos:Concept;
  skos:prefLabel "hoofdwallen"@nl;
  skos:scopeNote "Doorlopende wal rond een vesting, zonder de voor- of buitenwerken. (Stichting Menno van Coehoorn)"@nl,
