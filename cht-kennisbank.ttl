<https://data.cultureelerfgoed.nl/term/id/cht/7b737e7e-3b8d-4b39-b0d6-0081a987f918>
  a skos:Concept;
  skos:prefLabel "paulowniahout"@nl;
  skos:scopeNote "De Anna Paulownia boom, ook wel keizersboom of princess tree genoemd, is vernoemd naar de Russische Anna Paulowna, die met de Nederlandse koning Willem II trouwde."@nl;
  skos:altLabel "keizersboom"@nl, "princess tree"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
