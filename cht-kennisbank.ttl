<https://data.cultureelerfgoed.nl/term/id/cht/82790bb7-22ec-48cf-a262-79d7c66c7c83>
  a skos:Concept;
  skos:prefLabel "weefzwaarden"@nl;
  skos:scopeNote "Een weefzwaard werd gebruikt voor het aanslaan van de draden bij het weven. (ABR)"@nl;
  skos:altLabel "weefzwaard"@nl;
