<https://data.cultureelerfgoed.nl/term/id/cht/838d87b7-ee48-4792-b9e1-49487c0fa438>
  a skos:Concept;
  skos:prefLabel "argentei"@nl;
  skos:scopeNote "De argenteus was een zilveren munt geproduceerd door het Romeinse rijk uit de tijd van de hervorming van het muntenstelsel van Diocletianus in het jaar 294 tot 310. (Wikipedia)"@nl;
  skos:altLabel "argenteus"@nl;
