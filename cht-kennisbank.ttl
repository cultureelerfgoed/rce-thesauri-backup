  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/87975405-7bf4-443e-9b70-3705cc354955>
  a skos:Concept;
  skos:prefLabel "gritstralen"@nl;
  skos:scopeNote "Gritstralen: stralen door een straalmiddel (grit, granulaat, zand) al dan niet in combinatie met lucht en/of water min of meer loodrecht op de gevel te spuiten."@nl;
