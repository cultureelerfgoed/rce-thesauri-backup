<https://data.cultureelerfgoed.nl/term/id/cht/fd31a291-559a-48ed-b051-c5edbb25b1cf>
  a skos:Concept;
  skos:prefLabel "slaglijnmolens"@nl;
  skos:scopeNote "Een slaglijnmolen heeft een lang koord welke u uit kunt trekken en vervolgens even op kunt tillen en dan laten schieten. Er blijft dan een krijtstreep op de vloer achter. Zo tekent u eenvoudig af. (MARDOC)"@nl;
  skos:altLabel "slaglijnmolen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
