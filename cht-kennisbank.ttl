  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2530e817-0537-4e7f-952d-7f0e855654e6>
  a skos:Concept;
  skos:prefLabel "scheepstypen-visserij"@nl;
  skos:scopeNote "Scheepstypologieën betreft de systematische classificatie van scheepstypen, gebaseerd op hun ontwerp en gebruik, zoals in de visserij."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d5a6d0f2-6327-43c1-be4d-0afa5dbd76e0>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d5a6d0f2-6327-43c1-be4d-0afa5dbd76e0>
  a skos:Concept;
  skos:prefLabel "scheepstypologieën"@nl;
  skos:scopeNote "Scheepstypologieën zijn classificatiesystemen die verschillende soorten schepen indelen op basis van hun vorm, functie, en bouwtechnieken. Dit helpt bij het begrijpen van de ontwikkeling en het gebruik van schepen door de geschiedenis heen."@nl;
  skos:altLabel "scheepstypologie"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eef20cde-5429-4714-ac82-0c2b60388930>;
