<https://data.cultureelerfgoed.nl/term/id/cht/4b913d38-5bf8-4c81-959d-81c6de9606ce>
  a skos:Concept;
  skos:prefLabel "doggers"@nl;
  skos:scopeNote "Vaartuig voor de visserij op kabeljauw (doggervis) in het bijzonder op de Doggersbank. Oudste vermelding in 1404. Het gebruik brengt met zich mee dat dogboten in grootte en type kunnen verschillen. Begin 17e eeuw: soort visserspink van 8 last groot naast een soort van driemasthoeker van 30-40 last groot. (MARDOC)"@nl;
  skos:altLabel "dogboten"@nl, "dogboot"@nl, "dogger"@nl, "dogschepen"@nl, "dogschip"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bfbd8aec-1c5a-4353-93b3-d721fac9881d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/cb08e785-a6cb-4a00-9942-a5c857802adc>
  a skos:Concept;
  skos:prefLabel "melkschuiten"@nl;
  skos:scopeNote "Lange, smal platbodem zeilend vaartuig met één à twee masten voor het vervoeren van melk over binnenwateren."@nl;
  skos:altLabel "melkschuit"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c5d2f2e6-180a-432d-a694-3ed8149fbad4>;
