<https://data.cultureelerfgoed.nl/term/id/cht/ffad1a4b-22b9-4739-a974-12735e5a19ee>
  a skos:Concept;
  skos:prefLabel "zuigerveergroeven"@nl;
  skos:scopeNote "Groeven, die rondom in het zuigerlichaam zijn gestoken en waarin de zuigerveren worden aangebracht."@nl;
  skos:altLabel "zuigerveergroef"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/191e6fab-4b8b-49ae-87f9-85763bf6a904>;
