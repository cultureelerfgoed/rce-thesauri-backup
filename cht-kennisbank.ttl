<https://data.cultureelerfgoed.nl/term/id/cht/aa601962-facf-40c1-93b5-be46e98847c4>
  a skos:Concept;
  skos:prefLabel "strandhuisjes"@nl;
  skos:scopeNote "Strandhuisjes zijn vakantiehuizen gesitueerd op het strand en vaak alleen in het zomerseizoen in gebruik. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
