<https://data.cultureelerfgoed.nl/term/id/cht/8f81742b-7484-454a-b70d-58ef80a58428>
  a skos:Concept;
  skos:prefLabel "schalmmessen"@nl;
  skos:scopeNote "Een schalmmes is een stuk gereedschap dat wordt gebruikt om leer, perkament en papier te schalmen. Het heeft een vlakke onderzijde en een afgeschuinde snijkant. (Conservation Dictionary)"@nl;
  skos:altLabel "schalmmes"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2ed04729-7ad2-4346-ae14-74dda34a3163>;
