  a skos:Concept;
  skos:prefLabel "pek"@nl;
  skos:scopeNote "Pek is een meer gezuiverde steenkoolteer, ontdaan van ammoniakwater, benzol en teerolien. Het zuiveren geschiedt door destillatie."@nl;
