  skos:scopeNote "De rijpe zaadkorrel of de onrijpe gedroogde bes van de peperstruik. Wordt gemalen gebruikt als specerij en heeft een scherpe smaak. (MARDOC/Wikipedia)"@nl;
  skos:altLabel "peperkorrel"@nl, "peperkorrels"@nl;
