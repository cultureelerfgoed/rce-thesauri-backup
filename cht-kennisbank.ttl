  a skos:Concept;
  skos:prefLabel "zalfflessen"@nl;
  skos:scopeNote "Een zalfflesje is een lange, smalle of bolvormige container voor dunne zalf die hieruit geschonken kan worden. Zalfflesjes zijn vaak voorzien van een of twee oren. Behalve van aardewerk komen zalfflesjes van glas en metaal voor. Zalfflesjes komen voor in de Romeinse tijd. (ABR)"@nl;
  skos:altLabel "balsamarii"@nl, "balsamarium"@nl, "parfumfles"@nl, "parfumflessen"@nl,
    "zalffles"@nl;
