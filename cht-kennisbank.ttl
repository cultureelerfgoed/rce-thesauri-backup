<https://data.cultureelerfgoed.nl/term/id/cht/eb9610d8-5132-4269-a853-b8175ba0b860>
  a skos:Concept;
  skos:prefLabel "viceadmiraal"@nl;
  skos:scopeNote "Een viceadmiraal in de marine is een senior vlagofficier, vaak tweede in bevel onder een admiraal, met verantwoordelijkheden voor de strategische leiding en coördinatie van maritieme operaties."@nl,
    "Nederlandse vlagofficier boven schout-bij-nacht. (MARDOC)"@nl;
  skos:altLabel "vice-admiraals"@nl, "vice-admiraal"@nl;
