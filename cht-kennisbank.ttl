  a skos:Concept;
  skos:prefLabel "gezangborden"@nl;
  skos:scopeNote "Aankondigingsbord voor de gezangen of liederen die in de eredienst zullen worden gezongen. Is veelal bevestigd aan kerkmuur, zuil of preekstoel. (Religieus Erfgoedthesaurus)"@nl;
  skos:altLabel "gezangbord"@nl;
