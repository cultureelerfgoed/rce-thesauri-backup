<https://data.cultureelerfgoed.nl/term/id/cht/8db3ba2e-550d-4647-a08f-0683056ac656>
  a skos:Concept;
  skos:prefLabel "oordeelspelen"@nl;
  skos:scopeNote "Van oorsprong middeleeuws kerkelijk kunstuurwerk, dat op gezette tijden bijbelse scènes te zien geeft, voorgesteld door poppen."@nl;
  skos:altLabel "oordeelspel"@nl;
