<https://data.cultureelerfgoed.nl/term/id/cht/0d681b79-f3fa-4241-a59e-52d1330f19cb>
  a skos:Concept;
  skos:prefLabel "putkisten"@nl;
  skos:scopeNote "Putkisten zijn de bovengrondse opbouwen van waterputten in de vorm van een getimmerde houten kist. Onderin zit vaak een houten putdeksel. Boven de kist zit vaak een windas met slinger of een putgalg gemonteerd."@nl;
  skos:altLabel "putkist"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cc35695d-14c2-4533-8dde-d121a0b71bda>;
