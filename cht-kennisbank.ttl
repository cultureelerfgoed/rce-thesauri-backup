<https://data.cultureelerfgoed.nl/term/id/cht/e22f1e12-1d0b-4f64-9556-a40225b6a47d>
  a skos:Concept;
  skos:prefLabel "kreken"@nl;
  skos:scopeNote "Een kreek is een kleine getijdengeul in een getijdenbekken, vaak tussen kwelders gelegen, en ontstaat door de eb- en vloedbewegingen. Kreken zijn in het Holoceen gevormd. (Weerts & Bazelmans 2011 / Jongmans et al. 2013)"@nl;
  skos:altLabel "kreek"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0470207a-e317-4891-96dd-461e0ae8a63f>;
