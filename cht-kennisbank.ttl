<https://data.cultureelerfgoed.nl/term/id/cht/68c0a74d-930d-4178-87b1-19b2a52628d7>
  a skos:Concept;
  skos:prefLabel "borduurgaren"@nl;
  skos:scopeNote "Borduurgaren is een speciaal type textielgaren dat wordt gebruikt voor borduurwerk, gekenmerkt door zijn glans en sterkte, ideaal voor gedetailleerde en decoratieve steken."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/86d3631a-1f3f-4b51-bbbb-dadebc310ecc>;
