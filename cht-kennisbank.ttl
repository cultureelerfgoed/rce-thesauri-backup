<https://data.cultureelerfgoed.nl/term/id/cht/2c002039-8cb7-4bd5-a36d-e7450e9f763b>
  a skos:Concept;
  skos:prefLabel "differentiëlen"@nl;
  skos:scopeNote "Tandwielstelsel in de aandrijving, dat het mogelijk maakt dat de aangedreven wielen met verschillende snelheden kunnen draaien als de wagen door een bocht gaat. In een bocht moet het buitenste wiel een grotere afstand afleggen dan het binnenste wiel en moet daarom sneller draaien."@nl;
  skos:altLabel "differentieel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/3404a4e0-e349-4d47-89d0-735151467e92>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/2c0eebd4-f465-4254-bdc7-f5047ffd259d>,
    <https://data.cultureelerfgoed.nl/term/id/cht/74864733-64ee-48ff-bd36-e93e9d889d60>,
