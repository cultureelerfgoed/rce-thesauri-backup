<https://data.cultureelerfgoed.nl/term/id/cht/753dd01b-7beb-4320-878e-ad9d84df81ec>
  a skos:Concept;
  skos:prefLabel "degens"@nl;
  skos:scopeNote "Een degen is een wapen dat wordt gebruikt bij schermen. (Wikipedia)"@nl;
