  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/be32e9fb-192d-445d-824e-d81d3f99a467>
  a skos:Concept;
  skos:prefLabel "porringpunten"@nl;
  skos:scopeNote "Middelpunt van waaruit de boog wordt getrokken of de plaats waar de draad wordt vastgezet om de juiste richting van de voegen tussen de stenen te bepalen. Het ligt bij een gebogen kozijnbovendorpel of segmentboog meestal op c. 1,5 maal de horizontale steendagmaat vanuit de top van de boog op de hartlijn van de opening. (Haslinghuis)"@nl;
  skos:altLabel "porringpunt"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/929f2b49-e558-4543-a710-41a893c3c5dd>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d5240bfd-08be-46ff-b066-9522e9bb7bf0>
  a skos:Concept;
