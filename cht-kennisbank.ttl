  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/09ab28e7-d6b3-489c-bd84-b9e95a9f3081>
  a skos:Concept;
  skos:prefLabel "voorhoven"@nl;
  skos:scopeNote "Open ruimte, plein voor de hoofdingang van een gebouw en aan twee of drie zijden door vleugels of armen omvat. B.v. het atrium met zijgalerijen van een vroegchristelijke of romaanse kerk, de door een voorburcht omsloten hof, basse cour, buitenhof van een kasteel of Frans hôtel. ‘Côté cour’ en ‘côté jardin’ zijn nog steeds Franse toneelaanwijzingen, oorspr. van toepassing op de theaterzaal van de Tuilerieën. (Haslinghuis)"@nl;
  skos:altLabel "voorhoof"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/8528f737-ab2b-4566-8d22-65d076b018e1>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/25397e18-80f0-49ce-9a40-52f2b1422d82>,
    <https://data.cultureelerfgoed.nl/term/id/cht/0b6754fe-1e10-473d-b069-1b68ea197b15>,
    <https://data.cultureelerfgoed.nl/term/id/cht/6b5a1150-889f-482b-b25f-dece5613b4c2>,
    <https://data.cultureelerfgoed.nl/term/id/cht/326b7671-8388-4384-8b64-993e0eae533b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/15844068-6b2e-413f-9915-8c96af97e828>
  a skos:Concept;
  skos:prefLabel "metseltekens"@nl;
  skos:scopeNote "Metseltekens zijn figuren in baksteenmuren, die in een min of meer contrasterende steen met het optrekken van het metselwerk is aangebracht. Vaak hebben de tekens de vorm van ruiten of andreaskruisen."@nl;
  skos:altLabel "metselteken"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4e481c81-319a-44da-86bf-106f145d22c1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/14d58741-85be-4e1b-aa21-5e3d4458aac1>
  a skos:Concept;
  skos:prefLabel "stadialen"@nl;
  skos:scopeNote "Een stadiaal is een koudere periode binnen een glaciaal. Stadialen zijn perioden waarin het landijs zich uitbreidt. (Wikipedia)"@nl;
  skos:altLabel "stadiaal"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cfbb8bc7-ebda-4791-8fa2-3d2af6abd583>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/66d202d2-ea98-4586-9c4a-40e1b5a8f068>
  a skos:Concept;
  skos:prefLabel "ijsbruggen"@nl;
  skos:scopeNote "IJsbruggen zijn bruggen om van de wal op het ijs te komen. In koude noordelijke landen hebben ijsbruggen vaak een aanzienlijke lengte omdat de winningplek ver verwijderd ligt van de opslagplaats. Dergelijke bruggen hebben een glijbaanfunctie. (IJskelders, koeltechnieken van weleer / A.W. Reinink en J.G. Vermeulen, Nieuwkoop 1981)"@nl;
  skos:altLabel "ijsbrug"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5830cbd3-8bd3-4a4e-9d7c-6f506fd364ae>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/675aa967-0be7-4aee-883a-56641b218215>
  a skos:Concept;
  skos:prefLabel "kuipen (bemalingswerktuig)"@nl;
  skos:scopeNote "(weidemolen) bemalingswerktuig; binnen de kuip draaide de waaier."@nl;
  skos:altLabel "kuip (bemalingswerktuig)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/04770e4f-1c11-40e7-a256-9de8c6d569c6>;
