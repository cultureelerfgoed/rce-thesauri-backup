<https://data.cultureelerfgoed.nl/term/id/cht/0518b694-5c75-43aa-aa48-08528520a46c>
  a skos:Concept;
  skos:prefLabel "steigerhout"@nl;
  skos:scopeNote "Hout dat gebruikt wordt om een steiger mee te maken, in de M.e. voorn. kortelingen en masten. (Haslinghuis)"@nl;
