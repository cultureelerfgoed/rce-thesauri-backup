  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/753a8c9a-ee6d-4f29-91bb-928d59fb7d03>
  a skos:Concept;
  skos:prefLabel "terpentine"@nl;
  skos:scopeNote "Koolwaterstof oplosmiddelen, die gebruikt worden voor het chemisch reinigen in de textielconservering."@nl;
