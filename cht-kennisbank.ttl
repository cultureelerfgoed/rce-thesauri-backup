<https://data.cultureelerfgoed.nl/term/id/cht/ad06c382-0d0b-4190-a8de-4e0a80113602>
  a skos:Concept;
  skos:prefLabel "heipalen"@nl;
  skos:scopeNote "Wordt gebruikt voor palen die op het bouwterrein in positie worden ingeheid. (AAT-Ned)"@nl;
  skos:altLabel "heipaal"@nl;
