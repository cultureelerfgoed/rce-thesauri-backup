  a skos:Concept;
  skos:prefLabel "botervloten"@nl;
  skos:scopeNote "Dekschalen voor het bewaren en serveren van boter aan tafel. (AAT-Ned) Gebruik 'boterschaaltjes' voor kleine schalen voor porties boter voor één persoon. (AAT-Ned) Gebruik 'boterkoelers' voor bakjes die ontworpen zijn om gekoelde boter op tafel te serveren. (AAT-Ned)"@nl;
