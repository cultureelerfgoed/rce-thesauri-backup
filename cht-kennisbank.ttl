<https://data.cultureelerfgoed.nl/term/id/cht/93e5a1a3-88d9-46a4-ac3c-18bf0a6696d8>
  a skos:Concept;
  skos:prefLabel "tablina"@nl;
  skos:scopeNote "Hoofdvertrek, zitkamer, ontvangstruimte in een Romeins woonhuis, gelegen tussen atrium en peristilium. (Haslinghuis)"@nl;
  skos:altLabel "tablinum"@nl;
