    <https://data.cultureelerfgoed.nl/term/id/cht/0d1ae206-bcc9-4735-96ac-d34b5b5bbd84>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/7a6ffdd9-25ba-41b0-8b18-460adc82eafb>
  a skos:Concept;
