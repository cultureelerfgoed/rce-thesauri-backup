<https://data.cultureelerfgoed.nl/term/id/cht/b3e5c29b-7619-4c40-9dcb-52730f6a28e1>
  a skos:Concept;
  skos:prefLabel "meetlinten"@nl;
  skos:scopeNote "Een meetlint, lintmeter of meetband is een gereedschap waarmee de maat van iets genomen kan worden, of waarmee men afstanden kan meten. Een metrisch lint is meestal onderverdeeld in centimeters en decimeters en van één tot vijftig meter lang. Een meetlint kan gemaakt zijn van metaal, kunststof, textiel of papier. Grotere meetlinten worden in een haspel opgerold bewaard.(Wikipedia)"@nl;
  skos:altLabel "meetlint"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/36963dcd-7f11-4902-8e8e-91eb92ad8ffd>;
