<https://data.cultureelerfgoed.nl/term/id/cht/bb30749b-3598-47a0-ae9d-13e93c924866>
  a skos:Concept;
  skos:prefLabel "schilderscholen"@nl;
  skos:scopeNote "School waar men schilderen leert; ook: kunstbeweging, groep van schilders die volgens een bepaalde stijl werken, de manier van schilderen die zo'n groep eigen is."@nl;
  skos:altLabel "schilderschool"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f6451643-0a3a-4077-a19c-d6a30a4e2583>;
