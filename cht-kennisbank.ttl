<https://data.cultureelerfgoed.nl/term/id/cht/2a6be1d4-f19d-43ea-9c07-3590a1e66d4e>
  a skos:Concept;
  skos:prefLabel "verwarmingsrijtuigen"@nl;
  skos:scopeNote "Het verwarmingsrijtuig zorgde in de winter voor de verwarming van alle (persoons) rijtuigen"@nl;
