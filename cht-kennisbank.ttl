  a skos:Concept;
  skos:prefLabel "cocondraden"@nl;
  skos:scopeNote "Cocondraden zijn fijne, zijdeachtige draden die worden gesponnen door rupsen bij het maken van hun cocon, en worden veelal gebruikt in de textielindustrie."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2b3abca2-0b5b-4a9c-8b63-ff1ee30e0610>;
