<https://data.cultureelerfgoed.nl/term/id/cht/b1aee2d5-734f-4971-9ffd-b43485bfc6eb>
  a skos:Concept;
  skos:prefLabel "gevestplaten"@nl;
  skos:scopeNote "Het gevest van een zwaard is het deel dat houvast biedt en bestaat uit de greep, waar de hand past en de pareerstang of stootplaat. Deze plaat is een metalen stang tussen greep en kling, dat gebruikt kan worden om het wapen van de tegenstander op te vangen. Soms is dit onderdeel schijfvormig, soms ontbreekt het. De pareerstand of stootplaat vindt zijn oorsprong in het enkelhandig zwaardvechten tegen een schild. Zonder deze stootplaat zou een slag tegen een schild namelijk de handen van de aanvaller beschadigen.(Wikipedia)"@nl;
  skos:altLabel "gevestplaat"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/71f15138-ea1c-4d66-8f7b-c6435ad8f3bf>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8e75e913-eb4e-41df-b481-b2e0866f5c83>
  a skos:Concept;
  skos:prefLabel "zwaardgrepen"@nl;
