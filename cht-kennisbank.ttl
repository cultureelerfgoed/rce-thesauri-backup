<https://data.cultureelerfgoed.nl/term/id/cht/aba7c871-3de6-4e74-8010-6a7ef565901d>
  a skos:Concept;
  skos:prefLabel "usenet"@nl;
  skos:scopeNote "Usenet (ook bekend als 'netnews' of 'news') is een wereldwijd, gedecentraliseerd netwerk voor de uitwisseling van door de gebruikers gemaakte tekstberichten of binaire bestanden. Alle berichten worden geplaatst in zogeheten nieuwsgroepen; een nieuwsgroep richt zich meestal op een specifiek onderwerp, gebruikt (als er van tekstberichten sprake is) een specifieke taal, en is soms beperkt tot een specifiek land, gebied of instituut."@nl;
  skos:altLabel "Netnews"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/31bf5543-c7d0-4c15-a603-9ce921a9607d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/29b1461e-fc25-4111-8076-449000dc331a>
  a skos:Concept;
