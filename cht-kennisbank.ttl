<https://data.cultureelerfgoed.nl/term/id/cht/3bf5e756-b53f-449b-aaf7-aca3eb38a99e>
  a skos:Concept;
  skos:prefLabel "golfschotten"@nl;
  skos:scopeNote "Golfschotten zijn elementen in watertorens die eventuele golven van het water in het reservoir dempen. Hierdoor blijft de watertoren stabiel en gaat de toren niet nog meer bewegen bij harde windstoten. (Henk van der Veen, Watertorens in Nederland. 1994, p. 33)"@nl;
  skos:altLabel "golfschot"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ba4b10ae-c486-42a4-82f8-3417c6a8a4cc>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/61fc8ce1-121e-41ff-876c-1bfdad26d356>
  a skos:Concept;
  skos:prefLabel "estrikken (vloer)"@nl;
  skos:scopeNote "Vloer van leem, cement e.d., vlakke afwerklaag op een stenen ondervloer die dient als onderlaag voor een daarna aan te brengen vloerafwerking. Men onderscheidt cement-, magnesiet- en bitumineuze estrik. Als toeslagmateriaal gebruikt men o.a. zand, zaagsel (houtgraniet), kurkkorrels enz.. (Haslinghuis)"@nl;
  skos:altLabel "estrik (vloer)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/3bf64cd9-cf95-4482-9e31-6069991467df>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/65f48a28-e8e4-4ff6-a22c-69835a21858f>
  a skos:Concept;
