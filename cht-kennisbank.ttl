<https://data.cultureelerfgoed.nl/term/id/cht/d65f4597-3cb1-4159-bd72-f9f483008ad1>
  a skos:Concept;
  skos:prefLabel "kwarthol"@nl;
  skos:scopeNote "Kwarthol is een concaaf profiel dat zich aftekent als ongeveer een kwart cirkel. Dit wordt vaak begeleid door een bandje, aan lijsten en onder klassieke en romaanse zuilschachten en als afzetting ter weerszijden van een rondstaaf. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/50a5ae33-53bb-4d8c-bc1c-6bf463de641c>;
