<https://data.cultureelerfgoed.nl/term/id/cht/921941d6-f3aa-412b-b6c2-7ee53dc663b2>
  a skos:Concept;
  skos:prefLabel "buitenhoven"@nl;
  skos:scopeNote "Buiten of voor het eigenlijke kasteel gelegen gedeelte waar dienstwoningen, stallen enz. staan. basse court, vgl. voorburcht. (Haslinghuis)"@nl;
