<https://data.cultureelerfgoed.nl/term/id/cht/8f4ef051-c29e-42cd-b499-372f10f0f800>
  a skos:Concept;
  skos:prefLabel "wormgaten"@nl;
  skos:scopeNote "Houtgebrek, gaatje van een houtworm. (Haslinghuis)"@nl;
  skos:altLabel "wormgat"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
