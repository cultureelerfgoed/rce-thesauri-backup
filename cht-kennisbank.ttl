<https://data.cultureelerfgoed.nl/term/id/cht/8fac617d-cc67-425b-af82-faca8177d649>
  a skos:Concept;
  skos:prefLabel "jachttaferelen"@nl;
  skos:scopeNote "Jachttaferelen zijn voorstellingen of afbeeldingen van jachtpartijen. Vele schilderijen met scenes van de jacht zijn gemaakt. (Van Dale)"@nl;
