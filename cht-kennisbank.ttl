<https://data.cultureelerfgoed.nl/term/id/cht/1b54f60a-0c64-4da8-ada3-35d1f5971b91>
  a skos:Concept;
  skos:prefLabel "tweeroeders"@nl;
  skos:scopeNote "Tweeroeders zijn kapbergen met twee roeden. Dit type kapberg heeft vrijwel altijd een zadeldak. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "tweeroeder"@nl, "tweeroedige kapberg"@nl, "tweeroedige kapbergen"@nl;
