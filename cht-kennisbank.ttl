<https://data.cultureelerfgoed.nl/term/id/cht/066126bd-5d28-45f4-89d4-23b14a5d221a>
  a skos:Concept;
  skos:prefLabel "bisschopsringen"@nl;
  skos:scopeNote "Ring die dagelijks wordt gedragen door kardinalen, bisschoppen, abten en prelaten. Behoort tot de bisschoppelijke insignia: bisschopsring, bisschopskruis, kromstaf, mijter, bisschopszetel met wapenschild en vroeger pontificale handschoenen en pantoffels. De ring is vervaardigd uit edelmetaal, is veelal versierd met eensteen; soms is er een ruimte voor een reliek."@nl;
  skos:altLabel "bisschopsring"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c44b0e6b-d22e-42d1-97ca-8c0a0aa64065>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/22b99d8b-f79a-4c64-93ef-b0df870c0c37>
  a skos:Concept;
  skos:prefLabel "steenburries"@nl;
  skos:scopeNote "De bovenste, de koker omsluitende, balklaag in de kop van de wipmolen. Rust op de bovenzetel."@nl;
  skos:altLabel "steenburrie"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/04770e4f-1c11-40e7-a256-9de8c6d569c6>;
