<https://data.cultureelerfgoed.nl/term/id/cht/5ff36c93-7938-45bc-81da-2992366e5170>
  a skos:Concept;
  skos:prefLabel "koppelingswerkcilinders"@nl;
  skos:scopeNote "Kleine hydraulisch werkende cilinder waaraan, wanneer hydraulische druk met het koppelingspedaal en de hoofdcilinder wordt uitgeoefend, de zuiger naar buiten treedt en het koppelingsmechanisme bedient."@nl;
  skos:altLabel "koppelingswerkcilinder"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0ef28dc0-1153-4cde-a8a4-7b2873977681>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/671c2a10-161e-42fb-9ff2-8c9aac9c8f49>
  a skos:Concept;
  skos:prefLabel "koppelingsvorken"@nl;
  skos:scopeNote "Vork waarin aan één zijde het koppelingsdruklager is bevestigd en waaraan het andere einde door een stang, een kabel of een hydraulisch mechanisme met het koppelingspedaal is verbonden."@nl;
  skos:altLabel "koppelingsvork"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0ef28dc0-1153-4cde-a8a4-7b2873977681>;
