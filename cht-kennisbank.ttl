<https://data.cultureelerfgoed.nl/term/id/cht/3ee90c32-0a98-46fa-a8db-a7ed2ed72bda>
  a skos:Concept;
  skos:prefLabel "geubels"@nl;
  skos:scopeNote "Rosmolentype waarbij het paard(en) buiten de boerderij rondloopt en daarbij werktuigen aandrijft in de boerderij. Zie ook paarden manege. (Molenwoordenboek G.J. Pouw)"@nl;
  skos:altLabel "geubel"@nl, "manege (molen)"@nl, "manege's (molen)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e4ed082e-0493-43e1-9a53-69e00632deb1>;
