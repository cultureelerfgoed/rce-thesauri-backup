<https://data.cultureelerfgoed.nl/term/id/cht/597014a2-6932-4d8e-b38b-539cffe7cb02>
  a skos:Concept;
  skos:prefLabel "Lingense steen"@nl;
  skos:scopeNote "Lingense steen is een zandsteensoort afkomstig uit de regio Lingen in Duitsland, bekend om zijn gebruik in historische bouw vanwege zijn bewerkbaarheid en esthetiek."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/07067413-15a3-4210-a2ca-5fa80893357d>;
