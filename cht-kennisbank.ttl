  a skos:Concept;
  skos:prefLabel "terraria"@nl;
  skos:scopeNote "Terraria zijn meestal glazen kasjes om daarin fijne broeikasplanten, hagedissen, slangen, padden enz. te houden en gade te slaan."@nl;
