<https://data.cultureelerfgoed.nl/term/id/cht/277dbb30-df28-4ad3-8743-2aefe1d2b31c>
  a skos:Concept;
  skos:prefLabel "geschoren hagen"@nl;
  skos:scopeNote "Beplantingsvormen waarbij heester- of boomsoorten op zeer korte afstand van elkaar worden geplant in één of meerdere rijen en die één of meerdere keren per jaar worden geschoren."@nl;
  skos:altLabel "geschoren haag"@nl;
