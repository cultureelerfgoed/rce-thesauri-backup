  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3f1ace50-e981-4b2e-9b9b-4bfa2cf0b576>
  a skos:Concept;
  skos:prefLabel "visserijschepen"@nl;
  skos:scopeNote "Boot, schuit of schip gebruikt bij het vissen of het vervoer van (levende) vis. (debinnenvaart.nl)"@nl,
    "Vissersboten zijn boten die vissers gebruiken bij het uitoefenen van hun beroep. Zowel kleine houten boten als grote gemotoriseerde boten worden gebruikt voor visserij op zee of op de binnenwateren. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
