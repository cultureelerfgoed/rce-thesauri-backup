<https://data.cultureelerfgoed.nl/term/id/cht/b9d4c9ff-de12-44b9-a0b3-f436fa286395>
  a skos:Concept;
  skos:prefLabel "broodhuizen"@nl;
  skos:scopeNote "Vertrek waarin levensmiddelen, in het bijz. brood, aan behoeftigen werden uitgedeeld, meestal tegen een kerk gelegen (Leeuwarden, Grote Kerk). (Haslinghuis)"@nl;
