<https://data.cultureelerfgoed.nl/term/id/cht/764bd281-d49e-485c-ac5c-d0e75f493984>
  a skos:Concept;
  skos:prefLabel "concordansen"@nl;
  skos:scopeNote "Alfabetisch register van woorden met de aanwijzing van de plaats waar zij in de bijbel staan. Komt voor als handschrift en als gedrukt boek."@nl;
  skos:altLabel "concordans"@nl;
