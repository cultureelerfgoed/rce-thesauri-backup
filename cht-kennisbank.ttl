  a skos:Concept;
  skos:prefLabel "spreiriet"@nl;
  skos:scopeNote "Spreiriet is riet dat als onderlaag in een rieten dak wordt verwerkt. De eigenschappen van spreiriet zijn: recht stelen met een max lengte 2,50 m. Het materiaal wordt direct op rietlatten, van boven naar onder, aangebracht."@nl,
    "Spreiriet is riet dat als onderlaag in een rieten dak wordt verwerkt. De eigenschappen van spreiriet zijn: recht stelen met een max lengte 2,50 m. Het materiaal wordt direct op rietlatten, van boven naar onder, aangebracht. "@nl;
