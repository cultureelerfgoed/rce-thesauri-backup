<https://data.cultureelerfgoed.nl/term/id/cht/33cd3b4b-b002-4b4c-924b-7863da7c0f4a>
  a skos:Concept;
  skos:prefLabel "adventure bikes"@nl;
  skos:scopeNote "Adventure bikes zijn zware allroadmotoren, die in het algemeen zijn uitgevoerd met een uitgebreide kofferset, waarmee wereldreizigers hun tochten volbrengen."@nl;
  skos:altLabel "adventure bike"@nl;
