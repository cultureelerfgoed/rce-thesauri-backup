<https://data.cultureelerfgoed.nl/term/id/cht/00dd52f1-d37c-4fce-a214-bd87c0d852bc>
  a skos:Concept;
  skos:prefLabel "schoorsteenpijpen"@nl;
  skos:scopeNote "Schoorsteenpijpen zijn doorgaans ronde schoorsteenkanalen. De pijpen kunsr van steen of metaal zijn. Ook de uit aardewerk gebakken rookmond die op de schoorsteenschacht geplaatst is, wordt schoorsteenpijp genoemd. (Haslinghuis)"@nl;
  skos:altLabel "schoorsteenpijp"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6717f660-f7ac-4ed4-bbfe-28a235d56ea9>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/61a82470-3fbf-4e6d-9a52-bcad7398e377>
  a skos:Concept;
  skos:prefLabel "kiezelbakken"@nl;
  skos:scopeNote "Kiezelbakken zijn rechthoekige of ronde zinken bakken met kleine openingen, aangebracht op platte daken ter plaatse van de hemelwaterafvoeren, om te voorkomen dat kiezels, bladeren en ander aangewaaid materiaal in de afvoeren terechtkomen en zo verstoppingen geven. (Bouwkunde / Jellema, R., deel 3, 1964)"@nl;
  skos:altLabel "kiezelbak"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a28cd055-1cd1-461f-bd9d-c4d301454206>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b5267079-f85c-4275-b547-3ed58a6d17fa>
  a skos:Concept;
  skos:prefLabel "paalwerken"@nl;
  skos:scopeNote "Palissade, omheining van in de grond geslagen palen of staken ten behoeve van landaanwinning. (BRT)"@nl;
  skos:altLabel "paalwerk"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/04770e4f-1c11-40e7-a256-9de8c6d569c6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6283b4a9-cf6e-4519-b36b-2d31b3235e6a>
  a skos:Concept;
  skos:prefLabel "draaiblinden"@nl;
  skos:scopeNote "Draaiblinden zijn blinden die scharnierend zijn uitgevoerd. Ze kunnen open en dicht gedraaid worden. (Historische zonwering / B.H.J.N. Kooij, RCE Brochure, Amersfoort, 2012)"@nl;
  skos:altLabel "draaiblind"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/822d09a8-1cd9-4c03-a260-1f46c8998ce5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/07f54341-6edb-4ef6-9d6b-9f3e2edc9503>
  a skos:Concept;
  skos:prefLabel "troffelvloeren"@nl;
  skos:scopeNote "Troffelvloeren zijn naadloze vloeistofdichte vloeren op plaatsen waar zeer hoge eisen worden gesteld aan mechanische of chemische belasting. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "troffelvloer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/be9ffbd0-dd12-491e-b9a1-0d224a57a03d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/00c02908-ca89-4295-8878-a219606c3c81>
  a skos:Concept;
  skos:prefLabel "zetschoorstenen"@nl;
  skos:scopeNote "Los, trechtervormig element dat boven een stookplaats werd geplaatst om een grote schoorsteenopening te verkleinen, zodat de rook niet in het vertrek kon dwarrelen. Bekend uit advertenties begin XIX. (Haslinghuis)"@nl;
  skos:altLabel "zetschoorsteen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/84cffb71-5ca0-43b2-b21f-33014471e95c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c8d8c9fd-9d9f-4af1-a867-de3069148754>
  a skos:Concept;
  skos:prefLabel "Friese huisgroep"@nl;
  skos:scopeNote "De Friese huisgroep is een benaming voor een indeling in boerderijtypen die R.C. Hekker heeft gemaakt. De boerderijen in Friesland, Noord-Holland boven het IJ, het noorden en oosten van Groningen en op de Waddeneilanden zijn in deze groep ingedeeld. Overeenkomsten in deze boerderijtypen zijn de grondtas, de toepassing van (over het algemeen) dekbalkgebinten en de Friese stal."@nl;
  skos:altLabel "noordelijke huisgroep"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24681d2a-2f2d-40fe-8257-25a35525ae92>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/618d5e63-9ba4-4f27-9611-d59416436c47>
  a skos:Concept;
  skos:prefLabel "soldeer"@nl;
  skos:scopeNote "Mengsel van lood en tin waarmee in gesmolten vorm onderdelen van loodwerk aan elkaar kunnen worden verbonden en naden waterdicht gemaakt. Men onderscheidde grof soldeer (3 lood, 1 tin) en fijn soldeer (2 lood, 1 tin). M.ned. soudeer. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/81cc6e88-be0d-41a8-90f6-ea6179fce550>
  a skos:Concept;
  skos:prefLabel "binnenspouwmuren"@nl;
  skos:scopeNote "Binnenspouwmuren zijn spouwmuren toegepast als scheidingsmuren tussen gebouwen, veelal woningen, met als doel geluidoverlast, met name contactgeluid te voorkomen."@nl;
  skos:altLabel "binnenspouwmuur"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/035120de-d3a4-407f-9125-0f3ea2860c2f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c0395b99-a026-4597-b599-713297b6e0ab>
  a skos:Concept;
  skos:prefLabel "rangeerterreinen"@nl;
  skos:scopeNote "Rangeerterreinen zijn spoorwegemplacementen voor het rangeren van treinen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "rangeerterrein"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/89af9530-a005-4f58-8b7f-b0658391fe4a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fc6d0b78-a171-45c3-9e45-310f73ec9c3e>
  a skos:Concept;
  skos:prefLabel "caponnières (galerij)"@nl;
  skos:scopeNote "In het gebastionneerde stelsel (bastion) een door de droge gracht aangelegde weg, die verbinding geeft met de vooruitliggende lunette en door geschutbanken gedekt wordt. (Haslinghuis)"@nl;
  skos:altLabel "caponnière (galerij)"@nl, "grachtgalerij"@nl, "grachtgalerijen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/591d32cb-84e1-45a3-8c6e-0846546cbd32>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/49be13b4-226e-47a9-a75c-144b82771333>
  a skos:Concept;
  skos:prefLabel "peristylen"@nl;
  skos:scopeNote "Zuilenrij rond het centrale deel van een tempel ( peripteros) of rond een binnenplaats. (Haslinghuis)"@nl;
  skos:altLabel "peristyle"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b46878d8-c4e5-4861-aded-86b4934e3f0c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8d5df333-cb47-44f2-bf9b-c2075b82f218>
  a skos:Concept;
  skos:prefLabel "zinkputten"@nl;
  skos:scopeNote "Zinkputten zijn gemetselde putten zonder bodem waarin vuil water of regenwater kan wegzakken. In bepaalde gevallen doet men een laag grind in de put om het water makkelijk wel te laten zakken."@nl;
  skos:altLabel "zinkput"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cc35695d-14c2-4533-8dde-d121a0b71bda>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/972fa62e-51cc-4690-b707-fe4e9d4f2883>
  a skos:Concept;
  skos:prefLabel "bouwmarkten"@nl;
  skos:scopeNote "Bouwmarkten zijn grote winkels die hoofdzakelijk doe-het-zelf-producten verkopen. In bouwmarkten is alles te koop om te klussen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/10f47eb6-f1a9-465f-b8ab-8381925f039b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3723dbb2-dc79-49e2-b55b-067687baefe1>
  a skos:Concept;
  skos:prefLabel "werkkamers"@nl;
  skos:scopeNote "Werkkamers zijn vertrekken binnen een gebouw die zijn ingericht als kantoor of werkruimte, vaak persoonlijk ingericht en bedoeld voor geconcentreerd werk."@nl;
  skos:altLabel "werkkamer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5f973f74-2afb-4d34-96af-8bf888b93318>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/02d08985-bac8-4e04-bed3-4977416f5396>
  a skos:Concept;
  skos:prefLabel "uitspanningen"@nl;
  skos:scopeNote "Buitencafés of buitenherbergen. Te onderscheiden van andere drinkgelegenheden (bijvoorbeeld cafés of bars) doordat ze meer op het buiten zijn gericht en op gezinnen met kinderen. (AAT-Ned)"@nl;
  skos:altLabel "uitspanning"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7650ee06-28e5-4178-a7c2-00b9fdfe8394>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4df9ac06-7089-45a3-a949-502a9be24c9a>
  a skos:Concept;
  skos:prefLabel "schortkneppels (oliemolen)"@nl;
  skos:scopeNote "(oliemolen), hefboom, kneppel waarmee de heien en stampers uit het werk werden gelicht. (Molenwoordenboek B.D. Poppen)"@nl;
  skos:altLabel "schortkneppel (oliemolen)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/04770e4f-1c11-40e7-a256-9de8c6d569c6>;
