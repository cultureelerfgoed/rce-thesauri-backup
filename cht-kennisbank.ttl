<https://data.cultureelerfgoed.nl/term/id/cht/05321266-6ef9-4b91-a8f1-c527dfddd9fc>
  a skos:Concept;
  skos:prefLabel "smalspoorlijnen"@nl;
  skos:scopeNote "Smalspoor is een spoorweg met een spoorwijdte die kleiner is dan 1435 mm (normaalspoor). (Wikipedia)"@nl;
  skos:altLabel "smalspoorlijn"@nl;
