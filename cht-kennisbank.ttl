  a skos:Concept;
  skos:prefLabel "doopsgezinden"@nl;
  skos:scopeNote "Doopsgezinden zijn leden van een christelijke geloofsgemeenschap die de volwassenendoop en geweldloosheid centraal stelt. Zij vormen een eigen kerkgenootschap."@nl;
