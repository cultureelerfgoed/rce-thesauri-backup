<https://data.cultureelerfgoed.nl/term/id/cht/c6ff7468-0894-4693-952e-7697e9edd0c2>
  a skos:Concept;
  skos:prefLabel "onderkleding"@nl;
  skos:scopeNote "Kledingstukken die onder de bovenkleding worden gedragen. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5dec9aa2-5ced-4f77-b929-c043b90b2a8f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c9ba043c-b333-4a6a-b593-8ebaedea539a>
  a skos:Concept;
  skos:prefLabel "avondmaalskleding"@nl;
  skos:scopeNote "Variant van de streekdracht zoals die wordt gedragen bij deelname aan het heilig avondmaal."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5dec9aa2-5ced-4f77-b929-c043b90b2a8f>;
