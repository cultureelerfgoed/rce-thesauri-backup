<https://data.cultureelerfgoed.nl/term/id/cht/aee35ba6-7599-43d3-9c34-9ceb1346fc86>
  a skos:Concept;
  skos:prefLabel "trekhonden"@nl;
  skos:scopeNote "Gebruik trekhonden voor honden die zijn getraind en ingezet om lasten of voertuigen te trekken, zoals sledes of karren. Betreft specifieke werkhonden binnen de categorie honden, vaak gebruikt in koude gebieden of in sportcontext (sledehondensport). Voorbeelden zijn rassen zoals de Siberische husky en Alaskan malamute. Sluit honden uit die geen trekkrachtwerk verrichten."@nl;
  skos:altLabel "trekhond"@nl, "sledehonden"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/577eaa56-49f8-489b-9a9b-376735b1e42b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/934a31eb-dff9-481d-ae54-5fa9ba134654>
  a skos:Concept;
  skos:prefLabel "oorlogspropaganda"@nl;
