<https://data.cultureelerfgoed.nl/term/id/cht/f302aa2a-05cf-4994-9ae9-118639374bb2>
  a skos:Concept;
  skos:prefLabel "graffiti"@nl;
  skos:scopeNote "Graffiti zijn teksten of symbolen die op gebouwen zijn geschilderd of gespoten als uiting van vandalisme of protest. (Conservation Dictionary)"@nl,
    "Bewuste markeringen getekend of geschilderd op, of gekrast in, het oppervlak van een kunstwerk, door iemand anders dan de kunstenaar. Vaak met de bedoeling om de kunstwerk te beschadigen."@nl;
  skos:altLabel "graffiti art"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dd372291-e2df-4cc8-bcd7-3c58b315895f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/9826ca1a-94c0-4641-b19e-22a87d16942e>
  a skos:Concept;
  skos:prefLabel "bedieningswinkels"@nl;
  skos:scopeNote "Bedieningswinkels zijn winkels waar de winkelier de artikelen van grootverpakkingen 'om-verpakt' en in kleine hoeveelheden distributeert naar de consument. De inrichting van was daarop afgestemd. Typerend voor de bedieningswinkel zijn lange toonbanken, met kasregister en weegschalen, daarachter wandstellingen met open bakken met producten. Door de opkomst van supermarkten in de jaren zeventig zijn bedieningswinkels zoals kruidenierszaken nagenoeg verdwenen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "bedieningswinkel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/10f47eb6-f1a9-465f-b8ab-8381925f039b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/92860e93-5bc5-4258-8a97-ff310d0d609c>
  a skos:Concept;
  skos:prefLabel "naalden (nokrib)"@nl;
  skos:scopeNote "Naalden zijn de nokribben in houten tongewelven. (Haslinghuis)"@nl;
  skos:altLabel "naald (nokrib)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/732ab127-5a16-4168-afd0-9cfb7cc842eb>;
