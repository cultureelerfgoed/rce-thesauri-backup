<https://data.cultureelerfgoed.nl/term/id/cht/d39faf71-531c-4149-a0e9-e2aeec44bddb>
  a skos:Concept;
  skos:prefLabel "schuiframen"@nl;
  skos:scopeNote "Schuiframen zijn bewegende delen binnen een raamkozijn. Ze bestaan uit de omraming van het vensterglas met de glasroeden en schuiven als geheel in het kozijn. In Nederland komen ze voor vanaf 1686. (Haslinghuis)"@nl;
  skos:altLabel "Engels raam"@nl, "Engels ramen"@nl, "schuifraam"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/27bf738c-67e7-48d7-8865-51214638d85c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/19abc423-c5a2-4185-b659-27ccd0392ba8>
  a skos:Concept;
  skos:prefLabel "muurtabernakels"@nl;
  skos:scopeNote "Tabernakel, ingebouwd in een muur, afgesloten met een deur. Kan de grootte hebben van een kast."@nl;
  skos:altLabel "muurtabernakel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/53d2c7d7-fa80-4795-ae8f-705886c4a4ae>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/7e0bdbf0-2506-4616-9e3d-67222a4fb086>
  a skos:Concept;
  skos:prefLabel "naaidozen"@nl;
  skos:scopeNote "Dozen om instrumenten en werkmaterialen in te doen, met name naaigerei. (AAT)"@nl;
  skos:altLabel "naaidoos"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/44872c69-2b39-4667-88a7-9500b45b65c9>;
