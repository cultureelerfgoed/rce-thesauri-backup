<https://data.cultureelerfgoed.nl/term/id/cht/df676f98-2cf2-4304-8295-5384068320b6>
  a skos:Concept;
  skos:prefLabel "salamanders"@nl;
  skos:scopeNote "Salamanders zijn ronde ijzeren kachels, doorgaans aan de binnenzijde bekleed met vuurvaste steen. Aan de bovenzijde kan de kachel gevuld worden. Veel salamanders staan op ijzeren pootjes. Het grote voordeel van deze kachels is dat vrijwel probleemloos alle vaste brandstoffen kunnen worden gestookt: het zijn de 'allesbranders' van vroeger. (Kachels / R. Rook, Utrecht/Aartselaar, 1985)"@nl;
  skos:altLabel "allesstokers"@nl, "salamander"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b0c78b3b-8b3f-42f6-a904-fd186ce5316f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e15a3535-757f-4201-a6b1-fff35faa340d>
  a skos:Concept;
  skos:prefLabel "valletjes"@nl;
  skos:scopeNote "Valletjes zijn afhangende stroken gordijnstof ter versiering of tegen de inkijk. (Van Dale)"@nl;
