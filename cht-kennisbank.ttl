<https://data.cultureelerfgoed.nl/term/id/cht/3ad54f03-5c37-4549-b0e9-e385cd5bb955>
  a skos:Concept;
  skos:prefLabel "relingen"@nl;
  skos:scopeNote "In ruime zin, benaming voor het geheel van de op het dek staande open omheining van een schip."@nl;
  skos:altLabel "reling"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/77f91bd1-4367-448a-903c-da826fa40e88>;
