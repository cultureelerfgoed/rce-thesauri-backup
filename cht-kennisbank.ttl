<https://data.cultureelerfgoed.nl/term/id/cht/eca8ca55-6b78-49b1-b4ea-ef64efcf5973>
  a skos:Concept;
  skos:prefLabel "ploegscharen"@nl;
  skos:scopeNote "IJzeHet van voren puntige ijzeren (stalen) werktuig dat achter het kouter aan het ploeghout is bevestigd en de grond van onderen lossnijdt. (ABR)"@nl;
  skos:altLabel "ploegschaar"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/beb84149-ddcd-42a4-b46c-b57b79826540>;
