<https://data.cultureelerfgoed.nl/term/id/cht/e2567e1c-67c5-433e-ac7e-e1f021349b73>
  a skos:Concept;
  skos:prefLabel "communiebestekken"@nl;
  skos:scopeNote "Bestek, meestal bestaande uit een zilveren vork, mes, lepel en sevetring, geschonken ter ere van de erste communie. Veelal met inscriptie en datum, die aan deze gebeurenis herinneren."@nl;
  skos:altLabel "communiebestek"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
