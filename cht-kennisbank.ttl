<https://data.cultureelerfgoed.nl/term/id/cht/a6a40d08-785a-4278-9498-e0046a18ad33>
  a skos:Concept;
  skos:prefLabel "Tweede Wereldoorlog"@nl;
  skos:scopeNote "Periode tussen 1940 en 1945 waarin Nederland bezet is door het Duitse leger, er in Nederland gevochten wordt en verzetsacties worden gepleegd."@nl;
  skos:altLabel "WO II"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0c0cc97c-2579-40af-b58e-fd2d21b4bc7c>;
