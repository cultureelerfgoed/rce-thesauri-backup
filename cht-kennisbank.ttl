<https://data.cultureelerfgoed.nl/term/id/cht/ae07fd68-7522-47a5-b314-cd134420c4ce>
  a skos:Concept;
  skos:prefLabel "paarden (gereedschap)"@nl;
  skos:scopeNote "Smalle hoge schraag van hout of ijzer, waarop een kalkmouw geplaatst wordt, opdat een opperman hem gemakkelijk kan opnemen. Andere naam: knaap."@nl;
  skos:altLabel "knaap (gereedschap)"@nl, "paard (gereedschap)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
