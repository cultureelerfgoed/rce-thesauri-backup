<https://data.cultureelerfgoed.nl/term/id/cht/4cd3bd14-e13a-405d-a873-e0f85317c2be>
  a skos:Concept;
  skos:prefLabel "smeedwerk"@nl;
  skos:scopeNote "Smeedwerken zijn de werken die door smeden worden of zijn gedaan. Smeedwerken kunnen reparaties zijn of nieuwe werken, al of niet naar voorbeelden uit voorbeeldboeken."@nl;
  skos:altLabel "smidswerk"@nl;
