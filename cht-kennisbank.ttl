<https://data.cultureelerfgoed.nl/term/id/cht/a2893fee-78f9-4f8b-a619-679ca799b2b6>
  a skos:Concept;
  skos:prefLabel "afval"@nl;
  skos:scopeNote "Stoffen of materialen die zijn afgedankt en alleen nog geschikt zijn om te worden weggegooid. (Wikipedia)"@nl;
