<https://data.cultureelerfgoed.nl/term/id/cht/0fd03ab9-36cd-45d8-9332-9713122be587>
  a skos:Concept;
  skos:prefLabel "ontstoren"@nl;
  skos:scopeNote "Ontstoren is een methode voor het retoucheren van een schildering waarbij de lacune ingeschilderd wordt met stipjes of streepjes in kleuren en vormen die niet storen als men ze van een normale afstand bekijkt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3aed2e76-11b6-43c1-bdf2-b70feb13fe6a>
  a skos:Concept;
  skos:prefLabel "beschieten"@nl;
  skos:scopeNote "Met planken of (zie) wagenschot bekleden van een dak, houten gewelf of wand. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
