<https://data.cultureelerfgoed.nl/term/id/cht/f01934cc-c3d3-48f2-9569-ac410ab14f84>
  a skos:Concept;
  skos:prefLabel "motorkapvergrendelingen"@nl;
  skos:scopeNote "De motorkapvergrendeling, in de vorm van een haak, voorkomt dat de motorkap, als die die niet goed in het slot is gevallen openwaait bij het rijden. De vergrendeling is van buitenaf bedienbaar."@nl;
  skos:altLabel "motorkapvergrendeling"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d231e0fd-83f5-49dc-a0cb-f8d61bb87610>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f17e2c3e-c8f0-43d1-8332-227b5da36cf0>
  a skos:Concept;
  skos:prefLabel "temperatuurmeters"@nl;
  skos:scopeNote "Instrument dat de temperatuur van vloeistoffen aangeeft. In een auto gebruikt om de temperatuur van het koelwater van de motor te registreren."@nl;
  skos:altLabel "temperatuurmeter"@nl;
