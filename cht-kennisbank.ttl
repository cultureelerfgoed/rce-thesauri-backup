  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9f0aeb0a-f420-4821-b7c7-5c8a85b1bb80>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d75e6f79-b1b4-433a-806f-585d370065b6>
  a skos:Concept;
  skos:prefLabel "boetegesels"@nl;
  skos:scopeNote "Gesel, bestaande uit takjes of metalen kettingen met pennen, riemen of touwtjes met knopen, metalen kogeltjes of ringen aan het uiteinde. De gesel herinnert aan een van de lijdenswerktuigen en hing als zodanig ook wel aan het kruis. 2. Symbolische gesel die in het zicht lag bij kloosterlijke schuldkapittels. Het synoniem voor de boetegesel is discipline, de uitdrukking ’discipline nemen’ stond voor het zich geselen."@nl;
  skos:altLabel "boetegesel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5ea04285-3622-42ef-9639-ae5c87531260>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e88c0b8e-37e8-437e-a277-2e15de0e62ed>
