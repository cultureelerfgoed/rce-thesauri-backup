<https://data.cultureelerfgoed.nl/term/id/cht/26acd397-9329-4711-a763-1b8a542301f7>
  a skos:Concept;
  skos:prefLabel "bar (eenheid)"@nl;
  skos:scopeNote "De bar is een eenheid van gas- en vloeistofdruk. De SI-eenheid van druk (of spanning) is de pascal (Pa). 1 Pa = 1 newton/ m2; 1 bar = 100.000 Pa = 1,0197 atmosfeer. (Conservation Dictionary)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/929f2b49-e558-4543-a710-41a893c3c5dd>;
