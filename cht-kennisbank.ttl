<https://data.cultureelerfgoed.nl/term/id/cht/418a1262-a411-427b-8563-9759f9b797f1>
  a skos:Concept;
  skos:prefLabel "esdoornhout"@nl;
  skos:scopeNote "Esdoornhout is hout van de esdoorn (botanische familie Acer). Het hout is witachtig tot grijs-geelwit en lichtbruin en wordt verwerkt in fijne betimmeringen en vloeren, o.a. parket. (Haslinghuis)"@nl;
  skos:altLabel "ahorn"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ba6bdd8e-2f33-4268-a6a0-791e94a6a782>;
