<https://data.cultureelerfgoed.nl/term/id/cht/9a8d1349-8900-4ca1-b55c-357b5443fdb7>
  a skos:Concept;
  skos:prefLabel "scheepsuitrusting"@nl;
  skos:scopeNote "Scheepsuitrusting omvat alle zaken die bij het vaartuig horen en voor de vaart noodzakelijk zijn."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/9aef7835-6d9a-4a05-afd8-f53c7abde826>
  a skos:Concept;
  skos:prefLabel "evacueren"@nl;
  skos:scopeNote "Het evacueren van een collectie houdt in het verwijderen van de collectie van een plaats waar deze in onmiddellijk gevaar is."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/190b9fce-fb0d-4b41-b46d-e1795ae38304>;
