  a skos:Concept;
  skos:prefLabel "Scandinavische dolken"@nl;
  skos:scopeNote "Importproducten uit Noord-Duitsland, Helgoland en mogelijk Denemarken. Ze zijn te definiëren als dolken met aan twee zijden oppervlakteretouche. (ABR)"@nl;
