  a skos:Concept;
  skos:prefLabel "gewicht (maateenheid)"@nl;
  skos:scopeNote "Maat voor hoeveelheden stof naar zwaarte. In het metrieke stelsel is de kilogram (kg) de basis van het gewichtstelsel. Oude gewichtseenheden waren o.a. Amsterdams pond (0,494 kg), Nijmeegs pond (0,470 kg) en Delfts pond (0,469 kg). (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/929f2b49-e558-4543-a710-41a893c3c5dd>;
