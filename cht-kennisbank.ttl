<https://data.cultureelerfgoed.nl/term/id/cht/ab78faa0-7ce0-442c-aece-448da5ebb74b>
  a skos:Concept;
  skos:prefLabel "naaldonderdelen"@nl;
  skos:scopeNote "Naaldonderdelen zijn de delen waaruit een naald is opgbouwd."@nl;
  skos:altLabel "naaldonderdeel"@nl;
