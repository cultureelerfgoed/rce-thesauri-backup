<https://data.cultureelerfgoed.nl/term/id/cht/770fb466-9374-4ced-9d65-1e4b106b5ee9>
  a skos:Concept;
  skos:prefLabel "lycea"@nl;
  skos:scopeNote "Lycea (meervoud van lyceum) waren middelbare scholen in Nederland die een combinatie aanboden van gymnasiaal en hbs-onderwijs. Binnen de bredere categorie van middelbare scholen boden lycea een breed curriculum dat leerlingen voorbereidde op het hoger onderwijs, met aandacht voor zowel klassieke talen als moderne wetenschappen."@nl;
  skos:altLabel "lyceum"@nl, "lyceums"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d73bfa19-273a-416b-8c4d-dad7fd384484>;
