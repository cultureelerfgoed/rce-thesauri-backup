<https://data.cultureelerfgoed.nl/term/id/cht/0fc3677d-af55-41d3-9876-c0bc4b16970f>
  a skos:Concept;
  skos:prefLabel "krissen"@nl;
  skos:scopeNote "Indonesische, asymmetrische dolken met een golvend blad, vaak uitgevoerd uit waardevolle materialen zoals goud, ivoor of zeldzame houtsoorten. De kris wordt gezien als een teken van gezag of waardigheid en er worden mystieke krachten aan toegeschreven. (AAT)"@nl;
  skos:altLabel "kris"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/61a56d22-abad-4598-9f52-61ecd6249fcb>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/889d3186-74f0-4d6f-bc14-f2f5890f6c56>
  a skos:Concept;
  skos:prefLabel "bedaking"@nl;
  skos:scopeNote "Wijze waarop een gebouw afgedekt wordt, samenstel van daken op een gebouw. (Haslinghuis)"@nl;
