  a skos:Concept;
  skos:prefLabel "gootijzers (staven)"@nl;
  skos:scopeNote "Gootijzers zijn horizontale ijzeren staven met vierkante doorsnede van circa 1 cm waarop houten goten rusten. Met een scherpe punt zijn zij in de muurplaat geslagen. (Haslinghuis)"@nl;
