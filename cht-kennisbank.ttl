<https://data.cultureelerfgoed.nl/term/id/cht/57e7ce5c-5f09-4dcc-b580-a2822c7db957>
  a skos:Concept;
  skos:prefLabel "authenticiteitsverklaringen"@nl;
  skos:scopeNote "Een authenticiteitsverklaring is een door de bisschop ondertekende verklaring, waarin staat dat de betreffende relieken authentiek zijn. Vaak werd zo’n verklaring opgesteld als de relieken in een altaar werden geplaatst. Daarom staat in de verklaring vaak ook de kerknaam en de datum van de altaarplaatsing. Al in de zestiende en zeventiende eeuw werden zulke verklaringen uitgegeven. (Religieus Erfgoedthesaurus)"@nl;
  skos:altLabel "authenticiteitsverklaring"@nl, "echtheidsbewijs"@nl, "echtheidsbewijzen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91712616-6dec-4871-8fdc-c317850c20d1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

