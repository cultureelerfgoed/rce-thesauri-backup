<https://data.cultureelerfgoed.nl/term/id/cht/9af3e18e-7bc8-40d2-87ca-8eef2dfe2bc3>
  a skos:Concept;
  skos:prefLabel "merklappen"@nl;
  skos:scopeNote "Textielwerken, meestal van fijne stof, waarop door vrouwen en meisjes in verschillende steken is geborduurd en die bedoeld zijn om in te lijsten. Ze werden doorgaans gemaakt door beginnelingen om hun vaardigheden te tonen. Kenmerkend zijn een combinatie van steken, motieven, letters en verzen, en vaak de voltooiingsdatum en de naam van de borduurster. (AAT-Ned)"@nl;
  skos:altLabel "merkdoek"@nl, "merkdoeken"@nl, "merklap"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/623e7274-a6cb-4133-b9b4-83f0db8d4f01>;
