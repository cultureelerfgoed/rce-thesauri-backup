<https://data.cultureelerfgoed.nl/term/id/cht/be177d08-91af-4b6e-a823-6ebbb4fdd99b>
  a skos:Concept;
  skos:prefLabel "meetkettingen"@nl;
  skos:scopeNote "De meetketting is al vanaf de middeleeuwen het meetinstrument waarmee lengte wordt gemeten. Er zijn lengten bekend van 10, 20 en 30 meter. (bron:het leege land)"@nl;
  skos:altLabel "meetketting"@nl, "roedemaat"@nl, "roedematen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/36963dcd-7f11-4902-8e8e-91eb92ad8ffd>;
