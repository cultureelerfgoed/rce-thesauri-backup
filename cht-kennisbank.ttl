<https://data.cultureelerfgoed.nl/term/id/cht/9b53ce1b-24c4-4894-a230-46c55381b5ba>
  a skos:Concept;
  skos:prefLabel "feestbaldakijnen"@nl;
  skos:scopeNote "Baldakijn dat ter gelegenheid van een feestelijke eredienst wordt/werd aangebracht."@nl;
  skos:altLabel "feestbaldakijn"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f75e4d60-1f1a-41a5-82ff-004740964e6c>;
