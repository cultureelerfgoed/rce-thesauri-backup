<https://data.cultureelerfgoed.nl/term/id/cht/05a55363-5860-4a11-bef4-8d0720d686c7>
  a skos:Concept;
  skos:prefLabel "spouwankers"@nl;
  skos:scopeNote "Spouwankers zijn ankers om binnen- en buitenblad van een spouwmuur te koppelen. Vanaf het begin van de 20ste eeuw worden spouwankers toegepast."@nl;
  skos:altLabel "spouwanker"@nl;
