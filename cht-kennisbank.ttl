<https://data.cultureelerfgoed.nl/term/id/cht/b3ac0f71-5686-45a7-8471-d7ebc9bed3b3>
  a skos:Concept;
  skos:prefLabel "achtertuinen"@nl;
  skos:scopeNote "Achtertuinen zijn tuinen gelegen achter een, al dan niet geschakeld, woonhuis waarbij de individueel ingerichte tuin vooral voor sier en ontspanning dient. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "achtertuin"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c2fcf3dc-6efd-4c88-afcf-287b680894ff>;
