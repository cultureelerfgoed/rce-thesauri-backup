  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6d2422e9-4936-44fe-b113-1f9e2581ed72>
  a skos:Concept;
  skos:prefLabel "rietgors"@nl;
  skos:scopeNote "Rietgors is met riet begroeid gors of aangeslibd land. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2971af0-cde7-4888-b828-33443f702e7d>;
