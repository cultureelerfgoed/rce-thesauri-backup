<https://data.cultureelerfgoed.nl/term/id/cht/0f7f3170-f2fa-4bcb-a574-f0e92dd50e64>
  a skos:Concept;
  skos:prefLabel "Amerikaans"@nl;
  skos:scopeNote "Amerikaans heeft betrekking op alles wat afkomstig is uit Amerika, als werelddeel of uit de Verenigde Staten van Amerika. Amerikaans-Engels is de naam voor de varianten van de Engelse taal die gesproken worden in de Verenigde Staten van Amerika en bij uitbreiding in Canada."@nl;
  skos:altLabel "Amerikaanse"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ba8a0df0-e7c1-48f4-ab90-dfde6c264f0e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/39b78e39-218b-4256-a5a0-1b0efb262d85>
  a skos:Concept;
  skos:prefLabel "havenkommen"@nl;
  skos:scopeNote "De beschutte ruimte van een haven. (MARDOC)"@nl;
  skos:altLabel "havenkom"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/800aaad2-2f60-4223-8576-6d52af72dfc8>;
