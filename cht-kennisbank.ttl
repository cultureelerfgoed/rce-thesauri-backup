<https://data.cultureelerfgoed.nl/term/id/cht/152a6b74-0549-4e53-aec0-f8209db88b86>
  a skos:Concept;
  skos:prefLabel "aquarelverf"@nl;
  skos:scopeNote "Een verf die wordt verkregen door pigmenten te mengen in een waterig oplosmiddel, meestal in Arabische gom; wordt doorgaans aangebracht met een kwast. (Zuiderzeemuseum)"@nl;
  skos:altLabel "aquarelverven"@nl;
