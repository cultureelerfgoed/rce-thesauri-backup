  a skos:Concept;
  skos:prefLabel "driekwart zwevende assen"@nl;
  skos:scopeNote "Achteras type waarvan slechts een klein gedeelte van het gewicht van de wagen door de halve assen wordt gedragen en de rest door het ashuis."@nl;
  skos:altLabel "driekwart zwevende as"@nl;
