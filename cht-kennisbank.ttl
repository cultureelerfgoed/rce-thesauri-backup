  skos:scopeNote "Verf met goud als pigment, vaak in combinatie met een ander pigment van een vergelijkbare kleur. ()"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7a795abe-51b8-4f72-85bf-aa2ccce7ff02>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/afc828eb-4b01-453b-8180-7f2efa67d997>
  a skos:Concept;
  skos:prefLabel "wandeltochten"@nl;
  skos:scopeNote "Tochten waarbij te voet wordt gereisd. (AAT)"@nl;
