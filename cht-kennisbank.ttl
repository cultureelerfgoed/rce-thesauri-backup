<https://data.cultureelerfgoed.nl/term/id/cht/63f013a5-ec14-4ad3-b2b5-cf54ce2de1e2>
  a skos:Concept;
  skos:prefLabel "vlotters"@nl;
  skos:scopeNote "De vlotter in de brandstoftank gaat met het vloeistofniveau op en neer. De vloter beweegt een hefboom over een variable weerstand."@nl;
  skos:altLabel "vlotter"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0a0b798b-453c-43ca-a048-174acb18a717>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/67a1dfde-2aec-49c4-8e6a-ca048ba1eca1>
  a skos:Concept;
  skos:prefLabel "luchtinlaten"@nl;
  skos:scopeNote "Met de luchtinlaat wordt de buis aangeduid, waar de buitenlucht de carburateur binnenkomt."@nl;
  skos:altLabel "luchtinlaat"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0a0b798b-453c-43ca-a048-174acb18a717>;
