<https://data.cultureelerfgoed.nl/term/id/cht/a39d3b13-5437-4f9a-a140-6d04d07a7d3a>
  a skos:Concept;
  skos:prefLabel "lampenkappen"@nl;
  skos:scopeNote "Kap over een lamp om het licht af te schermen. (Wikipedia)"@nl;
  skos:altLabel "lampenkap"@nl;
