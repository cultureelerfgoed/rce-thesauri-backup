<https://data.cultureelerfgoed.nl/term/id/cht/bfd5c192-f890-4bbf-b8aa-e2dc7410fa27>
  a skos:Concept;
  skos:prefLabel "metselverbanden"@nl;
  skos:scopeNote "Metselverbanden zijn steenverbanden, de wijze waarop stenen, m.n. bakstenen, aan de buitenzijde van een muur zijn gerangschikt, om een goede hechtheid van het metselwerk te garanderen en de muur een goed aanzien te geven. Essentieel is dat in opvolgende lagen stootvoegen niet boven elkaar staan. (Haslinghuis)"@nl;
  skos:altLabel "metselverband"@nl, "steenverband"@nl, "steenverbanden"@nl;
