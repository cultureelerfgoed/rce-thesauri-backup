  a skos:Concept;
  skos:prefLabel "concaaf conische voet"@nl;
  skos:scopeNote "Een concaaf conische voet is een voet die naar binnen buigt en een conische vorm heeft, waardoor een stabiele basis wordt gecreëerd met een subtiele kromming, die bijdraagt aan de elegantie van het object."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5608b95b-9dac-4142-a188-8abe707023a7>;
