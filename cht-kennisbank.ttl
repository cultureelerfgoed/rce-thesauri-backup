<https://data.cultureelerfgoed.nl/term/id/cht/e7095c67-fa9d-4396-a2b4-a25d7deec38f>
  a skos:Concept;
  skos:prefLabel "kamers (huisje)"@nl;
  skos:scopeNote "Huisje, hoofdzakelijk uit één kamer bestaande, in de M.e. veelal als ‘vrije’ (gratis) woning uitgegeven. Het meervoud betekent dan hofje, zoals Beyerskameren te Utrecht (1597). kamere: 1408 Dordrecht, Minderbroedersklooster; camer: 1442 id.. (Haslinghuis)"@nl;
  skos:altLabel "kamer (huisje)"@nl;
