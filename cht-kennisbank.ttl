<https://data.cultureelerfgoed.nl/term/id/cht/705a9370-8a9a-4513-8a0a-35f6c2e4e1a7>
  a skos:Concept;
  skos:prefLabel "astragalen"@nl;
  skos:scopeNote "Astragalen zijn smal ringvormige en tussen de schacht en het kapiteel van een zuil. Oorspronkelijk maakten ze deel uit van de schacht, maar in de Middeleeuwen van het kapiteel. Het profiel wordt tegen het midden van de 13e eeuw afwaterend. (Haslinghuis)"@nl;
  skos:altLabel "astragaal"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/50a5ae33-53bb-4d8c-bc1c-6bf463de641c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/cd1a9789-6781-414a-aef7-c9a667c39c98>
  a skos:Concept;
  skos:prefLabel "microcement"@nl;
  skos:scopeNote "Microcement is een coating op basis van cement, kunsthars, toevoegingen en minerale pigmenten."@nl;
