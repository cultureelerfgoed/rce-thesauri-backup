<https://data.cultureelerfgoed.nl/term/id/cht/172b5cfa-45fd-4e5d-944a-e6682475d387>
  a skos:Concept;
  skos:prefLabel "cottages"@nl;
  skos:scopeNote "Cottage is sinds de tweede helft van de 18e eeuw in Engeland de naam voor een klein buiten- of voorstadshuis, gebouwd in landelijke stijl maar met moderne gerieflijkheid."@nl;
  skos:altLabel "cottage"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/27a69fff-57b2-4d81-a8ae-9102d21d03e2>;
