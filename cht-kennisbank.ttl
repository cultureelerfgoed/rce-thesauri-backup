<https://data.cultureelerfgoed.nl/term/id/cht/442ef23b-4cb0-4c48-a8d8-84696e5feda8>
  a skos:Concept;
  skos:prefLabel "steensneden"@nl;
  skos:scopeNote "Vormbepaling van of vormgeving aan de stukken steen van een constructie in natuursteen. De vlakken worden uitgeslagen, en hiernaar worden mallen gemaakt volgens welke men de stenen afschrijft. Vooral in Franse architectuurboeken wordt aan de steensnede veel aandacht besteed. (Haslinghuis)"@nl;
  skos:altLabel "steensnede"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/03d3ef65-55c4-441f-b410-ed1e58d79045>;
