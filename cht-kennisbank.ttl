  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/88326f50-39d4-42c8-bec3-28a44ff3e472>
  a skos:Concept;
  skos:prefLabel "sluizen"@nl;
  skos:scopeNote "Een sluis is een inrichting waardoor twee wateren ter weerszijden daarvan met elkaar in verbinding kunnen worden gebracht of juist van elkaar kunnen worden gescheiden. (Thesaurus landschap)"@nl;
