  a skos:Concept;
  skos:prefLabel "caseïne formaldehyde"@nl;
  skos:scopeNote "Caseïne formaldehyde is een type polymeer gemaakt van caseïne (een eiwit uit melk) en formaldehyde, vaak gebruikt voor knopen en sieraden vanwege zijn duurzaamheid en bewerkbaarheid."@nl;
