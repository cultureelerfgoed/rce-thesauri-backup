<https://data.cultureelerfgoed.nl/term/id/cht/7d6b8d10-90f3-4b61-91ef-5a22aba3066d>
  a skos:Concept;
  skos:prefLabel "smoorkleppen"@nl;
  skos:scopeNote "Verstelbare klep in de carburateur, waarvan de stand wordt bepaald door het gaspedaal en waarmee de hoeveelheid benzine/luchtmengsel wordt geregeld, die aan de motor wordt toegevoegd."@nl;
  skos:altLabel "smoorklep"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0a0b798b-453c-43ca-a048-174acb18a717>;
