  a skos:Concept;
  skos:prefLabel "erfpachter"@nl;
  skos:scopeNote "Een erfpachter is een persoon die de bevoegdheid heeft om een onroerende zaak van een ander te houden en te gebruiken."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a25a2f3d-a179-41c7-8d37-cd4da30b7d9f>;
