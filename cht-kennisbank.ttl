<https://data.cultureelerfgoed.nl/term/id/cht/bbd138b5-6524-4e7b-81cc-825e92e77363>
  a skos:Concept;
  skos:prefLabel "kogels (molens)"@nl;
  skos:scopeNote "Ronde stalen kogel die ligt tussen de rijn en het staakijzer bij een kogelrijn. (Molenwoordenboek)"@nl;
