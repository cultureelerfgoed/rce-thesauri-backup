<https://data.cultureelerfgoed.nl/term/id/cht/8b3901aa-9774-4c8f-b091-459fcd17e1e3>
  a skos:Concept;
  skos:prefLabel "sardines"@nl;
  skos:scopeNote "Sardines, ook wel sardienen of pelsers, is een groep vissen die behoren tot de straalvinnige vis uit de familie haringen (Clupeidae). Sardines komen bijna wereldwijd voor en danken hun naam aan het Mediterrane eiland Sardinië, waar ze ooit zeer talrijk voorkwamen. (Wikipedia)"@nl;
  skos:altLabel "sardien"@nl, "sardientje"@nl, "sardientjes"@nl, "sardine"@nl, "pelser"@nl,
    "Clupea pilchardus"@nl;
