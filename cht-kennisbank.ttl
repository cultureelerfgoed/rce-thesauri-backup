  a skos:Concept;
  skos:prefLabel "balies (leuning)"@nl;
  skos:scopeNote "Leuning, hekwerk of balustrade langs een brug, trap, weg- of waterkant, meestal gemaakt van bak- of natuursteen, ijzer of staal, brons e.d. of een combinatie hiervan."@nl;
