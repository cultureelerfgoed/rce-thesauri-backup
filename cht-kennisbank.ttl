<https://data.cultureelerfgoed.nl/term/id/cht/5ea58e28-3ef9-4acf-b2d4-d2eb275b4d71>
  a skos:Concept;
  skos:prefLabel "conservatoria"@nl;
  skos:scopeNote "Hogere school voor muziek, georganiseerd naar het voorbeeld van het ‘Conservatoire national de Musique’ (1795) te Parijs. In Italië kwamen reeds XVI dergelijke kweekscholen voor, maar vooral bestemd voor jonge kinderen (1537 in Napels). (Haslinghuis)"@nl;
  skos:altLabel "conservatorium"@nl, "conservatoriums"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0f30650b-d425-4a45-9cbe-9c6750f701cf>;
