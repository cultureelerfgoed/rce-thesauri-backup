<https://data.cultureelerfgoed.nl/term/id/cht/807debc2-9d4e-4f03-9c9f-f34a267aa2ce>
  a skos:Concept;
  skos:prefLabel "haardhalen"@nl;
  skos:scopeNote "De haardhaal werd bij het koken gebruikt om ketels of pannen op te hangen boven het open vuur in een schouw. Om goed te kunnen koken was een haal in hoogte verstelbaar."@nl;
  skos:altLabel "haardhaal"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aefdd718-b34b-4024-9583-123686fbc209>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8088e52f-c306-4421-94b3-17a7c98d43c8>
  a skos:Concept;
  skos:prefLabel "kastbalgen"@nl;
  skos:scopeNote "De (kast) balg, die zorgt voor de windvoorraad en de juiste druk van de orgelwind."@nl;
  skos:altLabel "kastbalg"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/738ccaaf-b35f-4872-8d3a-ca2575a8a60b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/80923055-868b-4133-9ad4-def78f4071dd>
  a skos:Concept;
  skos:prefLabel "permanent papier"@nl;
  skos:scopeNote "Permanent papier is papier dat gemaakt is volgens de Internationale Standaard ISO 9706:1994 (Information and documentation --Paper for documents--Requirements for permanence). Dit type papier heeft een buffer van calciumcarbonaat en is gemaakt uit bepaalde vezels. Het papier wordt aangeduid met een oneindigheidssymbool in een cirkel."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2d28d9aa-77e8-40ab-b0fe-f04d99f57955>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/80a461b7-696f-4206-b523-696f460d2054>
  a skos:Concept;
  skos:prefLabel "emulaties"@nl;
  skos:scopeNote "Techniek waarmee een computer of toepassingsprogrammatuur zich hetzelfde gedraagt als één van een oudere generatie."@nl;
  skos:altLabel "emulatie"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/47e05121-f2b9-4020-a461-97319b89bf5e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/80cdade5-25c7-48ed-8ef3-796215d4c6f6>
  a skos:Concept;
  skos:prefLabel "UV-fluorescentie"@nl;
  skos:scopeNote "UV-fluorescentie is de straling (meest in het zichtbare gebied) die door een materiaal wordt uitgezonden nadat het is aangestraald (geëxciteerd) door (kortgolvige) ultraviolette straling."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/80e51e54-fe03-4b22-bec4-232de315280d>
  a skos:Concept;
  skos:prefLabel "dye diffusion"@nl;
  skos:scopeNote "Bij een dye diffusion (kleurdiffusie-)proces veranderen toegevoegde stoffen de oplosbaarheid van kleurstoffen waardoor zij in een beeldlaag kunnen migreren."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/80edb9d7-f4e1-4f76-8586-1cb3df88650c>
  a skos:Concept;
  skos:prefLabel "voet per minuut"@nl;
  skos:scopeNote "FPM staat voor voet per minuut en beschrijft de doorvoersnelheid van cinematografische film in de Verenigde Staten en Engeland"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/3481ebf6-767c-4b6a-8b20-b0a0152c60a6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/80f5b058-73cf-4154-9593-d8cde1dbf5db>
  a skos:Concept;
  skos:prefLabel "lijnbussen"@nl;
  skos:scopeNote "Een lijnbus is een bus die wordt ingezet voor openbaar vervoer. (Wikipedia)"@nl;
  skos:altLabel "lijnbus"@nl;
