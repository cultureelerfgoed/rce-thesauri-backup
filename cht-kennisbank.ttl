<https://data.cultureelerfgoed.nl/term/id/cht/7f17e727-226c-4af7-ad32-756909d65cb5>
  a skos:Concept;
  skos:prefLabel "geklonken schepen"@nl;
  skos:scopeNote "Een stalen schip waarvan de huidplaten met ijzeren klinknagels aan elkaar en op de spanten zijn bevestigd. De klinknagels werden eerst roodgloeiend gemaakt, in de openingen geplaatst en aan weerszijden overslagen. Door het afkoelen veranderde de lengte en werden de twee delen stevig tegen elkaar gedrukt."@nl;
  skos:altLabel "geklonken schip"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ffab7ecd-8caa-4191-a63f-ac8ed9258b19>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/414a8e97-8054-45d3-8442-718deb22a9d8>
  a skos:Concept;
