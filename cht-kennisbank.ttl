<https://data.cultureelerfgoed.nl/term/id/cht/c98408e0-a5a0-4a52-90c7-43ee222fc9c8>
  a skos:Concept;
  skos:prefLabel "draadkniptangen"@nl;
  skos:scopeNote "Tang met twee scherpe snijkanten waarmee het stalen binddraad wordt doorgeknipt."@nl;
  skos:altLabel "draadkniptang"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/89c4841b-6283-41dc-940f-9e741e8193a6>;
