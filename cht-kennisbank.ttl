  a skos:Concept;
  skos:prefLabel "strokenvloeren"@nl;
  skos:scopeNote "Strokenvloeren zijn houten dekvloeren bestaande uit smalle, lange houten planken die naast elkaar op een balkenvloer worden gelegd. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
