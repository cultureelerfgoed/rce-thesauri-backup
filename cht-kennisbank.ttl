<https://data.cultureelerfgoed.nl/term/id/cht/7b168a24-cf04-4b43-bf59-466cc8549180>
  a skos:Concept;
  skos:prefLabel "klingen (landschapselement)"@nl;
  skos:scopeNote "Klingen zijn regelmatig gevormde afslagen met min of meer parallelle zijden, waarvan de lengte minstens tweemaal de breedte is. Een kling kan een halffabrikaat zijn. (ABR)"@nl;
  skos:altLabel "kling (landschapselement)"@nl;
