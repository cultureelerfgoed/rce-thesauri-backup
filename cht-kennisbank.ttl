<https://data.cultureelerfgoed.nl/term/id/cht/ada72f2a-bb76-4be6-b05c-c7a16d920492>
  a skos:Concept;
  skos:prefLabel "hakmessen"@nl;
  skos:scopeNote "Een hakmes is een keukenmes met een breed, zwaar lemmet, geschikt voor het grof snijden of hakken van vlees, vis of harde groenten."@nl;
