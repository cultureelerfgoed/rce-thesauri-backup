<https://data.cultureelerfgoed.nl/term/id/cht/1689d4e2-713c-498b-923f-68999fee6279>
  a skos:Concept;
  skos:prefLabel "ampullennissen"@nl;
  skos:scopeNote "Kleine nis in kerkmuur aan de epistelzijde van het altaar, voor het opstellen van het heilig vaatwerk, de ampullen, vaak in combinatie met een piscina. (Haslinghuis)"@nl;
  skos:altLabel "ampullennis"@nl;
