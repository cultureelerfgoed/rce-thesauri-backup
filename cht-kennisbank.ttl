<https://data.cultureelerfgoed.nl/term/id/cht/2647c3bd-eb5f-407e-8282-0aa875ea9010>
  a skos:Concept;
  skos:prefLabel "woestijnmuizen"@nl;
  skos:scopeNote "Meriones is een geslacht van zoogdieren uit de familie van de Muridae en zijn ook wel gekend onder de naam woestijnmuizen of zandmuizen. De wetenschappelijke naam van het geslacht werd voor het eerst geldig gepubliceerd door Johann Karl Wilhelm Illiger in 1811. (Wikipedia)"@nl;
  skos:altLabel "woestijnmuis"@nl, "Meriones (geslacht)"@nl, "zandmuizen"@nl, "zandmuis"@nl;
