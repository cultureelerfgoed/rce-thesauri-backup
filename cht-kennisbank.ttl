<https://data.cultureelerfgoed.nl/term/id/cht/63c24c4e-4272-4387-9c08-c3dc6bfd2104>
  a skos:Concept;
  skos:prefLabel "Wieringer boerderijen"@nl;
  skos:scopeNote "Wieringer boerderijen zijn de voorlopers van de Westfriese stolpen. De Wieringer boerderij heeft een éénlaags woonhuis met haaks er op een hoge schuur. De schuur heeft een rieten dak."@nl;
  skos:altLabel "Wieringer boerderij"@nl, "skuurskotboerderij"@nl, "skuurskotboerderijen"@nl;
