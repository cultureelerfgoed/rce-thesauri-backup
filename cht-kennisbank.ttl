<https://data.cultureelerfgoed.nl/term/id/cht/75de4f63-4a39-4a5a-9262-6569a611525c>
  a skos:Concept;
  skos:prefLabel "Pinkstergemeente Filadelfia"@nl;
  skos:scopeNote "Pinkstergemeente Filadelfia is een pinkstergemeente die bekend staat om haar focus op de gaven van de Heilige Geest, charismatische aanbidding, en evangelisatie. De gemeente heeft een sterke betrokkenheid bij de lokale gemeenschap en bijbelgetrouwheid."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1270db19-bfd0-4b46-abc2-6f44fe8c7f4c>;
