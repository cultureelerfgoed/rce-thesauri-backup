<https://data.cultureelerfgoed.nl/term/id/cht/86655ac0-cc1f-4f4e-a9b0-65fed2e9cf03>
  a skos:Concept;
  skos:prefLabel "ansjovisvletten"@nl;
  skos:scopeNote "Visvlet, die men bij de ansjovisvisserij gebruikte. (De Binnenvaart)"@nl;
  skos:altLabel "ansjovisvlet"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f8ff5f24-df2d-4790-bb6e-b9480a45b23f>;
