<https://data.cultureelerfgoed.nl/term/id/cht/d2e45bfa-6989-4171-889b-5e6f658196c5>
  a skos:Concept;
  skos:prefLabel "pivot frames"@nl;
  skos:scopeNote "Een Pivot frame is een motorfiets-frame waarbij de aluminium kokerbalken aan de achterkant overgaan in een gegoten box-sectie. De achtervork scharniert in deze box sectie."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/17a278a7-16f4-4065-bef6-8ce5f22026e8>;
