<https://data.cultureelerfgoed.nl/term/id/cht/e6903d1f-cade-424e-bb52-65b76d888927>
  a skos:Concept;
  skos:prefLabel "hekwerken"@nl;
  skos:scopeNote "Hekwerken zijn omheiningen van een tuin, park of terrein en bestaan uit een samenstel van spijlen en regels, staven of tralies, bevestigd tussen soortgelijke stijlen. Een hek kan zijn gemaakt van hout of metaal. Hekwerken kunnen bedoeld zijn om mensen buiten, of dieren binnen te houden. De vormgeving varieert van functioneel tot sierlijk en is aangepast op de tuinarchitectuur. (Haslinghuis)"@nl;
  skos:altLabel "hekwerk"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4e481c81-319a-44da-86bf-106f145d22c1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8a25cca7-a562-4d44-8519-a40db5ef8423>
  a skos:Concept;
  skos:prefLabel "achtkantstijl"@nl;
  skos:scopeNote "Eén van de acht stijlen in een achtkante molen."@nl;
  skos:altLabel "achtkantstijlen"@nl, "kantstijl"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/04770e4f-1c11-40e7-a256-9de8c6d569c6>;
