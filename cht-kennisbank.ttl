<https://data.cultureelerfgoed.nl/term/id/cht/2fe8a764-f906-4ee4-8948-5db3a0a638a1>
  a skos:Concept;
  skos:prefLabel "pineta"@nl;
  skos:scopeNote "Een pinetum is een collectietuin met levende naaldbomen in zoveel mogelijk soorten en groeivormen. Pineta werden aangelegd voor het plezier maar ook uit wetenschappelijk of landbouweconomisch oogpunt. De vormgeving loopt dan ook uiteen van functioneel tot parkachtig. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "pinetum"@nl, "pinetums"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/43243bc0-662e-4c4c-a559-3156601ffc69>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

