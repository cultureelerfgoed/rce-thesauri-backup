  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6a4d52d3-6765-4bdb-acdd-645a209434b1>
  a skos:Concept;
  skos:prefLabel "mural"@nl;
  skos:scopeNote "Een grootschalig kunstwerk geschilderd of direct op een muur of oppervlak aangebracht, vaak met een bepaalde beeltenis, boodschap of abstract ontwerp."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e5deb0ac-8b97-4a01-8367-65f9a35d6550>
  a skos:Concept;
  skos:prefLabel "stencil art"@nl;
  skos:scopeNote "Een techniek waarbij een afbeelding of ontwerp wordt gemaakt door een sjabloon uit te snijden en op een oppervlak aan te brengen voordat er wordt geschilderd."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/27910cf7-9aa5-426c-90a6-748de6517b15>
  a skos:Concept;
  skos:prefLabel "paste-up"@nl;
  skos:scopeNote "Kunstwerken gemaakt op papier of ander materiaal en op een oppervlak geplakt met behulp van een mengsel gemaakt van bloem en water of een vergelijkbare soort lijm."@nl;
  skos:altLabel "wheatpaste"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b3544cac-b4fe-4abb-a3d4-8416e0707dc8>
  a skos:Concept;
  skos:prefLabel "sticker art"@nl;
  skos:scopeNote "Kleine stickers met ontwerpen, boodschappen of afbeeldingen die op oppervlakken in openbare ruimtes worden aangebracht."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ca99820f-fec8-46b1-a1ca-19a7d0efbc13>
  a skos:Concept;
  skos:prefLabel "installation"@nl;
  skos:scopeNote "Driedimensionale kunstwerken of sculpturen gemaakt of geïnstalleerd in openbare ruimtes, meestal bedoeld om interactie aan te gaan met de omgeving of gedachten op te roepen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/27c9eeaf-e570-49a3-be23-17dd948d76d2>
  a skos:Concept;
  skos:prefLabel "yarn bombing"@nl;
  skos:scopeNote "Een vorm van straatkunst waarbij touw of garen worden gebruikt om kleurrijke displays te maken die openbare objecten zoals bomen, lantaarnpalen of bankjes bedekken."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/44dbb73d-c21f-45bb-a1a3-1281c0fddce2>
  a skos:Concept;
  skos:prefLabel "guerrilla gardening"@nl;
  skos:scopeNote "Tuinieren in verwaarloosde of verlaten delen van de stad, vaak met de intentie om te verfraaien of enige openbare ruimte terug te winnen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/42b4dff5-d55c-4cf6-a8ee-5d0a993acb5f>
  a skos:Concept;
  skos:prefLabel "intervention"@nl;
  skos:scopeNote "Kunstzinnige interventies waarbij bestaande elementen in de stedelijke omgeving – zoals borden, advertenties of architectonische kenmerken – worden veranderd of toegevoegd om een nieuwe betekenis of boodschap te creëren."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ffe1fe61-8d1c-497a-b1e2-a0ee9662e0d6>
  a skos:Concept;
  skos:prefLabel "street installations"@nl;
  skos:scopeNote "Tijdelijke of semi-permanente kunstwerken geïnstalleerd in openbare ruimtes, inclusief sculpturen, lichtinstallaties of interactieve werken."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d2ab9568-a1a5-4b70-8bb7-043bfbdf75a2>
  a skos:Concept;
  skos:prefLabel "stencil graffiti"@nl;
  skos:scopeNote "Vergelijkbaar met stencilkunst, maar meer geassocieerd met politieke of sociale boodschappen en illegaal aangebracht in openbare ruimtes."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/160c9fbb-284e-4f05-965e-615b833be8c9>
  a skos:Concept;
  skos:prefLabel "environmental art"@nl;
  skos:scopeNote "Kunstwerken die in contact staan met hun natuurlijke omgeving, veelal gemaakt met natuurlijke materialen, geïntegreerd in het landschap of de stedelijke omgeving."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/019efacc-109b-4ea3-82b4-8dcb12132771>
  a skos:Concept;
  skos:prefLabel "3d style"@nl;
  skos:scopeNote "Effect dat wordt gebruikt bij letters om de illusie van een derde dimensie te creëren. De eerste kunstenaar die begon met het verfraaien van letters op deze manier is Phase 2. Binnen de Graffiti-cultuur verwijst '3D' naar de tekst, maar er is ook een andere versie van 3D-schilderen op trottoirs met stoepkrijt. Graffiti en krijtkunst verschillen echter qua concept en esthetiek en mogen niet worden verward."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a973db48-2a98-465d-b910-74f9d970c4ce>
  a skos:Concept;
  skos:prefLabel "abstract style"@nl;
  skos:scopeNote "Tekst hoort over het algemeen niet bij de abstract style, maar gaat over de schilderkunstige vaardigheid en harmonie die een kunstenaar demonstreert. Het idee is vergelijkbaar met abstract schilderen – om een harmonieus werk te creëren met een specifieke dynamiek en balans door het gebruik van basale artistieke elementen – lijn, vorm, geometrie, kleur en compositie."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f21a9a1e-cc49-411e-8e6b-20cf33f25d85>
  a skos:Concept;
  skos:prefLabel "anti-style"@nl;
  skos:scopeNote "Ook wel bekend als ghetto style of ignorant style. Een opzettelijk onervaren of (ogenschijnlijk) ongeschoolde stijl van schrijven en schilderen. Het komt voort uit de Graffiti cultuur van de jaren 70 in New York, maar het verspreidde zich en werd ook populair in de jaren 80 en begin jaren 90 in San Francisco. Anti-style volgt geen regels, zeer afhankelijk van het individu en vaak visueel ongemakkelijk. We kunnen voorbeelden van deze schilderkunst zien in San Francisco, New York, Parijs, Berlijn en andere grotere steden in Europa."@nl;
  skos:altLabel "ugly style"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6f8d6468-9f0f-49c9-82a2-59037a657a9a>
  a skos:Concept;
  skos:prefLabel "backjump"@nl;
  skos:scopeNote "Een throw-up of een panel piece dat snel wordt uitgevoerd, vaak op een geparkeerde trein of bus."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/08053ca2-83d8-437a-b363-eb73a6a0c9c4>
  a skos:Concept;
  skos:prefLabel "blockbuster style"@nl;
  skos:scopeNote "Blockbuster of 'rechte' tekst is groot, vierkant, robuust en eenvoudig. Beter leesbaar dan de meeste Graffiti en wordt meestal geschilderd in twee kleuren, in combinaties van effen zwart, wit en zilver. Vaak gebruikt om over een ander werk of op de zijkanten van een trein te spuiten, aangezien blockbusters goed zijn om iets volledig te bedekken."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8982e50c-1e36-407a-bf09-7447231834de>
  a skos:Concept;
  skos:prefLabel "bombing"@nl;
  skos:scopeNote "Het schilderen van meerdere muren in één gebied of een trein in een kort tijdsbestek (ook wel: to hit). Bombers zijn geneigd eenvoudigere stijlen, tags of throw-ups te gebruiken, aangezien snelheid zo'n belangrijke factor is. Het kan ook betekenen: iets beschilderen tijdens het weggaan."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fbfd1110-4877-4253-ba3a-14ee7502595c>
  a skos:Concept;
  skos:prefLabel "bubble style"@nl;
  skos:scopeNote "Een wat verouderde stijl van eenvoudige, afgeronde, bubbelvormige letters, die over het algemeen goed te lezen zijn. Throw-ups worden vaak in deze stijl geschilderd, omdat het makkelijk en snel uit te voeren is."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6d50672b-9021-4523-af2c-870fc1cf974f>
  a skos:Concept;
  skos:prefLabel "cartoon"@nl;
  skos:scopeNote "Een cartoon of personage bekend door een strip, popcultuur of tv. Kunstenaars die strips maken, bedenken meestal hun eigen personages en beeldtaal. 'StripGraffiti' voegt humor toe aan een werk en is simpel aan te passen aan de meeste letterstijlen."@nl;
  skos:altLabel "character"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d6ead8d7-a4c5-4b01-932f-ff96ce9928a3>
  a skos:Concept;
  skos:prefLabel "challenge"@nl;
  skos:scopeNote "Challenge Graffiti is gemaakt om aan te geven dat iemand 'er was'. Net zoals insides wordt het vaak binnenshuis geschilderd. Insides zijn een specifieke verwijzing naar tags die in het openbaar vervoer worden geschreven – treinen, bussen etc."@nl;
  skos:altLabel "insides"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/13686bf1-7fb4-48e3-a193-004a43c10457>
  a skos:Concept;
  skos:prefLabel "complex style"@nl;
  skos:scopeNote "Een algemene term voor Graffiti met ingewikkelde letters, een overvloed aan kleur en die lastig uit te voeren is. De werken zijn soms moeilijk te lezen, maar visueel indrukwekkend."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/1dd47526-9caa-4119-83f9-dc79fbe0dc26>
  a skos:Concept;
  skos:prefLabel "computer style"@nl;
  skos:scopeNote "Een bepaald type wildstyle dat er digitaal of 'gebitmapped' uitziet, alsof het uit een computer komt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ab8b306a-5f21-46a1-af4b-10b676eec158>
  a skos:Concept;
  skos:prefLabel "dubs (uk)"@nl;
  skos:scopeNote "Graffiti uitgevoerd in zilver of chroom, afkomstig uit Londen. Ze zijn te vinden rond treinstations of op straat en worden meestal door een groep gemaakt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/5b7feac7-dd1c-4d80-a4b3-c00ee4bd1208>
  a skos:Concept;
  skos:prefLabel "free style"@nl;
  skos:scopeNote "Freestyle Graffiti is een stijl waarbij de kunstenaar creëert zonder een vooraf gepland ontwerp of schets, waardoor hij/zij kan improviseren tijdens het maken. In plaats van elk detail zorgvuldig te plannen, laat de kunstenaar in het moment door zijn creativeit leiden, wat resulteert in spontane en vloeiende composities. Deze benadering vertrouwt op de instincten en vaardigheden van de kunstenaar om unieke en dynamische stukken te creëren. Freestyle Graffiti kan een breed scala aan technieken en stijlen omvatten, van gedurfde belettering tot abstracte vormen, en wordt gewaardeerd om zijn spontaniteit en rauwe energie. Het houdt in dat je schildert zonder voorafgaande voorbereiding of schetsen, het beeld ter plaatse op te bouwen zonder te vertrouwen op gememoriseerde stijlen of vooraf ontworpen contouren."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/396940e2-deb2-4d24-abca-234f101e1e5a>
  a skos:Concept;
  skos:prefLabel "full monty"@nl;
  skos:scopeNote "Een werk dat een heel gebied, muur of object bedekt. Het kan een grove, maar zeer effectieve boodschap uitdragen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e6680eba-2af7-423a-977b-3e3e25a1c37e>
  a skos:Concept;
  skos:prefLabel "mop"@nl;
  skos:scopeNote "Een zelfgemaakt schildersgereedschap, veelal gebruikt om grotere tags te schilderen. Het heeft een ronde punt en laat een dikke lijn achter die druipt. Mops kunnen met verschillende kleuren worden gebruikt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8575c008-566f-4862-af02-9f1025bd16d9>
  a skos:Concept;
  skos:prefLabel "mural"@nl;
  skos:scopeNote "Een muurschildering buiten of binnen (of op een plafond). In straatkunst verwijst het naar een grote, uitgebreide muurschildering die aanzienlijke vaardigheid vereist om te schilderen. In tegenstelling tot Graffiti respecteren muurschilderingen normaal gesproken de architectuur van de muur, het gebouw en soms zelfs de omgeving. Vaak zijn ze legaal."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d6d4019d-0c94-4d3f-94a4-24eec1ab9a15>
  a skos:Concept;
  skos:prefLabel "old school"@nl;
  skos:scopeNote "Een algemene term die verwijst naar de tijden van vroege Graffiti, in de jaren 70 en begin jaren 80. Het kan ook betrekking hebben op hiphop uit die periode. Old-school Graffiti-kunstenaars genieten veel respect omdat ze er vanaf het begin bij waren en velen van hen hebben specifieke schrijfstijlen uitgevonden. Zo creëerde Phase 2 bubbels, wolken en 3D, en begonnen Blade en Comet als eersten met het gebruiken van blockbusters."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/76e08b63-84b8-4d39-8685-ce7cc5a35a5a>
  a skos:Concept;
  skos:prefLabel "own style"@nl;
  skos:scopeNote "Een stijl die kenmerkend is voor één specifieke kunstenaar."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/00d45463-bfff-4f69-8663-5d6b144c68fe>
  a skos:Concept;
  skos:prefLabel "piece"@nl;
  skos:scopeNote "Afkorting van masterpiece, geschilderd met de vrije hand. Een grote, complexe muurschildering die tijdrovend en moeilijk uit te voeren is. Het wordt gekenmerkt door veel verschillende componenten, zoals een rijk palet, 3D-elementen en andere visuele kenmerken. Het werk van een meer ervaren artiest, dat vaak extra respect oplevert."@nl;
  skos:altLabel "free-hand"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/35096d55-48d5-4147-86b0-be1edc6e4f68>
  a skos:Concept;
  skos:prefLabel "public style"@nl;
  skos:scopeNote "Graffiti die makkelijk leesbaar is voor het publiek."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/0751b475-92f1-4d13-b5db-53dc80d3cad7>
  a skos:Concept;
  skos:prefLabel "punition"@nl;
  skos:scopeNote "Een soort Graffiti waarin één woord talloze keren wordt herhaald, totdat het een heel oppervlak bedekt. De naam komt van de strafregels die werden gebruikt om kinderen op school te straffen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/508f3be3-232e-4782-9af3-d108d10a6c35>
  a skos:Concept;
  skos:prefLabel "roller graffiti"@nl;
  skos:scopeNote "Graffiti geschilderd met een roller en verf in plaats van met een spuitbus. Er zijn speciale technieken gerelateerd aan deze manier van schilderen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/7166771c-9abc-4db4-851d-99db0c35e442>
  a skos:Concept;
  skos:prefLabel "semi-wildstyle"@nl;
  skos:scopeNote "Een eenvoudiger type 'wildstyle', beter leesbaar dan de complete vorm. Een minder complexe stijl van wildstyle. Moeilijker te lezen dan eenvoudige stijl, maar niet zo complex als wildstyle Graffiti. Wildstyle Graffiti heeft veel effecten, stijlelementen, en is op een complexe manier gerangschikt, waardoor het echt moeilijk te lezen is. De semi-wildstyle gebruikt enkele van deze elementen, maar niet dusdanig dat de Graffiti niet meer leesbaar is."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f2e01977-b6ad-4ff1-8cdf-260d937e0064>
  a skos:Concept;
  skos:prefLabel "sharp"@nl;
  skos:scopeNote "Een manier van schrijven met geometrische, hoekige letters en veel scherpe hoeken en punten, waarbij de puntige en priemende elementen tot het uiterste worden gedreven. Letters worden sterk veranderd, vaak onherkenbaar, waardoor ze een felle en woeste indruk geven."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3d2e1b8b-d0e5-43e6-baf7-9e771ae2a11c>
  a skos:Concept;
  skos:prefLabel "silver style"@nl;
  skos:scopeNote "Zoals de naam al doet vermoeden: Graffitiletters enkel geschilderd in zilver. Schaduwen en contouren zijn meestal in zwart geschilderd. De zilveren kleur maakt het mogelijk om op gestructureerde oppervlakken te beschilderen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fa2669d0-039a-4d03-b3ce-0c15f6c437f8>
  a skos:Concept;
  skos:prefLabel "simple style"@nl;
  skos:scopeNote "De letters van simple style zijn gemakkelijk te lezen en niet op een ingewikkelde manier gerangschikt. De opvullingen bestaan meestal uit 1 tot 3 kleuren. Er worden hierbij weinig stijlelementen gebruikt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/1ba39c46-a884-4a65-bc01-7e75d8421b50>
  a skos:Concept;
  skos:prefLabel "subway-style graffiti"@nl;
  skos:scopeNote "Ontstaan in Philadelphia en New York in de jaren 70 en vroege jaren 80, waarbij veelal vaardig en met de vrije hand op treinen of in metrostations wordt gespoten. Ook bekend als hip-hop-stijl Graffiti."@nl;
  skos:altLabel "hip-hop-stijl graffiti"@nl, "graff"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/bbe4a004-9e1a-4da2-a287-6d8ce463410f>
  a skos:Concept;
  skos:prefLabel "tag"@nl;
  skos:scopeNote "De handtekening van een kunstenaar, zeer gestileerd, snel geschreven en vaak in één kleur die contrasteert met de achtergrond. De eenvoudigste en meest voorkomende vorm van Graffiti. Ook gebruikt als werkwoord: taggen betekent 'ondertekenen', afgeleid van de klassieke traditie van kunstenaars die hun werken signeren."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/71aeb6a8-e5d6-4dc6-9e87-27208d3872e3>
  a skos:Concept;
  skos:prefLabel "tagging"@nl;
  skos:scopeNote "Taggen. Een geaccepteerde term in de huidige popcultuur, vaak met een andere betekenis dan Graffiti zelf. Sinds het voor het eerst verscheen in Philadelphia in de vorm van berichten die Bobby Beck rond de snelwegen van de stad achterliet, is taggen op veel manieren geëvolueerd. Andere manieren van taggen kunnen worden gevonden in verschillende steden, afhankelijk van de regio en lokale cultuur, en natuurlijk de kunstenaar zelf. TAKI 183, in New York in de vroege jaren 70, wordt beschouwd als een van de grondleggers van Graffiti en taggen in het algemeen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/91bc3de1-bf53-4009-afa3-ebf5e8db0c09>
  a skos:Concept;
  skos:prefLabel "throw-up"@nl;
  skos:scopeNote "Ook wel throwie genoemd – een eenvoudige vorm van Graffiti, tussen een tag en bomb in. Het wordt meestal geschilderd met een eenvoudige letteromtrek en vervolgens ingevuld met kleur. Holle throw-ups worden hollows genoemd, terwijl geschilderde bekend staan als fill-ins. Throw-ups worden vaak gemaakt in een bubbel- of blockbusterstijl die passen bij een snelle uitvoering. Kunstenaars zouden throw-ups en tags gebruiken om zoveel mogelijk oppervlakken te bedekken, concurrerend met hun rivalen. Deze Graffitiwerken zijn stilistisch gedefinieerd en herkenbaar, in tegenstelling tot werken die vrijer en schilderachtiger zijn. Samen met de tag is een throw-up het logo van een kunstenaar."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/656134a4-0abd-4748-b3e7-8b7a6f2a7781>
  a skos:Concept;
  skos:prefLabel "wildstyle"@nl;
  skos:scopeNote "Complexe en gestileerde vorm van tekst die vaak onmogelijk te lezen is voor niet-kunstenaars. De letters kunnen zo ingewikkeld worden, haast abstract, met 3D-elementen, veel verbindingen, pijlen en in elkaar grijpende elementen. Over het algemeen wordt wildstyle gezien als een van de meest veeleisende stijlen, gereserveerd voor kunstenaars met serieuze vaardigheden."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb2a0671-29fa-46e3-b78c-8fac78acd032>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/cb15c46f-3c78-4c00-9884-0489130b1ac1>
  a skos:Concept;
  skos:prefLabel "zand"@nl;
  skos:scopeNote "Zand is zacht, hard, los en korrelig materiaal en een van de meest voorkomende natuurlijke stoffen op aarde. Zand bestaat uit zeer kleine stukjes steen, zandkorrels, die in grootte variëren tussen 63 micrometer en 2 millimeter. Als de korrels kleiner dan 63 micrometer zijn heet de grondsoort silt; bij korrels groter dan 2 millimeter spreekt men van grind."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a84ab8b6-24c6-493d-939d-102bb982bd91>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/edfbeadf-9c1e-4123-a8be-f02900be5ee2>
  a skos:Concept;
  skos:prefLabel "associatie"@nl;
  skos:scopeNote "Verbinding die in het denken wordt gelegd tussen verschillende indrukken, ideeën of betekenissen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9666ad45-7ff1-478a-8a52-0a5840b2c546>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3a94fea7-e2a7-48b0-a8fa-5d7276213e5e>
  a skos:Concept;
  skos:prefLabel "teken"@nl;
  skos:scopeNote "Iets dat verwijst naar, staat voor of betekenis geeft aan iets anders."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9666ad45-7ff1-478a-8a52-0a5840b2c546>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2cd79d86-b9c3-412e-a650-7bd53d8656de>
  a skos:Concept;
  skos:prefLabel "brandblusinstallaties"@nl;
  skos:scopeNote "Een brandblusinstallatie wordt toegepast voor het aansturen van een brandblussysteem, en heeft tot doel een beginnende brand te blussen of een brand onder controle te houden, zodat de omvang beperkt wordt."@nl;
  skos:altLabel "brandblusinstallatie"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a8109416-1859-4535-a428-06e76ca45321>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/16a889e6-fbe6-4d28-a892-830689e1f217>
  a skos:Concept;
  skos:prefLabel "Sefardisch jodendom"@nl;
  skos:scopeNote "Religieuze en culturele traditie binnen het jodendom die is verbonden met Sefardische Joodse gemeenschappen. Omvat onder meer eigen liturgische gebruiken, gebedstradities, religieuze rechtsopvattingen en gemeenschapsgebruiken."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b425528a-1808-49d8-bc07-7c0b49d8de19>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/bece25a6-eb64-46e8-85a8-2a7991f02a2c>
