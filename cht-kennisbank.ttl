  a skos:Concept;
  skos:prefLabel "visstropers"@nl;
  skos:scopeNote "Visstropers zijn personen die zonder de benodigde vergunningen en meestal met verboden vistuig, op grote schaal vis vangen. Visstropers kunnen ook personen zijn die vis uit andersmans vistuig halen of in andermans viswater vissen. (www.debinnenvaart.nl)"@nl;
  skos:altLabel "schuimvisser"@nl, "schuimvissers"@nl, "visstroper"@nl;
