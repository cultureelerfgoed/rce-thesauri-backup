<https://data.cultureelerfgoed.nl/term/id/cht/9230258f-cafc-42a5-9d1d-701322cd93e6>
  a skos:Concept;
  skos:prefLabel "zaagbokken (gereedschap)"@nl;
  skos:scopeNote "Een zaagbok is een houten staketsel waarop een te zagen boomstam kan worden gelegd. Vrijwel steeds worden twee zaagbokken gebruikt. Er zijn exemplaren die op hoogte gesteld kunnen worden door een lat op pennen te leggen, die in gaten in de stijlen passen."@nl;
  skos:altLabel "zaagbok (gereedschap)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/95b325fc-695e-42fd-a217-08211e255ddb>
  a skos:Concept;
  skos:prefLabel "steenklopboren"@nl;
  skos:scopeNote "Aan het ondereind staan tanden in een cirkel rond een uitholling. De steel is rond."@nl;
  skos:altLabel "steenklopboor"@nl;
