  a skos:Concept;
  skos:prefLabel "sonar"@nl;
  skos:scopeNote "Een methode voor het opsporen van voorwerpen onder water door het registreren van de sonische en ultrasonische golven die door het voorwerp worden teruggekaatst. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/47e05121-f2b9-4020-a461-97319b89bf5e>;
