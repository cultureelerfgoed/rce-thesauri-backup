  a skos:Concept;
  skos:prefLabel "clavis"@nl;
  skos:scopeNote "Verticale sierboorden op een dalmatiek, lopend van zoom naar zoom over elke schouder. Van overeenkomstig materiaal is op borsthoogte een horizontaal verbindingsstuk aangebracht. Komt voort uit de banden op een Romeinse tunica, die de status van de drager aangaven."@nl;
  skos:altLabel "clavi"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5dec9aa2-5ced-4f77-b929-c043b90b2a8f>;
