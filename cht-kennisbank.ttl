<https://data.cultureelerfgoed.nl/term/id/cht/e7742789-f243-4cd6-b2c8-53f14f7630a9>
  a skos:Concept;
  skos:prefLabel "aankleuring"@nl;
  skos:scopeNote "Histologische aankleuring kan worden toegepast op een verfdwarsdoorsnede om bepaalde bestanddelen aan te kleuren."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2586723b-dd68-4b53-b7fe-715bde062395>;
