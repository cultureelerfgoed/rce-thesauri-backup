<https://data.cultureelerfgoed.nl/term/id/cht/ad9f4796-9f92-424a-b826-d8c347bd27a6>
  a skos:Concept;
  skos:prefLabel "vloeipalen"@nl;
  skos:scopeNote "Elk van de stevige palen tegen en voor kaaimuren langs buitenhavens enz. die met de kop een eind boven de muur uitsteken. (MARDOC)"@nl;
  skos:altLabel "vloeipaal"@nl;
