<https://data.cultureelerfgoed.nl/term/id/cht/6f3b6c53-14e4-4372-b808-65425547ad93>
  a skos:Concept;
  skos:prefLabel "veerbladen"@nl;
  skos:scopeNote "Een enkel blad van een bladveer."@nl;
