<https://data.cultureelerfgoed.nl/term/id/cht/8516edfa-c827-462e-8b0a-636b1250b6bc>
  a skos:Concept;
  skos:prefLabel "diepe borden"@nl;
  skos:scopeNote "Borden die wijd, rond en open zijn en een platte bodem hebben. Ze hebben een rechte of holronde zijkant en zijn dieper dan gewone borden, maar minder diep dan kommen. (AAT)"@nl;
  skos:altLabel "diep bord"@nl;
