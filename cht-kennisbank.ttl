  a skos:Concept;
  skos:prefLabel "Tabriz-tapijten"@nl;
  skos:scopeNote "Tabriz-tapijten zijn perzische tapijten die in de stad Tabriz in Iran worden gemaakt. Ze zijn bekend om hun gedetailleerde florale patronen, rijke kleuren en vaak een grote knoopdichtheid, waardoor ze bijzonder waardevol zijn."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c3f9ef98-ae46-42e6-af2a-29a0f0b9fb84>;
