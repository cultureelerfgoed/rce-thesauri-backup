  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a2f3c5a2-4cb2-452d-96ac-ee97c410c813>
  a skos:Concept;
  skos:prefLabel "Afschaffing van slavernij & emancipatie van (voormalige) slaven"@nl;
  skos:scopeNote "Alles wat verband houdt met afschaffing van de slavernij, emancipatiebewegingen, racisme en herdenkingen."@nl;
