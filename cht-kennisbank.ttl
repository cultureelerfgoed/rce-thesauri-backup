<https://data.cultureelerfgoed.nl/term/id/cht/ee59c501-e07d-4dd7-9320-c2fda2c44fed>
  a skos:Concept;
  skos:prefLabel "sanctuskandelaars"@nl;
  skos:scopeNote "Kandelaar voor de sanctuskaars die volgens het Tridentijnse Romeinse missaal gedurende het Sanctus tot en met de communie van de priester moet branden. Dit voorschrift werd echter veelal niet nagevolgd."@nl;
  skos:altLabel "sanctuskandelaar"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c54d75d4-df7d-4114-b50d-f0270df8a38a>;
