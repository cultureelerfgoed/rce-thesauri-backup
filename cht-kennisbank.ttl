  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/74092fa4-c606-47a8-9605-9efe4cf1cca1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/443fc4c8-ed82-4668-ae47-1e529ff413e1>
  a skos:Concept;
  skos:prefLabel "watertorens"@nl;
  skos:scopeNote "De watertoren is een toren waarin men gezuiverd water oppompt, zodat voldoende druk op het waterleidingnet komt te staan. (Thesaurus landschap)"@nl,
    "Watertorens zijn torens met een hooggelegen waterreservoir waarin gezuiverd water wordt opgepompt zodat het onder druk naar de gebruikers kan stromen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "watertoren"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/28405b4d-719e-468b-98b4-1e0aa2e0e2c9>;
