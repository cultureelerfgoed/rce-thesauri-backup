<https://data.cultureelerfgoed.nl/term/id/cht/5d70869c-c967-4ea1-8028-1466a8760b45>
  a skos:Concept;
  skos:prefLabel "zolderbalken"@nl;
  skos:scopeNote "Een zolderbalk is een draagbalk waarop de zolder rust. Zolderbalken maken deel uit van een zoldering en in het geval van een balkenzoldering zijn ze in het zicht gelaten. (Encyclo.nl)"@nl;
  skos:altLabel "zolderbalk"@nl, "zolderbint"@nl, "zolderbinten"@nl;
