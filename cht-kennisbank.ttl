  a skos:Concept;
  skos:prefLabel "broederschapsmedailles"@nl;
  skos:scopeNote "Medaille met kenmerken en naam van een broederschap. Kan aan een lint, ornament of ketting hangen. Wordt gedragen door de bestuursleden. RT devotiemedaille"@nl;
  skos:altLabel "broederschapsmedaille"@nl;
