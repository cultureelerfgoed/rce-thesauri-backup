<https://data.cultureelerfgoed.nl/term/id/cht/3912e183-b423-4629-8580-f343006e47f7>
  a skos:Concept;
  skos:prefLabel "admiraalsstaven"@nl;
  skos:scopeNote "Admiraalsstaven zijn ceremoniële staven die door admiraals worden gedragen of getoond als symbool van hun rang en autoriteit binnen de marine. Ze worden vaak rijkelijk versierd en zijn historische objecten van militaire traditie."@nl;
  skos:altLabel "admiraalsstaf"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/49a3cf5a-1dda-414f-98ca-49f879289d13>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/cef20f2c-8244-4142-9c93-72dbad001517>
  a skos:Concept;
  skos:prefLabel "advertentiekranten"@nl;
  skos:scopeNote "Advertentiekranten zijn publicaties die voornamelijk bestaan uit advertenties, vaak gericht op lokale gemeenschappen. Ze bieden bedrijven en individuen een platform om goederen en diensten aan te bieden."@nl;
  skos:altLabel "advertentiekrant"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0d906d76-3ec8-4e84-84f4-1171bb81fae9>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/834000dd-2439-4031-aa70-9e118c4e581a>
  a skos:Concept;
  skos:prefLabel "advertentietijdschriften"@nl;
  skos:scopeNote "Advertentietijdschriften zijn periodieken die voornamelijk advertenties bevatten, meestal gericht op specifieke doelgroepen of thema's. Ze dienen als een platform voor commerciële boodschappen en productpromotie."@nl;
  skos:altLabel "advertentietijdschrift"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0d906d76-3ec8-4e84-84f4-1171bb81fae9>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/0d63a910-2105-40f6-8d80-efef6de8b1e9>
  a skos:Concept;
  skos:prefLabel "albus"@nl;
  skos:scopeNote "Een albus is een historische zilveren munt, voornamelijk gebruikt in de middeleeuwse Duitse gebieden."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/306df5ea-fa8e-4352-bb98-55b82d1445dd>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/df42d07d-f5ef-4322-a3c2-7b665c5ee0ba>
  a skos:Concept;
  skos:prefLabel "alsengemmen"@nl;
  skos:scopeNote "Alsengemmen zijn kleine, gegraveerde edelstenen die traditioneel werden gebruikt als zegel of decoratie. Ze zijn genoemd naar het eiland Als en zijn vaak voorzien van mythologische of religieuze afbeeldingen."@nl;
  skos:altLabel "alsengemme"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a9bfab12-efb9-480d-a2fa-f46f4f0e64f8>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/1e293089-2d41-43e4-9c27-540950a91fce>
  a skos:Concept;
  skos:prefLabel "ambtsringen"@nl;
  skos:scopeNote "Ambtsringen zijn symbolische ringen gedragen door personen in officiële functies, zoals geestelijken of bestuurders. Ze vertegenwoordigen autoriteit en verantwoordelijkheid en zijn vaak met inscripties of symbolen versierd."@nl;
  skos:altLabel "ambtsring"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fdf9d35f-b8d1-4a54-808b-766ac8cf1fc0>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6673347f-9776-46f4-bfe7-668ff7b1c188>
  a skos:Concept;
  skos:prefLabel "anatomische atlassen"@nl;
  skos:scopeNote "Anatomische atlassen zijn gedetailleerde boeken met illustraties van het menselijk lichaam, bedoeld voor onderwijs in geneeskunde en biologie."@nl;
  skos:altLabel "anatomische atlas"@nl, "anatomie-atlassen"@nl, "anatomie-atlas"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7860ea36-d3f4-462f-8eca-ca9954d83b42>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/bb413bf1-068b-42ca-8e17-bf0ca1be516f>
  a skos:Concept;
  skos:prefLabel "astronomische atlassen"@nl;
  skos:scopeNote "Astronomische atlassen zijn gedetailleerde kaarten van sterren, planeten en andere hemellichamen. Ze worden gebruikt voor navigatie, onderzoek en onderwijs in de astronomie."@nl;
  skos:altLabel "astronomische atlas"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7860ea36-d3f4-462f-8eca-ca9954d83b42>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/020f5976-06cf-46c2-b671-1b95fd523514>
  a skos:Concept;
  skos:prefLabel "assurantievlaggen"@nl;
  skos:scopeNote "Assurantievlaggen zijn vlaggen die gebruikt werden door verzekeringsmaatschappijen om aan te geven dat een schip verzekerd was. Ze speelden een belangrijke rol in de maritieme verzekering en scheepvaartveiligheid."@nl;
  skos:altLabel "assurantievlag"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/053ec816-8dc9-46ea-b3e4-ee9ab8e89b6d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c0ec7f7e-6d1c-4831-87f1-02bd0b69b6ef>
  a skos:Concept;
  skos:prefLabel "audiovisuele media"@nl;
  skos:scopeNote "Audiovisuele media omvatten alle vormen van communicatie die zowel geluid als beeld gebruiken, zoals films, televisie, en digitale video's."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91712616-6dec-4871-8fdc-c317850c20d1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d8dbbdf1-1dd2-4318-afcc-69d91f87bb64>
  a skos:Concept;
  skos:prefLabel "avondmaalsserviezen"@nl;
  skos:scopeNote "Avondmaalsserviezen zijn sets van vaatwerk, zoals kelken en borden, die worden gebruikt tijdens de christelijke eucharistie. Ze zijn vaak rijk versierd en symboliseren de heiligheid van de rituele maaltijd."@nl;
  skos:altLabel "avondmaalsservies"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ddae2b9d-6d8b-4e5e-ba1b-7f5a8df3a5e5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/46ffd619-2ca2-433c-b2a8-acd1d3a8bd6c>
  a skos:Concept;
  skos:prefLabel "baklijsten"@nl;
  skos:scopeNote "Baklijsten zijn schilderijlijsten die een diepere rand hebben, waardoor het schilderij 'in' de lijst lijkt te liggen. Ze bieden bescherming en een esthetische omlijsting voor kunstwerken."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f9ad90dc-6fc8-454a-9010-278cc1b0349f>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/c39818d9-c619-4a3d-92de-4d7f46006313>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/97b53f1b-ff55-43f3-a24d-7c7cfefbee32>
  a skos:Concept;
  skos:prefLabel "bedelbalken"@nl;
  skos:scopeNote "Bedelbalken zijn houten balken of stokken waaraan bedeltjes of kleine voorwerpen worden opgehangen, vaak gebruikt als decoratief element in religieuze of culturele ceremonies."@nl;
  skos:altLabel "bedelbalk"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bbbb5751-b3b2-4490-85ad-51a73c7651ee>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/72abb2b2-ef03-4123-9ca7-6df35ac1f5b0>
  a skos:Concept;
  skos:prefLabel "begrafenispenningen"@nl;
  skos:scopeNote "Begrafenispenningen zijn herdenkingspenningen die worden uitgegeven ter gelegenheid van een begrafenis, vaak voorzien van inscripties of afbeeldingen die de overledene eren."@nl;
  skos:altLabel "begrafenispenning"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/949e4827-f900-45e5-8828-94e38419a466>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c39818d9-c619-4a3d-92de-4d7f46006313>
  a skos:Concept;
  skos:prefLabel "beknotte baklijsten"@nl;
  skos:scopeNote "Beknotte baklijsten zijn een variant van baklijsten waarbij de randen zijn verkort of aangepast, vaak om een specifiek visueel effect te bereiken of om aan te passen aan de afmetingen van het kunstwerk."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/46ffd619-2ca2-433c-b2a8-acd1d3a8bd6c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/adadc183-babd-4842-b7c4-bc1195b37159>
  a skos:Concept;
  skos:prefLabel "beloningsmedailles"@nl;
  skos:scopeNote "Beloningsmedailles zijn medailles die worden uitgereikt als erkenning voor een prestatie, dienst of bijdrage. Ze worden vaak gebruikt in sport, militaire, en academische contexten."@nl;
  skos:altLabel "beloningsmedaille"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/73c9e221-4d06-4ed9-b5bc-b84e0f7e7bc3>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b1d358dc-520e-4068-b5af-1488bd33d1c0>
  a skos:Concept;
  skos:prefLabel "beloningsplaatjes"@nl;
  skos:scopeNote "Beloningsplaatjes zijn kleine metalen plaatjes die worden uitgereikt als symbolische erkenning voor prestaties of diensten, vergelijkbaar met medailles maar vaak kleiner en eenvoudiger van ontwerp."@nl;
  skos:altLabel "beloningsplaatje"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91712616-6dec-4871-8fdc-c317850c20d1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3c66af9a-de5e-4281-a681-be0e743e7205>
  a skos:Concept;
  skos:prefLabel "benificiaalboeken"@nl;
  skos:scopeNote "Benificiaalboeken zijn registers of boeken waarin kerkelijke beneficies en de daarmee verbonden rechten en verplichtingen worden gedocumenteerd. Ze zijn belangrijk voor de studie van kerkelijke administratie en recht."@nl;
  skos:altLabel "benificiaalboek"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b2619bd2-0cdc-4fb1-9998-a69d9ab08421>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/67e6eabf-9e3a-4122-9fa2-2185d90271f3>
  a skos:Concept;
  skos:prefLabel "beschermingsprogrammas"@nl;
  skos:scopeNote "Een beschermingsprogramma is een plan of reeks maatregelen gericht op het behoud en de bescherming van cultureel erfgoed, zoals monumenten, kunstwerken of landschappen."@nl;
  skos:altLabel "beschermingsprogramma"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/51ce5a00-4e47-4176-88a5-43b51b40af79>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a34532d0-1fb9-4d82-8b86-8061256628c8>
  a skos:Concept;
  skos:prefLabel "besnijdenispenningen"@nl;
  skos:scopeNote "Besnijdenispenningen zijn herdenkingspenningen die worden uitgegeven ter ere van een joodse besnijdenisceremonie. Ze hebben vaak religieuze symbolen en inscripties en worden als waardevolle herinneringen bewaard."@nl;
  skos:altLabel "besnijdenispenning"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/949e4827-f900-45e5-8828-94e38419a466>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2030b86a-7149-47fc-841b-9c764347b9a6>
  a skos:Concept;
  skos:prefLabel "bijlbrieven"@nl;
  skos:scopeNote "Bijlbrieven zijn historische documenten waarin privileges, rechten of eigendommen worden bevestigd, vaak bezegeld met een bijl als symbool van autoriteit."@nl;
  skos:altLabel "bijlbrief"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/71f37ee9-1479-47d2-b5a0-ab5fa3417ed4>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/158b57b4-152a-46ba-bd8f-18aee94df512>
  a skos:Concept;
  skos:prefLabel "binnenlijsten"@nl;
  skos:scopeNote "Binnenlijsten zijn smalle lijsten die binnen een bredere lijst worden geplaatst, vaak gebruikt om een kunstwerk extra diepte en dimensie te geven. Ze dragen bij aan de esthetische presentatie van schilderijen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f6b4e26a-f95c-4539-8039-9ad242401217>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3d4237f4-4645-487b-8349-996420abce9e>
  a skos:Concept;
  skos:prefLabel "bioscoopkaartjes"@nl;
  skos:scopeNote "Bioscoopkaartjes zijn toegangskaartjes voor films in een bioscoop."@nl;
  skos:altLabel "bioscoopkaartje"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91712616-6dec-4871-8fdc-c317850c20d1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/9baadbdc-6471-466c-a29b-86621fb0d462>
  a skos:Concept;
  skos:prefLabel "archeologieprogramma"@nl;
  skos:scopeNote "Een archeologieprogramma is een plan of reeks projecten gericht op de opgraving, studie en conservering van archeologische vondsten."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/51ce5a00-4e47-4176-88a5-43b51b40af79>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/75762d3c-882e-460c-bbd8-45e023efd210>
  a skos:Concept;
  skos:prefLabel "bouwtekeningen-gebouwen"@nl;
  skos:scopeNote "Bouwtekeningen van gebouwen zijn technische schetsen en plannen die de constructie, indeling en details van een gebouw weergeven. Ze zijn essentieel voor architectuur en bouwkunde."@nl;
  skos:altLabel "bouwtekening-gebouw"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5a2c7fa7-93b8-457c-800b-897c09ab19f7>;
