<https://data.cultureelerfgoed.nl/term/id/cht/46d8f426-27e3-4f1a-8b93-e2d533cafc8d>
  a skos:Concept;
  skos:prefLabel "astrologie"@nl;
  skos:scopeNote "De studie die aanneemt dat er invloed van de sterren, maan en planeten op menselijke aangelegenheden is en die tracht te interpreteren en voorspellen. (AAT-Ned)"@nl;
