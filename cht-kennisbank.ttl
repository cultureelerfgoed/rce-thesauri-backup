<https://data.cultureelerfgoed.nl/term/id/cht/f44f3972-63a0-418a-ae3a-490838a8513c>
  a skos:Concept;
  skos:prefLabel "achteruittandwielen"@nl;
  skos:scopeNote "Tussentandwiel in de versnellingsbak om de draairichting van de uitgaande as om te keren en de wagen achteruit te laten rijden. Wordt in aangrijping gebracht als de achteruitversnelling wordt ingeschakeld."@nl;
  skos:altLabel "achteruittandwiel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/440e54df-3af5-4bae-91be-39086e40fb58>;
