<https://data.cultureelerfgoed.nl/term/id/cht/10812e35-db72-42f9-89e2-30ac41b565db>
  a skos:Concept;
  skos:prefLabel "koorhekken"@nl;
  skos:scopeNote "Houten of metalen hek ter begrenzing en afsluiting van de koorruimte. Op het koorhek kan/kon zich een triomfkruis bevinden, met aan weerszijden een beeld: Maria en Johannes. Ook andere hekken zijn in de kerk te vinden om bepaalde ruimten af te scheiden, zoals de hekken voor doopkapel, grafkapel, gildenkapel. (Religieus Erfgoedthesaurus)"@nl;
  skos:altLabel "koorhek"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/45db386a-7e50-4c8f-94d2-6caa48ee8f6a>;
