  a skos:Concept;
  skos:prefLabel "hondsoren (balk)"@nl;
  skos:scopeNote "Zware balken tussen ondertafelement en hoekstijlen in een wipmolen. Ter vergroting van het draagvlak van de hoekstijlen voor het boventafelement. (Molenwoordenboek B.D. Poppen)"@nl;
