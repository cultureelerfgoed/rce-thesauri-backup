  a skos:Concept;
  skos:prefLabel "nijptangen"@nl;
  skos:scopeNote "Nijptangen zijn tangen met scherpe bekken die hoofdzakelijk gebruikt worden bij het koud bewerken van metalen, zoals het afknijpen van draad."@nl;
  skos:altLabel "nijptang"@nl, "trektang"@nl;
