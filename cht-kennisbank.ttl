<https://data.cultureelerfgoed.nl/term/id/cht/cc8c5166-4644-47a4-93b6-b0f0af335dd4>
  a skos:Concept;
  skos:prefLabel "bootschepen"@nl;
  skos:scopeNote "Koopvaardijschip, ook gebruikt als walvisvaarder, bekend sedert de 15de eeuw, maar vooral in de vaart in de 17de en 18de eeuw in Nederland, België, Duitsland en Scandinavië. (aatned.nl)"@nl;
  skos:altLabel "bootschip"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/32d80748-50d1-4c9c-b06d-dfca42e46ac6>;
