<https://data.cultureelerfgoed.nl/term/id/cht/5d06bfd4-ad21-42b0-a929-759f108cf2e3>
  a skos:Concept;
  skos:prefLabel "Zeeuwse steen"@nl;
  skos:scopeNote "Zeeuwse stenen zijn bakstenen van van klei die overwegend geel bakt. Ze zijn gevormd in Waalformaat."@nl;
