<https://data.cultureelerfgoed.nl/term/id/cht/a13773d0-ea50-47bb-8a6e-a278e9b9f729>
  a skos:Concept;
  skos:prefLabel "koppen en schotels"@nl;
  skos:scopeNote "Drinkgerei, vaak met één handvat, maar soms met twee of geen handvatten, gewoonlijk op een lage voetring; naar boven toe minder wijd uitlopend dan 'kommen'. (AAT)"@nl;
  skos:altLabel "kop en schotel"@nl;
