<https://data.cultureelerfgoed.nl/term/id/cht/66cfdc9c-010d-459c-b32f-2fdb770f4ed3>
  a skos:Concept;
  skos:prefLabel "dwarsdelen"@nl;
  skos:scopeNote "Deel die dwars t.o.v. de lengterichting in een schuur ligt en vaak aan beide zijden een inrijdeur heeft. (Haslinghuis)"@nl;
