  a skos:Concept;
  skos:prefLabel "hangers (haak/ketting)"@nl;
  skos:scopeNote "Ophanghaak of ophangketting bevestigd aan de einden van de korte spruit en aan de lange schoor, om het doorzwiepen te voorkomen. Ook trekstang."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/04770e4f-1c11-40e7-a256-9de8c6d569c6>;
