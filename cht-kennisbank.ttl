<https://data.cultureelerfgoed.nl/term/id/cht/7c274ea2-0be4-4c27-b24e-00a09192f0ec>
  a skos:Concept;
  skos:prefLabel "suikerbroden (grenspaal)"@nl;
  skos:scopeNote "Suikerbroden is de naam voor een groep stenen grenspalen met de volgende drie kenmerken: naar boven toe enigszins taps toelopend, in dwarsdoorsnede rond en aan de bovenzijde een afgeronde kop. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "suikerbrood (grenspaal)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d0672d52-28d1-439e-9af1-9aa0a834b681>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/7292ca42-3a16-4492-bef6-79e38ee8cc33>
  a skos:Concept;
  skos:prefLabel "lintbebouwing"@nl;
  skos:scopeNote "Lintbebouwing is een langgerekte lijn van (veelal vrijstaande) bebouwing langs een weg of waterverbinding. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2971af0-cde7-4888-b828-33443f702e7d>;
