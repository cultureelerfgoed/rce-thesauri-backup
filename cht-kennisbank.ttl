  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/dab39a94-f15f-4150-b0f0-1ee93c53181b>
  a skos:Concept;
  skos:prefLabel "strappo"@nl;
  skos:scopeNote "Strappo is de techniek van het afnemen van een fresco van de ondergrond waarbij men alleen de verflaag overbrengt op een tijdelijke drager."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/dac9218b-eb22-4950-b080-eea73719697f>
  a skos:Concept;
  skos:prefLabel "smalti"@nl;
  skos:scopeNote "Smalti is een door en door gekleurde, ondoorzichtige glassoort, die in Italië wordt gemaakt. Het glas wordt gegoten in de vorm van een tien millimeter dikke tegel, piastra of pizza genaamd, die in kleine rechthoekige stukjes van ongeveer 15 x 6 à 7 millimeter wordt gesneden: tesserae. Deze tesserae worden gebruikt als onderdeel van terrazzo om daar mede kleur aan te geven of om er mozaIeken mee te maken. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dcc2121b-8394-44f7-9664-86b109d079a4>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/daf44ee2-f997-4c73-98ea-d1f9e8fe8f22>
  a skos:Concept;
  skos:prefLabel "massaconservering"@nl;
  skos:scopeNote "Massaconservering is de gelijktijdige behandeling van een groot aantal voorwerpen in een werkgang, in tegenstelling tot het behandelen van individuele stukken."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/190b9fce-fb0d-4b41-b46d-e1795ae38304>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/dafa1de9-d74a-4d21-ae2d-3f61046b04ae>
  a skos:Concept;
  skos:prefLabel "wolvenjachten"@nl;
  skos:scopeNote "Wolvenjachten zijn jachtpartijen op wolven die vanaf de middeleeuwen werden beschouwd als schadelijk wild. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "wolvenjacht"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fe944ecb-9c86-4a8e-87e0-f196bac83383>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/db0928fc-f767-474a-9691-567f047c192d>
  a skos:Concept;
  skos:prefLabel "archeometallurgie"@nl;
  skos:scopeNote "Archeometallurgie is het vakgebied dat de prehistorische en historische praktijk bestudeert van mijnbouw, winning en zuivering van metalen, en de vervaardiging van metalen voorwerpen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c32e9420-6176-42cc-a65c-25f671d1ec23>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/db0a27db-9f76-4c9d-a574-ae494ab9d321>
  a skos:Concept;
  skos:prefLabel "lakbeschadiging"@nl;
  skos:scopeNote "Lakbeschadiging is het per ongeluk doorboren of krassen van de microscopisch dunne laag aan de labelzijde van een CD of vergelijkbare optische opslagmedia, waardoor de kwetsbare, reflecterende laag komt bloot te liggen. Lakbeschadiging kan tijdens de fabricage door toepassing van zure drukinkten ontstaan, door onvoorzichtige behandeling en slechte opslag. De aantasting van de reflecterende laag is er de oorzaak van dat de laseraftasting van het volledige signaal op de schijf ernstig bemoeilijkt wordt, waardoor de schijf niet meer kan worden afgespeeld."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/db319621-461a-441e-8deb-a429a62863aa>
  a skos:Concept;
  skos:prefLabel "lansonderdelen"@nl;
  skos:scopeNote "Lansonderdelen zijn alle delen van waar uit een lans is opgebouwd. Een lans (Lat. Lancia) is een stoot- of steekwapen. Een lans bestaat uit een lange schacht, van bijvoorbeeld essen of bamboe, of staal. Aan het einde is een platte metalen kling bevestigd met een ronde of bladvormige doorsnede. Een lans heeft een totale lengte van 3,5 tot 4,5 meter. Het greepeinde was soms voorzien van een handbeschermer en verzwaard met kegelvormige verdikkingen, zodat het zwaartepunt bij de hand lag."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bfa5acbd-ed55-4787-a217-db06688d2331>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/70107690-3db6-4dce-88c3-648c44c219fa>,
    <https://data.cultureelerfgoed.nl/term/id/cht/952be7e9-a855-4e8b-a91b-d6694a8fc556>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/db32587d-9a31-47e5-b460-862e22e76da3>
  a skos:Concept;
  skos:prefLabel "manuaalkoppels"@nl;
  skos:scopeNote "zie koppel, specifiek voor de handklavieren (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "manuaalkoppel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b391ff3f-fe77-436c-89bb-21f7944fd426>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/db4f482c-3c45-4e22-ad36-77ba38c587ea>
  a skos:Concept;
  skos:prefLabel "ont-tinning"@nl;
  skos:scopeNote "Ont-tinning zou het verdwijnen van tin uit een legering zijn. Dit gebeurt niet omdat tin onoplosbare oxidehydraten vormt, met name bij de corrosie van bronzen met een laag tingehalte (eenfasige koper-tinlegeringen)."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/db4fc66e-9190-4ecc-bbe9-cee602949f8e>
  a skos:Concept;
  skos:prefLabel "satijnbinding"@nl;
  skos:scopeNote "De satijnbinding is een weeftechniek waarbij iedere kettingdraad over tenminste vier inslagen loopt alvorens door een inslag te worden vastgezet. Het resultaat is een weefsel met lange flotterende kettingdraden die een glad, glanzend effect veroorzaken."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/db51ce46-858b-43bd-b4c4-734a6cb2445e>
  a skos:Concept;
  skos:prefLabel "maforijen"@nl;
  skos:scopeNote "Op iconen is de maforij het overkleed dat het hoofd en de schouders van de Moeder Gods of een vrouwelijke heilige bedekt. (Conservation Dictionary)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/623e7274-a6cb-4133-b9b4-83f0db8d4f01>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/db7ba9f6-abf1-4990-990e-11f0859c40e4>
  a skos:Concept;
  skos:prefLabel "bankhamers"@nl;
  skos:scopeNote "Bankhamers zijn houten hamers met een korte steel die gebruikt worden om klompen met beitels uit te hollen. Bankhamers zijn hamers die qua vorm lijken op voorhamers, maar zijn beduidend lichter van gewicht. Hun gewicht ligt tussen de een en drie kilogram."@nl;
  skos:altLabel "bankhamer"@nl, "dophamer"@nl, "dophamers"@nl, "heulhamer"@nl, "heulhamers"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d339743b-2655-40ed-b20b-e39879154603>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/db88c403-6f4f-46cc-9262-5198707e9bb0>
  a skos:Concept;
  skos:prefLabel "aërosol silica"@nl;
  skos:scopeNote "Aërosol silica (handelsnaam: Aerosil) is een soort zeer fijnkorrelig siliciumdioxide in allerlei vorm die kan worden gebruikt als matteringsmiddel en verdikkingsmiddel voor bindmiddelen. Aërosol silica, Aerosil, is een heel fijn verdeelde, colloïdale vorm van synthetisch siliciumdioxide, gemaakt door verbranding van siliciumtetrachloride. Het wordt gebruikt als massa voor epoxyvulstoffen bij de restauratie van glas en ceramiek. Het blijkt de hechtkracht van sommige harsen te verhogen. Het wordt ook gebruikt als matteringsmiddel in retoucheermiddelen. Het is een heel fijn poeder en het is verkrijgbaar in een hydrofiele (waterminnende) en een hydrofobe (waterafstotende) vorm."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7ae64c63-7d37-4a9c-9d7b-2dbc577009ab>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/dbad789c-3b67-481d-b26a-6c8e1263b37b>
  a skos:Concept;
  skos:prefLabel "prepareren"@nl;
  skos:scopeNote "Prepareren is het schoonmaken en conserveren van de huid van een meestal gewerveld dier en het opzetten ervan op een geraamte of model zodat de vorm van het skelet en de musculatuur van het dier wordt gesimuleerd. Het prepareren of opzetten van een dier is het werkproces ten behoeve van het bewaren van het exemplaar. Afhankelijk van de diersoort omvat het het verwijderen van de delen die niet worden bewaard, het drogen en de ondersteuning van de overblijvende delen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/dbe0d364-d3db-4fa7-b6cf-1b83916063f0>
  a skos:Concept;
  skos:prefLabel "levensverwachting"@nl;
  skos:scopeNote "De levensverwachting is de tijdsperiode die voor de bruikbaarheid van een foto geldt, voordat het beeld door kleurveranderingen en verbleken door veroudering onacceptabel wordt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5f4c4bef-a5c2-4d8e-ad2a-88b04f93f3dc>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/dbeff392-bcba-4017-aabc-4423c3be3358>
  a skos:Concept;
  skos:prefLabel "scharnierversterkingen (boek)"@nl;
  skos:scopeNote "Een scharnierversterking is de binnenkant van het scharnier van een boek en bestaat uit een strook leer of papier. (Conservation Dictionary)"@nl;
  skos:altLabel "scharnierversterking (boek)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/df6a4c88-277e-4078-9a74-72033a63bb37>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/dc047359-ce0f-436f-b73a-8c793f8479f8>
  a skos:Concept;
  skos:prefLabel "22 karaat goud"@nl;
  skos:scopeNote "De zuiverheidsgraad van regulier goud is 22 karaat."@nl;
  skos:altLabel "22 karaat"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/87732f1f-badc-482e-b596-cdd356dc6c1d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/dc08a89f-7292-45ce-a8b0-a3ff8dff0557>
  a skos:Concept;
  skos:prefLabel "rode rot"@nl;
  skos:scopeNote "Rode rot in leer is een vervalverschijnsel ten gevolge van de interactie van zwaveldioxide (door luchtverontreiniging of het vervaardigingsproces) met plantaardige looistoffen, waardoor het leer bros wordt, met een baksteenrood poederig oppervlak."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/8d19cea6-edf8-40fb-a6e6-8ba0d52c3a53>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/dc1d0eea-6cf9-4560-bee6-22da2279e40d>
  a skos:Concept;
  skos:prefLabel "road carts"@nl;
  skos:scopeNote "Lichte wagentjes voor één of twee passagiers die door één paard of pony werden getrokken; populair aan het einde van de 19e en begin van de 20e eeuw. (AAT-Ned)"@nl;
  skos:altLabel "road cart"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/27f18a43-a2aa-4b07-a601-e083756f1874>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/dc284766-e2d6-4a1a-a5f7-c41e241c79d4>
  a skos:Concept;
  skos:prefLabel "kleipap"@nl;
  skos:scopeNote "Kleipap, een extractiemassa van klei is een absorberende pap met klei als absorberend materiaal."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/dc87ecf1-35a0-4505-a66c-e168d4779e15>
  a skos:Concept;
  skos:prefLabel "directe belichting"@nl;
  skos:scopeNote "Directe belichting is belichting zonder afscherming tussen de lichtbron en het voorwerp."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/df4db7b4-3b69-49a2-9068-13034f1a068f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/dcdaf405-3736-4bfd-a094-d1cded445166>
  a skos:Concept;
  skos:prefLabel "ziekte van Byne"@nl;
  skos:scopeNote "De ziekte van Byne is het verschijnsel van uitbloei op schelpen, meestal zeeschelpen, als gevolg van de reactie van calciumcarbonaat met zure organische dampen afkomstig uit houten kasten en andere opbergmaterialen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/adece53d-06f7-48a9-8dde-89386bba2082>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/dce83a17-9ae7-4a18-91db-e83d35f14ad2>
  a skos:Concept;
  skos:prefLabel "blindlood (techniek)"@nl;
  skos:scopeNote "De blindloodtechniek is een techniek voor het maken van Tiffany glaspanelen en (nauwelijks in Nederland) het repareren van gebroken vlak glas. Zelfklevend koperfolie wordt op de breukranden gewreven en de met folie bedekte randen worden aan elkaar gesoldeerd. Deze techniek is een alternatief voor lelijke breukloodjes of wanneer lijmen niet kunnen worden gebruikt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/dd31385e-9785-44dd-82ec-9db1a791c736>
  a skos:Concept;
  skos:prefLabel "ontgravingen"@nl;
  skos:scopeNote "Ontgraven,weggraven van zand, in de duinen mijnen genoemd."@nl;
  skos:altLabel "ontgraving"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
