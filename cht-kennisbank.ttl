  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c199d7bd-193a-4b69-8c84-e068eb4d0613>
  a skos:Concept;
  skos:prefLabel "rietsnitten"@nl;
  skos:scopeNote "Rietsnitten zijn scherpe, klein zeisvormig stukken gereedschap waarmee de rietsnijders het riet op de velden snijden. (Het weke dak: riet- en strobedekkingen / , RV bijdrage 11, Zeist 1990)"@nl;
