<https://data.cultureelerfgoed.nl/term/id/cht/0897a6e7-258b-44dc-bfa0-d75308a752cc>
  a skos:Concept;
  skos:prefLabel "stengewinderepen"@nl;
  skos:scopeNote "Reep voor het hijsen van een steng."@nl;
