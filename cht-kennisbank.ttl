<https://data.cultureelerfgoed.nl/term/id/cht/b1cf29d2-404d-42c3-8869-70a5e5099064>
  a skos:Concept;
  skos:prefLabel "groeikernen"@nl;
  skos:scopeNote "Groeikernen als stedenbouwkundige concepten zijn steden of plaatsen die als overloop fungeren voor een grotere stad, waar ruimtetekort verondersteld werd. Het Nederlandse groeikernenbeleid in de periode 1960-1985 was een poging de voortschrijdende suburbanisatie in vooral de Randstad in goede banen te leiden. (Wikipedia)"@nl;
  skos:altLabel "groeikern"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d67a4fa0-7ed6-4584-b653-8cd0bef4a150>;
