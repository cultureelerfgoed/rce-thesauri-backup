<https://data.cultureelerfgoed.nl/term/id/cht/499d139e-c7ec-4175-b9cc-74b5ca30746e>
  a skos:Concept;
  skos:prefLabel "numismatiek"@nl;
  skos:scopeNote "Numismatiek is de wetenschappelijke studie van alle tastbare vormen en geschiedenis van geld (munten en bankbiljetten) en vormverwante voorwerpen als penningen en gesneden stenen, alsmede de zaken die hierbij horen, zoals muntstempels, muntgewichten, druktechnieken en muntwetgeving."@nl;
  skos:altLabel "muntkunde"@nl;
