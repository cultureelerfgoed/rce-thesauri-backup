<https://data.cultureelerfgoed.nl/term/id/cht/35b49087-a029-4fdb-aa82-1bedda6ee761>
  a skos:Concept;
  skos:prefLabel "inkjetkleurstofsublimatiedrukken"@nl;
  skos:scopeNote "Afdrukken gebaseerd op een overdracht waarbij eerst een inkjetprint gemaakt wordt en vervolgens de kleurstof van de inkjetprint door sublimatie overgebracht wordt op een drager. (Project Fotografie)"@nl;
  skos:altLabel "inkjet kleurstofsublimatiedruk"@nl;
