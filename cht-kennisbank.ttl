<https://data.cultureelerfgoed.nl/term/id/cht/2065408c-80b0-4d0c-a950-73c5b634262a>
  a skos:Concept;
  skos:prefLabel "grantverglas"@nl;
  skos:scopeNote "Grantverglas is een soort glas dat wordt gebruikt voor vensters en decoratieve objecten, bekend om zijn helderheid en duurzaamheid, vaak toegepast in architectonische en artistieke contexten."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dcc2121b-8394-44f7-9664-86b109d079a4>;
