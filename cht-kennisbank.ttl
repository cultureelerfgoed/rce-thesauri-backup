  a skos:Concept;
  skos:prefLabel "tegenmijnen"@nl;
  skos:scopeNote "Mijngang met een springlading, door de belegerde aangelegd met het doel een door de aanvaller aangelegde mijn voortijdig te doen exploderen. (Stichting Menno van Coehoorn)"@nl;
  skos:altLabel "tegenmijn"@nl;
