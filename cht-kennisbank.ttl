<https://data.cultureelerfgoed.nl/term/id/cht/9f34f27a-588d-4461-8ee8-1431def8fa60>
  a skos:Concept;
  skos:prefLabel "chemisch reinigen"@nl;
  skos:scopeNote "Chemisch reinigen is een behandeling met chemicaliën die met ongewenste materialen op een voorwerp reageren of deze oplossen dan wel afsplitsen. Bij chemisch reinigen van textiel wordt een niet-waterige oplossing gebruikt. Chemisch reinigen wordt toegepast als het aanwezige (vettige) vuil onoplosbaar is in water of als er materialen aanwezig zijn, zoals kleurstoffen, die in water uitbloeden."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/06a2fab7-0ef1-4eda-a282-20153013381e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/06a4759c-9a3e-4a40-803b-e71f31bc8cf3>
  a skos:Concept;
  skos:prefLabel "traliewerk (ornament)"@nl;
