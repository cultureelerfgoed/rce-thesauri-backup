<https://data.cultureelerfgoed.nl/term/id/cht/4069b266-42ad-4fa5-96cd-2e0e9de04520>
  a skos:Concept;
  skos:prefLabel "schuifblinden"@nl;
  skos:scopeNote "Schuifblinden zijn blinden die horizontaal weggeschoven kunnen worden in een smalle uitgespaarde ruimte in de bijbehorende betimmeringen. Bij eenvoudige uitvoeringen schuiven de blinden langs de muur. (Historische zonwering / B.H.J.N. Kooij, RCE Brochure, Amersfoort, 2012)"@nl;
  skos:altLabel "schuifblind"@nl;
