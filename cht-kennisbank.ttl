<https://data.cultureelerfgoed.nl/term/id/cht/ae874acf-c353-4829-a77c-6fbeaf99f692>
  a skos:Concept;
  skos:prefLabel "draaizagen"@nl;
  skos:scopeNote "Spanzaag waarbij het zaagblad ook nog aan een einde aangespannen kan worden met een draaiknop. De lengte hiervan is doorgaans 30 tot 40 cm."@nl;
  skos:altLabel "draaizaag"@nl;
