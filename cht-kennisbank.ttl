  a skos:Concept;
  skos:prefLabel "koperdraad"@nl;
  skos:scopeNote "Draad van koper. In het verleden gebruikt voor de bevestiging van glas-in-loodpanelen, zoals hier en daar nog in Duitsland te zien is. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
