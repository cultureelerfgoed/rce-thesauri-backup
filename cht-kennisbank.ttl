<https://data.cultureelerfgoed.nl/term/id/cht/9ee48f42-18fe-4392-aa05-8a97f7b7c5d1>
  a skos:Concept;
  skos:prefLabel "bogengangen"@nl;
  skos:scopeNote "Gang, meestal onder de bebouwing gelegen, rond een plein of binnenhof, aan de zijde van de open ruimte afgesloten door een bogenrij, rustend op zuilen of pijlers. (zie) arcade, (zie) Laube. (Haslinghuis)"@nl;
  skos:altLabel "bogengang"@nl;
