<https://data.cultureelerfgoed.nl/term/id/cht/2a1171e7-b346-4c87-ab77-e6ad62258c41>
  a skos:Concept;
  skos:prefLabel "waterpoorten"@nl;
  skos:scopeNote "Een waterpoort is een uit één of meer bogen bestaande poort over een rivier, kanaal of haven, aan weerszijden voorzien van torens, dienende om door een valhek of andere middelen de doorvaart te verhinderen."@nl;
  skos:altLabel "waterpoort"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c8f08076-526c-4ed4-a079-1ea5dcf52547>;
