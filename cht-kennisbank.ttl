<https://data.cultureelerfgoed.nl/term/id/cht/7b6f985c-8e76-4d8e-9554-45ad8adf9c23>
  a skos:Concept;
  skos:prefLabel "over-vierkante motoren"@nl;
  skos:scopeNote "Motor waarvan de slag van de zuiger kleiner is dan de diameter van de cilinder."@nl;
  skos:altLabel "over-vierkante motor"@nl;
