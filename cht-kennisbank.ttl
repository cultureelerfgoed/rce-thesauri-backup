<https://data.cultureelerfgoed.nl/term/id/cht/6843fe51-c8fe-449a-8b2c-50f6fe4fc8b3>
  a skos:Concept;
  skos:prefLabel "daklak"@nl;
  skos:scopeNote "Daklak is teerhoudend materiaal, verkregen uit steenkooldestillatie. De substantie wordt heet verwerkt voor het afsmeren van teerhoudende dakbedekking."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5594c353-227c-4047-86b4-89c6f760eb17>;
