<https://data.cultureelerfgoed.nl/term/id/cht/71455fd2-831a-4dac-b322-e0b5a57d364b>
  a skos:Concept;
  skos:prefLabel "ogiefbinten"@nl;
  skos:scopeNote "Dekbalk van een spitsbooggebint in een houten tongewelf, waaruit gedeeltelijk de spitsbogige gewelfrib is uitgestoken. (Haslinghuis)"@nl;
  skos:altLabel "ogiefbint"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bd8b0ad6-f704-46fa-a6de-ca52c53ec74a>;
