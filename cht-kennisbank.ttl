<https://data.cultureelerfgoed.nl/term/id/cht/56217d44-5597-40e4-88b5-e5dbc94e4067>
  a skos:Concept;
  skos:prefLabel "puntschaven"@nl;
  skos:scopeNote "De beitel in de puntschaaf is puntig om in het hout een overhoekse sponning uit te schaven. Soms met diepte-instelling door middel van een aanloop. Andere namen: diamantschaaf, serpentschaaf."@nl;
  skos:altLabel "diamantschaaf"@nl, "puntschaaf"@nl, "serpentschaaf"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/8a71150f-c731-4b96-aaba-18daab8c4900>;
