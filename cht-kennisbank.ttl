<https://data.cultureelerfgoed.nl/term/id/cht/fe5a7d96-972f-4ebb-845d-2177ab94c234>
  a skos:Concept;
  skos:prefLabel "apostelbalken"@nl;
  skos:scopeNote "Triomfbalk waarop apostelbeelden staan of waarop apostelportretten zijn geschilderd. Op de apostelbalk kan ook een triomfkruis (kruisbeeld) met flankerende beelden staan (Maria en Johannes, soms aangevuld met twee vrouwenbeelden die kerk en synagoge verbeelden)."@nl;
  skos:altLabel "apostelbalk"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/650ab4b1-e8ab-4c49-9195-8401d4a6cd6e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/0b5189aa-4277-4362-a25f-a53fcc915be1>
  a skos:Concept;
  skos:prefLabel "koorschotten"@nl;
  skos:scopeNote "Houten afscheidingswand tussen koorruimte en volkskerk."@nl;
  skos:altLabel "koorschot"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4e481c81-319a-44da-86bf-106f145d22c1>;
