  a skos:Concept;
  skos:prefLabel "beeldmanipulatie"@nl;
  skos:scopeNote "Zie digitale beeldmanipulatie."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a191d2f5-7b35-4005-8d1c-d90824858200>
  a skos:Concept;
  skos:prefLabel "wrijfpalen"@nl;
  skos:scopeNote "Een wrijfpaal is een paal waaraan de beesten in de weide zich kunnen wrijven (bron: van Dale)"@nl,
    "Een wrijfpaal is zware lostaande 'meerpaal' op een hoek van de (scheeps)doorvaart van een kunstwerk, die het kunstwerk moet beschermen.(bron: de Binnenvaart)"@nl;
  skos:altLabel "wrijfpaal"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a1bda31a-b52d-41f7-906b-fbb8c3dc820a>
  a skos:Concept;
  skos:prefLabel "breukrand"@nl;
  skos:scopeNote "Een breukrand is een vers oppervlak dat aan de dag is gekomen door een breuk."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/44911502-f7bb-4318-8682-f7aa579cf2b1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a1ced41d-fbeb-449b-bd8c-fb729def5fb2>
  a skos:Concept;
  skos:prefLabel "afstemming van glazuur en klei"@nl;
  skos:scopeNote "Of een glazuur zich goed houdt op aardewerk wordt bepaald door de mate waarin eigenschappen als uitzetting en krimp van de klei en de glazuur op elkaar zijn afgestemd. Als de overeenkomst slecht is zal de glazuur craqueleren en loslaten."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a1e40773-5f1b-42a8-89d0-3adfc3671642>
  a skos:Concept;
  skos:prefLabel "haringvaten"@nl;
  skos:scopeNote "Het pakken van de haring in tonnen was een vak apart. De Enkhuizers wisten precies welke tonnen ze hiervoor moesten gebruiken en hoe ze de vis moesten verpakken. De haring bleef zo lang goed, wat belangrijk was voor de export."@nl;
  skos:altLabel "harington"@nl, "haringtonnen"@nl, "haringvat"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2fbe6906-a6df-4540-8e60-eeae4cbcd1a3>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a1ea6db1-bcd8-473f-894a-176b4ade9624>
  a skos:Concept;
  skos:prefLabel "röntgenkristallografie"@nl;
  skos:scopeNote "Röntgenkristallografie bepaalt de structuur van kristallen en moleculen met behulp van röntgendiffractie."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a21eeebb-da40-4c9d-822f-9a5cb3b5d0d6>
  a skos:Concept;
  skos:prefLabel "perkamentlijm"@nl;
  skos:scopeNote "Perkamentlijm is een lijm die gemaakt wordt door perkamentsnippers te koken in water, soms onder toevoeging van azijnzuur. Perkamentlijm zonder azijnzuur wordt gebruikt om papier na te lijmen na een natbehandeling. Met azijnzuur wordt het gebruikt om goudslagershuid op perkament te lijmen als versteviging van het perkament."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c623de2a-4e2a-476d-9d3c-10c4501cabad>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a2408625-a088-4e48-b671-3f28336ccfdd>
  a skos:Concept;
  skos:prefLabel "alkalische aantasting"@nl;
  skos:scopeNote "Alkalische aantasting van cellulose is een soort schade die veroorzaakt wordt doordat sterke alkaliën de vezel doen zwellen, zodat interne scheuren en breuken ontstaan. Alkalische condities veroorzaken hydrolyse van de cellulose. Op deze wijze aangetaste cellulose is vaak vergeeld."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/19a4249c-f03b-4c4c-9806-45c04fb0bceb>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a24744ad-58b6-4bd5-927d-a7b2b5edcf6d>
  a skos:Concept;
  skos:prefLabel "tijdmeetinstrumenten"@nl;
  skos:scopeNote "Tijdmeetinstrumenten zijn alle soorten instrumenten, die de tijd meten. Tijdmeting of chronometrie is het meten van de tijd. Tijdmeting en de daarmee gepaard gaande ontwikkeling van mechanische klokken zijn verweven met de ontwikkeling van onze huidige maatschappij; ze kunnen eigenlijk niet los van elkaar gezien worden.Voordat het mechanische uurwerk er was, had de mens de beschikking over elementaire klokken. Naast kalenders werden gebruikt: de waterklok, de zandloper, kaarsen of olielampen (met een aantal strepen erop) en de zonnewijzer. Aan elk van deze elementaire tijdmeters kleefde een nadeel: water kan bevriezen, een zandloper moet constant in de gaten gehouden worden, kaarsen of olielampen kunnen uitgeblazen worden, en een zonnewijzer werkt alleen als er zon is.Afgezien van de zonnewijzer konden elementaire klokken bovendien meestal alleen de duur van een gebeurtenis meten, niet op welk tijdstip de gebeurtenis plaatshad. De komst van het mechanisch uurwerk in de laatste decennia van de dertiende eeuw heeft dat probleem opgeheven."@nl;
  skos:altLabel "tijdmeetinstrument"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/36963dcd-7f11-4902-8e8e-91eb92ad8ffd>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a270ce86-4e64-4127-ab1c-e43b96a7d998>
  a skos:Concept;
  skos:prefLabel "tussenbedoekingen"@nl;
  skos:scopeNote "Een tussenbedoeking is een materiaal dat bij het bedoekingsproces wordt aangebracht tussen het originele doek en het steundoek. Het is bedoeld om meer steun en stevigheid te geven en in sommige gevallen vorming van interferentiepatronen tussen de weefsels te onderdrukken. Een losse tussenbedoeking wordt los tussen de beide doeken gelegd. Een vaste tussenbedoeking wordt aan het steundoek gehecht. (Conservation Dictionary)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/461d88c4-a46f-4dbb-a137-a9266eae7a42>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a2940dd8-fc99-40ce-b260-09378172d40b>
  a skos:Concept;
  skos:prefLabel "cassettes"@nl;
  skos:scopeNote "Een cassette, juister Compact Cassette genoemd, bestaat uit een plastic omhulsel waarin zich een smalle magnetische band bevind. De gebruikelijke binder bevat meestal ijzeroxide als magnetisch materiaal. Vanwege (de lage) opname- en afspeelsnelheid zijn andere samenstellingen toegepast om de geluidskwaliteit te verbeteren. Hoewel het een van de meest succesvolle geluidsdragers is die ooit is geproduceerd, raakt de cassette gemakkelijk beschadigd indien ze niet juist gehanteerd en bewaard wordt. (Conservation Dictionary)"@nl;
  skos:altLabel "cassette"@nl, "compact cassette"@nl, "compact cassettes"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91712616-6dec-4871-8fdc-c317850c20d1>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/51f16e02-dc19-4a6e-b156-6c390bc0223c>,
    <https://data.cultureelerfgoed.nl/term/id/cht/8ba8460d-94f7-4d84-9fa4-6139fef0d1e4>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a2e40df2-f38d-4a4b-9af6-6e3274321313>
  a skos:Concept;
  skos:prefLabel "tabernakellijsten"@nl;
  skos:scopeNote "Lijsten die architectonische elementen bevatten die voornamelijk bestaan uit een paar zuilen of pilaren die het object flankeren, een fries en fonton ondersteunen en op een voetstuk rusten. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f9ad90dc-6fc8-454a-9010-278cc1b0349f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a2e5e5c9-0c95-4bf1-b900-856da26189aa>
  a skos:Concept;
  skos:prefLabel "shoe-strings"@nl;
  skos:scopeNote "Een shoe-string (schoenveter) is een overstrekte polyester geluids- of beeldband die een ronde vetervorm gekregen heeft. Deze schade wordt vaak veroorzaakt door een plotselinge stop bij het heen en weer spoelen of het beklemd raken van de band in de cassette, vooral bij slecht onderhouden apparatuur. (Conservation Dictionary)"@nl;
  skos:altLabel "shoe-string"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91712616-6dec-4871-8fdc-c317850c20d1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a2f468b1-6e4d-4cfe-9b14-d258caa53c5a>
  a skos:Concept;
  skos:prefLabel "jachtgerei"@nl;
  skos:scopeNote "De pijl en boog was het jachtgerei bij uitstek in de pre-historie. Heden ten dage bestaat het jachtgerei uit een jachtgeweer, jachthoorn, jachtmes, verrekijker, kompas etc."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a31c3714-5ef1-4850-8c90-1c87bb58e51b>
  a skos:Concept;
  skos:prefLabel "verspekken"@nl;
  skos:scopeNote "Verspekken van een geprepareerd dier is beschadiging van de huid door oxidatie en migratie van het vet dat nog in het dier zit. Verspekken leidt vaak tot verlies van haar of veren."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a33b53dc-30bc-49c2-9f16-6077de0f29c0>
  a skos:Concept;
  skos:prefLabel "controlesporen"@nl;
  skos:scopeNote "Op een videoband is een controlespoor een lineair geschreven spoor, apart van de beeldinformatie, om synchronisatie mogelijk te maken tijdens opname, monteren en weergave. (Conservation Dictionary)"@nl;
  skos:altLabel "controlespoor"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a360d684-7690-41eb-bdb2-fb02a3d6f385>
  a skos:Concept;
  skos:prefLabel "kantje"@nl;
  skos:scopeNote "Het kantje is een oude vissersbenaming voor een houten harington. De door een logger gevangen haring werd aan boord gekaakt, gezouten en in een ton geschept. Een dergelijke met haring gevulde ton werd een kantje genoemd. Aangevoerd aan de wal werd de haring vanuit het kantje veelal overgepakt in een nieuwe ton. Vanaf dat moment gold voor een ton niet meer de benaming kantje. Deze aanduiding bleef voorbehouden aan de houten vaten die aan boord van het vissersschip werden meegevoerd en daar werden gevuld met haring."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2fbe6906-a6df-4540-8e60-eeae4cbcd1a3>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a3663391-ff52-4447-b6f8-c757176f080d>
  a skos:Concept;
  skos:prefLabel "laagsgewijs opbouwen"@nl;
  skos:scopeNote "Laagsgewijs opbouwen van een schilderij is het aanbrengen van meerdere lagen, waarvan sommige (semi-)transparant kunnen zijn."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a37a3bc2-3cce-48ed-91b4-89e687a085a7>
  a skos:Concept;
  skos:prefLabel "Tafel diagram"@nl;
  skos:scopeNote "Een Tafel diagram wordt gebruikt om experimentele corrosiesnelheden te bepalen. Het is een grafiek van de overspanning als functie van de logaritme van de stroomdichtheid."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/929f2b49-e558-4543-a710-41a893c3c5dd>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/98cca3a6-b0a8-4cb6-8b9e-55649a161d86>,
    <https://data.cultureelerfgoed.nl/term/id/cht/cc615bad-f12c-42a4-8509-a8555340810e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a38526de-7dd3-43d3-ab81-ea161f6df347>
  a skos:Concept;
  skos:prefLabel "antihalolaag"@nl;
  skos:scopeNote "Een antihalolaag is een donkergekleurde laag die onder de zilverhalide emulsie of aan de achterkant van een film wordt aangebracht. De laag dient om belichting door lichtreflectie vanaf de film of glazen drager te voorkomen. Antihalolagen worden gewoonlijk kleurloos tijdens het ontwikkelproces."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a39604bd-df6e-463a-b446-724b171ad15d>
  a skos:Concept;
  skos:prefLabel "verwervingsbeleid"@nl;
  skos:scopeNote "Het verwervingsbeleid van een organisatie staat beschreven in een formeel document dat de soorten voorwerpen die men wil verwerven beschrijft en de procedure die voor acceptatie geldt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/df4db7b4-3b69-49a2-9068-13034f1a068f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a399b499-737f-424f-86cd-783106f09274>
  a skos:Concept;
  skos:prefLabel "dubbelvergulding"@nl;
  skos:scopeNote "Dubbele vergulding is een methode bij het lijmvergulden waarbij een gepolijst oppervlak bedekt wordt met twee lagen goudblad. Meestal wordt dubbeldik goudblad gebruikt om een rijkere afwerking te krijgen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a3a75b37-6d23-4082-ae2b-16b765f83f77>
  a skos:Concept;
  skos:prefLabel "schimmelplek"@nl;
  skos:scopeNote "Een schimmelplek is een oppervlakkige of inwendige verkleuring van een voorwerp. Dit wordt veroorzaakt door bepaalde schimmels, die gekleurde afvalproducten afscheiden."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a3acd2d3-61f5-4426-81cb-d295c3b3c9ea>
  a skos:Concept;
  skos:prefLabel "temperatuurverloop"@nl;
  skos:scopeNote "Temperatuurverloop is de temperatuurverandering in een object of een gebouw die tot vormveranderingen kan leiden. Het verloop kan dagelijks zijn maar ook jaarlijks."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cea5f41e-f9e4-42a3-a2e4-b0a0977bfa39>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a3b2bd2b-a84a-406a-9c09-38696960cfee>
  a skos:Concept;
  skos:prefLabel "melkemmers"@nl;
  skos:scopeNote "Een melkemmer wordt gebruikt om tijdens het handmatig melken van de koe, de melk op te vangen."@nl;
  skos:altLabel "melkemmer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/741ce018-10d2-4f48-abe1-95bfd4c08fdd>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a3c5df51-679a-43c6-8b20-158208bdb31c>
  a skos:Concept;
  skos:prefLabel "plantafstanden"@nl;
  skos:scopeNote "Plantafstanden zijn de afstanden tussen planten, meestal bomen, in een rij of patroon. De keuze voor een plantafstand hangt samen met het gewenste estetisch effect, met de soort bomen en de groeiplaats. In lanen is de historische plantafstand belangrijk vanwege de uniciteit en de beleving van de laan. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "plantafstand"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a458501b-b4fa-4936-8a6e-256705fd36f7>
  a skos:Concept;
  skos:prefLabel "prioriteit"@nl;
  skos:scopeNote "Als men kijkt wat er moet gebeuren met een aantal objecten of werkzaamheden, worden prioriteiten gesteld waarmee de onderlinge volgorde voor het uitvoeren van het werk wordt gegeven."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/96f8ea1c-ab5c-42dc-975b-8ec50ae5bc66>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a4911136-a7b8-4ef1-8028-e89a26a2aa2b>
  a skos:Concept;
  skos:prefLabel "Friese steen"@nl;
  skos:scopeNote "Baksteenformaat 21,5x10,6x4,5, geel, rood, appelbloesem. (Agriwiki)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bbe4a82c-d0af-42c9-86c2-cca2e9560bac>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a4abbdd2-5d55-417b-b0b4-d261cec32712>
  a skos:Concept;
  skos:prefLabel "lijming"@nl;
  skos:scopeNote "1. (Na)lijming is een materiaal dat toegepast wordt om een materiaal tegen het indringen van vloeistoffen zoals water of inkt te beschermen. De belangrijkste soorten zijn gelatine, huidenlijm, stijfsel, hars, gemodificeerde cellulose(s), caseïne of synthetische harsen. 2. Lijming is een oplossing van lijm in water die wordt gebruikt bij vergulden."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d032a7bc-8e44-4c1e-87cc-e02b6137a76d>
  a skos:Concept;
  skos:prefLabel "telescopen"@nl;
  skos:scopeNote "Een telescoop is, net als een verrekijker, een optisch instrument waarmee verre voorwerpen vergroot kunnen worden waargenomen. (Wikipedia)"@nl;
  skos:altLabel "telescoop"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/33f1944f-4045-46f2-a3b0-8283bdc5b328>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/2b98bc50-b4af-4667-a264-009ca73cb212>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a4f4583e-a60e-4013-bcd0-af506b4193fe>
  a skos:Concept;
  skos:prefLabel "transitie"@nl;
  skos:scopeNote "Transitie, overzetten, is het behouden van geluid- en beeldinformatie voor het nageslacht, ongeacht de drager van die informatie."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/190b9fce-fb0d-4b41-b46d-e1795ae38304>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a4f8898c-8701-4d54-b423-20f1002b5806>
  a skos:Concept;
  skos:prefLabel "spanspijkergaatje"@nl;
  skos:scopeNote "Een spanspijkergat is een gat in een doek dat gemaakt is door een spanspijker. Zo'n gat komt vaak voor in de omgeslagen rand van een doekschilderij."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a518af42-f6ec-49d1-ad0d-46b5fca12c05>
  a skos:Concept;
  skos:prefLabel "Airbrasive units"@nl;
  skos:scopeNote "Een Airbrasive unit is een apparaat voor het op gecontroleerde wijze zand- of gritstralen."@nl;
  skos:altLabel "Airbrasive unit"@nl;
