<https://data.cultureelerfgoed.nl/term/id/cht/b33b6bfb-f895-45a5-a0e4-79909ebc97f3>
  a skos:Concept;
  skos:prefLabel "altaarkleden"@nl;
  skos:scopeNote "In de perioden waarin het altaar niet wordt gebruikt, kan het altaarkleed over de altaardwalen op het altaar worden gelegd ter bescherming tegen vuil. Het kan gekleurd zijn en versierd zijn met borduursels."@nl;
  skos:altLabel "altaarkleed"@nl, "vesperdoek"@nl, "vesperdoeken"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/02a4722d-1dff-4e0a-9519-5a4c2562a48e>;
