  a skos:Concept;
  skos:prefLabel "idiofonen"@nl;
  skos:scopeNote "Idiofonen zijn muziekinstrumenten gemaakt van materiaal dat van nature klankrijk is. Idio- is afgeleid van het Griekse ἴδιος (idios) dat 'zelf, eigen' betekent. Idiofoon verwijst daarmee naar de eigen klankrijkheid van het muziekinstrument."@nl;
  skos:altLabel "idiofoon"@nl;
