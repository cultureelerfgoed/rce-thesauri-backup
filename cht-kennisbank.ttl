<https://data.cultureelerfgoed.nl/term/id/cht/c0707ced-4a39-494e-ba58-52e7fe5e7a34>
  a skos:Concept;
  skos:prefLabel "staatsietrappen"@nl;
  skos:scopeNote "Staatsietrappen zijn grote, breed aangelegde trappen die in openbare gebouwen of andere belangrijke bouwwerken een architectonisch hoogtepunt vormen. Doorgaans zijn zij rijk versierd en vervaardigd van kostbaar materiaal."@nl;
  skos:altLabel "staatsietrap"@nl;
