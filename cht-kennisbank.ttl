<https://data.cultureelerfgoed.nl/term/id/cht/46f0fcf3-f68a-49dd-9fa0-ad4ec6816bda>
  a skos:Concept;
  skos:prefLabel "goudleer"@nl;
  skos:scopeNote "Goudleer is een wanddecoratie van fijn leer (meestal van gelooide kalfshuiden), waarop afbeeldingen van bladzilver werden bevestigd, afgedekt met een goudkleurige vernis. (Wikipedia)"@nl;
  skos:altLabel "Cordoba-leer"@nl;
