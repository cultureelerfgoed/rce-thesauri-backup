<https://data.cultureelerfgoed.nl/term/id/cht/c4c313b7-92da-4cf4-9275-688f6d6093e5>
  a skos:Concept;
  skos:prefLabel "Sefardisch Joodse gemeente"@nl;
  skos:scopeNote "Joodse geloofsgemeenschap die de religieuze gebruiken, liturgie en tradities van het Sefardische jodendom volgt. Sefardisch-Joodse gemeenten zijn historisch verbonden met Joden van wie de voorouders afkomstig waren uit Spanje en Portugal en met gemeenschappen die na hun verdrijving elders ontstonden."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1270db19-bfd0-4b46-abc2-6f44fe8c7f4c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

