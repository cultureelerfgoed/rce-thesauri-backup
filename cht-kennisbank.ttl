<https://data.cultureelerfgoed.nl/term/id/cht/dc1b6a91-3e47-40dd-9fd4-5f3f3a680f84>
  a skos:Concept;
  skos:prefLabel "monstransen"@nl;
  skos:scopeNote "Houders waarin de geconsacreerde hostie wordt uitgestald op een altaar of tijdens een processie. In de regel (deels) van edelmetaal en op voet met stam. Te onderscheiden van 'pyxides'; dit zijn houders zonder stam gebruikt voor de grote hostie op het altaar of om de geconsacreerde hosties naar de zieken buiten de kerk te dragen. (AAT-Ned)"@nl;
  skos:altLabel "monstrans"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/abfc1bb7-04d7-43a0-9e99-dd4c5a4f2c15>;
