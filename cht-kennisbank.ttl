<https://data.cultureelerfgoed.nl/term/id/cht/41baf0de-267b-48ab-9501-63c7a8bf0517>
  a skos:Concept;
  skos:prefLabel "deisen"@nl;
  skos:scopeNote "Deisen zijn dunne balkjes van hout of ijzer in een schoorsteen. Over twee of meer deisen lagen latten of ijzeren staven, waaraan spek of worst opgehangen werd om te roken. (Haslinghuis)"@nl;
  skos:altLabel "deis"@nl, "deynsenen"@nl, "deysen"@nl;
