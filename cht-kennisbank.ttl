  a skos:Concept;
  skos:prefLabel "volle baksteen"@nl;
  skos:scopeNote "Volle baksteen is een massieve baksteen zonder holtes, gebruikt voor constructies waar een hoge druk- en treksterkte vereist is. Deze stenen zijn zwaar en duurzaam, waardoor ze geschikt zijn voor dragende muren en fundamenten."@nl;
