<https://data.cultureelerfgoed.nl/term/id/cht/dac18d55-6984-49cd-9582-0dcad41bb656>
  a skos:Concept;
  skos:prefLabel "chamfronnen"@nl;
  skos:scopeNote "Chamfron is een deel van een harnas voor paarden. De chamfron (ook wel gespeld als chanfron, chamfrein en shaffron) werd ontworpen om het gezicht van het paard te beschermen."@nl,
    "Chamfron is een deel van een harnas voor paarden. De chamfron (ook wel gespeld als chanfron, chamfrein en shaffron) werd ontworpen om het gezicht van het paard te beschermen. "@nl;
  skos:altLabel "chamfron"@nl, "hoofdpantser"@nl, "hoofdpantsers"@nl;
