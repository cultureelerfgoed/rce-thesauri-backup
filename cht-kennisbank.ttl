<https://data.cultureelerfgoed.nl/term/id/cht/8a321b41-e8bb-42cc-92c9-a4d4754c048b>
  a skos:Concept;
  skos:prefLabel "ijsbanen"@nl;
  skos:scopeNote "De ijsbaan is een terrein waarop in de winter bij vorst een ongeveer ovaalvormig parcours voor schaatsers wordt uitgezet."@nl;
