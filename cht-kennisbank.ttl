<https://data.cultureelerfgoed.nl/term/id/cht/41ae98cd-0cc4-438a-8032-3c6ee1429b8d>
  a skos:Concept;
  skos:prefLabel "dierenverblijven"@nl;
  skos:scopeNote "Dierenverblijven zijn onderkomens van dieren. Dat kunnen onderkomens in dierentuinen zijn, maar ook op andersoortige locaties zoals op boerderijen, maneges en schapenhouderijen."@nl;
  skos:altLabel "dierenonderkomen"@nl, "dierenonderkomens"@nl, "dierenverblijf"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d648c14d-3493-4003-8aaa-11a7786f8c32>;
