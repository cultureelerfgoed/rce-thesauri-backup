<https://data.cultureelerfgoed.nl/term/id/cht/9996121f-6417-45bd-bc8d-0705bf410160>
  a skos:Concept;
  skos:prefLabel "lithografieën"@nl;
  skos:scopeNote "Steendruk. Prent die is gedrukt door middel van een afgeplatte steen en de daarop aangebrachte tekening of schildering. De steen is zodanig voorbewerkt dat de drukinkt alleen hecht op het vette materiaal waarmee de voorstelling op de steen is aangebracht. (Religieus Erfgoedthesaurus)"@nl;
  skos:altLabel "litho"@nl, "litho's"@nl, "lithografie"@nl, "steendruk (prent)"@nl,
    "steendrukken (prent)"@nl;
