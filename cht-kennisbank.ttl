<https://data.cultureelerfgoed.nl/term/id/cht/9edcad50-db8d-48c4-a63c-7ad76273c51b>
  a skos:Concept;
  skos:prefLabel "Ölandsteen"@nl;
  skos:scopeNote "Zeer dichte harde fijnkorrelige kalksteen van het Zweedse eiland Öland."@nl;
  skos:altLabel "Öland"@nl;
  skos:hiddenLabel "Oland"@nl, "Olandsteen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b003b3b2-65d1-4aa7-bbe4-c035ae230c53>;
