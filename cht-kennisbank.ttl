<https://data.cultureelerfgoed.nl/term/id/cht/3396f95c-2168-4333-a122-e22c2b025842>
  a skos:Concept;
  skos:prefLabel "guillotines"@nl;
  skos:scopeNote "De guillotine is een instrument waarmee door middel van een valbijl mensen werden onthoofd. Het toestel ontstond tijdens de Franse Revolutie en werd behalve in Frankrijk gebruikt in België, Duitsland, Zweden en sommige Zwitserse kantons. (AAT-Ned)"@nl;
  skos:altLabel "guillotine"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c5497578-e661-49ed-9f0e-2a4fbd1079f8>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e3243590-4a52-458c-b4f7-240cad467fd1>
  a skos:Concept;
  skos:prefLabel "baardmankruiken"@nl;
  skos:scopeNote "Bol- of peervormige stenen flessen met smalle hals, versierd met masker met baard, vaak ook met een wapenschild; werd gemaakt in de 16e en 17e eeuw. (AAT-Ned)"@nl;
  skos:altLabel "baardmankruik"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e677977f-f707-46c7-8471-aed0f9e9e470>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f850a5e3-3780-4e04-a8f4-6677d7d6f393>
  a skos:Concept;
  skos:prefLabel "schuurbordjes"@nl;
  skos:scopeNote "Klein rechthoekig houten bordje met handgreep aan de onderzijde."@nl;
  skos:altLabel "schuurbordje"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/de57ea5e-0ed1-467b-8629-6df1ad0c69ed>;
