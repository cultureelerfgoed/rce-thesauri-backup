<https://data.cultureelerfgoed.nl/term/id/cht/a5b30cab-e93b-4091-9aaa-d2edd7d291ba>
  a skos:Concept;
  skos:prefLabel "ontspanningslokalen"@nl;
  skos:scopeNote "Ontspanningslokalen zijn vertrekken in gebouwen zoals internaten of retraitehuizen specifiek bedoeld voor ontspanning, bijvoorbeeld om te kaarten. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4d717812-4cc8-46b7-8c3c-6fd6fea67959>;
