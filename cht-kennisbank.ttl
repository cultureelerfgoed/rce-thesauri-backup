<https://data.cultureelerfgoed.nl/term/id/cht/ef1ff11f-ab10-46e2-93c2-9802b2095feb>
  a skos:Concept;
  skos:prefLabel "brand (hardsteenader)"@nl;
  skos:scopeNote "Zware bitumineuze ader in hardsteen. Scheiding tussen twee steenformaties. Wanneer een brandlaag dikker is dan 2 mm kan dit als een gebrek worden aangemerkt, omdat de steen op die laag vrij snel stukgaat. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f04fd7a6-c143-4255-9d98-bf07cc494eb0>
  a skos:Concept;
  skos:prefLabel "trekspanning"@nl;
  skos:scopeNote "Krachten, in een materiaal ontstaan door uitrekking. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f0b78153-e651-4172-b10b-4566b350c430>
  a skos:Concept;
  skos:prefLabel "ratelschelig"@nl;
  skos:scopeNote "Houtgebrek, met schors of wankant, rijschaal. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f0f6937f-1ce7-4811-a0b9-99231ddb317c>
  a skos:Concept;
  skos:prefLabel "windbelasting"@nl;
  skos:scopeNote "De opgelegde drukkracht door lucht in beweging die wordt ondersteund door een structuur of lichaam. (AAT)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f1f7b42b-7a42-41a9-805a-ddc3f2a1d43f>
  a skos:Concept;
  skos:prefLabel "midden in de hoek"@nl;
  skos:scopeNote "Midden in de hoek verwijst naar een plaatsing of positie van een object, detail of element dat zich precies in het midden van een hoek bevindt. Dit kan van toepassing zijn in architecturale ontwerpen, kunstwerken of andere visuele composities."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d744a929-2f06-4ed4-8710-43cd695fe180>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f29943be-c18f-4061-a2c2-e78a6f2a607b>
  a skos:Concept;
  skos:prefLabel "ringvormig oor"@nl;
  skos:scopeNote "Een ringvormig oor is een handvat dat een volledige cirkel of ring vormt, wat een symmetrische en functionele grip biedt. Deze vorm is zowel decoratief als praktisch, vaak gebruikt in objecten waar een stevige en comfortabele grip vereist is."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b1e39c43-c749-45fa-b814-c293b5b5491d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f47a68f0-4a09-4709-9211-ea4323ba04b7>
  a skos:Concept;
  skos:prefLabel "wortelhout (fysiek kenmerk)"@nl;
  skos:scopeNote "Wortelhout is een houttekening in de vorm van vreemde uitwassen die voorkomt aan de basis van een boom, net boven de grond, maar ook daar waar de stam zich in takken verdeelt. Deze zogenoemde knollen zijn wortelhout. Men spreekt oook wel van voet- en luchtwortels. Op zo'n vreemde plaats groeien plotseling takken uit de stam. Wanneer men recht afzaagt, geeft dit een grillige tekening. Een geschilderde imitatie van wortelhout wordt ook wel arabiën genoemd. (Schilder- en Verfkunst, RV bijdrage 13, RDMZ/Sdu Uitgeverij Koninginnegracht, 1992. J. Berghuis jr., De Quintessentiële Academie Hout- en marmerimitaties)"@nl;
  skos:altLabel "wortelnoten (fysiek kenmerk)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9587b3e4-6c3b-499f-a99e-ac4af9fdb30f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f5c0da4a-a96e-4d39-ad50-602856dc85fa>
  a skos:Concept;
  skos:prefLabel "tolvormig"@nl;
  skos:scopeNote "Stolpvormig verwijst naar een vorm die lijkt op een stolp, met een ronde bovenkant die taps toeloopt naar een smallere basis. Deze vorm biedt zowel bescherming als een decoratief element, vaak toegepast in glazen en andere transparante objecten."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b1e39c43-c749-45fa-b814-c293b5b5491d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f6512223-d3ae-4aa5-9e4c-ffb818b58465>
  a skos:Concept;
  skos:prefLabel "snijwerk (patroon)"@nl;
  skos:scopeNote "Te gebruiken voor gesneden, geometrische patronen van lijnen die elkaar snijden, zowel doorboord als in reliëf; in de late 19e eeuw vooral toegepast op ajourwerk, waarbij patronen uit dunne stukjes hout werden gesneden met een figuurzaag. Gebruik 'meander (patronen)' voor soortgelijke patronen die door een doorlopende rand zijn begrensd. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f7151133-9060-47a8-8530-84fd851d9649>
  a skos:Concept;
  skos:prefLabel "vet (lettertype)"@nl;
  skos:scopeNote "Een dikkere versie lettertypen van dezelfde stijl. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f8ae20ee-ecb8-4766-8653-5d87cdd2af79>
  a skos:Concept;
  skos:prefLabel "afzettend"@nl;
  skos:scopeNote "Afgeschuind ondervlak of zijkant van een venster of deuropening, zodat de dag of opening in breedte toeneemt, zoals in de gotiek bijna alle neggen van portalen en vensters. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fb5d85a2-0f84-4f1c-8d2f-a7b6fc1c0dce>
  a skos:Concept;
  skos:prefLabel "staand (formaat)"@nl;
  skos:scopeNote "Formaat dat verticaal is vormgegeven en niet horizontaal bij het ontwerp van onder meer publicaties, documenten en foto's, waarbij de hoogte groter is dan de breedte. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b1e39c43-c749-45fa-b814-c293b5b5491d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fc09f704-33c4-4634-9bf0-940641738bf3>
  a skos:Concept;
