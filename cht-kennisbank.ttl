<https://data.cultureelerfgoed.nl/term/id/cht/ccf51484-b8c4-4ccd-9509-c2e1adf2a86d>
  a skos:Concept;
  skos:prefLabel "beemgronden"@nl;
  skos:scopeNote "Laaggelegen, nat hooi- en weiland, grenzend aan een waterloop en doorgaans gedurende natte perioden geheel of gedeeltelijk overstroomd. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2971af0-cde7-4888-b828-33443f702e7d>;
