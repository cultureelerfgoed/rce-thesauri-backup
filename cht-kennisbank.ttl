<https://data.cultureelerfgoed.nl/term/id/cht/17883340-4ce6-44c0-ae8d-84be614df516>
  a skos:Concept;
  skos:prefLabel "bovenliggende nokkenassen"@nl;
  skos:scopeNote "Nokkenas, die bovenop de cilinderkop gemonteerd is en de kleppen via klepstoters of tuimelaars bedient."@nl;
  skos:altLabel "bovenliggende nokkenas"@nl;
