<https://data.cultureelerfgoed.nl/term/id/cht/863c66a2-9467-465d-801d-3ef6ebfa6b3e>
  a skos:Concept;
  skos:prefLabel "occhio di pavone"@nl;
  skos:scopeNote "Een schelpmarmer dat meestal lichtpaars of roodachtig bruin is. De naam is Italiaans voor 'pauwenoog', als verwijzing naar de versteende oesterschelpen die op ogen lijken. Twee zuilen in de Biblioteca Apostolica Vaticana zijn van dit marmer gemaakt. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ca8b3672-a66b-4ee4-a628-cefcfab0ab7f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/86f4a8bc-9c90-43f6-9f6b-a5dd3c00fa63>
  a skos:Concept;
  skos:prefLabel "strokarton"@nl;
  skos:scopeNote "Karton gemaakt van stro, bepaalde grassoorten en ander papiermateriaal met weinig cellulose. (AAT-Ned)"@nl;
