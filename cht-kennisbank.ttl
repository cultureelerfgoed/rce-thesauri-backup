<https://data.cultureelerfgoed.nl/term/id/cht/7a9442c0-16c8-4f6a-904e-f0f1635a1d85>
  a skos:Concept;
  skos:prefLabel "kramen"@nl;
  skos:scopeNote "Aanduiding voor kleine en vaak tijdelijke bouwconstructies die opgesteld zijn voor het tonen of verkopen van handelswaar of het drijven van handel. (Van Dale)"@nl;
