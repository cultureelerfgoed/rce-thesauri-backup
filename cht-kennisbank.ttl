  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/04770e4f-1c11-40e7-a256-9de8c6d569c6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a376c90c-2146-4b0a-b8a3-89f14f013bd9>
  a skos:Concept;
  skos:prefLabel "Noord-Hollandse stolpen"@nl;
  skos:scopeNote "Noord-Hollandse stolpen zijn stolpen waarbij de darsdeuren aan de achterzijde naar het land zijn gericht. Het woongedeelte is naar de weg gericht. Dars en stalling liggen evenwijding aan elkaar. De Noordhollandse stolp komt voor in een Noord-Holland boven het IJ met uitzondering van Westfriesland."@nl;
  skos:altLabel "normaalstelp"@nl, "normaalstelpen"@nl, "normaalstolp"@nl, "normaalstolpen"@nl,
    "Noord-Hollands type"@nl, "Noord-Hollands typen"@nl, "Noord-Hollandse stelp"@nl, "Noord-Hollandse stelpen"@nl,
    "Noord-Hollandse stolp"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4e1f25d9-b5cc-4169-b5ca-954f56a2ccd2>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/fceecae1-5f38-4516-b1e2-c1b519ea6cce>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a5c38758-0176-4773-a60c-3041c537e24d>
  a skos:Concept;
  skos:prefLabel "half verharde wegen"@nl;
  skos:scopeNote "Een weg waarop de verharding slechts gedeeltelijk is aangebracht (als twee banen met klinkers, beton, tegels,etc.) of het rijvlak is verbeterd met grind of sintels. (BRT)"@nl;
  skos:altLabel "half verharde weg"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1e309e1c-16cd-4b46-8cc6-1e5888853e49>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/9f307c55-8b72-43ef-9666-a5246ab5edd3>
  a skos:Concept;
  skos:prefLabel "vijzelmolens"@nl;
  skos:scopeNote "Vijzelmolens zijn industriemolens die werden gebruikt voor het fijnmalen of verpulveren van grondstoffen zoals specerijen, zouten, of mineralen. De vijzel, een zware stamper, werd aangedreven door wind- of waterkracht en was in staat om harde materialen tot een poeder of pasta te verwerken. Vijzelmolens speelden een cruciale rol in de productie van voedingsmiddelen, medicijnen, en andere producten die een fijne consistentie vereisten."@nl;
  skos:altLabel "vijzelmolen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6654db8a-3424-4bf3-bfd8-0490ce52b8ae>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/def9f720-699d-4d0d-8dfb-4791aeb2880a>
  a skos:Concept;
  skos:prefLabel "schepradgemalen"@nl;
  skos:scopeNote "Schepradgemalen maken gebruik van een scheprad om water te verplaatsen. Dit type gemaal, dat al in de middeleeuwen werd gebruikt, is een van de oudste technieken voor het pompen van water uit polders en was een voorloper van modernere gemalen."@nl;
  skos:altLabel "schepradgemaal"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/63e3cea6-22d0-4d8a-b79b-2b8c3d049587>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ed8754da-cc1d-4656-987e-2ed4838e2b9c>
  a skos:Concept;
  skos:prefLabel "tussenvloeren"@nl;
  skos:scopeNote "Tussenvloeren zijn al dan niet vrijdragende vloeren die geplaatst wordt tussen twee etagevloeren, en die veel wordt toegepast in een hoge ruimte voor het creëren van extra vloeroppervlakte. Vaak bestrijkt de tussenvloer niet het gehele vloeroppervlak van een gebouw, maar is het meer een soort balkon. In dat geval wordt de vloer doorgaans niet meegeteld bij de etagenummering. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "entresol"@nl, "entresols"@nl, "insteekverdieping"@nl, "insteekverdiepingen"@nl,
    "mezzanino"@nl, "mezzanino's"@nl, "tussenverdieping"@nl, "tussenverdiepingen"@nl,
    "tussenvloer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/3bf64cd9-cf95-4482-9e31-6069991467df>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/96c0bfab-b28c-476b-9900-b5a12fc790b2>
  a skos:Concept;
  skos:prefLabel "daglicht"@nl;
  skos:scopeNote "Daglicht voor de belichting van een object is licht van buiten dat gewoonlijk wordt gereflecteerd of gefilterd door middel van neutraal gekleurd materiaal."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/54825595-88aa-4f30-ac19-c5fc288f8de2>;
