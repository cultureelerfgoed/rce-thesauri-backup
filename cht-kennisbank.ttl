<https://data.cultureelerfgoed.nl/term/id/cht/11eb8d07-9a43-4008-bbe4-f79e75f07d4b>
  a skos:Concept;
  skos:prefLabel "kabeltrams"@nl;
  skos:scopeNote "Een kabeltram is een tram die zich op rails voortbeweegt, voortgetrokken door een kabel onder het wegdek."@nl;
  skos:altLabel "kabeltram"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b12f2ba0-ea54-4e6a-b6ba-e5c01453e1d3>;
