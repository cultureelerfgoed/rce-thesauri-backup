<https://data.cultureelerfgoed.nl/term/id/cht/efb6ba26-c5cc-4a83-9f6f-7cd4e3da57c3>
  a skos:Concept;
  skos:prefLabel "hertogdomgrenspalen"@nl;
  skos:scopeNote "Hertogdomgrenspalen zijn historische grenspalen die grenzen tussen voormalige hertogdommen markeren. (Grenspalen in Nederland / T. Brouwer, Zutphen 1978)"@nl;
  skos:altLabel "hertogdomgrenspaal"@nl;
