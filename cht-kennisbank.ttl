<https://data.cultureelerfgoed.nl/term/id/cht/df7e6a56-926d-4c6d-889d-8db1dccea800>
  a skos:Concept;
  skos:prefLabel "Missouri marmer"@nl;
  skos:scopeNote "Een witte tot lichtgrijze marmersoort met een blauwe of grijze tint. Het is grofkorrelig en bevat enkele stylolieten. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e0c2bbee-a647-4e27-b8f0-1cd464f38c61>
  a skos:Concept;
  skos:prefLabel "Siena marmer"@nl;
  skos:scopeNote "Marmer met een gele en geelbruine kleur dat wordt gedolven in de omgeving van Siena in Italië; het marmer is van oudsher gewild als materiaal voor binnenhuisarchitectuur; dit type marmer is compact en vaak gefragmenteerd (precies), met een wasachtige glans. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e1332ca7-02d7-4124-a7c0-0ce133de48a9>
  a skos:Concept;
  skos:prefLabel "thasisch marmer"@nl;
  skos:scopeNote "Een witte marmersoort met blauwige nuances, afkomstig van het eiland Thasos in de Egeïsche Zee. Het heeft een compacte textuur en glinsterende kristallen. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e4859418-2287-476d-9f74-0e18404b4ec3>
  a skos:Concept;
  skos:prefLabel "portoro"@nl;
  skos:scopeNote "portoro: marmer welke gewonnen wordt nabij La Spezia, Italië. De steen heeft een zwarte ondergrond met fijne tot grove, goudkleurige respectievelijk witte gekleurde aders."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e50329ae-b568-40e7-a8b0-3eaa5a2dac84>
  a skos:Concept;
  skos:prefLabel "cristallino"@nl;
  skos:scopeNote "Verzamelnaam voor bijna alle grof kristallijne marmers, o.a. uit Italië, Griekenland, Portugal en Zwitserland. Kleur helder wit, grijs gestreept of gewolkt tot donkerblauw met groene vlekken. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e6b8f499-e606-4e23-baf8-11d02ea1350c>
  a skos:Concept;
  skos:prefLabel "Istrisch marmer"@nl;
  skos:scopeNote "Een vaalgeel marmer met grote aders dat wordt gewonnen in Istrië in de Adriatische Zee en op sommige Dalmatische eilanden. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e7429af5-30ea-4899-be59-f0bcc1dc75c0>
  a skos:Concept;
  skos:prefLabel "wit Cherokee marmer"@nl;
  skos:scopeNote "Een witte marmersoort met zwarte en grijze vlekken, afkomstig uit Pickens County in Georgia. Het is grover van structuur dan wit marmer uit Vermont. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e87dd225-7585-4692-8b85-975378ecb67f>
  a skos:Concept;
  skos:prefLabel "cipollino"@nl;
  skos:scopeNote "cipollino: marmer welke gewonnen wordt in de Apennijnen bij Versilia, Italië. De steen is licht- tot donkergroen van kleur met lichtgrijze tot witte vlekken. Rechtlijnig grijs tot zwart geaderd, als de schillen van een ui (It.:cipolla), en gewolkt. Het breukvlak is grofkorrelig."@nl;
  skos:altLabel "cipollino versilia"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e9b48be7-be3d-4687-b666-8df8a2c2f534>
  a skos:Concept;
  skos:prefLabel "cottanello"@nl;
  skos:scopeNote "De aanduiding voor een aantal Italiaanse marmersoorten, die meestal diverse tinten en patronen in rood en bruin hebben, hoewel soms ook andere kleuren zoals wit en paars aanwezig zijn. De moderne soorten zijn grof en worden vaak niet mooi gevonden, maar de oude Romeinen dolven cottanello van zeer hoge kwaliteit op ongeveer 60 kilometer van Rome in de Sabijnse heuvels, in de buurt van de plaats waarnaar het marmer is genoemd. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ed3c4733-aaa1-4392-b2c7-5b6159c3f8ec>
  a skos:Concept;
  skos:prefLabel "Proconnesisch marmer"@nl;
  skos:scopeNote "Een ruw, bont geschakeerd marmer, gedolven op het eiland Proconnesus (het tegenwoordige Turkse eiland Marmara Adasi), dat grijs, wit of wit met grijze strepen is. Grote hoeveelheden van dit marmer werden geïmporteerd in Griekenland en tot sarcofagen gehakt. Ook Cyzicaans marmer genoemd, omdat het zeer veel werd gebruikt in Cyzicus, het huidige Belkis. Het werd ook zeer veel gebruikt in Constantinopel. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ef5ad90a-4a31-44f6-9df7-6b73e254ed79>
  a skos:Concept;
  skos:prefLabel "rosso antico"@nl;
  skos:scopeNote "Rosso antico: marmer welke gewonnen wordt nabij Genua, Italië. De steen is donkerrood van kleur met fijne tot grove witte en zwarte aderen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f25346af-af6d-4a1d-a2d7-e86f6fc54fc8>
  a skos:Concept;
  skos:prefLabel "Lyonaise marmer"@nl;
  skos:scopeNote "Handelsnaam voor een grofgevlekt marmer uit Mallets Bay bij Lake Champlain in de Verenigde Staten. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f308f772-af85-40f5-955d-90c40e9beee2>
  a skos:Concept;
  skos:prefLabel "bigio antico"@nl;
  skos:scopeNote "Marmer dat licht- en donkergrijs is, in grote patronen. Het is doorgaans afkomstig uit Noord-Afrika. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f6cb6eee-c7b1-4d79-a16d-1ba6908ccdd6>
  a skos:Concept;
  skos:prefLabel "Tabrez marmer"@nl;
  skos:scopeNote "Onyx-marmer dat wordt gewonnen in de omgeving van Tabriz in noordwestelijk Iran. Het wordt voornamelijk gebruikt als bouwsteen. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
