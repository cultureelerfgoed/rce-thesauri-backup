<https://data.cultureelerfgoed.nl/term/id/cht/33ddad90-a891-4ac0-9132-740d201331f9>
  a skos:Concept;
  skos:prefLabel "locomotoren"@nl;
  skos:scopeNote "De Sik is een voornamelijk door Werkspoor gebouwde locomotor die bij de Nederlandse Spoorwegen veel werd gebruikt voor het rangeren met goederenwagens. Ook op verschillende particuliere bedrijfsterreinen waren deze locomotoren in gebruik."@nl;
  skos:altLabel "locomotor"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7ad31105-4636-4f60-bdde-8e201cfddeb6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/35b334e7-2a4e-46dd-8e8a-7550f282c226>
  a skos:Concept;
  skos:prefLabel "vuurloze locomotieven"@nl;
  skos:scopeNote "Een vuurloze locomotief is een stoomlocomotief die bestemd is voor plaatsen waar vuur en rook gevaarlijk of ongewenst zijn, bijvoorbeeld in kolenmijnen."@nl;
  skos:altLabel "vuurloze locomotief"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7ad31105-4636-4f60-bdde-8e201cfddeb6>;
