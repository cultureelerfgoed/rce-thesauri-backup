<https://data.cultureelerfgoed.nl/term/id/cht/1e52ece3-c6d0-4e8f-b6cb-c9affd92904a>
  a skos:Concept;
  skos:prefLabel "bonte knaagkever"@nl;
  skos:scopeNote "De bonte knaagkever (Xestobium rufovillosum) is een kever uit de familie klopkevers (Anobiidae). Andere namen zijn bonte klopkever of grote houtwormkever. (Wikipedia)"@nl;
  skos:altLabel "bonte klopkever"@nl, "grote houtwormkever"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/78672fa4-8815-4427-995e-21a2cc90bd39>;
