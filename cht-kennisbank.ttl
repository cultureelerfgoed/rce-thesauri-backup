<https://data.cultureelerfgoed.nl/term/id/cht/06dafcdb-70c6-4a1e-9966-426c63bf430e>
  a skos:Concept;
  skos:prefLabel "duikers (nagel)"@nl;
  skos:scopeNote "Slappe nagel of spijker, nogal taps. De kop wordt geheel weggeslagen. Toegepast o.a. bij te schilderen werk. De lengte en het gewicht werden aangepast aan de overeenkomstige nagels of spijkers. (Haslinghuis)"@nl;
  skos:altLabel "duiker (nagel)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6f8bf719-083b-482e-bc3d-85e91fbabcdf>;
