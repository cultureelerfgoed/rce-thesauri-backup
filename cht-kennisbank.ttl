<https://data.cultureelerfgoed.nl/term/id/cht/f70e422a-e9fc-4215-8de3-6926858557b3>
  a skos:Concept;
  skos:prefLabel "bouleuterionen"@nl;
  skos:scopeNote "Bestuursgebouw in een antieke Griekse stad, meestal gelegen aan de agora. (Haslinghuis)"@nl;
  skos:altLabel "bouleuterion"@nl;
