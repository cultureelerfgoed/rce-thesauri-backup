  skos:scopeNote "Zegenformule voor een gelovige, afkomstig van de paus. Het papier is voorzien van een afbeelding of foto van de paus en kleurrijke versieringen."@nl;
  skos:altLabel "apostolische zegenprent"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26b0d61a-e37a-4912-b516-48884f251bc6>;
