<https://data.cultureelerfgoed.nl/term/id/cht/b796e428-c3e8-4b25-a22b-fa2db980b083>
  a skos:Concept;
  skos:prefLabel "getrapte wegen"@nl;
  skos:scopeNote "Houten buitenwand ( weeg) waarvan de horizontale delen gepotdekseld zijn. potdekselen. (Haslinghuis)"@nl;
