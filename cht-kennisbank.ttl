  a skos:Concept;
  skos:prefLabel "connaat water"@nl;
  skos:scopeNote "Connaat water verwijst naar water dat gevangen zit in poreuze gesteenten of sedimenten, vaak gebruikt in geologische en hydrologische studies."@nl;
