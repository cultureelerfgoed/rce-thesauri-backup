<https://data.cultureelerfgoed.nl/term/id/cht/1939d21f-e4c3-4d4f-a124-7bbc5be34568>
  a skos:Concept;
  skos:prefLabel "zoggen"@nl;
  skos:scopeNote "1. Houten gaffel, die voor en achter aan het schip de steven steunt. De rij inhouten begint en eindigt met een zog ; 2. De plaats waar het vlak van een schip achter begint te rijzen en de scherpte der piek begint."@nl;
  skos:altLabel "zog"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/77f91bd1-4367-448a-903c-da826fa40e88>;
