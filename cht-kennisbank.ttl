<https://data.cultureelerfgoed.nl/term/id/cht/b9e0f7f9-2a55-40a5-addd-7b99b5332c51>
  a skos:Concept;
  skos:prefLabel "claimlijsten"@nl;
  skos:scopeNote "Claimlijsten zijn documenten waarin de eisen of claims van een persoon of organisatie worden vastgelegd, vaak in juridische of zakelijke contexten."@nl;
  skos:altLabel "claimlijst"@nl;
