  a skos:Concept;
  skos:prefLabel "basterd-cementmortel"@nl;
  skos:scopeNote "Basterd-cementmortel is een type basterdmortel waarin cement is toegevoegd om de sterkte en duurzaamheid te vergroten, veelal gebruikt in bouw- en restauratieprojecten."@nl;
