<https://data.cultureelerfgoed.nl/term/id/cht/f986f3fd-4933-455f-8f9d-70ff8a414fb5>
  a skos:Concept;
  skos:prefLabel "schommelvoorvorken"@nl;
  skos:scopeNote "Een schommelvoorvork (of schommelvork) is een voorvork van een motorfiets waarbij het voorwiel via twee scharnierende stangen aan de vork zelf bevestigd is."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2695f9cf-e414-4bf8-a4cb-4862e8577d2b>;
