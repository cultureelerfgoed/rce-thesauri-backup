<https://data.cultureelerfgoed.nl/term/id/cht/6d3da907-84f3-4719-af31-f5682b48bc36>
  a skos:Concept;
  skos:prefLabel "meelspuiten"@nl;
  skos:scopeNote "Spuit voor het met meel bestuiven van brood en broodjes. Bestaande uit een houten staaf passend in een metalen huls met afneembare kop waarin een plaat met gaatjes zit. (MARDOC)"@nl;
  skos:altLabel "meelspuit"@nl;
