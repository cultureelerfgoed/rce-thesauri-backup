<https://data.cultureelerfgoed.nl/term/id/cht/7e1e10f2-d1f8-4c61-af5b-543caaa4fc80>
  a skos:Concept;
  skos:prefLabel "microchemische analyse"@nl;
  skos:scopeNote "Een microchemische test is een natchemische identificatiereactie op microschaal op een bepaalde component . De test wordt gedaan met een druppel van de testoplossing op een voorwerp of een monstertje."@nl;
  skos:altLabel "microchemische test"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
