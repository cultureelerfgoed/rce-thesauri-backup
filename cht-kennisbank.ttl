  a skos:Concept;
  skos:prefLabel "takelingen (touw)"@nl;
  skos:scopeNote "Dun touw om eind van een tamp, bijv. zwichtlijn, om uitrafelen te voorkomen. Een benaaide takeling wordt toegepast op kunstvezeltouw. (Molenwoordenboek B.D. Poppen)"@nl,
