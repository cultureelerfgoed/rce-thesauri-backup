<https://data.cultureelerfgoed.nl/term/id/cht/c9f02e02-6271-4408-aefa-0afd35ae6113>
  a skos:Concept;
  skos:prefLabel "relieken"@nl;
  skos:scopeNote "Relieken zijn voorwerpen die vereerd worden vanwege hun fysieke relatie met Christus, Maria, heiligen, martelaren of andere vereerde personen. Het gaat om lichamelijke resten, voorwerpen die zij gebruikten of droegen, of zaken waarmee zij in aanraking kwamen, zoals kledingstukken, kruisfragmenten of persoonlijke bezittingen. Ook fragmenten afkomstig van heilige plaatsen worden als relieken beschouwd."@nl;
  skos:altLabel "relikwieën"@nl, "reliek"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/abfc1bb7-04d7-43a0-9e99-dd4c5a4f2c15>;
