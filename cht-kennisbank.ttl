  a skos:Concept;
  skos:prefLabel "staatsieponen"@nl;
  skos:scopeNote "Ponen waarbij het naar binnen vallend boeisel op het achterschip niet naar de steven toebuigt maar over het berghout naar achteren schiet tot op gelijke hoogte met de achterkant van de steven. (MARDOC)"@nl;
  skos:altLabel "staatsiepoon"@nl;
