<https://data.cultureelerfgoed.nl/term/id/cht/7f789d02-9066-41c9-957c-08d43b167555>
  a skos:Concept;
  skos:prefLabel "soft enduro motorfietsen"@nl;
  skos:scopeNote "Een Soft Enduro is een teruggetunede Enduromotor, geschikt gemaakt voor gebruik op de openbare weg."@nl;
