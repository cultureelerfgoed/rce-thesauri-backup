<https://data.cultureelerfgoed.nl/term/id/cht/c6845182-418e-47d2-b14d-7592a153d8cb>
  a skos:Concept;
  skos:prefLabel "doofstommeninstituten"@nl;
  skos:scopeNote "Doofstommeninstituten zijn zorg- en onderwijsinstelling voor doven, slechthorenden en doofblinden, die vanaf midden 19e eeuw werden opgericht door kloosterorden. De instituten hadden naast de onderwijsfunctie ook internaatfunctie. In de loop der tijd is de verblijfsfunctie verdwenen."@nl;
  skos:altLabel "doofstommeninstituut"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7d637918-2d8b-4d8b-8fba-2ad9546fc879>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/83df36f1-8328-41fb-be2e-2be90ae6e097>
  a skos:Concept;
  skos:prefLabel "touwbanen"@nl;
  skos:scopeNote "Lange, meestal smalle gebouwen of ruimten waarin touwen worden gemaakt, meestal door vezels tot draden te spinnen, draden tot strengen te draaien en drie of meer strengen samen te draaien tot touw. (AAT-Ned)"@nl;
