<https://data.cultureelerfgoed.nl/term/id/cht/b675f707-2983-404c-8c09-0055b906b750>
  a skos:Concept;
  skos:prefLabel "wilgenbomen"@nl;
  skos:scopeNote "Geslacht van bomen en heesters (Salix) uit de wilgenfamilie met zeer buigzame takken die veel voor bindrijs vlechtwerk en hoephout gebruikt worden; de bladeren zijn smal ovaal tot lijnvormig en de bloeiwijzen katjes. (MARDOC)"@nl;
