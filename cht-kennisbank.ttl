<https://data.cultureelerfgoed.nl/term/id/cht/a60dda61-7b65-4f45-9e2d-9bb5163d9111>
  a skos:Concept;
  skos:prefLabel "architectonische conservering"@nl;
  skos:scopeNote "Met architectonische conservering beoogt men het behoud op lange termijn van historische gebouwen, monumenten en stads- en dorpsgezichten."@nl;
