<https://data.cultureelerfgoed.nl/term/id/cht/8da298ba-4efe-4b99-9126-9716ce43df22>
  a skos:Concept;
  skos:prefLabel "aardbevingsrisico's"@nl;
  skos:scopeNote "De kans op door aardbevingen veroorzaakte schade (aan mensen, gebouwen, infrastructuur, productie)."@nl;
