<https://data.cultureelerfgoed.nl/term/id/cht/f65b24f9-4428-4989-b798-0ce0ec5a1726>
  a skos:Concept;
  skos:prefLabel "altaarantependia"@nl;
  skos:scopeNote "Antependium voor het altaar. Uit kostbare stoffen samengesteld of geschilderd. Verwisselbaar naar gelang de liturgische kleurvoorschriften. Wordt vooral gebruikt bij kastaltaren en niet bij uitgesproken versierde altaarfronten. Antependia kunnen ter bewaring en bescherming in een antependiumkast worden geschoven. (Religieus Erfgoedthesaurus)"@nl;
  skos:altLabel "altaarantependium"@nl, "altaarvoorzet"@nl, "altaarvoorzetten"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/43c8f896-eb92-4a0c-853e-ef49d78cd8ea>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/2e54b634-49d9-47f9-9fdc-148be51c6156>;
