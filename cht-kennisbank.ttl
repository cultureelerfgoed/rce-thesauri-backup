<https://data.cultureelerfgoed.nl/term/id/cht/6b943773-1773-4a53-ad08-108893a52a6f>
  a skos:Concept;
  skos:prefLabel "achtcilinder motoren"@nl;
  skos:scopeNote "Een achtcilindermotor is een motor opgebouwd rond 8 cilinders. Die zijn veelal in V vorm uitgevoerd."@nl;
  skos:altLabel "achtcilinder motor"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/44ac60de-195d-45b2-8cf8-a46deb19ef7f>;
