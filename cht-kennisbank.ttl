<https://data.cultureelerfgoed.nl/term/id/cht/931c38ee-dc01-4e61-8b93-6b2613088cbe>
  a skos:Concept;
  skos:prefLabel "takelagen"@nl;
  skos:scopeNote "Naar men zegt had de term oorspronkelijk betrekking op de gehele uitrusting van het schip. Er zijn echter ook bronnen, die er de tuigage, echter zonder de zeilen, onder verstaan. Een derde groep ziet in takelage een verwijzing naar de term takel en gaat er vanuit dat alleen al het lopende en staande want te samen takelage genoemd wordt. (De Binnenvaart)"@nl;
  skos:altLabel "takelage"@nl, "takeling"@nl, "takelingen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/77f91bd1-4367-448a-903c-da826fa40e88>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/9352e09d-a261-4ef5-9bf5-d5b578d7d7fd>
  a skos:Concept;
