<https://data.cultureelerfgoed.nl/term/id/cht/1d2924bd-c936-45c5-ac55-896c26ba17d1>
  a skos:Concept;
  skos:prefLabel "loden (meten)"@nl;
  skos:scopeNote "Meten van de waterdiepte ter plaatse door middel van echolood, handlood, daggaard of lodingmachine. (MARDOC)"@nl;
