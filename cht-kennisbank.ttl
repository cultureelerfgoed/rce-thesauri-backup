  a skos:Concept;
  skos:prefLabel "fabriekspoorten"@nl;
  skos:scopeNote "Fabriekspoorten zijn de hoofdingangen van fabrieken, vaak monumentaal uitgevoerd en symbolisch voor de industriële macht en toegang tot de werkplaats."@nl;
