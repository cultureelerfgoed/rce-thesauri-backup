<https://data.cultureelerfgoed.nl/term/id/cht/28dc6b40-37f5-4a9c-934a-9571e5448bec>
  a skos:Concept;
  skos:prefLabel "Nerva-hout"@nl;
  skos:scopeNote "Nerva-hout is naaldhout dat is uitgevoerd via Narva in Letland aan de Finse Golf. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/357008a8-6eb7-43a9-b0aa-6a4be4a5e905>
  a skos:Concept;
  skos:prefLabel "opus"@nl;
  skos:scopeNote "Opus is ambachtelijk werk, techniek. Het is een nadere aanduiding van wijzen van steenzetting (metselwerk) zoals door de Romeinen gebruikt: opus incertum, opus quadratum, opus caementicum, opus isodomon, opus reticulatum, opus spcatum, opus mixtum. Daarnaast zijn er nog een aantal die niet van Romeinse oorsprong zijn: opus scotium, opus gallicum, opus alexandrinum, opus sectile, opus tessellatum, opus vermiculatum, opus musivum. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d0351025-0184-4b29-afac-3ceb07eedb21>
  a skos:Concept;
  skos:prefLabel "formen (mal)"@nl;
  skos:scopeNote "Mal, berd. (Haslinghuis)"@nl;
  skos:altLabel "form (mal)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
