<https://data.cultureelerfgoed.nl/term/id/cht/75db6398-f4e9-4a49-b31b-9287113a31cb>
  a skos:Concept;
  skos:prefLabel "belichtingsdosis"@nl;
  skos:scopeNote "De belichtingsdosis is de hoeveelheid lichtenergie die per tijdseenheid op een bepaald oppervlak valt vermenigvuldigd met de duur van belichting, uitgedrukt in lux.uur (lx.h) of bij grote getallen in klx.h (k=kilo=1.000) of Mlx.h (M=mega=1.000.000)."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/929f2b49-e558-4543-a710-41a893c3c5dd>;
