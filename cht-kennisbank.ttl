<https://data.cultureelerfgoed.nl/term/id/cht/a94cf256-3fef-4d45-b737-adc6c7083017>
  a skos:Concept;
  skos:prefLabel "dierenparken"@nl;
  skos:scopeNote "Dierenparken zijn parken waarin onder geconditioneerde voorwaarden en zorg één of meerdere soorten dieren vrij rondlopen. Deze parken zijn ter lering en vermaak. Sommige dierenparken zoals bizonparken en vogelparken komen nog maar weinig voor of zijn zelfs verdwenen."@nl;
  skos:altLabel "dierenpark"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7520120b-22f5-48ff-b6b3-ad570638cf17>;
