<https://data.cultureelerfgoed.nl/term/id/cht/02f97678-d3f2-4868-a516-6f785787e253>
  a skos:Concept;
  skos:prefLabel "mycena"@nl;
  skos:scopeNote "Mycena is een geslacht van schimmels dat behoort tot de plaatjeszwammen (Agaricales). Het geslacht omvat soorten met middelgrote tot kleine paddenstoelen. Ze hebben een kegel- tot klokvormige hoed met vaak gevoorde, rechte rand, die bij het rijper worden niet naar binnen omkrult. De steel is dun en heeft geen manchet. Sommige soorten hebben melksapbuizen in de steel waardoor bij doorbreken een wit of rood sap naar buiten komt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4113903c-246d-43fa-891c-f9f7a65b4e12>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ebdcedb4-d7cc-418a-85f3-cf9626d1672b>
  a skos:Concept;
  skos:prefLabel "koppenlagen"@nl;
  skos:scopeNote "Koppenlagen zijn lagen metselwerk in baksteen waarbij alleen koppen in het zicht zijn. (Haslinghuis)"@nl;
  skos:altLabel "koppenlaag"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fb082808-4325-49b6-a068-ec7e4ed1a887>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/dd730d5c-3740-44ac-a84b-b046b17714d2>
  a skos:Concept;
  skos:prefLabel "lokalen"@nl;
  skos:scopeNote "Groot vertrek, niet voor bewoning bestemd maar voor vergaderingen, onderricht, kantoren, verkopingen e.d.. Daarom zakelijk ingericht. (Haslinghuis)"@nl;
  skos:altLabel "lokaal"@nl;
