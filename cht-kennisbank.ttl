<https://data.cultureelerfgoed.nl/term/id/cht/9ab83b68-932e-4af0-ab32-763d327c9f08>
  a skos:Concept;
  skos:prefLabel "hotchkiss-aandrijvingen"@nl;
  skos:scopeNote "Achterwielophanging waarbij de halfelleptische bladveren de reactie van het aandrijfkoppel opnemen."@nl;
