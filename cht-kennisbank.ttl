  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/37115140-d958-4156-92f4-b87cc9388e4b>
  a skos:Concept;
  skos:prefLabel "glasbatist"@nl;
  skos:scopeNote "Glasbatist is een fijn geweven, doorzichtig textiel gemaakt van glasvezel, vaak gebruikt voor lichtgewicht, decoratieve toepassingen zoals gordijnen en voeringen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2035cba8-d10c-47a5-b10f-2a5295a396b2>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/203a512c-2a95-45df-aadb-f8772b5260b2>
  a skos:Concept;
  skos:prefLabel "blazen (schadefenomeen)"@nl;
  skos:scopeNote "Blazen zijn schadefenomenen aan verschillende materialen zoals verflagen en worden hoofdzakelijk veroorzaakt door een sterke wisseling in temperatuur en relatieve vochtigheid of blootstelling aan hoge temperaturen en hoge relatieve vochtigheid, zoals ophopingen van vocht in de houtporiën en oplosmiddelen of onvoldoende onderlinge binding. Hierbij ontstaan opbollingen van de verflaag in de vorm van belletjes. Een regelmatig voorkomend voorbeeld zijn blazen bij huisschilderwerk op hardhout. (Handboek voor het restaureren van schilderijen / Knut, N., Busch, J., 1999)"@nl;
  skos:altLabel "blaas (schadefenomeen)"@nl, "blaasjes"@nl, "blaasvorming"@nl, "blaren"@nl,
    "brandblaren"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/19a4249c-f03b-4c4c-9806-45c04fb0bceb>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/203a8b3d-c785-4ba0-a501-108c2d38fe99>
  a skos:Concept;
  skos:prefLabel "verdonkering"@nl;
  skos:scopeNote "Verdonkering is een schadefenomeen waarbij de kleur van de verflaag of de vernislaag donkerder wordt. Dit kan een normaal ouderdomsverschijnsel zijn, door de verandering in de scheikundige samenstelling van de gebruikte materialen. (Schilderijen restaureren: beoordelen, restaureren, conserveren / Emile-Mâle, G., 1976)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/19a4249c-f03b-4c4c-9806-45c04fb0bceb>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/28f2bf90-70c4-4d25-81fe-2162b392a25f>
  a skos:Concept;
  skos:prefLabel "gewelfd deksel, ln het midden opgestulpt vlamvormige knop"@nl;
  skos:scopeNote "Dit gewelfde deksel heeft een opgestulpt midden, wat betekent dat het middenstuk omhoog is geduwd, met een vlamvormige knop erop. Deze knop voegt een sierlijk en symbolisch element toe aan het deksel."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/8d6b3fe8-d27c-4f23-9e4b-483e5ac1b6e2>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2047d017-8fa6-464d-ad69-33a0524cde64>
  a skos:Concept;
  skos:prefLabel "incrustatie (uitholling)"@nl;
  skos:scopeNote "Inlegwerk, uitdieping of uitholling van de ondergrond, meestal metaal of hout. Het werk van de (zie) Cosmaten is als incrustatie te beschouwen. Ook wordt eronder verstaan bekleding van een muur of vloer met een hard, kostbaar materiaal zoals marmer, albast, majolicategels ( (zie) mozaïek), gebed in kalk, gips e.d., liefst in geometrische patronen. Incrustatie was zeer geliefd in de Byzantijnse en daarna in de Moorse kunst (de (zie) azulejos van Alhambra in Granada, Alcazar in Sevilla enz.) en in de Italiaanse renaissance (Battisterio van Florence, Dogenpaleis te Venetië). (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/df4db7b4-3b69-49a2-9068-13034f1a068f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/204beea3-da95-44bd-ad80-ed3228c714bf>
  a skos:Concept;
  skos:prefLabel "waterbouwkundigen"@nl;
  skos:scopeNote "Waterbouwkundigen ontwerpen en beheren waterwerken zoals dijken, sluizen of havens. Ze combineren techniek met inzicht in stroming, bodem en klimaat."@nl;
  skos:altLabel "waterbouwkundige"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db4a7619-d236-4b14-8e79-b4a6e890f677>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/204ed7dc-2051-4072-b96e-fa23afb539de>
  a skos:Concept;
  skos:prefLabel "verbanddozen"@nl;
  skos:scopeNote "Een verbanddoos is een opbergdoos met EHBO-middelen zoals pleisters, verband, scharen en ontsmettingsmiddelen."@nl;
  skos:altLabel "verbanddoos"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/44872c69-2b39-4667-88a7-9500b45b65c9>;
