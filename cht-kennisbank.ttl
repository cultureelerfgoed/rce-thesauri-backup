<https://data.cultureelerfgoed.nl/term/id/cht/760d394d-4049-4db5-b6c0-2d81ae01e122>
  a skos:Concept;
  skos:prefLabel "theorielokalen"@nl;
  skos:scopeNote "Theorielokalen zijn kokalen waar theoretisch onderwijs wordt gegeven. Bij ambachts- of technische scholen betrof het met name tekenzalen, natuurkunde en scheikunde. Bij het toenemen van theoretische vakken binnen het ambachts- en technisch onderwijs werd na 1945 het Algemeen Vormend Onderwijs ingevoerd. De zogenaamde AVO vakken bestonden naast de reeds genoemde vakken uit nederlands en buitenlandse talen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "theorielokaal"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7b0c45f2-dbb0-45f7-a1db-b8f9b753ec89>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e4cdd551-4f8c-45fb-bb6a-f652e9007843>
  a skos:Concept;
