<https://data.cultureelerfgoed.nl/term/id/cht/5001664d-3b46-4cb0-ae52-9e5cf50bdb4c>
  a skos:Concept;
  skos:prefLabel "schuifdakwagens"@nl;
  skos:scopeNote "Een schuifdakwagen is een goederenwagon waar bij het dak uit een schuifdak bestaat. Hierdoor kan bv stukgoederen of los gestorte goederen (graan, kolen) worden geladen. De lading is hierdoor beschermd tegen de weersinvloeden."@nl;
  skos:altLabel "schuifdakwagen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/feb50453-4925-49d0-a20e-39d63bed2a0f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/50212356-b029-4a08-a646-f3b6172e8f92>
  a skos:Concept;
  skos:prefLabel "sportquads"@nl;
  skos:scopeNote "Deze quads worden gebruikt als sportvoertuig. Door hun snelle motoren kunnen ze snel accelereren en hoge snelheden behalen."@nl;
  skos:altLabel "sportquad"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/041fd2f5-8e5b-4029-9284-0ae9ddb25a14>;
