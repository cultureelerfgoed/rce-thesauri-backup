<https://data.cultureelerfgoed.nl/term/id/cht/aca904f8-84d5-4bc7-8344-04754f39be08>
  a skos:Concept;
  skos:prefLabel "schrijfbehoefte"@nl;
  skos:scopeNote "Schrijfbehoefte is alles wat er tot schrijven nodig is, (papier, inkt, pennen enz.)."@nl;
