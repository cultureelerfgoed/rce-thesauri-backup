<https://data.cultureelerfgoed.nl/term/id/cht/337fde05-b874-4c6a-98ea-c356bfd21742>
  a skos:Concept;
  skos:prefLabel "coaches"@nl;
  skos:scopeNote "De stoelen in een rijtuig met middengang zijn zo geplaatst dat de reizigers allemaal dezelfde kant op kijken."@nl,
    "Een coach is een carrosserievorm voor een auto met twee portieren en een kofferdeksel waarbij het personengedeelte (meestal) niet vanuit de bagageruimte/kofferbak bereikt kan worden. De bagageruimteruimte is een afzonderlijke afgesloten kofferbak."@nl;
  skos:altLabel "coach"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0e8a6dfe-1280-4414-9a64-ca190bac648f>;
