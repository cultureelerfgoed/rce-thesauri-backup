  a skos:Concept;
  skos:prefLabel "wezels"@nl;
  skos:scopeNote "Klein, schuw roofdiertjes van de familie der marterachtigen ; kleiner dan de hermelijn, bruinrood van kleur met witte borst en buik. (MARDOC)"@nl;
