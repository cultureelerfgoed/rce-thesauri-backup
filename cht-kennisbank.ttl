  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a49925fa-b7a5-4664-9235-1a7e685322b5>
  a skos:Concept;
  skos:prefLabel "etagebomen"@nl;
  skos:scopeNote "Bomen waarvan alle gesteltakken in één horizontaal vlak of soms in meerdere horizontale vlakken worden geleid."@nl;
  skos:altLabel "etageboom"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7403e26d-cf33-4372-ad72-a2f9fcf8f63b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a7ddc935-9e1d-46eb-9da6-4c45f9d4b4f7>
  a skos:Concept;
  skos:prefLabel "sacristieën"@nl;
  skos:scopeNote "De sacristie, een ruimte of afzonderlijk gebouw verbonden aan een Rooms-Katholieke kerk, dient als bewaarplaats voor het liturgisch vaatwerk, het liturgisch textiel (de parament) en andere objecten. Tevens vervult het de functie van kleedkamer voor de celebrant en diens assistenten."@nl;
  skos:altLabel "gerfkamer"@nl, "gerfkamers"@nl, "sacristie"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1f045186-ba15-4937-a311-de50437f32d4>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d4820ed7-f9cf-4847-9b13-90edb9a9d3d4>
  a skos:Concept;
  skos:prefLabel "draaikruizen"@nl;
  skos:scopeNote "Draaikruizen worden geplaatst op zogenaamde duivelsroosters, gelegen in de toegang tot het kerkhof, in de vorm van een rechthoekige houten paal met daarop een draaibaar houten kruis bevestigd. Het kruis draaide met de zon mee. Hierdoor kon de duivel niet op het kerkhof komen om de heilige aarde te ontwijden. (Funerair Lexicon)"@nl;
  skos:altLabel "tourniquets"@nl, "draaikruis"@nl, "duivelskruis"@nl, "duivelskruizen"@nl,
    "tourniquet"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5d0e5e7e-9034-4fdc-8888-a2580cf24c48>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/46e540c8-e9a6-4709-acff-83a923656529>
  a skos:Concept;
  skos:prefLabel "loofgangen"@nl;
  skos:scopeNote "Paden waarbij aan beide zijden bomen staan, die aan de bovenzijdes met elkaar zijn verbonden en regelmatig geschoren worden, zodat een soort tunnels ontstaan."@nl;
  skos:altLabel "berceaus"@nl, "berceau"@nl, "charmille"@nl, "loofgang"@nl, "charmilles"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fe171968-b236-4a64-8728-c008d7d88700>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/23763f49-9101-42a0-a5f9-76e6278508db>
  a skos:Concept;
  skos:prefLabel "kiosken"@nl;
  skos:scopeNote "Een kiosk is een klein, vrijstaand gebouwtje. Dit kan een winkel zijn, zoals een krantenkiosk. (Wikipedia)"@nl;
  skos:altLabel "kiosk"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/10f47eb6-f1a9-465f-b8ab-8381925f039b>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/f82b0e92-9162-4bec-b52b-e8893d5b9b0c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/84b38cbc-3ab2-432a-8c7c-4987acd03f84>
  a skos:Concept;
  skos:prefLabel "landduinen"@nl;
  skos:scopeNote "Een landduin is een door de wind gevormde zandheuvel in het binnenland; duin in het binnenland."@nl;
  skos:altLabel "landduin"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/77479da0-22eb-4b7a-8bac-e2f6f4b9c620>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b207c500-1664-4549-a7ce-f2eb43f5b116>
  a skos:Concept;
  skos:prefLabel "meerpalen"@nl;
  skos:scopeNote "Een meerpaal c.q. dukdalf is een stevige, vrijstaande paal of paalconstructie in of langs het vaarwater. U gebruikt een meerpaal om een schip veilig vast te maken. De paal voorkomt ongewenste bewegingen en beschermt oevers, bruggen en sluizen tegen aanvaringsschade. Traditionele exemplaren bestaan uit hardhout zoals eiken. Moderne varianten gebruiken staal of composiet. De term dukdalf verwijst vaak naar een samenstelling van meerdere palen die als één constructie functioneren. In de praktijk lopen beide termen door elkaar, maar een dukdalf staat meestal in het water en een meerpaal kan ook aan de wal staan."@nl;
  skos:altLabel "dukdalven"@nl, "ducdalven"@nl, "dukdalf"@nl, "meerpaal"@nl, "ducdalf"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e9f07631-1f34-408d-a1cd-08cb80cf2023>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/5a7b2a79-1d79-45ab-9e2a-6c0286008101>
  a skos:Concept;
  skos:prefLabel "haarden"@nl;
  skos:scopeNote "Haarden zijn oorspronkelijk de geplaveide vloeren waar gestookt werd. Mogelijk vanaf de 15de eeuw duidde men met haard niet alleen de vuurplek aan maar ook de bijbehorende opbouw met rookvang. Mogelijk vanaf de 19de eeuw krijgt haard ook de betekenis van ijzeren kachel. In het verleden duidde men met haard soms ook het vertrek aan waarin gestookt werd. (Haslinghuis)"@nl;
  skos:altLabel "haardplaatsen"@nl, "haard"@nl, "haardplaats"@nl, "haerdt"@nl, "haert"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c69e25aa-d72e-4126-97ae-49f5ebb383ff>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/164697a2-1a28-4866-9b97-a538925897b5>
  a skos:Concept;
  skos:prefLabel "hekken (activiteit)"@nl;
  skos:scopeNote "De behekking van de einden met heklatten en zoomlatten."@nl;
  skos:altLabel "hek (activiteit)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/df4db7b4-3b69-49a2-9068-13034f1a068f>;
