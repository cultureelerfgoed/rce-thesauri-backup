<https://data.cultureelerfgoed.nl/term/id/cht/76464b1b-8cd4-4337-9def-a1a29e967acb>
  a skos:Concept;
  skos:prefLabel "wielflenzen"@nl;
  skos:scopeNote "Een flens is een opstaande rand aan treinwielen. De vorm van de rails (bol) en de geer (helling) van de wielen zorgen dat de trein gecentreerd wordt op het spoor. Flenzen zorgen voor extra bescherming en zijn zowel nodig bij bogen als beschadigde of versleten spoorrails."@nl;
  skos:altLabel "wielflens"@nl;
