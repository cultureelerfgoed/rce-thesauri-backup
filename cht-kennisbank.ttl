<https://data.cultureelerfgoed.nl/term/id/cht/8eed83a5-6520-4efb-aace-2afde0b0e61d>
  a skos:Concept;
  skos:prefLabel "laadwagens (mijnen)"@nl;
  skos:scopeNote "De laadwagen werd ondergronds gebruikt voor het vervoeren van materialen zoals stijlen, kappen en hout."@nl;
  skos:altLabel "laadwagen (mijnen)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/feb50453-4925-49d0-a20e-39d63bed2a0f>;
