  a skos:Concept;
  skos:prefLabel "veiligheidsglas"@nl;
  skos:scopeNote "Veiligheidsglas wordt gemaakt door een aantal lagen glas aan elkaar te hechten met kunststof. Het wordt in vitrines gebruikt om reden van beveiliging en bescherming."@nl;
