<https://data.cultureelerfgoed.nl/term/id/cht/5d0a6925-abbb-4274-859c-992edec7a686>
  a skos:Concept;
  skos:prefLabel "hoogholten"@nl;
  skos:scopeNote "Hoogholten of hoogholtjes zijn in de provincie Groningen de benamingen voor een hoge vaste voetbrug, hoog genoeg om schepen te laten passeren."@nl,
    """Hoogholten of hoogholtjes zijn in de provincie Groningen de benamingen voor een hoge vaste voetbrug, hoog genoeg om schepen te laten passeren.
"""@nl,
    "Een heechhout is in de provincie Friesland de benaming voor een hoge vaste voetbrug, hoog genoeg om skûtsjes (met gestreken mast) te laten passeren. De Friese benaming betekent letterlijk hoog hout, al werden ze in de loop der jaren ook van andere materialen gemaakt. Aan beide zijden van de brug bevindt zich een trap. In de provincie Groningen staan deze bruggen bekend als hoogholtjes."@nl,
    "Een hoogholtje is in de provincie Groningen de benaming voor een hoge vaste voetbrug, hoog genoeg om schepen te laten passeren. Aan beide zijden bevindt zich een trap of steile opgang, vaak met dwarslatten."@nl;
  skos:altLabel "heechhouten"@nl, "hoogholtjes"@nl, "hoogholte"@nl, "hogholtje"@nl,
    "hogholtjes"@nl, "hoogholt"@nl, "hoogholtje"@nl, "heechout"@nl, "hooghout"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b0df8b0e-8df3-41d5-9ab0-0d146024907a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f670f20c-5428-4920-ba34-5712c82747a1>
  a skos:Concept;
