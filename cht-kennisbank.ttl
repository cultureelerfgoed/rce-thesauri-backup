<https://data.cultureelerfgoed.nl/term/id/cht/66a2846f-a516-4d2c-b100-a19d96df717d>
  a skos:Concept;
  skos:prefLabel "joodse begraafplaatsen"@nl;
  skos:scopeNote "Joodse begraafplaatsen zijn begraafplaatsen die aangelegd en bedoeld zijn voor personen uit de joodse gemeenschap. Al vroeg legden joden hun begraafplaatsen aan op enige afstand van de stad. De graven op deze begraafplaats worden niet geruimd. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "Israëlitische begraafplaats"@nl, "Israëlitische begraafplaatsen"@nl,
    "jodenkerkhof"@nl, "jodenkerkhoven"@nl, "joodse begraafplaats"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bb70464c-b05e-45f7-a5ef-bfb3c5dcdb8c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/738a5380-f89b-4892-98b3-209cae05841b>
  a skos:Concept;
  skos:prefLabel "windlatten"@nl;
  skos:scopeNote "Schuin oplopende lat, onder tegen een opeenvolgende serie daksporen gespijkerd om schranken tegen te gaan. Eerste vorm van windverband in een kapconstructie, XIIIen later. (Haslinghuis)"@nl;
  skos:altLabel "schrankhout"@nl, "schrankhouten"@nl, "windlat"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/66547924-e6e8-4991-873e-85a2aa436b91>;
