<https://data.cultureelerfgoed.nl/term/id/cht/c0757987-800f-4fbd-a661-b77b98452d34>
  a skos:Concept;
  skos:prefLabel "handschoenendozen"@nl;
  skos:scopeNote "Dozen, meestal lang en smal, voor het bewaren van hanschoenen als deze niet gebruikt worden. Bevat soms een voering aan de binnenkant van de deksel voor het bewaren van handschoenrekkers. (AAT-Ned)"@nl;
  skos:altLabel "handschoenendoos"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/44872c69-2b39-4667-88a7-9500b45b65c9>;
