<https://data.cultureelerfgoed.nl/term/id/cht/d311cec3-f2f6-49b4-8819-850336959e3a>
  a skos:Concept;
  skos:prefLabel "chokekleppen"@nl;
  skos:scopeNote "Vlakke ronde schijf, gemonteerd op een asje, dat in de luchtinlaat van de carburateur kan draaien en daardoor de luchttoevoer kan verminderen of afsluiten gedurende de koude start."@nl;
  skos:altLabel "chokeklep"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0a0b798b-453c-43ca-a048-174acb18a717>;
