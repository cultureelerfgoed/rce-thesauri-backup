  a skos:Concept;
  skos:prefLabel "schijfwielen (vervoer)"@nl;
  skos:scopeNote "Een schijfwiel is een wiel zonder spaken. Bij treinen worden praktisch alleen dit soort wielen toegepast. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
