<https://data.cultureelerfgoed.nl/term/id/cht/772867bd-1e70-44a9-a264-4a41e587edcf>
  a skos:Concept;
  skos:prefLabel "matzewot"@nl;
  skos:scopeNote "Matzewot zijn grafstenen/gedenkstenen. Op Asjkenazische begraafplaatsen staan de grafstenen rechtop, terwijl Sefardische begraafplaatsen worden gekenmerkt door liggende grafstenen."@nl;
  skos:altLabel "matzeiwe"@nl, "matzewa"@nl;
