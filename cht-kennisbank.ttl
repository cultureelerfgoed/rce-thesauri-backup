<https://data.cultureelerfgoed.nl/term/id/cht/1a0e39e3-5306-47db-9ed3-36a0d423597c>
  a skos:Concept;
  skos:prefLabel "archeologische attentiegebieden"@nl;
  skos:scopeNote "Archeologisch attentiegebieden zijn gebieden waar, op grond van vondsten, (al dan niet in combinatie met ligging, bodemkenmerk en/of andere indicaties) wordt verwacht dat zich in deze gebieden (nog) archeologische sporen zullen bevinden. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "archeologisch attentiegebied"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bca0f9df-2f19-4587-bfaa-7357ce4d904f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6a54549b-b890-453f-af4c-ebd0d273e9f8>
  a skos:Concept;
  skos:prefLabel "etno-historische onderzoeken"@nl;
  skos:scopeNote "Etno-historische onderzoeken zijn onderzoeken naar gewoonten en gebruiken met behulp van historische gegevens om een breder kader te scheppen voor de interpretatie van archeologisch materiaal. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "etno-historische onderzoek"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/56738807-ec3f-4dca-9a62-fc9397df54a1>;
