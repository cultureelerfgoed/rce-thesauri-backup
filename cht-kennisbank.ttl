  a skos:Concept;
  skos:prefLabel "filmcassettes"@nl;
  skos:scopeNote "Gesloten en vaak lichtdichte houders met film of microfilm op twee spoelen. Cassettes kan men in een geschikte camera doen en direct gebruiken. Ze zijn meestal gemaakt van plastic of lichtgewichtmetaal en hebben een platte en rechthoekige vorm. (Project Fotografie)"@nl;
  skos:altLabel "filmcassette"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2940dd8-fc99-40ce-b260-09378172d40b>;
