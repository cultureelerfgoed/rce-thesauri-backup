<https://data.cultureelerfgoed.nl/term/id/cht/87d90bd8-c0d3-4fa5-bc26-1840a382a074>
  a skos:Concept;
  skos:prefLabel "katheders"@nl;
  skos:scopeNote "Romeinse stoelen met een ronde rugleuning op verticale staanders en met gebogen poten. Tevens de zetel of troon van een bisschop in zijn kerk. (AAT-Ned)"@nl;
  skos:altLabel "katheder"@nl;
