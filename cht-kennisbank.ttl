<https://data.cultureelerfgoed.nl/term/id/cht/524c03c3-e7d0-481e-a945-3b41731d6576>
  a skos:Concept;
  skos:prefLabel "cella's (hoofdgedeelte)"@nl;
  skos:scopeNote "Hoofdgedeelte van het door muren omsloten deel van een tempel tussen pronaos en opisthodomos, waar gewoonlijk een godenbeeld stond.G. naos (Haslinghuis)"@nl;
  skos:altLabel "cella (hoofdgedeelte)"@nl;
