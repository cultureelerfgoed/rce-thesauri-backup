<https://data.cultureelerfgoed.nl/term/id/cht/5bd6176d-b821-4349-9e83-b20141637c5d>
  a skos:Concept;
  skos:prefLabel "legers (natuursteen)"@nl;
  skos:scopeNote "Leger: bij natuurlijk gelaagde natuursteen de min of meer evenwijdige vlakken en lagen van de gelaagdheid."@nl;
