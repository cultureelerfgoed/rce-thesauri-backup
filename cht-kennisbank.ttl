<https://data.cultureelerfgoed.nl/term/id/cht/76dd8253-1b0f-470b-b977-7907bea3a444>
  a skos:Concept;
  skos:prefLabel "eet- en drinkgerei"@nl;
  skos:scopeNote "Eet- en drinkgerei is de algemene benaming voor alle voorwerpen die worden gebruikt bij het eten en drinken. Voor het eten worden daar dus zowel het serviesgoed als het couvert ofwel bestek onder verstaan. (Bron: Wikipedia)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
