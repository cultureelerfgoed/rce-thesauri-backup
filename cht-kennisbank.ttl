<https://data.cultureelerfgoed.nl/term/id/cht/dd590ad9-d31f-4036-8717-a4d7bc0083ac>
  a skos:Concept;
  skos:prefLabel "digitaliseringstandaarden"@nl;
  skos:scopeNote "Geheel van regels en principes met betrekking tot de digitalisering. Deze standaarden werden erkend en goedgekeurd door de wetenschappelijke gemeenschap en maken de invoering van gemeenschappelijke technieken, materialen en uitwisselingsformaten mogelijk."@nl;
  skos:altLabel "digitaliseringstandaard"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e2db3c44-4869-406e-9534-5deb074679a2>;
