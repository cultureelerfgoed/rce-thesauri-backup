<https://data.cultureelerfgoed.nl/term/id/cht/aa20f870-f545-479c-bddb-60b95586c6b8>
  a skos:Concept;
  skos:prefLabel "schoorsteenluiken"@nl;
  skos:scopeNote "Schoorsteenluiken zijn houten of metalen luiken in schoorstenen om het schoorsteenkanaal te inspecteren, te vegen en om vlees op te hangen zodat het gerookt kan worden. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "schoorsteenluik"@nl;
