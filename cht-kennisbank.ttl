  a skos:Concept;
  skos:prefLabel "aanrecht"@nl;
  skos:scopeNote "Werkvlak in een keuken van hout, steen (marmer, terrazzo) of bekleed met metaal (zink, corrosiebestendig staal) of kunststof. In de aanrecht is veelal een (zie) gootsteen of afvoerbak opgenomen. (Haslinghuis)"@nl;
