<https://data.cultureelerfgoed.nl/term/id/cht/bab1583d-2050-4a8d-9468-7a9582aa754e>
  a skos:Concept;
  skos:prefLabel "expositietrappen"@nl;
  skos:scopeNote "Verplaatsbaar trapje van enkele treden, waarop de priester kan staan bij de plaatsing in en het terugnemen uit de expositietroon op het tabernakel van de monstrans of de expositieciborie."@nl;
  skos:altLabel "expositietrap"@nl;
