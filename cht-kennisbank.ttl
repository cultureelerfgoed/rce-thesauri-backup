<https://data.cultureelerfgoed.nl/term/id/cht/450c6824-cf93-4b2e-a11b-36cf3363840e>
  a skos:Concept;
  skos:prefLabel "verfzeven"@nl;
  skos:scopeNote "Een verfzeef is voor het zeven van lakken, verf en blanke lak. Een verfzeef haalt alle vuiltjes en stof uit de lak."@nl;
  skos:altLabel "verfzeef"@nl;
