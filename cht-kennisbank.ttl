<https://data.cultureelerfgoed.nl/term/id/cht/46b80c49-7b7d-4515-b626-9550c06012a0>
  a skos:Concept;
  skos:prefLabel "opticiëns (winkels)"@nl;
  skos:scopeNote "Zij die brillenglazen en contactlenzen maken in overeenstemming met de voorschriften van oogspecialisten zoals optometristen en oftalmologen.(AAT)"@nl;
  skos:altLabel "opticiën (winkels)"@nl;
