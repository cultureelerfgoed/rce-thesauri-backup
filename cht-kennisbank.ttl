<https://data.cultureelerfgoed.nl/term/id/cht/7d68177c-a890-42d4-b550-b36a42f18a90>
  a skos:Concept;
  skos:prefLabel "waterverf"@nl;
  skos:scopeNote "Een verf die wordt verkregen door pigmenten te mengen in een waterig oplosmiddel, meestal in Arabische gom; wordt doorgaans aangebracht met een kwast. (AAT-Ned)"@nl;
