<https://data.cultureelerfgoed.nl/term/id/cht/896be79c-32a4-415f-9342-7b63560db7d6>
  a skos:Concept;
  skos:prefLabel "vlucht (afstand)"@nl;
  skos:scopeNote "De afstand tussen de uiteinden van één molenroede. Je kunt ook zeggen de afstand tussen de uiteinden van twee wieken. De vlucht van de molen is de afstand in meters van de ene wiektop naar de top van de tegenoverliggende wiek. De vlucht is dus tweemaal de wieklengte. De vlucht wordt als algemene maatstaf gebruikt bij de onderverdeling van molens in grootte. De meeste molens in Nederland hebben een vlucht variërend tussen 22 en 28 meters. (Molenwoordenboek B.D. Poppen)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/929f2b49-e558-4543-a710-41a893c3c5dd>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8998a43d-6242-4a21-bccf-061c23b9fcfe>
  a skos:Concept;
  skos:prefLabel "wielbandprofielen"@nl;
  skos:scopeNote "Het wielbandprofiel is de vorm van het treinwiel"@nl;
  skos:altLabel "wielbandprofiel"@nl;
