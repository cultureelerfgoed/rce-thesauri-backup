<https://data.cultureelerfgoed.nl/term/id/cht/e531075b-aaf7-4f3b-b147-5b635916fabf>
  a skos:Concept;
  skos:prefLabel "drukgroepen"@nl;
  skos:scopeNote "Samenstel van de beweegbare drukplaat en het huis waarin de koppelingsveren zijn ondergebracht en waarmee de koppelingsplaat tussen de beweegbare drukplaat en het vliegwiel wordt ingeklemd."@nl;
  skos:altLabel "drukgroep"@nl;
