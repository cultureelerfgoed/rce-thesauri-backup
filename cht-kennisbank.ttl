<https://data.cultureelerfgoed.nl/term/id/cht/20e54c14-f0c6-4b30-a760-91bcab1c2855>
  a skos:Concept;
  skos:prefLabel "volkeren"@nl;
  skos:scopeNote "1) volkeren: gemeenschap van bewoners van een land die afstamming, taal, zeden, overlevering gemeen hebben (historisch als een zelfstandige groep optredend deel der mensheid, een levensgemeenschap).2) bevolkingsgroep: de gezamenlijke bewoners van een landstreek, zoals door ondergeschikte raskenmerken, taal en zeden van andere groepen onderscheiden."@nl;
  skos:altLabel "volk"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db4a7619-d236-4b14-8e79-b4a6e890f677>;
