<https://data.cultureelerfgoed.nl/term/id/cht/91d6b616-bc1e-4ce4-997a-4aaec663eee2>
  a skos:Concept;
  skos:prefLabel "beschutting"@nl;
  skos:scopeNote "Door een schut, een afsluiting enz. beschermen."@nl;
