<https://data.cultureelerfgoed.nl/term/id/cht/264e8baf-2540-4daa-89c7-d41b879c43a4>
  a skos:Concept;
  skos:prefLabel "televisiestudio's"@nl;
  skos:scopeNote "Televisiestudio’s zijn speciaal ingerichte ruimtes vanwaaruit televisie-uitzendingen plaatshebben, bestaande uit opnameruimtes, controlekamers, make-up- en kleedruimtes. Hierbij wordt gebruik gemaakt van camera's, microfoons, verlichting en decors. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "opnamestudio"@nl, "opnamestudio's"@nl, "televisiestudio"@nl;
