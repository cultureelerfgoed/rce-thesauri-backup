<https://data.cultureelerfgoed.nl/term/id/cht/59f287a0-4f09-4b22-a6bd-76d490a7c001>
  a skos:Concept;
  skos:prefLabel "dekstations"@nl;
  skos:scopeNote "Dekstations zijn gespecialiseerde agrarische gebouwen waar vee, zoals paarden of runderen, wordt gedekt voor fokdoeleinden, vaak uitgerust met alle benodigde faciliteiten voor kunstmatige inseminatie."@nl;
  skos:altLabel "dekstation"@nl;
