<https://data.cultureelerfgoed.nl/term/id/cht/1cd56376-a753-49e1-82ba-2162bcc1b885>
  a skos:Concept;
  skos:prefLabel "ruimtelijk uitvoeringsplannen"@nl;
  skos:scopeNote "Een ruimtelijk uitvoeringsplan of RUP, is in Vlaanderen een plan waarmee de overheid in een bepaald gebied de bodembestemming vastlegt."@nl;
  skos:altLabel "RUP"@nl, "ruimtelijk uitvoeringsplan"@nl;
