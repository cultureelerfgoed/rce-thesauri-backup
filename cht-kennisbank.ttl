  a skos:Concept;
  skos:prefLabel "krielaardappelen"@nl;
  skos:scopeNote "Krielaardappelen of krieltjes zijn consumptieaardappelen met een grootte van 23 tot 30 mm. Krielaardappelen worden meestal met de schil gebakken of gekookt. Ook zijn er vers geschrapte krieltjes te koop."@nl;
  skos:altLabel "krielaardappel"@nl, "krieltjes"@nl;
