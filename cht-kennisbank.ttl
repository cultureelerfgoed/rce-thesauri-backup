<https://data.cultureelerfgoed.nl/term/id/cht/1b92c462-ca59-4ff8-be69-9858cca1df68>
  a skos:Concept;
  skos:prefLabel "avant-corpsen (gevelonderdeel)"@nl;
  skos:scopeNote "Min of meer zelfstandig bouwlichaam, op de wijze van een risaliet voor de hoofdgevel uitstekend, maar gewoonlijk met aanmerkelijk grotere voorsprong. (Haslinghuis)"@nl;
  skos:altLabel "avant-corps (gevelonderdeel)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0b8e500e-d40f-4be2-85de-5fe442c59d20>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/be7a8f5b-8ce3-4265-bfd0-6b05b03a198a>
  a skos:Concept;
  skos:prefLabel "toeschrijving"@nl;
  skos:scopeNote "Een toeschrijving is een beoordeling waarmee een historisch voorwerp of een kunstwerk wordt toegeschreven aan een bepaalde kunstenaar, maker of school."@nl;
  skos:altLabel "toeschrijvingen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f94da6b6-f1b8-4141-b4e8-316573793d59>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f55fd4a1-5092-4c4b-b759-4064db1daff7>
  a skos:Concept;
  skos:prefLabel "uitbloeien"@nl;
  skos:scopeNote "Een oplossing of een gehydrateerd zout kan uitbloeien als het water afstaat en in een andere vorm (samenstelling, kristalvorm) overgaat."@nl;
  skos:altLabel "uitbloeiing"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/e8065eac-852d-4f32-b459-2ee3ad30528a>;
