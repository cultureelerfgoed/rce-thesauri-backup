    <https://data.cultureelerfgoed.nl/term/id/cht/fb760165-26d8-401d-b7cd-15736afe1036>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/51b94a36-cb97-40c5-accd-10d1d6f28b61>
  a skos:Concept;
  skos:prefLabel "tin"@nl;
  skos:scopeNote "Pewter is een legering van tin (80-90%) met lood (20-10%), tegenwoordig met antimoon."@nl;
