<https://data.cultureelerfgoed.nl/term/id/cht/e4eb92e1-adcf-40a0-9f64-987d0712713a>
  a skos:Concept;
  skos:prefLabel "gildetekens"@nl;
  skos:scopeNote "Algemene benaming voor een kenmerk van een gilde. Het kon bijvoorbeeld zijn aangebracht aan een door het gilde geschonken object aan de kerk."@nl;
  skos:altLabel "gildeteken"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/abfc1bb7-04d7-43a0-9e99-dd4c5a4f2c15>;
