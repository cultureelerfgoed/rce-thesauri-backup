  a skos:Concept;
  skos:prefLabel "konijnenhokken"@nl;
  skos:scopeNote "Boxvormige hokken die gebouwd of gebruikt worden om konijnen in te laten wonen. (AAT)"@nl;
  skos:altLabel "konijnenhok"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/41ae98cd-0cc4-438a-8032-3c6ee1429b8d>;
