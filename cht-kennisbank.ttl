<https://data.cultureelerfgoed.nl/term/id/cht/42220f9f-29aa-4bac-8e02-b5fab4c72e55>
  a skos:Concept;
  skos:prefLabel "achterplaten"@nl;
  skos:scopeNote "Plaatjes die als zetting dienen voor knoppen of handvatten en zijn bevestigd tussen deze knoppen of handvaten en de kasten waaraan ze zijn bevestigd. (AAT)"@nl;
