<https://data.cultureelerfgoed.nl/term/id/cht/97ce02ad-f664-45e3-8a08-3c286e6a11fe>
  a skos:Concept;
  skos:prefLabel "atc motorfietsen"@nl;
  skos:scopeNote "Een ATC of All Terrain Carrier is een lichte trike voor in het terrein. Ook wel (ten onrechte) ATV genoemd."@nl;
  skos:altLabel "atc motorfiets"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db3edfc3-7d4b-4090-8ff7-2a9597a0206f>;
