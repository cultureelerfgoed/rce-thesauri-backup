<https://data.cultureelerfgoed.nl/term/id/cht/ee940bd8-c603-4395-87b9-687b5d1bc918>
  a skos:Concept;
  skos:prefLabel "röntgenfotografie"@nl;
  skos:scopeNote "Röntgenfotografie is het gebruik van röntgenstraling voor het maken van afbeeldingen van voorwerpen."@nl;
