<https://data.cultureelerfgoed.nl/term/id/cht/06553050-7dcc-406d-95aa-99f9edac67aa>
  a skos:Concept;
  skos:prefLabel "Benedictijnerkloosters"@nl;
  skos:scopeNote "Benedictijnerkloosters zijn kloosters die leefden volgens de regel van Benedictus van Nursia. De orde ontstond in de 6e eeuw en legde nadruk op ora et labora (bidden en werken). Benedictijnerkloosters waren vaak zelfvoorzienend en speelden een grote rol in landbouw, wetenschap en boekproductie."@nl;
  skos:altLabel "Benedictijnerklooster"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c627ea74-ed43-4327-b8fb-f46f759e5ff4>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

