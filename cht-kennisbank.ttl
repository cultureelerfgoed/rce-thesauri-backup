<https://data.cultureelerfgoed.nl/term/id/cht/e28732a4-dac8-454e-96cc-1cfa442b48de>
  a skos:Concept;
  skos:prefLabel "wildbeheer"@nl;
  skos:scopeNote "Wildbeheer is het beheer van de wildstand. Tot de belangrijkste maatregelen kunnen gerekend worden de bescherming van de leef- en broedgebieden, en de controle op aantallen. (Winkler Prins Encyclopaedie)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0173183f-b658-443e-b333-25d2df7d1b7c>;
