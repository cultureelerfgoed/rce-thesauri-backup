<https://data.cultureelerfgoed.nl/term/id/cht/fc62c988-b77c-42be-bf10-535847f11c55>
  a skos:Concept;
  skos:prefLabel "maskerprocedés"@nl;
  skos:scopeNote "Bij het maken en verwerken van fotografisch materiaal bewerkstelligt het maskerprocedé de correctie van de optische dekking van enkele of meerdere beeldlagen. Het wordt toegepast om de kleur en contrastweergave te verbeteren en kan worden bereikt door het gebruik van in de beeldlaag geïntegreerde maskerlagen of in combinatie met maskeerfilms."@nl;
  skos:altLabel "maskerprocedé"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
