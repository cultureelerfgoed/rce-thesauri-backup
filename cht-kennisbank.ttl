<https://data.cultureelerfgoed.nl/term/id/cht/7cfe315d-de07-4d5e-b736-2ce87be9af09>
  a skos:Concept;
  skos:prefLabel "pseudohallenkerken"@nl;
  skos:scopeNote "Kerktype dat slechts in zoverre van de hallenvorm afwijkt, dat het middenschip iets hoger is. Er is nog plaats voor kleine bovenlichten, b.v. de St.-Nicolaaskerk te Diksmuide (W.V., c. 1350) en enkele andere in het Vlaamse en Hollandse kustgebied. (Haslinghuis)"@nl;
  skos:altLabel "pseudohallenkerk"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c15af234-87b0-433c-bbe1-880a6f717057>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f57b1a75-6358-4b28-a091-28456771e664>
  a skos:Concept;
  skos:prefLabel "rechtkettingen"@nl;
  skos:scopeNote "Ketting waarmee het eind (wiek) dat voor de borst moest staan werd vastgelegd."@nl;
  skos:altLabel "rechtketting"@nl;
