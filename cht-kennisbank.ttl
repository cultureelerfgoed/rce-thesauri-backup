<https://data.cultureelerfgoed.nl/term/id/cht/742b92ae-1116-4790-b331-1c165b385623>
  a skos:Concept;
  skos:prefLabel "Curvilinear style"@nl;
  skos:scopeNote "Fase in de Engelse gotiek, genoemd naar de tekening in het maaswerk. Tweede fase van de ‘decorated style’, c. 1315-’75. Ook ‘flowing’ genoemd; inleiding tot het Franse flamboyant. (Haslinghuis)"@nl;
  skos:altLabel "Flowing"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9e8b7e42-e2cf-4070-8f1c-c88ee97bd112>;
