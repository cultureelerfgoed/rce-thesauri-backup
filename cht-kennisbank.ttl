<https://data.cultureelerfgoed.nl/term/id/cht/c88199d1-c5e2-46cd-a21b-2ea476f29a0a>
  a skos:Concept;
  skos:prefLabel "leihaken"@nl;
  skos:scopeNote "Leihaken zijn haken waaraan de daklei wordt opgehangen. Deze worden voornamelijk gebruikt bij een Maasdak. (Haslinghuis)"@nl;
  skos:altLabel "leihaak"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aefdd718-b34b-4024-9583-123686fbc209>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/81063c13-bf8f-425f-adb3-63121b6303d4>
  a skos:Concept;
  skos:prefLabel "gaarkeukens"@nl;
  skos:scopeNote "Te gebruiken voor gebouwen waar soep, brood en andere basisvoeding wordt verstrekt aan behoeftigen, gratis of tegen een kleine vergoeding. (AAT-Ned)"@nl;
  skos:altLabel "gaarkeuken"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7a3fef04-32ad-4b47-9a65-8059b21a629c>;
