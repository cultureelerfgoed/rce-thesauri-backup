<https://data.cultureelerfgoed.nl/term/id/cht/b3c80195-3d8d-422e-8b72-fb992e34ac8d>
  a skos:Concept;
  skos:prefLabel "tussenbalken"@nl;
  skos:scopeNote "Een tussenbalk is een onderdeel van een gebint. Het is een horizontale balk van een tussenbalkgebint, d.w.z. dat de balk met een niet of weinig doorstekende pen (zonder verankering d.m.v. wiggen) in elk van beide gebintstijlen is opgelegd. Bij de variant met overstek is deze houtverbinding slechts aan één einde aanwezig. (Historische houtconstructies in Nederland / G. Behrends, 1996)"@nl;
  skos:altLabel "tussenbalk"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/650ab4b1-e8ab-4c49-9195-8401d4a6cd6e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b4317c99-6cc4-4b75-9bb1-82d1960c2e1b>
  a skos:Concept;
  skos:prefLabel "stapelspanten"@nl;
