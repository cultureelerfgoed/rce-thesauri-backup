<https://data.cultureelerfgoed.nl/term/id/cht/00ccd232-d40b-4c08-8c83-44dcac7bfa28>
  a skos:Concept;
  skos:prefLabel "kerncentrales"@nl;
  skos:scopeNote "Centrale die met kernenergie elektriciteit opwekt (kerncentrale) / Installatie voor het splijten of fuseren van atoomkernen, atoomreactor (kernreactor)."@nl;
  skos:altLabel "kerncentrale"@nl;
