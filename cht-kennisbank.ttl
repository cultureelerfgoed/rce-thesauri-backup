<https://data.cultureelerfgoed.nl/term/id/cht/77a074e4-6e79-465d-bf51-1ca3b76cf8db>
  a skos:Concept;
  skos:prefLabel "wijn"@nl;
  skos:scopeNote "Alcoholische drank bereid uit gefermenteerde druivensap. De term wordt ook gebruikt voor dranken die van andere gefermenteerde planten zijn gemaakt. (AAT-Ned)"@nl;
