<https://data.cultureelerfgoed.nl/term/id/cht/e6664436-90a4-4f2e-a7af-84a70b2112bc>
  a skos:Concept;
  skos:prefLabel "vrijmetselaarsattributen"@nl;
  skos:scopeNote "Attribuut dat behoort tot de symbolenwereld van de vrijmetselarij, ontleend aan de bijbel, het metselaarsvak en het licht."@nl;
  skos:altLabel "vrijmetselaarsattribuut"@nl;
