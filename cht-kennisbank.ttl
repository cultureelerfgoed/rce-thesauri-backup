  a skos:Concept;
  skos:prefLabel "stellingdeuren"@nl;
  skos:scopeNote "Deuren waardoor men van de zolder op de zwichtstelling kon komen, bij pelmolens waren dit er verscheidene. In Groningen zijn ze dubbel uitgevoerd."@nl;
  skos:altLabel "molendeur"@nl, "stellingdeur"@nl;
