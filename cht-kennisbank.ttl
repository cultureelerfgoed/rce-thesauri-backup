<https://data.cultureelerfgoed.nl/term/id/cht/419d864f-d458-4f4e-91af-45e1460c578b>
  a skos:Concept;
  skos:prefLabel "houtdraadbouten"@nl;
  skos:scopeNote "Zware schroef met vier- of zeskante kop en grote spoed, speciaal bedoeld om houten onderdelen op elkaar te bevestigen. Lengte 3-20 cm, dikte 6-14 mm. (Haslinghuis)"@nl;
  skos:altLabel "houtdraadbout"@nl;
