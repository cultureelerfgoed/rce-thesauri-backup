<https://data.cultureelerfgoed.nl/term/id/cht/bd9f1123-22d2-4604-93b4-6dd1b963c097>
  a skos:Concept;
  skos:prefLabel "walvisjagers (vaartuig)"@nl;
  skos:scopeNote "Kleine, gemotoriseerde zeeschepen die worden gebruikt om op walvissen te jagen en deze te doden; varen meestal samen op met 'fabrieksschepen'. (MARDOC)"@nl;
  skos:altLabel "walvisjager (vaartuig)"@nl;
