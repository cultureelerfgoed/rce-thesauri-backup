<https://data.cultureelerfgoed.nl/term/id/cht/897d661e-23c1-4d08-8768-a76a0b0addd8>
  a skos:Concept;
  skos:prefLabel "detritus gyttja"@nl;
  skos:scopeNote "Detritus gyttja is een fijn organisch sediment bestaande uit detritus (fijnkorrelig dood organisch materiaal, meestal verslagen veen). Deze organische afzetting vormt vooral in veenmeren met stilstaand, water (dieper dan 1 à 2 meter)."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/afba7122-883c-4e8e-9430-a5f3f43923e4>;
