<https://data.cultureelerfgoed.nl/term/id/cht/2003f691-e977-47c7-81ea-05cada282ed4>
  a skos:Concept;
  skos:prefLabel "vlasmolens"@nl;
  skos:scopeNote "Klein soort molen speciaal ingericht om de vlasstengels te breken. (Molenwoordenboek G.J. Pouw)"@nl;
  skos:altLabel "vlasmolen"@nl, "vlaszwingelmolen"@nl, "vlaszwingelmolens"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6654db8a-3424-4bf3-bfd8-0490ce52b8ae>;
