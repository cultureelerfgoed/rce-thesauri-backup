    <https://data.cultureelerfgoed.nl/term/id/cht/62a516e5-99f5-469d-91d1-d614213c2da6>,
    <https://data.cultureelerfgoed.nl/term/id/cht/af5e7e9a-7bcc-426c-bfba-11572422696d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/36a29c90-25b1-4273-b865-9d084281dde9>
  a skos:Concept;
  skos:prefLabel "bergen"@nl;
  skos:scopeNote "Om een kwetsbaar object uit zijn vindplaats te bergen, gebruikt men een steunconstructie om verdere schade te voorkomen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/36bf63bf-3d8a-420b-8cab-883e4784e8ed>
  a skos:Concept;
  skos:prefLabel "tafelpositieven"@nl;
  skos:scopeNote "Het tafelpositief is een klein pijporgel, zonder onderbouw, groter dan het portatief, dat op een tafel kan worden geplaatst. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "tafelpositief"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa9cda1e-c01d-431e-9f74-51d3073b97d5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/36c51d71-f8aa-40c4-bb7f-148004c1ea53>
  a skos:Concept;
  skos:prefLabel "dichloorvos"@nl;
  skos:scopeNote "Dichloorvos, 2,2-dichloorvinyl dimethylfosfaat, is een verdelgingsmiddel dat geleidelijk in een afgesloten ruimte wordt losgelaten en dat in een bepaalde concentratie insecten doodt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/40766ec4-4368-4614-a988-c11925841758>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/36c6ab64-bd22-4665-8367-f7ff2349664d>
  a skos:Concept;
  skos:prefLabel "lopers (gereedschap)"@nl;
  skos:scopeNote "Een loper is een zware, vlakke steen met een handvat in het midden van één van de zijden, die gebruikt wordt voor het wrijven van pigmenten of andere materialen op een grotere plaat van steen of glas. Lopers werden vaak van steen gemaakt, maar nu zijn ze vaker van glas. (Conservation Dictionary)"@nl;
  skos:altLabel "loper (gereedschap)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/36fc7de7-6a0a-4eaa-ba84-3ee9c77810de>
  a skos:Concept;
  skos:prefLabel "vis à vis"@nl;
  skos:scopeNote "Vis-à-vis (Frans voor 'tegenover') is een opstelling van stoelen of banken tegenover elkaar, in een voertuig."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dec3cb60-0105-49ac-a19f-d52c1f1ac5b4>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3736b5d4-b7a8-480d-b377-9853eb8c766c>
  a skos:Concept;
  skos:prefLabel "uitwerkingsplan"@nl;
  skos:scopeNote "Bij de restauratie van gebouwen beschrijft een uitwerkingplan hoe een terrein verder zal worden ontwikkeld en verbeterd. Een uitwerkingsplan kan het nauwkeurig omschreven resultaat zijn van institutioneel beleid en van een beroepsopvatting."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/df4db7b4-3b69-49a2-9068-13034f1a068f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/37d0facb-c805-4351-bed6-aba50a1e16d1>
  a skos:Concept;
  skos:prefLabel "impermeabele korst"@nl;
  skos:scopeNote "Een impermeabele korst is een aangroei of een afzetting op een materiaal (in het bijzonder steen) die ondoorgankelijk is voor vloeistoffen en gassen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/37fe03d4-c526-46a3-9793-121d6d9ba658>
  a skos:Concept;
  skos:prefLabel "indemniteit"@nl;
  skos:scopeNote "Iemand verkrijgt indemniteit als hij de toezegging krijgt dat schade aan of verlies van bepaalde objecten vergoed zal worden. Deze toezegging kan gedekt worden door een belangrijke institutie (bijvoorbeeld een overheid) of door een verzekeringsmaatschappij, welke meestal voorwaarden verbinden aan de zorg voor de betreffende objecten."@nl;
  skos:altLabel "garantieregeling"@nl, "garantieregelingen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bcc9ece8-29e8-46f8-b0ab-144d51f43c72>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/38049414-9866-44d5-a0f6-6f47f80556eb>
  a skos:Concept;
  skos:prefLabel "brandweerauto's"@nl;
  skos:scopeNote "De term brandweervoertuig is een verzamelnaam voor de verschillende typen voertuigen die de brandweer inzet bij brand, ongeval of calamiteit. (Wikipedia)"@nl;
  skos:altLabel "brandweerauto"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dec3cb60-0105-49ac-a19f-d52c1f1ac5b4>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/94301196-4f38-4147-901a-ffe5a9f009f3>,
    <https://data.cultureelerfgoed.nl/term/id/cht/3d00876b-d91d-457f-ae67-3c42f9aa6f89>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3826efe3-cee9-4743-b63c-ce81d3fba875>
  a skos:Concept;
  skos:prefLabel "kopervraat"@nl;
  skos:scopeNote "Kopervraat van papier is een schade die veroorzaakt wordt door sommige koperhoudende pigmenten, welke een afbraakreactie in de cellulose veroorzaken, waarbij het koper als katalysator optreedt. Tekenen van dit soort schade zijn een voortschrijdende bruingroene verkleuring aan de achterkant van de kleuring. De aangetaste delen worden extreem bros."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/98b5139f-ec16-4fbb-8f24-d80fd2a767f5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/38324e75-8d98-45c6-bb13-e9444d4cf11c>
  a skos:Concept;
  skos:prefLabel "primerlaag"@nl;
  skos:scopeNote "De primerlaag is de eerste laag van een beschermende of decoratieve afwerking. Bij metalen zit er een anticorrosiemiddel in. In een verfsysteem is het de grondverf waarop de volgende lagen zullen hechten."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3836cda3-b168-4831-8892-f0c8209461d3>
  a skos:Concept;
  skos:prefLabel "beschermende beglazing"@nl;
  skos:scopeNote "1. Beschermende beglazing is een manier om aan de buitenlucht blootgesteld glas in lood te beschermen. 2. Beschermende beglazing is het gebruik van glas met bepaalde eigenschappen in lijsten, vitrines of ramen ter bescherming tegen bijvoorbeeld licht of diefstal."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3864a164-7332-4bcf-93d0-49feafeb7c7f>
  a skos:Concept;
  skos:prefLabel "tandartsen-afdrukwas"@nl;
  skos:scopeNote "Tandartsen-afdrukwas is een materiaal dat wordt gebruikt om kleine oppervlakken te kopiëren door er semi-permanente mallen van te maken. Het is afkomstig uit de tandartsenpraktijk. Het kan een was zijn of een siliconenrubber of een andere soort cross-linkende hars."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c7a915d7-bfdb-46fd-86a8-35b66c23aea1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3869cc24-4b5f-428a-8fd9-6dec3b7d5022>
  a skos:Concept;
  skos:prefLabel "putje"@nl;
  skos:scopeNote "Een putje is een halfbolvormig kuiltje, ontstaan in het oppervlak van een object."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/387e79f8-942c-4712-b7a4-54c708e95638>
  a skos:Concept;
  skos:prefLabel "magnetiet"@nl;
  skos:scopeNote "Het zwarte mineraal ijzer(III)oxide, magnetiet (Fe<sub>3</sub>O<sub>4</sub>), is een normaal product van ijzercorrosie."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/38d0e16c-616c-4154-9993-5ff3aae6b9bd>
  a skos:Concept;
  skos:prefLabel "vormlingen"@nl;
  skos:scopeNote "Groene stenen of vormlingen zijn gevormde ongebakken blokken klei. Na het vormen werden de groene stenen eerst te drogen gelegd om scheuren door uitzettend water tijdens het bakken te voorkomen."@nl;
  skos:altLabel "groene steen"@nl, "groene stenen"@nl, "vormling"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bbe4a82c-d0af-42c9-86c2-cca2e9560bac>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/39085719-27ad-44e5-9995-2ca27e82f91a>
  a skos:Concept;
  skos:prefLabel "wortelmotieven"@nl;
  skos:scopeNote "Wortelmotieven zijn geveldecoraties. Het zijn renaissancemotieven die lijken op een hangende wortel. (Haslinghuis)"@nl;
  skos:altLabel "wortelmotief"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5db74efc-e56d-4ff9-b60c-5c3bd938226c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/390b5976-5d88-435d-9f02-3e7dad99da6a>
  a skos:Concept;
  skos:prefLabel "archeobotanie"@nl;
  skos:scopeNote "Archeobotanie is de studie van plantenresten in opgravingen. Het doel van het onderzoek is meer te weten te komen over de plantengroei in het leefmilieu van de mens en zijn dieet in vroegere tijden."@nl;
  skos:altLabel "paleobotanie"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c32e9420-6176-42cc-a65c-25f671d1ec23>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/391714f7-97c4-4faf-9cc1-96d93bb24392>
  a skos:Concept;
  skos:prefLabel "zilvergeel (techniek)"@nl;
  skos:scopeNote "Zilvergeel is een techniek om bepaalde partijen van een gebrandschilderd glas aan de achterzijde te accentueren. Zilvernitraat wordt op het glasoppervlak aangebracht, slaat er in de oven op neer en gaat er een verbinding mee aan. De kleur varieert van licht- tot donkerroodgeel."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/39478309-0147-4508-8ef3-8f60e0086a1f>
  a skos:Concept;
  skos:prefLabel "kleurstofoverdracht"@nl;
  skos:scopeNote "Bij een kleurstofoverdrachtprocédé draagt een aangekleurd polymeer zijn kleur over aan een ander materiaal."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/396b0a99-6dab-40a9-bb19-f4d16639d80f>
  a skos:Concept;
  skos:prefLabel "overgeslagen plekken"@nl;
  skos:scopeNote "Als een (afwerk)laag slecht is aangebracht, kan hij op plekjes te dun zijn of volledig ontbreken. Deze plekjes noemt men overgeslagen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/39ac1d80-beca-41cc-9ed7-ec493136ef7d>
  a skos:Concept;
  skos:prefLabel "snijsel"@nl;
  skos:scopeNote "Snijsel zijn de krullen cellulosenitraat of -acetaat die een snijbeitel uit de zachte oppervlaktelaag bij directe plaatopnamen snijdt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/39daa4c6-7250-4370-a06b-972e2998d6f1>
  a skos:Concept;
  skos:prefLabel "hygrostaten"@nl;
  skos:scopeNote "Een hygrostaat is een sensor met een schakelaar die een be- of ontvochtiger in- of uitschakelt zodat een bepaalde relatieve vochtigheid wordt gehandhaafd. (Conservation Dictionary)"@nl;
  skos:altLabel "hygrostaat"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/33f1944f-4045-46f2-a3b0-8283bdc5b328>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3a312342-30b7-40c5-8c25-eb5c5fec6ef0>
  a skos:Concept;
  skos:prefLabel "elektronenstraalmicroanalyse"@nl;
  skos:scopeNote "Elektronenstraalmicroanalyse, SEM-EDX (scanning elektronenmicroscopie -energiedispersieve röntgenanalyse) is een methode voor kwantitatieve elementanalyse in materialen. Met het instrument bepaalt men de samenstelling van microscopisch kleine oppervlakken door middel van de energie en de intensiteit van röntgenstralen die ontstaan door de wisselwerking tussen de elektronenstraal en het monster."@nl;
  skos:altLabel "SEM-EDX"@nl, "scanning elektronen microscopie"@nl, "scanning elektronen microscopie met energie-dispersieve röntgenanalyse"@nl,
    "electron microprobe"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c31c17cc-ac7d-4a4e-bc63-41f888e1a047>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3a48c0b3-5730-4c06-8c61-45a22bf66b52>
  a skos:Concept;
  skos:prefLabel "recieten"@nl;
  skos:scopeNote "Het Reciet is een werk dat typisch is voor het romantische Franse orgel. Ruimtelijk bevindt het zich in het bovenste gedeelte van het Hoofdwerk. Dit manuaal telt over het algemeen enkele solostemmen die strategisch geplaatst zijn om boven het orgel uit te klinken, zodat de organist er 'reciterend' mee kan musiceren, vandaar de naam van dit manuaal. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "reciet"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cf51f60b-c1bb-4c17-b938-17e1dacb6e7c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3a90087c-c528-4999-9608-3d2570a1289a>
  a skos:Concept;
  skos:prefLabel "beperkte toegankelijkheid"@nl;
  skos:scopeNote "Beperkte toegankelijkheid voor mensen tot een voorwerp, een collectie of een kamer, betekent dat er bijkomende criteria worden aangelegd om reden van veiligheid of kwetsbaarheid."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5f4c4bef-a5c2-4d8e-ad2a-88b04f93f3dc>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3a94c27a-0667-407f-9eb6-81a9d7141610>
  a skos:Concept;
  skos:prefLabel "ontwateren"@nl;
  skos:scopeNote "Ontwatering van een materiaal is het afstaan van water vanuit de inwendige structuur van het materiaal. Dit kan door middel van chemische reacties en door fysische processen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3ac49c67-eb9f-4cf5-add2-0c163a4a2bdf>
  a skos:Concept;
  skos:prefLabel "neutraal intonen"@nl;
  skos:scopeNote "Neutraal intonen is een retoucheertechniek voor schilderingen. Dit doet men door lacunes zo in te vullen met een neutrale toon dat het oog van de beschouwer het beeld completeert aan de hand van de originele fragmenten. Men doet het door (soms ook kruiselings) arceren met vier kleuren (geel, rood, blauw of groen, bruin of zwart)."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3adfd97c-bc55-4293-a278-1e1fdde395e7>
  a skos:Concept;
  skos:prefLabel "slagmetaal"@nl;
  skos:scopeNote "Slagmetaal is algemene verzamelnaam voor diverse soorten imitatie bladmetalen. Doorgaans bedoeld om een afwerking op vergulding of verzilvering te laten lijken. (Collectiewijzer)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b9fd0887-297b-4bab-bea5-cb288d068816>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3ae2f69b-4218-4535-916a-7649da076bfc>
  a skos:Concept;
  skos:prefLabel "draadglas n.p."@nl;
  skos:scopeNote "Draadglas N.P. is draadglas dat zijn naam ontleent aan de vervaardiging volgens een gepatenteerde methode, het zogenaamde Nervura Patent. Het is aan één zijde voorzien van prismavormige ribben, die ongeveer twee centimeter uit elkaar liggen en die het licht beter verspreiden. Het Portugese woord ‘nervura’ betekent rib. Verder bevat dit glas zeshoekig gaas. Het glas heeft een iets andere samenstelling en is vuurgepolijst, waardoor een zeer glad oppervlak ontstaat. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7a3ca2fc-45e4-4ef4-88d8-9f0c8b100eca>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3afc2e1c-0c39-41a4-bbaa-238bc0b2b89b>
  a skos:Concept;
  skos:prefLabel "nachtegalen"@nl;
  skos:scopeNote "De nachtegaal is een imitatie van het zingen van de nachtegaal waarbij twee kleine orgelpijpjes in een bakje met water staan. Door lucht door het water te geleiden gaan de pijpjes een zeer specifiek, onregelmatig geluid geven dat lijkt op het geluid van een zingende vogel. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "nachtegaal"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cf51f60b-c1bb-4c17-b938-17e1dacb6e7c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3b0810fe-8f3a-4489-84bf-559667eaf4da>
  a skos:Concept;
  skos:prefLabel "chamois"@nl;
  skos:scopeNote "a. Chamois is een zachte, oliegelooide leersoort gemaakt van de huid van de chamois antilope. b. Zeemleer is een oliegelooide leersoort gemaakt van gesplitte schapenhuiden."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/58039588-a7e8-40d3-a1d3-5d6ae95f5aa5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3b0fbd2b-739d-42e3-b42d-88a152d7fe8b>
  a skos:Concept;
  skos:prefLabel "positieven (instrument)"@nl;
  skos:scopeNote "Het positief is een orgel, meestal klein van afmetingen en vaak zelfs verplaatsbaar, dat op de grond gezet wordt. Die « positie » op de grond verklaart ook de herkomst van de naam. Bij de grote klassieke instrumenten is het positief het orgelcorpus dat op of in de balustrade gebouwd zit, achter de organist, vandaar rugpositief. Is het onderaan het hoofdwerk geplaatst, dan spreken we over een onderpositief. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "positief (instrument)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa9cda1e-c01d-431e-9f74-51d3073b97d5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3b1d1c74-dbb9-471c-b42c-90ef15d7f94f>
  a skos:Concept;
  skos:prefLabel "harten (symbolische betekenis)"@nl;
  skos:scopeNote "Harten komen in het funeraire gebruik menigmaal voor op grafstenen als symbool. Uiteraard als Valentijnshart, als algemeen symbool voor de liefde en het huwelijk, maar ook in combinatie met ankers en kruizen welke samen staan voor de voornaamste christelijke deugden: geloof, hoop en liefde. Tevens symboliseert het de band met Christus. Een brandend hart verwijst naar religieuze bezieling. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "hart (symbolische betekenis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/abfc1bb7-04d7-43a0-9e99-dd4c5a4f2c15>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3b289a27-12dc-4b3b-9245-e4bba9e513e6>
  a skos:Concept;
  skos:prefLabel "niello"@nl;
  skos:scopeNote "Niello bestaat uit de zwarte sulfides van zilver, koper en lood die werden gebruikt voor decoratief inlegwerk op metalen voorwerpen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3b29c980-1789-484c-b707-e8809127c30e>
  a skos:Concept;
  skos:prefLabel "schoonkrabben"@nl;
  skos:scopeNote "Als men een oppervlak schoonkrabt, verwijdert men materiaal door voorzichtig met een mes over het oppervlak te schrapen. Overschilderingen en onoplosbare aanwas worden op deze wijze afgenomen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3b5e8856-3098-43ef-8097-98495984929a>
  a skos:Concept;
  skos:prefLabel "schilderspenselen"@nl;
  skos:scopeNote "Een penseel is een gereedschap dat door kunstschilders wordt gebruikt voor het aanbrengen van olieverf, aquarelverf, gouache of acryl. Het verschil tussen een penseel en een kwast is dat voor een penseel zacht en soepel haar, bijvoorbeeld marterhaar, wordt gebruikt."@nl;
  skos:altLabel "schilderspenseel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/8828200a-1366-4980-b91d-a67a0a41e542>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3b62e63a-81ad-4a16-8f5a-d8192a88364e>
  a skos:Concept;
  skos:prefLabel "fysische eigenschappen"@nl;
  skos:scopeNote "De fysische eigenschappen van een stof omvatten sterkte, kleur, dichtheid, magnetisme en andere kenmerken die men kan waarnemen zonder de chemische structuur te veranderen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3b69dad8-b35d-4520-ae3d-4953821ec83f>
  a skos:Concept;
  skos:prefLabel "halsen (knie)"@nl;
  skos:scopeNote "Het middelste, gebogen deel van een houten knie. (Woordenlijst Bataviawerf)"@nl;
  skos:altLabel "hals (knie)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/77f91bd1-4367-448a-903c-da826fa40e88>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3b7f219c-066b-4de1-adfa-5b2e7fbbc384>
  a skos:Concept;
  skos:prefLabel "polyamide weefsel"@nl;
  skos:scopeNote "Een polyamide weefsel is gemaakt van nylon."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3baba787-6314-4446-867a-4f13f8144102>
  a skos:Concept;
  skos:prefLabel "UHU Hart"@nl;
  skos:scopeNote "UHU Hart is een in de handel verkrijgbare lijm die wordt gebruikt bij de conservering van poreuze ceramiek. Het is een oplossing van cellulosenitraat, weekgemaakt met dibutylftalaat."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fce84563-8f36-41ce-a0bb-7f6c03e83e8d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3be4e0fb-d416-4020-9477-da296fca8bf8>
  a skos:Concept;
  skos:prefLabel "ritsmessen"@nl;
  skos:scopeNote "De rits bestaat uit een langwerpig ijzer met een omgesmede punt die scherp is geslepen."@nl,
    "Ritsmessen zijn gutsvormige messen waarbij het mes schuin naar het handvat is gericht. Met een trekkende beweging worden met ritsmessen lijnen of ruitpatronen op klompen getrokken."@nl;
  skos:altLabel "groefmes"@nl, "rits (gereedschap)"@nl, "ritsen (gereedschap)"@nl, "ritsmes"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2ed04729-7ad2-4346-ae14-74dda34a3163>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3bed381c-2ec1-4c95-a515-b803cda97482>
  a skos:Concept;
  skos:prefLabel "raamspuiten"@nl;
  skos:scopeNote "Een raamspuit werd gebruikt bij het ramenwassen. De spuit werd in een emmer met water geplaatst en door middel van de pompbeweging werd water tegen de ramen gespoten."@nl;
  skos:altLabel "raamspuit"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3bf5d2d0-c4da-453c-9d65-0b5fc18b7a42>
  a skos:Concept;
  skos:prefLabel "kistpedalen"@nl;
  skos:scopeNote "Het kistpedaal is een oude verschijningsvorm van het pedaal waarbij de toetsen zijn ingebouwd in een kist en alleen het bovenste gedeelte, het aanslagvlak, boven het deksel van de kist uitsteekt. Dit klavier wordt uitsluitend met de voetspitsen bespeeld. In de 19e eeuw raakte dit type pedaal buiten gebruik. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "kistpedaal"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/68f1e279-2c75-4aa1-aeb7-eb1d7292768e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3bf91316-dc30-47c3-a6eb-a290c652090b>
  a skos:Concept;
  skos:prefLabel "beheerregels"@nl;
  skos:scopeNote "Door de Secretaris-generaal, op grond van artikel 14 van het Archiefbesluit, vastgestelde regels voor de regeling en toebedeling van taken en verantwoordelijkheden voor het beheer van informatie."@nl;
  skos:altLabel "beheerregel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/72cf2664-95be-48a7-86cd-ac8e220dbb99>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3c7a0e1c-46a3-4a6f-af91-37f61029638e>
  a skos:Concept;
  skos:prefLabel "artefact (geluid)"@nl;
  skos:scopeNote "Een artefact is een vibrerend achtergrondgeluid dat hoorbaar is in een digitale opname die met een computer bewerkt is. Het wordt veroorzaakt door het overmatig weghalen van informatie uit het digitale signaal ter bestrijding van sisklanken en ruis in de opname."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cea5f41e-f9e4-42a3-a2e4-b0a0977bfa39>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3c7e62a5-46b1-4697-becb-1d6f4f0d03b8>
  a skos:Concept;
  skos:prefLabel "hoefstempels"@nl;
  skos:scopeNote "Hoefstempels zijn de doorslagen voor het slaan van gaten in hoefijzers."@nl;
  skos:altLabel "hoefstempel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3cabca76-4e3f-4872-9072-de95ab874e6e>
  a skos:Concept;
  skos:prefLabel "verwarmde spatels"@nl;
  skos:scopeNote "Een verwarmde spatel is een elektrisch verwarmd handgereedschap om conserveringsmaterialen zacht te maken of in een bepaalde vorm te brengen, zoals hars en was voor versteviging of voor het vullen van gaten. (Conservation Dictionary)"@nl;
  skos:altLabel "verwarmde spatel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3cc12944-1430-462c-97b7-560fa38c8ba0>
  a skos:Concept;
  skos:prefLabel "tijdcapsulen"@nl;
  skos:scopeNote "Een tijdcapsule wordt gebruikt om één of meer voorwerpen langdurig te deponeren in een cultureel betekenisvolle plek of om ze later te kunnen bergen. (Conservation Dictionary)"@nl;
  skos:altLabel "tijdcapsule"@nl, "tijdcapsules"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3ccc8a28-a88d-4b3f-9393-2c88ff462a40>
  a skos:Concept;
  skos:prefLabel "windwijzeronderdelen"@nl;
  skos:scopeNote "Windwijzeronderdelen vormen alle delen waaruit een windwijzer is opgebouwd."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b38627c8-a48a-42da-b4da-3d6b5087ee8f>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/381c92a4-99da-4784-b135-cd78485a9c6f>,
    <https://data.cultureelerfgoed.nl/term/id/cht/1c5c1eee-ae17-4c51-99b2-74631161153a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3ccf72c7-0f06-4699-b153-d95f236d9c48>
  a skos:Concept;
  skos:prefLabel "detacheren"@nl;
  skos:scopeNote "Detacheren is het lokaal voorbehandelen van een vlek voorafgaand aan chemisch reinigen. Het wordt toegepast in stomerijen. Reinigingsmiddelen in water of oplosmiddelen worden aangebracht in combinatie met borstelen of wrijven. Het type reinigingsmiddel wordt bepaald aan de hand van het soort vlek. De textiel met vlek wordt over een onderdruktafel gelegd en het reinigingsmiddel wordt aangebracht. Met behulp van een stoomapparaat wordt de vlek met het reinigingsmiddel door de textiel geblazen en afgezogen door de tafel. De textiel wordt vervolgens gedroogd met hete lucht uit hetzelfde stoomapparaat. In de textielconservering wordt een dergelijk apparaat soms gebruikt, maar wordt de zuigkracht en hitte gereduceerd om schade te voorkomen. Zie ook vlek verwijderen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3ce8c61b-9afc-455d-8345-80df603e8d39>
  a skos:Concept;
  skos:prefLabel "looprichting"@nl;
  skos:scopeNote "De looprichting van een materiaal is die richting in het materiaal waarin de meeste vezels liggen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3cf6e516-10e1-4362-a877-c0fe08eea888>
  a skos:Concept;
  skos:prefLabel "leenstelsels"@nl;
  skos:scopeNote "Het begrip leenstelsel of leenwezen, ook wel feodaal stelsel of de feodaliteit, is een bestuursvorm waarbij de leenheer zich van de persoonlijke afhankelijkheid van zijn vazallen of leenmannen verzekerde door het uitgeven van lenen."@nl;
  skos:altLabel "leenstelsel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/96f8ea1c-ab5c-42dc-975b-8ec50ae5bc66>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/180d583c-ea15-4aaa-b448-3e19ef1efec9>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3d6cd8fb-2ea1-4e69-b6d6-7efa6ae995fa>
  a skos:Concept;
  skos:prefLabel "afpaalmessen"@nl;
  skos:scopeNote "Afpaalmessen zijn messen om houtblokken een klompmodel te geven. Het zijn brede messen van ongeveer één meter lengte. Het ene uiteinde is voorzien van een dwarsgeplaatst handvat. Het andere uiteinde is voorzien van een haak waarmee ze in een kram kunnen scharnieren op een werkbank of krampaard."@nl;
  skos:altLabel "afpaalmes"@nl, "blokmes"@nl, "blokmessen"@nl, "paalmes"@nl, "paalmessen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aef9210d-0c80-4a21-84d4-fe3f4266dac6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3dac7133-7e09-4c17-8180-b86b17ccf2f3>
  a skos:Concept;
  skos:prefLabel "spiltakels"@nl;
  skos:scopeNote "Een spiltakel of een stagtakel is een takel dat boven het grootluik van een schip hangt. (bron: Zeemanswoordenboek / Jacob van Lennep)"@nl;
  skos:altLabel "spiltakel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/93c30b65-b690-40ce-91ee-08f15af8d1c2>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3dafb41f-7d98-43f6-adfc-ecaeb229e8f5>
  a skos:Concept;
  skos:prefLabel "planeren"@nl;
  skos:scopeNote "Planeren is het glad en vlak maken van een metaal (of ander materiaal) door het met een glad gepolijst metalen oppervlak te rollen of te hameren."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3dbbff13-72c8-410a-b219-e29152a6af2e>
  a skos:Concept;
  skos:prefLabel "topografische kaarten"@nl;
  skos:scopeNote "Kaart met kartografische weergave van de topografie."@nl;
  skos:altLabel "topografische kaart"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7c99f9e1-2f0f-4367-abe4-f6d72120c233>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3e1ad32e-50a3-4f10-95e4-8c3ee1bd76d7>
  a skos:Concept;
  skos:prefLabel "milieuverontreiniging"@nl;
  skos:scopeNote "Milieuverontreiniging is het totaal van verontreinigende stoffen in het milieu, in de lucht, het water en de grond."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/11e05087-998e-441f-a8c7-28450ec48805>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3e49dc70-a907-4e5a-a61c-4d64d02d549b>
  a skos:Concept;
  skos:prefLabel "DDT"@nl;
  skos:scopeNote "DDT is het acroniem voor dichloordifenyltrichloorethaan (IUPAC-naam: 1,1-bis(4-chloorfenyl)-2,2,2-trichloorethaan). Het is een insectendodend middel dat op ruime schaal op museumstukken is toegepast voor het werd verboden wegens de giftigheid voor dieren en de mens op lange termijn."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/40766ec4-4368-4614-a988-c11925841758>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3e551db5-9da4-4806-a333-29a3f9dd639b>
  a skos:Concept;
  skos:prefLabel "trekpompen"@nl;
  skos:scopeNote "Een trekpomp of lenspomp is een pomp waarbij men de zuiger, d.m.v. een stang of stok, direct met de handen op en neer moet bewegen.De totale lengte, of moet men hoogte zeggen, van de pomp was afhankelijk van de holte van het schip en was dus al gauw meer dan tweeëneenhalve meter. Dat hield in dat men bij elke slag ook de totale waterkolom in de pomp moest tillen. Gerelateerde term: krukpomp, pompemmer, pompgat, pomphart, steekpomp, vleugelkleppomp."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/578c713f-ab52-4afd-8457-db217bac57a5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3e6f509c-489f-4e7b-b3a3-fb4878e10660>
  a skos:Concept;
  skos:prefLabel "kalkpleister"@nl;
  skos:scopeNote "Kalkpleister is een mengsel van gebluste kalk met zand en andere toeslag (zoals ten behoeve van de trekvastheid) en wordt gebruikt voor het afwerken van plafonds en muren."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3edd1117-b298-435b-a4f1-f6516351b527>
  a skos:Concept;
  skos:prefLabel "concentratiecel"@nl;
  skos:scopeNote "Een concentratiecel is een galvanische cel die wordt aangedreven door een verschil tussen de concentratie van een reagens bij de anode en die bij de kathode. Dit leidt tot plaatselijke corrosie. Het gebeurt bijvoorbeeld in holtes waarin het reagens sneller wordt gebruikt in de corrosiereactie dan het door diffusie kan worden aangevoerd."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3ee2fe0b-078b-43f2-88d1-474039fd7829>
  a skos:Concept;
  skos:prefLabel "aluminiumbrons"@nl;
  skos:scopeNote "Aluminiumbronzen zijn legeringen met minimaal 70% koper en meestal 14% aluminium. Naast aluminium bevat aluminiumbrons ijzer, nikkel, mangaan of silicium, maar geen zink."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b9fd0887-297b-4bab-bea5-cb288d068816>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3efe4306-2cb3-453b-bbe7-cc4a1066e302>
  a skos:Concept;
  skos:prefLabel "vervangbaar"@nl;
  skos:scopeNote "Een vervangbaar voorwerp in een collectie wordt door de beheerder ingezet in een tentoonstelling waarbij het voorwerp risico loopt of voor educatieve doeleinden, waarbij het gehanteerd wordt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f94da6b6-f1b8-4141-b4e8-316573793d59>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3f1470b1-64b8-4ff3-b13f-48ae088c56ed>
  a skos:Concept;
  skos:prefLabel "geldtelbakken"@nl;
  skos:scopeNote "Plank met opstaande randen, aan één zijde vernauwd en zonder rand. Het gesorteerde geld wordt van de plank in een houder geschoven."@nl;
  skos:altLabel "geldtelbak"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/efa1e071-9861-4eb6-85c2-8e72b3a37ba3>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3f2921e0-52a7-40bc-b22e-66349ebca7ea>
  a skos:Concept;
  skos:prefLabel "waterafstotend materiaal"@nl;
  skos:scopeNote "Waterafstotend materiaal wordt op een oppervlak aangebracht om te verhinderen dat er water indringt. Poreuze bouwmaterialen zoals (bak)steen worden behandeld met middelen als was en siliconen, die water afstoten."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3f351401-4256-4da1-a835-10903bb5eef7>
  a skos:Concept;
  skos:prefLabel "stacco"@nl;
  skos:scopeNote "Stacco is het afnemen van een fresco van de muur door alleen de pigmentlaag en de bovenste pleisterlaag af te nemen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3f3947c3-f4ac-4847-b6e8-92822376435e>
  a skos:Concept;
  skos:prefLabel "beoordeling"@nl;
  skos:scopeNote "Een beoordeling is de overweging van de noodzaak tot conservering van een voorwerp of een collectie."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a8a85323-deee-4dba-8f23-8fa6a63a1753>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3f4b1c8c-ab80-4197-b32b-a328dcaa5435>
  a skos:Concept;
  skos:prefLabel "Hostapon T"@nl;
  skos:scopeNote "Hostapon T is een anionische oppervlakteactieve stof bestaande uit een vetzure methyltauriden en wordt geproduceerd door Hoechst. Tauriden worden gevormd uit chloorbevattende vetzuren en amino-alkaansulfonzuren (meestal met het natriumzout van methyltaurine)."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4c8b3905-3d3d-4f73-be92-a33a95f378fd>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3f85af3f-e08a-4505-ba26-9be1a07aac90>
  a skos:Concept;
  skos:prefLabel "evenredige vrachtverdeling"@nl;
  skos:scopeNote "De evenredige vrachtverdeling is een beurtregeling systeem waarbij, uit de voor transport aangeboden vrachten, de schipper die het langste op een lading wachtte, de eerste keus had. Ingevoerd in 1933, in 1998 buiten werking getreden.(bron: De Binnenvaart)"@nl,
    "De schippersbeurs beleefde een tweede jeugd in de jaren 30, opnieuw als gevolg van macro-economische factoren. De Grote Depressie bleek rampzalig voor de binnenvaart en de levensstandaard van de schippers daalde snel. Ook nam in deze periode de vrachtauto in toenemende mate vervoer over van de binnenvaart. In 1933 werd de als tijdelijk bedoelde Wet op de Evenredige Vrachtverdeling aangenomen in de Tweede Kamer. Binnenvaartverladers werden daarmee weer verplicht om hun vracht via de beurzen aan te bieden, tegen de door de overheid vastgestelde minimumtarieven. Nederland werd verdeeld in 19 rayons, per rayon was er een schippersbeurs. Deze Evenredige Vrachtverdeling gold alleen voor het ongeregeld binnenlands beroepsvervoer van droge lading, de zogenaamde wilde vaart.(bron: Wikipedia)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/96f8ea1c-ab5c-42dc-975b-8ec50ae5bc66>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3fb82a33-ca48-49cb-9c86-f563260b9165>
  a skos:Concept;
  skos:prefLabel "dichroïsme"@nl;
  skos:scopeNote "Dichroïsme is het optische effect waardoor een glas verschillende kleuren vertoont afhankelijk van de hoek waaronder het licht erop valt. Dit effect wordt bereikt door een beetje colloïdaal goud aan de glassmelt toe te voegen. In doorvallend licht ziet het er rood uit en olijfgroen in weerkaatst licht."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3feef239-91fd-4f62-9cd2-f392e9e40a39>
  a skos:Concept;
  skos:prefLabel "acrylpolymeer"@nl;
  skos:scopeNote "Een acrylpolymeer is afgeleid van acrylaat-, methacrylaat- of acrylnitril-monomeren. Het polymeer kan worden gebruikt als hars, dispersie, vezel en gietmateriaal."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/362a9c1d-41b3-46e0-bb2c-f3f3cfdc21b0>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/bfa7b209-5f40-4e75-a08a-baa02a9efa2c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/40051232-027d-4d4e-b5c3-64fe49fbe833>
  a skos:Concept;
  skos:prefLabel "krimp (fysiek)"@nl;
  skos:scopeNote "Krimp is de afname van het volume of de lengte. Krimp kan ondermeer optreden bij het drogen of stollen van een lijm. Krimp is het afnemen van de maat van een filmdrager van cellulosenitraat of -acetaat, dat veroorzaakt wordt door het uiteenvallen van het materiaal door veroudering."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/401e8b2d-b919-4de2-8210-8ac88bd58b7c>
  a skos:Concept;
  skos:prefLabel "normaal-(oxidatie-)potentiaal"@nl;
  skos:scopeNote "De normaal-(oxidatie)potentiaal van een metaal geeft aan bij welke elektrodepotentiaal (e.m.k., elektromotorische kracht) ten opzichte van een standaard waterstofelektrode (referentie) een metaal onder standaard omstandigheden tot ion wordt geoxideerd."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cea5f41e-f9e4-42a3-a2e4-b0a0977bfa39>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/405afcce-ce0d-4520-bbc9-3b45d586f2aa>
  a skos:Concept;
  skos:prefLabel "tussenschieten"@nl;
  skos:scopeNote "Tussenschieten is het aanbrengen van een vel papier of plastic tussen de pagina's van een boek of tussen foto's om ze te beschermen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4079d9e7-2c3b-4e97-bd40-9c003fa87cb2>
  a skos:Concept;
  skos:prefLabel "schoorsteenvegers"@nl;
  skos:scopeNote "Schoorsteenvegers zijn ambachtsmannen die schoorstenen vegen en vrijmaken van obstakels. Als belangrijk stuk gereedschap gebruiken zij een ijzeren kogel met borstel waaraan een lang touw zit. De tegenwoordige schoorsteenvegers zijn schoorsteenkanaal-specialisten die met camera’s de kanalen kunnen inspecteren, lekken kunnen traceren en andere aanverwante problemen kunnen oplossen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "schoorsteenveger"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db4a7619-d236-4b14-8e79-b4a6e890f677>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/407f3651-b0b4-4163-89ad-dbc7a82afe19>
  a skos:Concept;
  skos:prefLabel "reinigend onderzoeken"@nl;
  skos:scopeNote "Reinigend onderzoeken is het verwijderen van een deel van aangegroeide lagen of gedegradeerd oorspronkelijk materiaal om details bloot te leggen. Hierbij wordt ernaar gestreefd om het object zoveel mogelijk intact te laten."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/40a7620c-00ad-46f8-9041-7db29d9bb98e>
  a skos:Concept;
  skos:prefLabel "diepladers"@nl;
  skos:scopeNote "Een dieplader is een soort oplegger die gebruikt wordt voor het vervoer van hoge ondeelbare voorwerpen."@nl;
  skos:altLabel "dieplader"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4a681b3c-12b7-454a-a36c-56aa3f7d3fa5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/40af904e-283e-4e1c-91b8-eaa17391a9ec>
  a skos:Concept;
  skos:prefLabel "polyester weefsel"@nl;
  skos:scopeNote "Polyester weefsels zijn weefsels geweven uit polyethyleentereftalaat (PET), met handelsnamen als Dacron, Tergal en Teryleen. Deze vezels werden in 1941 geïntroduceerd."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b0602086-c6e6-4e06-9591-7ef265298546>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/7605ef7b-c99c-4a7c-b97e-45388712a4c0>,
    <https://data.cultureelerfgoed.nl/term/id/cht/434aa0e9-f84e-4a35-a627-2a18a3379d3a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/40b1e8ac-f43c-4bd0-8b7b-3dfc07b97931>
  a skos:Concept;
  skos:prefLabel "looien"@nl;
  skos:scopeNote "Wanneer een huid gelooid wordt om er leer van te maken wordt hij blootgesteld aan chemicaliën die de collageenstructuur stabiliseren zodat er een flexibel vel ontstaat."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/6b2d0fe2-b2a3-40d4-9bc9-550ce41abcf6>,
    <https://data.cultureelerfgoed.nl/term/id/cht/c3b8d462-db59-49b1-a429-7cc335fb3793>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/40c7653c-554e-4ebc-940e-74bedf3fc90b>
  a skos:Concept;
  skos:prefLabel "glansafwerking"@nl;
  skos:scopeNote "Glansafwerking is het glanzende oppervlak dat glazen voorwerpen krijgen door ze na de vervaardiging te verhitten in de herverhittings- of hulpoven. Deze werkwijze doet onvolkomenheden verdwijnen evenals het doffe oppervlak dat soms uit de gietvorm komt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e36ca7c3-09bf-41e4-a2bb-a7c2bed7f806>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4115b9d5-8d38-48df-82a4-d1d72ad6b640>
  a skos:Concept;
  skos:prefLabel "Vel-mix"@nl;
  skos:scopeNote "Vel-mix is een materiaal dat op tandartsengips lijkt, maar dat wat duurzamer en harder is. Het wordt gebruikt als vul- en steunmateriaal voor zware voorwerpen, waaronder gestapeld glas."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/36b72cb5-11b8-4523-9666-926c26fd7297>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/411c8c02-0672-46f4-a935-b2dc22e27385>
  a skos:Concept;
  skos:prefLabel "ijsfabrikanten"@nl;
  skos:scopeNote "IJsfabrikanten zijn eigenaars van kunstijsproducerende bedrijven. Er wordt zowel ijs voor koeling als voor consumptie geproduceerd. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "ijsfabrikant"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db4a7619-d236-4b14-8e79-b4a6e890f677>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/416d3378-0d91-481b-8a61-ccb3917df26e>
  a skos:Concept;
  skos:prefLabel "argentarium"@nl;
  skos:scopeNote "Argentarium is de Latijnse naam voor een legering van tin en lood. Wegens de zilvergrijze kleur werd het door de Romeinen gebruikt als beschermings- en versieringslaag, hoofdzakelijk voor voorwerpen gemaakt van koperlegeringen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b9fd0887-297b-4bab-bea5-cb288d068816>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/41826744-faff-40ba-a9a0-ba4755cc1cff>
  a skos:Concept;
  skos:prefLabel "zichtkant"@nl;
  skos:scopeNote "De zichtkant is de kant van de schilderijlijst die aan de afbeelding grenst."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/41b4f6cb-ea7e-4d89-8459-0ec32d069ecb>
  a skos:Concept;
  skos:prefLabel "showmappen"@nl;
  skos:scopeNote "Een showmap is een draagbare map om gedaan werk in de vorm van foto's, tekeningen en toelichtende teksten te kunnen laten zien. (Conservation Dictionary)"@nl;
  skos:altLabel "showmap"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2dbee58b-45dd-4f95-911d-19ac704d31ee>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/41e3d242-899e-4eb3-8e6e-d179e6b1a07f>
  a skos:Concept;
  skos:prefLabel "vélocipèdes"@nl;
  skos:scopeNote "Te gebruiken voor twee- of driewielige, eenvoudig gebouwde, lichte voertuigen die door de berijder, die schrijlings op de middenstang zit, werden aangedreven door middel van pedalen, trappers, hendels of met de voeten direct op de grond; al of niet bestuurbaar en met een voorwiel dat vaak groter was dan het achterwiel (of wielen); meestal beperkt tot die voertuigen die werden gebouwd vanaf eind 18e eeuw tot rond 1870. Gebruik 'fietsen' voor soortgelijke lichte voertuigen met twee wielen achter elkaar en comfort- en snelheid vergrotende kenmerken, die na ongeveer 1870 werden gemaakt en 'driewielers (fietsen)' voor versies met drie wielen. (AAT-Ned)"@nl;
  skos:altLabel "vélocipède"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/27f18a43-a2aa-4b07-a601-e083756f1874>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/41ff6389-362d-461c-9cb4-89352e6b8d8a>
  a skos:Concept;
  skos:prefLabel "rigatino"@nl;
  skos:scopeNote "Rigatino ('chromatische selectie') is een retoucheertechniek voor schilderingen; een lacune wordt ingeschilderd door verf in vloeiende lijnen op te brengen, in lijn met de originele penseelstreken."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/42024b71-30fb-4f6a-907e-14f0dd631f42>
  a skos:Concept;
  skos:prefLabel "zilversulfide"@nl;
  skos:scopeNote "Zilversulfide (Ag<sub>2</sub>S) is een veelvoorkomend zwart corrosieproduct op zilver. Het wordt gebruikt voor niello (inlegwerk in metaal)."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4229560d-cfb0-4c5c-84f5-4ab68fe95d5e>
  a skos:Concept;
  skos:prefLabel "VHS-C"@nl;
  skos:scopeNote "VHS-C is een kleinere versie van VHS voor gebruik in camcorders. Het kan worden afgespeeld in een gewone VHS machine met gebruikmaking van een adapter om de cassette passend te maken. De breedte van de band is dezelfde als die van VHS. (Conservation Dictionary)"@nl;
  skos:altLabel "VHS-Compact"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/803bc11d-2768-4154-954f-34321916e749>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/422a7867-1f8e-4fda-b3a8-68f03ef4b961>
  a skos:Concept;
  skos:prefLabel "papier splitsen"@nl;
  skos:scopeNote "Papier splitsen is de eerste fase van een manier om een vel papier te verstevigen. Het papier wordt mechanisch in twee lagen gesplitst en deze worden in een tweede fase weer op elkaar geplakt met een nieuw vel papier er tussenin."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4262f17c-cbad-4330-9158-7a3ce7840ab3>
  a skos:Concept;
  skos:prefLabel "Carbowax"@nl;
  skos:scopeNote "Carbowax is een hydrofiele (waterminnende) was op basis van polyethyleenglycol (PEG 6000). Het is gebruikt voor het verstevigen van aangetast archeologisch glas."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/23f4a4f6-51d8-47e6-9dc0-15f0647bfc02>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4285b4a7-a97a-47ae-a658-fc8ee6ae94e5>
  a skos:Concept;
  skos:prefLabel "glasvezeldoek"@nl;
  skos:scopeNote "Glasvezeldoek is doek van of met glasvezel."@nl;
  skos:altLabel "GRP"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/46e4c36b-b42e-4da4-84c9-5bca3e11440a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/428689cc-8e8a-4829-b048-6cc605b9d92b>
  a skos:Concept;
  skos:prefLabel "paratacamiet"@nl;
  skos:scopeNote "Basisch koperchloride, paratacamiet [Cu<sub>2</sub>(OH)<sub>3</sub>Cl], is een kenmerkend mineraal bestanddeel van het groene patina op koper. De kristalstructuur verschilt van die van atacamiet."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/42b0bcb9-153c-469d-9375-95fbc02e4345>
  a skos:Concept;
  skos:prefLabel "pietra paesina"@nl;
  skos:scopeNote "Pietra paesina is een geelbruine kalksteen bestaande uit calciet met ijzer(III)hydroxide. Het werd met name in de 17e eeuw in Toscane gebruikt als starre schildergrond."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b003b3b2-65d1-4aa7-bbe4-c035ae230c53>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/42c98513-bd0c-4132-98df-cf458040201f>
  a skos:Concept;
  skos:prefLabel "staande klokken"@nl;
  skos:scopeNote "De staande klok is een klok, waarvan het uurwerk wordt aangedreven door een gewicht of gewichten, waarbij dit uurwerk is geplaatst in een houten kast, die één geheel vormt, doordat de achterwand van onder tot boven doorloopt en normaliter op de grond is geplaatst. (Henk Houkes)"@nl;
  skos:altLabel "staande klok"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c86f3489-a69b-45f1-b4a6-379c7c7ea551>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/42e230a3-20be-4868-b296-2d2c4892501e>
  a skos:Concept;
  skos:prefLabel "dubbele bedoeking"@nl;
  skos:scopeNote "Dubbele bedoeking is een conserveringsbehandeling waarbij een tweede bedoeking achter de eerste wordt geplakt. Dit kan nodig zijn als de eerste bedoeking onvoldoende stevigheid heeft opgeleverd voor het schilderij."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/42f5c793-0399-4a1c-a614-d2a164c2f445>
  a skos:Concept;
  skos:prefLabel "frequentiebereik"@nl;
  skos:scopeNote "Het frequentiebereik van een geluidsdrager is het vermogen van die drager om een vastgelegd bereik van frequenties en harmonieën precies op te nemen en weer te geven. Minidiscs bijvoorbeeld hebben een frequentiebereik van 5Hz tot 20kHz, de frequenties benodigd om muziek weer te geven."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/43003c45-7262-4098-9031-1a16cfe28d0b>
  a skos:Concept;
  skos:prefLabel "strooilicht"@nl;
  skos:scopeNote "Strooilicht is licht dat in een optisch systeem (lenzenstelsel) verstrooid wordt en dat geen beeld vormt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/432e61bc-bc26-4d06-b813-12c0f153e1fb>
  a skos:Concept;
  skos:prefLabel "kortzwaarden"@nl;
  skos:scopeNote "Het kortzwaard is een gevechtswapen. Qua vorm is het vergelijkbaar met een normaal zwaard, maar het heeft ten opzichte van een normaal zwaard een korter blad of kling."@nl;
  skos:altLabel "kortzwaard"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4830960f-3cb9-4b89-b44e-7f49c6b72e9d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/432fa681-df0d-452f-9289-9496b890847f>
  a skos:Concept;
  skos:prefLabel "cumulatieve dosis"@nl;
  skos:scopeNote "De cumulatieve dosis licht is de hoeveelheid licht waaraan een voorwerp is blootgesteld geweest. De dosis wordt berekend door de verlichtingssterkte te integreren over de periode van blootstelling. Dit wordt meestal gedaan door de verlichtingssterkte (in lux) aan het oppervlak van het voorwerp regelmatig te meten en het gemiddelde ervan te berekenen. De gebruikelijke eenheid voor de dosis is het lux-uur."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cea5f41e-f9e4-42a3-a2e4-b0a0977bfa39>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/433a66ae-97f2-4d13-92fc-b6448c65dbb1>
  a skos:Concept;
  skos:prefLabel "diepvriezen"@nl;
  skos:scopeNote "Als een voorwerp wordt diepgevroren, wordt het in een diepvriezer geplaatst, gewoonlijk bij een temperatuur beneden -20°C. Als diepvriezen wordt gebruikt om insecten te doden wordt het voorwerp eerst ingeseald in een plastic zak om veranderingen in vochtgehalte en daaruit voortkomende vervorming tegen te gaan en dan gekoeld tot onder de -30°C. Diepvriezen is de eerste stap om te kunnen vriesdrogen in geval van waterschade of van geheel doordrenkte archeologische vondsten."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4343207d-674e-4594-9057-75890d011e1f>
  a skos:Concept;
  skos:prefLabel "dubbeldeksopleggers"@nl;
  skos:scopeNote "Dubbeldeks oplegger: deze oplegger heeft een laadruimte met twee etages. Laden en lossen is alleen mogelijk via de achterkant. Deze oplegger wordt vooral gebruikt voor supermarkten en dergelijke."@nl;
  skos:altLabel "dubbeldeksoplegger"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4a681b3c-12b7-454a-a36c-56aa3f7d3fa5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/43446dd6-7b6f-4974-85ce-b54d6bf6ba6a>
  a skos:Concept;
  skos:prefLabel "nomenclatuur"@nl;
  skos:scopeNote "Nomenclatuur is een gestandaardiseerd systeem voor benaming, omschrijving en herkenning van verschillende soorten."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dc1ed021-8bd6-4ce2-afdf-883cfd629ac7>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/438d044e-a7d9-40d6-84da-9adbbbae842c>
  a skos:Concept;
  skos:prefLabel "registerwippers"@nl;
  skos:scopeNote "Verschijnt doorgaans rond het eind van de 19de - begin 20ste eeuw ter vervanging van de grote registertrekkers die op een orgel met een pneumatisch of elektrisch regeerwerk overbodig waren geworden. Registerwippers kunnen van hout zijn, van ivoor en vaak ook van plastic. Hun hoogte is 5 tot 6 cm bij een breedte van 2 tot 3 cm, zodat ze aan de speeltafel minder plaats innemen en de bediening van de registers dichter bij de manualen brengen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "registerwipper"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cf51f60b-c1bb-4c17-b938-17e1dacb6e7c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4398a580-4dfa-4150-a6f9-ce262509af8f>
  a skos:Concept;
  skos:prefLabel "informatiebeheersystemen"@nl;
  skos:scopeNote "Het geheel van mensen, methoden, procedures, gegevensverzamelingen, programmatuur, apparatuur, voorzieningen en andere middelen, bestemd tot het beheer van informatie."@nl;
  skos:altLabel "informatiebeheersysteem"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2911bf19-4011-4440-a4b3-464be28f70c5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/43ac4105-a066-40fe-a2a8-75d376e14de7>
  a skos:Concept;
  skos:prefLabel "spoelenopnames"@nl;
  skos:scopeNote "Een spoelen(recorder)opname is een opname gemaakt op geluidsband die opgespoeld is op open spoelen in plaats van in een cassette. (Conservation Dictionary)"@nl;
  skos:altLabel "spoelenopname"@nl, "spoelenrecorderopname"@nl, "spoelenrecorderopnames"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91712616-6dec-4871-8fdc-c317850c20d1>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/63be41c0-651c-4c8d-bcf7-77813e9aeff9>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/43b16580-ccbe-4a41-a23f-0904e21ac11c>
  a skos:Concept;
  skos:prefLabel "witkalk"@nl;
  skos:scopeNote "Witkalk is verf bestaande uit kalk en water. Witsel is fijngemalen calciumcarbonaat. Witkalk is een aloud afwerkingsmateriaal voor muren binnen en buiten. Het is een suspensie van calciumhydroxide in water met of zonder toevoeging van pigment. Het wordt op muren aangebracht als een beschermende laag."@nl;
  skos:altLabel "witsel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7f7416bf-634e-470e-b4de-00a2a439409c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/43be6bf0-4d68-4b3d-8fe7-7604bdb3e565>
  a skos:Concept;
  skos:prefLabel "tienden"@nl;
  skos:scopeNote "De tiende werd in Europa in de 8ste eeuw ingevoerd en was bedoeld als een sociale belasting, die moest dienen ter financiering van de armenzorg, het levensonderhoud van parochiepriesters en de instandhouding van kerkgebouwen. De regel was dat iedereen een tiende deel van zijn oogst zou afdragen. De inning gebeurde aanvankelijk in natura, waarbij men letterlijk een tiende deel van een oogst op de velden ging ophalen. De tienden konden worden opgeslagen in een tiendschuur. In dorpen waar de tiende door meerdere partijen werd opgehaald, werd het inningsgebied zorgvuldig afgebakend of via een tiendebeschrijving te boek gesteld. In latere tijden werd de tiende dikwijls verpacht aan een zogenaamde tiendesteker en werd de tiende ook wel voldaan in klinkende munt."@nl;
  skos:altLabel "tiende"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9e422627-b366-4192-9001-7f7d2ac4e128>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/43f63bd7-1bb2-4d77-8e37-43bfa3f37dee>
  a skos:Concept;
  skos:prefLabel "balansklavieren"@nl;
  skos:scopeNote "In tegenstelling tot het staartklavier, bevindt het steunpunt van het balansklavier zich halverwege. Het uiteinde van de toets is verbonden met de speelmechaniek. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "balansklavier"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/67f9744b-f459-4244-af93-2758efab2253>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/443aed3d-d775-4183-8ca8-d3315d664e68>
  a skos:Concept;
  skos:prefLabel "polycyclohexanonhars"@nl;
  skos:scopeNote "Polycyclohexanonhars is een synthetische hars gemaakt uit cyclohexanon, soms met methylcyclohexanon. Voorbeelden zijn Laropal K en Ketonhars N. Het polymeer werd in 1930 door BASF gepatenteerd. Deze harsen zijn als schilderijenvernis gebruikt in de plaats van natuurlijke harsen zoals damar."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4451804d-2795-4032-aa5d-e382dd7b75b6>
  a skos:Concept;
  skos:prefLabel "minivans"@nl;
  skos:scopeNote "Een minivan / ludospace is een type personenauto met veel binnenruimte, vooral door zijn hoogte, en veel praktische mogelijkheden. De auto's zien er uit of ze zijn gebaseerd op een kleine bestelauto, wat soms ook zo is. In Duitsland worden deze auto's Hochdachkombis genoemd, in Engelstalige landen leisure activity vehicles en in Italië multispazio; in Nederland wordt de van oorsprong Franse benaming ludospace gebruikt."@nl;
  skos:altLabel "minivan"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dec3cb60-0105-49ac-a19f-d52c1f1ac5b4>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4453f993-2ffb-4282-a962-ca3bf6cbfb25>
  a skos:Concept;
  skos:prefLabel "versteende mortel"@nl;
  skos:scopeNote "Versteende mortel is mortel die door reactie met kooldioxide uit de lucht (carbonatatie) en de verdamping van water hard geworden is. Dit leidt gewoonlijk tot de krimp van de mortel afhankelijk van de toeslag."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/76079c9c-8e0d-4487-a35c-c1793bbaf0d7>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/445d011d-dbe1-47b0-a570-d23953267d63>
  a skos:Concept;
  skos:prefLabel "lengtebepaling"@nl;
  skos:scopeNote "Lengte is de grootste afmeting van een object (de grootste afstand tussen twee punten). Het meten van die lengte wordt lengtebepaling genoemd."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/36963dcd-7f11-4902-8e8e-91eb92ad8ffd>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/29543d4e-06df-4c74-b8ad-fb7a43cd13ad>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4469fe77-18a8-49af-a073-260ed1a3c7d1>
  a skos:Concept;
  skos:prefLabel "rouwborden"@nl;
  skos:scopeNote "Een veelal ruitvormig schilderij met daarop geschilderd het opschrift ‘obiit’, geboorte- en sterfdatum en eventueel wapenschild van een overledene. Werd tot aan het einde van de achttiende eeuw bij een begrafenis voor de kist uitgedragen en kreeg zijn plaats in de nabijheid van het graf in de kerk. Voor de reformatie gebruik van de adel, daarna overgenomen door de burgerij, maar nam af of verdween plaatselijk geheel. (Religieus Erfgoedthesaurus)"@nl;
  skos:altLabel "rouwbord"@nl, "rouwkas"@nl, "rouwkassen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2e44391b-0677-4f76-a9be-d9b3289b8108>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/44b6b237-8a4f-4ee3-b996-4d6b885ff311>
  a skos:Concept;
  skos:prefLabel "nylon"@nl;
  skos:scopeNote "Nylon is een synthetisch, thermoplastisch polyamide, dat gemaakt kan worden van diverse monomeren. Het wordt geproduceerd als vezel en als vaste kunststof. Er zijn twee types: nylon 6,6 en nylon 6. Nylon 6,6 wordt gemaakt van adipinezuur en hexamethyleendiamine. Nylon 6 wordt gemaakt van het cyclische caprolactam. Beide types bevatten aminogroepen maar worden niet gerekend tot de proteïnen. Nylon wordt sinds 1940 toegepast."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/832a8f9f-4437-489d-b914-8cc0e2934920>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/6a69f1a2-80e7-44bc-9438-d3b46162cd20>,
    <https://data.cultureelerfgoed.nl/term/id/cht/b1a197dd-70a2-4d13-8c30-810964ff17d5>,
    <https://data.cultureelerfgoed.nl/term/id/cht/c338bc00-d9be-4664-9a65-fd573f6cbb99>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/44d10dbf-ecdf-4fcb-a290-357b236b44d0>
  a skos:Concept;
  skos:prefLabel "verdoeken"@nl;
  skos:scopeNote "Verdoeken is het vervangen van eerdere bedoeking van een schilderij door een nieuwe bedoeking. De oude bedoeking en de lijm worden verwijderd en het schilderij wordt met nieuwe lijm gehecht aan een nieuw steundoek."@nl;
  skos:altLabel "verdoeking"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/44d423a4-5d7c-4260-8709-87e4264d46e4>
  a skos:Concept;
  skos:prefLabel "injecteren"@nl;
  skos:scopeNote "Men injecteert een vloeistof in een materiaal door de vloeistof in de structuur te dwingen met behulp van een injectiespuit of iets dergelijks."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/44e15e36-efa8-4c06-929f-0e386eaa8a66>
  a skos:Concept;
  skos:prefLabel "dye"@nl;
  skos:scopeNote "Een dye is een afdruk gemaakt met het kleuroverdrachtprocédé. (Conservation Dictionary)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91712616-6dec-4871-8fdc-c317850c20d1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/44f4a4e6-02c0-4992-b4e3-3b692294c7b3>
  a skos:Concept;
  skos:prefLabel "van beschermend glas voorzien"@nl;
  skos:scopeNote "Men kan een schilderij, kabinet, vitrine of raam van beschermende beglazing voorzien door een extra glaslaag aan te brengen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/44fd6cc1-8fec-43ad-90f4-8e02ade6e150>
  a skos:Concept;
  skos:prefLabel "zoneren"@nl;
  skos:scopeNote "Zoneren is het bepalen van verschillende bestemmingen en ontwikkelingsmogelijkheden in en rond stedelijke gebieden. Zoneren is het inrichten van museale en vergelijkbare ruimten waarbij voorwerpen of collecties geordend worden op grond van de omgevingsomstandigheden die ze nodig hebben."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/190b9fce-fb0d-4b41-b46d-e1795ae38304>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4503b621-c02c-46a9-affa-c363979d9935>
  a skos:Concept;
  skos:prefLabel "anhydriet"@nl;
  skos:scopeNote "Anhydriet is watervrij calciumsulfaat, CaSO<sub>4</sub>, dat wordt gebruikt in de gesso grosso-laag van (Italiaanse) paneelschilderingen. Het wordt gemaakt door gips te verhitten en zo het daarin aanwezige water te verdrijven."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/541cf6bb-3273-4fa4-bcc8-8f579f552c03>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/45199b04-a599-4eea-8990-7f98fd8ffb3d>
  a skos:Concept;
  skos:prefLabel "veiligheidsbeambten"@nl;
  skos:scopeNote "Een veiligheidsbeambte is iemand die verantwoordelijk is voor het uitvoeren van veiligheidsmaatregelen."@nl;
  skos:altLabel "veiligheidsbeambte"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db4a7619-d236-4b14-8e79-b4a6e890f677>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/455f5fee-f6b5-42b2-a3cd-4e39f5c08c61>
  a skos:Concept;
  skos:prefLabel "naloop hoeken"@nl;
  skos:scopeNote "De naloop , ook wel naspoor genoemd, is het verschil tussen het raakpunt van een denkbeeldige lijn door het balhoofd van een tweewieler en het raakpunt van het voorwiel op de weg. Deze bepaalt het stuurgedrag van een wiel in hoge mate."@nl;
  skos:altLabel "naloop hoek"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/929f2b49-e558-4543-a710-41a893c3c5dd>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4565c2af-c479-4e2c-aa08-9a497eeb49d7>
  a skos:Concept;
  skos:prefLabel "elektrische auto's"@nl;
  skos:scopeNote "Een elektrische auto of EV (Elektrisch Voertuig) is een wegvoertuig dat wordt aangedreven door een elektromotor, die gebruikmaakt van elektriciteit die afkomstig is van bijvoorbeeld chemische energie die wordt opgeslagen in accu's of uit een brandstofcel."@nl;
  skos:altLabel "elektrische auto"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dec3cb60-0105-49ac-a19f-d52c1f1ac5b4>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/457b9532-6244-41f2-91d5-7c738635b4f7>
  a skos:Concept;
  skos:prefLabel "waterrand"@nl;
  skos:scopeNote "Een waterrand is een scherp begrensde verkleuring veroorzaakt door water. Het water lost afbraakproducten uit het papier op die naar het oppervlak van het papier migreren tijdens het drogen en zich concentreren op de plaats waar het papier het laatst droogt. Een waterrand is vaak de begrenzing van een vochtplek."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/45be42fc-7781-4066-ad3b-107ec8e061f0>
  a skos:Concept;
  skos:prefLabel "plantverbanden"@nl;
  skos:scopeNote "Plantverbanden geven het patroon tussen planten of bomen aan. Er kan zowel een esthetische als een functionele overweging zijn voor de keuze voor een plantverband, of een combinatie daarvan. Bijvoorbeeld een goede luchtcirculatie evenals een regelmatig beeld in een boomgaard. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "plantverband"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/45ed5ca1-cbbc-42b9-93e2-a7fa7df13c7f>
  a skos:Concept;
  skos:prefLabel "koelopleggers"@nl;
  skos:scopeNote "Koeloplegger: speciaal voor temperatuurgeleide transporten, om goederen koel, bevroren of warm te houden. De oplegger is voorzien van geïsoleerde vloer, wanden en dak, en heeft aan de voorkant een koelmotor, die aangedreven wordt op diesel (eigen tank). Lengte van laadvloer 13,2 meter, hoogte 2,55 meter, breedte 2,45 meter."@nl;
  skos:altLabel "koeloplegger"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4a681b3c-12b7-454a-a36c-56aa3f7d3fa5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/45edfc1b-a2a3-44fb-a255-c1cdf8a56f51>
  a skos:Concept;
  skos:prefLabel "rotstekeningen"@nl;
  skos:scopeNote "Een rotstekening, petroglief, is een gravering of een tekening in een rots. (Conservation Dictionary)"@nl;
  skos:altLabel "rotstekening"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/eb9e1e5b-b319-4519-a4f5-0dd26dbf4524>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/45f8e8df-82cd-400a-979c-08d634bb4126>
  a skos:Concept;
  skos:prefLabel "grading"@nl;
  skos:scopeNote "Grading is de techniek van het controleren en bijstellen van de algehele optische dekking en kleurbalans van een (speel)filmkopie."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4618fec4-9022-4b3b-83c9-542b50f8adda>
  a skos:Concept;
  skos:prefLabel "op dubbele binding"@nl;
  skos:scopeNote "Op (met) dubbele binding naaien is een techniek waarbij de katernen van een boek aan dubbele opliggende touwen genaaid worden en waarbij het naaigaren de katern door het zelfde naaigat in- en uitgaat."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/461d88c4-a46f-4dbb-a137-a9266eae7a42>
