<https://data.cultureelerfgoed.nl/term/id/cht/8defb510-0124-4ce0-8fe0-103ad3dc5a06>
  a skos:Concept;
  skos:prefLabel "lichtkasten"@nl;
  skos:scopeNote "Een lichtkast is een kast die een fotograaf gebruikt om schaduwen weg te werken bij productfotografie. Een lichtkast bestaat uit een 'kast' waarin een soort van lamp achter een matglazen plaat zit. Zo worden de sterke schaduwen weggewerkt. (Wikipedia)"@nl;
  skos:altLabel "lichtkast"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/95098be3-5c28-4eea-9847-75f0e6eb3cff>;
