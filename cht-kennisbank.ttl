  skos:scopeNote "Type schede, veelal van leer of ander flexibel materiaal, waarin je een bijl bij je draagt. (ABR)"@nl;
  skos:altLabel "bijlschede"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c5a6574c-0799-4177-883a-53dd52c858e1>;
