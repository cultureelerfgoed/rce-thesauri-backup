    "jaarversen"@nl, "tijdvers"@nl, "tijdversen"@nl, "versuschronographicus"@nl, "versuschronologicus"@nl,
    "versuseteologicus"@nl, "versusnumeralis"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dc6e2a8d-5f85-4076-a67a-271eb74136d0>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/0ad23b8e-a7c0-4454-b50a-77b31157f947>
