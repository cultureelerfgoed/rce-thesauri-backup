<https://data.cultureelerfgoed.nl/term/id/cht/21c0681d-8204-43f9-944b-d64d19916724>
  a skos:Concept;
  skos:prefLabel "quackpannen"@nl;
  skos:scopeNote "Gegolfde dakpan, in de IJsselstreek sedert c. 1465 gemaakt. De golf (wel) dekt meestal links over rechts (linksdekkend), maar soms ook rechts over links (rechtsdekkend). Met quack of kwak wordt vermoedelijk de wel ((zie)wel 3) bedoeld (Goeree 1681). (Haslinghuis)"@nl;
  skos:altLabel "quackpan"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f1834398-e32b-4a85-acf4-7f71ab3f94d1>;
