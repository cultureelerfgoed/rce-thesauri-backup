<https://data.cultureelerfgoed.nl/term/id/cht/9c93cf5e-0fa6-45bc-be8c-928fc00d3188>
  a skos:Concept;
  skos:prefLabel "formaten"@nl;
  skos:scopeNote "Het geheel van de door de vorm bepaalde afmetingen, in het bijz. van bakstenen. (Haslinghuis)"@nl;
  skos:altLabel "formaat"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/96f8ea1c-ab5c-42dc-975b-8ec50ae5bc66>;
