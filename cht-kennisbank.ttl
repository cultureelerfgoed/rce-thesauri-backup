  a skos:Concept;
  skos:prefLabel "glazenmaker hamertjes"@nl;
  skos:scopeNote "Fijn hamertje om de hechtspijkers in te slaan."@nl;
  skos:altLabel "glazenmaker hamertje"@nl;
