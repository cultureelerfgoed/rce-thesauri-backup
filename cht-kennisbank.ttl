  a skos:Concept;
  skos:prefLabel "jufferkappen"@nl;
  skos:scopeNote "Eenvoudige kapconstructie, bij voorkeur met behulp van juffers zonder dakbeschot. Gebruikt voor boerderijen, schuren en stallen. (Haslinghuis)"@nl;
