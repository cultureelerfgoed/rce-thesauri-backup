<https://data.cultureelerfgoed.nl/term/id/cht/fdec6eeb-7c2b-475a-ac17-affa1755594f>
  a skos:Concept;
  skos:prefLabel "planvoorschriften"@nl;
  skos:scopeNote "Planvoorschriften zijn voorschriften voor het ontwerpen van gebouwen, die worden gegeven door de rijks- of plaatselijke overheid."@nl;
