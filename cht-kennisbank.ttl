<https://data.cultureelerfgoed.nl/term/id/cht/0c055e55-3b99-4489-84fa-ab26105adb9d>
  a skos:Concept;
  skos:prefLabel "in het lood"@nl;
  skos:scopeNote "Loodrecht, verticaal, zoals het schietlood hangt. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
