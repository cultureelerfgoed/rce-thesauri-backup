  a skos:Concept;
  skos:prefLabel "alta kwartsiet"@nl;
  skos:scopeNote "alta kwartsiet: kwartsiet welke gewonnen wordt in Noorwegen. De steen is groengrijs van kleur, fijnschubbig van structuur en egaal te splijten. De steen heeft een hoog gehalte aan kwarts en glimmer."@nl;
  skos:altLabel "alta"@nl;
