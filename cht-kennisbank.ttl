<https://data.cultureelerfgoed.nl/term/id/cht/094de7c2-be8a-4032-8763-51e7d517588d>
  a skos:Concept;
  skos:prefLabel "charter van Athene"@nl;
  skos:scopeNote "Het Charter van Athene voor de Restauratie van Historische Monumenten is een beginselverklaring die is aangenomen door het eerste Internationale Congres van Architecten en Vaklieden voor Historische Monumenten in Athene in 1931. Het werd in 1933 gepubliceerd door het Internationale Bureau van Musea."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/72cf2664-95be-48a7-86cd-ac8e220dbb99>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d17c6798-d0f2-4264-9002-9cb3297da7cb>
  a skos:Concept;
  skos:prefLabel "straling"@nl;
  skos:scopeNote "Straling is een natuurkundig verschijnsel dat zich kan voortplanten over grote afstanden en dat in vaste stof kan doordringen. Voorbeelden zijn elektromagnetische golven (röntgenstralen, licht, centimetergolven, radiogolven) of deeltjesstraling (radioactieve α- and β-straling)."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/03a6072f-cfac-4d52-96d4-0e43405d7e2f>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/5c265d2b-7cfe-4dcc-9143-9f945b385c03>,
    <https://data.cultureelerfgoed.nl/term/id/cht/db018d4c-449d-4c8b-8ca0-fa1411bd3384>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

