<https://data.cultureelerfgoed.nl/term/id/cht/18fbb860-52e8-406c-b4f0-042115af5d1c>
  a skos:Concept;
  skos:prefLabel "dilataties"@nl;
  skos:scopeNote "De toename van een materiaal of een lichaam in lengte of volume, die wordt veroorzaakt door, bijvoorbeeld, temperatuursverandering of bevochtiging. (AAT)"@nl;
