<https://data.cultureelerfgoed.nl/term/id/cht/f448913c-68ed-4dd9-a1de-e31cf61c3637>
  a skos:Concept;
  skos:prefLabel "bariumcarbonaat"@nl;
  skos:scopeNote "Het onoplosbare bariumcarbonaat (BaCO<sub>3</sub>) ontstaat als ter versteviging van kalksteen een oplossing van bariumhydroxide wordt toegevoegd,."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
