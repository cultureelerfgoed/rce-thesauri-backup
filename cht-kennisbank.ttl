  a skos:Concept;
  skos:prefLabel "tiengebodenborden"@nl;
  skos:scopeNote "Paneel waarop de tien geboden zijn gecalligrafeerd. Hangt aan de kerkmuur of is geplaatst op het koorhek. In dit laatste geval staat er niet zelden een tekst aan schip- en koorzijde. Aan schipzijde staan de tien geboden, aan koorzijde, wanneer daar het heilig avondmaal wordt gevierd, is het avondmaalsformulier te lezen."@nl;
  skos:altLabel "10-gebodenbord"@nl, "10-gebodenborden"@nl, "10 gebodenbord"@nl, "10 gebodenborden"@nl,
