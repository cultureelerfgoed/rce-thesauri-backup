<https://data.cultureelerfgoed.nl/term/id/cht/998e404c-c4f8-4d33-967f-27e519a9ba51>
  a skos:Concept;
  skos:prefLabel "open porie"@nl;
  skos:scopeNote "Een open porie in een object is een porie die in verbinding staat met andere, waardoor het object kan worden doordrenkt met vloeistof of gas"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
