<https://data.cultureelerfgoed.nl/term/id/cht/1d7b1f3b-c6dd-4414-a1a4-3cedc172a2d5>
  a skos:Concept;
  skos:prefLabel "tuitlampen"@nl;
  skos:scopeNote "Lampen met een of meerdere pitten die door een schuin omhoog lopende rechte of gebogen buis lopen, die aan de zijkant uit de houder komt. (AAT-Ned)"@nl;
  skos:altLabel "snotneus"@nl, "snotneuzen"@nl, "tuitlamp"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d8f707ff-1866-4890-a94c-c0fe554bf797>;
