<https://data.cultureelerfgoed.nl/term/id/cht/edcb32e1-15ed-46b7-afeb-c55a1fbe762b>
  a skos:Concept;
  skos:prefLabel "Vlaamse Renaissance"@nl;
  skos:scopeNote "In het midden van de 16e eeuw werden renaissancevormen toegepast in Antwerpen, het culturele centrum van die tijd. In 1565 werd het nieuwe stadhuis van Antwerpen voltooid. Het was daarmee het belangrijkste maniëristische gebouw in de Nederlanden. (Bouwen in Nederland / Bosma, 2007)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/09eda2e2-4ec0-4b64-b40c-36d68ff919e0>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f3dcaa71-0da6-4580-9d36-fbac24555712>
  a skos:Concept;
  skos:prefLabel "grindwegen"@nl;
  skos:scopeNote "Grindwegen zijn wegen met een oppervlak van grind, vaak gebruikt in landelijke gebieden."@nl;
  skos:altLabel "grindweg"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1e309e1c-16cd-4b46-8cc6-1e5888853e49>;
