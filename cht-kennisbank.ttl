<https://data.cultureelerfgoed.nl/term/id/cht/d3b8e443-5da2-4d4f-a168-673560af45ac>
  a skos:Concept;
  skos:prefLabel "zalfstenen"@nl;
  skos:scopeNote "Glad geslepen, meestal (afgerond) rechthoekig stenen plaatje met rechte of schuinstaande zijden waarop kleurpigment of een geneesmiddel werd gemengd/aangebracht. Er kan een cirkelvormige uitholling aanwezig zijn aan de bovenzijde. (ABR)"@nl;
  skos:altLabel "schminkpalet"@nl, "schminkpaletten"@nl, "zalfsteen"@nl;
