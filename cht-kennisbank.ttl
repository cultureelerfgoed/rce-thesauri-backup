  a skos:Concept;
  skos:prefLabel "smetlijnen"@nl;
  skos:scopeNote "Smetlijn, timmergereedschap van hout en hennep. Dit gereedschap wordt gebruikt om rechte lijnen te trekken.(RCE)"@nl,
