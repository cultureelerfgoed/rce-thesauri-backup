<https://data.cultureelerfgoed.nl/term/id/cht/6be28cdf-4559-4640-b362-d997af721113>
  a skos:Concept;
  skos:prefLabel "vacuümruitenwissers"@nl;
  skos:scopeNote "Ruitenwissers, die door het vacuüm of de onderdruk in het inlaatspruitstuk werken."@nl;
