<https://data.cultureelerfgoed.nl/term/id/cht/85c6e364-bf1a-471f-88b2-ea62263d2d74>
  a skos:Concept;
  skos:prefLabel "lobben"@nl;
  skos:scopeNote "Lobben zijn passen, driepassen, glopen, zwellingen of kwabben die onderdeel zijn van gotisch maaswerk. Een drielobbig venster is gedekt door een boog in drie ‘passen’. (Haslinghuis)"@nl;
  skos:altLabel "lob"@nl, "lobbe"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b2b692aa-2772-40ff-94ae-4ddb99464c4d>;
