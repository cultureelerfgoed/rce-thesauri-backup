  a skos:Concept;
  skos:prefLabel "opzetspiegels"@nl;
  skos:scopeNote "Een opzetspiegel is een extra grote binnen spiegel, doe over de bestaande binnen spiegel wordt geplaatst."@nl;
  skos:altLabel "opzetspiegel"@nl;
