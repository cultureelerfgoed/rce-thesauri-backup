<https://data.cultureelerfgoed.nl/term/id/cht/fff1d07a-6f84-4ae4-b53f-c7c559d25423>
  a skos:Concept;
  skos:prefLabel "kapellenkranzen"@nl;
  skos:scopeNote "Gezamenlijke straal- of transkapellen ( kapel 1) rond de veelhoekige kooromgang. Gelden als kenmerk van kathedralen en grote kerken van de Franse en op Frankrijk georiënteerde gotiek. Zie tekeningen gotische bouwkunst en koor. (Haslinghuis)"@nl;
  skos:altLabel "kapellenkrans"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/213d40ef-1fa0-469b-9a3a-c3a435fe2e0b>;
