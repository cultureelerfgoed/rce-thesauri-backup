<https://data.cultureelerfgoed.nl/term/id/cht/c517c532-13f2-4c48-a75e-4c2a02c7a232>
  a skos:Concept;
  skos:prefLabel "Vlaamse schuren"@nl;
  skos:scopeNote "Vlaamse schuren zijn schuren waarin de werkvloer in de langsrichting ligt. Het voordeel daarvan is dat de tasruimte langs de deel komt te liggen en dus gemakkelijk gevuld kon worden."@nl;
  skos:altLabel "Vlaamse schuur"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c8a9451e-9ee0-43ae-99b8-5066f8aab68b>;
