<https://data.cultureelerfgoed.nl/term/id/cht/dc19b5b6-1329-412c-bb1a-0433139b9371>
  a skos:Concept;
  skos:prefLabel "gemeentegrenspalen"@nl;
  skos:scopeNote "Gemeentegrenspalen zijn grenspalen die de gemeentegrenzen aanduiden. Vanaf het begin van de 20ste eeuw zijn vele gemeentegrenzen veranderd ten gevolge van fusies."@nl;
  skos:altLabel "gemeentegrenspaal"@nl;
