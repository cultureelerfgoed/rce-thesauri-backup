<https://data.cultureelerfgoed.nl/term/id/cht/0ef36156-a6c0-4ed4-8f54-9434b49e5c00>
  a skos:Concept;
  skos:prefLabel "denominatie (numismatiek)"@nl;
  skos:scopeNote "De denominatie is de nominale waarde zoals die op een munt, bankbiljet of postzegel is vermeld, en die door de uitgever van het betaalmiddel wordt vastgesteld."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/499d139e-c7ec-4175-b9cc-74b5ca30746e>;
