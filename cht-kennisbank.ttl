<https://data.cultureelerfgoed.nl/term/id/cht/a5b6dd6c-bf8c-4a3a-8fd5-8a7ce8cf9135>
  a skos:Concept;
  skos:prefLabel "gleibakkers"@nl;
  skos:scopeNote "Gleibakkers vervaardigen grove keramiek of bouwmateriaal, zoals dakpannen of bakstenen, uit klei. Zij werken met eenvoudige middelen, vaak in veldovens of kleine werkplaatsen."@nl;
  skos:altLabel "gleibakker"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db4a7619-d236-4b14-8e79-b4a6e890f677>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

