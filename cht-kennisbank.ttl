<https://data.cultureelerfgoed.nl/term/id/cht/9b955103-2e79-4a66-823a-af839016943a>
  a skos:Concept;
  skos:prefLabel "draaikaken"@nl;
  skos:scopeNote "Draaikaken zijn kaken, op een voetstuk opgerichte palen of zuilen waaraan een overtreder vastgebonden en tentoongesteld werd, met wentelende halskragen."@nl;
  skos:altLabel "draaikaak"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6ef898a2-c5d0-4bb5-b07f-7d9f446d4c53>;
