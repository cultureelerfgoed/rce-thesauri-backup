<https://data.cultureelerfgoed.nl/term/id/cht/5003f8f7-862e-4065-a56e-b403711ccf2a>
  a skos:Concept;
  skos:prefLabel "kaarsendovers"@nl;
  skos:scopeNote "Houten steel of stok met conisch mutsje van koper of zilver aan het uiteinde. Het mutsje wordt dicht boven de kaars gehouden en ontneemt zo de vlam haar zuurstof, waardoor deze dooft. Vlaams equivalent: kaarsendomper."@nl;
  skos:altLabel "kaarsendover"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
