<https://data.cultureelerfgoed.nl/term/id/cht/b05a237f-b6a9-4aff-9db3-d88580409575>
  a skos:Concept;
  skos:prefLabel "ruimtelijke ordening"@nl;
  skos:scopeNote "Wordt gebruikt als verwijzing naar wetten die bepalen hoe land wordt gebruikt, ruimtelijke ordening en stadsvernieuwing, als beschrijving voor de overkoepelende plannen van steden voor huisvesting, industriële, commerciële en recreatieve faciliteiten en de invloed daarvan op het milieu. (AAT)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/da33072d-ec78-44e6-aa5a-9ca956f9d2da>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

