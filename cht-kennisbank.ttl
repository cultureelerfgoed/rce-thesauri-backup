<https://data.cultureelerfgoed.nl/term/id/cht/9d57f826-fabb-4a34-b2b6-a4e05dff86bc>
  a skos:Concept;
  skos:prefLabel "schors"@nl;
  skos:scopeNote "De buitenste bedekking van de houtachtige stammen, takken en wortels van planten, te onderscheiden van het hout zelf. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
