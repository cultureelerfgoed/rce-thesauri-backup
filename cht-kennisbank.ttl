  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/511e6ab5-d246-4c4a-9663-79910268da74>
  a skos:Concept;
  skos:prefLabel "gedestilleerd water"@nl;
  skos:scopeNote "Gedestilleerd water is water dat is gezuiverd van zijn niet-vluchtige bestanddelen door het te koken en de gecondenseerde damp weer op te vangen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0c41c9b8-fb66-48af-b44a-46dd24503c6c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6f0543ff-f16c-4cce-971f-0d3c05930759>
  a skos:Concept;
  skos:prefLabel "bergwater"@nl;
  skos:scopeNote "Water dat zich in natuursteen bevindt kort na het uitbreken uit de groeve. Bij veel soorten verdient het aanbeveling om het water te laten verdampen opdat de steen niet meer door vorst aangetast kan worden. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0c41c9b8-fb66-48af-b44a-46dd24503c6c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/9b49d5ff-eb5e-4411-8acb-d7130b2a898c>
  a skos:Concept;
  skos:prefLabel "hard water"@nl;
  skos:scopeNote "Hard water is water met opgeloste, geïoniseerde verbindingen van calcium en magnesium. Deze kunnen op voorwerpen neerslaan bij natte reiniging en met zeep reageren tot onoplosbare aanslag."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0c41c9b8-fb66-48af-b44a-46dd24503c6c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/9ed63836-a29c-410b-a23e-fd69b2dea41b>
  a skos:Concept;
  skos:prefLabel "gezuiverd water"@nl;
  skos:scopeNote "Gezuiverd water is water waaruit verontreinigingen zoals kationen, anionen, opgeloste organische stoffen of gassen zijn verwijderd. Het soort en de mate van de zuivering worden meestal gespecificeerd door de zuiveringstechniek. Gezuiverd water wordt geprefereerd bij de behandeling van voorwerpen, om zo vervuiling van het voorwerp door verontreinigingen te voorkomen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0c41c9b8-fb66-48af-b44a-46dd24503c6c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/0c420974-6e23-4719-aba2-db9d7790a393>
  a skos:Concept;
  skos:prefLabel "kantonneren"@nl;
  skos:scopeNote "Gezegd van schalken en colonnetten als die met pijlers voor ongeveer een derde van de doorsnede verbonden zijn. Vgl. flankeren. Zie tekening gekantonneerd. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/0c4a21ed-2f69-4d03-8c92-5c71592872a4>
  a skos:Concept;
  skos:prefLabel "dieptelijnen"@nl;
  skos:scopeNote "Lijn gevormd door punten met gelijke waterdiepte."@nl;
  skos:altLabel "dieptelijn"@nl;
