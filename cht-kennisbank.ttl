<https://data.cultureelerfgoed.nl/term/id/cht/51e83e12-4d05-4fc4-bc5d-34b9d23224b1>
  a skos:Concept;
  skos:prefLabel "blauwe pigmenten"@nl;
  skos:scopeNote "Blauwe pigmenten zijn kleurstoffen die worden gebruikt om een blauwe kleur te geven aan verf, textiel of andere materialen, variërend van natuurlijke mineralen tot synthetische verbindingen."@nl;
  skos:altLabel "blauwe pigment"@nl;
