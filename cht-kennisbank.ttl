  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/0777ae6d-c9c2-44a5-bebf-dac2451f2763>
  a skos:Concept;
  skos:prefLabel "versnellingshandels"@nl;
  skos:scopeNote "Hefboom om van het ene tandwielstel in de versnellingsbak op het andere over te schakelen."@nl;
