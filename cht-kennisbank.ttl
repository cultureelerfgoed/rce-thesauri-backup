<https://data.cultureelerfgoed.nl/term/id/cht/10982228-0fcd-4ed6-b741-9b8b43af0504>
  a skos:Concept;
  skos:prefLabel "ceselen"@nl;
  skos:scopeNote "Beitel van 3,5 tot minstens 12 cm breed, in hoofdzaak gebruikt voor scharreren en frijnen. Ceseels komen ook voor met houten handvat. Andere namen: cyseel, syseel, platijzer, frijnijzer, scharreerbeitel. Een smalle ceseel wordt ook slagijzer genoemd."@nl;
  skos:altLabel "ceseel"@nl, "cesselen"@nl, "cesseel"@nl;
