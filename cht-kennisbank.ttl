<https://data.cultureelerfgoed.nl/term/id/cht/9cb1141b-71e7-4695-82de-895d4e58eac1>
  a skos:Concept;
  skos:prefLabel "hulpveren"@nl;
  skos:scopeNote "Toegevoegde achterveer, gewoonlijk van rubber, die wordt gemonteerd aan beide zijden van een auto die bijzonder zwaar beladen wordt."@nl;
  skos:altLabel "hulpveer"@nl;
