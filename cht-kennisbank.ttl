<https://data.cultureelerfgoed.nl/term/id/cht/bc03c4a8-078a-407a-aefc-4e1251e70d21>
  a skos:Concept;
  skos:prefLabel "waterafstotend"@nl;
  skos:scopeNote "Voorzien van een oppervlak dat bestand maar niet ondoordringbaar is voor water. Gebruik 'waterdicht' voor oppervlakken die ondoordringbaar zijn voor water. Gebruik 'hydrofobiciteit' voor de toestand of eigenschap weinig of geen affiniteit met water te hebben, vooral op moleculaire niveau. (AAT)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/bc3cfdb6-ea5f-4a46-adaf-90a75d01ff23>
  a skos:Concept;
  skos:prefLabel "bloktanden (fysiek kenmerk)"@nl;
  skos:scopeNote "Bloksgewijze vertanding in metselwerk waarbij, b.v. om de vijf lagen, het metselwerk terug- en weer uitspringt, tand. (Haslinghuis)"@nl;
  skos:altLabel "bloktand (fysiek kenmerk)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
