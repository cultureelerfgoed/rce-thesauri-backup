<https://data.cultureelerfgoed.nl/term/id/cht/12ae97c7-0e6c-439a-9fcd-e29a43e99ba0>
  a skos:Concept;
  skos:prefLabel "puntijzers (beitel)"@nl;
  skos:scopeNote "Puntige steenhouwersbeitel van doorgaans 13-25 cm lengte, soms wel tot een halve meter. Het is meestal achthoekig van doorsnede, soms rond, met een uitgesmede en geharde punt. Andere naam: puntbeitel, spitsijzer."@nl;
  skos:altLabel "puntbeitel"@nl, "puntbeitels"@nl, "puntijzer (beitel)"@nl, "spitsijzer (beitel)"@nl,
