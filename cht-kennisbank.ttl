<https://data.cultureelerfgoed.nl/term/id/cht/6fd54876-3586-4b32-a8a4-d88b481fd5ee>
  a skos:Concept;
  skos:prefLabel "balkons (molen)"@nl;
  skos:scopeNote "Platform aan de zijde van het trapbint van een standerdmolen dat langs een buitentrap bereikbaar is en d.m.v. een deur toegang verschaft tot de molen. In de vloer is een luik opgenomen dat het ophijsen en laten zakken van graan-, resp. meelzakken mogelijk maakt. (Haslinghuis)"@nl;
  skos:altLabel "balkon (molen)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b2331d07-8cfc-4ddb-ab21-ed760e7cbc9f>;
