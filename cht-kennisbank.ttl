<https://data.cultureelerfgoed.nl/term/id/cht/04e8c5e9-925f-450d-8f08-3a81432b9da9>
  a skos:Concept;
  skos:prefLabel "Eskimo"@nl;
  skos:scopeNote "Eskimo is de verzamelnaam voor inheemse bevolkingsgroepen die Groenland, het noorden van Canada, Alaska en het uiterste oosten van Siberië bewonen. De Eskimo's worden (politiek en vaak ook wetenschappelijk) niet tot de indianen gerekend."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ba8a0df0-e7c1-48f4-ab90-dfde6c264f0e>;
