<https://data.cultureelerfgoed.nl/term/id/cht/fd860d49-33f0-465e-bcbb-5129e91985ca>
  a skos:Concept;
  skos:prefLabel "oefenaltaren"@nl;
  skos:scopeNote "Niet-gewijd altaar waaraan de mis werd geoefend door priesterstudenten, de zogeheten ‘houten mis’. Daarbij werd ongewijd vaatwerk gebruikt, vervaardigd uit hout of onedele metalen. (Religieus Erfgoedthesaurus)"@nl;
  skos:altLabel "oefenaltaar"@nl, "oefenaltaars"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1904a522-7070-4b07-90d9-7e15086b007b>;
