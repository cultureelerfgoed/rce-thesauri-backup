<https://data.cultureelerfgoed.nl/term/id/cht/9b9d32d0-1250-4f30-8613-8f97aca3f495>
  a skos:Concept;
  skos:prefLabel "vervetting"@nl;
  skos:scopeNote "Vervetting in een vloeistofpreparaat is de afbraak en de afscheiding van vetten uit het dierlijke weefsel in de vloeistof."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/9ba81c12-8ea4-441a-bd47-d1d1c56569a0>
  a skos:Concept;
  skos:prefLabel "perforaties"@nl;
  skos:scopeNote "Perforaties zijn de gaten aan de rand van een film voor de vertanding van het filmtransportmechanisme. (Conservation Dictionary)"@nl;
  skos:altLabel "perforatie"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
