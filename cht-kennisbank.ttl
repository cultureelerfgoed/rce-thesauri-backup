<https://data.cultureelerfgoed.nl/term/id/cht/70f73667-6992-4b00-9058-96c28dbda6bd>
  a skos:Concept;
  skos:prefLabel "cochenillewas"@nl;
  skos:scopeNote "Cochenillewas is een was die wordt gewonnen uit de cochenilleluis, naast kleurstof ook gebruikt in de productie van vernis en cosmetische producten."@nl;
