<https://data.cultureelerfgoed.nl/term/id/cht/57a21ac6-0de5-4515-bfb1-b814d50749f4>
  a skos:Concept;
  skos:prefLabel "altaarnissen"@nl;
  skos:scopeNote "Nis, uitgespaard in het muurwerk, meestal van een dwarsarm of zijkapel, om er een altaar in te plaatsen; minder nauwkeurig ook voor koorapsis (apsis) gebruikt. (Haslinghuis)"@nl;
  skos:altLabel "altaarnis"@nl;
