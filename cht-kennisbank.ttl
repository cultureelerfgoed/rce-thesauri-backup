<https://data.cultureelerfgoed.nl/term/id/cht/ac707bf5-e3e0-4619-96f1-3eefecd677ef>
  a skos:Concept;
  skos:prefLabel "tandartsen"@nl;
  skos:scopeNote "Tandartsen zijn artsen die de tandheelkunde beoefenen. Zij behandelen gebitsproblemen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
