    <https://data.cultureelerfgoed.nl/term/id/cht/fc6990f6-88ed-466f-b156-c0dd9f7bea7a>,
    <https://data.cultureelerfgoed.nl/term/id/cht/901f1e06-89f7-4e9a-8557-a0bd48ffd5fd>,
    <https://data.cultureelerfgoed.nl/term/id/cht/7b5f539f-675a-4e62-b70a-eea1488817cd>,
    <https://data.cultureelerfgoed.nl/term/id/cht/597c1a25-557a-4300-9a98-c6ce87dc84d5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3529de13-a341-42d0-9e3a-463488046d3d>
  a skos:Concept;
  skos:prefLabel "familiegraven"@nl;
  skos:scopeNote "Familiegraven is de oude benaming voor particuliere graven. De benaming werd gekozen ter onderscheid van algemene graven. Familiegraven zijn bestemd voor families die een recht op het graf vestigen en zelf bepalen wie er in begraven wordt. Wettelijk gezien wordt de term niet meer gebruikt, maar in het spraakgebruik vaak nog wel. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "familiegraf"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d6eef960-5cb5-4dd5-b68d-cc1929ed20c0>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/40545591-76ec-4cb1-8dc7-6c046c9f37d9>
  a skos:Concept;
  skos:prefLabel "kaarbomen"@nl;
  skos:scopeNote "Balkjes waartussen de kaar is opgehangen."@nl;
  skos:altLabel "kaarboom"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/04770e4f-1c11-40e7-a256-9de8c6d569c6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/5f1505bd-0e77-49fa-a7ed-1192f960c1bd>
  a skos:Concept;
  skos:prefLabel "damhekken"@nl;
  skos:scopeNote "Damhekken in combinatie met hekpalen markeren de toegang op een dam tot een bezitting, bijvoorbeeld een hof, boerderij of land. De toegang wordt meestal verkregen door een dam over een sloot. Omdat de grensscheiding vaak door het midden van de sloot loopt hebben damhekken ook de functie van grenspalen. (Merkwaardige grenspalen en grensstenen / M.A. Aalbregtse, Oostburg 1974)"@nl;
  skos:altLabel "damhek"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/45db386a-7e50-4c8f-94d2-6caa48ee8f6a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/44068684-011b-4fe5-ae20-615aac08b180>
  a skos:Concept;
  skos:prefLabel "binnenkamers"@nl;
  skos:scopeNote "Vertrek tussen voorhuis en achterkamer, binnenhaard zonder keukenfunctie. (Haslinghuis)"@nl;
  skos:altLabel "binnenkamer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5f973f74-2afb-4d34-96af-8bf888b93318>;
