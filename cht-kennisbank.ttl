<https://data.cultureelerfgoed.nl/term/id/cht/6218eb36-773d-4b35-b113-89b851b00af7>
  a skos:Concept;
  skos:prefLabel "trimvlakken"@nl;
  skos:scopeNote "Om eventueel benodigde permanente stuurkracht op te heffen, is in het hoogte roer een z.g. trimvlak aangebracht."@nl;
