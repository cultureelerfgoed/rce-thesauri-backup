<https://data.cultureelerfgoed.nl/term/id/cht/dd918c1b-bc16-464d-b273-751ae44db613>
  a skos:Concept;
  skos:prefLabel "komenijen"@nl;
  skos:scopeNote "Komenijen waren winkels waar niet alleen de zogenaamde vette waren als spek, ham, boter en kaarsen, maar ook bier, grutten, bonen, gort, meel, boenders, grauw papier en meer werdem verkocht. Komenijen komen niet meer voor in het Nederlandse winkellandschap. (Clé Lesger, Het winkellandschap van Amsterdam, 2013)"@nl;
  skos:altLabel "komenij"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/10f47eb6-f1a9-465f-b8ab-8381925f039b>;
