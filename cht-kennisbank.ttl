  a skos:Concept;
  skos:prefLabel "interieurwacht"@nl;
  skos:scopeNote "De interieurwacht inspecteert onderdelen van historische interieurs die aard- en nagelvast onderdeel uitmaken van het monument. Denk hierbij aan elementen als historische deuren, lambriseringen, wandbespanningen, schoorsteen- en bovendeurstukken, behang, ingebouwde meubelstukken als buffetkasten, koorbanken, preekstoelen, maar ook aan historische installaties en voorzieningen als liften."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db4a7619-d236-4b14-8e79-b4a6e890f677>;
