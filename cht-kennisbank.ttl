<https://data.cultureelerfgoed.nl/term/id/cht/2377dd42-78cb-4f7e-8c14-e06517c2dd38>
  a skos:Concept;
  skos:prefLabel "boekopeners"@nl;
  skos:scopeNote "Toestel of gereedschap voor het (machinaal) openen van boeken."@nl;
  skos:altLabel "boekopener"@nl;
