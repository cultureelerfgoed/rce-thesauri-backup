<https://data.cultureelerfgoed.nl/term/id/cht/9ecd9154-8767-4ec1-bc86-af057252ce88>
  a skos:Concept;
  skos:prefLabel "digitale audioband"@nl;
  skos:scopeNote "Digitale audio band (DAT) is een geluidstechniek die gebruik maakt van een smalle band om geluid van hoge kwaliteit digitaal op te nemen en weer te geven. Het systeem wordt ook gebruikt computerbestanden te bewaren. (Conservation Dictionary)"@nl;
  skos:altLabel "DAT"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91712616-6dec-4871-8fdc-c317850c20d1>;
