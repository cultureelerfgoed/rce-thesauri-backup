<https://data.cultureelerfgoed.nl/term/id/cht/5b59fe05-9c1f-4041-bc08-97a6b3d93ee3>
  a skos:Concept;
  skos:prefLabel "haalmessen"@nl;
  skos:scopeNote "Gereedschap met twee handvatten of hechten waartussen een breed recht of krom beitelvormig mes. Andere namen: schaafmes, trekmes."@nl;
  skos:altLabel "haalmes"@nl, "schaafmes"@nl, "trekmes"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2ed04729-7ad2-4346-ae14-74dda34a3163>;
