  a skos:Concept;
  skos:prefLabel "klemmen"@nl;
  skos:scopeNote "Een klem is een stuk gereedschap om delen van een voorwerp tijdens de behandeling onder druk bij elkaar te houden. (Conservation Dictionary)"@nl;
