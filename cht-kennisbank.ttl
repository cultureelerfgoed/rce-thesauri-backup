  a skos:Concept;
  skos:prefLabel "kerktapijten"@nl;
  skos:scopeNote "Kleed van behoorlijke grootte, voornamelijk gebruikt om een vlak oppervlak te bedekken; tapijten vormen de grootste en meest bekende groep onder de kleden. Het kerktapijt kan zich onderscheiden door ingeweven bijbelteksten en/of eucharistische symbolen."@nl;
  skos:altLabel "kerktapijt"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0e27175e-cf3a-40cd-9c33-55d9127fa6fd>;
