  a skos:Concept;
  skos:prefLabel "vrijwielen"@nl;
  skos:scopeNote "Koppeling, die slechts in één richting werkt, namelijk alleen wanneer de motor trekt. Wanneer het gaspedaal wordt losgelaten, verbreekt het vrijwiel de aandrijving en wordt de voortbeweging van de wagen niet door de motor afgeremd."@nl;
  skos:altLabel "freewheel"@nl, "vrijwiel"@nl;
