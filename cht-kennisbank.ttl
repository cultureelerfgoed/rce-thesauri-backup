<https://data.cultureelerfgoed.nl/term/id/cht/9f2afb5b-9063-43a4-b48a-f501690b59ae>
  a skos:Concept;
  skos:prefLabel "ijssilo's"@nl;
  skos:scopeNote "IJssilo’s zijn moderne metalen containers voor de tijdelijke opslag van kunstmatig geproduceerd ijs. IJssilo’s hebben een aanzienlijk grotere capaciteit dan ijsbunkers en zijn bedoeld voor industriële productieprocessen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "ijssilo"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/58deacce-b39b-4d10-be1f-83ec25f8fa80>;
