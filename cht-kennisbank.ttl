<https://data.cultureelerfgoed.nl/term/id/cht/60b07ea1-8374-4c21-897b-725c1abf219e>
  a skos:Concept;
  skos:prefLabel "keukentextiel"@nl;
  skos:scopeNote "Keukentextiel is een textiel dat typisch gebruikt wordt in een keuken. Het beschermt tegen de hitte van het koken, beschermt tegen vet en vuil en kan worden gebruikt voor het opdrogen van vaatwerk. Typisch soorten keukentextiel zijn: pannenlappen, theedoeken, ovenwanten en keukenhanddoeken."@nl;
  skos:altLabel "huishoudtextiel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cf2cff8c-6b76-4b02-ba35-3c93e9f84894>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/9794225a-3584-446b-b069-32e9ea817486>,
    <https://data.cultureelerfgoed.nl/term/id/cht/447d513f-2071-489d-89a1-cf728e3511b9>,
    <https://data.cultureelerfgoed.nl/term/id/cht/f9c4f99c-b375-4f99-a4c6-3af3039430ff>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/9794225a-3584-446b-b069-32e9ea817486>
  a skos:Concept;
  skos:prefLabel "theedoeken"@nl;
  skos:scopeNote "Een theedoek is een doek van katoen of linnen waarmee het afgewassen eet- en kookgerei (de vaat) wordt afgedroogd."@nl;
  skos:altLabel "theedoek"@nl, "keukenhanddoek"@nl, "afdroogdoek"@nl, "droogdoek"@nl,
    "schoteldoek"@nl, "keukendoek"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/60b07ea1-8374-4c21-897b-725c1abf219e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/447d513f-2071-489d-89a1-cf728e3511b9>
  a skos:Concept;
  skos:prefLabel "vaatdoeken"@nl;
  skos:scopeNote "Een vaatdoek is een doekje waarmee het aanrecht plus gootsteen worden schoongemaakt. Een vaatdoek wordt ook gebruikt om tafels mee af te vegen."@nl;
  skos:altLabel "aanrechtdoek"@nl, "vaatdoek"@nl, "schotelvod"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/60b07ea1-8374-4c21-897b-725c1abf219e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/42fd8fff-3398-417a-8bee-55495846482d>
  a skos:Concept;
  skos:prefLabel "slabben (beschermende kleding)"@nl;
  skos:scopeNote "Kleine lappen, meestal bevestigd rond de hals, die de borst bedekken en die worden gedragen ter bescherming van de bovenkleding bij het eten, vooral voor kinderen."@nl;
  skos:altLabel "slab (beschermende kleding)"@nl, "slabbetjes"@nl, "slabbetje"@nl;
