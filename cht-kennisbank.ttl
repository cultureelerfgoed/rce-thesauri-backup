  a skos:Concept;
  skos:prefLabel "oppervlaktebehandeling"@nl;
  skos:scopeNote "De oppervlaktebehandeling van een voorwerp houdt in dat het oppervlak van het hele voorwerp met een vloeibaar middel wordt behandeld."@nl;
