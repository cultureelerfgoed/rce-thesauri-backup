<https://data.cultureelerfgoed.nl/term/id/cht/0842f938-57f7-4317-9813-6e8ffd1008a7>
  a skos:Concept;
  skos:prefLabel "puttouwen"@nl;
  skos:scopeNote "Puttouwen zijn touwen waaraan putemmers zijn bevestigd. Door te draaien aan de windas boven de put, kan de gevulde putemmer met water worden opgehaald."@nl;
  skos:altLabel "putkoord"@nl, "putkoorden"@nl, "puttouw"@nl, "putzeel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cc35695d-14c2-4533-8dde-d121a0b71bda>;
