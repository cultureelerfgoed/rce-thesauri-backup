  a skos:Concept;
  skos:prefLabel "wassen"@nl;
  skos:scopeNote "Wassen: reinigen met een redelijke tot grote hoeveelheid water en eventueel een neutrale detergent, zonder of met weinig druk. (Bestekstermen voor B bewerking, behandeling en verwerking van natuursteen)"@nl;
