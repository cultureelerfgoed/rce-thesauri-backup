<https://data.cultureelerfgoed.nl/term/id/cht/e354f44a-7b74-4902-99e9-9bad04145451>
  a skos:Concept;
  skos:prefLabel "pianola's"@nl;
  skos:scopeNote "Piano's met een mechanisme om automatisch te spelen; meestal een mechanisme waarmee geponste papieren rollen kunnen worden afgespeeld. (AAT-Ned)"@nl;
  skos:altLabel "pianola"@nl;
