  a skos:Concept;
  skos:prefLabel "krambouten"@nl;
  skos:scopeNote "IJzeren staaf of bout met aan de kopzijde een ring. Wordt voor velerlei doeleinden gebruikt om een bevestigingspunt te maken voor touwwerk. Komen bijvoorbeeld voor op iedere achtkantstijl van een binnenkruier om het gevlucht aan vast te zetten, daar bij dit type molens geen kruipalen aanwezig zijn."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c941876f-315f-4bf9-9cd4-4ee970578385>;
