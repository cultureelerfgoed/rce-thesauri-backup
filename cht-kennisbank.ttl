<https://data.cultureelerfgoed.nl/term/id/cht/34688a9e-f4f2-4c72-97e9-6a32116c7f63>
  a skos:Concept;
  skos:prefLabel "zweepslagmotieven"@nl;
  skos:scopeNote "Zweepslagmotieven zijn lijnvoeringen die typerend zijn voor de Art Nouveau, denk hierbij aan uitbundige, sierlijke en asymmetrische lijnvoering. De vloeiende gebogen lijnen met een sterker gebogen einde zijn op allerlei plaatsen toegepast. De toepassing is decoratief. (Bouwstijlen in Nederland 1040-1940 / Roland Blijdestijn, Ronald Stenvert, 2000)"@nl;
  skos:altLabel "zweepslagmotief"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5db74efc-e56d-4ff9-b60c-5c3bd938226c>;
