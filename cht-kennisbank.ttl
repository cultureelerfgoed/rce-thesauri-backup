<https://data.cultureelerfgoed.nl/term/id/cht/4ed1af25-0867-485d-ad28-938e57691117>
  a skos:Concept;
  skos:prefLabel "maigeleinen"@nl;
  skos:scopeNote "Houders waarin munitie is opgeslagen vóór het laden. Ze zijn afneembaar, of maken deel uit van het wapen. (AAT-Ned)"@nl;
  skos:altLabel "maigelein"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0d9f9433-b7d7-4ace-b064-a359412d53a3>;
