<https://data.cultureelerfgoed.nl/term/id/cht/d17de294-a37b-44f0-a108-8f47484bd7b2>
  a skos:Concept;
  skos:prefLabel "hang- en sluitwerk"@nl;
  skos:scopeNote "Alle onderdelen die nodig zijn voor het afhangen en sluiten van ramen, deuren, hekken e.d.. Hiertoe behoren gehengen, scharnieren, grendels en sloten. Meestal van metaal maar soms ook van hout, voorn. in de houtbouw. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4e481c81-319a-44da-86bf-106f145d22c1>;
