<https://data.cultureelerfgoed.nl/term/id/cht/0c2bab75-9e31-44e7-9fc5-486f0411b078>
  a skos:Concept;
  skos:prefLabel "hennepkloppers"@nl;
  skos:scopeNote "Molen die de hennepstengels met stampers breekt, zodat alleen de bruikbare hennepvezel overblijft ter vervaardiging van touw of garen voor de zeildoek weverij. (Molenwoordenboek G.J. Pouw)"@nl;
  skos:altLabel "hennepklopper"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/115eaa82-d324-4f3b-ac96-fec7fe185bf9>;
