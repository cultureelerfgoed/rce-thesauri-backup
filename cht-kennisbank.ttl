  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/35d9227d-0f6f-44ff-8190-d74397bfb034>
  a skos:Concept;
  skos:prefLabel "undertray's"@nl;
  skos:scopeNote "Een undertray is een bodemplaat die als spatbord onder het “kontje” van een motorfiets kan worden gemonteerd om dit aan de onderzijde af te dichten."@nl;
  skos:altLabel "undertray"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/77bd4b5a-d0b0-4fa1-a4b9-5f2e913985cc>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/36ec8c25-69a6-43d7-8d2b-062e9fc5b757>
  a skos:Concept;
  skos:prefLabel "skai"@nl;
  skos:scopeNote "Skai is een merknaam van kunstleer van de Duitse firma Konrad Hornschuch AG, dat in 1958 op de markt kwam. Het merk verwaterde in de loop der jaren tot de soortnaam 'skai' en werd synoniem voor kunstleer. (Wikipedia)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db199987-35a2-450c-8806-9962b2dde9a1>;
