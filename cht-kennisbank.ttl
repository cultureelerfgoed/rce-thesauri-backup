<https://data.cultureelerfgoed.nl/term/id/cht/2840c23c-04f3-494f-b1f8-f0684aa098dd>
  a skos:Concept;
  skos:prefLabel "buitentaluds"@nl;
  skos:scopeNote "Het buitentalud is de helling van de buitenkant van de dijk, oftewel de kant van de dijk waar het water tegenaan stroomt. (Wikipedia)"@nl;
  skos:altLabel "buitentalud"@nl;
