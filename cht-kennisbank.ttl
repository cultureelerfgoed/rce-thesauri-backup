<https://data.cultureelerfgoed.nl/term/id/cht/18357444-5a0e-4cd1-a68e-bc651ac0a05f>
  a skos:Concept;
  skos:prefLabel "decoratieve kenmerken"@nl;
  skos:scopeNote "De gidsterm decoratieve kenmerken zijn visuele elementen die worden gebruikt om objecten, oppervlakken of structuren te verfraaien. Ze dragen vaak bij aan de esthetische waarde ervan."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
