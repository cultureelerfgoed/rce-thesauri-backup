<https://data.cultureelerfgoed.nl/term/id/cht/9f3d0b9c-9c40-4ebc-a6e9-b10b02da5650>
  a skos:Concept;
  skos:prefLabel "chromofoor"@nl;
  skos:scopeNote "Een chromofoor is een functionele groep in een organisch molecuul die verantwoordelijk is voor de absorptie van licht. Het is vaak een onverzadigde groep."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
