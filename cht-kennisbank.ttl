<https://data.cultureelerfgoed.nl/term/id/cht/c81065fb-5174-4314-9567-28429d95a2ed>
  a skos:Concept;
  skos:prefLabel "Autochromeplaten"@nl;
  skos:scopeNote "Glasdia's met een positief kleurenbeeld bestaande uit een coating van aardappelzetmeelkorreltjes, geverfd in de complementaire kleuren oranje, violet en groen. Daar overheen is een zwart-wit zilvergelatine emulsie aangebracht. Autochromeplaten waren van 1907 tot 1931 in de handel. (Project Fotografie)"@nl;
  skos:altLabel "Autochromeplaat"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/15d26695-4a51-4fbf-aec2-65a18b5a5cc5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2b27e37f-9f53-40f3-b678-1500233b48a0>
  a skos:Concept;
