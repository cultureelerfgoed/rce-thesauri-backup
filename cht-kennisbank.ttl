<https://data.cultureelerfgoed.nl/term/id/cht/91f9462e-d799-4e61-9ad8-c82546acbabd>
  a skos:Concept;
  skos:prefLabel "vervoer"@nl;
  skos:scopeNote "Het vervoer van een voorwerp is het overbrengen ervan van de ene plaats naar de andere."@nl;
