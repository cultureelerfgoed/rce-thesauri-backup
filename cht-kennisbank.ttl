<https://data.cultureelerfgoed.nl/term/id/cht/ab10fe27-3e98-443e-af7d-6a84c606c0df>
  a skos:Concept;
  skos:prefLabel "gemeentes"@nl;
  skos:scopeNote "Een gemeente is een openbaar lichaam met zelfbestuur en bevoegdheid binnen een gebied kleiner dan dat van een provincie."@nl,
