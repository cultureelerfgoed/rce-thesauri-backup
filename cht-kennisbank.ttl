<https://data.cultureelerfgoed.nl/term/id/cht/ceed8535-e62b-4933-9e29-8240da5e7dd5>
  a skos:Concept;
  skos:prefLabel "abtswoningen"@nl;
  skos:scopeNote "Een abtswoning is de woning waar de abt van het klooster woonde. De abtswoning kan een onderdeel zijn van het klooster of los op het kloostercomplex staan."@nl;
  skos:altLabel "abtswoning"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/68a2ee6d-9205-424e-9540-43d27b6a483f>;
