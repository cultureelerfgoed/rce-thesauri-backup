<https://data.cultureelerfgoed.nl/term/id/cht/443e133a-7c93-4c8f-af20-19ff4b3b6be0>
  a skos:Concept;
  skos:prefLabel "tempera"@nl;
  skos:scopeNote "Tempera is een opake verf met lijm of caseïne als bindmiddel, vaak met krijt als pigment. Tempera werd veel gebruikt in interieurs. Tempera is verf op waterbasis die tot een waterbestendige laag opdroogt. Eiproteïnen worden vaak als bindmiddel gebruikt, maar ook melk, diverse soorten dierlijke lijm, gom, paardebloemensap of het sap van de vijgenboom kunnen erin zijn verwerkt. (Conservation Dictionary)"@nl;
  skos:altLabel "tempera-verf"@nl, "tempera verf"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6879c494-8310-4cda-87f2-cfc637f3fca6>;
