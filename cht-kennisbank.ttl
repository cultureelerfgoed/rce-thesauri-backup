  a skos:Concept;
  skos:prefLabel "gordijnbogen"@nl;
  skos:scopeNote "Gordijnbogen zijn bogen waarvan elk boogdeel bestaat uit twee of meer holle delen. Dit is een niet-constructieve, slechts voor versiering bruikbare boog. (Haslinghuis)"@nl;
