<https://data.cultureelerfgoed.nl/term/id/cht/e2fc1a68-7ad9-4e8d-8b77-780af477b700>
  a skos:Concept;
  skos:prefLabel "visrokerijen"@nl;
  skos:scopeNote "Visrokerijen zijn werkcomplexen van vissers of visventers bestaande uit vishangen, woningen, opslagruimten en boetruimten. Bepaalde vissoorten, zoals aal en makreel, worden er gerookt. (Van Dale)"@nl;
  skos:altLabel "hang"@nl, "visrokerij"@nl;
