  a skos:Concept;
  skos:prefLabel "knip- en snijwerk"@nl;
  skos:scopeNote "Afwerking van metselwerk waarbij de voegen volgezet worden, vervolgens langs de rei gestreken en tenslotte langs de kanten met een voegijzer of mesje schuin afgesneden worden. De lintvoegen zijn afwaterend afgewerkt. Sedert XVIII. Vgl. platvol en verdiept voegen. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
