<https://data.cultureelerfgoed.nl/term/id/cht/19b9797e-131b-409c-aa90-124e3d8b386b>
  a skos:Concept;
  skos:prefLabel "kraken (vaartuig)"@nl;
  skos:scopeNote "Grote, zeevarende schepen uit de 15e tot eind 17e eeuw, gekenmerkt door een hoog achterkasteel, een hoog, overhangend voorkasteel en een lage kuil; ze werden als handels- of oorlogsschepen gebruikt; meestal met razeilen aan de fokkemast en grote mast, en latijnzeilen aan de resterende één tot drie andere masten. (AAT-Ned)"@nl;
  skos:altLabel "kraak (vaartuig)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/8a3ac8f9-6f7b-4c51-8742-c6499601ce5b>;
