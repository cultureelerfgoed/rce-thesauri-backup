<https://data.cultureelerfgoed.nl/term/id/cht/f10946f5-fe37-4fba-9690-ff43cefd5f05>
  a skos:Concept;
  skos:prefLabel "peerkralen"@nl;
  skos:scopeNote "Peerkralen zijn gotisch profilen van peervormige doorsnede met sterk in- en uitgezwenkte contour en afgeplat of met een riem belegd. Voortzetting van de romaanse kraal. Veel voorkomend aan portaal-, venster- en scheiboogneggen, aan gewelfribben en aan sleutelstukken. (Haslinghuis)"@nl;
  skos:altLabel "peerkraal"@nl;
