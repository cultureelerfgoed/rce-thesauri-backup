<https://data.cultureelerfgoed.nl/term/id/cht/625affeb-4031-42d3-81d4-5484bec88546>
  a skos:Concept;
  skos:prefLabel "egaliseermortel"@nl;
  skos:scopeNote "Egaliseermortel is een mortel die wordt gebruikt om oppervlakken zoals vloeren en wanden glad te maken voordat verdere afwerking plaatsvindt, essentieel voor een gelijkmatige en duurzame afwerking."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/76079c9c-8e0d-4487-a35c-c1793bbaf0d7>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/688519e1-aeb1-4742-affb-f2a63a20a698>
  a skos:Concept;
  skos:prefLabel "eierproducten"@nl;
  skos:scopeNote "Eierproducten zijn voedingsmiddelen die zijn afgeleid van eieren, zoals poedervormige, vloeibare of gedroogde eieren, veelal gebruikt in de voedingsindustrie vanwege hun veelzijdigheid en voedingswaarde."@nl;
  skos:altLabel "eierproduct"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/231e97d9-93a7-470c-9213-80e2ff05de5f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/cc9d4cad-665a-42d0-ac78-a96514df5a4c>
  a skos:Concept;
  skos:prefLabel "epichloorhydrinerubber"@nl;
  skos:scopeNote "Epichloorhydrinerubber is een synthetisch elastomeer dat bekend staat om zijn uitstekende weerstand tegen oliën, chemicaliën en ozon, veel gebruikt in afdichtingen, slangen en pakkingen."@nl;
  skos:altLabel "ECO"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9834c5a3-66d2-4d2d-aa64-789ff13dde5e>;
