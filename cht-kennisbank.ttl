<https://data.cultureelerfgoed.nl/term/id/cht/a8276433-e7f0-45a5-814e-3feca097aec8>
  a skos:Concept;
  skos:prefLabel "peilmerkstenen"@nl;
  skos:scopeNote "Een steen die dient als referentiepunt door de exact ingemeten hoogte vast te leggen, wordt een peilmerksteen genoemd. (Thesaurus landschap)"@nl;
  skos:altLabel "peilmerksteen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/36963dcd-7f11-4902-8e8e-91eb92ad8ffd>;
