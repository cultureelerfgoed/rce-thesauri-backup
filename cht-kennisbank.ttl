<https://data.cultureelerfgoed.nl/term/id/cht/44404e9d-26aa-4a73-aa93-dbc3b8caa8b5>
  a skos:Concept;
  skos:prefLabel "huishoudelijke accessoires"@nl;
  skos:scopeNote "Kleine voorwerpen die de functionaliteit en esthetiek van het huishouden ondersteunen, zoals opbergers of decoratieve items."@nl;
