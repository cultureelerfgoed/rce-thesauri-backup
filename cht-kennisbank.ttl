<https://data.cultureelerfgoed.nl/term/id/cht/25ff09e3-c5c5-4b90-8e6c-ac70db4b2241>
  a skos:Concept;
  skos:prefLabel "zakhorloges"@nl;
  skos:scopeNote "Wordt gebruikt voor horloges die zijn ontworpen om in zakken te worden gedragen, in tegenstelling tot horloges die bijvoorbeeld zijn bedoeld om rond de pols of aan een ketting te worden gedragen. (AAT-Ned)"@nl;
  skos:altLabel "zakhorloge"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/23fbebb2-d57a-45d6-957c-b41525d912db>;
