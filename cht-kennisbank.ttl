<https://data.cultureelerfgoed.nl/term/id/cht/8731055a-a601-46de-bd85-5a15667626fa>
  a skos:Concept;
  skos:prefLabel "zwaaispitsen"@nl;
  skos:scopeNote "Werktuig met een houweelachtige vorm en met een scherpe punt aan beide zijden. Het wordt gebruikt als eerste bewerking om een blok steen te voorzien van vlakke zijden. Het ijzer is ca. 50 cm lang, de steel 90 tot 100 cm. Andere namen: dubbelspits, spitshamer."@nl;
  skos:altLabel "dubbelspits"@nl, "dubbelspitsen"@nl, "spitshamer"@nl, "spitshamers"@nl,
    "zwaaispits"@nl;
