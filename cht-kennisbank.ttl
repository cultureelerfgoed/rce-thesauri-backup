  a skos:Concept;
  skos:prefLabel "drielingen (baksteen)"@nl;
  skos:scopeNote "Drielingformaat is een formaat dat verwijst naar bakstenen van c. 18 x 9 x 4,5 cm. Drielingformaat komt voor bij de Utrechtse-, Friese- en IJsselstenen."@nl,
    "Kleine baksteen, c. 18 x 9 x 4,5 cm. Vooral in Zuid-Holland gebakken. 1661 Utrecht, Janskerkhof 16. Friese drielingen in 1610: c. 22x11x5 cm. (Haslinghuis)"@nl;
  skos:altLabel "drielingen (formaat)"@nl, "drielingformaat"@nl, "drieling (baksteen)"@nl;
