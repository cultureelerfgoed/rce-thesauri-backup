<https://data.cultureelerfgoed.nl/term/id/cht/b3330446-f4d3-4e0c-8b9d-1dd8d2259419>
  a skos:Concept;
  skos:prefLabel "reservoirs"@nl;
  skos:scopeNote "Reservoirs zijn gesloten bakken waarin vloeistof verzameld of bewaard wordt, in het bijzonder om daaruit naar behoefte afgetapt te kunnen worden. (Van Dale, 2005)"@nl;
