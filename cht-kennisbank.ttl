<https://data.cultureelerfgoed.nl/term/id/cht/105beecb-9aac-4db2-8c52-bb68e365613a>
  a skos:Concept;
  skos:prefLabel "werfbakken"@nl;
  skos:scopeNote "Klein rechthoekig vaartuig dat bij werven gebruikt wordt om werkzaamheden aan in het water liggende schepen te verrichten. (De Binnenvaart)"@nl;
  skos:altLabel "werfbak"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ffab7ecd-8caa-4191-a63f-ac8ed9258b19>;
