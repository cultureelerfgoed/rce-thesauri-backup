  a skos:Concept;
  skos:prefLabel "stadsherstel"@nl;
  skos:scopeNote "Stadsherstel verwijst naar de restauratie en het behoud van historische stedelijke gebieden en gebouwen om hun culturele en architectonische waarde te behouden."@nl;
