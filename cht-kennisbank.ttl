<https://data.cultureelerfgoed.nl/term/id/cht/80018bd0-42b5-41ad-b1c8-7f303deae32f>
  a skos:Concept;
  skos:prefLabel "strengperssteen"@nl;
  skos:scopeNote "Strengperssteen is een type baksteen dat wordt gevormd door klei door een pers te persen, waarna het in een lange streng wordt gesneden en vervolgens gebakken. Deze methode zorgt voor een consistente maat en vorm, wat deze steen populair maakt in moderne bouwtechnieken."@nl;
  skos:altLabel "nageperste strengperssteen"@nl;
