<https://data.cultureelerfgoed.nl/term/id/cht/0fc80957-1ed5-46f8-b733-42f98933f5b2>
  a skos:Concept;
  skos:prefLabel "torens (muziekinstrument)"@nl;
  skos:scopeNote "De toren bevindt zich in het front van een orgel en vormt een kader waarin de pijpen, in tegenstelling tot het vlakveld, een ronde, driehoekige, enz. opstelling kregen. Een orgel kan meer dan één toren tellen, vaak in combinatie met een of meer velden. (Brussels Hoofdstedelijk Gewest, Directie Monumenten en Landschappen)"@nl;
  skos:altLabel "toren (muziek instrument)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cf51f60b-c1bb-4c17-b938-17e1dacb6e7c>;
