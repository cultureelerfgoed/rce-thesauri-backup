  a skos:Concept;
  skos:prefLabel "ad-west stuurbekrachtigingen"@nl;
  skos:scopeNote "Bij het bekrachtigde tandheugelstuur van Adwest wordt ondersteunende hydraulische druk geregeld en bestuurd door een roterende klep."@nl;
  skos:altLabel "ad-west stuurbekrachtiging"@nl;
