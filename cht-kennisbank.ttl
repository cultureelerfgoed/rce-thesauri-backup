    <https://data.cultureelerfgoed.nl/term/id/cht/96b617af-e8c9-46a9-b196-ea2484ec3f4d>,
    <https://data.cultureelerfgoed.nl/term/id/cht/005a0964-508b-4d1d-8d6f-c344976f4d8b>;
