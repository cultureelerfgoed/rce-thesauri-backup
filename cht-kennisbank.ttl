  a skos:Concept;
  skos:prefLabel "schaven"@nl;
  skos:scopeNote "Gereedschap dat wordt gebruikt om het oppervlak van hout glad en egaal te maken door er houtkrullen af te schaven. (AAT-Ned)"@nl;
