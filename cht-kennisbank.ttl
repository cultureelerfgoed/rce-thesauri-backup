    <https://data.cultureelerfgoed.nl/term/id/cht/b475ade7-6362-49a9-943b-87a8787cd1e0>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/0bd49d8e-ef04-4874-9df4-85a8d4c52b9a>
  a skos:Concept;
  skos:prefLabel "naainaalden"@nl;
  skos:scopeNote "Kromme, stomp of scherp uitlopende naald met aan de andere zijde een oog. Wordt gebruikt in combinatie met een twijgijzer."@nl;
  skos:altLabel "naainaald"@nl;
