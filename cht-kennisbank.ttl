<https://data.cultureelerfgoed.nl/term/id/cht/b97f8070-031c-4df8-96bd-aebf61fde2f4>
  a skos:Concept;
  skos:prefLabel "maalstenen"@nl;
  skos:scopeNote "Een stenen schijf die geschikt is om granen mee te malen t.b.v. de consumptie voor mens en dier. (Molenwoordenboek)"@nl;
  skos:altLabel "maalsteen"@nl, "platte steen"@nl;
