<https://data.cultureelerfgoed.nl/term/id/cht/5ebda6fc-0a0b-4e9f-8ae4-1bbb1d64f09b>
  a skos:Concept;
  skos:prefLabel "snurrevaads"@nl;
  skos:scopeNote "De snurrevaad of ankerzegen (of Deense zegen) is een sleepnet dat de vorm heeft van een open kegel. Eén zijde is verankerd en de andere wordt door een schip over de bodem voortgetrokken. De snurrevaad wordt vooral bij het vangen van platvis toegepast. (MARDOC)"@nl;
  skos:altLabel "snurrevaad"@nl, "ankerzegen"@nl, "ankerzegens"@nl, "Deense zegens"@nl,
    "Deense zegen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ce9b37ce-b11b-47fc-b181-00a165a59094>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/0f4ca0c2-4f64-4fd1-b6c8-a6715117aa50>
  a skos:Concept;
  skos:prefLabel "strandzegens"@nl;
  skos:scopeNote "Vanaf het strand wordt een trechtervormig net dat van lange vleugels (vlerken) voorzien is met een boot in zee gebracht. Aan de uiteinden van de vlerken zijn lange lijnen bevestigd waarmee het net langzaam naar het strand getrokken wordt. De bovenkant van het net is van drijvers voorzien terwijl de onderkant verzwaard is en over de bodem gaat. (MARDOC)"@nl;
  skos:altLabel "strandzegen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ce9b37ce-b11b-47fc-b181-00a165a59094>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/1ea791cf-52a0-45d7-8d90-ca1cda283c35>
  a skos:Concept;
  skos:prefLabel "snijzeilen"@nl;
  skos:scopeNote "Zeilen die niet aan een ra worden gevaren en dus zuiver langsscheeps kunnen worden gebracht. (MARDOC)"@nl;
  skos:altLabel "snijzeil"@nl, "langsscheepszeilen"@nl, "langsscheepszeil"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/499ab44a-c685-4f90-b92d-bc21ca90a95e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f1d347dc-c689-4132-8b97-eba15e077342>
