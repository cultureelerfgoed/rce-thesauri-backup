<https://data.cultureelerfgoed.nl/term/id/cht/090d2848-2eae-4767-b798-f3a41824bd3d>
  a skos:Concept;
  skos:prefLabel "kniespanten"@nl;
  skos:scopeNote "pant waarbij een (nagenoeg) verticaal onderdeel met een knik in één geheel doorloopt in een schuin gedeelte. (Haslinghuis)"@nl;
  skos:altLabel "kniespant"@nl;
