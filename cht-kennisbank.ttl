  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fb3f4179-aa79-4ed3-b0f9-f4e61ead43a9>
  a skos:Concept;
  skos:prefLabel "vurenhout"@nl;
  skos:scopeNote "Het Nederlandse woord vuren is de genormeerde naam voor het hout van de fijnspar (Picea abies). Het wordt dan vurenhout genoemd. In Nederland is vuren de meest gebruikte naaldhoutsoort, en daarmee de meest gebruikte houtsoort. Het is niet alleen makkelijk te bewerken maar ook relatief goedkoop"@nl;
  skos:altLabel "vuren (hout)"@nl, "vuren (houtsoort)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/abd006a6-d9c0-4170-a488-776d9e8ca157>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/e7db678b-14db-468c-afae-cef0fb2dff1c>,
