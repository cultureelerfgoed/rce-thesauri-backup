  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/25dc552f-d3de-448c-9442-8fe20bc5a6b6>
  a skos:Concept;
  skos:prefLabel "wielen (vervoer)"@nl;
  skos:scopeNote "Wielen zijn er in vele soorten: stalen schijfwielen, draadspaakwielen en gegoten lichtmetalen wielen. Wielen moeten sterk, licht en goed uitgebalanceerd zijn. (ANWB / Het Beste Autohandboek 1972)"@nl,
    "Plat, rond lichaam, draaibaar om een as door zijn middelpunt, dat dient om een bepaalde beweging over te brengen. (Van Dale groot woordenboek (1989))"@nl;
  skos:altLabel "wiel (vervoer)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0e8a6dfe-1280-4414-9a64-ca190bac648f>;
