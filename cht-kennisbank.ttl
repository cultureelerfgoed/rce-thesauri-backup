    <https://data.cultureelerfgoed.nl/term/id/cht/48979a0e-6eb9-4496-903d-a82e4241030c>,
    <https://data.cultureelerfgoed.nl/term/id/cht/5e0d8734-844c-4cff-ae9c-2e5aeddcf678>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

