<https://data.cultureelerfgoed.nl/term/id/cht/ecf1b983-1047-4012-8415-45c07eb66718>
  a skos:Concept;
  skos:prefLabel "asbest"@nl;
  skos:scopeNote "Asbest bestaat uit vezelige silicaatmineralen; het werd op ruime schaal gebruikt in gebouwen en textiel wegens zijn hittebestendigheid en warmte-isolerende eigenschappen, tot de kankerverwekkende eigenschappen ervan werden ontdekt. (Conservation Dictionary)"@nl,
    "Asbestvezels zijn natuurlijke minerale vezels bestaande uit silicaten. Asbest is al sinds oude tijden in textiel verwerkt."@nl;
  skos:altLabel "asbestvezel"@nl, "bergvlas"@nl, "steenvlas"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f3e24442-1423-4a3d-958f-692a0dd7099c>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/2a253cd7-d840-40ca-bca2-0fc3f3cdbfe1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/eec62887-7945-4c5b-81e9-c28772973a77>
  a skos:Concept;
  skos:prefLabel "Noorse leien"@nl;
  skos:scopeNote "Noorse leien gebruikt van uitzonderlijke grote afmetingen en dikte van ongeveer één centimeter, groen en roestkleurig. ("@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bc50e54d-2c3e-4b8e-8b4f-ab865b297b08>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/eef8ca9e-e9f2-4420-88ce-2ac1c7e8c448>
  a skos:Concept;
  skos:prefLabel "auripigment"@nl;
  skos:scopeNote "Het mineraal auripigment is een arseen-sulfide met de chemische formule As2S3. (Wikipedia)"@nl;
  skos:altLabel "orpiment"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/caf2fcaa-7437-40fb-bca4-a7c711aa5cf8>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f0cbc90b-216a-4f0f-b241-d91f7b7a96f9>
  a skos:Concept;
  skos:prefLabel "Luxemburgse leien"@nl;
  skos:scopeNote "Luxemburgse leien zijn natuurstenen dakpannen uit Luxemburg, bekend om hun duurzaamheid en veel gebruikt in traditionele bouwstijlen in de regio."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bc50e54d-2c3e-4b8e-8b4f-ab865b297b08>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f17aaf4b-2264-458d-a00f-4bd17d0b3aaf>
  a skos:Concept;
  skos:prefLabel "groene aarde"@nl;
  skos:scopeNote "Verwijst naar een reeks groene kleuren die lijken op de kleuren van groene aardpigmenten, die zijn samengesteld uit diverse mineralen. (bouwmaterie)"@nl;
  skos:altLabel "boheemse groene aarde"@nl, "verdeterra"@nl, "veronese groene aarde"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9a18ce2d-c3dd-44e4-9542-9f973f7d6c4a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f2f4d86e-2087-4919-a2f3-eae70301f978>
  a skos:Concept;
  skos:prefLabel "tegelmortel"@nl;
  skos:scopeNote "Tegelmortel is een mortel die gebruikt wordt voor het bevestigen van tegels op vloeren of wanden. Deze mortel zorgt voor een sterke en duurzame hechting tussen de tegel en de ondergrond."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/76079c9c-8e0d-4487-a35c-c1793bbaf0d7>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f97fcb75-9669-4d4c-8413-ccfe020201ef>
  a skos:Concept;
  skos:prefLabel "rameh"@nl;
  skos:scopeNote "Rameh is een textielvezel die onder plantaardige vezels valt en wordt gewonnen uit de bast van de ramieplant. Het is bekend om zijn sterkte, glans en weerstand tegen bacteriën."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d392ecd6-f402-4136-9dea-467467620f69>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fc4621ec-39d2-4399-a340-90dea3e9788f>
  a skos:Concept;
  skos:prefLabel "harder"@nl;
  skos:scopeNote "Harder is een materiaal dat in verschillende industrieën wordt gebruikt als additief om de hardheid en duurzaamheid van andere materialen te verbeteren. Het wordt vaak toegepast in coatings, bouwmaterialen en kleefstoffen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bc3bcd42-fb5e-424f-8dec-e20637dc520f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ff273d63-d34f-48c2-bf70-cbdb6fd21607>
  a skos:Concept;
  skos:prefLabel "slakkencement"@nl;
  skos:scopeNote "Slakkencement, niet te verwarren met hoogovencement of ijzerportlandcement, bestaat voor 70-85% uit gegranuleerde, basische hoogovenslakken en verder uit droog gebluste vette of hydraulische kalk, welk samen worden vermengd en fijngemalen. verhardt aan de lucht zeer slecht en bederft snel. Niet geschikt voor het maken van metselmortels en beton. (Scharroo, P.W. Beton. Handleiding voor den betonvakarbeider. 1940)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5edf3ff6-8b94-4892-b1ce-af9a41d5a5b5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ffe00da2-8062-4f10-9cb6-4b55d892df77>
  a skos:Concept;
  skos:prefLabel "sojalijm"@nl;
  skos:scopeNote "Plantaardig proteïnelijm gemaakt van geëxtraheerd sojameel; het heeft een grotere kleefkracht en waterbestendigheid dan de meeste andere plantaardige lijmen en het wordt in droge vorm op de markt gebracht en voornamelijk gebruikt voor multiplex voor binnenshuis. (bouwmaterie)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ecc85a42-eb28-4491-9676-d835b6858bb1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2d22c912-b41b-4bdd-8a36-2df656d986c8>
  a skos:Concept;
  skos:prefLabel "schuddemantels"@nl;
  skos:scopeNote "Gebouwtje waar de misgewaden werden bewaard. (Haslinghuis)"@nl;
  skos:altLabel "schuddemantel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7710d7ac-1f51-4b63-816b-5b911f808a63>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/feac38ce-c379-4ee5-b623-e599acf252e0>
  a skos:Concept;
  skos:prefLabel "potkachels"@nl;
  skos:scopeNote """Potkachels is de verzamelnaam voor een reeks kachels, type bovenafbranders, zoals de salamanders en vulkachels. (Kachels / R. Rook, Utrecht/Aartselaar, 1985) 
Eenvoudige gegoten ronde kachels waarop men koken kan."""@nl;
  skos:altLabel "potkachel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b0c78b3b-8b3f-42f6-a904-fd186ce5316f>;
