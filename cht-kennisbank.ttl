<https://data.cultureelerfgoed.nl/term/id/cht/86e6d522-5a76-49fb-85cb-cfe6d17e16df>
  a skos:Concept;
  skos:prefLabel "hybride zonnewijzers"@nl;
  skos:scopeNote "Hybride zonnewijzers zijn een kruising tussen een poolstaafzonnewijzer en een analematische zonnewijzer. De pool staat scheef op de datumschaal. (Zonnewijzers in Nederland / J.G. van Cittert-Eymers en M.J. Hagen, Zutphen 1984)"@nl;
  skos:altLabel "hybride zonnewijzer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ef27a877-7e1e-4ceb-914a-0319fe020061>;
