<https://data.cultureelerfgoed.nl/term/id/cht/7c08c4b7-a62f-4cf2-89b5-f46e4821c0e2>
  a skos:Concept;
  skos:prefLabel "Kolossale orde"@nl;
  skos:scopeNote "Kolossale orden zijn zuilenorden waarbij de zuilen over de volle hoogte of over meer dan één verdieping opgaan. Dat geldt ook voor halve of driekwart of pilasters. De door vensters en bouwlagen gegeven maten spelen daarbij geen rol. (Haslinghuis)"@nl;
  skos:altLabel "grote orde"@nl, "grote orden"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e24ce2f5-b7b0-4c96-b9f5-c38600c6ae74>;
