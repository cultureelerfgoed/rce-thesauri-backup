<https://data.cultureelerfgoed.nl/term/id/cht/414ee9ac-df35-4120-a036-aebfed23cfe8>
  a skos:Concept;
  skos:prefLabel "saaihallen"@nl;
  skos:scopeNote "Saaihallen zijn markthallen waar saai, een soort fijn wollen stof, werd verhandeld, vaak belangrijk in steden met een bloeiende textielindustrie."@nl;
  skos:altLabel "saaihal"@nl;
