<https://data.cultureelerfgoed.nl/term/id/cht/890af9d8-e121-4f3a-b01a-c41a370cff24>
  a skos:Concept;
  skos:prefLabel "hangbodemreservoirs"@nl;
  skos:scopeNote "Hangbodemreservoirs zijn vrijdragende reservoirs met een hangende bodem. Er zijn geen ondersteunende balken nodig. Het gewicht van het water wordt overgedragen op een drukring. (Henk van der Veen, Watertorens in Nederland. 1994, p. 36)"@nl;
  skos:altLabel "hangbodemreservoir"@nl;
