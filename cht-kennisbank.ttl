  a skos:Concept;
  skos:prefLabel "bruinharthout"@nl;
  skos:scopeNote "Bruinharthout is een duurzame houtsoort die bekend staat om zijn harde en sterke eigenschappen, vaak gebruikt voor constructie, meubels en vloeren."@nl;
  skos:altLabel "Surinaams bruinharthout"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
