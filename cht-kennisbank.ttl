  a skos:Concept;
  skos:prefLabel "soisijnse steen"@nl;
  skos:scopeNote "Grijze kolenkalksteen of hardsteen uit de omgeving van Soignies (Zinnik) in Henegouwen. De naam werd vermengd met de verwante steen uit Ecaussinnes, escosijnse steen. (Haslinghuis)"@nl;
