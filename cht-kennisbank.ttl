<https://data.cultureelerfgoed.nl/term/id/cht/06647fdd-3dc0-4cf7-bb83-7fd77a8fd0e9>
  a skos:Concept;
  skos:prefLabel "schuiven (ezel)"@nl;
  skos:scopeNote "Houten raam in de ezel. Is met wiggen verstelbaar waardoor de vangbalk in de hoogte is af te stellen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/04770e4f-1c11-40e7-a256-9de8c6d569c6>;
