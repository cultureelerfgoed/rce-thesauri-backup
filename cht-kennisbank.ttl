<https://data.cultureelerfgoed.nl/term/id/cht/fea11589-3138-4ff9-bb67-22a0088e1fe8>
  a skos:Concept;
  skos:prefLabel "kookstenen"@nl;
  skos:scopeNote "Brok van een door hitte-inwerking kapot gesprongen kei. Vaak is er sprake van roodverkleuring en haarscheuren. Aangenomen wordt dat ze ontstonden door de toevoeging van verhitte stenen aan water in een container, om dat aan de kook te brengen. De koudeschok leidt tot breuk. (ABR)"@nl;
  skos:altLabel "kooksteen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/19c3b976-4e95-40b9-aebf-6fc0215cf022>
  a skos:Concept;
  skos:prefLabel "accoladebouwnaden"@nl;
  skos:scopeNote "Fraai afgewerkte bouwnaad, min of meer in de vorm van een staande accolade, XVI-XVII. (Haslinghuis)"@nl;
  skos:altLabel "accoladebouwnaad"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/82376367-010f-4707-8803-dea76d55485e>
  a skos:Concept;
  skos:prefLabel "natuurhistorische musea"@nl;
  skos:scopeNote "Gebouwen met musea met collecties met als onderwerp de eigenschappen van natuurvoorwerpen, planten, dieren; bijvoorbeeld opgezette vogels en zoogdieren, geprepareerde insecten en planten, stenen, mineralen en fossielen. (AAT)"@nl;
  skos:altLabel "natuurhistorisch museum"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/3b0593ba-153a-46fd-baa4-8ae54475f015>;
