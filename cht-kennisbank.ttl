<https://data.cultureelerfgoed.nl/term/id/cht/ab6f5cfb-99c7-4773-b885-a6a2e144cc7f>
  a skos:Concept;
  skos:prefLabel "erfpachtcanon"@nl;
  skos:scopeNote "Erfpachtcanon is een geldsom die de erfpachter verplicht is om aan de eigenaar te betalen, op al dan niet regelmatig terugkerende tijdstippen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a25a2f3d-a179-41c7-8d37-cd4da30b7d9f>;
