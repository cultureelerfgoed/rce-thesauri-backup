<https://data.cultureelerfgoed.nl/term/id/cht/40405e1f-94b1-4ee6-939a-7549e84c8372>
  a skos:Concept;
  skos:prefLabel "beschotten (plankafscheiding)"@nl;
  skos:scopeNote "Schot, lichte afscheiding van planken, die kan fungeren als niet dragende wand of als dakbebording. (Haslinghuis)"@nl;
  skos:altLabel "beschot (plankafscheiding)"@nl;
