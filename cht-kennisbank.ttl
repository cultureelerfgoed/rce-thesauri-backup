  a skos:Concept;
  skos:prefLabel "inzagen"@nl;
  skos:scopeNote "In de boekbinderij: het proces waarbij groeven in de achterkant van een boekblok worden gezaagd voor de touwen waarop de katernen worden genaaid. (AAT-Ned)"@nl;
