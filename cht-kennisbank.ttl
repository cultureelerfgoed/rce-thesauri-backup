<https://data.cultureelerfgoed.nl/term/id/cht/72d910b6-48c1-42f3-b4e5-c979bb22b07a>
  a skos:Concept;
  skos:prefLabel "viaducten"@nl;
  skos:scopeNote "Bruggen, meestal rustend op een reeks bogen, die wegen of spoorwegen over lagergelegen terrein heen voeren. (AAT-Ned)"@nl;
