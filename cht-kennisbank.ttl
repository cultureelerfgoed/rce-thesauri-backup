<https://data.cultureelerfgoed.nl/term/id/cht/9d2cc8f4-0f5f-4873-bf48-3826b6de452f>
  a skos:Concept;
  skos:prefLabel "albast"@nl;
  skos:scopeNote "Albast is een gesteente, bestaande uit een massieve, gewoonlijk doorschijnende, vorm van in de natuur voorkomend gips, CaSO<sub>4</sub>.2H<sub>2</sub>O. Albast werd gebruikt om beelden te snijden en, in de 16e en 17e eeuw in Italië, als ondergrond voor olieverfschilderijen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fc2fe801-ca2c-4905-b8fb-3aff062b9284>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/2badf78d-af07-466d-92a3-0d03ca3f3a4f>,
    <https://data.cultureelerfgoed.nl/term/id/cht/5a0e96f2-dce0-412d-93e8-0361a523e87b>;
