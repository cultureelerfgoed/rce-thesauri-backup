<https://data.cultureelerfgoed.nl/term/id/cht/841c4e6d-680a-4d1e-a5b4-682eaa8f92da>
  a skos:Concept;
  skos:prefLabel "fotolithografieën (procedé Asser)"@nl;
  skos:scopeNote "Fotolithografische afdrukken waarmee foto’s snel en goedkoop in drukinkt konden worden gereproduceerd en op grote schaal worden verspreid. Vanaf 1857 ontwikkeld door de Amsterdamse jurist en amateurfotograaf Eduard Isaac Asser (1809-1894). (Project Fotografie)"@nl;
  skos:altLabel "fotolithografie (procedé Asser)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d3cf6ba8-a7cf-4082-be0c-b2e02568f014>;
