<https://data.cultureelerfgoed.nl/term/id/cht/ef47fae3-98d7-4a92-9e98-cb54863c3ec0>
  a skos:Concept;
  skos:prefLabel "frigidaria"@nl;
  skos:scopeNote "Onderdeel van de Romeinse thermen waarin zich koude baden bevinden. (Haslinghuis)"@nl;
  skos:altLabel "frigidarium"@nl;
