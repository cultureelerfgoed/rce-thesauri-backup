  skos:scopeNote "Groot zeiltuig op grote praam, in tegenstelling tot het kleine vaarttuig op kanalen."@nl;
  skos:altLabel "zeetuig"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/77f91bd1-4367-448a-903c-da826fa40e88>;
