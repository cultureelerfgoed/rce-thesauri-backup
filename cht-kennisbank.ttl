  a skos:Concept;
  skos:prefLabel "onverzadigd polyester"@nl;
  skos:scopeNote "Onverzadigd polyester is een thermohardend polymeer, veelgebruikt in composieten voor de bouw en maritieme industrie vanwege zijn goede mechanische eigenschappen en weerstand tegen chemicaliën."@nl;
  skos:altLabel "UP"@nl;
