<https://data.cultureelerfgoed.nl/term/id/cht/96d3b561-002c-4d5d-9621-21ea0107789f>
  a skos:Concept;
  skos:prefLabel "voederbieten"@nl;
  skos:scopeNote "De voederbiet (Beta vulgaris subsp. vulgaris var. crassa) is een biet die behoort tot dezelfde soort als de suikerbiet, maar met een laag suikergehalte. Voederbieten stammen uit de 18e eeuw en worden als veevoeder gegeven. (Wikipedia/MARDOC)"@nl;
  skos:altLabel "Beta vulgaris subsp. vulgaris var. crassa"@nl, "mangelwortel"@nl, "voederbiet"@nl;
