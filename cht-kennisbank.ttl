<https://data.cultureelerfgoed.nl/term/id/cht/809b325b-9354-4430-8310-f9a0e04995de>
  a skos:Concept;
  skos:prefLabel "welputten"@nl;
  skos:scopeNote "Welputten zijn waterputten die gevoed worden door welwater. Het welwater dat als drinkwater wordt opgehaald, kan relatief dicht onder de oppervlakte zitten."@nl;
