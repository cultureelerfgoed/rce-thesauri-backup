<https://data.cultureelerfgoed.nl/term/id/cht/1a6e19d3-cc33-4e03-bb92-38d53fe6293f>
  a skos:Concept;
  skos:prefLabel "slaghouten"@nl;
  skos:scopeNote "Lange, uitgerekte, meestal houten sticks in verschillende maten en vormen gebruikt om ballen mee te slaan in bepaalde sporten zoals honkbal en cricket. (AAT-Ned)"@nl;
  skos:altLabel "slaghout"@nl;
