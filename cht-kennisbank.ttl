<https://data.cultureelerfgoed.nl/term/id/cht/8c7a003f-3be2-476e-9441-7a92cc6faa7e>
  a skos:Concept;
  skos:prefLabel "gewelfschilderingen"@nl;
  skos:scopeNote "Gewelfschilderingen zijn schilderingen op een stenen of houten gewelf (Haslinghuis)"@nl,
