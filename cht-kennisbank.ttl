<https://data.cultureelerfgoed.nl/term/id/cht/f61ba737-0a7e-44c9-9c83-8d891bef92fd>
  a skos:Concept;
  skos:prefLabel "hangwrakken"@nl;
  skos:scopeNote "Hangwrakken zijn dakpannen die door beschadiging of misvorming niet aan panlatten opgehangen kunnen worden. Deze pannen werden gebruikt voor beschoeiingen en het leggen van dammen."@nl;
  skos:altLabel "hangwrak"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f1834398-e32b-4a85-acf4-7f71ab3f94d1>;
