<https://data.cultureelerfgoed.nl/term/id/cht/7bacb54e-017f-4a84-903e-7e5d9219659d>
  a skos:Concept;
  skos:prefLabel "parels"@nl;
  skos:scopeNote "Een gladde, ronde kraal die wordt gevormd in de schelp van bepaalde weekdieren. Wordt gebruikt voor sieraden en andere decoratieve doeleinden, en wordt als edelsteen beschouwd. (Toegepaste Kunst Project, RKD)"@nl;
  skos:altLabel "parel"@nl;
