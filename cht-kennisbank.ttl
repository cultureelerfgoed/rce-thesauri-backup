<https://data.cultureelerfgoed.nl/term/id/cht/b6c6d0cd-4c9d-421e-a4b5-b37abda71f34>
  a skos:Concept;
  skos:prefLabel "beslag"@nl;
  skos:scopeNote "Een Beslag is een voorlopige maatregel waarbij de overheid, al dan niet op vordering van een belanghebbende, bepaalde zaken aan iemands vrije beschikking onttrekt, of wel deze onder zich neemt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/190b9fce-fb0d-4b41-b46d-e1795ae38304>;
