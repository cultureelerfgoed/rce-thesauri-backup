<https://data.cultureelerfgoed.nl/term/id/cht/f4f1befd-7e92-4bf2-a9f5-7a1cdc0cc1ac>
  a skos:Concept;
  skos:prefLabel "mengmachines"@nl;
  skos:scopeNote "(korenmolen), machine voor de menging van veevoeder."@nl;
  skos:altLabel "mengmachine"@nl;
