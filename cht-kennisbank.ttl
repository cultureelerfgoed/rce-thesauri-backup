<https://data.cultureelerfgoed.nl/term/id/cht/b2458ebd-800a-4499-a6fa-ff56e904ba12>
  a skos:Concept;
  skos:prefLabel "bewakers"@nl;
  skos:scopeNote "Personen die zijn aangenomen om toezicht te houden of op wacht te staan. (AAT-Ned)"@nl;
  skos:altLabel "bewaker"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db4a7619-d236-4b14-8e79-b4a6e890f677>;
