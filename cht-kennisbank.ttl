<https://data.cultureelerfgoed.nl/term/id/cht/d07610b2-b8cd-4ece-b5ec-38315f983020>
  a skos:Concept;
  skos:prefLabel "hoekconsolen"@nl;
  skos:scopeNote "Wordt gebruikt voor kraagstenen die uit het kruispunt van twee muren steken. Wanneer ze aan de buitenkant geplaatst zijn dienen ze vaak om een kornis te ondersteunen. Wanneer ze aan de binnenkant zitten ondersteunen ze vaak een dakspant. (AAT-Ned)"@nl;
  skos:altLabel "hoekconsole"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4e481c81-319a-44da-86bf-106f145d22c1>;
