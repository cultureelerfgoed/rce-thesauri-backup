<https://data.cultureelerfgoed.nl/term/id/cht/55b87e4d-717e-4a71-a991-6ba62e85d085>
  a skos:Concept;
  skos:prefLabel "hoge duinen"@nl;
  skos:scopeNote "Een hoge duin is een kustduin, een heuvel van zand, en gelegen aan de kust. Kustduinen ontstaan doordat strandzand opwaait tot duinen. Het zand is door de stroming en de branding vanuit zee aangevoerd. De hoge duinen zijn vanaf ongeveer 1000 n.Chr. ontstaan. (Weerts & Bazelmans 2011)"@nl;
  skos:altLabel "hoge duin"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/77479da0-22eb-4b7a-8bac-e2f6f4b9c620>;
