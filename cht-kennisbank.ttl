<https://data.cultureelerfgoed.nl/term/id/cht/6480ca6b-c7c8-4cfa-9a09-321198493f93>
  a skos:Concept;
  skos:prefLabel "sociale media"@nl;
  skos:scopeNote "Sociale media (de Engelse term social media is ook in het Nederlands gangbaar) is een verzamelbegrip voor online platformen waar de gebruikers, zonder of met minimale tussenkomst van een professionele redactie, de inhoud verzorgen."@nl;
  skos:altLabel "social media"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d0c8f415-4493-40a9-b737-fedbf4f7dff6>;
