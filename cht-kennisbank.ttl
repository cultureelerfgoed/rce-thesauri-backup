  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bf54aba1-90f4-4211-9c44-2bc8d1a982f7>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/88b67174-1e9e-442f-957a-db1264d63be8>
  a skos:Concept;
  skos:prefLabel "monstransfoedralen"@nl;
  skos:scopeNote "Foedraal ter bewaring van een monstrans."@nl;
