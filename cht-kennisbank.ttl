<https://data.cultureelerfgoed.nl/term/id/cht/c8d5d592-3f5d-475a-9388-a1a18e55401e>
  a skos:Concept;
  skos:prefLabel "stoepbanken"@nl;
  skos:scopeNote "Vaste bank op een (particuliere) stoep, meestal bevestigd tussen de gevel van de woning en een stoepbaluster. Het is geen openbare zitplek. (AAT)"@nl;
