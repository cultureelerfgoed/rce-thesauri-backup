<https://data.cultureelerfgoed.nl/term/id/cht/5378b570-bf15-4cd6-8667-7c62dbf70da6>
  a skos:Concept;
  skos:prefLabel "kerkgang"@nl;
  skos:scopeNote "Het ter kerke gaan."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/190b9fce-fb0d-4b41-b46d-e1795ae38304>;
