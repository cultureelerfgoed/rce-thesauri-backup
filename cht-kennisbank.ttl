<https://data.cultureelerfgoed.nl/term/id/cht/951dd77d-ea4c-4fe4-8428-70d7b785d33d>
  a skos:Concept;
  skos:prefLabel "Ringperlen"@nl;
  skos:scopeNote "Type kraal, altijd van gekleurd glas, qua productie, samenstelling en voorkomen vergelijkbaar met La Tène armbanden echter geringer in omvang. Dateert uit de Midden en Late IJzertijd. (ABR)"@nl;
  skos:altLabel "Ringperle"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4127f7a9-e054-4222-a6ba-b496409bc06a>;
