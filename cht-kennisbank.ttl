<https://data.cultureelerfgoed.nl/term/id/cht/538983bc-936d-48f1-899f-3c6f1b6e9e19>
  a skos:Concept;
  skos:prefLabel "Amerikaans grenenhout"@nl;
  skos:scopeNote "Amerikaans grenen is afkomstig van de Douglasspar, een boom, die ook in Nederland tegenwoordig veelvuldig voorkomt. Naar gelang de groeiplaats wordt het ook Pitch-pine of Oregon-pine genoemd. (www.debinnenvaart.nl)"@nl;
  skos:altLabel "Amerikaans grenehout"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/544a4e60-e7a3-4084-aba1-05bffb34b706>;
