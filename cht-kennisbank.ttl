<https://data.cultureelerfgoed.nl/term/id/cht/fab1ac43-e74d-4216-a27d-aaf334dc940d>
  a skos:Concept;
  skos:prefLabel "technisch tekenen"@nl;
  skos:scopeNote "Technisch tekenen is het ambacht van het maken van tekeningen volgens de geldende normen en voorschriften. Dit in tegenstelling tot het vrij tekenen, wat een kunstvorm is. Het uiteindelijke doel van technisch tekenen is het bouwen van het getekende ontwerp. Op de tekening moet dus alle informatie voorkomen om het getekende te kunnen vervaardigen, eenduidig uitlegbaar.Het ontwerpen gebeurt in de regel door grafisch ontwerpers, constructeurs, architecten technici als technisch tekenaars. (Wikipedia)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bb72a9e0-c3fd-4506-9dc2-4b4335904db3>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a518dd93-2bb0-4b0d-bb74-0f7fc4da97de>
  a skos:Concept;
  skos:prefLabel "havenmeesters"@nl;
