<https://data.cultureelerfgoed.nl/term/id/cht/abff0732-c27c-4121-9617-9ba81bee16eb>
  a skos:Concept;
  skos:prefLabel "zadelhorens"@nl;
  skos:scopeNote "Omdat de stijgbeugel in de Romeinse tijd nog onbekend was en ruiters in het Romeinse leger toch stevig te paard moesten kunnen zitten, waren speciale zadels ontwikkeld met hoornvormige uitsteeksels, de zadelhoorns. Aan de achter- en voorkant staken die recht omhoog en gaven zo houvast. (bron: Museum het Valkhof)"@nl;
  skos:altLabel "zadelhoren"@nl, "zadelknop"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/8e4a1dd7-524e-4d6c-855b-2d85b2b74130>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/7f515c55-bdf4-4dcb-b193-cecb039f770a>
  a skos:Concept;
  skos:prefLabel "zadelbeslagen"@nl;
  skos:scopeNote "Zadelbeslag is het beslag dat ter versiering op een paardenzadel is aangebracht."@nl;
  skos:altLabel "zadelbeslag"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/8e4a1dd7-524e-4d6c-855b-2d85b2b74130>;
