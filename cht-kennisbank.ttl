  a skos:Concept;
  skos:prefLabel "autogeen lassen"@nl;
  skos:scopeNote "Autogeen lassen, ook wel gassmeltlassen of zuurstof-acetyleenlassen genoemd, is een lasmethode die gebruikmaakt van een zeer hete vlam. Meestal wordt gebruikgemaakt van de reactie van ethyn (acetyleen) met zuivere zuurstof. (Wikipedia)"@nl;
  skos:hiddenLabel "acetyleenvlam"@nl;
