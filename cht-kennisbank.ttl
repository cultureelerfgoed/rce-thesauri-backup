<https://data.cultureelerfgoed.nl/term/id/cht/986093f8-8b68-42b8-b2b1-1ba4886024ef>
  a skos:Concept;
  skos:prefLabel "doorgaand gewapend beton"@nl;
  skos:scopeNote "Doorgaand of continu gewapend beton is een type wegverharding dat in België frequent toegepast wordt. Het is een doorlopend en voegloos betonnen wegdek. (Wikipedia)"@nl;
  skos:altLabel "continu gewapend beton"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2a12497c-8217-40dc-a005-28be2814ee6d>;
