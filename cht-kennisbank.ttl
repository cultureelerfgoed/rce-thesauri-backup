<https://data.cultureelerfgoed.nl/term/id/cht/d45830ac-ba06-49f2-9cf7-cbc43aa91fb4>
  a skos:Concept;
  skos:prefLabel "kusttaluds"@nl;
  skos:scopeNote "Het kusttalud is als een flauwe helling zichtbaar in het landschap. Het talud is een overblijfsel van de oever van de voormalige Zuiderzee en is ontstaan onder invloed van golven en wind en bestaat uit zandige, kalkrijke klei . De Zuiderzee ontstond in de 13e eeuw na Chr. en werd door de Afsluitdijk in 1932 afgesloten waardoor het IJsselmeer ontstond. (Stouthamer et al. 2015)"@nl;
  skos:altLabel "kusttalud"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/41d0db11-7cd2-4cbb-b885-cc763b01298d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8d7fdc91-f0f2-475f-ac6b-656df02d23f3>
