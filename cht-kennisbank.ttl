  a skos:Concept;
  skos:prefLabel "kantoorwoningen"@nl;
  skos:scopeNote "Bij kantoorwoningen bevindt het kantoor zich op de begane grond, terwijl de woning op de eerste etage is gesitueerd."@nl;
