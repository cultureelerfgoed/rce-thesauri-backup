<https://data.cultureelerfgoed.nl/term/id/cht/177e303e-2f34-46c5-917e-f1e0632a8dbc>
  a skos:Concept;
  skos:prefLabel "trotseerloodjes"@nl;
  skos:scopeNote "Lapje lood dat de loodgieter aanbrengt over spijkers waarmee loodwerk is bevestigd om inwateren tegen te gaan. Meestal in schild- of medaillonvorm in een giettang vervaardigd. Het draagt gewoonlijk de initialen of naam van de loodgieter, een jaartal en een afbeelding van gereedschap (pomp, leidekkershamer e.d.). Ook: dakloodje, traceer-, traseer-, tranceer-, transeerlood(je). (Haslinghuis)"@nl;
  skos:altLabel "dakloden"@nl, "daklood"@nl, "dakloodje"@nl, "dakloodjes"@nl, "loodstrip"@nl,
    "loodstrippen"@nl, "traceerloodje"@nl, "traceerloodjes"@nl, "tranceerloodje"@nl, "tranceerloodjes"@nl,
    "transeerloodje"@nl, "transeerloodjes"@nl, "traseerloodje"@nl, "traseerloodjes"@nl,
    "trotseerlood"@nl, "trotseerloodje"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4e481c81-319a-44da-86bf-106f145d22c1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a2ddd589-d787-417d-b3dd-b594941aa8c2>
  a skos:Concept;
  skos:prefLabel "unica"@nl;
  skos:scopeNote "Unica kan verwijzen naar: unicaat - voorwerp dat door kunstnijverheid is vervaardigd, en dat een uniek exemplaar vormt unica (boek) - boekuitgave waarvan slechts één exemplaar bekend is UNICA - netwerk van Europese universiteiten Unica - Union Internationale du Cinéma, organisatie ter bevordering van het amateurfilmen (Wikipedia)"@nl;
  skos:altLabel "unicaat"@nl, "unicaten"@nl;
  skos:hiddenLabel "unica's"@nl;
