<https://data.cultureelerfgoed.nl/term/id/cht/9332ac36-d958-4de5-835b-c61931b0df44>
  a skos:Concept;
  skos:prefLabel "limace-schaven"@nl;
  skos:scopeNote "Smal, slug-shaped (naaktslakvormig), eenzijdig bewerkt werktuig met steile randen en een ‘hoog’ dorsaal oppervlak dat vaak afgerond is. Vermoedelijk was het werktuig geschacht en werd het gebruikt als chisel (=beitel). (ABR)"@nl;
  skos:altLabel "limace-schaaf"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/16a2b01d-6b53-462f-9793-80ebb06a6f43>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/16c4c6ae-1c88-486a-8f47-87136d2e2f5f>
