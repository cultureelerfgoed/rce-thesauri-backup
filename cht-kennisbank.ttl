  a skos:Concept;
  skos:prefLabel "brandijzers"@nl;
  skos:scopeNote "Een brandijzer is een soort metalen stempel aan een lange, haakse, stalen, steel waarmee men het brandmerk aanbracht. Brandijzers die door de scheepsmeter gebruikt werden, bestonden meestal merken met één enkele cijfer of letter. Brandmerken waarmee men zijn eigen bezit, vaatjes, emmers, enz. en bijv. vissers. (bron: de binnenvaart)"@nl,
    "Een brandrijzer is gloeiend heet gestookte stalen staaf, waarmee gaten in hout gemaakt worden. (bron: de binnenvaart)"@nl;
  skos:altLabel "brandijzer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

