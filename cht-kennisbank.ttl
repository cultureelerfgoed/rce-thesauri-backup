<https://data.cultureelerfgoed.nl/term/id/cht/1993b8ef-cf0f-40f2-9f58-22f61d2b0aa5>
  a skos:Concept;
  skos:prefLabel "rostra"@nl;
  skos:scopeNote "Hoog platform op een Romeins forum waarop toespraken werden gehouden en besluiten van de stadsregering werden voorgelezen. (Haslinghuis)"@nl;
  skos:altLabel "rostrum"@nl;
