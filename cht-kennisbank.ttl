<https://data.cultureelerfgoed.nl/term/id/cht/a649e34a-62a6-486f-ba59-847a07798b38>
  a skos:Concept;
  skos:prefLabel "ijsputten"@nl;
  skos:scopeNote "IJsputten zijn ondergrondse putten voor de opslag van ijs. De wanden zijn er van hout of steen. Bovengronds is een puntig zadeldak van hout en riet aangebracht. Een aansluitende luchtsluis met geïsoleerde deuren geeft toegang tot de put. De ijsput is een bijzonder type ijsbewaarplaats. (IJskelders, koeltechnieken van weleer / A.W. Reinink en J.G. Vermeulen, Nieuwkoop 1981)"@nl;
  skos:altLabel "ijsput"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cc35695d-14c2-4533-8dde-d121a0b71bda>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/5f8eab4e-9913-4db4-a219-53013572cb50>
  a skos:Concept;
  skos:prefLabel "stuiken"@nl;
  skos:scopeNote "Stuiknaad; de naad tussen twee in elkaars verlengde liggende planken waarvan de koppen ter plaatse van de naad schuin of recht zijn afgezaagd."@nl;
  skos:altLabel "stuik"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/77f91bd1-4367-448a-903c-da826fa40e88>;
