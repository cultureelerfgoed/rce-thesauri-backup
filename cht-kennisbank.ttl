<https://data.cultureelerfgoed.nl/term/id/cht/dba7451d-d5fc-4e08-a9ef-75bb8828b8b1>
  a skos:Concept;
  skos:prefLabel "Early English style"@nl;
  skos:scopeNote "Vroege periode van de Engelse gotiek, ook ‘Lancet style’ genoemd, van c. 1175 tot 1275, wat later dan de vroege gotiek op het vasteland van Europa. De gotiek werd naar Engeland gebracht door William van Sens, die naar Canterbury reisde om de kathedraal, die in 1174 was afgebrand, te herbouwen. (Haslinghuis)"@nl;
  skos:altLabel "Lancet style"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9e8b7e42-e2cf-4070-8f1c-c88ee97bd112>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8c5a6026-2755-426f-a621-08a29fe7b171>
  a skos:Concept;
  skos:prefLabel "tepidaria"@nl;
  skos:scopeNote "Zaal voor lauwe baden in de Romeinse thermen. (Haslinghuis)"@nl;
