<https://data.cultureelerfgoed.nl/term/id/cht/7174f649-1952-4681-afc5-2d3a3852e1fc>
  a skos:Concept;
  skos:prefLabel "tinspuiten"@nl;
  skos:scopeNote "Waar het tinerts dicht aan, de oppervlakte ligt, spuit men het met een grote spuitinstallatie los. Hiervoor gebruikt men een tinspuitinstallatie.(bron: Ensie)"@nl;
