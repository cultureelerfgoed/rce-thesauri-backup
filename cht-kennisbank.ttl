<https://data.cultureelerfgoed.nl/term/id/cht/c6e6e47a-86ce-452b-bff1-b039db722d47>
  a skos:Concept;
  skos:prefLabel "brandgangen"@nl;
  skos:scopeNote "Zeer smalle steeg tussen twee naast elkaar gelegen stadshuizen, waardoor brandslangen geleid kunnen worden en die ook watergang (osendrop) kan zijn. (Haslinghuis)"@nl;
