<https://data.cultureelerfgoed.nl/term/id/cht/4dc234da-a465-412f-8d33-38215c920d18>
  a skos:Concept;
  skos:prefLabel "sergeant-majoor (landmacht)"@nl;
  skos:scopeNote "Een sergeant-majoor in de landmacht is een senior onderofficier die een sleutelrol speelt in de organisatie en discipline van een militaire eenheid, vaak verantwoordelijk voor de dagelijkse operaties."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f23b62ea-bf1a-4860-99da-5b9e05eb0538>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3f3638f6-f6d0-4be4-86c0-ef7a9b844330>
  a skos:Concept;
  skos:prefLabel "sergeant der 1e klasse (landmacht)"@nl;
  skos:scopeNote "Een sergeant der 1e klasse in de landmacht is een gevorderde onderofficier die een grotere verantwoordelijkheid draagt en leiding geeft aan meerdere teams of een sectie."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f23b62ea-bf1a-4860-99da-5b9e05eb0538>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c958be78-7c96-4084-a003-b854bd3f6bc1>
  a skos:Concept;
  skos:prefLabel "sergeant (landmacht)"@nl;
  skos:scopeNote "Een sergeant in de landmacht is een onderofficier die een cruciale rol speelt in het leiden van kleinere groepen soldaten en het uitvoeren van tactische operaties op het slagveld."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f23b62ea-bf1a-4860-99da-5b9e05eb0538>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

