  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/075324eb-9bac-4f7d-bd42-e4d2afdacc4a>
  a skos:Concept;
  skos:prefLabel "Hunze-Eems-hielbijlen"@nl;
  skos:scopeNote "Robuust bijltype met relatief groot oor en (zaagtand-) versiering rond forse kokermond. Noord-Nederlands type, komen voor tot in het rivierengebied. (ABR)"@nl;
  skos:altLabel "Hunze-Eems-hielbijl"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/85fea1d1-1bc0-44a1-aa46-8e9d01acad6a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f1dcc3d3-8b17-4fd5-bcb7-995e38ec3ba4>
  a skos:Concept;
  skos:prefLabel "Fels-Absatzbeilen Schaftrillenbeil"@nl;
  skos:scopeNote "Stenen bijl met een sprongsgewijze verjonging naar de top. De verjonging kan betrekking hebben op drie zijden en daarbij al dan niet gepaard gaan met een diepe, ¾ omlopende brede groef (met als resultaat een verdikking aan de top), of betrekking hebben op alle vier de zijden (geen groef). (ABR)"@nl;
  skos:altLabel "Fels-Absatzbeil"@nl, "Schaftrillenbeil"@nl, "Schaftrillenbeilen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/62e02a4b-4af5-491f-a78f-e2b60621021e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4d220249-ab68-49aa-9fa8-4cade656be8d>
  a skos:Concept;
  skos:prefLabel "Flint-Rechteckbeilen"@nl;
  skos:scopeNote "In algemene zin kan betreft dit een hak-/kapwerktuig van vuursteen dat gekarakteriseerd wordt door een rechthoekige dwarsdoorsnede, dat geheel of gedeeltelijk is geslepen. (ABR)"@nl;
  skos:altLabel "Flint-Rechteckbeil"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/62e02a4b-4af5-491f-a78f-e2b60621021e>;
