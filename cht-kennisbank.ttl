<https://data.cultureelerfgoed.nl/term/id/cht/b8cf81e4-b459-4b18-9637-a1b8cb2534e5>
  a skos:Concept;
  skos:prefLabel "stopbouten"@nl;
  skos:scopeNote "Het iets gebogen einde van dit gereedschap heeft een vlakke voet. De bout heeft een houten hecht waaraan de heet gemaakte bout vastgehouden kan worden."@nl;
  skos:altLabel "stopbout"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b73558d7-9814-4c3b-8c11-f9404f1a3aba>;
