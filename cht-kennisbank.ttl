<https://data.cultureelerfgoed.nl/term/id/cht/4420dad7-8395-4277-964e-f7bfe709ade4>
  a skos:Concept;
  skos:prefLabel "metshamers"@nl;
  skos:scopeNote "Metselaarshamer, wellicht identiek met kaphamer. (Haslinghuis)"@nl;
  skos:altLabel "metshamer"@nl;
