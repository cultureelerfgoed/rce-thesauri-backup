<https://data.cultureelerfgoed.nl/term/id/cht/bebcd2c1-75bd-47b8-91ae-dc15c8b8b00f>
  a skos:Concept;
  skos:prefLabel "breipennen"@nl;
  skos:scopeNote "Een breipen is een lange, rechte naald met stompe punt, gebruikt bij handmatig breien van textiel. Wordt per paar gebruikt en is verkrijgbaar in diverse diktes en lengtes."@nl;
  skos:altLabel "breipen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/856cfbf2-6474-48a8-b962-97396682851a>;
