<https://data.cultureelerfgoed.nl/term/id/cht/7abba28e-31f9-4865-8eca-d5febe08d3c3>
  a skos:Concept;
  skos:prefLabel "druk"@nl;
  skos:scopeNote "Druk is de kracht die op een voorwerp werkt en die het probeert te vervormen. De druk wordt gemeten als de kracht gedeeld door het oppervlak waarop hij werkt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/929f2b49-e558-4543-a710-41a893c3c5dd>;
