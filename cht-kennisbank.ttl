<https://data.cultureelerfgoed.nl/term/id/cht/2d25575c-d3ee-4394-b95b-50ede7483508>
  a skos:Concept;
  skos:prefLabel "admiraliteitscolleges"@nl;
  skos:scopeNote "Admiraliteitscolleges zijn colleges in de Republiek der Verenigde Nederlanden die onder het opperbewind van de admiraal-generaal het bewind voerden over zeezaken."@nl;
  skos:altLabel "admiraliteitscollege"@nl;
