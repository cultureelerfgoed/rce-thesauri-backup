<https://data.cultureelerfgoed.nl/term/id/cht/bc1343e4-5ad1-4203-9892-fbfe70236dfa>
  a skos:Concept;
  skos:prefLabel "bleekselderij"@nl;
  skos:scopeNote "Bleekselderij, Apium graveolens var. dulce, is een selderij waarvan de bladstelen worden gegeten. Selderij met kunstmatig bleekgehouden stengels en bladeren. (Wikipedia/MARDOC)"@nl;
  skos:altLabel "Apium graveolens var. dulce"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/8ab29de2-0b79-41ca-ba0c-a9b55f232b84>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/19a8ed4a-d992-4e1c-af10-89384f118f56>
  a skos:Concept;
  skos:prefLabel "overgordijnen"@nl;
  skos:scopeNote "Overgordijnen zijn gordijnen die over andere gordijnen heen hangen. Vroeger gold ‘als de lamp opgaat, worden de gordijnen gesloten’. Indien dichtgetrokken, hangen overgordijnen in het zicht. Vaak zijn het dikkere gordijnen dan glasgordijnen. (Het Nederlandse interieur in beeld / C. Willemijn Fock e.a., Zwolle 2001)"@nl;
  skos:altLabel "overgordijn"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cb336fbe-378b-4518-a816-900ea1345a0c>;
