<https://data.cultureelerfgoed.nl/term/id/cht/c2a12670-5dd3-4dbe-bfdd-f18767341861>
  a skos:Concept;
  skos:prefLabel "gespiegelde luiken"@nl;
  skos:scopeNote "Gespiegelde luiken zijn opgeklampte luiken die als toevoeging geprofileerde klampen hebben. Deze geprofileerde klampen zijn op een zodanige wijze geplaatst en vast gespijkerd dat de suggestie van een paneelluik wordt opgeroepen. (Historische zonwering / B.H.J.N. Kooij, RCE Brochure, Amersfoort, 2012)"@nl;
  skos:altLabel "gespiegelde luik"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1f1fb20b-7734-4e0a-9f9a-1aaeb49269f0>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d16081f0-178f-4ac2-8e99-091539b26f6b>
  a skos:Concept;
  skos:prefLabel "binnenschuifluiken"@nl;
  skos:scopeNote "Binnenschuifluiken zijn houten luiken die binnen open en dicht kunnen worden geschoven. Ze komen al in de 18de eeuw voor, maar de toepassing van buitenschuifluiken vond pas na 1900 plaats. (Historische zonwering / B.H.J.N. Kooij, RCE Brochure, Amersfoort, 2012)"@nl;
  skos:altLabel "binnenschuifluik"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1f1fb20b-7734-4e0a-9f9a-1aaeb49269f0>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ea05f903-5edb-4bc9-855b-b97f1c5c7a81>
  a skos:Concept;
  skos:prefLabel "rookluiken"@nl;
  skos:scopeNote "Rookluiken zijn luiken in rieten daken van huizen en boerderijen zonder schoorsteen, om rook van het open-vuurhaard te laten ontwijken. Door de luiken open te draaien, kan de rook van het open-haardvuur afgevoerd worden. Omdat de doorgang in het dak vaak rondom is afgetimmerd met planken, spreekt men ook over rookkisten. (Haslinghuis)"@nl;
  skos:altLabel "rookkist (luik)"@nl, "rookkisten (luik)"@nl, "rookluik"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1f1fb20b-7734-4e0a-9f9a-1aaeb49269f0>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ee88d49f-27bb-4610-b018-04f4a0ca78b1>
  a skos:Concept;
  skos:prefLabel "kistluiken"@nl;
  skos:scopeNote "Kistluiken zijn met luiken gesloten en door planken omgeven ventilatieopeningen bij de nok van daken, vaak rieten daken, van stallen of hooihuizen van boerderijen. De luiken draaien net als rookluiken aan de onderzijde. Kistluiken komen voornamelijk in Noord-Holland en Friesland voor. (Haslinghuis)"@nl;
  skos:altLabel "huiskist"@nl, "huiskisten"@nl, "kistluik"@nl, "slachkist"@nl, "slachkisten"@nl,
    "slagkist"@nl, "slagkisten"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1f1fb20b-7734-4e0a-9f9a-1aaeb49269f0>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f27d93eb-d1fc-465a-b6bb-09e0c0f7071e>
  a skos:Concept;
