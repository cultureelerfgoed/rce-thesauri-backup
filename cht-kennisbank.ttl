<https://data.cultureelerfgoed.nl/term/id/cht/057400f8-424b-4e89-989e-b583ff8bac5d>
  a skos:Concept;
  skos:prefLabel "visinmakerijen"@nl;
  skos:scopeNote "Visinmakerijen zijn visverwerkingsplekken waar vis wordt geweckt of ingemaakt. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "visinmakerij"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b394b67c-f229-46f4-afe1-bc234818ca26>;
