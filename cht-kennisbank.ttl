<https://data.cultureelerfgoed.nl/term/id/cht/715c6539-4c15-4534-b741-72bc9c6a9ee1>
  a skos:Concept;
  skos:prefLabel "diaconessen"@nl;
  skos:scopeNote "Diaconessen zijn vrouwelijke leden van protestantse zorggemeenschappen. Zij verrichten verpleegkundig en maatschappelijk werk op religieuze basis."@nl;
