<https://data.cultureelerfgoed.nl/term/id/cht/d9fd77ad-7052-4e12-98e5-ba2787420cf2>
  a skos:Concept;
  skos:prefLabel "wijwaterbekkens"@nl;
  skos:scopeNote "Wijde houder voor wijwater op een verhoog, op een voetstuk, bevestigd aan of ingemetseld in de muur. Heeft zijn plaats bij de ingang van een rooms- of oud-katholieke kerk. De gelovige doopt er enkele vingers in bij binnenkomst en maakt dan het kruisteken ter herinnering aan zijn doop. Wordt ook wel wijwaterbak genoemd."@nl;
  skos:altLabel "wijwaterbekken"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/abfc1bb7-04d7-43a0-9e99-dd4c5a4f2c15>;
