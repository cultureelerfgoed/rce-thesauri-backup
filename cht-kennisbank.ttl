  a skos:Concept;
  skos:prefLabel "schootijzers"@nl;
  skos:scopeNote "Steunijzers, uitgehakt in de roed, ter versteviging van de bordzijde. Vooral toegepast bij het gevlucht van pelmolens."@nl;
