<https://data.cultureelerfgoed.nl/term/id/cht/001ffbdb-589b-4243-84cb-fab6815c4bac>
  a skos:Concept;
  skos:prefLabel "keggen"@nl;
  skos:scopeNote "Taps toelopende klos hout, aan beide zijden vlak, die wordt gebruikt om iets tussen twee vaste punten vast te zetten."@nl;
