<https://data.cultureelerfgoed.nl/term/id/cht/71ed4681-5885-45fd-9a08-9eea55289981>
  a skos:Concept;
  skos:prefLabel "plunjers"@nl;
  skos:scopeNote "Een plunjer in de SU carburateur remt de snelheid, waarmee de zuiger stijgt af en veroorzaakt daardoor een rijker mengsel tijdens het accelereren."@nl;
  skos:altLabel "plunjer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0a0b798b-453c-43ca-a048-174acb18a717>;
