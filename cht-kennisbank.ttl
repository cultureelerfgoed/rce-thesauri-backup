<https://data.cultureelerfgoed.nl/term/id/cht/c64fa825-4c24-4faa-a610-1a9ce08b76b2>
  a skos:Concept;
  skos:prefLabel "overslagstations"@nl;
  skos:scopeNote "Overslagstations zijn stations waar meerdere vervoersstromen samen komen om goederen van het ene vervoermiddel op een ander vervoermiddel over te hevelen."@nl;
  skos:altLabel "overslagstation"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9662347a-4c85-440f-918a-3bbfc5e4b1bf>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/dacfe5ae-ddca-4153-b597-2068c829c27f>
  a skos:Concept;
  skos:prefLabel "lippen"@nl;
  skos:scopeNote "Inhoeking of afschuining waarmee het uiteinde van een stuk hout of balk in of over een ander stuk hout grijpt. Het is op die plaats dunner gemaakt, b.v. om een las te maken. In de M.e. en XVI werden ontmoetingen van stijlen en balken met schoren vaak als lip uitgevoerd, vaak met een zwaluwstaart. In het Duits spreekt men van ‘Blatt’. In Duitsland werden deze ‘Anbattungen’ in XVI soms verboden omdat ze een minder deugdelijke houtverbinding zouden vormen dan een pen- en gatverbinding. Dat geldt zeker voor het daar veelvuldig gebruikte dennenhout. (Haslinghuis)"@nl;
  skos:altLabel "lip"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4e481c81-319a-44da-86bf-106f145d22c1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/32265bf9-26e4-4fc7-b6a6-c85dac61bfc2>
  a skos:Concept;
  skos:prefLabel "broekstukken (molen)"@nl;
  skos:scopeNote "Verbinding tussen penbalk en korte spruit. Vangt de druk op die de wind op het gevlucht uitoefent."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/04770e4f-1c11-40e7-a256-9de8c6d569c6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2e0c750f-5ea6-41b6-a3b8-648453272e6d>
  a skos:Concept;
  skos:prefLabel "vijzelwielen"@nl;
  skos:scopeNote "Het vijzelwiel zit bovenaan de vijzelbalk en wordt aangedreven door de onderbonkelaar."@nl;
  skos:altLabel "vijzelwiel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/04770e4f-1c11-40e7-a256-9de8c6d569c6>;
