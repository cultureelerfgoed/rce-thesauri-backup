  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/76f721e1-fbaa-4510-af65-fc8d4f8acd18>
  a skos:Concept;
  skos:prefLabel "vaandrig (luchtmacht)"@nl;
  skos:scopeNote "Een vaandrig in de luchtmacht is een subalterne officier in opleiding, doorgaans betrokken bij de voorbereiding van operationele missies of als assistent bij vliegende of technische eenheden."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/56f2281c-1238-4be5-87b7-d27bbb234dad>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/43db257e-e642-4c54-81c4-4f6f1ca07979>
  a skos:Concept;
  skos:prefLabel "aladdintulpen"@nl;
  skos:scopeNote "Aladdintulpen zijn een soort tulpen die bekend staan om hun levendige kleuren en unieke vorm. Ze behoren tot de bloemen (flora) en worden vaak gekweekt voor decoratieve doeleinden in tuinen en bloembakken."@nl;
  skos:altLabel "aladdintulp"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/01db7f16-1850-40b9-a472-e591c1611767>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/0c3849bf-f0b3-4acd-b585-935a695dca33>
  a skos:Concept;
  skos:prefLabel "kogelcactussen"@nl;
  skos:scopeNote "Kogelcactussen zijn een bolvormige soort cactussen die worden gekenmerkt door hun ronde vorm en vaak scherpe stekels. Ze behoren tot de cactussen en zijn populair als sierplanten vanwege hun unieke uiterlijk en lage onderhoud."@nl;
  skos:altLabel "kogelcactus"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6d456a64-fe30-4819-a6cd-ed26b35ac507>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/707e5c1c-644b-4f79-8491-8d197a90bea0>
  a skos:Concept;
  skos:prefLabel "spitssnuitdolfijnen"@nl;
  skos:scopeNote "Spitssnuitdolfijnen zijn een groep dolfijnen die worden gekenmerkt door hun lange, smalle snuiten. Ze behoren tot de dolfijnen en worden vaak in open zeeën aangetroffen, waar ze bekendstaan om hun sociale gedrag en acrobatische sprongen."@nl;
  skos:altLabel "spitssnuitdolfijn"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ea4f4792-6434-4ea6-b886-9cf66242a1f2>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/11cbe13d-a2a1-4d44-94e0-20289e1dde02>
  a skos:Concept;
  skos:prefLabel "witte dolfijnen"@nl;
  skos:scopeNote "Witte dolfijnen zijn een dolfijnensoort die bekend staat om hun lichte tot witte kleur. Ze behoren tot de dolfijnen en komen voor in kust- en riviergebieden. Deze dolfijnen worden vaak bewonderd vanwege hun speelse gedrag en intelligentie."@nl;
  skos:altLabel "beloega"@nl, "beloegas"@nl, "beluga"@nl, "belugas"@nl, "witte dolfijn"@nl,
    "witte walvis"@nl, "witte walvissen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ea4f4792-6434-4ea6-b886-9cf66242a1f2>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/1359e450-d227-4471-ae9e-43efa852d1dc>
  a skos:Concept;
  skos:prefLabel "kloosterorde"@nl;
  skos:scopeNote "Een kloosterorde is een gemeenschap binnen de geestelijke orden waarin monniken of nonnen een religieus leven leiden volgens specifieke regels en tradities. Deze orden spelen een belangrijke rol in het geestelijke leven en zijn vaak betrokken bij educatie, zorg en andere maatschappelijke diensten."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fee0a7bd-f558-4969-855d-3c142660cf74>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/e70e2dba-4789-4bfd-a5d8-33b41fc99067>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/0f659ca9-0d0d-4b1a-856c-39a71926cd5b>
  a skos:Concept;
  skos:prefLabel "Franse Alpengeiten"@nl;
  skos:scopeNote "Franse Alpengeiten zijn een ras van geiten afkomstig uit de Franse Alpen. Ze behoren tot de geiten en zijn bekend om hun uitstekende melkproductie en aanpassingsvermogen aan verschillende klimaten en terreinen."@nl;
  skos:altLabel "Franse Alpengeit"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/39ccd40f-ec36-412a-8d6a-e35505844989>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4c9613ab-a38a-4ef9-bb5f-94c4bb332fc9>
  a skos:Concept;
  skos:prefLabel "Saanen-geiten"@nl;
  skos:scopeNote "Saanen-geiten zijn een geitenras afkomstig uit Zwitserland, bekend om hun hoge melkproductie. Ze behoren tot de geiten en worden wereldwijd gewaardeerd voor hun efficiëntie in de melkproductie en hun rustige karakter."@nl;
  skos:altLabel "Saanen-geit"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/39ccd40f-ec36-412a-8d6a-e35505844989>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/7212c873-7094-4266-9582-14d1bfd26a2b>
  a skos:Concept;
  skos:prefLabel "bakkersgilden"@nl;
  skos:scopeNote "Bakkersgilden waren historische gilden waarin bakkers zich verenigden om hun ambacht te reguleren, kwaliteit te waarborgen, en de belangen van hun leden te behartigen. Ze behoren tot de gilden en speelden een belangrijke rol in de middeleeuwse en vroegmoderne ambachten."@nl;
  skos:altLabel "bakkersgilde"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e9bb1914-ec82-4ae6-8b7d-4aae6834bb6d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d75c7525-77da-478b-89b0-17bd2e0cd13a>
  a skos:Concept;
  skos:prefLabel "begrafenisgilden"@nl;
  skos:scopeNote "Begrafenisgilden waren gilden die zich specialiseerden in het regelen van begrafenissen en de bijbehorende rituelen. Ze behoorden tot de gilden en zorgden ervoor dat leden een waardige begrafenis kregen, vaak met religieuze ceremonies en processies."@nl;
  skos:altLabel "begrafenisgilde"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e9bb1914-ec82-4ae6-8b7d-4aae6834bb6d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/78166990-6aac-4b83-8b68-05ada7bf5ded>
  a skos:Concept;
  skos:prefLabel "scheepmakersgilden"@nl;
  skos:scopeNote "Scheepmakersgilden waren gilden waarin ambachtslieden verenigd waren die gespecialiseerd waren in het bouwen en repareren van schepen. Deze gilden behoorden tot de gilden en speelden een cruciale rol in de maritieme handel en scheepsbouw in historische havens."@nl;
  skos:altLabel "scheepmakersgilde"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e9bb1914-ec82-4ae6-8b7d-4aae6834bb6d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/85803f45-2635-4750-a4ef-ef6e93df1dd8>
  a skos:Concept;
  skos:prefLabel "schildersgilden"@nl;
  skos:scopeNote "Schildersgilden waren verenigingen van schilders die hun ambacht reguleerden en beschermden. Deze gilden behoorden tot de gilden en waren verantwoordelijk voor het toezicht op de kwaliteit van schilderwerken en de opleiding van nieuwe schilders."@nl;
  skos:altLabel "schildersgilde"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e9bb1914-ec82-4ae6-8b7d-4aae6834bb6d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fc3f0cef-3610-422f-a19c-bbede7fefbc7>
  a skos:Concept;
  skos:prefLabel "schuitemakersgilden"@nl;
  skos:scopeNote "Schuitemakersgilden waren gilden van ambachtslieden die gespecialiseerd waren in het maken van schuiten en andere kleine boten. Deze gilden behoorden tot de gilden en speelden een belangrijke rol in het lokale vervoer en de handel via waterwegen."@nl;
  skos:altLabel "schuitemakersgilde"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e9bb1914-ec82-4ae6-8b7d-4aae6834bb6d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/82b72a23-21e8-428b-a318-ebf62b6fed65>
  a skos:Concept;
  skos:prefLabel "timmermansgilden"@nl;
  skos:scopeNote "Timmermansgilden waren gilden waarin timmerlieden zich verenigden om hun ambacht te reguleren, vakmanschap te bevorderen, en de belangen van hun leden te behartigen. Deze gilden behoorden tot de gilden en waren essentieel voor de bouw van huizen, meubels en andere houten structuren."@nl;
  skos:altLabel "timmermansgilde"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e9bb1914-ec82-4ae6-8b7d-4aae6834bb6d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e93de340-eec4-4d40-b1c1-3d6518593250>
  a skos:Concept;
  skos:prefLabel "weversgilden"@nl;
  skos:scopeNote "Weversgilden waren gilden waarin wevers zich verenigden om hun ambacht te reguleren, kwaliteitsnormen vast te stellen, en de belangen van hun leden te beschermen. Deze gilden behoorden tot de gilden en waren essentieel voor de productie van textiel in de middeleeuwen en daarna."@nl;
  skos:altLabel "weversgilde"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e9bb1914-ec82-4ae6-8b7d-4aae6834bb6d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fe492022-88dd-4c51-a179-e7d8d693fa17>
  a skos:Concept;
  skos:prefLabel "kolonel (luchtmacht)"@nl;
  skos:scopeNote "Een kolonel in de luchtmacht is een rang binnen de hoofdofficieren van de luchtmacht. Deze rang staat direct onder de rang van brigadegeneraal en boven de rang van luitenant-kolonel. Kolonels in de luchtmacht hebben doorgaans de leiding over grote luchtmachteenheden of bekleden belangrijke stafposities."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/11346d37-d832-4677-bfec-abf233d7103b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/18fb4faa-d3b7-4e39-a386-43aa3c1bb441>
  a skos:Concept;
  skos:prefLabel "luitenant-kolonel (luchtmacht)"@nl;
  skos:scopeNote "Een luitenant-kolonel in de luchtmacht is een rang binnen de hoofdofficieren van de luchtmacht, direct onder de rang van kolonel en boven de rang van majoor. Luitenant-kolonels in de luchtmacht vervullen vaak commandofuncties binnen vliegende squadrons of belangrijke stafposities."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/11346d37-d832-4677-bfec-abf233d7103b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/09680158-ced9-4a2f-80b1-52c70e16a24d>
  a skos:Concept;
  skos:prefLabel "botenverhuur"@nl;
  skos:scopeNote "Botenverhuur verwijst naar de activiteit waarbij boten worden verhuurd aan klanten voor recreatie of transport. Als onderdeel van verhuurbedrijven biedt botenverhuur een tijdelijke mogelijkheid om te varen zonder de noodzaak van eigendom."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6b56e08c-ba64-42b3-82cc-dbfd85845597>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e889d083-fbb8-4ee0-9b47-e38b1bb32ea2>
  a skos:Concept;
  skos:prefLabel "jachtverhuur"@nl;
  skos:scopeNote "Jachtverhuur betreft het verhuren van jachten, vaak luxe vaartuigen, voor recreatieve doeleinden. Deze service, binnen verhuurbedrijven, biedt klanten de ervaring van luxe zeilen of varen zonder permanente eigendom van een jacht."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6b56e08c-ba64-42b3-82cc-dbfd85845597>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/5a1c3fb9-5c19-4aad-b2c4-83e52d0e2a85>
  a skos:Concept;
  skos:prefLabel "kippen"@nl;
  skos:scopeNote "Kippen zijn gedomesticeerde vogels die wereldwijd worden gehouden voor hun eieren, vlees en veren. Als onderdeel van de bredere groep vogels, spelen kippen een belangrijke rol in de menselijke voedselvoorziening en landbouw."@nl;
  skos:altLabel "kip"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7b795769-2673-4389-9fae-6c6944ece10a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/881d561d-a8d6-4b70-bd2d-2fec3eb95790>
  a skos:Concept;
  skos:prefLabel "pauwen"@nl;
  skos:scopeNote "Pauwen zijn opvallende vogels bekend om hun kleurrijke en iriserende veren, vooral de staartveren van de mannetjes. Ze behoren tot de vogels en worden vaak gehouden als sierdieren vanwege hun pracht en gratie."@nl;
  skos:altLabel "pauw"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7b795769-2673-4389-9fae-6c6944ece10a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4fb5d1a9-1ebf-4db2-838b-b68fc9139523>
  a skos:Concept;
  skos:prefLabel "rode zeebrasems"@nl;
  skos:scopeNote "Rode zeebrasems zijn een groep vissen binnen de zeebrasems, gekenmerkt door hun roze tot rode kleur en veelvoorkomende aanwezigheid in kustwateren. Ze worden vaak gevangen voor voedsel en zijn populair in de sportvisserij."@nl;
  skos:altLabel "rode zeebrasem"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e78b5957-82d3-44dd-b0b0-34be4ff3cf35>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/1679e449-fc35-4ee6-8595-bf8625fbd744>
  a skos:Concept;
  skos:prefLabel "stuurlieden"@nl;
  skos:scopeNote "Stuurlieden zijn zeelieden verantwoordelijk voor het navigeren van een schip en het sturen van de koers. Ze behoren tot de bredere groep zeelieden en spelen een cruciale rol in de veiligheid en efficiëntie van zeereizen."@nl;
  skos:altLabel "stuurman"@nl, "stuurlui"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5ede8cf4-a22f-4ed0-a031-a8a1979f68e6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/7201e38e-9585-4882-8ba5-4203766a4d3f>
  a skos:Concept;
  skos:prefLabel "zeehelden"@nl;
  skos:scopeNote "Zeehelden zijn zeelieden die bekend staan om hun moed en bijdragen aan maritieme successen, vaak in tijden van oorlog of gevaar. Deze zeelieden, binnen de bredere categorie zeelieden, worden geëerd voor hun uitzonderlijke prestaties op zee."@nl;
  skos:altLabel "zeeheld"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5ede8cf4-a22f-4ed0-a031-a8a1979f68e6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ea4f4792-6434-4ea6-b886-9cf66242a1f2>
  a skos:Concept;
  skos:prefLabel "dolfijnen"@nl;
  skos:scopeNote "Dolfijnen zijn zeezoogdieren die bekend staan om hun intelligentie, sociale gedrag en speelgedrag. Ze behoren tot de zeezoogdieren en leven in verschillende maritieme omgevingen wereldwijd, vaak dicht bij kustlijnen en in open zeeën."@nl;
  skos:altLabel "dolfijn"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d2a6333f-dd1d-4a6a-ade7-6591c0072eca>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/707e5c1c-644b-4f79-8491-8d197a90bea0>,
    <https://data.cultureelerfgoed.nl/term/id/cht/11cbe13d-a2a1-4d44-94e0-20289e1dde02>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/614833de-2fe0-4e5f-8e37-659ffd309fd5>
  a skos:Concept;
  skos:prefLabel "korporaal (marine)"@nl;
  skos:scopeNote "Een korporaal in de marine is een onderofficier die een team van matrozen aanstuurt en verantwoordelijk is voor de dagelijkse uitvoering van taken aan boord van een schip of binnen een marine-eenheid. Ze spelen een cruciale rol in het opereren van schepen en het uitvoeren van missies."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/910c0016-6ddc-4316-9a1b-15ded5070368>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e4ab55ce-7756-4f9e-b601-abef5a72251a>
  a skos:Concept;
  skos:prefLabel "luitenant ter zee 3e klasse"@nl;
  skos:scopeNote "Een luitenant ter zee 3e klasse in de marine is een subalterne officier in de beginfase van zijn carrière, verantwoordelijk voor operationele en navigatietaken aan boord van schepen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/adaa37b7-5a6d-4546-a5eb-9be9d1faf905>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/84c826a3-d417-4435-a09b-85dee6dcb078>
  a skos:Concept;
  skos:prefLabel "luitenant ter zee 2e klasse oudste categorie"@nl;
  skos:scopeNote "Een luitenant ter zee 2e klasse oudste categorie in de marine is een subalterne officier met meer ervaring en senioriteit, verantwoordelijk voor het leiden van een schip of afdeling."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/adaa37b7-5a6d-4546-a5eb-9be9d1faf905>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/9d63ff32-49ec-4f20-9558-6274db7b6877>
  a skos:Concept;
  skos:prefLabel "luitenant ter zee 2e klasse"@nl;
  skos:scopeNote "Een luitenant ter zee 2e klasse in de marine is een subalterne officier die verantwoordelijk is voor het bevel over een afdeling of een schip, met een focus op operationele taken en strategie."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/adaa37b7-5a6d-4546-a5eb-9be9d1faf905>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f93a25af-cde7-4d4f-a35c-28ddb75bd6dd>
  a skos:Concept;
  skos:prefLabel "gastarbeiders"@nl;
  skos:scopeNote "Gastarbeiders zijn trekarbeiders die tijdelijk in een ander land werken om economische redenen. Deze arbeiders, binnen de bredere groep trekarbeiders, worden vaak aangetrokken door de behoefte aan arbeidskrachten in specifieke sectoren en dragen bij aan de economie van hun gastland."@nl;
  skos:altLabel "gastarbeider"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f9fddf95-650f-4a01-9a30-60039759a182>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/237591e2-c3b9-432d-ae89-74ab5e2c87c6>
  a skos:Concept;
  skos:prefLabel "ambachtsscholen"@nl;
  skos:scopeNote "Ambachtsscholen zijn instellingen gericht op het onderwijs in traditionele ambachten en handwerk, zoals houtbewerking en metaalbewerking. Als onderdeel van technische scholen bieden ze praktische, vaardigheidsgerichte opleidingen die gericht zijn op het ontwikkelen van specifieke vakbekwaamheden."@nl;
  skos:altLabel "ambachtsschool"@nl, "nijverheidsscholen"@nl, "nijverheidsschool"@nl,
    "nijverheidsschool voor jongens"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fc98b085-0bf6-4373-a3f3-bf7a9db46e0c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f7fd852c-4c1f-4749-9b3d-93df5e4a621c>
  a skos:Concept;
  skos:prefLabel "narwallen"@nl;
  skos:scopeNote "Narwallen zijn tandwalvissen die bekend staan om hun lange, spiraalvormige slagtand, meestal gevonden bij mannetjes. Als onderdeel van de tandwalvissen onderscheiden narwallen zich door hun unieke verschijning en leven voornamelijk in de Arctische wateren."@nl;
  skos:altLabel "narwal"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a0ef5abf-c18e-4c13-8f73-b1b024eafdfe>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/49f4c0ab-c34b-4d69-a83a-27ae48ff7e2f>
  a skos:Concept;
  skos:prefLabel "korporaal (luchtmacht)"@nl;
  skos:scopeNote "Een korporaal in de luchtmacht is een onderofficier die net boven de manschappen staat en verantwoordelijk is voor het uitvoeren van specifieke taken en het leiden van kleine groepen binnen de luchtmacht. Korporaals worden vaak ingezet als teamleiders en zijn belast met de taak om de operationele efficiëntie van hun eenheid te waarborgen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e95e0e25-b88a-4217-8f1b-ea1fe4502e49>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/7927ed8a-b4e2-4fee-8cd4-11904492aa2d>
  a skos:Concept;
  skos:prefLabel "Rotaryclubs"@nl;
  skos:scopeNote "Rotaryclubs zijn wereldwijd verspreide serviceclubs die zich richten op het verbeteren van gemeenschappen door middel van humanitaire projecten en wereldwijde samenwerkingsverbanden. Als onderdeel van serviceclubs staan Rotaryclubs bekend om hun inzet voor vrede, ziektebestrijding, en onderwijs."@nl;
  skos:altLabel "rotary"@nl, "Rotaryclub"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cb77aad0-3887-45cb-989c-664e7cec8cb7>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fcf2173e-fc03-4b31-9eb9-f62607dba713>
  a skos:Concept;
  skos:prefLabel "Odd Fellows"@nl;
  skos:scopeNote "Odd Fellows zijn serviceclubs met een lange geschiedenis van liefdadigheidswerk en broederschap. Binnen de bredere context van serviceclubs streven de Odd Fellows naar persoonlijke groei, gemeenschapsdienst, en de bevordering van vriendschap, liefde, en waarheid onder hun leden."@nl;
  skos:altLabel "Odd Fellow"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cb77aad0-3887-45cb-989c-664e7cec8cb7>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/0b54698e-ef35-4113-891a-fde1294bc90a>
  a skos:Concept;
  skos:prefLabel "Lions Clubs"@nl;
  skos:scopeNote "Lions Clubs zijn internationale serviceclubs gericht op vrijwilligerswerk, gemeenschapsdienst, en humanitaire projecten. Binnen de bredere categorie van serviceclubs, richten Lions Clubs zich op het bevorderen van welzijn, met speciale aandacht voor gezondheidszorg, hongerbestrijding en milieu."@nl;
  skos:altLabel "Lions Club"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cb77aad0-3887-45cb-989c-664e7cec8cb7>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b2fd555a-439b-4af4-8f24-6549a46c37fe>
  a skos:Concept;
  skos:prefLabel "groot seminaries"@nl;
  skos:scopeNote "Groot seminaries zijn opleidingsinstituten binnen de katholieke kerk waar toekomstige priesters een uitgebreide en diepgaande theologische en filosofische opleiding ontvangen. Als onderdeel van seminaries bieden groot seminaries geavanceerde vorming die noodzakelijk is voor het priesterschap."@nl;
  skos:altLabel "groot seminarie"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b2a318b6-4ba1-4199-ae10-593cfa6c0c7e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/10162e18-7b4c-4913-ae55-44289b075e03>
  a skos:Concept;
  skos:prefLabel "landsbestuur"@nl;
  skos:scopeNote "Landsbestuur verwijst naar de hoogste bestuurslaag binnen een staat, die verantwoordelijk is voor het beheer en de administratie van nationale aangelegenheden. Als onderdeel van besturen omvat het landsbestuur functies zoals wetgeving, rechtspraak, en handhaving van wetten op nationaal niveau."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/552e2764-b8d3-4e13-b82b-76aba164b48f>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/69542e8b-fd43-4949-826c-3c420c980dbd>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/681b4306-04d2-4e64-8b7d-8f8a2ea8f4fb>
  a skos:Concept;
  skos:prefLabel "provinciaal bestuur"@nl;
  skos:scopeNote "Provinciaal bestuur is de bestuurslaag die verantwoordelijk is voor de administratie en het bestuur van een provincie. Binnen de bredere categorie van besturen richt het provinciaal bestuur zich op regionale kwesties zoals ruimtelijke ordening, infrastructuur, en economische ontwikkeling."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/552e2764-b8d3-4e13-b82b-76aba164b48f>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/1aaa436e-6d04-4895-a2c5-83b0702475d8>,
    <https://data.cultureelerfgoed.nl/term/id/cht/5ab4257b-2057-4723-9471-8aa4e99f8311>,
    <https://data.cultureelerfgoed.nl/term/id/cht/7ed83dec-a208-4f02-8bce-e4752d3730fd>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/5dedc6eb-e585-4cbc-8cbe-2a3b64c718ad>
  a skos:Concept;
  skos:prefLabel "wortelgroentes"@nl;
  skos:scopeNote "Wortelgroentes zijn eetbare planten waarvan de wortel het belangrijkste deel is dat wordt geconsumeerd. Binnen de bredere categorie van groentes worden wortelgroentes gekenmerkt door hun voedzame waarde en veelzijdigheid in de keuken, met voorbeelden zoals wortels, bieten, en radijsjes."@nl;
  skos:altLabel "wortelgroenten"@nl, "wortelgroente"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/8ab29de2-0b79-41ca-ba0c-a9b55f232b84>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/66b50224-3069-4bff-b2db-0d7eb874d261>
  a skos:Concept;
  skos:prefLabel "kapitein ter zee"@nl;
  skos:scopeNote "Een kapitein ter zee is een hoge rang binnen de hoofdofficieren van de marine, direct onder de rang van commandeur. Kapiteins ter zee zijn vaak commandanten van grote marineschepen of vervullen belangrijke leidinggevende en stafposities binnen de marine."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1248a5cb-06eb-4dc7-86dc-28829fb1e1e2>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/aa94e0d2-f44c-4290-8d02-b9221e80e0b2>
  a skos:Concept;
  skos:prefLabel "luitenant ter zee 1e klasse"@nl;
  skos:scopeNote "Een luitenant ter zee 1e klasse is een rang binnen de hoofdofficieren van de marine, direct onder de rang van kapitein-luitenant ter zee en boven de rang van luitenant ter zee 2e klasse. Deze officieren vervullen vaak functies als commandant van kleinere eenheden of belangrijke stafposities binnen de marine."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1248a5cb-06eb-4dc7-86dc-28829fb1e1e2>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/910c0016-6ddc-4316-9a1b-15ded5070368>
  a skos:Concept;
  skos:prefLabel "korporaals (marine)"@nl;
  skos:scopeNote "Korporaals bij de marine zijn een lagere onderofficiersrang, verantwoordelijk voor het aansturen van kleine groepen matrozen en technische teams."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9ff75247-a89b-408a-8b0c-bd578ff441bb>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/614833de-2fe0-4e5f-8e37-659ffd309fd5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f0c04dc4-5871-470c-8e47-a904957758a1>
  a skos:Concept;
  skos:prefLabel "manschappen (marine)"@nl;
  skos:scopeNote "Manschappen bij de marine vormen de basis van het marinepersoneel, verantwoordelijk voor de uitvoering van operationele en ondersteunende taken aan boord van schepen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9ff75247-a89b-408a-8b0c-bd578ff441bb>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/8572a7a4-edf7-46f0-8526-19e2bf0c2a81>,
    <https://data.cultureelerfgoed.nl/term/id/cht/d96e256e-dfc1-4f4c-a90e-01d2f9c02638>,
    <https://data.cultureelerfgoed.nl/term/id/cht/032df4ce-c1ed-4ca7-a4a4-9b5535ccd6c6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8572a7a4-edf7-46f0-8526-19e2bf0c2a81>
  a skos:Concept;
  skos:prefLabel "matroos der 1e klasse"@nl;
  skos:scopeNote "Een matroos der 1e klasse is een ervaren marinemilitair binnen de manschappen die verantwoordelijk is voor het uitvoeren van taken aan boord van schepen en die soms extra verantwoordelijkheden heeft vanwege hun ervaringsniveau."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f0c04dc4-5871-470c-8e47-a904957758a1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d96e256e-dfc1-4f4c-a90e-01d2f9c02638>
  a skos:Concept;
  skos:prefLabel "matroos der 2e klasse"@nl;
  skos:scopeNote "Een matroos der 2e klasse is een marinemilitair die basisoperationele taken uitvoert aan boord van schepen. Ze hebben meer ervaring dan een matroos der 3e klasse, maar nog niet de verantwoordelijkheid van een matroos der 1e klasse."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f0c04dc4-5871-470c-8e47-a904957758a1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/032df4ce-c1ed-4ca7-a4a4-9b5535ccd6c6>
  a skos:Concept;
  skos:prefLabel "matroos der 3e klasse"@nl;
  skos:scopeNote "Een matroos der 3e klasse is de laagste rang binnen de manschappen in de marine. Ze voeren basisoperationele taken uit en krijgen vaak extra begeleiding om ervaring op te doen in hun rol."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f0c04dc4-5871-470c-8e47-a904957758a1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e5145da0-53f9-447b-9cb0-b8a3e5e64157>
  a skos:Concept;
  skos:prefLabel "ganzenflappers"@nl;
  skos:scopeNote "Ganzenflappers zijn jagers die gespecialiseerd zijn in het vangen of verjagen van ganzen. Binnen de bredere categorie van jagers maken ganzenflappers gebruik van specifieke technieken en hulpmiddelen om ganzen te lokken en te vangen, vaak voor consumptie of wildbeheer."@nl;
  skos:altLabel "ganzeflappers"@nl, "ganzenflapper"@nl, "ganzeflapper"@nl, "ganzenjager"@nl,
    "ganzenjagers"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/11c19af6-272f-45db-afc7-78ff96cf1673>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/474603f2-4616-413b-9c51-e746295eb8d7>
  a skos:Concept;
  skos:prefLabel "wilsterflappers"@nl;
  skos:scopeNote "Wilsterflappers zijn jagers die zich richten op het vangen van wulpen (wilsters) met behulp van traditionele vangmethoden. Binnen de bredere categorie van jagers gebruiken wilsterflappers vaak netten of andere handmatige technieken om deze vogels te vangen, meestal voor consumptie."@nl;
  skos:altLabel "wilsterflapper"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/11c19af6-272f-45db-afc7-78ff96cf1673>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/5727bf46-bc31-469c-8310-db48586994ef>
  a skos:Concept;
  skos:prefLabel "Vlaamse reuzen"@nl;
  skos:scopeNote "Vlaamse reuzen zijn een groot konijnenras dat bekend staat om zijn formaat en gewicht. Binnen de bredere categorie van konijnen (dier) worden Vlaamse reuzen vaak gehouden voor vleesproductie of als gezelschapsdier, en zijn ze populair vanwege hun rustige temperament en indrukwekkende grootte."@nl;
  skos:altLabel "Vlaamse reus"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b7553f8b-a54e-4f5e-a90e-1590a0bb965b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e386a5a7-64c9-421a-9556-14729e17c36e>
  a skos:Concept;
  skos:prefLabel "zoogdieren"@nl;
  skos:scopeNote "Zoogdieren (Mammalia) vormen een klasse van warmbloedige, meestal levendbarende chordadieren die hun jongen zogen met borstvoeding. Ze zijn deel van de Amniota en zijn als zodanig het nauwst verwant aan de reptielen en vogels. (Wikipedia)"@nl;
  skos:altLabel "zoogdier"@nl, "Mammalia (taxonomie)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/78672fa4-8815-4427-995e-21a2cc90bd39>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/b7553f8b-a54e-4f5e-a90e-1590a0bb965b>,
    <https://data.cultureelerfgoed.nl/term/id/cht/458d01c2-fd8d-4998-a9fc-a469a5d07580>;
