<https://data.cultureelerfgoed.nl/term/id/cht/700bd339-6939-4d4b-867d-e549e19a14e1>
  a skos:Concept;
  skos:prefLabel "windmolengebouwen"@nl;
  skos:scopeNote "Bebouwing t.b.v. het verrichten van arbeid (m.u.v. het opwekken van elektrische energie, het malen van granen en het opvijzelen van water), waarvoor de energie geleverd wordt door wind en opgenomen door middel van wieken."@nl;
  skos:altLabel "windmolengebouw"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0198a25a-3469-469e-8103-a613e32fcdc6>;
