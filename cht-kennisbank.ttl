<https://data.cultureelerfgoed.nl/term/id/cht/e7db678b-14db-468c-afae-cef0fb2dff1c>
  a skos:Concept;
  skos:prefLabel "vurenhout (grove den)"@nl;
  skos:scopeNote "Vurenhout is hout van de grove den (Pinus sylvestris), in Noorwegen ‘furuen’, in Denemarken ‘fyrn’. In 1307 wordt in Lübeck (D) vermeld trabes abiecnas, scilicet vuren, d.w.z. hout van de abies dat men vuren noemt. (Haslinghuis)"@nl;
  skos:altLabel "vuren (grove den)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fb3f4179-aa79-4ed3-b0f9-f4e61ead43a9>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e820e1b6-1e9f-4b74-9312-61ddf29de6c8>
  a skos:Concept;
  skos:prefLabel "Frederiksstads hout"@nl;
  skos:scopeNote "Naaldhout, uitgevoerd via Fredrikstad aan de oostkant van de Oslofjord in Noorwegen. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ea0098fa-4bf9-46c8-b983-deb14b3f1903>
  a skos:Concept;
  skos:prefLabel "bovenlands hout"@nl;
  skos:scopeNote "Bovenlands hout is vuren- of dennenhout afkomstig uit het 'bovenland' van de Rijn en tot omstreeks 1950 per vlot naar Nederland gebracht. Dit hout is meestal voor heipalen gebruikt. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/eae43ad3-2bdf-4c46-978e-f73e95a1b5fe>
  a skos:Concept;
  skos:prefLabel "abelenhout"@nl;
  skos:scopeNote "Abelenhout is hout van de zilverpopulier en is o.a. gebruikt voor zittingen en voor het draaien van balusters. (Haslinghuis)"@nl;
  skos:altLabel "abeel"@nl, "abelen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/eef5bee4-d223-4ed7-bb9b-9cb2cd37c4a0>
  a skos:Concept;
  skos:prefLabel "vurenhout (fijnspar)"@nl;
  skos:scopeNote "Vurenhout is het hout van de fijnspar (Picea excelsa), dat na XVIIa in Nederland als vuren aangeduid wordt. In Noorwegen heet deze boom ‘granen’. De aanduiding grenen komt in middeleeuwse teksten niet voor. Hoe de naamsverwisseling tot stand is gekomen, is niet bekend. (Haslinghuis)"@nl;
  skos:altLabel "vuren (fijnspar)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fb3f4179-aa79-4ed3-b0f9-f4e61ead43a9>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/efca703d-b96c-4c17-ae99-327210837ec2>
  a skos:Concept;
  skos:prefLabel "Singi hout"@nl;
  skos:scopeNote "Singi hout is eikenhout dat afkomstig is uit de bossen van Chiny bij Florenville in Belgisch Luxemburg. (Haslinghuis)"@nl;
  skos:altLabel "Singi balken"@nl, "balken van Singi"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/eff372ee-9db4-4776-bb12-a4b4d1b56e5a>
  a skos:Concept;
  skos:prefLabel "sliet"@nl;
  skos:scopeNote "Rondhout van soms tamelijk grote lengte en een diameter van 10 à 12 cm in het midden. Elzen slieten werden in West-Nederland omstreeks 1300 o.a. gebruikt om de bodem onder funderingen van stenen muren meer draagkracht te geven. Ook gebruikt als steigerhout (1753 Oostwoud-N.H., Herv. Kerk) of in boerderijen over de ankerbalken van de gebinten om er hooi of koren op te slaan. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f1bfcb37-c021-4a41-a540-76a07baf18ad>
  a skos:Concept;
  skos:prefLabel "Pernausch hout"@nl;
  skos:scopeNote "Pernausch hout is hout dat afkomstig is uit Estland en is verscheept via Pernau (Pjarnu) aan de golf van Riga. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6a581b97-c367-45e4-9add-2b9a409d69b5>
  a skos:Concept;
  skos:prefLabel "scheerbekkens"@nl;
  skos:scopeNote "Ondiepe houders voor het aanmaken en opvangen van scheerschuim bij het scheren door de kapper; aan één kant is van de rand een halve cirkel uitgespaard. (AAT-Ned)"@nl;
  skos:altLabel "scheerbekken"@nl;
