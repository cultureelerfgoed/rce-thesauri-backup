<https://data.cultureelerfgoed.nl/term/id/cht/19dbd675-469b-49b9-8e86-1ab01fab0481>
  a skos:Concept;
  skos:prefLabel "muziekkoepels"@nl;
  skos:scopeNote "Een muziekkoepel is een klein bouwwerk voor bands, om buiten overdekt te kunnen musiceren, meestal geplaatst in een park, in een tuin of op een pier. (Wikipedia)"@nl,
    "Een muziekkoepel is een klein bouwwerk voor bands, om buiten overdekt te kunnen musiceren, meestal geplaatst in een park, in een tuin of op een pier. (Wikipedia) "@nl,
    "Muziekkoepels zijn open veelhoekige bouwsels waarin muziekgezelschappen uitvoeringen kunnen geven. Overdekt door een koepelvormig dak, doorgaans op een stenen verhoging en gelegen in parken of op pleinen. (Rijksdienst voor het Cultureel Erfgoed/Van Dale)"@nl;
  skos:altLabel "muziekkiosken"@nl, "muziekoepels"@nl, "muziekkiosk"@nl, "muziekkoepel"@nl,
