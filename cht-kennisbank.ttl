<https://data.cultureelerfgoed.nl/term/id/cht/a897874d-cced-4a86-a2ef-3f7f7d7a6695>
  a skos:Concept;
  skos:prefLabel "zoldertrappen"@nl;
  skos:scopeNote "Zoldertrappen zijn trappen die leiden naar de zolder van een pand. Bij woningen zijn het vaak eenvoudige rechte steektrappen, maar bij grotere panden waar de zolder een opslag functie heeft, kunnen de trappen breder, groter en zwaarder zijn uitgevoerd."@nl;
  skos:altLabel "zoldertrap"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4568d082-f2fd-4dfb-b1b9-4d71334e1d9a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/feed3bef-473d-43a3-af09-43f476959f50>
  a skos:Concept;
  skos:prefLabel "schouwbalken"@nl;
  skos:scopeNote "Schouwbalken zijn horizontaal geplaatste balken of lateien waarom de schoorsteenboezems met aansluitende schoorstenen rusten. De schouwbalken rusten op schoorsteenwangen. (Haslinghuis)"@nl;
  skos:altLabel "schouwbalk"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/650ab4b1-e8ab-4c49-9195-8401d4a6cd6e>;
