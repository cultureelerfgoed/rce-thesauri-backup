<https://data.cultureelerfgoed.nl/term/id/cht/7af32d3b-1bb9-45e3-8e41-0e835e4bbfbd>
  a skos:Concept;
  skos:prefLabel "ruige blokschaven"@nl;
  skos:scopeNote "Ruwe- of ruige blokschaaf is een enkele schaaf die dient om het hout enigszins glad te schaven. Breedte 3/4 tot 2, oplopend met 1/8. De schaaf bestaat uit een eenvoudig, vierkant afgewerkt prismatisch blokje hout, waarin een beitel geplaatst is. Om de beitel los te slaan, klopt men met een hamer tegen de achterzijde van de schaaf. De beitel wordt vastgezet met een wig ter breedte van de schaafbeitel. Het schaafblok is vaak gedateerd."@nl;
  skos:altLabel "ruige blokschaaf"@nl, "ruwe blokschaaf"@nl, "ruwe blokschaven"@nl,
    "ruwe- of ruige blokschaaf"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a9970eba-9bc3-4066-b96e-0b613a96034b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/7e0a3068-1262-4c6c-9952-5d97a53084c7>
  a skos:Concept;
