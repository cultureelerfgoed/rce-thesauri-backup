<https://data.cultureelerfgoed.nl/term/id/cht/647946f4-dcb7-4afd-8314-1d3f3e2761cd>
  a skos:Concept;
  skos:prefLabel "rookgaten"@nl;
  skos:scopeNote "Rookgaten zijn gaten in kanonkelders die in verbinding staan met verticale kanalen, waarlangs kruitdampen worden afgevoerd. (Haslinghuis)"@nl;
  skos:altLabel "rookgat"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b2331d07-8cfc-4ddb-ab21-ed760e7cbc9f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/7a9dd589-ca95-4c19-8009-cfeb1488ab67>
  a skos:Concept;
  skos:prefLabel "heldengraven"@nl;
  skos:scopeNote "Heldengraven zijn graven voor personen die een speciale rol hebben gespeeld bij een gebeurtenis zoals oorlog, verzet, sportevenement en dergelijke. Militaire graven worden vaak ook heldengraven genoemd. De overledenen stierven vaak voor het vaderland. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "heldengraf"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d6eef960-5cb5-4dd5-b68d-cc1929ed20c0>;
