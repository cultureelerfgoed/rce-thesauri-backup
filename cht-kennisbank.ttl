  a skos:Concept;
  skos:prefLabel "dubbelwerkende schokdempers"@nl;
  skos:scopeNote "Dubbelwerkende schokdempers dempen mechanisch zowel de inverende- als uitverende bewegingen. Dubbelwerkende schokdempers kunnen worden gesteld d.m.v. een stelschroef. Daarmee worden de scharnierende benen meer of minder zwaar tegen elkaar aangedrukt."@nl;
