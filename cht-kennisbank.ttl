    <https://data.cultureelerfgoed.nl/term/id/cht/1035182d-d8e4-40aa-833f-5959562f7410>,
    <https://data.cultureelerfgoed.nl/term/id/cht/5f393d02-0914-4010-8207-821e75063be3>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d0c8f415-4493-40a9-b737-fedbf4f7dff6>
  a skos:Concept;
  skos:prefLabel "informatietechnologie"@nl;
  skos:scopeNote "Toepassing van wetenschappelijke kennis bij het ontwerpen van informatietechnieken, -producten en -systemen die de opbouw, bewaring, opslag en het gebruik van informatie mogelijk maken."@nl;
