<https://data.cultureelerfgoed.nl/term/id/cht/2bc06f67-b12b-4c5c-a768-8c0ae74e970f>
  a skos:Concept;
  skos:prefLabel "rijstpelmolens"@nl;
  skos:scopeNote "Molen waarmede uitsluitend rijst wordt gepeld. Deze molens hebben hun oorsprong in de Zaanstreek sinds 1830. In tegenstelling tot gerst liep rijst slechts driemaal over de pelsteen dit in tegenstelling tot gerst wel het dubbele aantal. (Molenwoordenboek G.J. Pouw)"@nl;
  skos:altLabel "rijstpelmolen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6654db8a-3424-4bf3-bfd8-0490ce52b8ae>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e62b2ff2-b4bb-4689-9da4-233c8a7acab1>
  a skos:Concept;
  skos:prefLabel "instructietuinen"@nl;
  skos:scopeNote "Instructietuinen zijn heemtuinen of onderdeel van heemtuinen waarin educatie aan vooral jongeren plaatsvindt met betrekking tot de Nederlandse flora en fauna en met behulp van educatieve (proef-)opstellingen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "instructietuin"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ba3721c9-b0c9-42e4-add6-d5c4602453e8>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/0c288b34-1e22-4367-babe-0b274704e66c>
  a skos:Concept;
