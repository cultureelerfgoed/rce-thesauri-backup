<https://data.cultureelerfgoed.nl/term/id/cht/1d5557cc-82dc-4c95-b346-57df92d3efb7>
  a skos:Concept;
  skos:prefLabel "merkmessen"@nl;
  skos:scopeNote "Gootvormig mesje, waarmee merken in hout worden gesneden, met gutsvormig einde. Sedert de 19de eeuw vaak inklapbaar, ongeveer zoals een zakmes. Lengte hecht 9 tot 11 cm, lemmet ca. 7,5 cm. Het gutseind heeft een snijkant van 0,4 cm doorsnede, hoogte gutseind 1,7 tot 2,1 cm. Andere naam: ritsmes."@nl;
  skos:altLabel "merkmes"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2ed04729-7ad2-4346-ae14-74dda34a3163>;
