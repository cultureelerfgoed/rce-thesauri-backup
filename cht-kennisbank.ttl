<https://data.cultureelerfgoed.nl/term/id/cht/a936addd-f509-4acb-ad37-cd81326484f4>
  a skos:Concept;
  skos:prefLabel "bankbiljetten"@nl;
  skos:scopeNote "Een bankbiljet is papiergeld dat wordt uitgegeven door een bank, doorgaans de centrale bank van een land. (Wikipedia)"@nl;
  skos:altLabel "bankbiljet"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/533b331c-aa32-4474-bf4a-d718a4e9be2a>;
