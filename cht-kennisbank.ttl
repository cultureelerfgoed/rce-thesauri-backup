  a skos:Concept;
  skos:prefLabel "geldsorteerbladen"@nl;
  skos:scopeNote "Een geldsorteerblad is een (zilveren) collecteblad met ronde openingen, waardoor de munten op diameter kunnen worden gesorteerd."@nl;
