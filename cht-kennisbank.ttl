<https://data.cultureelerfgoed.nl/term/id/cht/20ad1228-749d-4507-ba35-88096919a533>
  a skos:Concept;
  skos:prefLabel "voortreinen"@nl;
  skos:scopeNote "Een extra trein die hetzelfde traject rijdt en enkele minuten voor de officiële trein vertrekt. Wordt vaak bij drukte ingezet."@nl;
  skos:altLabel "voortrein"@nl;
