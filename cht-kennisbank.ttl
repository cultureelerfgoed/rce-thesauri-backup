  a skos:Concept;
  skos:prefLabel "lichten (molen)"@nl;
  skos:scopeNote "De licht is een speciaal mechanisme wat de bovenste molensteen tijdens het draaien verticaal kan bewegen, zodat de afstand tot de onder- en stilliggende molensteen gevarieerd kan worden. Hierdoor wordt de fijnheid van het meel gereguleerd; een kleine afstand betekent een fijnere kwaliteit meel!"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/04770e4f-1c11-40e7-a256-9de8c6d569c6>;
