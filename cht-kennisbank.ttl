<https://data.cultureelerfgoed.nl/term/id/cht/ee3218d9-3ba7-47d1-9bd3-240345924d1c>
  a skos:Concept;
  skos:prefLabel "restaurantrams"@nl;
  skos:scopeNote "Een restauranttram is een tram die is omgebouwd tot restaurant. Tijdens de maaltijd worden de gasten door de stad gereden. Het eerste tramrestaurant reed in Melbourne. De route duurt minimaal twee uren."@nl;
  skos:altLabel "restaurantram"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b12f2ba0-ea54-4e6a-b6ba-e5c01453e1d3>;
