<https://data.cultureelerfgoed.nl/term/id/cht/6094802a-f1aa-4546-8e7c-1fb12be39597>
  a skos:Concept;
  skos:prefLabel "werven (terrein)"@nl;
  skos:scopeNote "Terrein waarop bouw- en herstelwerkzaamheden worden verricht en de hiervoor benodigde werktuigen en materialen zijn opgeslagen. (Haslinghuis)"@nl;
  skos:altLabel "werf (terrein)"@nl;
