<https://data.cultureelerfgoed.nl/term/id/cht/45dce6ab-800e-41ae-9533-0bbd231d781d>
  a skos:Concept;
  skos:prefLabel "schelpenkoepels"@nl;
  skos:scopeNote "Schelpenkoepels, schelpengrotten of schelpengalerijen zijn classicistische tuinhuizen of nissen, fijn gedecoreerd met aan water gerelateerde voorwerpen zoals schelpen, kleine sculpturen en mozaïeken. Voorbeelden zijn de nis in het souterrain van Paleis 't Loo, de galerij in de tuin van kasteel Rosendael, de koepel op Nienoord in Leek en de koepel in de stadstuin Hof van Heeckeren in Zutphen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "schelpengrotten"@nl, "schelpengalerij"@nl, "schelpengalerijen"@nl,
    "schelpengrot"@nl, "schelpenkoepel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cef967f0-40b3-43ab-8e48-fb7215844297>;
