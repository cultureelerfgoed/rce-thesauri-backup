<https://data.cultureelerfgoed.nl/term/id/cht/699c75ea-5eb3-4f33-a803-487201772661>
  a skos:Concept;
  skos:prefLabel "chloride"@nl;
  skos:scopeNote "Scheikundige verbinding van chloor met een ander element."@nl;
