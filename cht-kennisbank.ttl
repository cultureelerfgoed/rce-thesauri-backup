<https://data.cultureelerfgoed.nl/term/id/cht/ed4c0129-4fbb-447f-8520-ba928ccc1bb1>
  a skos:Concept;
  skos:prefLabel "weldorpels"@nl;
  skos:scopeNote "Onderdorpel van raam of deur die aan de buitenzijde verzwaard is. Daardoor wordt regenwater naar buiten afgevoerd."@nl;
