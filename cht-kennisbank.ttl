  a skos:Concept;
  skos:prefLabel "wielnaven"@nl;
  skos:scopeNote "Een naaf is een onderdeel van een mechaniek voor de bevestiging van een wiel of excentriek op een aandrijfas, as of pen. (De Binnenvaart)"@nl;
  skos:altLabel "wielnaaf"@nl;
