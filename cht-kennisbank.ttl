<https://data.cultureelerfgoed.nl/term/id/cht/5a42ee97-985a-470c-8c25-8755540984f8>
  a skos:Concept;
  skos:prefLabel "acceleratiepompen"@nl;
  skos:scopeNote "Klein pompje in een carburateur met een zuiger of een membraan. Dient om het benzine/luchtmengsel tijdelijk rijker te maken, wanneer het gaspedaal plotseling wordt ingetrapt."@nl;
  skos:altLabel "acceleratiepomp"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0a0b798b-453c-43ca-a048-174acb18a717>;
