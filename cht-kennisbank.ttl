    <https://data.cultureelerfgoed.nl/term/id/cht/a9ee5a82-ecfc-4d94-9ee3-9e187037d8d5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/9258af6e-fb36-4f9b-84d9-6993683b8c3a>
  a skos:Concept;
  skos:prefLabel "thermohardende lijm"@nl;
  skos:scopeNote "Thermohardende lijm is een synthetische lijm die uithardt door verhitting en daarna niet meer smelt. Deze lijm wordt gebruikt voor toepassingen waar een sterke, permanente hechting nodig is."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fce84563-8f36-41ce-a0bb-7f6c03e83e8d>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/2955a059-75ac-4e9f-a858-659b8787cdb7>,
    <https://data.cultureelerfgoed.nl/term/id/cht/70451e8f-1fce-4085-bc5f-427692907393>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a68539d3-21bb-40d0-96de-ab1e125595ec>
  a skos:Concept;
  skos:prefLabel "thermoplastische lijm"@nl;
  skos:scopeNote "Een thermoplastische lijm is een lijm die vast is bij kamertemperatuur, bij verhitting smelt en weer vast wordt bij afkoeling, zoals bijvoorbeeld Beva -film."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fce84563-8f36-41ce-a0bb-7f6c03e83e8d>;
