  a skos:Concept;
  skos:prefLabel "moated sites"@nl;
  skos:scopeNote "Moated sites zijn omgrachte huizen of boerderijen, in het bijzonder een laatmiddeleeuws huis met een weerbaar uiterlijk. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
