<https://data.cultureelerfgoed.nl/term/id/cht/f09bb897-4e07-4338-91fe-a5402bebf33c>
  a skos:Concept;
  skos:prefLabel "vaargeulen"@nl;
  skos:scopeNote "Vaargeulen zijn geulen van voldoende diepte als vaarwater tussen ondiepten door. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
