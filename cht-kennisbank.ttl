<https://data.cultureelerfgoed.nl/term/id/cht/e1e99c00-9307-413e-b8ee-fd5de8f8fb16>
  a skos:Concept;
  skos:prefLabel "teerlingkapitelen"@nl;
  skos:scopeNote "Teerlingkapitelen zijn kapitelen die eruit zien als een dobbelsteen. De hoofdvorm bestaat uit een kubus met aan de onderzijde afgeronde hoeken, zoals een dobbelsteen die een dergelijke afronding aan alle hoeken heeft. (Haslinghuis)"@nl;
  skos:altLabel "dobbelsteenkapiteel"@nl, "dobbelsteenkapitelen"@nl, "teerlingkapiteel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1bd43a03-2889-400f-b451-ba760c3e0114>;
