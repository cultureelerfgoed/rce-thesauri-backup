<https://data.cultureelerfgoed.nl/term/id/cht/7206eb4e-1462-4f34-a7f8-3d1b78f653ac>
  a skos:Concept;
  skos:prefLabel "kop- en staartdelen"@nl;
  skos:scopeNote "Planken die het tapse verloop van de boomstammen nog bezitten, breed aan de onderzijde en smal aan het topeind. Zij werden om en om gelegd om materiaalverlies te beperken. Ook: kop en kont. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/333dad79-4b9e-4c77-924e-c4455b781628>;
