<https://data.cultureelerfgoed.nl/term/id/cht/380fe1b3-e532-40bb-8e9f-7daab5600659>
  a skos:Concept;
  skos:prefLabel "missaalomslagen"@nl;
  skos:scopeNote "Stoffen omslag voor het missaal."@nl;
