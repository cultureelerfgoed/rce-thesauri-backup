<https://data.cultureelerfgoed.nl/term/id/cht/13c78cff-5a28-4dee-905a-456e571a629b>
  a skos:Concept;
  skos:prefLabel "tekenstiften"@nl;
  skos:scopeNote "Tekenmateriaal in de vorm van een staafje (potloof of krijt). (AAT-Ned)"@nl;
