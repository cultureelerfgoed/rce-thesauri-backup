  a skos:Concept;
  skos:prefLabel "cocoswerk"@nl;
  skos:scopeNote "Cocoswerk verwijst naar kunstvoorwerpen of gebruiksvoorwerpen die zijn gemaakt van of versierd met kokosnootschalen. Ze zijn vaak handgemaakt en worden gewaardeerd om hun exotische en natuurlijke uitstraling."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bbbb5751-b3b2-4490-85ad-51a73c7651ee>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f5de2367-ee3c-4136-8a8e-d1300e2d5982>
  a skos:Concept;
  skos:prefLabel "collectiecatalogi"@nl;
  skos:scopeNote "Collectiecatalogi zijn gedetailleerde beschrijvingen van de objecten in een verzameling of museum. Ze dienen als belangrijke naslagwerken en bieden inzicht in de samenstelling en betekenis van collecties."@nl;
  skos:altLabel "collectiecatalogus"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9f6fb65c-948a-4dcd-b655-814ea0a58517>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/68f8885c-c0fc-43df-98c5-fddf6df5b823>
  a skos:Concept;
  skos:prefLabel "congresverslagen"@nl;
  skos:scopeNote "Congresverslagen zijn gedetailleerde notities en samenvattingen van de presentaties en discussies die plaatsvonden tijdens een congres of conferentie. Ze zijn essentieel voor de documentatie van wetenschappelijke en professionele bijeenkomsten."@nl;
  skos:altLabel "congresverslag"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91712616-6dec-4871-8fdc-c317850c20d1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/69dc5404-c4be-428f-8d00-07c005ec1ba8>
  a skos:Concept;
  skos:prefLabel "continentkaarten"@nl;
  skos:scopeNote "Continentkaarten zijn gedetailleerde geografische kaarten die een heel continent weergeven, vaak gebruikt in onderwijs, navigatie en onderzoek. Ze bieden een overzicht van de topografie, politieke grenzen en andere kenmerken."@nl;
  skos:altLabel "continentkaart"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7c99f9e1-2f0f-4367-abe4-f6d72120c233>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8350e62f-a18d-4a24-bd30-4011e23c49e6>
  a skos:Concept;
  skos:prefLabel "controlekaarten"@nl;
  skos:scopeNote "Controlekaarten zijn documenten of formulieren die worden gebruikt om de voortgang of status van een proces of activiteit bij te houden. Ze zijn essentieel in kwaliteitsbeheer en administratie."@nl;
  skos:altLabel "controlekaart"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91712616-6dec-4871-8fdc-c317850c20d1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/abd62430-c0bd-4f30-8685-a8b7a2bd2356>
  a skos:Concept;
  skos:prefLabel "cursusverslagen"@nl;
  skos:scopeNote "Cursusverslagen zijn documenten die de inhoud en resultaten van een cursus of opleidingsprogramma samenvatten, vaak gebruikt in het onderwijs of professionele ontwikkeling."@nl;
  skos:altLabel "cursusverslag"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91712616-6dec-4871-8fdc-c317850c20d1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fa28dce2-faeb-46e4-8b18-27a2439e3f18>
  a skos:Concept;
  skos:prefLabel "deelnemerskaarten"@nl;
  skos:scopeNote "Deelnemerskaarten zijn identificatiekaarten die worden verstrekt aan deelnemers van een evenement, zoals conferenties, beurzen, of sportwedstrijden. Ze bieden toegang en vaak ook speciale rechten of functies."@nl;
  skos:altLabel "deelnemerskaart"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91712616-6dec-4871-8fdc-c317850c20d1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/05e3a96b-0cdd-40d9-b98f-d629747b741e>
  a skos:Concept;
  skos:prefLabel "dierplastiek"@nl;
  skos:scopeNote "Dierplastiek verwijst naar driedimensionale kunstwerken die dieren afbeelden, vaak in brons of keramiek."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/20bcbb64-d439-411c-b332-fe2d3e162a24>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/5395fac1-0008-474c-8979-4af40a60f51e>
  a skos:Concept;
  skos:prefLabel "dierstillevens"@nl;
  skos:scopeNote "Dierstillevens zijn schilderijen of tekeningen die dieren in een statische compositie afbeelden, vaak met aandacht voor detail en realisme. Ze zijn een belangrijk genre binnen de schilderkunst."@nl;
  skos:altLabel "dierstilleven"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6195c543-baf4-47c3-94f4-90397ae636c8>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d023ecbf-577b-4f19-a4c7-868b4499feff>
  a skos:Concept;
  skos:prefLabel "digitale drukken"@nl;
  skos:scopeNote "Digitale drukken zijn kunstwerken of documenten die worden geproduceerd met behulp van digitale printtechnieken, vaak met hoge precisie en mogelijkheid tot reproductie."@nl;
  skos:altLabel "digitale druk"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91712616-6dec-4871-8fdc-c317850c20d1>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/c0cea0c9-563c-463c-952e-e7083b49693c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6595bf1c-758b-4a1f-b9f7-13cb33a45379>
  a skos:Concept;
  skos:prefLabel "digitale handtekening"@nl;
  skos:scopeNote "Een digitale handtekening is een cryptografisch beveiligde elektronische handtekening die wordt gebruikt om de authenticiteit en integriteit van digitale documenten te waarborgen."@nl;
  skos:altLabel "E-handtekening"@nl, "elektronische handtekening"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/acb4b124-1627-4de8-94c4-005dd7a4a19d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c6cb581b-f4fc-43fb-a5c5-5bdc0e9f450c>
  a skos:Concept;
  skos:prefLabel "directeurslijsten"@nl;
  skos:scopeNote "Directeurslijsten zijn registers van personen die als directeuren of leidinggevenden hebben gediend binnen een organisatie, vaak gebruikt voor administratieve en historische doeleinden."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f9ad90dc-6fc8-454a-9010-278cc1b0349f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/500d33f0-3f95-4043-89f2-a7b4004939b0>
  a skos:Concept;
  skos:prefLabel "donorportretten"@nl;
  skos:scopeNote "Donorportretten zijn schilderijen of andere kunstwerken die schenkers of begunstigden van een religieuze of liefdadigheidsinstelling afbeelden, vaak te vinden in kerken en kathedralen."@nl;
  skos:altLabel "donorportret"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c0a4866d-5222-4f10-a6bc-592ba4e42c8e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/7d4ee7a4-4ea1-4737-83b2-a0579c477b8e>
  a skos:Concept;
  skos:prefLabel "doopgeschenken"@nl;
  skos:scopeNote "Doopgeschenken zijn geschenken die worden gegeven ter gelegenheid van een doop, vaak religieus van aard en bedoeld als blijvende herinnering aan het sacrament."@nl;
  skos:altLabel "pillegift"@nl, "doopgeschenk"@nl, "pillegiften"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/abfc1bb7-04d7-43a0-9e99-dd4c5a4f2c15>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6775eac2-007c-45bf-9846-347dc7d0e653>
  a skos:Concept;
  skos:prefLabel "doordrukken (grafieken)"@nl;
  skos:scopeNote "Doordrukken in grafische kunst verwijst naar de techniek waarbij een afbeelding wordt gemaakt door inkt door een sjabloon of raster te persen, vaak gebruikt voor gedetailleerde en scherpe afdrukken."@nl;
  skos:altLabel "doordruk (grafieken)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6798bbe3-4d5a-4c3d-b419-97bc234954eb>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/fb614899-8bdd-4f93-b3fd-3b737529be56>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f5f714b5-6ee2-4be5-bcac-bd36ff805682>
  a skos:Concept;
  skos:prefLabel "dubbele groten"@nl;
  skos:scopeNote "Dubbele groten zijn historische zilveren munten die in het middeleeuwse Europa werden gebruikt. Ze hebben een hogere waarde dan de standaard groten."@nl;
  skos:altLabel "dubbele groot"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/57747aab-2562-44e8-8130-dd2027701a5d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b96ea1f6-9101-4c89-a6f9-6f721fce54d0>
  a skos:Concept;
  skos:prefLabel "dwangsombesluiten"@nl;
  skos:scopeNote "Dwangsombesluiten zijn juridische besluiten waarbij een boete of dwangsom wordt opgelegd als een bepaalde verplichting niet wordt nagekomen. Ze zijn een belangrijk instrument in bestuursrechtelijke handhaving."@nl;
  skos:altLabel "dwangsombesluit"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91712616-6dec-4871-8fdc-c317850c20d1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ee1955f1-e085-4cd3-a4c3-cba78297b8f7>
  a skos:Concept;
  skos:prefLabel "elfstedenkruisjes"@nl;
  skos:scopeNote "Elfstedenkruisjes zijn medailles die worden uitgereikt aan deelnemers die de Elfstedentocht succesvol hebben volbracht, een schaatstocht langs elf steden in Friesland. Ze zijn een iconisch symbool van doorzettingsvermogen en sportieve prestatie."@nl;
  skos:altLabel "elfstedenkruisje"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/601b5bd5-cbc6-492d-9292-0032c9bfe3ab>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/856115d3-b9cc-40f6-88a4-0553b8780551>
  a skos:Concept;
  skos:prefLabel "eremedailles"@nl;
  skos:scopeNote "Eremedailles zijn onderscheidingen die worden toegekend als erkenning voor buitengewone prestaties of verdiensten, vaak in militaire, civiele of sportieve contexten."@nl;
  skos:altLabel "eremedaille"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ff0af536-4541-49e2-af12-c72899b104a6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8b707fc7-0492-43e2-8576-4f530fca44a2>
  a skos:Concept;
  skos:prefLabel "erespelden"@nl;
  skos:scopeNote "Erespelden zijn kleine onderscheidingen, vaak in de vorm van een speld, die worden uitgereikt voor speciale prestaties of langdurige dienst, vaak binnen verenigingen of organisaties."@nl;
  skos:altLabel "erespeld"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ff0af536-4541-49e2-af12-c72899b104a6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e40f9c33-941e-48c0-82f6-fc9e5595d7d4>
  a skos:Concept;
  skos:prefLabel "etalageschilden"@nl;
  skos:scopeNote "Etalageschilden zijn decoratieve panelen die in etalages worden gebruikt om producten aan te prijzen of reclame te maken. Ze zijn vaak voorzien van opvallende kleuren en ontwerpen om de aandacht van voorbijgangers te trekken."@nl;
  skos:altLabel "etalageschild"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2e44391b-0677-4f76-a9be-d9b3289b8108>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/dfbf0430-167c-4ee9-a212-79e7b22cc35d>
  a skos:Concept;
  skos:prefLabel "eucharistievaandels"@nl;
  skos:scopeNote "Eucharistievaandels zijn processievaandels die worden gebruikt in katholieke kerken tijdens de eucharistieviering of processies. Ze zijn vaak rijkelijk versierd en dragen religieuze symbolen en afbeeldingen."@nl;
  skos:altLabel "eucharistievaandel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e52cbc47-b4ee-40f0-9034-cfed9775f402>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b4628f9d-f1de-42d1-92dd-278a0993f6d0>
  a skos:Concept;
  skos:prefLabel "concurrentie"@nl;
  skos:scopeNote "Concurrentie verwijst naar de rivaliteit tussen bedrijven, organisaties of individuen die strijden om een gemeenschappelijk doel, zoals marktaandeel, winst, of erkenning. Het is een fundamenteel element in markteconomieën en kan innovatie en efficiëntie stimuleren."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c5854888-a379-4ae3-9501-f6e0819d5453>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c5854888-a379-4ae3-9501-f6e0819d5453>
  a skos:Concept;
  skos:prefLabel "handel"@nl;
  skos:scopeNote "Te gebruiken voor het kopen, verkopen of ruilen van producten."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/190b9fce-fb0d-4b41-b46d-e1795ae38304>;
