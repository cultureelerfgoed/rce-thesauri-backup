<https://data.cultureelerfgoed.nl/term/id/cht/821a4a73-7f6a-4ceb-9d0e-1dfe92b7c7fa>
  a skos:Concept;
  skos:prefLabel "weitassen"@nl;
  skos:scopeNote "Weitassen zijn tassen waarin men geschoten klein wild bergt. Doorgaans hangt men hem aan een riem over de schouder. (Van Dale/Het Loo : De Oranjes en De Jacht / L. van Everdingen, Velp/Haarlem, 1984)"@nl;
  skos:altLabel "jagerstas"@nl, "jagerstassen"@nl, "weittas"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0286a9a9-bc21-4172-8cdd-063bcb67f462>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/afe0afe6-ca1e-4e30-8052-ce6a2cf2430f>
