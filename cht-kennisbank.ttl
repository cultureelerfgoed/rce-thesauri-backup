<https://data.cultureelerfgoed.nl/term/id/cht/64c36f51-7a5a-4956-b998-1f793d654bad>
  a skos:Concept;
  skos:prefLabel "gewonden"@nl;
  skos:scopeNote "Met losse winding. Een zuil, colonnet of rondstaaf kan gewonden zijn. Vgl. getorst. (Haslinghuis)"@nl;
