<https://data.cultureelerfgoed.nl/term/id/cht/6a8b1a35-512c-40f3-a70d-648280c668d9>
  a skos:Concept;
  skos:prefLabel "scheerheggen"@nl;
  skos:scopeNote "Scheerheggen zijn heggen, die op een bepaalde hoogte regelmatig worden geschoren."@nl;
  skos:altLabel "scheerheg"@nl;
