<https://data.cultureelerfgoed.nl/term/id/cht/d1ed339a-69fa-4d17-887b-693fdf6e7e4d>
  a skos:Concept;
  skos:prefLabel "klauwkoppelingen"@nl;
  skos:scopeNote "Hiermee kan naar believen een koppeling gemaakt worden tussen twee spildelen door de klauwen in of uit elkaar te trekken. (Molenwoordenboek B.D. Poppen)"@nl,
    "Middel om de aandrijving van het ene deel op het andere over te brengen of te verbreken. Klauwen op het ene deel van de koppeling schuiven in corresponderende inkepingen in het andere deel. Wordt gewoonlijk gebruikt in versnellingsbakken met synchromesh. (ANWB / Het Beste Autohandboek 1972)"@nl;
  skos:altLabel "klauwkoppeling"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f79b09b7-8bb3-4d57-be5a-0eba17e1fdb6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d286de2a-a59b-4faa-b467-b394089aa6e6>
  a skos:Concept;
  skos:prefLabel "kleptafels"@nl;
  skos:scopeNote "De kleptafel is het schijfvormige deel van de inlaat- en uitlaatklep."@nl;
  skos:altLabel "kleptafel"@nl;
