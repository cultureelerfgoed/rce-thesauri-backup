<https://data.cultureelerfgoed.nl/term/id/cht/a1eeb86c-da32-4551-a3d1-9c3865996531>
  a skos:Concept;
  skos:prefLabel "kampanjes"@nl;
  skos:scopeNote "Achterdek, hoger gelegen dan het verdek, waarop de hutten zijn gesitueerd. Het dak van de hut werd bovenkampagne genoemd."@nl;
  skos:altLabel "kampanje"@nl, "kampanjedek"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/20147bdd-f78f-4b35-8a3f-1db5ea03026a>;
