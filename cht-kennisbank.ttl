<https://data.cultureelerfgoed.nl/term/id/cht/ebc477a8-464a-4f0a-8725-6a400c50377f>
  a skos:Concept;
  skos:prefLabel "draaischijven"@nl;
  skos:scopeNote "Draaischijven zijn schijven op het emplacement waar locomotieven of wagons op worden opgeplaatst om ze te draaien en zo op een ander spoor te zetten."@nl;
  skos:altLabel "draaischijf"@nl;
