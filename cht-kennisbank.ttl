<https://data.cultureelerfgoed.nl/term/id/cht/208d8f76-37ea-49bc-a349-51ecdb552095>
  a skos:Concept;
  skos:prefLabel "schoutenhuizen"@nl;
  skos:scopeNote "Schoutenhuizen zijn huizen waar de schout van een stad woonde en/of de gemeenteraad vergaderde."@nl;
  skos:altLabel "schultenhuizen"@nl, "schultenhuis"@nl, "schoutenhuis"@nl;
