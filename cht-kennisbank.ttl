<https://data.cultureelerfgoed.nl/term/id/cht/4043855b-4284-432b-9f90-8f2a1bf0196a>
  a skos:Concept;
  skos:prefLabel "hangbruggen"@nl;
  skos:scopeNote "Hangbruggen zijn vaste bruggen die zijn opgebouwd uit pijlers of pylonen waartussen een draagkabel is gespannen. De verticale hangers brengen de lasten van de verstijvingsligger over op de draagkabels. (Typologie van stalen bruggen / H. de Jong , 1996)"@nl;
  skos:altLabel "hangbrug"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d07e505e-44cc-4c32-a38c-522763b0cfe4>;
