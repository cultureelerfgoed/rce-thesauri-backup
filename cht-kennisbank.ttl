<https://data.cultureelerfgoed.nl/term/id/cht/efaf18e4-3558-459e-bd5e-8e5c11b0e32f>
  a skos:Concept;
  skos:prefLabel "lamsrug"@nl;
  skos:scopeNote "Lamsrug is een vleesproduct, afkomstig van het rugdeel van een lam, gewaardeerd om zijn malsheid en smaak, vaak gebruikt in verfijnde gerechten."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aae78a31-4508-4823-b723-e146ed35cd7a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/841352e9-3288-4fbf-8d5f-60902c360485>
  a skos:Concept;
  skos:prefLabel "kippenpoten"@nl;
  skos:scopeNote "Kippenpoten zijn vleesproducten, veelgebruikt in de voedingsindustrie, bekend om hun collageenrijkheid en vaak verwerkt in bouillon of als snack."@nl;
  skos:altLabel "kippenpoot"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aae78a31-4508-4823-b723-e146ed35cd7a>;
