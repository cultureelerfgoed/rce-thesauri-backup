<https://data.cultureelerfgoed.nl/term/id/cht/fcccdfe0-7d67-4e72-a24e-ef8d1206687b>
  a skos:Concept;
  skos:prefLabel "veententen"@nl;
  skos:scopeNote "Veententen zijn eenvoudige agrarische schuilplaatsen op veengebieden, gebruikt door veenarbeiders voor beschutting tijdens het werk, vaak tijdelijk en mobiel van aard."@nl;
  skos:altLabel "veentent"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cef967f0-40b3-43ab-8e48-fb7215844297>;
