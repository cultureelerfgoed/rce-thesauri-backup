<https://data.cultureelerfgoed.nl/term/id/cht/af410186-7f09-4351-ac16-1aed7371590f>
  a skos:Concept;
  skos:prefLabel "imitatie"@nl;
  skos:scopeNote "Wordt gebruikt voor reproducties van hele objecten wanneer deze bedoeld zijn om te misleiden; geldt ook voor beeldhouwwerken die gegoten zijn zonder toestemming van de kunstenaar. (AAT)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/df4db7b4-3b69-49a2-9068-13034f1a068f>;
