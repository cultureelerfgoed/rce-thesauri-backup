<https://data.cultureelerfgoed.nl/term/id/cht/010bcac1-8d72-43b9-8097-d829bba9b9f7>
  a skos:Concept;
  skos:prefLabel "conté"@nl;
  skos:scopeNote "Conté is een type krijt dat wordt gebruikt in de tekenkunst, samengesteld uit grafiet of koolstof en klei, bekend om zijn fijne, vloeiende lijnen en rijke tinten."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a4f08240-778c-430c-9c85-028ca55bb632>;
