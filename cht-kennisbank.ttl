<https://data.cultureelerfgoed.nl/term/id/cht/a10582b9-b1aa-4203-a65b-3c6569d7aa0e>
  a skos:Concept;
  skos:prefLabel "werkhoutvuurzwam"@nl;
  skos:scopeNote "De werkhoutvuurzwam is een schimmelsoort uit de familie Hymenochaetaceae. Het veroorzaakt witrot van hout."@nl;
