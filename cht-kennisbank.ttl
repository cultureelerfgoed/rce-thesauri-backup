<https://data.cultureelerfgoed.nl/term/id/cht/7b06777b-dc52-437c-bf82-c89e9ce515d4>
  a skos:Concept;
  skos:prefLabel "klokkenzolders"@nl;
  skos:scopeNote "Ruimte in een toren waar de luiklokken zijn opgehangen. Het geluid van de klokken kan de ruimte verlaten door de galmgaten. (Haslinghuis)"@nl;
