<https://data.cultureelerfgoed.nl/term/id/cht/5c51050b-9832-40a2-9081-e167c3b8f818>
  a skos:Concept;
  skos:prefLabel "stadions"@nl;
  skos:scopeNote "Stadion is in de moderne betekenis een groot complex waar men samenkomt om sportwedstrijden te bezoeken. Vaak worden er in stadions ook popconcerten en andere evenementen georganiseerd. De basisconstructie van een stadion een een groot speelvlak waaromheen toeschouwers kunnen staan of zitten in tribunes en/of skyboxen. (architectenweb)"@nl;
  skos:altLabel "stadion"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4d717812-4cc8-46b7-8c3c-6fd6fea67959>;
