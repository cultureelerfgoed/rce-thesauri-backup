<https://data.cultureelerfgoed.nl/term/id/cht/b9a4034d-1032-4063-8600-94406977e6e3>
  a skos:Concept;
  skos:prefLabel "Mercurius"@nl;
  skos:scopeNote "Mercurius is een figuur uit de Romeinse mythologie. Hij was de god van de handel, reizigers en winst. (Wikipedia)"@nl;
