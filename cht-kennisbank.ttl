<https://data.cultureelerfgoed.nl/term/id/cht/acb9b70f-3eff-4194-8c81-7bc3c7ca89ef>
  a skos:Concept;
  skos:prefLabel "hemisferische zonnewijzers"@nl;
  skos:scopeNote "Hemisferische zonnewijzers zijn halve bol zonnewijzers. Ze worden zowel voor in schuine stand als in horizontale stand uitgevoerd. ("@nl;
