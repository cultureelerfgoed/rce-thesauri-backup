  a skos:Concept;
  skos:prefLabel "stallingen"@nl;
  skos:scopeNote "Oorspronkelijk stallen in een stedelijke omgeving, vaak met woonruimte erboven, gelegen rond een binnenplaats of een korte straat voor gebruik door koetspaarden, tegenwoordig met name voor auto's en fietsen. (AAT-Ned)"@nl;
  skos:altLabel "stalling"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7710d7ac-1f51-4b63-816b-5b911f808a63>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/9d9cfb40-8e2c-4340-94f6-ab35a4315187>
  a skos:Concept;
  skos:prefLabel "bazaars"@nl;
  skos:scopeNote "Wordt gebruikt voor marktpleinen, meestal bestaande uit een netwerk van overdekte straten, stallen, kramen en winkels, veelvoorkomend in Noord-Afrika en West-Azië. (AAT-Ned)"@nl;
  skos:altLabel "bazaar"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/188a5639-e0be-4c06-b7a7-a88c8b5468d4>;
