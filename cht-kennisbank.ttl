<https://data.cultureelerfgoed.nl/term/id/cht/a19855b1-c4a8-4892-a906-0c8bf8b777f6>
  a skos:Concept;
  skos:prefLabel "organische lijm"@nl;
  skos:scopeNote "Organische lijm is een type lijm dat wordt vervaardigd uit natuurlijke materialen zoals dierlijke of plantaardige bronnen. Deze lijmen zijn biologisch afbreekbaar en worden vaak gebruikt in traditionele ambachten en restauraties."@nl;
