<https://data.cultureelerfgoed.nl/term/id/cht/31b7a0c2-002d-42d6-94b8-33f0fe439ced>
  a skos:Concept;
  skos:prefLabel "kegelgewelven"@nl;
  skos:scopeNote "Kegelgewelven zijn trechtervormige gewelven waarvan de vorm bepaald is door een rechte lijn te wentelen om een as waarmee zij één punt gemeen heeft en een hoek van minder dan 90° maakt. Voor de kap van een steekgewelf en een cellengewelf wordt vaak gebruik gemaakt van (deel)vlakken van een kegelgewelf, evenals voor componenten in de gewelven van veelhoekige kooromgangen of onder koepels en voor gewelven in de vorm van afgeknotte kegels. (Haslinghuis)"@nl;
  skos:altLabel "kegelgewelf"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/02e2289e-bbb7-4233-9e02-fd95935f4e28>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/793804b0-5ffb-48bf-a0dd-c6fe52d85851>
  a skos:Concept;
