<https://data.cultureelerfgoed.nl/term/id/cht/9be14477-76ac-4960-b2a4-c333294f4014>
  a skos:Concept;
  skos:prefLabel "gerimpelde emulsielaag"@nl;
  skos:scopeNote "Een gerimpelde emulsielaag wordt veroorzaakt door het krimpen van de drager door veroudering van film, vaak gepaard gaande met het loslaten van de beeldlaag van de drager."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/9bf74f90-8ac8-41bf-b18b-76e1bf24af91>
  a skos:Concept;
  skos:prefLabel "politieauto's"@nl;
  skos:scopeNote "Een politieauto of politiewagen is een automobiel die gebruikt wordt als politievoertuig. (Wikipedia)"@nl;
  skos:altLabel "politieauto"@nl, "politiewagen"@nl, "politiewagens"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dec3cb60-0105-49ac-a19f-d52c1f1ac5b4>;
