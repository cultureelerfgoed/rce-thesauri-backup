<https://data.cultureelerfgoed.nl/term/id/cht/6b7fcbf6-94f2-48b3-ae93-9a2097d6f720>
  a skos:Concept;
  skos:prefLabel "grafkruizen"@nl;
  skos:scopeNote "Grafkruizen zijn een bepaald type grafmonument in de vorm van een kruis, verwijzend naar het kruis waarin Christus stierf. Grafkruizen kennen vele vormen. (Rijksdienst voor het Cultureel Erfgoed)"@nl,
    "Kruis op een graf, al dan niet voorzien van de data van de overledene. (Religieus Erfgoed)"@nl;
  skos:altLabel "grafkruis"@nl;
