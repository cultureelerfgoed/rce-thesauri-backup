<https://data.cultureelerfgoed.nl/term/id/cht/5fd5cb6a-4b3f-4078-b679-495e6d0aac0b>
  a skos:Concept;
  skos:prefLabel "beroepsvisserij"@nl;
  skos:scopeNote "Visserij uitgevoerd als economische activiteit om in levensonderhoud te voorzien. Dit omvat zowel kleinschalige ambachtelijke visserij als grootschalige commerciële visserij."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f9fc1c3c-b9bc-4502-807a-6f49f243706a>;
