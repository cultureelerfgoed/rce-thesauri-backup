    <https://data.cultureelerfgoed.nl/term/id/cht/bc7cf6a2-5cb5-4853-a060-c29f4fdfd873>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/155dba54-1be0-460c-b6b2-c137c02ff7ed>
  a skos:Concept;
  skos:prefLabel "riemen (kleding)"@nl;
  skos:scopeNote "Een riem is een meestal leren of kunststoffen band met een gesp, die men om het middel kan dragen. Het doel van een riem is het afzakken van een broek of rok te voorkomen. Er zijn diverse sluitingmechanismen voor een riem. Het meest voorkomende is de normale gesp. Er zijn ook riemen die alleen gedragen worden voor de sier. (Wikipedia)"@nl;
  skos:altLabel "ceinturen"@nl, "ceintuurs"@nl, "ceintuur"@nl, "riem (kleding)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5dec9aa2-5ced-4f77-b929-c043b90b2a8f>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/58b67d23-3840-4ef7-a4b1-53dc4099367d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

