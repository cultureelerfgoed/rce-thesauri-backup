    <https://data.cultureelerfgoed.nl/term/id/cht/7bbf1240-4bca-4d33-bfb1-d6634ef7a401>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2222a549-7ceb-4848-af51-a52391e17a53>
  a skos:Concept;
  skos:prefLabel "korporaal (landmacht)"@nl;
  skos:scopeNote "Een korporaal in de landmacht is een onderofficier die verantwoordelijk is voor het aansturen van een kleine groep soldaten. Ze zijn vaak de eerste leidinggevenden voor soldaten en hebben een sleutelrol in de operationele uitvoering van opdrachten."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e586ee9a-4e09-419f-906d-90c99248c533>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e586ee9a-4e09-419f-906d-90c99248c533>
  a skos:Concept;
  skos:prefLabel "korporaals (landmacht)"@nl;
  skos:scopeNote "Korporaals bij de landmacht zijn een lagere onderofficiersrang, die verantwoordelijk is voor het aansturen van kleine groepen soldaten binnen hun eenheid."@nl;
