<https://data.cultureelerfgoed.nl/term/id/cht/63e5f7af-0f4f-48a4-8881-2c08f16ada8a>
  a skos:Concept;
  skos:prefLabel "vloedschuren"@nl;
  skos:scopeNote "Vloedschuren zijn schuren met een verhoogd vloerniveau. Hier kan het vee in veiligheid worden gebracht in tijden van hoog water. De onderkeldering wordt vaak gebruikt als opslag voor bieten en aardappelen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "vloedschuur"@nl, "vluchtschuren"@nl, "vluchtschuur"@nl, "waterschuren"@nl,
