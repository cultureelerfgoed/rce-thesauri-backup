  a skos:Concept;
  skos:prefLabel "hoofdwielen"@nl;
  skos:scopeNote "De hoofdwielen dragen het grootste gewicht van het vliegtuig en worden vooral tijdens de start en landing of taxiën zwaar belast."@nl;
