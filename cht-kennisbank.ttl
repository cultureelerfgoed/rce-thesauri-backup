<https://data.cultureelerfgoed.nl/term/id/cht/34e33dd1-fa54-46df-914c-41fce0366499>
  a skos:Concept;
  skos:prefLabel "stators"@nl;
  skos:scopeNote "Deel van een koppelomvormer. Wordt soms ook wel reactor genoemd. Een stator is eveneens het stilstaande deel van een wisselstroomdynamo."@nl;
  skos:altLabel "stator"@nl;
