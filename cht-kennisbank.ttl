  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f14f690e-b149-4e7a-af2b-3c3c5f2a9cb3>
  a skos:Concept;
  skos:prefLabel "construction support vessels"@nl;
  skos:scopeNote "Construction support vessels zijn multifunctionele offshore ondersteuningsvaartuigen en worden ingezet voor het uitvoeren van een breed scala aan werkzaamheden voor offshore olie & gas en offshore wind projecten. (Boskalis)"@nl;
  skos:altLabel "construction support vessel"@nl, "constructie ondersteuningsvaartuigen"@nl,
