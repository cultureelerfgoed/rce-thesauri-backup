  a skos:Concept;
  skos:prefLabel "reliëfdrukken (procedé)"@nl;
  skos:scopeNote "Wordt gebruikt voor afdrukprocedés waarbij de niet afdrukkende delen van het blok of de plaat zijn uitgekerfd, gegraveerd of weggeëtst, zodat de afdruk bestaat uit wat er van het oorspronkelijke oppervlak overblijft. (AAT)"@nl;
  skos:altLabel "reliëfdruk (procedé)"@nl;
