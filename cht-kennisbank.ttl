<https://data.cultureelerfgoed.nl/term/id/cht/6f6e3010-46ee-4325-9aa9-ed3ec1157315>
  a skos:Concept;
  skos:prefLabel "altaartomben"@nl;
  skos:scopeNote "Tombe van een tombealtaar. In de tombe kunnen zich de relieken of een geheel lichaam van een heilige bevinden. (Religieus Erfgoedthesaurus)"@nl;
  skos:altLabel "altaartombe"@nl;
