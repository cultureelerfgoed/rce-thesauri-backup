<https://data.cultureelerfgoed.nl/term/id/cht/091cc30f-b756-487c-b224-ca2864f9e47f>
  a skos:Concept;
  skos:prefLabel "commerciële gebouwen"@nl;
  skos:scopeNote "Bouwwerken voor verkoop van produkten en diensten. Zie 'ambachtelijke werkplaatsen' voor gebouwen waar op kleinschalige wijze produkten vervaardigd worden. Zie 'industrie- en nijverheidsbouwwerken' waar dit op grootschalige wijze gebeurt. (AAT)"@nl;
