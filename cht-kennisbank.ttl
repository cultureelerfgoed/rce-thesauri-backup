<https://data.cultureelerfgoed.nl/term/id/cht/aad5f5ce-4f37-4a2e-af92-fc06b57375af>
  a skos:Concept;
  skos:prefLabel "koubeitels"@nl;
  skos:scopeNote "Stalen beitel om metselwerk te breken, tot 18 cm lang."@nl;
  skos:altLabel "koubeitel"@nl, "koudbeitel"@nl, "koudbeitels"@nl;
