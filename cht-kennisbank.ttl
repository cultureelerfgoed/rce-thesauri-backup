  a skos:Concept;
  skos:prefLabel "laat Romeinse tijd B"@nl;
  skos:scopeNote "De dateringsrange is gebaseerd op de Romeinse aardewerktypologie uit de jaren ’90. Voor de typologie is met name gebruik gemaakt van aardewerk afkomstig uit goed-gedateerde en goed-opgegraven vondstcontexten zoals Nijmegen, Vechten en Velsen. (ABR)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2d5b08cd-5fd8-49fc-8400-973be7e00dcc>;
