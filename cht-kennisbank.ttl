<https://data.cultureelerfgoed.nl/term/id/cht/252ec2b8-95ec-44e5-a877-6ccee2d6d356>
  a skos:Concept;
  skos:prefLabel "tuinbeelden"@nl;
  skos:scopeNote "Tuinbeelden zijn tuinornamenten die meestal goden, mensen of dieren verbeelden. Tot en met de 18e eeuw zijn het meestal beeldhouwwerken in natuursteen. In latere perioden worden zowel materialen (onder andere zink en keramiek) als voorstellingen diverser, tot abstracte beelde in de twintigste eeuw. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "tuinbeeld"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2971af0-cde7-4888-b828-33443f702e7d>;
