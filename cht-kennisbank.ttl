<https://data.cultureelerfgoed.nl/term/id/cht/d3bf5457-4d71-4b5b-b76d-206871fbf419>
  a skos:Concept;
  skos:prefLabel "archeologische opgravingen"@nl;
  skos:scopeNote "Een archeologische opgraving of excavatie is een archeologisch medium om in de bodem aanwezige materiële resten en andere sporen van menselijke activiteit of aanwezigheid te traceren en te bestuderen, teneinde wetenschappelijke vraagstukken omtrent het menselijke verleden te kunnen beantwoorden."@nl;
  skos:altLabel "(archeologische) excavatie"@nl, "archeologische opgraving"@nl;
