<https://data.cultureelerfgoed.nl/term/id/cht/db5da51e-d1c8-41f5-a330-18c8dc047938>
  a skos:Concept;
  skos:prefLabel "instandhoudingssubsidies"@nl;
  skos:scopeNote "Instandhoudingssubsidies zijn financiële bijdragen van de overheid of andere instanties die bedoeld zijn om het behoud en onderhoud van erfgoed en monumenten te ondersteunen."@nl;
  skos:altLabel "instandhoudingssubsidie"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6f5f6968-8ee7-483b-b57c-f871958f60ac>;
