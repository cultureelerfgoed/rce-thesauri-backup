<https://data.cultureelerfgoed.nl/term/id/cht/18375db2-598a-4641-abfb-12bbd254f71d>
  a skos:Concept;
  skos:prefLabel "houwitsers"@nl;
  skos:scopeNote "Vuurmond (stuk geschut) met relatief korte loop van ongeveer 5 à 15 maal het kaliber.; Door de lage aanvangssnelheid is de baan van het verschoten projectiel gekromd en de invalshoek vrij steil. (Stichting Menno van Coehoorn)"@nl;
  skos:altLabel "houwitser"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/28026226-7e07-46ac-acee-21036603f0fb>;
