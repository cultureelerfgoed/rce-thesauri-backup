<https://data.cultureelerfgoed.nl/term/id/cht/9fd0964d-30e5-458e-a066-a59f28c3d470>
  a skos:Concept;
  skos:prefLabel "kunstlicht"@nl;
  skos:scopeNote "Kunstlicht is licht dat uit een andere lichtbron komt dan daglicht."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/54825595-88aa-4f30-ac19-c5fc288f8de2>;
