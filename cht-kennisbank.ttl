<https://data.cultureelerfgoed.nl/term/id/cht/5f540288-e1c9-498f-b566-c1744423c243>
  a skos:Concept;
  skos:prefLabel "wintersynagogen"@nl;
  skos:scopeNote "Een wintersynagoge is een kleine synagoge, behorende bij een groter synagogecomplex, waar in de winter diensten worden gehouden, wanneer het in de grote synagoge te koud wordt."@nl;
  skos:altLabel "wintersynagoge"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0946c81f-2ca9-4cb2-942b-d5b25ab478c1>;
