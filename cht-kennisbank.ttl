<https://data.cultureelerfgoed.nl/term/id/cht/41ae364b-083c-4d8c-b871-122aaf9c8360>
  a skos:Concept;
  skos:prefLabel "hooimuren"@nl;
  skos:scopeNote "Wand, bestaande uit houten stijlen met aan weerszijden rachels, waartussen droog hooi. Over de regels is koperdraad gespannen, waarover riet en pleisterwerk. Op die manier wordt geluidsisolatie verkregen, b.v. tussen schoollokalen. (Haslinghuis)"@nl;
  skos:altLabel "hooimuur"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d7d752d0-be8b-4641-a7ea-d3f21eda662f>;
