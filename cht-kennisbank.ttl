<https://data.cultureelerfgoed.nl/term/id/cht/6b2a3599-cec0-413e-8803-e1cbd9402ff8>
  a skos:Concept;
  skos:prefLabel "zanddozen"@nl;
  skos:scopeNote "Een zanddoos is een kist of bak met korrelig materiaal zoals zand, waarin men onderdelen plaatst die precies op elkaar passend moeten worden gelijmd. De delen worden op elkaar gezet, waarbij de zwaartekracht er voor zorgt dat de voeg zich sluit zonder dat ze verder worden aangeraakt. (Conservation Dictionary)"@nl;
  skos:altLabel "zanddoos"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1aceb3d4-ccd6-4e60-8b6b-e65ccad44ef1>;
