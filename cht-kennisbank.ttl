<https://data.cultureelerfgoed.nl/term/id/cht/dc72bd8c-3564-407f-af02-31fd304a2acf>
  a skos:Concept;
  skos:prefLabel "genade"@nl;
  skos:scopeNote "Clementie en medelijden betoond aan iemand die machteloos of onderworpen is, of op een moment wanneer strengheid verdiend is of verwacht wordt, meestal in geval van een wettelijk oordeel of een vonnis. (AAT)"@nl;
  skos:altLabel "pardon"@nl;
