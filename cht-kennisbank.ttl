  a skos:Concept;
  skos:prefLabel "Acryloid"@nl;
  skos:scopeNote "Acryloid is de Amerikaanse handelsnaam voor Paraloid."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a7f630dc-a86a-4026-b7e6-6a9021b08330>;
