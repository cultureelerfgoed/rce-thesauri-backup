<https://data.cultureelerfgoed.nl/term/id/cht/dfb370cd-8bcf-49de-81e5-97ea13ec1943>
  a skos:Concept;
  skos:prefLabel "avondmaalskleden"@nl;
  skos:scopeNote "Kleed of laken om de avondmaalstafel mee te dekken. Het kleed en het witte damast laken kunnen zijn ingeweven met symbolen voor Christus, voor het brood en de wijn, respectievelijk de vis, aren en druiven."@nl;
  skos:altLabel "avondmaalskleed"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b33b6bfb-f895-45a5-a0e4-79909ebc97f3>;
