  a skos:Concept;
  skos:prefLabel "pallen (pal)"@nl;
  skos:scopeNote "De pal, welke schamierend is bevestigd aan de krabbelstijl, houdt het krabbelrad tegen bij de neergaande (zaagslag) van het zaagraam in een houtzaagmolen."@nl;
