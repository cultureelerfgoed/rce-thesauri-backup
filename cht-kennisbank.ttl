<https://data.cultureelerfgoed.nl/term/id/cht/4c8f1119-0d1c-4263-b3f1-60c548fc8de2>
  a skos:Concept;
  skos:prefLabel "ampullen"@nl;
  skos:scopeNote "Liturgisch vaatwerk. Schenkkannetje in edelmetaal, glas of aardewerk. Twee ampullen worden tijdens de misviering gebruikt, een voor het water en een voor de wijn, hetgeen als zodanig kan zijn aangegeven met de letter A of V. Ze staan op een ampullenblad of -schaal. De ampullen en het ampullenblad worden ook wel bij de handwassing gebruikt."@nl;
  skos:altLabel "ampul"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/90af6b11-2f47-49f5-9b38-86947ec05093>
  a skos:Concept;
