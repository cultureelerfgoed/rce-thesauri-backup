<https://data.cultureelerfgoed.nl/term/id/cht/7b792274-9cea-46f0-b330-554c7976ce1d>
  a skos:Concept;
  skos:prefLabel "baignoires"@nl;
  skos:scopeNote "Baignoires zijn loges in schouwburgzalen, door borstweringen en zijschotten afgescheiden, iets hoger gelegen dan de parterre en onder het eerste balkon. (Haslinghuis)"@nl;
  skos:altLabel "baignoire"@nl;
