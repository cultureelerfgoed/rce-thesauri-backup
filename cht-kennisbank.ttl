<https://data.cultureelerfgoed.nl/term/id/cht/cd047b37-e76e-48ca-beee-f732944a9bf7>
  a skos:Concept;
  skos:prefLabel "plaag"@nl;
  skos:scopeNote "Men spreekt van een plaag als er actieve insecten, schimmels of bacteriën in een object aanwezig zijn."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/03a6072f-cfac-4d52-96d4-0e43405d7e2f>;
