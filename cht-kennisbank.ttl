<https://data.cultureelerfgoed.nl/term/id/cht/b7ce0c5e-a188-41c5-9c3b-1a11641b28ca>
  a skos:Concept;
  skos:prefLabel "silicaten"@nl;
  skos:scopeNote "Silicaten zijn zouten of esters van kiezelzuur."@nl;
  skos:altLabel "silicaatmineraal"@nl, "silicaat"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/541cf6bb-3273-4fa4-bcc8-8f579f552c03>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4fe895cb-b4bf-4c7c-b432-088f1d6b7ea3>
  a skos:Concept;
  skos:prefLabel "vuurhaarden"@nl;
  skos:scopeNote "Vuurhaarden zijn in het algemeen uit metselwerk opgebouwde vaste haarden in smederijen om ijzer te verhitten. Geheel ijzeren vuurhaarden komen ook voor. Een kunstmatig opgewekte luchtstroom door blaasbalgen of ventilators jaagt het vuur in de haarden op. Via vuurhaardvormen, die opgenomen zijn in de vuurhaarden, kan de luchtstroom al of niet gedoceerd worden. Boven de haard zit altijd een rookvanger gemonteerd om rook en gassen af te voeren. Om het vuur te onderhouden en op te porren maakt de smid gebruik van een kolenschop, en een rechte en kromme haardstok."@nl;
  skos:altLabel "vuurhaard"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1a24fcdf-5c94-4fcd-a5ce-45abfd91f642>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/625b4e2a-3d22-43e3-95a1-70bc2af25099>
  a skos:Concept;
  skos:prefLabel "jeugdcentra"@nl;
  skos:scopeNote "Jeugdcentra zijn gebouwen waar activiteiten plaats vinden voor jongeren. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "jeugdcentrum"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c1f698ea-a359-4c65-a13e-dfd50f8260b3>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/084b3b98-fa47-41b4-8ac4-2e291c95e12a>
  a skos:Concept;
  skos:prefLabel "biljoeningen"@nl;
  skos:scopeNote "(Zaans: winsing) De afschuining van de voor- en achterzijde van de roede, ongeveer gelijk verlopend met de stand van de hekkegaten in de roede. Bedoeld om de roe enige stroomlijn te geven. Bij stalen roeden niet meer toegepast. (Molenwoordenboek B.D. Poppen)"@nl;
  skos:altLabel "biljoening"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/04770e4f-1c11-40e7-a256-9de8c6d569c6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ed9982be-e02e-49ce-acb3-556750debdc3>
  a skos:Concept;
  skos:prefLabel "rubbercementlijm"@nl;
  skos:scopeNote "Een zelfklevende oplossing van niet-gevulkaniseerd rubber in een organisch oplosmiddel. Natuurlijke rubbercement heeft een hoge kleefkracht en geeft een sterke aanvangshechting, maar verkleurt na verloop van tijd en wordt bros. (Project Fotografie)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c623de2a-4e2a-476d-9d3c-10c4501cabad>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e84d73e3-6c69-4b21-8822-3e970efc9037>
  a skos:Concept;
  skos:prefLabel "houwers"@nl;
  skos:scopeNote "Blanke gevestwapens met een relatief korte eensnijdende rechte of kromme kling geschikt om mee te houwen; verouderd begrip (in de 17e eeuw vaak als synoniem van sabel gebruikt). Gebruik 'houwzwaarden' voor zwaarden met een kling, ontworpen om mee te houwen. (AAT-Ned)"@nl;
  skos:altLabel "houwer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/04770e4f-1c11-40e7-a256-9de8c6d569c6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/56ef3a0e-c974-4bac-8151-cc9903ec6f74>
  a skos:Concept;
  skos:prefLabel "spoelplaatsen"@nl;
  skos:scopeNote "Spoelplaatsen zijn agrarische gebouwen of open ruimtes waar landbouwmachines, voertuigen, en vee worden gewassen en schoongemaakt, vaak voorzien van afvoersystemen."@nl;
  skos:altLabel "spoelplaats"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cef967f0-40b3-43ab-8e48-fb7215844297>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/05d68665-3a90-4e99-956e-3ad11fd883fb>
  a skos:Concept;
  skos:prefLabel "schraalland"@nl;
