<https://data.cultureelerfgoed.nl/term/id/cht/98ea0301-977d-4f46-9363-db6598935cc0>
  a skos:Concept;
  skos:prefLabel "cirkels"@nl;
  skos:scopeNote "Geometrische vlakke figuren die zijn begrensd door één gebogen lijn die zich overal even ver van het middelpunt van de figuur bevindt. (AAT)"@nl;
  skos:altLabel "cirkel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
