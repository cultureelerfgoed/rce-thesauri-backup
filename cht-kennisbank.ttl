  a skos:Concept;
  skos:prefLabel "referentieobjecten"@nl;
  skos:scopeNote "Een referentieobject wordt gebruikt als hulpmiddel voor de restauratie van een voorwerp dat een aantal direct vergelijkbare eigenschappen heeft. (Conservation Dictionary)"@nl;
