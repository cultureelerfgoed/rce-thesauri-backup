<https://data.cultureelerfgoed.nl/term/id/cht/0a83bbcf-bf3e-4dea-ae8c-d098cb075750>
  a skos:Concept;
  skos:prefLabel "verwering"@nl;
  skos:scopeNote "De verwering van een voorwerp of een gebouw is de schade die wordt veroorzaakt door blootstelling aan het weer, waardoor het oppervlak erodeert en vergaat."@nl;
  skos:altLabel "verweerd"@nl;
