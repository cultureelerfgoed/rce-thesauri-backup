<https://data.cultureelerfgoed.nl/term/id/cht/928f7233-7614-4d1e-b0b5-5391f395d97d>
  a skos:Concept;
  skos:prefLabel "interieurverlichtingen"@nl;
  skos:scopeNote "Interieurverlichting zorgt voor verlichting van het interieur. Via een schakelaar in de deurstijlen wordt het systeem in- of uitgeschakeld."@nl;
  skos:altLabel "binnenlicht"@nl, "binnenverlichting"@nl, "interieurverlichting"@nl;
