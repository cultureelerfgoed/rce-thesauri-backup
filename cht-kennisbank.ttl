    <https://data.cultureelerfgoed.nl/term/id/cht/254738f7-c253-4dfe-a5ce-c6bca0846c83>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/938cf378-a0a5-4522-aa05-70e8a3ea6e22>
  a skos:Concept;
  skos:prefLabel "scheuren"@nl;
  skos:scopeNote "Een scheur is een barst of een uiteenrijting in een flexibel materiaal waarbij geen materiaal verloren gaat en waarbij weinig vervorming optreedt. Een scheur is een vorm van mechanische schade, veroorzaakt door het met kracht uit elkaar trekken van een flexibel materiaal zoals papier of textiel."@nl,
    "Langwerpige, smalle beschadiging."@nl;
  skos:altLabel "scheur"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fba63d82-3ed8-4a47-b47b-7ae9e750855f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/230363ec-ecca-4e37-9d53-09568a59bad6>
  a skos:Concept;
  skos:prefLabel "spleetcorrosie"@nl;
  skos:scopeNote "Spleetcorrosie is het gevolg van de vorming van een concentratiecel in een spleet, bijvoorbeeld door kleine verschillen in vochtretentie."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/254738f7-c253-4dfe-a5ce-c6bca0846c83>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/44911502-f7bb-4318-8682-f7aa579cf2b1>
  a skos:Concept;
  skos:prefLabel "breuk (mechanica)"@nl;
  skos:scopeNote "Een breuk betekent in de materiaalkunde dat het materiaal geen goede samenhang meer heeft en dus geen trekkrachten meer kan opnemen. Men onderscheidt een brosse en een taaie breuk. (Wikipedia)"@nl;
  skos:altLabel "mechanische breuk"@nl, "taaie breuk"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fba63d82-3ed8-4a47-b47b-7ae9e750855f>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/a1bda31a-b52d-41f7-906b-fbb8c3dc820a>,
    <https://data.cultureelerfgoed.nl/term/id/cht/0ee6e04b-8730-4c0c-b8a9-20326123a947>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/5b08e93c-e860-47fe-94c5-d83a392ce247>
  a skos:Concept;
  skos:prefLabel "bros papier"@nl;
  skos:scopeNote "Bros papier is papier waarvan de cellulose, in het bijzonder in de amorfe gebieden, is aangetast door zure hydrolyse en/of oxidatie. Dat kan worden veroorzaakt door hars-aluin lijming, luchtverontreiniging, de wijze van productie en materia(a)l(en) in contact met en/of aangebracht op het papier."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e0121334-ce90-48c0-9baf-35fac2c9c3f3>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2d28d9aa-77e8-40ab-b0fe-f04d99f57955>
  a skos:Concept;
  skos:prefLabel "papier"@nl;
  skos:scopeNote "Verwijst in het algemeen naar alle typen vervilte vellen of weefsels die bestaan uit vezels, die uit in water gedompelde pulp zijn gevormd en gedroogd op een fijn schepraam. De vezels kunnen dierlijk zijn, zoals haar, zijde of wol, of mineraal, bijvoorbeeld asbest. Ook kunstvezels zijn een mogelijkheid. Het meeste papier wordt echter gemaakt van plantenvezels van bijvoorbeeld houtpulp, gras, katoen, linnen en stro. (Project Fotografie)"@nl;
  skos:altLabel "papieren"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/382f9300-0ebc-40b8-9f48-cb1246990ef9>;
