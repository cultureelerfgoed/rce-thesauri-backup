  a skos:Concept;
  skos:prefLabel "klamplagen"@nl;
  skos:scopeNote "Verticale laag van stenen op hun kant. Die kan dienen om een deel van een muur te verzwaren, of als plaklaag om waterkerende muren van een kelder of regenwaterbak dicht te maken. (Haslinghuis)"@nl;
