<https://data.cultureelerfgoed.nl/term/id/cht/b40f4d49-376e-41e7-b6a7-b98c8a0e40f0>
  a skos:Concept;
  skos:prefLabel "glasdakoranjerieën"@nl;
  skos:scopeNote "Glasdakoranjerieën zijn oranjerieën waarvan het dak geheel of gedeeltelijk is uitgevoerd in glas. Dit type oranjerie kan ook gezien worden als overgang tussen een oranjerie en een kas. (Kassen bij andere monumenten / Kooij, B.H.J.N., 2014)"@nl;
  skos:altLabel "glasdakoranjerie"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/032771ea-179a-4938-b333-2dd3156a11a2>;
