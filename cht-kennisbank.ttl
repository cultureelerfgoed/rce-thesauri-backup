<https://data.cultureelerfgoed.nl/term/id/cht/5c81544d-9fa1-4f4d-bbe5-6bb81250d000>
  a skos:Concept;
  skos:prefLabel "kettingschakels"@nl;
  skos:scopeNote "Ovalen of langwerpige ronde ronde ijzeren ring waarvan er een aantal tot"@nl;
