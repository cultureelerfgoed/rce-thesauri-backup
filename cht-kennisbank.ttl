  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fe79d828-19ae-40ee-9744-8b72c16be86c>
  a skos:Concept;
  skos:prefLabel "wierookvathangers"@nl;
  skos:scopeNote "Een haak aan de muur waaraan het wierookvat kan worden opgehangen."@nl;
  skos:altLabel "wierookvathanger"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aefdd718-b34b-4024-9583-123686fbc209>;
