<https://data.cultureelerfgoed.nl/term/id/cht/c1ea7008-b8f6-40b9-af36-c93b1103d0b5>
  a skos:Concept;
  skos:prefLabel "landschapsarcheologie"@nl;
  skos:scopeNote "De studie van cultuurlandschappen en hun kenmerken door middel van archeologisch veldwerk en analyse. (AAT-Ned)"@nl;
