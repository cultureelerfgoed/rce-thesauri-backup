<https://data.cultureelerfgoed.nl/term/id/cht/9ebc8701-4235-46d4-9e07-cffadd65b777>
  a skos:Concept;
  skos:prefLabel "gecontroleerde droging"@nl;
  skos:scopeNote "Gecontroleerde droging van een nat voorwerp vindt plaats door het vocht te laten verdampen in een omgeving waarin de relatieve vochtigheid geregeld wordt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
