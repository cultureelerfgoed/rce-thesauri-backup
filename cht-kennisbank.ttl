<https://data.cultureelerfgoed.nl/term/id/cht/9692ab86-97c4-496b-8577-0b0de6dde6cf>
  a skos:Concept;
  skos:prefLabel "vangkampen"@nl;
  skos:scopeNote "Vangkampen zijn kleine, afgescheiden gedeelten in hertenkampen om herten te vangen, te scheiden of af te voeren."@nl;
  skos:altLabel "vangkamp"@nl;
