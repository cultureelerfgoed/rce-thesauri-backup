<https://data.cultureelerfgoed.nl/term/id/cht/2551efd6-8d7e-4963-81c7-d4da3090da11>
  a skos:Concept;
  skos:prefLabel "zelflosserwagens"@nl;
  skos:scopeNote "Zelflossers zijn wagens met een speciale vorm, ze zijn voorzien van kleppen, die geopend kunnen worden om d elading uit te storten."@nl;
  skos:altLabel "zelflosserwagen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/feb50453-4925-49d0-a20e-39d63bed2a0f>;
