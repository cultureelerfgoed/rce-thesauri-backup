<https://data.cultureelerfgoed.nl/term/id/cht/0993436e-fc75-4af3-bd47-48453ad4c26c>
  a skos:Concept;
  skos:prefLabel "vitsen (latten)"@nl;
  skos:scopeNote "Vitsen zijn afgeplatte, gekloofde of bekapte latten, gebruikt in verticale of horizontale richting in vakwerk om er twijgen omheen te vlechten. Meestal van eiken- of berkenhout. Het geheel wordt tenslotte met leem bestreken. (Haslinghuis)"@nl;
  skos:altLabel "vits (latten)"@nl, "vitslat"@nl, "vitslatten"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/66547924-e6e8-4991-873e-85a2aa436b91>;
