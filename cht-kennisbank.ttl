<https://data.cultureelerfgoed.nl/term/id/cht/14ea9e2d-c0f0-418d-b3d8-85312d5bf3f6>
  a skos:Concept;
  skos:prefLabel "glasbetonvloeren"@nl;
  skos:scopeNote "Glasbetonvloeren zijn draagvloeren bestaande uit elkaar kruisende gewapend betonbalken, waarvan de openingen worden gesloten met gegoten glazen tegels. (Scharroo)"@nl;
  skos:altLabel "glasbetonvloer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0058d3c3-aaca-4764-a0c4-5aa60dd2a068>;
