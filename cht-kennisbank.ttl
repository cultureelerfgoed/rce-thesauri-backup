<https://data.cultureelerfgoed.nl/term/id/cht/b741795a-43da-48ca-96d0-7862c85199c8>
  a skos:Concept;
  skos:prefLabel "bintbalken"@nl;
  skos:scopeNote "Balk die twee stijlen met elkaar verbindt, o.a. de horizontale verbinding tussen de kotstijlen van een paltrok of een balk tussen tegenover elkaar staande stijlen van een acht- of zeskante houten bovenkruier. (Haslinghuis)"@nl;
  skos:altLabel "bintbalk"@nl, "legeringsbalk"@nl, "legeringsbalken"@nl;
