<https://data.cultureelerfgoed.nl/term/id/cht/0e1fc369-5d5d-4905-b876-25b00c2a02b0>
  a skos:Concept;
  skos:prefLabel "sacramentsnissen"@nl;
  skos:scopeNote "Afsluitbare nis in de koormuur aan de evangeliezijde. Bewaarplaats voor de H. Eucharistie. In de koormuur van de meeste middeleeuwse kerken zijn nog nissen te zien die als de bewaarplaats dienden voor het heilig vaatwerk, maar niet meer worden gebruikt. (Religieus Erfgoedthesaurus)"@nl;
  skos:altLabel "sacramentsnis"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1f045186-ba15-4937-a311-de50437f32d4>;
