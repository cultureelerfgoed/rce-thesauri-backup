<https://data.cultureelerfgoed.nl/term/id/cht/1b1400ca-bd35-46d3-a439-d04b34047f0c>
  a skos:Concept;
  skos:prefLabel "hydrograven"@nl;
  skos:scopeNote "Hydrograven verrichten metingen en onderzoek aan zeeën, rivieren en andere wateren. Zij brengen waterdieptes, stromingen, kustlijnen en vaarwegen in kaart voor navigatie, cartografie of waterbeheer."@nl;
