  a skos:Concept;
  skos:prefLabel "nieuwbouw"@nl;
  skos:scopeNote "De term nieuwbouw heeft betrekking op nieuw gebouwde constructies, zoals een nieuw gebouwd huis, straat of wijk. (Wikipedia)"@nl;
