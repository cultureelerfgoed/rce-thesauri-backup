<https://data.cultureelerfgoed.nl/term/id/cht/3f693c00-c4c6-4fcb-8ed6-e85ba8840ffc>
  a skos:Concept;
  skos:prefLabel "visinleggerijen"@nl;
  skos:scopeNote "Visinleggerijen zijn speciale visverwerkingsplaatsen waar vis wordt ingelegd. Bekend zijn ansjovisinleggerijen. Inleggen is een bereiding- en conserveringstechniek waarbij men vis in laat trekken in een bepaalde vaste stof of vloeistof, zoals zout en azijn. (Van Dale)"@nl;
  skos:altLabel "visinleggerij"@nl;
