<https://data.cultureelerfgoed.nl/term/id/cht/0af7a560-ee7c-489d-bbb5-7291cc785daa>
  a skos:Concept;
  skos:prefLabel "ribbenvloeren"@nl;
  skos:scopeNote "Ribbenvloeren zijn draagvloeren bestaande uit T-vormige ribben van verdicht gewapend grind-, bims- of hollithbeton, waarbij de (geringe) tussenruimten met grindbeton worden gevuld. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "ribbenvloer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0058d3c3-aaca-4764-a0c4-5aa60dd2a068>;
