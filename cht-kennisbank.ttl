  a skos:Concept;
  skos:prefLabel "toonkamers"@nl;
  skos:scopeNote "Zaal waar de leden van een schildersgilde (St.-Lucasgilde) hun werken uitstalden en verkochten, b.v. in Utrecht, Haarlem, Amsterdam (boven in het stadhuis). (Haslinghuis)"@nl;
  skos:altLabel "toonkamer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/be185a64-69d3-478c-b740-e116020dd206>;
