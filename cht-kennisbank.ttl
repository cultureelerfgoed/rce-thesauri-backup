<https://data.cultureelerfgoed.nl/term/id/cht/870d041a-e84b-4829-9e00-f0ffb70dcab4>
  a skos:Concept;
  skos:prefLabel "teermastiek"@nl;
  skos:scopeNote "Teermastiek is een plakmateriaal op basis van teer, dat slechts na smelting verwerkt kan worden. Het kan ook als afstrijklaag tussen en op teervilt worden toegepast."@nl;
