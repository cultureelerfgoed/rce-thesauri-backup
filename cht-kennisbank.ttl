  a skos:Concept;
  skos:prefLabel "schroefbouten"@nl;
  skos:scopeNote "Schroeven die worden gebruikt voor het op een lijn brengen van een voorwerp en die vaak aan een sluitmoer worden gekoppeld om ze op hun plaats vast te zetten. (AAT-Ned)"@nl;
