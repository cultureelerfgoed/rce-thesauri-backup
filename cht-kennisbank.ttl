<https://data.cultureelerfgoed.nl/term/id/cht/810db8ce-733e-48d6-9cbb-0b44001961c8>
  a skos:Concept;
  skos:prefLabel "bewaking"@nl;
  skos:scopeNote "Bewaking maakt gebruik van bewakingspersoneel of van een gesloten televisiecircuit, waarmee een collectie in de gaten gehouden kan worden."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/190b9fce-fb0d-4b41-b46d-e1795ae38304>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/812f10c4-0987-44a5-8f64-146e9de2f855>
  a skos:Concept;
  skos:prefLabel "puntschilfering"@nl;
  skos:scopeNote "Puntschilfering in een schilderij is verfverlies op heel kleine plekjes."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fcd85b41-2cf8-46e0-bfc5-8b109f4bb938>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/814a5415-4a0a-44fc-827a-00ae95505aa7>
  a skos:Concept;
  skos:prefLabel "afnemen van muurschilderingen"@nl;
  skos:scopeNote "Zie verdoeking"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/818560be-ba24-49fa-85f2-bf361b64d449>
  a skos:Concept;
  skos:prefLabel "hoogovencement"@nl;
  skos:scopeNote "Hoogovencement (hoc) is een hydraulisch bindmiddel bestaande uit enkele procenten gips of anhydriet, 20-65% gemalen portlandcementklinkers en 35-80% gegranuleerd hoogovenslak, een afvalproduct van de staalindustrie met latent hydraulische of wel puzzolane eigenschappen (zie puzzolaancementen). is beter zout- en zuurbestendig dan portlandcement (pc), geschikt voor toepassing in (zee)water en agressieve milieus. Hydrateert langzamer dan pc bij lage tempraturen, sneller bij hogere tempraturen. Langzame hydratatie geschikt voor dikke constructies (minder hydratatiewarmte ergo minder tempratuurspanning). wanneer snelle ontkisting wenselijk is kan het hydratatieproces versneld worden door het cement te verwarmen (c. > 35 °C). Heeft direct na ontkisting blauwe-groene kleur, maar verdwijnt na langere blootstelling aan de buitenlucht. onder water en in de kern van het beton blijft deze kleur zichtbaar. In Nederland veel toegepast, goedkoper dan pc."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5edf3ff6-8b94-4892-b1ce-af9a41d5a5b5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/819a258d-5266-4463-9da0-f1d0f67e866e>
  a skos:Concept;
  skos:prefLabel "melaminehars"@nl;
  skos:scopeNote "Melamine is een oligomeer die wordt gebonden aan formaldehyde en zo een stijve, thermohardende polymeer vormt. Melaminehars werd gebruikt als deklaag bij restauratie van aardewerk."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f441e935-eea6-4606-9017-ce0b579c91e7>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/81a26b68-d0b7-4070-954f-1ca5a55c53d9>
  a skos:Concept;
  skos:prefLabel "Servo-Kroatisch"@nl;
  skos:scopeNote "Het Servo-Kroatisch of ook wel Kroato-Servisch (srpskohrvatski of hrvatskosrpski) is een taal uit de westelijke groep van de Zuid-Slavische talen. Het was de hoofdtaal van Servië, Kroatië, Bosnië en Herzegovina en Montenegro en wordt ook gesproken en verstaan in Macedonië en Slovenië. De taal wordt verder gesproken door Servische en Kroatische minderheden in Oostenrijk, Hongarije en Roemenië."@nl;
  skos:altLabel "Servo-Kroatische"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ba8a0df0-e7c1-48f4-ab90-dfde6c264f0e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/81d6c847-d00d-4c81-ac5d-3c59f6a1b236>
  a skos:Concept;
  skos:prefLabel "Munsell kleursysteem"@nl;
  skos:scopeNote "Het Munsell kleursysteem is een verzameling van gekleurde monsters, opgesteld in een theoretische driedimensionale kleurruimte, met als assen de kleur, de intensiteit en de chroma (verzadiging)."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/47e05121-f2b9-4020-a461-97319b89bf5e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/81e47da3-56ad-47de-8c3c-03ff7bf90696>
  a skos:Concept;
  skos:prefLabel "Noors"@nl;
  skos:scopeNote "Het Noors (norsk) is een Noord-Germaanse of Scandinavische taal met ongeveer 4,5 miljoen sprekers. Het is een officiële taal in Noorwegen.Het Noors is nauw verwant aan de andere twee vasteland-Scandinavische talen, het Deens en het Zweeds. Deze drie talen zijn onderling redelijk verstaanbaar. Twee andere Scandinavische talen, het IJslands en het Faeröers, vertonen echter sterkere afwijkingen tegenover deze drie talen."@nl;
  skos:altLabel "Noorse"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ba8a0df0-e7c1-48f4-ab90-dfde6c264f0e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/81e70bd3-a33e-438d-b217-aa01b7e72093>
  a skos:Concept;
  skos:prefLabel "nevelspuiten"@nl;
  skos:scopeNote "Bij nevelspuiten wordt een waternevel gebruikt voor het reinigen van metselwerk en gebouwen; het vuil wordt natgemaakt en nat gehouden waardoor het zacht wordt en kan worden afgewassen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/81fb97a4-dde1-43e9-a89c-dfb2833162fe>
  a skos:Concept;
  skos:prefLabel "lamme armen"@nl;
  skos:scopeNote "Een eenvoudige vorm van motorisering van zeilschepen in de binnenvaart was het plaatsen van een zijschroefinstallatie, kortweg zijschroef, in de wandeling een zogenaamde lamme arm.(Wikipedia)"@nl;
  skos:altLabel "lamme arm"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8207d84e-b2ac-4c0c-819a-4e586d01336f>
  a skos:Concept;
  skos:prefLabel "beschavingsgeschiedenis"@nl;
  skos:scopeNote "Beschavingsgeschiedenis omvat de overblijfselen van de geschiedenis van de door de mens gemaakte en beïnvloede leefomgeving.(Bron:www.encyclo.nl/lokaal/10651)"@nl,
    "Geschiedenis van alles dat door mensen gemaakt is en niet op natuurlijke wijze, of als een ‘deus ex machina’ ontstaan is. Het is daarmee breder dan bijvoorbeeld kunstgeschiedenis. Alle bouwwerken horen erbij maar bijvoorbeeld ook landschappelijke patronen (wallen, hagen, akkers, polders; zowel boven als onder het maaiveld). (Oude) staatkundige patronen (landsgrenzen) en bijvoorbeeld de invloed van religie eveneens. Landschappelijke patronen die niet door mensen zijn gemaakt of veroorzaakt (natuurlijk meanderende rivier, natuurlijk reliëf) worden er niet toe gerekend. Omdat deze geomorfologische aspecten echter wel voorwaardenscheppend zijn geweest voor het `in cultuur brengen` van gebieden en (dus) nauw samenhangen met de historisch-geografische aspecten, worden zij wel betrokken bij het cultuurhistorisch onderzoek. Cultuurhistorisch onderzoek vormt een belangrijk instrument om de monumentale waarden van een gebied, complex of pand te objectiveren."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/3497e072-02f7-4560-b7a6-438df232a4ad>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/82240b99-7bb2-4b90-bdcd-1b907508ed62>
  a skos:Concept;
  skos:prefLabel "edelpatina"@nl;
  skos:scopeNote "Edelpatina is een dunne en stabiele corrosielaag, die het onderliggende metaal beschermt tegen verdere corrosie."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/160866bb-38d8-4454-b99a-378a740be76a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/825fbd60-7674-4d5c-8938-7a3743bbeebd>
  a skos:Concept;
  skos:prefLabel "machineonderdelen"@nl;
  skos:scopeNote "Machineonderdelen zijn de onderdelen van een machine. Een machine is een apparaat opgebouwd uit een frame, een aandrijvingsmechanisme en overige specifieke onderdelen. Het is een mechanisme dat een vorm van beweging of energie in een andere vorm van beweging of energie kan omzetten.(Wikipedia)"@nl;
  skos:altLabel "machineonderdeel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/82694b34-6f7d-4a13-805b-d9869eaef908>
  a skos:Concept;
  skos:prefLabel "sinaasappelhuid"@nl;
  skos:scopeNote "Sinaasappelhuid is een fout in afwerkingslagen die meer of minder uitgesproken putjes vertonen, waardoor ze op een sinaasappelschil lijken. Het komt voor bij afwerkingen die met een spuit zijn opgebracht. Het effect wordt misschien veroorzaakt door een verkeerde viscositeit, te lage spuitkracht, onvoldoende droging tussen verschillende spuitbeurten of componenten in het te verspuiten materiaal die elkaar niet verdragen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/82b6ea79-7bc3-4d97-8763-15255c3f7942>
  a skos:Concept;
  skos:prefLabel "macereren"@nl;
  skos:scopeNote "Macereren is een methode voor het verwijderen van het vlees van een skelet door langdurig weken in koud of warm water. Chemicaliën als natriumperboraat en enzymen kunnen aan het water worden toegevoegd om de reactie te versnellen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/83282edf-459d-417e-871e-acc79ffe5e5e>
  a skos:Concept;
  skos:prefLabel "kilogram"@nl;
  skos:scopeNote "De kilogram (ook het kilogram) is sinds 1901 de internationale standaardeenheid voor massa en daarmee een van de zeven basiseenheden van het SI. Een kilogram is gelijk aan duizend gram. Toch is kilogram een basiseenheid en niet gram."@nl;
  skos:altLabel "kg"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/47d5a411-95ce-4d91-a31c-7812fc403986>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/83680272-4098-44ec-9873-3fa84b349895>
  a skos:Concept;
  skos:prefLabel "schelpgoud"@nl;
  skos:scopeNote "Schelpgoud is goudpoeder dat vroeger werd gemaakt van restjes goud van een vergulding. Deze restjes werden in een schelp bewaard."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/87732f1f-badc-482e-b596-cdd356dc6c1d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/836c881a-101d-4fb9-8361-15f8fa21fcd3>
  a skos:Concept;
  skos:prefLabel "petroleumether"@nl;
  skos:scopeNote "Petroleumether is vloeibare, alifatische koolwaterstof, verkregen bij de destillatie van aardolie. Oplosmiddelen van deze chemische familie zijn onder verschillende namen verkrijgbaar met verschillende kookpunten en in diverse zuiverheden en kwaliteiten: benzine, peut, terpentine, ligroïne, white spirit, Stoddard solvent, kerosine."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/79a3c2cb-a3ed-493a-865d-6da68c845f89>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/838e7f0c-b32e-4fa5-ad13-2ef1498fd3a0>
  a skos:Concept;
  skos:prefLabel "diamantgraveren"@nl;
  skos:scopeNote "Diamantgraveren is een decoratietechniek voor het graveren van glas, door met een punt van een diamant in het oppervlak te krassen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/83bda614-c511-4c9a-9ec8-33f5892026ba>
  a skos:Concept;
  skos:prefLabel "laser discs"@nl;
  skos:scopeNote "Een laser disc (LD) is een platte schijf, 30 cm in doorsnede, van glas of polycarbonaat die met behulp van een laserstraal afleesbaar is. Er bestaan twee typen: CLV, constant linear velocity, met een capaciteit voor twee uur film (60 minuten per kant) en CAV, constant analogue velocity, waarbij elke willekeurige afbeelding van de maximaal 54.000, beeld voor beeld kan worden bekeken. Een laser-disc kan gemakkelijk worden beschadigd, sommige soorten worden aangetast door licht. (Conservation Dictionary)"@nl;
  skos:altLabel "LD"@nl, "laser disc"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91712616-6dec-4871-8fdc-c317850c20d1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/83e2c452-e790-476d-a0d7-462dfdbafc56>
  a skos:Concept;
  skos:prefLabel "tratteggio"@nl;
  skos:scopeNote "Tratteggio is een manier van retoucheren waarbij verschillende kleuren in dunne, korte, evenwijdige en verticale penseelstreken worden aangebracht en waarmee de lacune voor het oog doorlopend wordt opgevuld."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/83e9174f-c5a2-4ba7-96de-b5a793d132fb>
  a skos:Concept;
  skos:prefLabel "conservering van onderwaterarcheologica"@nl;
  skos:scopeNote "Conservering van onderwaterarcheologica houdt het conserveren in van vondsten uit de zee in."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/83e9cec5-5de4-4301-abdc-da10177592c4>
  a skos:Concept;
  skos:prefLabel "bronspoeder"@nl;
  skos:scopeNote "Elk metaal, bijvoorbeeld een koperlegering of aluminium, in de vorm van fijne schilfers die als pigment worden gebruikt om het uiterlijk te creëren van een metallic oppervlak. (Collectiewijzer)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2d4ff601-9025-4667-811d-a4fe8da87b4d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8451279a-b5ec-4108-8386-37249a490616>
  a skos:Concept;
  skos:prefLabel "ektachrome (kleurtransparant)"@nl;
  skos:scopeNote "Ektachrome, van oorsprong een Kodak-merknaam, wordt gebruikt als een algemene term voor kleurtransparanten groter dan 35 mm. (Conservation Dictionary)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/91712616-6dec-4871-8fdc-c317850c20d1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8458234e-1ab8-4658-a109-29c605e20701>
  a skos:Concept;
  skos:prefLabel "bruikleennemers"@nl;
  skos:scopeNote "Een bruikleennemer is een persoon of een instelling die een voorwerp of een (deel)collectie in bruikleen neemt."@nl;
  skos:altLabel "bruikleennemer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db4a7619-d236-4b14-8e79-b4a6e890f677>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8484e35d-0b0c-427c-87f5-edbc25efeba4>
  a skos:Concept;
  skos:prefLabel "erfgoedmanagement"@nl;
  skos:scopeNote "Erfgoedmanagement is het totaal van beleid en praktijk met betrekking tot de conservering, documentatie en promotie van objecten en plekken die van belang zijn vanuit historisch of wetenschappelijk oogpunt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/190b9fce-fb0d-4b41-b46d-e1795ae38304>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/84a616e4-a1d3-47ef-987c-e4523313b137>
  a skos:Concept;
  skos:prefLabel "methacrylaathars"@nl;
  skos:scopeNote "Een methacrylaathars is een thermoplastische polymeer, opgebouwd uit methacrylaat monomeren. Deze harsen zijn bijzonder bestand tegen vergeling en worden in de conservering op ruime schaal gebruikt als afdeklaag, verstevigingsmiddel of hechtmiddel."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a061ecd4-92f0-47fc-b937-066e78e8d8e0>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/84b1e7bd-a5ac-4480-a23d-3f0e30387b6c>
  a skos:Concept;
  skos:prefLabel "conserveringsmedewerkers"@nl;
  skos:scopeNote "Een conserveringsmedewerker is opgeleid voor het uitvoeren van conserveringsbehandelingen; hij werkt onder leiding van een restaurator."@nl;
  skos:altLabel "conserveringsmedewerker"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db4a7619-d236-4b14-8e79-b4a6e890f677>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/84b584d2-894b-414d-914a-15675069b1dd>
  a skos:Concept;
  skos:prefLabel "schipperstaal"@nl;
  skos:scopeNote "Schipperstaal is een verzameling van de door binnenvaartschippers gebruikte terminlogieën. Synoniem voor binnenvaartjargon, tegenwoordig vaak ook binnenvaarttaal genoemd. De term schipperstaal werd in 1910 al gebruikt, maar raakte een beetje in de vergetelheid. Nadat in 2003 het boek 'Skipperstaal' (Fries voor 'schipperstaal') verschenen is, lijkt het gebruik van deze term weer op te leven."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ba8a0df0-e7c1-48f4-ab90-dfde6c264f0e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/84dbccd2-258b-413d-ac19-d54cf4f09000>
  a skos:Concept;
  skos:prefLabel "drogende olie"@nl;
  skos:scopeNote "Een drogende olie is een plantaardige olie met onverzadigde vetzuren die met zuurstof reageert en cross-linkt en zo een samenhangende laag vormt. Drogende oliën worden veel gebruikt als bindmiddel voor verfpigmenten, bijvoorbeeld lijnolie, notenolie en papaverolie. Zie ook olie, en niet-drogende olie."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/85007d82-4774-4089-97fa-7bf8d81f4516>
  a skos:Concept;
  skos:prefLabel "corrosiesnelheid"@nl;
  skos:scopeNote "De corrosiesnelheid van een metaal geeft aan hoe snel het wordt geoxideerd in een bepaalde omgeving. Zij wordt vaak aangeduid met de laagdikte die per jaar verloren gaat of met het gewicht dat per oppervlakte-eenheid en per tijdseenheid verloren gaat."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/929f2b49-e558-4543-a710-41a893c3c5dd>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/857dd29e-8e8f-4ff5-a4b7-3140a5b2c992>
  a skos:Concept;
  skos:prefLabel "vergulderskwasten"@nl;
  skos:scopeNote "Een vergulderskwast is een dikke ronde kwast van eekhoorn-, dassen- of ponyhaar. Hij wordt gebruikt om het goudblad op de geprepareerde ondergrond te kloppen en dan de overgebleven stukjes goudblad weg te vegen. (Conservation Dictionary)"@nl;
  skos:altLabel "vergulderskwast"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5a83bdca-8978-4f12-a5b1-ce3c095b13a2>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/85cb73c8-0224-4493-8ebe-6946e29df774>
  a skos:Concept;
  skos:prefLabel "Jenolite gel"@nl;
  skos:scopeNote "Jenolite gel is een in de handel verkrijgbare roestverwijderaar met fosforzuur als belangrijkste actieve stof. Jenolite is gebruikt voor de verwijdering van roestvlekken op ceramiek, glas en stenen voorwerpen. Het is gebleken dat fosforzuur glas etst en men neemt aan dat het onoplosbare calciumfosfaten vormt in de aardewerkscherf."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/85ea8a56-e608-4f6a-bd40-a1bb1c503e78>
  a skos:Concept;
  skos:prefLabel "halfwerken"@nl;
  skos:scopeNote "Halfwerken zijn de op één na kleinste lepelvormige boren voor het uiboren van klompen. Ze zijn voorzien van een dwarsgeplaats handvat; de boorkruk."@nl;
  skos:altLabel "halfwerk"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b3e6e73-95c2-4cb8-957a-8ad57d8946f9>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/860f0cef-06c3-4de8-8c9b-0259813b831a>
  a skos:Concept;
  skos:prefLabel "tussengeschoten vellen"@nl;
  skos:scopeNote "Een tussengeschoten vel is een transparant, of dun opaak blank vel papier dat tussen twee pagina's of tussen illustratie en tekstpagina geplaatst is, om tegen elkaar schuren van de pagina's te voorkomen. (Conservation Dictionary)"@nl;
  skos:altLabel "tussengeschoten vel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cf6bc0f3-9144-4847-8578-4e2227470cdd>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8616a51a-a503-4ec1-b194-d79b1da96413>
  a skos:Concept;
  skos:prefLabel "podriznik"@nl;
  skos:scopeNote "Een podriznik is het lange onderkleed van een priester, afgebeeld op een icoon."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7b6aa962-9e1b-4be4-88ae-11e4b89dbc8b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/862512ea-aa15-4a94-aacb-64548407d8e2>
  a skos:Concept;
  skos:prefLabel "optische instrumenten"@nl;
  skos:scopeNote "Optische instrumenten zijn hulpmiddelen, al dan niet elektromechanisch, waarbij het gedrag van licht wordt gemanipuleerd om het gewenste resultaat te bereiken. Voorbeelden van optische instrumenten zijn: verrekijker, sterrenkijker, microscoop, Röntgen-diffractie systemen en spectrometer.(Wikipedia)"@nl;
  skos:altLabel "optisch instrument"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/1c068bbf-8e71-4cb4-aaf8-49b2b994503b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/86530e2b-5918-4e48-a306-dc1a1ee76cca>
  a skos:Concept;
  skos:prefLabel "conditionering"@nl;
  skos:scopeNote "Een materiaal wordt geconditioneerd door het in evenwicht te laten komen met een bepaalde relatieve vochtigheid. Silicagel wordt bijvoorbeeld vaak voor gebruik geconditioneerd om de RH constant te houden."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8689e939-d019-4070-881d-d130af2fc5bf>
  a skos:Concept;
  skos:prefLabel "losse bedoeking"@nl;
  skos:scopeNote "Een losse bedoeking is een doek dat niet aan het originele doek is vastgeplakt, maar dat op zich aan het spieraam wordt bevestigd, onder het originele doek. Het werkt als een beschermende laag. (Conservation Dictionary)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/461d88c4-a46f-4dbb-a137-a9266eae7a42>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/868a6278-edc5-4637-b0b8-4a2400c62853>
  a skos:Concept;
  skos:prefLabel "witte portlandcement"@nl;
  skos:scopeNote "Wit portlandcement wordt verkregen door basismengsel te gebruiken dat rijk is aan krijt en arm aan ijzeroxides. Geeft een egaal witte kleur. Met kleurtoeslag ook gebruikt om andere egale kleuren te bewerkstelligen. Overige eigenschappen gelijk aan portlandcement."@nl;
  skos:altLabel "wit cement"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5edf3ff6-8b94-4892-b1ce-af9a41d5a5b5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/86c8c3dc-9e43-49d6-9d1d-bca18562acea>
  a skos:Concept;
  skos:prefLabel "ambulance's"@nl;
  skos:scopeNote "Een ambulance is een voertuig om medische hulpverleners te vervoeren naar een plaats waar behoefte is aan spoedeisende hulp en om slachtoffers of patiënten te vervoeren naar een ziekenhuis. (Wikipedia)"@nl;
  skos:altLabel "ambulance"@nl, "ziekenauto"@nl, "ziekenauto's"@nl, "ziekenwagen"@nl,
    "ziekenwagens"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dec3cb60-0105-49ac-a19f-d52c1f1ac5b4>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/86f5236f-e39e-4bc8-a820-b06136415797>
  a skos:Concept;
  skos:prefLabel "tegendrukken"@nl;
  skos:scopeNote "Een tegendruk is een olieverfafdruk op papier van een nog natte broomoliedruk met behulp van een (hand)drukpers. (Conservation Dictionary)"@nl;
  skos:altLabel "tegendruk"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/59470330-aa65-4b12-9e63-f19613be65bb>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/87306f37-c0da-480e-b973-19d399fb2ca7>
  a skos:Concept;
  skos:prefLabel "berliner"@nl;
  skos:scopeNote "Een berliner is een vroege vorm van een grammofoonplaat die in diverse diameters gemaakt werd. De Berliner werd geïntroduceerd door Emile Berliner (1851-1929). (Conservation Dictionary)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b99d539a-ba19-492f-99f6-f221523f84c2>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8731d83f-cb4f-44a6-a2d5-10527577526c>
  a skos:Concept;
  skos:prefLabel "gemerceriseerde katoen"@nl;
  skos:scopeNote "Gemerceriseerde katoen is katoen die is behandeld in het merceriseerproces. Zie ook merceriseren."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a5835fe7-c0e0-4750-a5f5-c2632321a8fa>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/87821b75-6efc-49ae-abeb-f4c7d5b6db01>
  a skos:Concept;
  skos:prefLabel "plique à jour"@nl;
  skos:scopeNote "Plique à jour is een emailleertechniek waarbij email in een open netwerk van metaal wordt gebracht, dat geen metalen ondergrond heeft, zodat er licht doorheen kan vallen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/87a26ab6-8830-4936-ac8d-c51b1daec956>
  a skos:Concept;
  skos:prefLabel "tegenelektrodes"@nl;
  skos:scopeNote "De tegenelektrode is een hulpelektrode in een galvanische cel waarin de corrosie-eigenschappen van materialen kwantitatief worden bepaald. De hulpelektrode moet de stroom voeren die nodig is voor de meting. (Conservation Dictionary)"@nl;
  skos:altLabel "tegenelektrode"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/33f1944f-4045-46f2-a3b0-8283bdc5b328>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/87a28159-6643-4ee9-b1ee-f1b91c184189>
  a skos:Concept;
  skos:prefLabel "totale reiniging"@nl;
  skos:scopeNote "Totale reiniging is de complete afname van een oppervlaktelaag van een voorwerp, meestal om het geschikt te maken voor tentoonstelling of om de interpretatie te vergemakkelijken."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/87c3b34d-18ae-4c09-82a3-c7f26fb04c88>
  a skos:Concept;
  skos:prefLabel "enzym"@nl;
  skos:scopeNote "Een enzym is een eiwit dat als katalysator werkt voor fysiologische reacties. Enzymen worden heel selectief gebruikt voor het verwijderen van onoplosbare, verouderde organische materialen zoals stijfsel of lijm. Enzymen blijven alleen intact en werkzaam als katalysator onder omstandigheden die vergelijkbaar zijn met de natuurlijke fysiologische omstandigheden. Tal van verschillende enzymen worden gebruikt voor het oplossen van bindmiddelen, lijmen en vernissen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/e931f06e-03ab-455d-85d9-ab7b509107c5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/87d74974-f31b-491f-ba7c-f813db1c35c8>
  a skos:Concept;
  skos:prefLabel "cellulose-acetaat-butyraat"@nl;
  skos:scopeNote "Cellulose-acetaat-butyraat is een thermoplastisch polymeer dat ontstaat uit een reactie van cellulose met azijnzuuranhydride en boterzuur. Het wordt, met toevoeging van weekmakers) gebruikt voor films. Het hydrolyseert langzaam onder ontwikkeling van azijnzuur."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a061ecd4-92f0-47fc-b937-066e78e8d8e0>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/88103e20-f0b1-4ed2-b65e-4a8402d1d0b2>
  a skos:Concept;
  skos:prefLabel "interstitium"@nl;
  skos:scopeNote "Een interstitium is het gat (de holte) tussen de draden van de canvas drager."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/461d88c4-a46f-4dbb-a137-a9266eae7a42>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/88307b6f-5faf-4a64-a4ad-41e63f6604a3>
  a skos:Concept;
  skos:prefLabel "klaarzakken"@nl;
  skos:scopeNote "De klaarzak is een zakvormig net dat in de bun van het schip wordt gehangen en waarin men de vis bewaart."@nl;
  skos:altLabel "klaarzak"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b4986b17-3253-453e-8e7c-5e334173ebff>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8836a4c7-f027-4cf2-9d11-eb35cc5b29ae>
  a skos:Concept;
  skos:prefLabel "vlasbewerkingsgereedschappen"@nl;
  skos:scopeNote "Vlasbewerkinggereedschappen zijn alle gereedschappen, die nodig zijn om vlas te bwerken. Voorbeelden daarvan zijn: de vlasbeuk, de vlasbraak, de zwingelmachine, het kaardplankje en de natspinmachine."@nl;
  skos:altLabel "vlasbewerkingsgereedschap"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8836b30c-42f3-4a2a-9da7-8557a2a0b972>
  a skos:Concept;
  skos:prefLabel "inleg"@nl;
  skos:scopeNote "Ingelegde decoratieve en beschermende rand van hout, kunststof of een ander materiaal langs de rand van de kast, achterblad of hals van snaarinstrumenten. Voornamelijk gebruikt voor violen en gitaren. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/88412afb-2ef2-4a24-9e57-8bdb6e465747>
  a skos:Concept;
