<https://data.cultureelerfgoed.nl/term/id/cht/5b4ffeb1-8a9d-41a0-b43b-104a058782ed>
  a skos:Concept;
  skos:prefLabel "wrakboeien"@nl;
  skos:scopeNote "Buik- of spitsvormige ton kleiner van omvang dan de gewone zeetonnen beschilderd met een dambordpatroon. Onderscheidend kenmerk dat zich ter plaatse van een gezonken schip of een wrak bevindt. (MARDOC)"@nl;
  skos:altLabel "wrakboei"@nl, "wraktonnen"@nl, "wrakton"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b0ded95-0e37-4006-b46f-69a8a49d1f41>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/77c59b15-0817-4a3c-bc3f-35dd9af6f61c>
  a skos:Concept;
  skos:prefLabel "castellums"@nl;
  skos:scopeNote "Kleine Romeinse legerplaats. (Haslinghuis)"@nl;
  skos:altLabel "castellum"@nl;
