<https://data.cultureelerfgoed.nl/term/id/cht/4b63f1b7-63bb-48fd-8cfb-81d4e2775d9a>
  a skos:Concept;
  skos:prefLabel "poldergrenspalen"@nl;
  skos:scopeNote "Poldergrenspalen zijn grenspalen die de grenzen van polders markeren. Vaak staan de namen van de betreffende polders erop aangeven. (Grenspalen in Nederland / T. Brouwer, Zutphen 1978)"@nl;
  skos:altLabel "poldergrenspaal"@nl;
