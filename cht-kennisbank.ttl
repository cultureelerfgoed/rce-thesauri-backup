<https://data.cultureelerfgoed.nl/term/id/cht/7b8f906b-4d47-4cbe-89f2-900febe3bb0e>
  a skos:Concept;
  skos:prefLabel "peilschalen"@nl;
  skos:scopeNote "Een peilschaal is een maatlat, voorzien van een indeling in centimeters, waarop de waterstand ten opzichte van N.A.P. kan worden afgelezen. (Thesaurus landschap)"@nl;
  skos:altLabel "peilschaal"@nl;
