<https://data.cultureelerfgoed.nl/term/id/cht/5919f9c2-c113-4fcd-8634-95968f786255>
  a skos:Concept;
  skos:prefLabel "aanplakzuilen"@nl;
  skos:scopeNote "Aanplakzuilen of reclamezuilen zijn cilindrische objecten in de openbare ruimte met een karakteristieke stijl die worden gebruikt voor reclame-en andere doeleinden. (AAT)"@nl;
  skos:altLabel "aanplakzuil"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/45a74ae2-8946-4fec-a6fb-e8cdefed17c6>;
