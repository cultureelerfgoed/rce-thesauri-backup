<https://data.cultureelerfgoed.nl/term/id/cht/ccfb1a31-6839-4f2f-a0cb-0a3da5d371ac>
  a skos:Concept;
  skos:prefLabel "overlopen (trap)"@nl;
  skos:scopeNote "De platformen die zich tussen trappen of aan het eind van een trap bevinden. (AAT)"@nl;
  skos:altLabel "overloop (trap)"@nl;
