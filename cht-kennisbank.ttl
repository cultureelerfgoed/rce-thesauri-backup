  a skos:Concept;
  skos:prefLabel "slijtlagen"@nl;
  skos:scopeNote "Slijtlagen zijn de toplagen van rietdaken, de lagen riet tot de gaarden. De toplagen slijten in de loop der jaren. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
