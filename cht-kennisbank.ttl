<https://data.cultureelerfgoed.nl/term/id/cht/28588b3f-12cb-4e9a-b20f-22df4cb7e236>
  a skos:Concept;
  skos:prefLabel "gordelbogen"@nl;
  skos:scopeNote "Gordelbogen zijn bogen die loodrecht staan op de lengteas van een langgerekt gewelfveld of een opeenvolging van gewelfvlakken. In de vroege romaanse periode dragen zij soms de kap- en zolderbalken. Later en in de gotiek steunen zij samen met de muraalbogen de gewelfkappen en scheiden de traveeën. (Haslinghuis)"@nl;
  skos:altLabel "gordelboog"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/42f94d21-f2a3-40e2-bf34-cc9e17ddaaaa>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

