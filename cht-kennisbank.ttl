  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b48b55b3-990b-4d24-b78f-ee32659fc3b0>
  a skos:Concept;
  skos:prefLabel "theekoepels"@nl;
  skos:scopeNote "Theekoepels zijn tuinhuizen, oospronkelijk met een koepeldak. De grondvormen zijn vierkant, rechthoekig, zes- of achthoekig, of ook wel rond. Tuinkoepels liggen vaak op een plek in de tuin waar de eigenaar een mooi uitzicht had op de omgeving en de koepel bovendien zichtbaar was voor voorbijgangers als teken van status. De koepel kan ook als beëindiging van een zichtlijn in de aanleg fungeren. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "lusthuisje"@nl, "lusthuisjes"@nl, "lustprieel"@nl, "lustpriëlen"@nl,
    "theehuisje"@nl, "theehuisjes"@nl, "theekoepel"@nl, "tuinkoepel"@nl, "tuinkoepels"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5aead5c4-f112-49f6-b969-bc4a903155c9>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/1efef502-6f77-4abc-8050-0db5df86ecd4>
  a skos:Concept;
  skos:prefLabel "speeltuinen"@nl;
  skos:scopeNote "Speeltuinen zijn, vaak omheinde, speelplekken in buitenlucht ingericht met speeltoestellen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "speelplaats"@nl, "speelplaatsen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b17688af-1ba1-4584-9862-e23ed26c3d84>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/7f4cd784-3e7d-4fdf-b6de-8b5e4fa095ff>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ba11cf0e-e44b-4416-9cb7-dd822adf5f3b>
  a skos:Concept;
  skos:prefLabel "sporen"@nl;
  skos:scopeNote "Metalen drijvers die zijn bevestigd aan de hielen van de laarzen van de rijder en die worden gebruikt om het paard aan te drijven. (AAT-Ned)"@nl;
  skos:altLabel "spoor"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/46f6ac19-d72c-4b91-be96-a27beeda1945>
  a skos:Concept;
  skos:prefLabel "boswachterswoningen"@nl;
  skos:scopeNote "Boswachterwoningen zijn woningen voor het huisvesten van boswachters. De woningen zijn meestal vrijstaand gelegen in of dichtbij het bos of natuurgebied."@nl;
  skos:altLabel "boswachterswoning"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/68a2ee6d-9205-424e-9540-43d27b6a483f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2671cfb0-dcb7-4a55-a45a-6308026bb1f8>
  a skos:Concept;
  skos:prefLabel "kruidentuinen"@nl;
  skos:scopeNote "Kruidentuinen zijn tuinen sinds de middeleeuwen aangelegd bij kloosters, apothekers of artsen voor het kweken van medicinale planten. Vanaf de 17de eeuw werd de hortus medicus in steden vaak onderdeel van hortus botanicus. Middeleeuwse kruidentuinen zijn in Nederland niet bewaard. Kruidentuinen konden ook verfplanten en keukenkruiden bevatten. Tegenwoordig worden kruidentuinen vooral aangelegd voor keukenkruiden. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "hortus medicus"@nl, "kruidentuin"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a83102b6-8906-4a48-b490-99f375f222e9>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/cf89484b-4e3f-4dc7-9aac-a979361cbbdc>
  a skos:Concept;
  skos:prefLabel "beeldentuinen"@nl;
  skos:scopeNote "Beeldentuinen zijn tuinen ingericht om beeldende kunst buiten te kunnen opstellen, waarbij de beleving van de kunst en de tuin elkaar versterken. Dit kan bij een museum zijn, zoals de beeldentuin bij museum Kröller-Muller in Hoenderloo ontworpen door J.T.P. Bijhouwer of in een particuliere tuin. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "beeldentuin"@nl;
  skos:hiddenLabel "(beelden)tuin"@nl, "(beelden)tuinen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c2fcf3dc-6efd-4c88-afcf-287b680894ff>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/dc018542-3380-4433-9a19-9afe83d16e32>
  a skos:Concept;
  skos:prefLabel "wachthuizen"@nl;
  skos:scopeNote "Hokjes of huisjes die een schildwacht beschutting geven op zijn post. (AAT-Ned)"@nl,
    "Meestal stenen, en soms versterkt bouwwerk in een vesting, met de functie van blokhuis."@nl;
  skos:altLabel "schildershuisje"@nl, "schildershuisjes"@nl, "schildwachthuisje"@nl,
    "schildwachthuisjes"@nl, "wachthuis"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/49e59c37-0e5d-48b8-a948-7170c8db933c>;
