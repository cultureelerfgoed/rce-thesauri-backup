<https://data.cultureelerfgoed.nl/term/id/cht/936ef9d5-1c2e-4ac2-97d3-81e8cbe94474>
  a skos:Concept;
  skos:prefLabel "castreertangen"@nl;
  skos:scopeNote "Zware (ca. 2-5 kg) tang met lange armen (ca. 30 cm) en een brede bek (ca. 8 cm) met sterk gebogen kaken die gebruikt wordt om stieren te castreren. (MARDOC)"@nl;
  skos:altLabel "castreertang"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/89c4841b-6283-41dc-940f-9e741e8193a6>;
