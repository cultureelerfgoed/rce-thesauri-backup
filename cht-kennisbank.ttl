<https://data.cultureelerfgoed.nl/term/id/cht/f6473257-6a90-4255-bd03-de5ad1c15d7f>
  a skos:Concept;
  skos:prefLabel "standaardkompassen"@nl;
  skos:scopeNote "Kompassen die in de meest gunstige voorwaarden aan boord geplaatst zijn en waarvan de aanwijzingen als de juiste worden aanvaard. (MARDOC)"@nl;
  skos:altLabel "standaardkompas"@nl;
