<https://data.cultureelerfgoed.nl/term/id/cht/a9dbf0b5-1144-452a-ba08-c60ca7bcdb78>
  a skos:Concept;
  skos:prefLabel "waterputten"@nl;
  skos:scopeNote "Waterputten zijn tot op het peil van het grondwater gegraven of geboorde kokers, waaruit water in een ton of emmer kan worden opgehaald. De wand van de putten zijn met steen bemetseld en komen als een lage ring of borstwering boven de grond uit. Een windas of een putgalg of haal met ketting of kabel vergemakkelijkt het water halen. De putten op stads- en burchtpleinen en kloosterhoven waren meestal van een sierlijke windvaan voorzien."@nl;
  skos:altLabel "klokput"@nl, "klokputten"@nl, "waterput"@nl, "waterwinput"@nl, "waterwinputten"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2971af0-cde7-4888-b828-33443f702e7d>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/809b325b-9354-4430-8310-f9a0e04995de>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d0e29771-f37a-445f-ab7a-2df97b2931a4>
  a skos:Concept;
  skos:prefLabel "dokken (plank)"@nl;
  skos:scopeNote "Houten plankje voor dakbedekking, in het bijz. in oostelijk Nederland. (Haslinghuis)"@nl;
