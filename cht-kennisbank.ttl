<https://data.cultureelerfgoed.nl/term/id/cht/ed7cca48-f7e0-4bb0-9893-30b41edc4717>
  a skos:Concept;
  skos:prefLabel "optreden"@nl;
  skos:scopeNote "Optreden zijn de verticale afstanden tussen de bovenzijde van twee opvolgende aantreden van een trap. Doorgaans zijn van een trap alle optreden gelijk, maar de aantreden zijn niet in alle gevallen gelijk."@nl;
  skos:altLabel "optrede"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d6c80a9d-63cd-41d6-adce-9daddf08ebb2>;
