<https://data.cultureelerfgoed.nl/term/id/cht/349d0fdd-657a-4f15-ae5e-c58abcef9fa2>
  a skos:Concept;
  skos:prefLabel "halshouten"@nl;
  skos:scopeNote "Beschot, aangebracht om de bovenas in de voorkeuvelens van een bovenkruier. Dicht de opening zoveel mogelijk waterdicht af. (Haslinghuis)"@nl;
  skos:altLabel "halshout"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/40405e1f-94b1-4ee6-939a-7549e84c8372>;
