<https://data.cultureelerfgoed.nl/term/id/cht/19b958a3-caa0-445a-8334-f0b4ea9326d1>
  a skos:Concept;
  skos:prefLabel "burgerbrieven"@nl;
  skos:scopeNote "Onder de term burgerbrief wordt verstaan: elk schriftelijk stuk dat een overheidsinstantie van een burger ontvangt."@nl;
  skos:altLabel "burgerbrief"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5ca2d7f5-2655-4122-9d9e-0cc10688d0e3>;
