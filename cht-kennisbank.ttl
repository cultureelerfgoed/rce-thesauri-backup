<https://data.cultureelerfgoed.nl/term/id/cht/acd92338-9eb2-47cf-a41d-c9eb364326d3>
  a skos:Concept;
  skos:prefLabel "houtvrij papier"@nl;
  skos:scopeNote "Houtvrij papier is gemaakt van chemische pulp. Omdat delen van het hout verloren gaan bij dit proces, is het een relatief duur papier."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2d28d9aa-77e8-40ab-b0fe-f04d99f57955>;
