<https://data.cultureelerfgoed.nl/term/id/cht/5cfdd4e2-e7fb-4138-baa7-a555426b3356>
  a skos:Concept;
  skos:prefLabel "vormselprenten"@nl;
  skos:scopeNote "Gelegenheidsprent die door tekst, datum en voorstelling herinnert aan het vormsel."@nl;
  skos:altLabel "vormselprent"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26b0d61a-e37a-4912-b516-48884f251bc6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/61180c1e-0604-4ef9-94cf-1acc0b38a400>
  a skos:Concept;
  skos:prefLabel "gelegenheidsprenten"@nl;
  skos:scopeNote "Algemene benaming voor een prent waarvan voorstelling en tekst verwijzen naar een bijzondere aangelegenheid die in glorieuze herinnering wordt herdacht, zoals bijvoorbeeld het vormsel, de eerste H. Communie, de huwelijks-sluiting, een priesterwijding of het vertrek van een religieus of religieuze naar een missiegebied. De prent kan de naam van de gebeurtenis krijgen, zoals vormselprent, missieprent. Niet te verwarren met de gedenkprent die in treurnis gedenkt."@nl;
  skos:altLabel "gelegenheidsprent"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26b0d61a-e37a-4912-b516-48884f251bc6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/63ec2d14-b680-4f2d-b2f8-f28f8ce272a6>
  a skos:Concept;
  skos:prefLabel "bijbelprenten"@nl;
  skos:scopeNote "Prent met een bijbelse voorstelling, veelal voorzien van een korte tekst."@nl;
  skos:altLabel "bijbelprent"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26b0d61a-e37a-4912-b516-48884f251bc6>;
