<https://data.cultureelerfgoed.nl/term/id/cht/9eb9a08e-a3a6-44ad-8387-b5309666d49c>
  a skos:Concept;
  skos:prefLabel "klav"@nl;
  skos:scopeNote "Klav is een versiering op een himation (lang gewaad). Het wordt afgebeeld als een verticale bies op de schouder van Christus of een heilige. (Conservation Dictionary)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/623e7274-a6cb-4133-b9b4-83f0db8d4f01>;
