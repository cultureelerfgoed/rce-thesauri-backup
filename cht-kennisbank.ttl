  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/0c5d0c52-b74e-4544-b20f-166b786f6f9d>
  a skos:Concept;
  skos:prefLabel "houtskooltekeningen"@nl;
  skos:scopeNote "Tweedimensionaal beeldend werk, waarbij de voorstelling is getekend met een staafje houtskool."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/623e7274-a6cb-4133-b9b4-83f0db8d4f01>;
