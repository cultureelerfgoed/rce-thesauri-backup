  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a1cfbaa8-218d-412b-a1e3-d539aedf8cf2>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6a89de30-61e3-464a-978c-947992078f53>
  a skos:Concept;
  skos:prefLabel "zwaardvallen"@nl;
  skos:scopeNote "Het val waarmee het zijzwaard kon worden opgehaald of neergelaten (zie val)."@nl;
