<https://data.cultureelerfgoed.nl/term/id/cht/b4efb0c7-af8f-476d-8193-fc9a4ecf2911>
  a skos:Concept;
  skos:prefLabel "pontonbruggen"@nl;
  skos:scopeNote "Pontonbruggen zijn verend ondersteunde bruggen waarbij de verstijvingsligger wordt ondersteund door pontons. De bruggen hebben vaak een geringe doorvaarhoogte. Pontonbruggen zijn gevoelig voor wind en stromingen van het water. (Typologie van stalen bruggen / H. de Jong , 1996)"@nl;
  skos:altLabel "pontonbrug"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5830cbd3-8bd3-4a4e-9d7c-6f506fd364ae>;
