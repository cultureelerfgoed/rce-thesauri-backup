<https://data.cultureelerfgoed.nl/term/id/cht/35b5629d-3341-4da5-991e-d14ec230b498>
  a skos:Concept;
  skos:prefLabel "Normandische gewelven"@nl;
  skos:scopeNote "Normandische gewelven zijn zesdelig kruisribgewelven. Twee transversale ribben zijn toegevoegd aan de vier kruisribben. Op deze dwarsribben zijn echter alleen muurtjes geslagen die de kruinen van de dwarse gewelfkappen ondersteunen. (Haslinghuis)"@nl;
  skos:altLabel "Normandisch gewelf"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/082d2924-50ea-4295-89b1-a48cc017ab5a>;
