<https://data.cultureelerfgoed.nl/term/id/cht/0d1ae206-bcc9-4735-96ac-d34b5b5bbd84>
  a skos:Concept;
  skos:prefLabel "gedrukte spitsbogen"@nl;
  skos:scopeNote "Gedrukte spitsbogen zijn bogen waarbij de twee trekpunten ongeveer liggen op de punten die de voetlijn in drieën delen.(Haslinghuis)"@nl;
  skos:altLabel "gedrukte spitsboog"@nl;
