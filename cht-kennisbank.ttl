  a skos:Concept;
  skos:prefLabel "tasliggers"@nl;
  skos:scopeNote "Tasliggers zijn dikke rondhouten balken die de tasvloer vormen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
