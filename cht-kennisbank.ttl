  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/723f432e-377b-4d4c-8609-247977b567c5>
  a skos:Concept;
  skos:prefLabel "gedroogde schol"@nl;
  skos:scopeNote "Gedroogde schol is een vorm van geconserveerde vis, waarbij schol wordt gedroogd om de houdbaarheid te verlengen, een traditionele methode die vaak wordt gebruikt in kustgebieden."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/231e97d9-93a7-470c-9213-80e2ff05de5f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6f7a13d3-4ba6-45fc-9c48-3a7b76b051b8>
  a skos:Concept;
  skos:prefLabel "geitenhaar"@nl;
  skos:scopeNote "geitehaar"@nl;
  skos:hiddenLabel "geitehaar"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/071a3a8a-88f0-4c57-b485-d24a5048d477>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a0f7f862-93d2-481e-8598-2f972236a1dc>
  a skos:Concept;
  skos:prefLabel "gemodificeerd zetmeel"@nl;
  skos:scopeNote "Gemodificeerd zetmeel is zetmeel dat chemisch of fysisch is aangepast om specifieke eigenschappen te verkrijgen, zoals verbeterde verdikkingskracht of stabiliteit, veel gebruikt in voedingsmiddelen en industriële toepassingen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dde01956-4aa3-4f71-8ccf-b3a1089119b1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/06b0db30-c867-4094-952f-77c16543d6bf>
  a skos:Concept;
  skos:prefLabel "gerookte paling"@nl;
  skos:scopeNote "Gerookte paling is een voedselproduct waarbij paling is geconserveerd door middel van roken, wat niet alleen de houdbaarheid verlengt, maar ook een karakteristieke rokerige smaak geeft."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/231e97d9-93a7-470c-9213-80e2ff05de5f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/52c97c7f-87a0-488b-b526-4c2e0abc053c>
  a skos:Concept;
  skos:prefLabel "gerookte zalm"@nl;
  skos:scopeNote "Gerookte zalm is een culinair product waarbij zalmfilets worden gerookt om ze te conserveren en een diepere smaak te geven."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/231e97d9-93a7-470c-9213-80e2ff05de5f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/813019dc-f8f1-4ea3-aeb7-962dc5038740>
  a skos:Concept;
  skos:prefLabel "gesulfateerd cement"@nl;
  skos:scopeNote "Gesulfateerd cement is een type cement dat bestand is tegen sulfaatrijke omgevingen, vaak gebruikt in de bouw van funderingen, rioleringen, en andere structuren die blootstaan aan agressieve chemische invloeden."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5edf3ff6-8b94-4892-b1ce-af9a41d5a5b5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f89d4e66-9dac-4e0d-b6a1-9f5958e0dac1>
  a skos:Concept;
  skos:prefLabel "geëmailleerde staalplaten"@nl;
  skos:scopeNote "Geëmailleerde staalplaten zijn staalplaten die zijn bedekt met een glazuurlaag om ze te beschermen tegen corrosie en om een esthetisch aantrekkelijke afwerking te geven, veel gebruikt in architectuur en huishoudelijke apparaten."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2f015793-fc1f-4f76-bed5-1022c2bd15c4>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2a9a5a20-6d87-45d4-ae8e-078e174b7c12>
  a skos:Concept;
  skos:prefLabel "gipssteen"@nl;
  skos:scopeNote "Gipssteen is een afzettingsgesteente dat voornamelijk bestaat uit calciumhydraatsulfaat, en wordt veel gebruikt in de bouw en kunst, onder andere voor het maken van gipsplaten en beeldhouwmateriaal."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fc2fe801-ca2c-4905-b8fb-3aff062b9284>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/329a5283-66cd-40d2-852c-75fc8d3a48b1>,
    <https://data.cultureelerfgoed.nl/term/id/cht/55017c3b-569a-4cae-83a6-2672bf78bda9>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/14abf45d-9956-4ec2-8b86-2de9b003133d>
  a skos:Concept;
  skos:prefLabel "glansijzer"@nl;
  skos:scopeNote "Glansijzer verwijst naar ijzermateriaal dat een hoogglans afwerking heeft, vaak bereikt door polijsten of galvaniseren, gebruikt in decoratieve en functionele toepassingen waar een glanzende, reflecterende afwerking gewenst is."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/5e409755-0001-439b-989f-ea7d776543ab>
  a skos:Concept;
  skos:prefLabel "glasvezel versterkt polyester"@nl;
  skos:scopeNote "Glasvezel versterkt polyester is een composietmateriaal dat bestaat uit polyester versterkt met glasvezels, wat resulteert in een sterk en licht materiaal dat veel wordt gebruikt in de auto-industrie, scheepsbouw en bouw."@nl;
  skos:altLabel "GPR"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f441e935-eea6-4606-9017-ce0b579c91e7>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/7eccdb46-8960-4b50-ab79-cc767ea8b7ae>
  a skos:Concept;
  skos:prefLabel "glasvezelplaten"@nl;
  skos:scopeNote "Glasvezelplaten zijn platen gemaakt van glasvezel, die gebruikt worden als isolatiemateriaal of voor constructieve toepassingen, bekend om hun sterkte en weerstand tegen vuur en vocht."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cd793303-5575-48db-a1c1-8befcb9089c4>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/60c7fc56-437c-456d-8eb3-e16db8967c2a>
  a skos:Concept;
  skos:prefLabel "goudlak"@nl;
  skos:scopeNote "Goudlak is een verf of lak die goudpigmenten bevat, gebruikt om oppervlakken een goudkleurige afwerking te geven, vaak toegepast in decoratieve kunst en meubels."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c86daa7c-4083-4688-bda2-424fc9c1fb0b>
  a skos:Concept;
  skos:prefLabel "graanproducten"@nl;
  skos:scopeNote "Graanproducten omvatten voedingsmiddelen die zijn gemaakt van granen zoals tarwe, maïs, of rijst, en vormen een basisvoedsel in veel culturen, variërend van brood en pasta tot ontbijtgranen."@nl;
  skos:altLabel "graanproduct"@nl;
  skos:hiddenLabel "graanprodukten"@nl, "graanprodukt"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/231e97d9-93a7-470c-9213-80e2ff05de5f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/9f5b7c50-d37a-4d12-a583-e454dc71f64e>
  a skos:Concept;
  skos:prefLabel "gresso"@nl;
  skos:scopeNote "Gresso is een krijtgrond dat wordt gebruikt in kunst en ambacht om een gladde, witte ondergrond te creëren op oppervlakken zoals hout, canvas, of papier, geschikt voor schilderen of vergulden."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ee4d916d-3ec3-4a3e-8a42-1b5d08377fa7>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/9a18ce2d-c3dd-44e4-9542-9f973f7d6c4a>
  a skos:Concept;
  skos:prefLabel "groene pigmenten"@nl;
  skos:scopeNote "Groene pigmenten zijn kleurstoffen die gebruikt worden om materialen een groene kleur te geven, en worden gewonnen uit natuurlijke en synthetische bronnen, veel toegepast in kunst, textiel, en bouwmaterialen."@nl;
  skos:altLabel "groene pigment"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2d4ff601-9025-4667-811d-a4fe8da87b4d>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/24566d21-47b9-4676-94c8-1349fdd0be95>,
    <https://data.cultureelerfgoed.nl/term/id/cht/f17aaf4b-2264-458d-a00f-4bd17d0b3aaf>,
    <https://data.cultureelerfgoed.nl/term/id/cht/71c9a4c6-6b83-412b-9f5e-6549c8fe30af>,
    <https://data.cultureelerfgoed.nl/term/id/cht/f8c65616-199f-48d9-ac94-690beb7f1531>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c865f315-291a-4713-b883-93ca994f5b23>
  a skos:Concept;
  skos:prefLabel "groene pâte"@nl;
  skos:scopeNote "Groene pâte is een specifieke soort pâte, een gemengd en gekneed materiaal, dat door zijn groene kleur vooral wordt gebruikt in decoratieve toepassingen in de keramiek en glasindustrie."@nl;
  skos:hiddenLabel "groene pate"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/176101d5-3254-4f0e-a452-0fc50a16ae8d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b305e1ea-a11d-429f-a0b1-a09cc04ec8ca>
  a skos:Concept;
  skos:prefLabel "guttlegom"@nl;
  skos:scopeNote "Guttlegom is een hars die afkomstig is van de Guttaperchaboom, en wordt vaak gebruikt als een natuurlijk pigment en verdikkingsmiddel in verven en inkten vanwege zijn kleefkracht en duurzame eigenschappen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/014237aa-5381-4dbe-8818-8d15931b3a34>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/136581fe-fd56-4493-b71a-1ccaac0b7c63>
  a skos:Concept;
  skos:prefLabel "hotelporselein"@nl;
  skos:scopeNote "Hotelporselein is een type aardewerk dat speciaal is ontworpen voor gebruik in de horeca, met name in hotels en restaurants. Het staat bekend om zijn hoge duurzaamheid, stootbestendigheid en vaak eenvoudige maar elegante ontwerpen die geschikt zijn voor intensief dagelijks gebruik."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dfbf8107-09f9-49c9-8118-8e79b7613723>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/11c4a3ac-d478-470b-94a1-208ad53bf32d>
  a skos:Concept;
  skos:prefLabel "kerfsneewerk"@nl;
  skos:scopeNote "Kerfsneewerk is een vorm van aardewerk waarbij decoratieve patronen worden gecreëerd door in het oppervlak van de klei te snijden of te kerven voordat het stuk wordt gebakken."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dfbf8107-09f9-49c9-8118-8e79b7613723>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d3653576-5e2c-4320-addc-64cc220eb33f>
  a skos:Concept;
  skos:prefLabel "loodglazuuraardewerk"@nl;
  skos:scopeNote "Loodglazuuraardewerk is aardewerk dat is afgewerkt met een glazuur op basis van lood. Dit glazuur geeft een glanzende, vaak transparante afwerking die de natuurlijke kleur van de klei benadrukt. Hoewel het esthetisch aantrekkelijk is, kan het gebruik van lood in glazuren gezondheidsrisico's met zich meebrengen als het niet correct wordt verwerkt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dfbf8107-09f9-49c9-8118-8e79b7613723>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a4a64843-1a0a-4c70-add7-3e398106fa95>
  a skos:Concept;
  skos:prefLabel "pijpaardewerk"@nl;
  skos:scopeNote "Pijpaardewerk is een gespecialiseerd type aardewerk dat wordt gebruikt voor het vervaardigen van rookpijpen, met name traditionele kleipijpen. Het materiaal is gekozen vanwege zijn fijne structuur, hittebestendigheid en het vermogen om delicate details te behouden tijdens het productieproces."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dfbf8107-09f9-49c9-8118-8e79b7613723>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/145ce647-6d6c-485b-b021-d58cf27f41dc>
  a skos:Concept;
  skos:prefLabel "potgruis"@nl;
  skos:scopeNote "Potgruis is gemalen of verbrijzeld aardewerk of keramiek dat wordt toegevoegd aan verse klei als chamotte. Deze toevoeging verhoogt de sterkte van het uiteindelijke keramische product en vermindert krimp en vervorming tijdens het droog- en bakproces, wat resulteert in duurzamere stukken."@nl;
  skos:altLabel "aardewerkgruis"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dfbf8107-09f9-49c9-8118-8e79b7613723>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e79ecee5-2e6a-45ca-a15a-8b26cb8bde33>
  a skos:Concept;
  skos:prefLabel "tinglazuuraardewerk"@nl;
  skos:scopeNote "Tinglazuuraardewerk is aardewerk bedekt met een ondoorzichtig, wit tin-glazuur dat dient als ideale achtergrond voor kleurrijke decoraties. Deze techniek, bekend van tradities zoals Delfts blauw en Majolica, geeft het aardewerk een helder en levendig uiterlijk en beschermt tegelijkertijd het onderliggende materiaal."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dfbf8107-09f9-49c9-8118-8e79b7613723>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/5faf1e79-1828-466c-a841-b0ce7d50bac7>
  a skos:Concept;
  skos:prefLabel "Terra Sigillata"@nl;
  skos:scopeNote "Terra Sigillata is Romeins aardewerk, overwegend glanzend rood en vaak voorzien van reliefdecoratie. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dfbf8107-09f9-49c9-8118-8e79b7613723>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c57a23c6-92ef-4063-9dc0-e92393931988>
  a skos:Concept;
  skos:prefLabel "keien"@nl;
  skos:scopeNote "Keien zijn grove afzettingsgesteenten die gevormd worden door natuurlijke erosieprocessen. Ze worden vaak aangetroffen in rivieren en op stranden, waar ze zijn gladgeslepen door stromend water. Keien worden vaak gebruikt in landschapsarchitectuur en bouwprojecten."@nl;
  skos:altLabel "kei"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fc2fe801-ca2c-4905-b8fb-3aff062b9284>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/7a84b026-b418-4460-82cf-1564484b1464>
  a skos:Concept;
  skos:prefLabel "kiezelgeode"@nl;
  skos:scopeNote "Een kiezelgeode is een bolvormige of ovale holte in een afzettingsgesteente, die is gevuld met kristallen van kwarts of chalcedoon. Deze geodes ontstaan door vulkanische of sedimentaire processen en worden gewaardeerd om hun esthetische en geologische waarde."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fc2fe801-ca2c-4905-b8fb-3aff062b9284>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/0d4383e9-2084-4fd9-acf4-45d5997e8fd5>
  a skos:Concept;
  skos:prefLabel "molersteen"@nl;
  skos:scopeNote "Molersteen is een specifiek type baksteen, vaak gebruikt in de bouw, dat bekend staat om zijn lichte gewicht en isolerende eigenschappen. Het wordt gemaakt van moler, een soort klei vermengd met vulkanisch as, en is bijzonder geschikt voor hittebestendige toepassingen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bbe4a82c-d0af-42c9-86c2-cca2e9560bac>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/456591ce-db36-43d1-b0fe-fee6232fdb64>
  a skos:Concept;
  skos:prefLabel "splitszijde"@nl;
  skos:scopeNote "Splitszijde is een fijn borduurgaren, vaak gebruikt voor gedetailleerd handwerk en borduurwerk. Het garen is samengesteld uit meerdere dunne draden die gemakkelijk gesplitst kunnen worden voor het maken van fijne, delicate steken."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/68c0a74d-930d-4178-87b1-19b2a52628d7>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/baf9c6c8-9804-41c9-a5c9-d9d9747406b4>
  a skos:Concept;
  skos:prefLabel "natuurrubber"@nl;
  skos:scopeNote "Natuurrubber is een elastomeer dat wordt gewonnen uit het sap van rubberbomen (latex). Het wordt gebruikt voor een verscheidenheid aan producten, zoals banden, handschoenen, en elastische banden, vanwege zijn hoge elasticiteit en waterdichte eigenschappen."@nl;
  skos:altLabel "natuurrubber (natuurlijk isopreenrubber (ir))"@nl, "NR"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9834c5a3-66d2-4d2d-aa64-789ff13dde5e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/49fdf332-ab87-437c-bdda-49b5fac40a0d>
  a skos:Concept;
  skos:prefLabel "styreen ethyleen butadieen styreen"@nl;
  skos:scopeNote "Styreen ethyleen butadieen styreen (SEBS) is een thermoplastisch elastomeer dat bekend staat om zijn flexibiliteit, slagvastheid en weerstand tegen slijtage. Het wordt vaak gebruikt in toepassingen zoals speelgoed, huishoudelijke artikelen en pakkingen."@nl;
  skos:altLabel "SEBS"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9834c5a3-66d2-4d2d-aa64-789ff13dde5e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/576d21b6-fb6a-4ed1-a1d6-43edaf0194d6>
  a skos:Concept;
  skos:prefLabel "styreenbutadieen rubber"@nl;
  skos:scopeNote "Styreenbutadieen rubber (SBR) is een synthetisch elastomeer dat wordt gebruikt in de productie van banden, schoenzolen en andere rubberproducten. Het biedt een goede balans tussen slijtvastheid en elasticiteit, waardoor het zeer veelzijdig is."@nl;
  skos:altLabel "SBR"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9834c5a3-66d2-4d2d-aa64-789ff13dde5e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/00b05612-e530-4a88-9df0-921271e33add>
  a skos:Concept;
  skos:prefLabel "vogeloogesdoornhout"@nl;
  skos:scopeNote "Vogeloogesdoornhout is een bijzondere variëteit van esdoornhout, gekenmerkt door kleine, ronde \"vogeloog\" patronen in het hout. Dit hout wordt zeer gewaardeerd in meubelmakerij en decoratieve houtbewerking vanwege zijn unieke esthetische eigenschappen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/418a1262-a411-427b-8563-9759f9b797f1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ca8d8feb-2547-423e-8403-1d40b2cfce73>
  a skos:Concept;
  skos:prefLabel "keperflanel"@nl;
  skos:scopeNote "Keperflanel is een type flanel dat wordt gekenmerkt door zijn diagonale keperbinding, wat zorgt voor extra sterkte en duurzaamheid. Het wordt vaak gebruikt voor warme kledingstukken en beddengoed vanwege zijn zachtheid en isolerende eigenschappen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0bb6eb95-d110-4cc0-81b5-539f402bdd91>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f6d5dbc2-a7f8-46aa-bcc6-4b50d04653f5>
  a skos:Concept;
  skos:prefLabel "tufnol"@nl;
  skos:scopeNote "Tufnol is een gewapende kunststof, gemaakt door het impregneren van lagen stof of papier met fenolhars. Het is sterk, licht en bestand tegen chemicaliën, waardoor het geschikt is voor mechanische onderdelen en isolatiemateriaal."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7b022197-9bbc-49af-b27d-3eb40bbc7a70>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6d6bbfea-9672-402c-b6e0-fa664e288103>
  a skos:Concept;
  skos:prefLabel "raqon de venise"@nl;
  skos:scopeNote "Raqon de Venise is een speciaal soort glas dat zijn oorsprong vindt in Venetië, beroemd om zijn helderheid en delicate decoratieve technieken. Dit glas wordt vaak gebruikt in kunstzinnige toepassingen zoals sieraden en luxe serviesgoed."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dcc2121b-8394-44f7-9664-86b109d079a4>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/aef8c8f8-8c00-4f5e-94a4-660f2bfb37a6>
  a skos:Concept;
  skos:prefLabel "terpaarde"@nl;
  skos:scopeNote "Terpaarde is grond afkomstig van de Friese terpen. Terpaarde werd gebruikt om de kwaliteit van landbouwgrond te verbeteren. Tot ca. 1930 werden hiervoor diverse Friese terpen afgegraven. De meeste grond werd per schip afgevoerd."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa048756-99b0-4569-9ab3-34fff12243dc>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/737000da-c37b-42ea-a501-3318b67de4e9>
  a skos:Concept;
  skos:prefLabel "runderhaar"@nl;
  skos:scopeNote "Runderhaar is een vezel die afkomstig is van runderen en wordt gebruikt in verschillende industriële en ambachtelijke toepassingen, zoals in borstels en als versteviging in pleisterwerk."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/071a3a8a-88f0-4c57-b485-d24a5048d477>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/1b9102e1-29aa-45de-8273-6835012b28aa>
  a skos:Concept;
  skos:prefLabel "koeienhaar"@nl;
  skos:scopeNote "Koeienhaar, een type haarvezel, wordt gewonnen van koeien en wordt gebruikt voor diverse doeleinden, waaronder in de textielindustrie en als versteviging in gips en pleisterwerk."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/071a3a8a-88f0-4c57-b485-d24a5048d477>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/071a3a8a-88f0-4c57-b485-d24a5048d477>
  a skos:Concept;
  skos:prefLabel "haarvezels"@nl;
  skos:scopeNote "Een haarvezel is een eiwitvezel van keratine die hoofdzakelijk wordt verkregen van angora- en kasjmiergeiten, kamelen, alpaca's en pelsdieren. Haarvezels worden gebruikt voor het maken van textiel en voorwerpen."@nl;
  skos:altLabel "haarvezel"@nl, "haarzijde (vezel)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2b3abca2-0b5b-4a9c-8b63-ff1ee30e0610>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/6f7a13d3-4ba6-45fc-9c48-3a7b76b051b8>,
    <https://data.cultureelerfgoed.nl/term/id/cht/737000da-c37b-42ea-a501-3318b67de4e9>,
    <https://data.cultureelerfgoed.nl/term/id/cht/1b9102e1-29aa-45de-8273-6835012b28aa>,
    <https://data.cultureelerfgoed.nl/term/id/cht/e46ab4e4-84f6-4024-be59-62db0b8dc70b>,
    <https://data.cultureelerfgoed.nl/term/id/cht/2c2cd90a-95eb-4754-9a14-84bc394aebdc>,
    <https://data.cultureelerfgoed.nl/term/id/cht/5cbcaf5b-e3e7-458d-98b4-62777fdcab3f>,
    <https://data.cultureelerfgoed.nl/term/id/cht/9dcf7fcf-a5b0-401f-80bb-64e19b705842>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e46ab4e4-84f6-4024-be59-62db0b8dc70b>
  a skos:Concept;
  skos:prefLabel "varkenshaar"@nl;
  skos:scopeNote "Varkenshaar is een type haarvezel afkomstig van varkens, vaak gebruikt voor het maken van stevige borstels en kwasten vanwege zijn stugheid en veerkracht."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/071a3a8a-88f0-4c57-b485-d24a5048d477>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e4ee2140-999d-42e2-bc6c-490329c4a20c>
  a skos:Concept;
  skos:prefLabel "kauri gom"@nl;
  skos:scopeNote "Kauri gom is een hars afkomstig van de Kauriboom, vooral in Nieuw-Zeeland. Deze hars wordt gebruikt in de vernisindustrie en als grondstof voor lakken en lijmen vanwege zijn uitstekende kleef- en beschermende eigenschappen."@nl;
  skos:altLabel "kaurigom"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/014237aa-5381-4dbe-8818-8d15931b3a34>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ba8e4eff-0233-4f93-bd06-d69aeb887171>
  a skos:Concept;
  skos:prefLabel "houtimitatiestalen"@nl;
  skos:scopeNote "Houtimitatiestalen zijn staalplaten of andere metalen die zijn behandeld om eruit te zien als hout. Ze worden vaak gebruikt in architectonische toepassingen waar de esthetiek van hout gewenst is, maar de sterkte en duurzaamheid van staal noodzakelijk zijn."@nl;
  skos:altLabel "houtimitatiestaal"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/71d4bca2-5e6b-4274-a499-b049b83ab052>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/95961b6c-9974-43fe-b915-5aac8b041923>
  a skos:Concept;
  skos:prefLabel "mazoniet"@nl;
  skos:scopeNote "Mazoniet is een houtachtig plaatmateriaal dat vaak wordt gebruikt als ondergrond voor fineerwerk of andere afwerkingen. Het staat bekend om zijn sterkte en stabiliteit, wat het geschikt maakt voor diverse meubel- en interieurtoepassingen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/8caf5937-3be9-472a-86ad-0602ce4018ce>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/64f89932-732c-4d86-a09a-0782f7457c2e>
  a skos:Concept;
  skos:prefLabel "wortelhout (hout)"@nl;
  skos:scopeNote "Wortelhout is een kostbare houtsoort die afkomstig is van de wortels van bomen, vaak met een uniek, grillig patroon. Het wordt gebruikt voor hoogwaardige meubels, fineer en luxe interieurdecoraties."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/63948684-1a2a-4042-8d84-85e56278b063>
  a skos:Concept;
  skos:prefLabel "kabbeshout"@nl;
  skos:scopeNote "Kabbeshout is een houtsoort die wordt gewaardeerd om zijn hardheid en duurzaamheid. Het wordt vaak gebruikt in bouwconstructies en meubelproductie, vooral in gebieden waar de boomsoort inheems is."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2933cc57-a236-410a-8c0c-e53127f85e83>
  a skos:Concept;
  skos:prefLabel "kajapoet"@nl;
  skos:scopeNote "Kajapoet is een tropische houtsoort afkomstig uit Zuidoost-Azië. Het hout is bekend om zijn sterkte en weerstand tegen rot, waardoor het geschikt is voor buitentoepassingen zoals scheepsbouw en buitenmeubels."@nl;
  skos:altLabel "kajapoethout"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/40caed4c-2bca-44e4-b165-390305a8e2b5>
  a skos:Concept;
  skos:prefLabel "kokospalm"@nl;
  skos:scopeNote "Kokospalmhout is een bijproduct van kokospalmbomen, vaak gebruikt voor decoratieve toepassingen en meubels. Het heeft een unieke vezelachtige structuur en wordt steeds populairder als een duurzaam bouwmateriaal."@nl;
  skos:altLabel "kokospalmen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/62ee20ca-d1cb-4e12-b5a4-3d3653da362e>
  a skos:Concept;
  skos:prefLabel "manouhout"@nl;
  skos:scopeNote "Manouhout, ook wel bekend als rattan, is een buigzaam houtmateriaal dat vaak wordt gebruikt voor het maken van meubels en manden. Het staat bekend om zijn flexibiliteit en lichte gewicht."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/533cc495-af81-49e1-b8da-370d04a0297e>
  a skos:Concept;
  skos:prefLabel "pijnboomhout"@nl;
  skos:scopeNote "Pijnboomhout is een veelgebruikte naaldhoutsoort, bekend om zijn rechte nerf en gemakkelijke bewerkbaarheid. Het wordt veel toegepast in de bouw, meubelproductie en als timmerhout voor diverse binnen- en buitentoepassingen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8c7b990a-d0fc-49c0-9f6e-2f106ca3e9d3>
  a skos:Concept;
  skos:prefLabel "plakhout"@nl;
  skos:scopeNote "Plakhout is een verzamelnaam voor dunne lagen hout die op elkaar zijn gelijmd om een sterke, duurzame plaat te vormen. Het wordt vaak gebruikt in de meubelindustrie en voor decoratieve afwerkingen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d77bfa3b-1e03-43fd-9919-511bb375ac28>
  a skos:Concept;
  skos:prefLabel "raminhout"@nl;
  skos:scopeNote "Raminhout is een tropische houtsoort, afkomstig uit Zuidoost-Azië, gewaardeerd om zijn fijne textuur en lichte kleur. Het wordt vaak gebruikt voor de productie van meubels, lijsten en speelgoed."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/cc5f9f1c-bd14-46a2-b212-37a0d46459f3>
  a skos:Concept;
  skos:prefLabel "stinkhout"@nl;
  skos:scopeNote "Stinkhout, ook bekend als Ocotea bullata, is een zeldzame houtsoort die voornamelijk voorkomt in Zuid-Afrika. Het staat bekend om zijn sterke geur en wordt vaak gebruikt in de meubelmakerij en houtbewerking."@nl;
  skos:altLabel "Zuid-Afrikaans stinkhout"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/65afd301-040e-44c8-afe3-93bca1a1572d>
  a skos:Concept;
  skos:prefLabel "thujahout"@nl;
  skos:scopeNote "Thujahout is afkomstig van de levensboom (Thuja), een conifeer die bekend staat om zijn weerbestendigheid en aromatische geur. Het hout wordt vaak gebruikt voor buitenbekleding, hekken en decoratieve toepassingen."@nl;
  skos:altLabel "thuyahout"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d6817ed0-a968-4ca9-8abb-4c2e5667afed>
  a skos:Concept;
  skos:prefLabel "tropisch hout"@nl;
  skos:scopeNote "Tropisch hout is een algemene term voor houtsoorten die afkomstig zijn uit tropische regenwouden. Deze houtsoorten worden gewaardeerd om hun duurzaamheid, hardheid en vaak exotische uitstraling, en worden gebruikt in meubelproductie en bouwconstructies."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e27f742d-44ba-46c5-ba5f-632b1db92520>
  a skos:Concept;
  skos:prefLabel "vlierhout"@nl;
  skos:scopeNote "Vlierhout is een zachte houtsoort afkomstig van de vlierboom, vaak gebruikt voor handgereedschap, muziekinstrumenten en kleine ambachtelijke voorwerpen. Het hout is licht en gemakkelijk te bewerken."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f0c68500-beeb-4f4e-b62f-31d2a5c30287>
  a skos:Concept;
  skos:prefLabel "kalkspecie"@nl;
  skos:scopeNote "Kalkspecie is een mengsel van kalk, zand en water, gebruikt als bindmiddel in de bouw voor het metselen en voegen van bakstenen of natuursteen. Dit materiaal staat bekend om zijn ademende eigenschappen en wordt vaak gebruikt in restauratiewerkzaamheden."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/52021650-7fbc-44b0-b857-38cf83fad6a4>
  a skos:Concept;
  skos:prefLabel "kleiproducten"@nl;
  skos:scopeNote "Kleiproducten zijn materialen die zijn vervaardigd uit klei, zoals aardewerk, bakstenen en tegels. Deze producten worden gevormd door de klei te bakken, wat resulteert in een hard, duurzaam materiaal dat veel wordt gebruikt in de bouw en kunstnijverheid."@nl;
  skos:altLabel "kleiproduct"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ee4d916d-3ec3-4a3e-8a42-1b5d08377fa7>
  a skos:Concept;
  skos:prefLabel "krijtgrond"@nl;
  skos:scopeNote "Krijtgrond is een grondsoort die rijk is aan kalksteen en wordt vaak gebruikt als ondergrond voor kunstwerken of als afwerkingslaag in de schilderkunst. Het materiaal biedt een glad oppervlak en is geschikt voor verschillende schildertechnieken."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/9f5b7c50-d37a-4d12-a583-e454dc71f64e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6a719957-71a1-4843-aedf-283ba1e9bebc>
  a skos:Concept;
  skos:prefLabel "kruidenierswaren"@nl;
  skos:scopeNote "Kruidenierswaren zijn consumptiegoederen die worden verkocht in een kruidenierswinkel, waaronder voedingsmiddelen, specerijen, en huishoudelijke producten. Ze omvatten een breed scala aan dagelijkse benodigdheden."@nl;
  skos:altLabel "kruidenierswaar"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/77006ff8-015f-45e1-be80-b1f551b8c654>
  a skos:Concept;
  skos:prefLabel "leidekking"@nl;
  skos:scopeNote "Leidekking verwijst naar het gebruik van leisteen als dakbedekking. Dit materiaal is duurzaam, waterdicht en wordt vaak gebruikt in historische en hedendaagse architectuur vanwege zijn esthetische en beschermende eigenschappen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e63c82e0-070c-409f-85a7-37ee5a2c107a>
  a skos:Concept;
  skos:prefLabel "papierlak"@nl;
  skos:scopeNote "Papierlak is een beschermende coating die wordt aangebracht op papier of karton om het oppervlak te beschermen tegen vocht, vuil en slijtage. Het wordt veel gebruikt in de productie van verpakkingsmateriaal en decoratieve objecten."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/79a3c2cb-a3ed-493a-865d-6da68c845f89>
  a skos:Concept;
  skos:prefLabel "petroleumproduct"@nl;
  skos:scopeNote "Petroleumproducten zijn stoffen die zijn afgeleid van ruwe olie, zoals benzine, diesel, en smeermiddelen. Deze producten zijn essentieel voor de energieproductie, transport en diverse industriële processen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/1208677a-b5f1-43bb-b904-17a01d02e8f3>,
    <https://data.cultureelerfgoed.nl/term/id/cht/836c881a-101d-4fb9-8361-15f8fa21fcd3>,
    <https://data.cultureelerfgoed.nl/term/id/cht/06ded5f4-b139-42cf-bd87-ebaef8754148>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d4b495e6-c842-428a-ab14-7f818b1efa66>
  a skos:Concept;
  skos:prefLabel "asfalt"@nl;
  skos:scopeNote "Asfalt is de benaming voor producten die samengesteld zijn uit asfaltbitumen en minerale stoffen zoals basaltsplit. Het gaat hier dus om mengsels ofwel samengestelde producten."@nl;
  skos:altLabel "bitumen"@nl, "bitumina"@nl, "bitumineus materiaal"@nl, "bitumineuze materialen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a84ab8b6-24c6-493d-939d-102bb982bd91>;
