<https://data.cultureelerfgoed.nl/term/id/cht/dfa28efc-be95-41f7-b3e0-b54711aca992>
  a skos:Concept;
  skos:prefLabel "jakobsladders"@nl;
  skos:scopeNote "Jacobsladders zijn hellende transportbanden bedoeld om goederen mee omhoog te transporteren. Op jakobsladders zitten richels, schotten, bakjes of pinnen om te voorkomen dat de goederen terugrollen. (Rijksdienst voor het Cultureelerfgoed)"@nl;
  skos:altLabel "jakobsladder"@nl;
