<https://data.cultureelerfgoed.nl/term/id/cht/129aa0a5-6c0f-48b9-8612-624a0bb33536>
  a skos:Concept;
  skos:prefLabel "herinrichting"@nl;
  skos:scopeNote "Herinrichting is het stelselmatig plannen op zowel stedenbouwkundig, sociaal, economisch, cultureel en milieuhygiënisch terrein. Gericht op behoud, herstel en verbetering, herindeling of sanering van bebouwde gedeelten van het gemeentelijk grondgebied. (Woorden-Boek.nl)"@nl;
  skos:altLabel "herinrichten"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/190b9fce-fb0d-4b41-b46d-e1795ae38304>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/9d088bdb-82c2-4f06-b201-eb0ba9e0dbcc>
  a skos:Concept;
  skos:prefLabel "eerste hulp"@nl;
  skos:scopeNote "Een object of gebouw krijgt eerste hulp als het een spoedbehandeling krijgt om verder verval te voorkomen. Deze vindt meestal in situ plaats en voordat tot een volledige behandeling wordt overgegaan."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/190b9fce-fb0d-4b41-b46d-e1795ae38304>;
