<https://data.cultureelerfgoed.nl/term/id/cht/41971df1-7024-4a5d-b42c-42ce31044d22>
  a skos:Concept;
  skos:prefLabel "parleersders"@nl;
  skos:scopeNote "Ondermeester in een bouwloods. Veelzeggend is de naam van de architectenfamilie der Parlers (XIV, in Schwäbisch Gmünd, Bazel, Keulen en Praag). (Haslinghuis)"@nl;
  skos:altLabel "parleerder"@nl;
