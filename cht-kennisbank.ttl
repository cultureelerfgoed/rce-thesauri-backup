<https://data.cultureelerfgoed.nl/term/id/cht/b778334f-ca13-4589-98a6-a24eb517ad2b>
  a skos:Concept;
  skos:prefLabel "barometers"@nl;
  skos:scopeNote "Barometers zijn instrumenten waarmee de luchtdruk gemeten kan worden. De luchtdruk is bepalend voor wat voor weer het wordt. Bij een relatief hoge luchtdruk kan mooi weer worden verwacht; bij een lage luchtdruk bewolking en regen. Er zijn verschillende types barometers, in uiteenlopende uitvoeringen ontwikkeld. Op een enkele openbare plaats staat een buitenexemplaar opgesteld. (Wikipedia)"@nl;
  skos:altLabel "barometer"@nl, "luchtdrukmeter"@nl, "luchtdrukmeters"@nl, "manometer"@nl,
    "manometers"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/36963dcd-7f11-4902-8e8e-91eb92ad8ffd>;
