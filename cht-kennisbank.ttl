<https://data.cultureelerfgoed.nl/term/id/cht/8fab01bc-7b86-4a99-a10d-6d19319335bb>
  a skos:Concept;
  skos:prefLabel "dieselrijtuigen"@nl;
  skos:scopeNote "Een dieselrijtuig is een rijtuig, dat zelfstandig wordt aangedreven door middel van een dieselmotor. (Nationaal Register Mobiel Erfgoed)"@nl;
  skos:altLabel "dieselrijtuig"@nl;
