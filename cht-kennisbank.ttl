<https://data.cultureelerfgoed.nl/term/id/cht/f7250050-b2fc-4867-8c53-e6dcdf829a3d>
  a skos:Concept;
  skos:prefLabel "kruitouwen"@nl;
  skos:scopeNote "Bij binnenkruiers. Zit met het vaste eind onder aan de buitenste kruipol vast. Het andere eind loopt via het kruiblok naar de munnik. (Molenwoordenboek B.D. Poppen)"@nl;
  skos:altLabel "kruireep"@nl, "kruirepen"@nl, "kruitouw"@nl;
