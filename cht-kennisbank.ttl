<https://data.cultureelerfgoed.nl/term/id/cht/3c55fe24-6bf2-4999-9baa-85f8821fb215>
  a skos:Concept;
  skos:prefLabel "jaloezieën"@nl;
  skos:scopeNote "Jaloezieën zijn klassieke zonweringen die bestaan uit beweegbare schoepen van latwerk of ander materiaal. De schoepen sluiten dicht op elkaar aan in tegenstelling tot schermlatten. Zowel binnen als buiten zijn zij toegepast. Door een ingenieus systeem kon de stand van de schoepen worden aangepast. Met behulp van bandoprollers kunnen de jaloezieën verticaal opgehaald of neergelaten worden. Ze komen in de 19de eeuw in ons land op, alhoewel ze in de 18de eeuw in het buitenland al werden toegepast."@nl;
  skos:altLabel "Persiennes Hollandaises"@nl, "Venetian blinds"@nl, "jaloezie"@nl, "jalousie"@nl,
    "jalousieën"@nl, "jalouzie"@nl, "jalouzieën"@nl, "trekjaloezie"@nl, "trekjaloezieën"@nl,
    "zonneblind"@nl, "zonneblinden"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7f2c26e8-ee43-48d1-9797-c2e812a95a47>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3c5b2594-c8bf-4467-ad38-c3e58006b79d>
