<https://data.cultureelerfgoed.nl/term/id/cht/1c301be5-fdef-48d9-a69e-a10f085381f8>
  a skos:Concept;
  skos:prefLabel "zwaardscheden"@nl;
  skos:scopeNote "Een (zwaard)schede is een uitrustingsstuk waarin een zwaardachtig wapen (mes, dolk, degen, zwaard etc.) of bijl wordt opgeslagen ter bescherming van het wapen en van de gebruiker. De schede wordt meestal van hout of leer gemaakt en kan op de rug alsook aan een riem op de zij worden gehangen zodat het zwaard meteen gebruiksklaar is."@nl;
  skos:altLabel "zwaardschede"@nl;
  skos:hiddenLabel "zwaardschedes"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cfa994ca-40d5-41ba-b994-61157df89ac8>;
