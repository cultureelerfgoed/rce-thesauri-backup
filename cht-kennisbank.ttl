<https://data.cultureelerfgoed.nl/term/id/cht/b321e490-88a0-439d-939f-3923128f478a>
  a skos:Concept;
  skos:prefLabel "klankborden"@nl;
  skos:scopeNote "Het klankbord boven de preekstoel spreidt en weerkaatst het stemgeluid van de spreker."@nl;
  skos:altLabel "klankbord"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/abfc1bb7-04d7-43a0-9e99-dd4c5a4f2c15>;
