  a skos:Concept;
  skos:prefLabel "ventilatorriemen"@nl;
  skos:scopeNote "Riem, die gebruikt wordt voor de aandrijving van de ventilator, soms samen met de waterpomp en de dynamo, vanaf een poelie op de krukas. De doorsnede van de riem is meestal V-vormig."@nl;
  skos:altLabel "v-riem"@nl, "ventilatorriem"@nl;
