  a skos:Concept;
  skos:prefLabel "berapen"@nl;
  skos:scopeNote "Een muur bedekken met een laag mortel, een mengsel van kalk, zand en ev. enig cement en deze (al of niet ‘onder de rij’) effen schuren. Ook: rapen, volrapen. Vgl. bewerpen, vertinnen, (be)pleisteren. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
