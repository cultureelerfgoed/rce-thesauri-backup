<https://data.cultureelerfgoed.nl/term/id/cht/461e7b56-3c96-4ace-a9ac-943ca19b1b85>
  a skos:Concept;
  skos:prefLabel "hefwerktuigonderdelen"@nl;
  skos:scopeNote "Onderdelen van een werktuig om lasten stuk voor stuk op te lichten en al of niet ook over een kleine afstand te verplaatsen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b11f6c4a-9652-41d8-8a53-411ec8e2f946>;
