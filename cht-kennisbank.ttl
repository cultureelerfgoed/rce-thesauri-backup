<https://data.cultureelerfgoed.nl/term/id/cht/d9dfac57-05fd-43a8-93a3-d2a679f8500f>
  a skos:Concept;
  skos:prefLabel "operatiekamers"@nl;
  skos:scopeNote "Operatiekamers zijn vertrekken in ziekenhuizen waar operaties uitgevoerd worden. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
