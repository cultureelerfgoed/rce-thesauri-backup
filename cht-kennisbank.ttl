<https://data.cultureelerfgoed.nl/term/id/cht/a00a55b3-dce3-474e-aa53-a85954dbbd23>
  a skos:Concept;
  skos:prefLabel "eesten (bouwwerk)"@nl;
  skos:scopeNote "Agrarische gebouwen, uitgerust met een eest voor het drogen van hop, gewoonlijk cirkelvormig met een kegelvormig dak, veel aangetroffen in het graafschap Kent (Engeland). (AAT-Ned)"@nl;
  skos:altLabel "asten"@nl, "ast"@nl, "eest (bouwwerk)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6f0bc443-b971-4a43-9cae-91f93d1b29d1>;
