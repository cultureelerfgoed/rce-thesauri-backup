<https://data.cultureelerfgoed.nl/term/id/cht/8ac2d20a-46ae-451a-91fa-f0bbd3cad914>
  a skos:Concept;
  skos:prefLabel "tootbogen"@nl;
  skos:scopeNote "Een met toten versierde boog. Komt in de laatromaanse periode na 1200 voor o.a. in de voorhal van de St.-Andreaskerk te Keulen en op de bovenverdieping van de dubbelkapel in het slot Neuenburg (Saksen-Anhalt). Beide voorbeelden wekken de indruk dat deze vorm ontstaan is o.i.v. de Moorse architectuur. In de late gotiek is het motief als ornament toegepast, b.v. in de Oude Kerk te Amsterdam aan de steunberen van de St.-Sebastiaanskapel (1515) en in het Heilig Graf. (Haslinghuis)"@nl;
  skos:altLabel "tootboog"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/42f94d21-f2a3-40e2-bf34-cc9e17ddaaaa>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/ec8d5e94-4f49-4cd0-8062-6459cda3ba36>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/783f37fd-8a45-4379-87ee-10d8649b1c80>
  a skos:Concept;
  skos:prefLabel "ijkkantoren"@nl;
  skos:scopeNote "IJkkantoren zijn gebouwen waar de ijkmeester gevestigd was."@nl;
