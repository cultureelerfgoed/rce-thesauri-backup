<https://data.cultureelerfgoed.nl/term/id/cht/3e8dc050-c866-47c3-a19e-3cf7ff121ac7>
  a skos:Concept;
  skos:prefLabel "scheepslantaarns"@nl;
  skos:scopeNote "Oude, algemene benaming voor een navigatielicht (waarbij het licht opgewekt wordt met behulp van een vlam). (www.debinnenvaart.nl)"@nl;
  skos:altLabel "scheepslantaarn"@nl;
