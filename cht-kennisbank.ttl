<https://data.cultureelerfgoed.nl/term/id/cht/17f4ba51-2d9f-46d3-930b-6626bc9f0919>
  a skos:Concept;
  skos:prefLabel "Oldendorf-randbijlen"@nl;
  skos:scopeNote "De randbijl, ook randlijstbijl of flensbijl, is een type bijl uit met name de Vroege en Midden-Bronstijd in Midden- en West-Europa. De Oldendorfversie is in de nabijheid van Oldendorf (Dld.) aangetroffen."@nl;
  skos:altLabel "Oldendorf-randbijl"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5f7b8500-d351-498c-ace7-c4163719265c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/0f169646-2ce9-402f-8743-d503a52d691c>
  a skos:Concept;
  skos:prefLabel "Ekehaar-randbijlen"@nl;
  skos:scopeNote "De Ekehaar randbijlen zijn in de omgeving van Drenthe gevonden. Ze zijn dus zeer waarschijnlijk daar geproduceerd. De Ekehaar bijlen zijn te herkennen aan drie of vier ingehamerde versierings lijnen halverwege de bijl."@nl;
  skos:altLabel "Ekehaar-randbijl"@nl, "proto-Ekehaar-randbijl"@nl, "proto-Ekehaar-randbijlen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5f7b8500-d351-498c-ace7-c4163719265c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

