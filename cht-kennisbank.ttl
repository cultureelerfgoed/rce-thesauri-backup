<https://data.cultureelerfgoed.nl/term/id/cht/65cc2870-23d9-47c4-b08e-dab4aaf91d73>
  a skos:Concept;
  skos:prefLabel "aardbevingsgevaar"@nl;
  skos:scopeNote "De kans dat er een aardbeving plaats vindt met een grondversnelling welke een gegeven grenswaarde overschrijdt."@nl;
  skos:altLabel "seismische dreiging"@nl;
