  a skos:Concept;
  skos:prefLabel "ultramarijn"@nl;
  skos:scopeNote "Variabele kleur in de reeks levendige en heldere koele blauwe kleuren, die lijkt op pigment dat oorspronkelijk werd ontleend aan het mineraal lapis lazuli. De naam is een verwijzing naar de buitenlandse ('overzeese') oorsprong van dit mineraal. (bouwmaterie)"@nl;
