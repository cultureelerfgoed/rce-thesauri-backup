<https://data.cultureelerfgoed.nl/term/id/cht/8046d66e-9903-43b2-8cda-2b7b7e04919e>
  a skos:Concept;
  skos:prefLabel "belvedères (lustverblijf)"@nl;
  skos:scopeNote "Naam van talrijke lustverblijven (XVIII-XIXa), o.a. bij Weimar (c. 1725), Unteres en Oberes Belvedere in Wenen (resp. 1714 en 1721), evenals Bellevue, jachtslot bij Wenen (1723), bij Warschau (1823), kasteel Bellevue bij Meudon (dept. Seine et Oise, 1751), slot Bellevue in de Tiergarten van Berlijn (eind XVIII). (Haslinghuis)"@nl;
  skos:altLabel "belvedère (lustverblijf)"@nl;
