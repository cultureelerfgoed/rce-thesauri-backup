<https://data.cultureelerfgoed.nl/term/id/cht/a0311776-53c0-4478-9b5e-0487d5ddd9c8>
  a skos:Concept;
  skos:prefLabel "schaarspanten"@nl;
  skos:scopeNote "Schaarspanten zijn nokspanten waarbij de twee benen in de nok over elkaar heen zijn gekeept. (Historische houtconstructies in Nederland / G. Behrends, 1996)"@nl;
  skos:altLabel "schaarspant"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/63a55de7-55fb-427d-af9d-3924aa90f6c1>;
