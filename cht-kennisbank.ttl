<https://data.cultureelerfgoed.nl/term/id/cht/66c8e2c2-7f58-44b8-a3f8-eb438edb3162>
  a skos:Concept;
  skos:prefLabel "walvisjachten"@nl;
  skos:scopeNote "Walvisjachten zijn de jachten op walvissen, op groot wild. Deze jacht geschiedt met grote vissersschepen met voldoende laadruimte om de gedode en ontlede walvissen op te slaan. (Van Dale)"@nl;
  skos:altLabel "walvisjacht"@nl, "walvisvangst"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fe944ecb-9c86-4a8e-87e0-f196bac83383>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2a5aba9e-56c4-4b15-a7ec-4038154f4a3f>
  a skos:Concept;
  skos:prefLabel "omgekeerd piramidaal met concave wanden"@nl;
  skos:scopeNote "Dit verwijst naar een omgekeerde piramidevorm waarbij de wanden naar binnen buigen (concave). Deze vorm creëert een dramatisch en visueel interessant profiel, populair in eigentijdse kunst en design."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4d488333-abc5-4519-a24d-bb391979c53e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4d488333-abc5-4519-a24d-bb391979c53e>
  a skos:Concept;
  skos:prefLabel "omgekeerd piramidaal"@nl;
  skos:scopeNote "Omgekeerd piramidaal beschrijft een piramidevorm die op zijn punt staat, met de brede basis aan de bovenkant. Deze vorm wordt vaak toegepast in moderne kunst en architectuur vanwege zijn uitdagende en opvallende structuur."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b1a7bbd9-c72a-4312-b65e-d04a67b01191>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/2a5aba9e-56c4-4b15-a7ec-4038154f4a3f>,
    <https://data.cultureelerfgoed.nl/term/id/cht/cc2e480f-190d-423b-8962-554337ec99b8>,
    <https://data.cultureelerfgoed.nl/term/id/cht/f6dc218f-2574-4ea2-8334-87260b4e3b66>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/17f51ff2-03de-4ece-af46-e434e73fbbee>
  a skos:Concept;
  skos:prefLabel "nokbindsels"@nl;
  skos:scopeNote "Touwwerk waarmee het zeil aan de ranokken wordt bevestigd."@nl;
  skos:altLabel "nokbindsel"@nl;
