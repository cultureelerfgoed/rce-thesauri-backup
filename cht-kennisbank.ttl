<https://data.cultureelerfgoed.nl/term/id/cht/9cb84d7e-bff9-4da5-874d-c96f92ff821a>
  a skos:Concept;
  skos:prefLabel "clichés (drukkerijterm)"@nl;
  skos:scopeNote "Clichés zijn metalen platen of blokken die worden gebruikt in de druktechniek om afbeeldingen of tekst herhaaldelijk af te drukken."@nl;
  skos:altLabel "clichee (drukkerijterm)"@nl;
