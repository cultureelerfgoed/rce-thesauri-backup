<https://data.cultureelerfgoed.nl/term/id/cht/a9654d59-7896-4376-9552-b12fbbd729c6>
  a skos:Concept;
  skos:prefLabel "duplexnagels"@nl;
  skos:scopeNote "Draadnagel met dubbele kop voor gebruik in betonbekistingen. (Haslinghuis)"@nl;
