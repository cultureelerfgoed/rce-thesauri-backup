<https://data.cultureelerfgoed.nl/term/id/cht/4024965f-bc46-4031-aa84-16b036c8e2e5>
  a skos:Concept;
  skos:prefLabel "staten"@nl;
  skos:scopeNote "De constituerende, staatkundige en bestuurlijke eenheden van verschillende landen onder een federale regering, zoals Australie en de Verenigde Staten. (AAT-Ned)"@nl;
  skos:altLabel "land"@nl, "staat"@nl, "staten (land)"@nl;
