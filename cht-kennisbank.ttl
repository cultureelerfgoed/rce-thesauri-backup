<https://data.cultureelerfgoed.nl/term/id/cht/d9420d80-c08e-49ad-98a2-d47547c49aff>
  a skos:Concept;
  skos:prefLabel "koppelingsvingers"@nl;
  skos:scopeNote "De koppelingsvinger trekt de drukplaat terug bij het ontkoppelen."@nl;
  skos:altLabel "koppelingsvinger"@nl;
