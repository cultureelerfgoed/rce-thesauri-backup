  a skos:Concept;
  skos:prefLabel "jeneverboomhars"@nl;
  skos:scopeNote "Hars van echte jeneverbesbomen, van het geslacht Juniperus. Gebruik voor de hars van de geslachten Callitris en Tetraclinis, die soms gomjeneverbes wordt genoemd, sandarac. (AAT)"@nl;
