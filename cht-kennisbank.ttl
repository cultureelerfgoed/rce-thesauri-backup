<https://data.cultureelerfgoed.nl/term/id/cht/2a25fe1d-a462-4798-b208-80ccc9b7f3fd>
  a skos:Concept;
  skos:prefLabel "stroomgronden"@nl;
  skos:scopeNote "Stroomgronden zijn ruggen in het landschap die de loop van een stroomgordel, en eventueel van aangrenzende oeverafzettingen, markeren; zijn vaak deels ontstaan door klinkverschillen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2971af0-cde7-4888-b828-33443f702e7d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/afba7122-883c-4e8e-9430-a5f3f43923e4>
  a skos:Concept;
  skos:prefLabel "gyttja"@nl;
  skos:scopeNote "Gyttja is een fijn organisch sediment bestaande uit deels verteerde kleine plantenresten of algen. Dit sediment vormt als een bezinksel in stilstaand water (meren), dieper dan 1 à 2 meter."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c6b8be00-b04b-45cc-a5ee-c7e04254319f>;
