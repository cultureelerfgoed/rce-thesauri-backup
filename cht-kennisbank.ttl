<https://data.cultureelerfgoed.nl/term/id/cht/e556c8e3-6bd2-4bc2-89a7-9e9bd21b4af3>
  a skos:Concept;
  skos:prefLabel "hoogglanzend"@nl;
  skos:scopeNote "Een stralende, zeer spiegelende oppervlaktekwaliteit, die een meer spiegelachtige reflectie geeft dan een oppervlak met glanzende, zijdeglans of matte afwerking. De hoogglanzende oppervlakte toont nauwlijks onregelmatigheden (functie van de oppervlaktestructuur). (Project Fotografie)"@nl;
  skos:altLabel "hoogglans"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6cc62105-702d-4ddb-baf8-71eff8ee77b5>;
