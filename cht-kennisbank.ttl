<https://data.cultureelerfgoed.nl/term/id/cht/bded5487-ec79-4a75-a5f4-32405c80f621>
  a skos:Concept;
  skos:prefLabel "regionale waarden"@nl;
  skos:scopeNote "Een regionale waarde is een gebied/regio waarvan is aangegeven dat er zich een unieke combinatie van agrarisch gebied, natuur en cultuurhistorie bevindt."@nl;
  skos:altLabel "regionaal belang"@nl, "regionale waarde"@nl;
