<https://data.cultureelerfgoed.nl/term/id/cht/492e86ff-949f-40c3-b612-dde5993b2f1b>
  a skos:Concept;
  skos:prefLabel "equatoriale zonnewijzers"@nl;
  skos:scopeNote "Equatoriale zonnewijzers zijn zonnewijzers waarvan het afleesvlak van de vlakke plaat met daarop de uurlijnen loodrecht staat op de stijl. Het afleesvlak is dus evenwijdig met het vlak van de evenaar of equator. Daarom noemt men dit een vlakke equatoriale zonnewijzer. Daar ’s zomers de zon boven het equatorvlak staat en ’s winters eronder, valt de schaduw van de stijl ’s zomers op de bovenkant en ’s winters op de onderkant. (Zonnewijzers in Limburg / M. Driessen, Herd-de-Stad, 1979/Zonnewijzers in Nederland / J.G. van Cittert-Eymers en M.J. Hagen, Zutphen 1984)"@nl;
  skos:altLabel "aequatoriale zonnewijzer"@nl, "aequatoriale zonnewijzers"@nl, "equatoriale zonnewijzer"@nl,
    "gnomonica"@nl, "parallel zonnewijzer"@nl, "parallel zonnewijzers"@nl, "schuingerichte zonnewijzer"@nl,
    "schuingerichte zonnewijzers"@nl, "sphaera armillaris"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ef27a877-7e1e-4ceb-914a-0319fe020061>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

