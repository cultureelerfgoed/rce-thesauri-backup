  a skos:Concept;
  skos:prefLabel "kachels"@nl;
  skos:scopeNote "Kachels zijn verwarmingstoestellen met gesloten vuur. Doorgaans zijn in Nederland ijzeren kachels gebruikt. Reeds eind 15de eeuw werden in de Elzas kachels van gietijzer gemaakt. Kachels zijn ook van steen vervaardigd. (Haslinghuis)"@nl;
  skos:altLabel "kachel"@nl;
