<https://data.cultureelerfgoed.nl/term/id/cht/76268eae-7987-41e6-92ff-e3d143ba8a82>
  a skos:Concept;
  skos:prefLabel "ropen"@nl;
  skos:scopeNote "Roop is van zegge of van (matten)biezen vervaardigd bindmateriaal bij rieten daken. (Het weke dak: riet- en strobedekkingen / , RV bijdrage 11, Zeist 1990)"@nl;
  skos:altLabel "locksnoer"@nl, "locksnoeren"@nl, "roop"@nl;
