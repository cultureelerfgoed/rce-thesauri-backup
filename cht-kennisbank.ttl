  a skos:Concept;
  skos:prefLabel "vijf asser trams"@nl;
  skos:scopeNote "Een vijfasser is een voertuig dat rust op vijf assen. De benaming wordt vooral in de tramwegwereld gebruikt."@nl;
  skos:altLabel "vijf asser tram"@nl;
