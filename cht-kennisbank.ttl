  a skos:Concept;
  skos:prefLabel "holten"@nl;
  skos:scopeNote "Holten bestaan uit opgaande bomen/spaartelgen (veelal eik) die zijn ontstaan uit hakhout. Holten komen voor langs de randen van essen."@nl;
