<https://data.cultureelerfgoed.nl/term/id/cht/a4d244c6-0c74-4a9a-8b88-d270a4c3f84f>
  a skos:Concept;
  skos:prefLabel "gebonden stelsel"@nl;
  skos:scopeNote "Het gebonden stelsel is een stelsel van met kruisgewelven overkluisde vierkante velden, zoals dat zich in het romaanse tijdperk sinds eind 1000 ontwikkelde. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4d7e3462-8396-4c39-8ffb-29451c51e72d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a03ce699-bc7c-44f3-9fee-377a62b608da>
  a skos:Concept;
  skos:prefLabel "tapverbindingen"@nl;
  skos:scopeNote "Tapverbindingen zijn ijzerverbindingen met cilindervormige pennen. In de te verbinden delen worden cilindervormige gaten gemaakt. In deze gaten worden pennen geplaatst die de verbinding bewerkstelligen. Onder andere toegepast bij het aanbrengen van lansspitsen."@nl;
  skos:altLabel "tapverbinding"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4e481c81-319a-44da-86bf-106f145d22c1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

