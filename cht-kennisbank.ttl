<https://data.cultureelerfgoed.nl/term/id/cht/a973b85c-866b-413d-9813-8f8da0856011>
  a skos:Concept;
  skos:prefLabel "driekleurenautotypieën"@nl;
  skos:scopeNote "Autotypieën in drie drukgangen: rood (magenta), geel en blauw (cyaan). Let op: bij combinatiedrukken worden de technieken apart vermeld, bijv. sleutel autotypie met chromolithografie of sleutel lichtdruk met chromolithografie. Dit zijn dus geen (meer)kleurenautotypieën. (Project Fotografie)"@nl;
  skos:altLabel "driekleurenautotypie"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fd69bda4-88da-4b39-9ec0-b58e9645d6b7>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/7a36cbf3-3e97-44c3-b102-ee1fcda7282e>
  a skos:Concept;
  skos:prefLabel "patineren"@nl;
  skos:scopeNote "Patinering is het ontstaan van oppervlakte-verschijnselen aan vuursteen (verkleuring en glans) door ouderdom, vorst en verbranding. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "gepatineerd"@nl, "patinering"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/eb223b26-d098-4a42-ad67-703b0daafb7a>
  a skos:Concept;
  skos:prefLabel "stuifdijken"@nl;
  skos:scopeNote "Dit zijn dijken van opgestoven zand die dienden gebied te vrijwaren van zand. (Thesaurus landschap)"@nl;
  skos:altLabel "stuifdijk"@nl;
