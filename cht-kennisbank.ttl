  a skos:Concept;
  skos:prefLabel "vervalsingen"@nl;
  skos:scopeNote "Een vervalsing is een kopie van een origineel voorwerp, die gemaakt is om voor echt door te gaan. (Conservation Dictionary)"@nl;
