<https://data.cultureelerfgoed.nl/term/id/cht/20ce814d-52dd-40c4-bbb6-2e299fce8916>
  a skos:Concept;
  skos:prefLabel "holle baksteenplaatvloeren"@nl;
  skos:scopeNote "Holle baksteenplaatvloeren zijn systeemvloeren vervaardigd van holle bakstenen elementen die tezamen een plaatvloer vormen. Merknamen: Perfora. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "holle baksteenplaatvloer"@nl;
