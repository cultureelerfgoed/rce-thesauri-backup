<https://data.cultureelerfgoed.nl/term/id/cht/de48c9e3-1e1d-4566-afde-81e38b0171f7>
  a skos:Concept;
  skos:prefLabel "kunststeen tegels"@nl;
  skos:scopeNote "Kunststeen tegels zijn tegels vervaardigd van iedere combinatie of mengsel van materialen. Ze worden gemaakt om natuursteen te vervangen. Merknamen: Keracem"@nl;
  skos:altLabel "granitotegels"@nl, "kunststeen tegel"@nl, "terrazzotegels"@nl;
