<https://data.cultureelerfgoed.nl/term/id/cht/6880b568-f50c-4d02-9439-bb7cf5916aca>
  a skos:Concept;
  skos:prefLabel "suisse-sjerpen"@nl;
  skos:scopeNote "Sjerp die een onderdeel uitmaakt van de suisse-uitrusting. (Religieus Erfgoedthesaurus)"@nl;
