<https://data.cultureelerfgoed.nl/term/id/cht/6edc9efc-1e9c-4f43-953c-f883e0c2c80c>
  a skos:Concept;
  skos:prefLabel "lichtbeuken"@nl;
  skos:scopeNote "Middenschip van een basilicaal gebouw ( (zie) basiliek). Daarin bevinden zich (zie) bovenlichten. Soms in engere zin alleen het bovendeel. Zie tekeningen arcade en basiliek. (Haslinghuis)"@nl;
  skos:altLabel "lichtbeuk"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a3b8829-38ec-471d-b701-f94c154c568d>;
