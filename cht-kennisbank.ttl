<https://data.cultureelerfgoed.nl/term/id/cht/1599048d-ab01-4df8-ae94-50163b72c2d8>
  a skos:Concept;
  skos:prefLabel "patagons"@nl;
  skos:scopeNote "De patagon is een munt die in de Lage Landen in 1612 werd geïntroduceerd onder het bewind van de aartshertogen Albrecht en Isabella (1598-1621) en werd voor het laatst geslagen in 1711 onder de Spaanse troonpretendent Karel III (1703-1711) in Antwerpen. (Wikipedia)"@nl;
  skos:altLabel "Albertusdaalder"@nl, "Albertusdaalders"@nl, "patacon"@nl, "patagon"@nl,
    "patakon"@nl, "patakons"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/306df5ea-fa8e-4352-bb98-55b82d1445dd>;
