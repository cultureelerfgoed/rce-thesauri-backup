<https://data.cultureelerfgoed.nl/term/id/cht/7123584e-a9ea-4246-91b1-b74095fa1d9e>
  a skos:Concept;
  skos:prefLabel "regels (begraafplaats)"@nl;
  skos:scopeNote "Regels zijn rijen (urnen)graven die genummerd zijn ten behoeve van de grafadministratie. Meerdere regels vormen een grafperk of grafvak. Meestal liggen regels dwars op de hoofdpaden met smallere paden ertussen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "regel (begraafplaats)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ebfd7cd7-7a9c-4832-8672-59dfdba61f5d>;
