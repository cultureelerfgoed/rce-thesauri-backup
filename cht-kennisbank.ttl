<https://data.cultureelerfgoed.nl/term/id/cht/f06b927a-423a-4972-82c8-a22bc66ab3d8>
  a skos:Concept;
  skos:prefLabel "apostels (actor)"@nl;
  skos:scopeNote "Apostels zijn religieuze figuren die een centrale rol spelen in het christendom. In erfgoedcontext worden zij vaak afgebeeld of genoemd in kerkelijke objecten of representaties."@nl;
  skos:altLabel "apostel (actor)"@nl;
