<https://data.cultureelerfgoed.nl/term/id/cht/2dbdcfa7-0c77-4398-9082-93bdb74e414b>
  a skos:Concept;
  skos:prefLabel "dubbelpenselen"@nl;
  skos:scopeNote "Dubbelpenselen zijn penselen met aan één kant runderoorhaar en aan de andere kant eekhoornhaar. Het wordt gebruikt bij het werken met waterige glacis."@nl;
  skos:altLabel "dubbelpenseel"@nl, "glacis (penseel)"@nl, "glacissen (penseel)"@nl,
