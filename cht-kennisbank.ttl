<https://data.cultureelerfgoed.nl/term/id/cht/828d2517-cb06-4b4f-ac61-24d13c882aec>
  a skos:Concept;
  skos:prefLabel "wijwaterbakjes"@nl;
  skos:scopeNote "Kleine houder voor wijwater. Bestemd voor huiselijk gebruik, meestal opgehangen aan de muur in het slaapvertrek. Na aanraking van het wijwater wordt/werd een kruisteken gemaakt voor het slapen gaan. (Religieus Erfgoedthesaurus)"@nl;
  skos:altLabel "wijwaterbak"@nl, "wijwaterbakje"@nl, "wijwaterbakken"@nl;
