<https://data.cultureelerfgoed.nl/term/id/cht/8e560196-df17-436b-ba90-a2e1ea6624c3>
  a skos:Concept;
  skos:prefLabel "vlakstroomcarburateurs"@nl;
  skos:scopeNote "Gewoonlijk een carburateur met vaste sproeiers, waarin de lucht horizontaal binnenstroomt."@nl;
  skos:altLabel "vlakstroomcarburateur"@nl, "zijstroomcarburateur"@nl;
