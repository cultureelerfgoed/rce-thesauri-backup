<https://data.cultureelerfgoed.nl/term/id/cht/8bbb8345-d598-4eb4-aa13-3ef096ff439c>
  a skos:Concept;
  skos:prefLabel "grafpalen"@nl;
  skos:scopeNote "Grafpalen is de Nederlandse benaming voor eenvoudige markeringen van een graf. Grafpalen zijn vaak smalle, hoge en dunne platen steen, hout of ijzer met daarop enige tekst ter herinnering aan de overledene. (Rijksdienst voor het Cultureel Erfgoed)"@nl,
    "Vlaamse term: Rechtopstaande graf- of gedenksteen waarin een motief of inscriptie is uitgehouwen, gewoonlijk op een graf. (Religieus Erfgoedthesaurus)"@nl;
  skos:altLabel "grafpaal"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/650c55c6-08ce-4d48-aa42-c7a0fe0c62dc>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ff1c43db-c5fa-4e1c-86b2-c1c53b6ace73>
  a skos:Concept;
  skos:prefLabel "kramerijen"@nl;
  skos:scopeNote "Klein ijzerwerk zoals krammen, ogen, haakjes e.d.. (Haslinghuis)"@nl;
  skos:altLabel "kramerij"@nl;
