<https://data.cultureelerfgoed.nl/term/id/cht/6fa4a26f-d73b-4207-8e93-66fd71575ddf>
  a skos:Concept;
  skos:prefLabel "Laminal"@nl;
  skos:scopeNote "Laminal is een type polyester dat vaak gebruikt wordt in constructies en afwerkingen vanwege zijn duurzaamheid en weerbestendigheid."@nl;
