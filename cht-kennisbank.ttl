  a skos:Concept;
  skos:prefLabel "brandtrappen"@nl;
  skos:scopeNote "Brandtrappen zijn veiligheidstrappen die ingeval van calamiteiten door de aanwezigen in een gebouw als vluchtweg gebruikt kunnen worden. Brandtrappen kunnen in maar ook buiten een gebouw zijn aangebracht. Buiten zijn het vaak open, ijzeren trappen. Binnen zijn brandtrappen brandveilig uitgevoerd en brandveilig gesitueerd zodat de vluchtweg gegarandeerd is."@nl;
  skos:altLabel "brandtrap"@nl, "vluchttrap"@nl, "vluchttrappen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4568d082-f2fd-4dfb-b1b9-4d71334e1d9a>;
