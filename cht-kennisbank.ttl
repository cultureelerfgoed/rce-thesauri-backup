<https://data.cultureelerfgoed.nl/term/id/cht/4e4e6051-664b-4f15-9888-7d62ddad7e0a>
  a skos:Concept;
  skos:prefLabel "vangkettingen"@nl;
  skos:scopeNote "Een ketting waarmee men de vangstok naar beneden kan trekken, zodat de vang in werking treedt. De wieken komen daardoor tot stilstand. In het noorden is, ter verbetering van de grip, het ondereind voorzien van houten kralen. Zie ook: vang, vangtouw."@nl;
  skos:altLabel "vangketting"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/8b224dca-1804-4087-bc69-54b23930a472>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/7da16d5f-f55e-43c0-a89d-688a1559a73f>
  a skos:Concept;
  skos:prefLabel "spankettingen"@nl;
  skos:scopeNote "Ketting aan een of meerdere vangblokken om ze goed passen om het bovenwiel te situeren."@nl;
  skos:altLabel "spanketting"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/8b224dca-1804-4087-bc69-54b23930a472>;
