<https://data.cultureelerfgoed.nl/term/id/cht/8734d08a-14f6-4a44-a072-8a3261679036>
  a skos:Concept;
  skos:prefLabel "zilverkleurbleekdrukken (digitale belichting)"@nl;
  skos:scopeNote "Zilverkleurbleekdrukken die niet handmatig in een donkere kamer van een negatief zijn belicht, maar in plaats daarvan door middel van een computergestuurde digitale belichter met laser of LED belicht zijn en vervolgens op de gewone manier ontwikkeld en gefixeerd. Merknamen: Cibachrome, Ilfochrome, Lambda (printer), Lightjet (printer). (Project Fotografie)"@nl;
  skos:altLabel "zilverkleurbleekdruk (digitale belichting)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9c8f9c94-0ed0-4839-97d3-7404ca700d8e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2fac680e-1ec3-4721-a61b-a3481ace1a86>
  a skos:Concept;
  skos:prefLabel "maalkastjes"@nl;
  skos:scopeNote "In pelmolens, vak van de korenharp waarin het maalgoed werd verzameld."@nl;
