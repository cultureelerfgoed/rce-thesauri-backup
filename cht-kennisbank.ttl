<https://data.cultureelerfgoed.nl/term/id/cht/b1ac87a2-e880-41d6-9c40-6c1532dc2272>
  a skos:Concept;
  skos:prefLabel "genaaide steunlagen"@nl;
  skos:scopeNote "Een genaaide steunlaag voor het steunen van een textiel is een steunlaag die door middel van een naaitechniek is aangebracht tegen de achterkant van de textiel. (Conservation Dictionary)"@nl;
  skos:altLabel "genaaide steunlaag"@nl;
