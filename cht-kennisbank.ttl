<https://data.cultureelerfgoed.nl/term/id/cht/c95534b2-3b1f-4f51-b9da-d0c0fde6ede2>
  a skos:Concept;
  skos:prefLabel "plan D rijtuigen"@nl;
  skos:scopeNote "Plan D is de typeaanduiding voor een serie getrokken rijtuigen die tussen 1950 en 1987 werd ingezet door de Nederlandse Spoorwegen."@nl;
  skos:altLabel "plan D rijtuig"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/45c7511d-182a-476b-b1f6-d8ce740b9fc3>;
