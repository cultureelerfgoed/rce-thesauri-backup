<https://data.cultureelerfgoed.nl/term/id/cht/92a35fd8-9217-41b3-9053-3b84f4e896b3>
  a skos:Concept;
  skos:prefLabel "vertinnen"@nl;
  skos:scopeNote "Met een dunne laag tin bedekken om roesten te voorkomen, vooral van gesmeed hang- en sluitwerk. (Haslinghuis)"@nl;
