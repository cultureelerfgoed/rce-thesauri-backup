<https://data.cultureelerfgoed.nl/term/id/cht/a070af34-ee10-4b07-b54d-e16653519e45>
  a skos:Concept;
  skos:prefLabel "mutuli"@nl;
  skos:scopeNote "Versiering aan de onderzijde van een Dorische kroonlijst, bestaande uit plaatvormige elementen. (Haslinghuis)"@nl;
