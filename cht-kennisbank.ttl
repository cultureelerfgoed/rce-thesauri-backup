  a skos:Concept;
  skos:prefLabel "uitlaatspruitstukken"@nl;
  skos:scopeNote "(Giet)ijzeren groep van pijpen, die recht tegenover de uitlaatpoorten met bouten tegen de motor wordt geschroefd. De uitlaatgassen worden in het uitlaatspruitstuk verzameld en via de uitlaatpijp en de knaldemper afgevoerd."@nl;
  skos:altLabel "uitlaatspruitstuk"@nl;
