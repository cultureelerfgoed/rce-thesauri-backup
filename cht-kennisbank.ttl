<https://data.cultureelerfgoed.nl/term/id/cht/889c47a5-e249-4e41-972a-a9d1e0cc8b5f>
  a skos:Concept;
  skos:prefLabel "lindehout"@nl;
  skos:scopeNote "Hout van de boom behorende tot de soort Tilia americana, inheems in het oosten van de Verenigde Staten en in Canada. De kleur van het hout varieert van roomwit tot bijna bruin; het hout wordt gebruikt voor de vervaardiging van constructiefineer, triplex, pianomechanieken en draaiwerk. (Toegepaste Kunst Project, RKD)"@nl;
  skos:altLabel "lindehout (American, hout)"@nl, "linden"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ba6bdd8e-2f33-4268-a6a0-791e94a6a782>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4a7e32c6-015b-40d2-b2e3-e4f7af6e5fba>
  a skos:Concept;
  skos:prefLabel "wilgenhout"@nl;
  skos:scopeNote "Wilgenhout is hout van de wilg, en is zacht en buigzaam. Het hout wordt voor talrijke doeleinden gebruikt, meestal als hulpmateriaal. (Haslinghuis)"@nl;
  skos:altLabel "wilgehout"@nl, "wilgen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ba6bdd8e-2f33-4268-a6a0-791e94a6a782>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ffb13791-6293-475c-8106-67d92825c98f>
  a skos:Concept;
  skos:prefLabel "satijnnotenhout"@nl;
  skos:scopeNote "Hout van de boom behorende tot de soort Eucalyptus calophylla, inheems in Australië. Het is geelachtig rood van kleur en wordt gebruikt voor het maken van vloeren, plaveisels en traptreden. (AAT-Ned)"@nl;
  skos:altLabel "satijnnotehout"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ba6bdd8e-2f33-4268-a6a0-791e94a6a782>;
