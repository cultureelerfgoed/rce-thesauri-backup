<https://data.cultureelerfgoed.nl/term/id/cht/4e2fe1ee-f351-468c-a1c9-8e1cce2b360a>
  a skos:Concept;
  skos:prefLabel "bolletriehout"@nl;
  skos:scopeNote "Bolletriehout is een houtsoort die bekend staat om zijn hardheid en duurzame eigenschappen, veel gebruikt in meubel- en constructietoepassingen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/7bd143fd-d041-4e54-b5d2-d1e5bccce643>
  a skos:Concept;
  skos:prefLabel "boontjes"@nl;
  skos:scopeNote "Boontjes, ook wel parels genoemd, zijn kleine, ronde decoratieve elementen die vaak in sieraden of borduurwerk worden gebruikt voor een verfijnde afwerking."@nl;
  skos:altLabel "boontje"@nl;
