  a skos:Concept;
  skos:prefLabel "kruiliers"@nl;
  skos:scopeNote "Een lier waarmee men een molen kan kruien. De kruilier is moderner dan het kruirad. Is voorzien van een kruidraad (Marle) of kruiketting (Sint Jansklooster). (Molenwoordenboek B.D. Poppen)"@nl;
  skos:altLabel "kruilier"@nl;
