<https://data.cultureelerfgoed.nl/term/id/cht/5d82f61d-8146-4ccd-9fb7-1d612aafedbc>
  a skos:Concept;
  skos:prefLabel "rozetten"@nl;
  skos:scopeNote "Rozetten zijn versieringselementen in reliëf. Deze elementen lijken op een roos en worden toegepast als versiering van bijvoorbeeld gevelbanden, friezen, dagkanten en plafonds. (Haslinghuis)"@nl;
  skos:altLabel "rozet"@nl;
