<https://data.cultureelerfgoed.nl/term/id/cht/9d174691-eb13-4026-b10a-913ff7668409>
  a skos:Concept;
  skos:prefLabel "bovenkapellen (kapelonderdeel)"@nl;
  skos:scopeNote "Het bovenste gedeelte van een dubbele kapel, b.v. de Agnietenkapel te Utrecht, nu onderdeel van het Centraal Museum. (Haslinghuis)"@nl;
  skos:altLabel "bovenkapel (kapelonderdeel)"@nl;
