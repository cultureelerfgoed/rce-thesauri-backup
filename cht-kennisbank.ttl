    <https://data.cultureelerfgoed.nl/term/id/cht/f485dbf4-4558-48eb-98e8-eacb9863858f>,
    <https://data.cultureelerfgoed.nl/term/id/cht/584ff8ca-06b5-468a-bc0c-8e1040c96f6c>,
    <https://data.cultureelerfgoed.nl/term/id/cht/d367a8f0-f0dd-4e04-8d41-e496a27fc754>,
    <https://data.cultureelerfgoed.nl/term/id/cht/55f3d8af-8b5d-4de3-94ef-e80674e01bce>,
    <https://data.cultureelerfgoed.nl/term/id/cht/9991233f-f32d-4cfe-a329-55e937288206>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e081adb2-7feb-4ae1-b00d-c0cc6dcc57d9>
  a skos:Concept;
  skos:prefLabel "eerste stenen"@nl;
  skos:scopeNote "Eerste stenen zijn stenen blokken, meestal van natuursteen, met enig ceremonieel geplaatst bij het begin van de bouw, als de fundering geheel of grotendeels gereed is. Meestal zijn ze voorzien van een opschrift ter herdenking van dit feit. (Haslinghuis)"@nl,
    "Steen met gebeitelde tekst die herinnert aan de stichting van de kerk. (Religieus Erfgoedthesaurus)"@nl;
  skos:altLabel "eerste steen"@nl, "fundatiesteen"@nl, "fundatiestenen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4e481c81-319a-44da-86bf-106f145d22c1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2c61e329-54d2-4a92-a098-983cc29246eb>
  a skos:Concept;
  skos:prefLabel "barricades"@nl;
  skos:scopeNote "Meestal een geïmproviseerde versperring van een doorgang. (Stichting Menno van Coehoorn)"@nl;
  skos:altLabel "barricade"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d33d002f-f84f-49b8-9658-df4ff52a3b21>;
