<https://data.cultureelerfgoed.nl/term/id/cht/58abf0fc-d62b-45b6-af92-77caa797b263>
  a skos:Concept;
  skos:prefLabel "begrafenissen"@nl;
  skos:scopeNote "Begrafenishandelingen, gewoonlijk maar niet noodzakelijkerwijs met een ceremonieel karakter, de plaatsing ervan in het graf, al dan niet vergezeld van allerlei bijbehorende rituele handelingen. (AAT)"@nl;
  skos:altLabel "inhumaties"@nl, "inhumatie"@nl, "begrafenis"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/15d2a044-9ebe-4f8e-8a34-bd7e5780b2aa>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f5da69b1-5658-41ea-ad8e-55a242554d30>
  a skos:Concept;
  skos:prefLabel "bemanning"@nl;
  skos:scopeNote "Bemanning bestaat uit personen die verantwoordelijk zijn voor de uitvoering van taken aan boord van een schip of luchtvaartuig. Zij zorgen voor navigatie, techniek en veiligheid."@nl;
  skos:altLabel "bemanningen"@nl, "bemanningsleden"@nl, "bemanningslid"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/db4a7619-d236-4b14-8e79-b4a6e890f677>;
