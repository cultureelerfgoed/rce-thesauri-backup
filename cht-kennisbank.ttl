<https://data.cultureelerfgoed.nl/term/id/cht/f523978d-5fac-46e8-815a-e071e7cb29ac>
  a skos:Concept;
  skos:prefLabel "gerechtshoven"@nl;
  skos:scopeNote "Gerechtshoven zijn instanties waar zaken worden behandeld van personen die in hoger beroep zijn gegaan tegen de uitspraak van de rechter."@nl;
