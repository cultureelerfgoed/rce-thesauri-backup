<https://data.cultureelerfgoed.nl/term/id/cht/29fc8d46-ab15-48b6-b0a7-0a1b9d80bbac>
  a skos:Concept;
  skos:prefLabel "Jodenvervolging"@nl;
  skos:scopeNote "Jodenvervolging is gecoördineerd geweld tegen en onderdrukking van de Joodse bevolkingsgroep. De bekendste Jodenvervolging is de Holocaust, de systematische vervolging en moord op Joden door de nazi's in Duitsland en bezet Europa voor en tijdens de Tweede Wereldoorlog."@nl;
  skos:altLabel "Holocaust"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/15d2a044-9ebe-4f8e-8a34-bd7e5780b2aa>;
