<https://data.cultureelerfgoed.nl/term/id/cht/9b85eae7-5a31-4363-92b4-d71e6a774c07>
  a skos:Concept;
  skos:prefLabel "gesloten bouwblokken"@nl;
  skos:scopeNote "Gesloten bouwblokken zijn bouwblokken die aan alle kanten door straten en/of wegen begrenst zijn. Ook hebben deze gesloten bouwblokken vaak een gezamelijke binnentuin.(Rijksdienst voor de Cultureel Erfgoed)"@nl,
    "Gesloten bouwblokken zijn structuren die bestaan uit geschakelde gebouwen die op enige manier een blok vormen met een gesloten en besloten binnengebied. (Verhuis vriend.nl)"@nl;
  skos:altLabel "gesloten bouwblok"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5f5647f3-3265-4077-9702-3be303347f08>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8715ca5d-efc8-4582-8832-ba947c97cf85>
  a skos:Concept;
  skos:prefLabel "lighallen"@nl;
  skos:scopeNote "Lighallen zijn hallen met open voorzijde, waarin patienten in de open lucht verpleegd konden worden. Deze lighallen werden vooral toegepast bij sanatoria. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "lighal"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/83883001-9943-4726-9ddd-3fd73c7b9c46>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/43e13d7a-9222-4aa1-b907-748dc6aad064>
  a skos:Concept;
  skos:prefLabel "valkenhoven"@nl;
  skos:scopeNote "Valkenhoven zijn de plaatsen waar valken en andere roofvogels ten behoeve van de jacht worden afgericht. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "valkenhof"@nl, "valkenhouderij"@nl, "valkenhouderijen"@nl, "valkhof"@nl,
    "valkhoven"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/41ae98cd-0cc4-438a-8032-3c6ee1429b8d>;
