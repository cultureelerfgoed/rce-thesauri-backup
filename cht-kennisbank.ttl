  a skos:Concept;
  skos:prefLabel "Meissner graniet"@nl;
  skos:scopeNote "Meissner graniet is een granietsoort afkomstig uit de regio Meissen in Duitsland, gewaardeerd om zijn sterkte en karakteristieke structuur."@nl;
