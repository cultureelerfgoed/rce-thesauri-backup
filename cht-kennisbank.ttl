<https://data.cultureelerfgoed.nl/term/id/cht/3091feb3-cb94-4f23-95dc-68c800415c90>
  a skos:Concept;
  skos:prefLabel "Rumfordse open haarden"@nl;
  skos:scopeNote "Open haard met warmte-overdracht volgens de theorieën van Sir Benjamin Thompson, graaf van Rumford, Engels politicus en natuurkundige (1753-1814). De verbrandingsgassen worden door een stelsel van circulatiekanalen geleid, waarbij de warmte aan het vertrek wordt afgegeven alvorens te worden afgevoerd naar de schoorsteen. (Haslinghuis)"@nl;
  skos:altLabel "Rumfordse open haard"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/74d39859-6672-4146-a13b-f3d5c30c7099>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/74d39859-6672-4146-a13b-f3d5c30c7099>
  a skos:Concept;
  skos:prefLabel "open haarden"@nl;
  skos:scopeNote "Open haarden zijn stookplaatsen in vertrekken waar in een open vuur hout wordt gestookt. Om vonken tegen te houden plaatst men wel haardschermen voor de open haard. (Van Dale)"@nl;
  skos:altLabel "open haard"@nl;
