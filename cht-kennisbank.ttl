<https://data.cultureelerfgoed.nl/term/id/cht/a1d0cff3-9430-4d9f-8caa-f9279a25a34b>
  a skos:Concept;
  skos:prefLabel "gemberpotten"@nl;
  skos:scopeNote "Houders om gember in te bewaren, meestal eivormig met afgevlakte schouders, rechtopstaande kraag en koepel- of kapvormig deksel; ook wel van zilver. Traditioneel gebruikt in China. (AAT)"@nl;
  skos:altLabel "gemberpot"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/888c6b9b-3e4f-4d52-8819-da81c0b07ad9>;
