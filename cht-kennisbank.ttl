<https://data.cultureelerfgoed.nl/term/id/cht/2ad33db7-a66f-4f4d-8dd5-5724128d9321>
  a skos:Concept;
  skos:prefLabel "polderhuizen"@nl;
  skos:scopeNote "Polderhuizen zijn gebouwen waarin het bestuur van een polder is gevestigd. Dit polderbestuur was een voorloper van het waterschap."@nl;
  skos:altLabel "polderhuis"@nl;
