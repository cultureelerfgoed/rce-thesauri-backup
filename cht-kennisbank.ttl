<https://data.cultureelerfgoed.nl/term/id/cht/742c58de-8d30-4afc-ab0a-2bddf4c2b319>
  a skos:Concept;
  skos:prefLabel "leeszalen"@nl;
  skos:scopeNote "Leeszalen zijn grote ruimtes waar men kan lezen of studeren in een bibliotheek, een sociëteit, op een schip enz. In Nederland verschenen in de negentiende eeuw voor het eerst openbare leeszalen. In de vroege twintigste eeuw konden hier ook boeken geleend worden. (Rijksdienst voor het Cultureel Erfgoed/Van Dale)"@nl;
  skos:altLabel "leeszaal"@nl, "openbare leeszalen"@nl, "openbare leeszaal"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e9251d88-dd54-4e65-9e36-9c19fd66a7a0>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/dfb3e170-7b42-45c2-8230-a70785a72a41>
  a skos:Concept;
  skos:prefLabel "watergangen (gang)"@nl;
  skos:scopeNote "Smalle gang tussen twee naast elkaar gelegen huizen, voor het opvangen van dakwater. (Haslinghuis)"@nl;
  skos:altLabel "watergang (gang)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a40f45b6-e7b7-4d9a-b34b-fc84feef85a9>;
