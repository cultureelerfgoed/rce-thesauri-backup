<https://data.cultureelerfgoed.nl/term/id/cht/9f144ff7-9e81-4ce2-a7e1-f8ccca903770>
  a skos:Concept;
  skos:prefLabel "verguldersmessen"@nl;
  skos:scopeNote "Een verguldersmes is een mes met een lang lemmet waarmee goudblad op de gewenste maat wordt gesneden. (Conservation Dictionary)"@nl;
