<https://data.cultureelerfgoed.nl/term/id/cht/d94c589f-fecc-4c74-9c84-e43a36be1eaf>
  a skos:Concept;
  skos:prefLabel "tijgerhout (hout)"@nl;
  skos:scopeNote "Geel hout met donkere strepen dat wordt verkregen uit de soort Lavoa klaineana, die inheems is in Afrika. Tijgerhout heeft een natuurlijk glanzend oppervlak met een fijne gelijkmatige structuur. Het wordt gebruikt voor meubels, fineer, geweerkolven, inlegwerk, biljarttafels en kasten. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/dc04cc77-00cb-47af-951e-abb44ad62d64>
  a skos:Concept;
