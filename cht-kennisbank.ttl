<https://data.cultureelerfgoed.nl/term/id/cht/29f134b2-952b-4714-a1df-32733750e51a>
  a skos:Concept;
  skos:prefLabel "gelifluctie"@nl;
  skos:scopeNote "Gelifluctie is het hellingafwaarts bewegen van met water verzadigde bovengrond gelegen op een permafrost. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/df4db7b4-3b69-49a2-9068-13034f1a068f>;
