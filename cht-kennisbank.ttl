<https://data.cultureelerfgoed.nl/term/id/cht/cedf5cfa-35d9-40fe-8239-f1b3b2ac23cb>
  a skos:Concept;
  skos:prefLabel "vogelhuizen"@nl;
  skos:scopeNote "Vogelhuizen zijn verblijven voor vogels. De verschijningsvorm kan variëren van grote volières tot kleine voerderhuisjes die in de tuin kunnen worden geplaatst."@nl;
  skos:altLabel "volières"@nl, "vogelhuis"@nl, "volièrevolières"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/41ae98cd-0cc4-438a-8032-3c6ee1429b8d>;
