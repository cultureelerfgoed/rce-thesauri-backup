<https://data.cultureelerfgoed.nl/term/id/cht/bc06a10b-2647-4adc-8245-b163238455bc>
  a skos:Concept;
  skos:prefLabel "nokstijlen"@nl;
  skos:scopeNote "Wordt gebruikt voor driehoekige geraamten met een verticale centrale stut (de koningsstijl) die van de apex naar de bintbalk loopt. (AAT-Ned)"@nl;
