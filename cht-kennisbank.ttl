<https://data.cultureelerfgoed.nl/term/id/cht/3f84841c-26b0-4c14-90df-b1922d11fc47>
  a skos:Concept;
  skos:prefLabel "boomgaarden"@nl;
  skos:scopeNote "Boomgaarden zijn nutstuinen beplant met op stam gesnoeide vruchtbomen in een regelmatig plantverband. De veredelde fruitbomen zijn geënt en gesnoeid in relatie tot de gewenste fruitopbrengst, vorm en levensduur van de boom. Meest voorkomende soorten zijn appels en peren, daarnaast ook pruimen, kersen, noten en mispels. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "bongerd"@nl, "boomgaard"@nl, "bommel"@nl, "bogaard"@nl, "bogerd"@nl,
    "bogerden"@nl, "bongerden"@nl, "bommels"@nl, "bogaarden"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a83102b6-8906-4a48-b490-99f375f222e9>;
