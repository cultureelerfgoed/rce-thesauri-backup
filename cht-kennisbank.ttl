  a skos:Concept;
  skos:prefLabel "poelierswinkels"@nl;
  skos:scopeNote "Poelierwinkels zijn winkels waar vlees van vogels, kalkoen en wild verkocht wordt. Poeliers zijn gespecialiseerde slagers. Door de komst van de supermarkt is het aantal zelfstandige poeliers drastisch afgenomen in Nederland. Op veel markten zijn er nog wel poeliers te vinden.(Rijksdienst voor het Cultureel Erfgoed"@nl;
  skos:altLabel "poelier"@nl, "poeliers"@nl, "poelierswinkel"@nl;
