<https://data.cultureelerfgoed.nl/term/id/cht/67ee3577-45ae-4443-ad79-105e00312060>
  a skos:Concept;
  skos:prefLabel "godshuizen"@nl;
  skos:scopeNote "Godshuizen zijn liefdadig gestichten, armenhuis, waar bejaarden, zieken enz. om ‘godswil’ werden verpleegd en geregeld kleine uitkeringen genoten."@nl;
