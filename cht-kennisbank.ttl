<https://data.cultureelerfgoed.nl/term/id/cht/9a81e70c-5451-4d14-9793-138ac41a46a0>
  a skos:Concept;
  skos:prefLabel "actieve corrosie"@nl;
  skos:scopeNote "Men spreekt van actieve corrosie als de corrosiereactie nog aan de gang is."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/254738f7-c253-4dfe-a5ce-c6bca0846c83>;
