<https://data.cultureelerfgoed.nl/term/id/cht/d89885c9-677d-40f7-8c23-e9cab3fb1223>
  a skos:Concept;
  skos:prefLabel "boekhandels"@nl;
  skos:scopeNote "Boekhandels zijn winkels waar boeken, kranten, ander drukwerk en mogelijke papierwaren en schrijfartikelen worden verkocht. Nederland is het land met de hoogste boekhandeldichtheid. Vroeger liepen toonbanken van boekhandels vaak door langs alle wanden. Daardoor was er genoeg ruimte om meerdere klanten in de gelegenheid te stellen de koopwaar te bekijken (zie afbeelding). (Het winkellandschap van Amsterdam : stedelijke structuur en winkelbedrijf in de vroegmoderne en moderne tijd, 1550-2000)"@nl;
  skos:altLabel "boekhandel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/10f47eb6-f1a9-465f-b8ab-8381925f039b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e672e669-689f-4bb9-9857-a56822e2e49d>
  a skos:Concept;
  skos:prefLabel "schachten"@nl;
  skos:scopeNote "Rechtstandige gang die toegang geeft tot de horinzotale winningslaag."@nl;
  skos:altLabel "schacht"@nl;
