<https://data.cultureelerfgoed.nl/term/id/cht/28eb8f0e-7d7c-4a89-8486-d287d77656aa>
  a skos:Concept;
  skos:prefLabel "gegoten glas"@nl;
  skos:scopeNote "(Vlak)glas dat gemaakt wordt door het uitgieten en eventueel walsen van vloeibaar glas op een vlakke metalen plaat, of door het gieten in een mal. (Werkgroep Vlakglas)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dcc2121b-8394-44f7-9664-86b109d079a4>;
