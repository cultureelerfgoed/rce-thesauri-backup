  a skos:Concept;
  skos:prefLabel "anastomoserende rivieren"@nl;
  skos:scopeNote "Anastomoserende rivieren zijn rivieren met een vlechtend patroon die bestaan uit een stelsel van meerdere ondiepe waterlopen die zich herhaaldelijk splitsen en samenvoegen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
