  a skos:Concept;
  skos:prefLabel "cyanideren"@nl;
  skos:scopeNote "Cyanideren is de extractie van goud uit verbrijzeld gesteente met een geconcentreerde oplossing van cyanide, waarin goud oplost als een cyanidecomplex."@nl;
