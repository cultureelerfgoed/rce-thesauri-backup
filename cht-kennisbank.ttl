<https://data.cultureelerfgoed.nl/term/id/cht/3c0d20ce-53db-45dd-919c-3c595a875d6a>
  a skos:Concept;
  skos:prefLabel "jachthavens"@nl;
  skos:scopeNote "Lig- en bergplaats voor pleziervaartuigen, tezamen met het omliggende terrein. (BRT)"@nl;
  skos:altLabel "jachthaven"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/800aaad2-2f60-4223-8576-6d52af72dfc8>;
