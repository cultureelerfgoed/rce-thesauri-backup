  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/14884248-d3f2-49cb-b407-79f827126a08>
  a skos:Concept;
  skos:prefLabel "kopbalkgebinten"@nl;
  skos:scopeNote "Kopbalkgebinten zijn gebinten waarbij de gebintbalken aan de toppen van de stijlen zijn verbonden. De gebintbalk is nabij de einden plaatselijk versmald, terwijl aan de boveneinden van de gebintstijlen het middengedeelte is weggezaagd; hierin past de versmalling van de gebintbalk. (AgriWiki)"@nl;
  skos:altLabel "kopbalkgebint"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/19aeaf60-71e6-4a44-84ce-d6dbcce537bb>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/7896dccc-75cf-4f4e-a9d8-c71d945f6312>
  a skos:Concept;
  skos:prefLabel "skeletten"@nl;
  skos:scopeNote "Stijf samenstel in een gebouw, bestaande uit verticale stijlen en horizontale balken of liggers, dat het geheel draagt. Daartussen of daaroverheen zijn vloeren en wanden aangebracht. In hout, staal of gewapend beton. (Haslinghuis)"@nl;
  skos:altLabel "skelet"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b2331d07-8cfc-4ddb-ab21-ed760e7cbc9f>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/05549ec4-a30f-428e-95d2-8f42da6b5e4a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/00f65946-8de9-4981-893b-6adc5894fd5e>
  a skos:Concept;
  skos:prefLabel "vuil"@nl;
  skos:scopeNote "Vuil, groezeligheid, is in de structuur van een voorwerp ingebed ongewenst materiaal. Vuil is alles wat niet op een voorwerp thuishoort, zoals stof, gruis en viezigheid."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6517856b-28ef-4b86-b1ad-2aeb217c1fdc>
  a skos:Concept;
  skos:prefLabel "galvaniseren"@nl;
  skos:scopeNote "Galvaniseren is het aanbrengen van een dunne laag metaal uit een oplossing van een zout van dat metaal op de kathode van een elektrolysecel. Het gebeurt veel met goud, chroom en nikkel."@nl,
    "Procedé waarbij een beschermende zinklaag wordt aangebracht op staal of ijzer om het tegen roest te beschermen."@nl;
  skos:altLabel "gegalvaniseerd"@nl, "gegalviseerd"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/916dc07e-0d01-4e71-82bb-d2cd6bcf9578>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/66a7812d-4c75-4d27-8075-0965d7fe1728>
  a skos:Concept;
  skos:prefLabel "Strakke Stijl"@nl;
  skos:scopeNote "De Strakke Stijl is een vorm van Classicisme waarbij de nadruk vooral ligt op harmonische verhoudingen. De pilasters zijn verdwenen. Het ornament blijft beperkt tot het middenrisaliet en de ingangspartij. Op het hoofdgestel wordt vaak een verhoogd middendeel (attiek) geplaatst. De stijl ontstaat vanaf 1670. (De Amsterdamse School / M. Casciato, 1991)"@nl;
  skos:altLabel "Pilasterloos Classicisme"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/946e80a3-fd4a-4187-ae44-fb5551489b42>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c8d60c50-23c4-44ba-a2cb-7afba3749a9d>
  a skos:Concept;
  skos:prefLabel "oxidelaag"@nl;
  skos:scopeNote "Beschermende laag op materiaal. Bijv. op aluminium."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/198e14bc-e2a4-4010-a8d2-72325d2ced79>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d71fd47e-ae72-46c3-a6ae-3e6e923e07a1>
  a skos:Concept;
  skos:prefLabel "kloostermolens"@nl;
  skos:scopeNote "In de Middeleeuwen had nagenoeg ieder klooster een molen in bezit. Het was tevens in bepaalde gevallen een banmolen. (Molenwoordenboek G.J. Pouw)"@nl;
  skos:altLabel "kloostermolen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0198a25a-3469-469e-8103-a613e32fcdc6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/20b9096b-7d91-40a5-a413-b130260e6a97>
  a skos:Concept;
  skos:prefLabel "bijenwas"@nl;
  skos:scopeNote "Bijenwas is een mengsel van esters met lange koolstofketens waarmee bijen de wanden van hun honingraat maken. Bijenwas wordt gebruikt als bindmiddel, in boenwas en als hechtmiddel."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26b327af-7709-4368-9f64-0612e65d55f6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/58d5a6f4-028b-46dd-9d53-a704790e5d01>
  a skos:Concept;
  skos:prefLabel "structuur"@nl;
  skos:scopeNote "De microscopische structuur van een materiaal is de ruimtelijke oriëntatie van de atomen, ionen of moleculen. Deze structuur bepaalt de macroscopische eigenschappen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2409aab7-e427-41b5-8dfa-0d23b32c023a>
  a skos:Concept;
  skos:prefLabel "bouwwerken"@nl;
  skos:scopeNote "Algemene benaming voor alle soorten gebouwde objecten. Men onderscheidt burgerlijke, kerkelijke, militaire en waterbouwkundige werken. Niet synoniem met gebouw. (Haslinghuis)"@nl;
