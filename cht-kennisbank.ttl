  a skos:Concept;
  skos:prefLabel "agrariërs"@nl;
  skos:scopeNote "Agrariërs houden zich bezig met landbouw of veeteelt. Zij beheren het land, verbouwen gewassen of houden dieren, vaak op boerderijen."@nl;
