<https://data.cultureelerfgoed.nl/term/id/cht/31fd0bea-330a-4ef0-a744-f9e8bcf35e85>
  a skos:Concept;
  skos:prefLabel "snaauwen"@nl;
  skos:scopeNote "Te gebruiken voor brikken met een bezaan met gaffeltuig, een gaffelzeil, aan een kleine hulpmast vlak achter de grote mast, de druil. (AAT)"@nl;
  skos:altLabel "snaauw"@nl;
