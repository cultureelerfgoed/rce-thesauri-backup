<https://data.cultureelerfgoed.nl/term/id/cht/eb0cbe85-2357-4360-a71e-5fc9e901884a>
  a skos:Concept;
  skos:prefLabel "vossenjachten"@nl;
  skos:scopeNote "Vossenjachten zijn een vorm van parforcejachten die gericht zijn op de vangst van vossen. Vanaf het einde van de 16de eeuw populair in Engeland. (Jacht als vermaak voor de elite / J.A. Hendrikx, In: Vermaak van de elite in de vroegmoderne tijd, Hilversum 1999, pp. 137-152)"@nl;
  skos:altLabel "vossenjacht"@nl;
