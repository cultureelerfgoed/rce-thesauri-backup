<https://data.cultureelerfgoed.nl/term/id/cht/e36ec24e-a54b-4904-9a39-b9271fc91328>
  a skos:Concept;
  skos:prefLabel "roltrappen"@nl;
  skos:scopeNote "Mechanisch voortbewogen trap waarop personen staande naar boven en beneden kunnen worden gebracht. In warenhuizen, stations e.d., sedert XXb. (Haslinghuis)"@nl;
