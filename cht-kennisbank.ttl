<https://data.cultureelerfgoed.nl/term/id/cht/9abf4dd7-17c7-42f7-84ed-36ba5d107a2a>
  a skos:Concept;
  skos:prefLabel "grafsculpturen"@nl;
  skos:scopeNote "Beeldhouwwerken die (onderdeel van) grafmonumenten zijn. (AAT-Ned)"@nl;
