<https://data.cultureelerfgoed.nl/term/id/cht/d593d54b-c2e8-4411-a8b9-bbf6b2fcffc6>
  a skos:Concept;
  skos:prefLabel "keitjesvloeren"@nl;
  skos:scopeNote "Keitjesvloeren zijn vloeren van in leem gelegde kiezelstenen, voornamelijk witte en zwarte, in patronen gerangschikt. Vooral in landelijke gebouwen in Oost- en Zuid-Nederland. (Haslinghuis)"@nl;
  skos:altLabel "keitjesvloer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/be9ffbd0-dd12-491e-b9a1-0d224a57a03d>;
