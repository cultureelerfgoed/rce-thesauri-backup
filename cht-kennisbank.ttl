<https://data.cultureelerfgoed.nl/term/id/cht/8b224dca-1804-4087-bc69-54b23930a472>
  a skos:Concept;
  skos:prefLabel "kettingen"@nl;
  skos:scopeNote "Een reeks voorwerpen die, de één na de ander, met elkaar zijn verbonden; het zijn meestal ringen die door elkaar heen lopen. (AAT-Ned)"@nl;
  skos:altLabel "kettingkettingen"@nl;
