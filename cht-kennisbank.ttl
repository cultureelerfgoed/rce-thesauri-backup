<https://data.cultureelerfgoed.nl/term/id/cht/f3dac25b-0f37-4626-9099-1c93d57cb16b>
  a skos:Concept;
  skos:prefLabel "sapeli"@nl;
  skos:scopeNote "Sapeli is een houtsoort afkomstig van de Entandrophragma cylindricum (familie Meliaceae, waar ook mahonie toe hoort). Deze boom groeit vooral in tropisch Centraal -en West-Afrika. (Wikipedia)"@nl;
  skos:altLabel "sapeli mahoniehout"@nl;
