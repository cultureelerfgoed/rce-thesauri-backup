<https://data.cultureelerfgoed.nl/term/id/cht/b130875f-9258-4ff5-b9f2-c4665c8365ee>
  a skos:Concept;
  skos:prefLabel "absolute vochtigheid"@nl;
  skos:scopeNote "De absolute vochtigheid is de hoeveelheid waterdamp die zich in een gegeven volume lucht bevindt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/278ecf7a-f714-4cf5-9fbf-cd073b63cd96>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a5ee95ac-dc45-473f-aeef-c7577d4a1bdd>
  a skos:Concept;
  skos:prefLabel "bevochtigbaarheid"@nl;
  skos:scopeNote "De bevochtigbaarheid van een oppervlak wordt gedoeld op de hydrofobische (water loop er in druppels af) of hydrofiele (water vormt een gelijkmatig verdeelde laag) eigenschappen ervan."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/278ecf7a-f714-4cf5-9fbf-cd073b63cd96>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/32f5ff14-cfc5-4e87-9e8c-0dabd464c853>
  a skos:Concept;
  skos:prefLabel "vochtplek"@nl;
  skos:scopeNote "Een vochtplek op papier is een diffuse verkleuring veroorzaakt door water. Het water lost afbraakproducten uit het papier op die naar het oppervlak van het papier migreren tijdens het drogen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/278ecf7a-f714-4cf5-9fbf-cd073b63cd96>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e399ad0a-8a47-4b01-ba66-dcf9b6d972c2>
  a skos:Concept;
  skos:prefLabel "luchtvochtigheid"@nl;
  skos:scopeNote "De hoeveelheid verdampt water in de atmosfeer. (AAT)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/278ecf7a-f714-4cf5-9fbf-cd073b63cd96>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/0c3c2c5c-8b53-4046-baa9-9c076fa5cb65>;
