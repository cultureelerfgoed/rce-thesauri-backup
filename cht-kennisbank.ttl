<https://data.cultureelerfgoed.nl/term/id/cht/0df4f6c2-a575-48eb-9154-1f5e82546948>
  a skos:Concept;
  skos:prefLabel "cippe"@nl;
  skos:scopeNote "Sokkelvormig grafmonument, op de hoeken bekroond met gestileerde acroteria (bekroning van een grafmonument in de vorm van een beeld of ornament)."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/7e081e30-ebe0-4a34-99fe-2ef63e71d38e>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/418c90b8-d4ac-4f01-8faf-8fa704c0f288>
  a skos:Concept;
  skos:prefLabel "gevlochten hagen"@nl;
  skos:scopeNote "Bij veekeringen en erfafsluitingen toegepaste technieken waarbij zijtakken van het haagplantsoen zijwaarts in de haag worden gevlochten om het gat in de haag te dichten."@nl;
