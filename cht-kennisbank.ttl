<https://data.cultureelerfgoed.nl/term/id/cht/e5a4048d-aba3-44f3-9ab1-0c55eebd10b6>
  a skos:Concept;
  skos:prefLabel "Franse kalksteen"@nl;
  skos:scopeNote "Verzamelnaam voor meer dan honderd witgele en geelbeige kalksteensoorten uit Frankrijk. (Haslinghuis)"@nl;
  skos:hiddenLabel "Frans kalksteen"@nl, "Frans kalkgesteente"@nl;
