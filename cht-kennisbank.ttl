<https://data.cultureelerfgoed.nl/term/id/cht/c4e819fb-4dbe-42bb-8f5a-5a4864dafecb>
  a skos:Concept;
  skos:prefLabel "hittepennen"@nl;
  skos:scopeNote "Hittepennen zijn pennen met een verwarmend element dat de punt van de pen verhit waarmee in acetaatfolie e.d. kan worden gesneden, zoals sjabloonfolie."@nl;
  skos:altLabel "hittepen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
