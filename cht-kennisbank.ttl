<https://data.cultureelerfgoed.nl/term/id/cht/ca4ec020-c0c1-48a2-baae-08eb0538c804>
  a skos:Concept;
  skos:prefLabel "devotieprenten"@nl;
  skos:scopeNote "Algemene benaming voor een houtsnede of gravure, al dan niet ingekleurd, of een gedrukte voorstelling van Christus, Maria, een heilige, een devotie(beeld) of een bijbelse voorstelling op een klein formaat perkament of papier. Veelal voorzien van een begeleidende tekst. (Religieus Erfgoedthesaurus)"@nl;
  skos:altLabel "devotieprent"@nl, "devotieprentje"@nl, "devotieprentjes"@nl;
