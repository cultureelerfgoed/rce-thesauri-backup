  a skos:Concept;
  skos:prefLabel "rijgen (activiteit)"@nl;
  skos:scopeNote "Het tijdelijk aan elkaar bevestigen van twee of meer stukken materiaal door middel van lange, losse steken om ze op hun plaats te houden tot ze uiteindelijk worden vastgenaaid. Gebruik 'losjes bevestigen' voor een lichte of tijdelijke bevestiging met behulp van een ander middel. (AAT)"@nl;
  skos:altLabel "geregen (activiteit)"@nl;
