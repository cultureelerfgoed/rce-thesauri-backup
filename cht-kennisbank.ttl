<https://data.cultureelerfgoed.nl/term/id/cht/db95e806-1ae6-4a4f-b1ca-37d60b4c9125>
  a skos:Concept;
  skos:prefLabel "tinglazuur"@nl;
  skos:scopeNote "Ondoorzichtig glazuur dat een tinoxide of tinas bevat. (Toegepaste Kunst Project, RKD)"@nl;
