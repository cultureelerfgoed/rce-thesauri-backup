  a skos:Concept;
  skos:prefLabel "mesbeslagen"@nl;
  skos:scopeNote "Mesbeslag vomt het geheel van de metalen delen van een mes."@nl;
  skos:altLabel "mesbeslag"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/62128e87-78cb-451f-ab69-da127f0a5119>;
