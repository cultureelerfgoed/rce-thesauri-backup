<https://data.cultureelerfgoed.nl/term/id/cht/289c66f4-a8f8-4061-8041-5be46912be62>
  a skos:Concept;
  skos:prefLabel "peterselie"@nl;
  skos:scopeNote "Peterselie (Petroselinum crispum) is een tweejarige, winterharde, kruidachtige plant uit de schermbloemenfamilie (Apiaceae). (Wikipedia)"@nl;
  skos:altLabel "tuinpeterselie"@nl, "Petroselinum crispum"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/78672fa4-8815-4427-995e-21a2cc90bd39>;
