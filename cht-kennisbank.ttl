<https://data.cultureelerfgoed.nl/term/id/cht/1d493243-f345-4a6d-ba1a-2c9cfa87b6a9>
  a skos:Concept;
  skos:prefLabel "vroege middeleeuwen A"@nl;
  skos:scopeNote "De verouderde benaming voor deze periode van de Vroege Middeleeuwen A is volksverhuizingstijd, een periode waarin door geheel Europa vele volkeren hun oorspronkelijke stamgebied verlaten en zich vestigen in andere gebieden. Dit alles heeft veel politieke instabiliteit, chaos en oorlogen tot gevolg."@nl;
  skos:altLabel "Dark Ages"@nl, "Volksverhuizingstijd"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/910d3568-8f11-45e2-aa6e-a2c484692f5b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b284f8d3-15aa-4117-abdf-6d86f4411478>
  a skos:Concept;
  skos:prefLabel "brandweerkazernes"@nl;
  skos:scopeNote "Gebouwen waar brandweerauto's, brandbestrijdingsapparatuur zijn ondergebracht en meestal ook de brandweermannen, die dienst hebben. (AAT-Ned)"@nl;
  skos:altLabel "brandweerkazerne"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e660c55f-5362-4410-87de-219ec5dbfb16>;
