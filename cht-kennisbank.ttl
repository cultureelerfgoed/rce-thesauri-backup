<https://data.cultureelerfgoed.nl/term/id/cht/fc259523-0e27-412c-b2a8-af4a3691703f>
  a skos:Concept;
  skos:prefLabel "litoraal"@nl;
  skos:scopeNote "Litoraal is betrekking hebbend op de zone langs de kust tussen de laagste en de hoogste getijdenstand. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/929f2b49-e558-4543-a710-41a893c3c5dd>;
