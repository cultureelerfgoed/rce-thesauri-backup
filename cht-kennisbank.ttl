<https://data.cultureelerfgoed.nl/term/id/cht/9c17dc7f-664f-47a7-a9ee-93dffbc6759c>
  a skos:Concept;
  skos:prefLabel "esranden"@nl;
  skos:scopeNote "De esrand is de overgang van het landbouwareaal naar het gebied met ander gebruik of begroeiing. Rondom een enk of es is vaak sprake van een wal, of bossage."@nl;
  skos:altLabel "esrand"@nl;
