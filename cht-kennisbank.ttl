<https://data.cultureelerfgoed.nl/term/id/cht/36ebf0b0-c055-4ff0-a4fc-3baaed2b1595>
  a skos:Concept;
  skos:prefLabel "meet- en weeginstrumenten"@nl;
  skos:scopeNote "Instrument of houder voor het meten van bijvoorbeeld de omvang, hoeveelheid, massa, plaats of het vermogen, uitgedrukt in een standaardeenheid of een vastgestelde hoeveelheid."@nl;
