  a skos:Concept;
  skos:prefLabel "heupgordels"@nl;
  skos:scopeNote "Autogordel met een enkele band die over de heup en het onderste gedeelte van het lichaam gaat."@nl;
  skos:altLabel "heupgordel"@nl;
