<https://data.cultureelerfgoed.nl/term/id/cht/aaab04d6-995c-4de9-bb71-92d48f9507e5>
  a skos:Concept;
  skos:prefLabel "kuilvoerplaten"@nl;
  skos:scopeNote "De kuilvloerplaat is in de regel een betonnen vloerplaat met aan de lange zijden opstaande betonnen wanden. Het kuilvoer wordt met de trekker aangereden en daarna afgdekt met plastic en grond. Kuilvoer is ingekuild veevoer. Vele soorten voeder kunnen worden ingekuild, maar de meest voorkomende kuilvoeders zijn kuilgras en snijmais."@nl;
  skos:altLabel "kuilvoerplaat"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/3bf64cd9-cf95-4482-9e31-6069991467df>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/21d05f73-aa55-4fff-bb03-71d6a461840d>
  a skos:Concept;
  skos:prefLabel "togen (molen)"@nl;
  skos:scopeNote "De gemetselde kromming, de kom, waarin de vijzel draait."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/04770e4f-1c11-40e7-a256-9de8c6d569c6>;
