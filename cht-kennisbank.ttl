<https://data.cultureelerfgoed.nl/term/id/cht/ac5fa588-c59b-4637-8ae6-c716b865aed8>
  a skos:Concept;
  skos:prefLabel "luchtkussenfolie"@nl;
  skos:scopeNote "Luchtkussenfolie is verpakkingsmateriaal en schokwerend materiaal dat bestaat uit twee gelamineerde lagen polyetheen met luchtkussentjes ertussen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
