<https://data.cultureelerfgoed.nl/term/id/cht/a7190f06-2af2-4fb1-a08e-67f5f869d493>
  a skos:Concept;
  skos:prefLabel "antitankwapens"@nl;
  skos:scopeNote "Een antitankwapen is een wapen bedoeld om pantservoertuigen, in het bijzonder tanks, uit te schakelen. (Wikipedia)"@nl;
  skos:altLabel "antitankwapen"@nl;
