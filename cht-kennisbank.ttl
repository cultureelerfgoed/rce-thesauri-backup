<https://data.cultureelerfgoed.nl/term/id/cht/d29ee4e5-c06b-4012-8da2-4031b22c76ab>
  a skos:Concept;
  skos:prefLabel "boerderijinterieurs"@nl;
  skos:scopeNote "Boerderijinterieurs verwijzen naar de binnenruimtes van boerderijen, vaak gekenmerkt door traditionele, functionele elementen die aansluiten bij het agrarische gebruik van het gebouw."@nl;
  skos:altLabel "boerderijinterieur"@nl;
