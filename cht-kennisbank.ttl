<https://data.cultureelerfgoed.nl/term/id/cht/b16e286f-e8b5-4337-8409-ca5198beaec5>
  a skos:Concept;
  skos:prefLabel "doken (kram/bout)"@nl;
  skos:scopeNote "Ijzeren of koperen kram of bout waarmee stukken gehouwen steen aan elkaar of aan achterliggend of onderliggend metselwerk of houtwerk worden bevestigd. Op die wijze worden ook natuurstenen neuten met stijlen van houten kozijnen of staanders verbonden. De doken worden in de natuursteen bevestigd in daarvoor gemaakte groeven of gaten en met lood, cement of steenlijm vastgegoten. (Haslinghuis)"@nl;
  skos:altLabel "dook (kram/bout)"@nl, "fits (kram/bout)"@nl, "fitsen (kram/bout)"@nl;
