<https://data.cultureelerfgoed.nl/term/id/cht/4fd21d37-0c62-48d3-98a1-818c23710726>
  a skos:Concept;
  skos:prefLabel "diergrondstof"@nl;
  skos:scopeNote "Diergrondstof verwijst naar materialen van dierlijke oorsprong, zoals leer, bont, wol, of hoorn, die worden verwerkt en gebruikt in de productie van diverse producten zoals kleding, kunstvoorwerpen, en gereedschappen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b4a07f8c-07ee-4f80-aa5b-2ef1e240ee79>;
