  a skos:Concept;
  skos:prefLabel "Doopsgezinde Gemeente"@nl;
  skos:scopeNote "Een protestants kerkgenootschap (broederschap) dat de kinderdoop verwerpt en de eed voor ongeoorloofd houdt."@nl;
