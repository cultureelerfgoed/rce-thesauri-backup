  a skos:Concept;
  skos:prefLabel "vorstschade"@nl;
  skos:scopeNote "Vorstschade is de schade die door het bevriezen van water wordt toegebracht aan bijvoorbeeld poreuze bouwmaterialen en buizen. Water zet ongeveer 9% uit bij bevriezing, wat leidt tot grote inwendige spanningen, met barsten en afsplintering als gevolg."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0e07bd39-012a-4958-90b8-ac9a877ea42e>;
