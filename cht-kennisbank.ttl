<https://data.cultureelerfgoed.nl/term/id/cht/a64d1067-8682-4524-acf8-af6c0a61e884>
  a skos:Concept;
  skos:prefLabel "Mottle-Test"@nl;
  skos:scopeNote "De Mottle-Test is een onderdeel van de Photographic Activity test. De test maakt gebruik van een emulsie van colloïdaal zilver in gelatine, aangebracht op een polyesterfilm, die dient als een verklikker voor stoffen die beeldzilver aantasten."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4b88257a-99a9-48f3-8bf3-a25765587b3e>;
