  a skos:Concept;
  skos:prefLabel "steldorpels"@nl;
  skos:scopeNote "Lat die voor het stellen onder aan een deurkozijn wordt aangebracht om de beide stijlen op de juiste afstand te houden. Wordt na het plaatsen van het kozijn verwijderd. (Haslinghuis)"@nl;
  skos:altLabel "steldorpel"@nl;
