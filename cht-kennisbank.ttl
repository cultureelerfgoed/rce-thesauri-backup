  a skos:Concept;
  skos:prefLabel "keratine"@nl;
  skos:scopeNote "Een vezelachtige proteïne die de chemische basis vormt van opperhuidweefsel zoals haar, hoorn, wol, nagels of veren. (Archeological Base Register)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/96dfb275-b038-4acd-a745-cfec32c1ee18>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/82185432-bca5-4440-a7d1-a1bb5fddb9e3>
  a skos:Concept;
