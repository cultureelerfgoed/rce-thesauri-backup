<https://data.cultureelerfgoed.nl/term/id/cht/53ed5542-7743-4431-ac2e-91efe171c6dd>
  a skos:Concept;
  skos:prefLabel "valgordijnen"@nl;
  skos:scopeNote "Valgordijnen zijn gordijnen die opgehouden worden door koorden aan haken. Nadat het koorden zijn losgemaakt vallen de gordijnen op hun plaats. Bij de rijkere huizen en buitenverblijven zijn valgordijnen toegepast, maar bij schouwburgen, theaters en poppenkasten komen ze ook voor. (Het Nederlandse interieur in beeld / C. Willemijn Fock e.a., Zwolle 2001/Historische zonwering / B.H.J.N. Kooij, RCE Brochure, Amersfoort, 2012)"@nl;
  skos:altLabel "valgordijn"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/cb336fbe-378b-4518-a816-900ea1345a0c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

