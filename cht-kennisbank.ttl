<https://data.cultureelerfgoed.nl/term/id/cht/7a758161-36fd-4f7c-974f-82858735f75e>
  a skos:Concept;
  skos:prefLabel "luchtgekoelde motoren"@nl;
  skos:scopeNote "Motor, die rechtstreeks wordt gekoeld door lucht die -meestal door een ventilator - over de koelribben van de cilinders en de cilinderkoppen wordt geblazen."@nl;
  skos:altLabel "luchtgekoelde motor"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/44ac60de-195d-45b2-8cf8-a46deb19ef7f>;
