<https://data.cultureelerfgoed.nl/term/id/cht/bf6cf815-78fd-4152-a00f-c08ca2da09f1>
  a skos:Concept;
  skos:prefLabel "leemgaten"@nl;
  skos:scopeNote "Leemgaten: gebrek in de vorm van holten in natuursteen ontstaan door het losraken van brokjes leem uit het gesteente"@nl;
  skos:altLabel "leemgat"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
