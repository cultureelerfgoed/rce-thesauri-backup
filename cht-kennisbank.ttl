  a skos:Concept;
  skos:prefLabel "olietemperatuurmeters"@nl;
  skos:scopeNote "De olietemperatuurmeter geeft aan wanneer de olie op haar bedrijfstemperatuur is."@nl;
  skos:altLabel "olietemperatuurmeter"@nl;
