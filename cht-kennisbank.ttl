<https://data.cultureelerfgoed.nl/term/id/cht/cc4a7e0e-bc77-406f-bd7d-f6a47c8acfc0>
  a skos:Concept;
  skos:prefLabel "flensmessen"@nl;
  skos:scopeNote "Groot, lang mes om een gevangen walvis langs het schip in stukken te snijden en om het spek er in repen af te halen."@nl;
