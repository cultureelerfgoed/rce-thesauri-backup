<https://data.cultureelerfgoed.nl/term/id/cht/67c8399a-266f-480d-97a7-ace80c97ac39>
  a skos:Concept;
  skos:prefLabel "handspaken"@nl;
  skos:scopeNote "Houten stok waarvan er meer op een as of in een wiel geplaatst zijn om daarmee met de hand de as of het wiel (kruirad) rond te draaien. (Haslinghuis)"@nl;
  skos:altLabel "handspaak"@nl;
