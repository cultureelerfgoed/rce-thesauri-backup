<https://data.cultureelerfgoed.nl/term/id/cht/77929248-3608-40d7-80ee-d131700614dc>
  a skos:Concept;
  skos:prefLabel "eetserviezen"@nl;
  skos:scopeNote "Serviezen om te gebruiken tijdens een diner met meerdere dinergasten. Meestal bestaand uit borden, schalen en koppen van verschillende afmetingen, soms ook andere voorwerpen zoals terrines, strooiers of decoratieve artikelen zoals vazen en pièces de milieus. (AAT-Ned)"@nl;
  skos:altLabel "eetservies"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2ab34639-aaf6-40b5-ad8e-07d2da0a0b1b>;
