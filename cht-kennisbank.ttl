<https://data.cultureelerfgoed.nl/term/id/cht/19690c38-6631-4aec-b29f-aa7c46236fb6>
  a skos:Concept;
  skos:prefLabel "sleutelgaten"@nl;
  skos:scopeNote "Gat in een deur, waardoor een sleutel in een slot kan worden gestoken. (Haslinghuis)"@nl;
