<https://data.cultureelerfgoed.nl/term/id/cht/4c255542-e846-479d-b1a5-4331d19195cb>
  a skos:Concept;
  skos:prefLabel "luchtschepen"@nl;
  skos:scopeNote "Luchtschepen zijn vervoermiddelen die vracht en passagiers door de lucht kunnen transporteren en die lichter zijn dan de omringende lucht. Blimps en Zeppelins zijn voorbeelden van luchtschepen."@nl;
  skos:altLabel "luchtschip"@nl;
