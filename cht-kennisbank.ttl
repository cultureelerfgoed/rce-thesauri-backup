<https://data.cultureelerfgoed.nl/term/id/cht/20358abd-7f1a-4877-b5e5-f80886c379fc>
  a skos:Concept;
  skos:prefLabel "specie"@nl;
  skos:scopeNote "Specie: mengsel van een mortel (mengsel van droge grondstoffen), water en eventuele middelen om eigenschappen als sterkte, aanhechting en dergelijke te verbeteren."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
