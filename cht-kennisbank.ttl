<https://data.cultureelerfgoed.nl/term/id/cht/e313243c-8dbc-4173-a9ef-8ccb7fc49889>
  a skos:Concept;
  skos:prefLabel "Chanoine-Pascaud-stuwkleppen"@nl;
  skos:scopeNote "Chanoine-Pascaud-stuwkleppen zijn metalen kleppen binnen klepstuwen, ontworpen om waterstromen te reguleren. Ze zijn gebaseerd op het Franse ontwerp van Chanoine en Pascaud (19e eeuw). De kleppen klappen op en neer bij wisselende waterstanden, wat ze geschikt maakt voor rivierstuwen. Ze behoren tot de groep klepstuwen binnen de waterbouwkunde."@nl;
  skos:altLabel "Chanoine-Pascaud-stuwklep"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/42ab6051-4c0b-443a-ace2-847aa798b4b5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/10a5487d-160e-486a-9344-2bf36b552d72>
  a skos:Concept;
  skos:prefLabel "uithaaldaken"@nl;
  skos:scopeNote "(oliemolen), bakje waarin het meel van de kapotgestampte koeken werd geschept. (met de schelp)"@nl;
