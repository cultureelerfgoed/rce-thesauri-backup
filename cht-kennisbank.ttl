  a skos:Concept;
  skos:prefLabel "Japans cipressenhout"@nl;
  skos:scopeNote "Japans cipressenhout is hout van de Japanse cipres, bekend om zijn duurzaamheid, lichte kleur en aromatische geur, vaak gebruikt in traditionele Japanse bouw."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/be0fa78e-1e5c-4948-aa00-fe360baab2d9>;
