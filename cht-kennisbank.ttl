<https://data.cultureelerfgoed.nl/term/id/cht/5597f3f4-b958-47ec-8c31-aa4c334f00ba>
  a skos:Concept;
  skos:prefLabel "natuurlijke hars"@nl;
  skos:scopeNote "Natuurlijke harsen zijn harsen van plantaardige (meestal) of dierlijke oorsprong. De meeste natuurlijke harsen bestaan uit terpenoïden. Zij lossen beter op in een organisch oplosmiddel dan in water."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/014237aa-5381-4dbe-8818-8d15931b3a34>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/9e289ff6-51d5-4b34-a9ba-08957711a38d>,
    <https://data.cultureelerfgoed.nl/term/id/cht/549de6c0-1bcb-46be-af00-a62eff15bd25>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ad635d83-8d1a-40e6-9a77-11112282c45d>
  a skos:Concept;
  skos:prefLabel "kopal"@nl;
  skos:scopeNote "Een algemene benaming voor fossiele en andere harde hars die wordt gevonden in bijna alle tropische landen en wordt gebruikt voor het maken van vernis, lak, hechtmiddelen en deklagen. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/014237aa-5381-4dbe-8818-8d15931b3a34>;
