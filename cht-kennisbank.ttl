  a skos:Concept;
  skos:prefLabel "draadsnijders"@nl;
  skos:scopeNote "Een draadsnijder wordt gebruikt voor het handmatig snijden van uitwendige schroefdraad."@nl;
  skos:altLabel "draadsnijder"@nl;
