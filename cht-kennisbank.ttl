<https://data.cultureelerfgoed.nl/term/id/cht/c1507be9-8f83-463a-8a1c-47d9821300f3>
  a skos:Concept;
  skos:prefLabel "pakketboten"@nl;
  skos:scopeNote "Pakketboten waren middelgrote boten die waren ontworpen voor binnenlands post-, passagiers- en vrachtvervoer in Europese landen en op Noord-Amerikaanse rivieren en kanalen, waarvan sommige met stoom werden aangedreven. Ze werden op grote schaal gebruikt in de 18e en 19e eeuw en hadden een regelmatige dienstregeling."@nl;
  skos:altLabel "pakketboot"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/32d80748-50d1-4c9c-b06d-dfca42e46ac6>;
