<https://data.cultureelerfgoed.nl/term/id/cht/f4a5838a-7ac7-4143-8d11-1be80a236751>
  a skos:Concept;
  skos:prefLabel "sluizenmolens"@nl;
  skos:scopeNote "Deze kleine molens kon men vroeger aantreffen bij de kanaalsluizen in Drenthe. Na het schutten van een of meer turfschepen pompten deze het water dat bij het schutten verloren was gegaan weer terug achter de sluis. Dit om het bovenstroomse deel van de kanalen op peil te houden. (Molenwoordenboek G.J. Pouw)"@nl;
  skos:altLabel "sluizenmolen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0198a25a-3469-469e-8103-a613e32fcdc6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c88f9ee0-db22-429c-8fed-96629979715c>
  a skos:Concept;
  skos:prefLabel "rolbanen"@nl;
  skos:scopeNote "Een rolbaan is een baan waarover een vliegtuig taxiet."@nl;
  skos:altLabel "taxibaan"@nl, "rolbaan"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a2971af0-cde7-4888-b828-33443f702e7d>;
