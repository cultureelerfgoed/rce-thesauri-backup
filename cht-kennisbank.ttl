  a skos:Concept;
  skos:prefLabel "bruine pigmenten"@nl;
  skos:scopeNote "Bruine pigmenten zijn kleurstoffen die worden gebruikt om materialen een bruine kleur te geven, vaak gewonnen uit natuurlijke bronnen zoals aarde of organisch materiaal."@nl;
  skos:altLabel "bruin pigment"@nl;
