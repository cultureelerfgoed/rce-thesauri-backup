<https://data.cultureelerfgoed.nl/term/id/cht/bdbf4733-200e-4722-a311-158019acf687>
  a skos:Concept;
  skos:prefLabel "haakstenen (blok)"@nl;
  skos:scopeNote "Natuurstenen overgangsblok van een muurvlak naar een daartegen geplaatste en ermee verbonden halve of driekwart kolom. (Haslinghuis)"@nl;
  skos:altLabel "haaksteen (blok)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4e481c81-319a-44da-86bf-106f145d22c1>;
