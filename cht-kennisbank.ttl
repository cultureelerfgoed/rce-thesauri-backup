<https://data.cultureelerfgoed.nl/term/id/cht/d98bc6b7-b9d3-44ef-98f7-baef679012bf>
  a skos:Concept;
  skos:prefLabel "luifels"@nl;
  skos:scopeNote "Luifels zijn horizontaal uitstekende gevelonderdelen die bescherming bieden tegen weersinvloeden. Deze afdakken vormen een onderdeel van de architectuur van een pand en kunnen uitstekend als zonwering dienen. Deze functie is vanwege de zonnestand alleen zinvol bij zuidgevels. Luifels dienen vooral om waren veilig uit te stallen."@nl;
  skos:altLabel "Luyffel"@nl, "luifel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4e481c81-319a-44da-86bf-106f145d22c1>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/2e671ade-fb30-4d8e-af7f-743a2524bcac>;
