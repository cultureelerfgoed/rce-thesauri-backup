<https://data.cultureelerfgoed.nl/term/id/cht/43ebd51a-0fd0-46d0-8043-1268f0a6eb1d>
  a skos:Concept;
  skos:prefLabel "polyisobutyleenfolie"@nl;
  skos:scopeNote "Polyisobutyleenfolie (pib) is de oudste thermoplastische kunststof dakbedekking. Sinds 1950 is dit product in de handel."@nl;
  skos:altLabel "pib"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/70b2da84-0d06-438f-a809-5d76078d4fa4>;
