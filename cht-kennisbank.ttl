  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/24e8bb26-d1fe-42e5-8500-38394c915d5f>
  a skos:Concept;
  skos:prefLabel "cargadoors"@nl;
  skos:scopeNote "Cargadoors regelen het laden en lossen van schepen. Zij coördineren vrachtstromen, documentatie en logistiek in de scheepvaart."@nl;
