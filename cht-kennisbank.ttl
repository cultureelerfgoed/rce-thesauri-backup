<https://data.cultureelerfgoed.nl/term/id/cht/6643cec0-54aa-4c51-a84a-67842f0e7345>
  a skos:Concept;
  skos:prefLabel "slakken (slakkenhoop)"@nl;
  skos:scopeNote "Slakken zijn gestolde resten van gesmolten as. Ze ontstaan als er te heet wordt gestookt en het assmeltpunt bereikt. De gesmolten as neemt na afkoeling de vorm van slakken aan. De oorzaak is doorgaans te wijten aan stookfouten. (Kachels / R. Rook, Utrecht/Aartselaar, 1985)"@nl;
  skos:altLabel "sintels (slakkenhoop)"@nl, "slak (slakkenhoop)"@nl, "sintel (slakkenhoop)"@nl;
