<https://data.cultureelerfgoed.nl/term/id/cht/c56ef013-5124-4d12-98b0-edb4cfe87ecb>
  a skos:Concept;
  skos:prefLabel "fly-overs"@nl;
  skos:scopeNote "Gebruik voor snelweg- of spoorwegbruggen die een barrière overbruggen, zoals een andere snelweg of spoorlijn, ofwel een 'kruisingsvrij verkeersknooppunt'. (AAT)"@nl;
  skos:altLabel "fly-over"@nl;
