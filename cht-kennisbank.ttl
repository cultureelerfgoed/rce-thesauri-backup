<https://data.cultureelerfgoed.nl/term/id/cht/c53c3471-3417-4789-a73e-de97e970bfc3>
  a skos:Concept;
  skos:prefLabel "hertshoorn"@nl;
  skos:scopeNote "Verwijst naar een carbonaat van ammonium dat ook wel hertshoorn wordt genoemd. Het is een wit poeder dat wordt gebruikt in reukzout, bakpoeder, textielverfstof en andere toepassingen. In de conservering wordt een oplossing van ammoniumcarbonaat gebruikt als oplosbaar makend middel voor de extractie van oplosbare zouten op verslechterde steenoppervlakken. (AAT)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4fc19669-5a77-4808-b382-575d43cc83a1>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b04b498d-d96b-43c1-a588-f2fcce86e4d6>
  a skos:Concept;
  skos:prefLabel "houtbakken"@nl;
