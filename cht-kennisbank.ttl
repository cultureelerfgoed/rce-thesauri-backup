  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2342eada-c9d9-4c19-8b12-91adc86808e2>
  a skos:Concept;
  skos:prefLabel "zakheiligdommen"@nl;
  skos:scopeNote "Devotieobject van slechts enkele centimeters groot, dat ter bescherming in de zak van jurk of pak werd gedragen. Het kan een kleine houder zijn met een heiligenbeeldje of een klein doosje met een of meer amuletten."@nl;
  skos:altLabel "zakheiligdom"@nl;
