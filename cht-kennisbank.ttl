  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2429d786-3d48-480f-99fb-9f21205bde0b>
  a skos:Concept;
  skos:prefLabel "doorgaand rijtuigen"@nl;
  skos:scopeNote "Een rijtuig dat achtereenvolgens met verschillende treinen meerijdt, om zodoende een overstapvrije verbinding te bieden op trajecten waar te weinig passagiersaanbod is voor een complete trein"@nl;
