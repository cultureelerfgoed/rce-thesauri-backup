<https://data.cultureelerfgoed.nl/term/id/cht/b8836d01-dd45-4578-8a7a-abb1659022e1>
  a skos:Concept;
  skos:prefLabel "keuvelens"@nl;
  skos:scopeNote "Keuvelens is de afschuining aan de korte zijde van een kap, onder andere van een windmolen. (Haslinghuis)"@nl;
  skos:altLabel "keuvelend"@nl, "keuveles"@nl;
