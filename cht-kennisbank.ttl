  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d6c18ce0-5eeb-47b1-9a07-544c112b386e>
  a skos:Concept;
  skos:prefLabel "rollenpalen"@nl;
  skos:scopeNote "Rollenpalen stonden bij bochten van kanalen of op een havenhoofd, waarlangs de treklijn van schepen wordt geleid om die schepen de bocht te laten nemen. (Thesaurus landschap)"@nl;
  skos:altLabel "rollenpaal"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a93191f2-7f3b-4efa-87f6-50ce3aa70adc>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d40e1a71-ed9f-4f95-85a8-ea6d1d2d96c6>
  a skos:Concept;
  skos:prefLabel "inundatiekommen"@nl;
  skos:scopeNote "Een inundatiekom is een gebied dat gebruikt wordt voor defensiedoeleinden, in tijden van oorlog of oorlogsgevaar een gebied onder water kan worden gezet. (Thesaurus landschap)"@nl;
  skos:altLabel "inundatiekom"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a93191f2-7f3b-4efa-87f6-50ce3aa70adc>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e1669c3b-7078-4a3e-8ffe-be7516e1adb8>
  a skos:Concept;
  skos:prefLabel "vouweren"@nl;
  skos:scopeNote "Vouweren zijn afscheidingen of omheiningen van verticale, op gelijke afstanden geplaatste en overdwars verbonden palen, staven of spijlen. (Rijksdienst voor het Cultureel Erfgoed)"@nl,
    """Vouweren zijn afscheidingen of omheiningen van verticale, op gelijke afstanden geplaatste en overdwars verbonden palen, staven of spijlen. (Rijksdienst voor het Cultureel Erfgoed)
"""@nl;
