<https://data.cultureelerfgoed.nl/term/id/cht/5e298d9b-c3fa-4a14-b927-8cbaa01b38a5>
  a skos:Concept;
  skos:prefLabel "parochies"@nl;
  skos:scopeNote "Te gebruiken voor delen van een groter kerkelijk bestuursgebied onder de zorg en invloed van een pastor. Ook te gebruiken voor delen van het plaatselijk bestuur, zoals in Engeland en de staat Louisiana, gebaseerd op of ontleend aan oorspronkelijke kerkelijke verdelingen. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/3902c205-ffc1-4a8a-9708-719de5763ce7>;
