<https://data.cultureelerfgoed.nl/term/id/cht/62cfc902-2f1e-4fd3-a3d4-3b5c507e4d26>
  a skos:Concept;
  skos:prefLabel "troggewelven"@nl;
  skos:scopeNote "Troggewelven zijn tongewelven waarvan de welflijn een klein gedeelte van een halve cirkel is. Ze hebben een geringe pijlen en worden in reeks gemetseld tussen houten of ijzeren liggers. Deze gewelven worden bv toegepast over kelders. (Haslinghuis)"@nl;
  skos:altLabel "troggewelf"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a93191f2-7f3b-4efa-87f6-50ce3aa70adc>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e04dacf0-bdd8-4998-bc1a-796558fbcd63>
  a skos:Concept;
  skos:prefLabel "wasschuiven"@nl;
  skos:scopeNote "In papiermolens, schuif niet kopergaas in de wasgoten, waardoor de papierstof werd tegengehouden en water en vuil wegspoelden. (Molenwoordenboek B.D. Poppen)"@nl;
  skos:altLabel "wasschuif"@nl, "wasvorm"@nl, "wasvormen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/04770e4f-1c11-40e7-a256-9de8c6d569c6>;
