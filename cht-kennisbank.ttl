<https://data.cultureelerfgoed.nl/term/id/cht/34ca4c81-8956-4094-be2b-023c0248e328>
  a skos:Concept;
  skos:prefLabel "cellengewelven"@nl;
  skos:scopeNote "Cellengewelven zijn veeldelige gewelven, in hoofdlijnen een netgewelf of waaiergewelf, maar bestaande uit een aantal kleine velden die ieder min of meer piramidevormig zijn. Vooral in baksteen uitgevoerd in de late gotiek. Ook Pruisisch gewelf genoemd, omdat het veel in de door Duitsers gekoloniseerde Oostzeelanden voorkomt. (Haslinghuis)"@nl;
  skos:altLabel "Pruisisch gewelf"@nl, "Pruisisch gewelven"@nl, "cellengewelf"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/76cb2c1a-25f3-4f5f-8f58-6eeff4c69a45>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

