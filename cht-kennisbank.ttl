  a skos:Concept;
  skos:prefLabel "röntgenfoto's"@nl;
  skos:scopeNote "Een röntgenfoto is een foto of digitale opname gemaakt met behulp van röntgenstraling.(Wikipedia)"@nl;
  skos:altLabel "röntgenfoto"@nl, "röntgenopname"@nl, "röntgenopnamen"@nl;
