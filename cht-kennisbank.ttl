<https://data.cultureelerfgoed.nl/term/id/cht/965bd84c-1557-4418-84c8-3f09abdbaeae>
  a skos:Concept;
  skos:prefLabel "dagtellers"@nl;
  skos:scopeNote "Kilometerteller met gewoonlijk slechts drie cijfers. Registreert de afstand die op een bepaalde reis is afgelegd, en kan door de bestuurder op nul worden teruggesteld."@nl;
  skos:altLabel "dagteller"@nl;
