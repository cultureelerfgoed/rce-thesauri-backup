<https://data.cultureelerfgoed.nl/term/id/cht/4dc90f37-1221-438c-908f-1ce9946b32f7>
  a skos:Concept;
  skos:prefLabel "pekeltrams"@nl;
  skos:scopeNote "Op basis van de Haagse GLT tram zijn pekeltrams, voorzien van pekeltanks, ontwikkeld. Verder hebben de pekeltrams een sneeuwschuiver."@nl;
  skos:altLabel "pekeltram"@nl;
