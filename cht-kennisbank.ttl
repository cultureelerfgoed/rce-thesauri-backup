<https://data.cultureelerfgoed.nl/term/id/cht/2aaedd56-b968-4f3b-b05e-cbec227a4ef9>
  a skos:Concept;
  skos:prefLabel "lesbisch marmer"@nl;
  skos:scopeNote "Een gelig-witte marmersoort met askleurige zwarte vlekken en grote, opmerkelijke kristallen. Het is afkomstig van het eiland Lesbos in Griekenland. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2fed2763-2e7c-4932-80fb-88c5fdf129f1>
  a skos:Concept;
  skos:prefLabel "bigio e nero di francia"@nl;
  skos:scopeNote "Marmer, meestal afkomstig uit het zuiden van Frankrijk, dat zich kenmerkt door gelige, bruine strepen en onzuivere zwarte en witte golven. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/341b6eb5-5ecf-4ce4-9ce0-7c76711af95d>
  a skos:Concept;
  skos:prefLabel "Languedoc-marmer"@nl;
  skos:scopeNote "Een compacte marmersoort in helderrood met witte vlekken, aangetroffen in de Montagne Noir en andere gebieden in de Pyreneeën. Lijkt op griottemarmer. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3e6b829d-0fca-473f-8b38-750e22eef1d6>
  a skos:Concept;
  skos:prefLabel "bianco e giallo"@nl;
  skos:scopeNote "Wit marmer uit Cappadocië, Turkije, lichtgeel geaderd met daaroverheen haarlijntjes in een donkerder tint geel. Het marmer kan zo fijn gepolijst worden dat het op een spiegel lijkt; om die reden zou keizer Domitianus dit marmer langs een hele gang hebben laten aanbrengen. Er is vrijwel niets van uit de oudheid bewaard gebleven. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3fa9d36c-0790-433b-8114-17f45c929f50>
  a skos:Concept;
  skos:prefLabel "giallo tigrato"@nl;
  skos:scopeNote "Een marmer dat wordt gekenmerkt door de gewolkte vermenging van zuiver wit, lichtbruin, lila-grijs en roze op een gele ondergrond. Het komt oorspronkelijk uit Korinthe. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4161b8d7-36ce-4803-a65f-c118046d2fc9>
  a skos:Concept;
  skos:prefLabel "bougard marble"@nl;
  skos:scopeNote "Een grijs-wit marmer dat qua uiterlijk vergelijkbaar is met Formosa-marmer en dat afkomstig is uit dezelfde regio in Duitsland; dit marmer is echter over het algemeen iets lichter van kleur dan Formosa-marmer. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/41cfd26d-a2a0-4d7b-98eb-194c0f4f49a6>
  a skos:Concept;
  skos:prefLabel "paragon"@nl;
  skos:scopeNote "Zwart marmer uit Griekenland en Egypte, dat werd gebruikt als toetssteen en vanaf de 16de eeuw in Verona om op te schilderen. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/498c831c-e5ed-4d68-a262-389a632f92e7>
  a skos:Concept;
  skos:prefLabel "rood porfiermarmer"@nl;
  skos:scopeNote "Een rood marmer dat vaak werd gebruikt in de oudheid. Het is te vinden in Cynopolis en Damarestica in Griekenland. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4b13323e-c1c5-4613-a953-6a061f5f04ef>
  a skos:Concept;
  skos:prefLabel "Sint Anna-marmer"@nl;
  skos:scopeNote "Een donkerblauw-zwart marmer met korte witte aderen, dat afkomstig is uit het Belgische Sint-Anna. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/56d01665-2e99-446f-ad64-bf4312c137d0>
  a skos:Concept;
  skos:prefLabel "Portor"@nl;
  skos:scopeNote "Donkergrijs, zwart of blauw marmer met goudgele aderen. O.a. uit Frankrijk, Italië (La Spezia) en Zwitserland. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/58d8e926-9515-476b-ab24-925f03331c5e>
  a skos:Concept;
  skos:prefLabel "tirio"@nl;
  skos:scopeNote "Een blauwachtig wit marmer dat lichtelijk bruin is gespikkeld en gevlekt. Dit marmer is afkomstig uit het Libanon-gebergte, vlakbij Tyre (het tegenwoordige Sur in Libanon). (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/59410199-bea2-4434-9599-0d4dcecf0d31>
  a skos:Concept;
  skos:prefLabel "Colorado joel statuair marmer"@nl;
  skos:scopeNote "Een fijnkorrelig, Amerikaans marmer dat geschikt is voor beeldhouwen. Het is zuiver wit van kleur, maar sommige soorten hebben een grijs waas. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/5c9588f2-d4dc-4f10-b4a3-a8c64805defb>
  a skos:Concept;
  skos:prefLabel "Arabescato"@nl;
  skos:scopeNote "Arabescato: marmer welke gewonnen wordt in de Apennijnen ten noorden van Carrara, Italië. De steen is altijd geaderd. De ondergrond is wit met gekleurde aderen die variëren van beige, rood, bruin, groen, grijs tot zwart. Het breukvlak is suikerkorrelig."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/5d971524-b5e8-43ae-91c6-82e1f6ec780b>
  a skos:Concept;
  skos:prefLabel "rancemarmer"@nl;
  skos:scopeNote "Een matrode marmersoort met blauwe en rode vegen en aderen. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/5f7f984c-52d8-4cb3-ba80-93ff1cfc9291>
  a skos:Concept;
  skos:prefLabel "Numidisch marmer"@nl;
  skos:scopeNote "De kleur van dit marmer varieert van geel, lichtbruin en roze tot dieprood. Het marmer is niet uit Numidië zelf afkomstig, maar uit de bergen van Algerije en Mauritanië. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/92d6ed0f-6f8c-49ac-aed0-6fbf99cc05a0>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/62ff44b4-3bb5-4b63-ae06-3a45fd722250>
  a skos:Concept;
  skos:prefLabel "Giallo di siena"@nl;
  skos:scopeNote "Giallo di Siena: marmer welke gewonnen wordt nabij Siena, Italië. In de steen komen steken veelvuldig voor; de platen worden doorgaans vanuit de groeve voorzien van een kunststof wapeningsnet aan de achterzijde. De lichte variant heeft een gele ondergrond en is sterk zalmkleurig tot okerkleurig geaderd en gewolkt met lichte vlekken en de donkere variant is geel tot okergeel met roodbruine aders en lichtere vlekken."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/63c20e4e-0e2c-495a-83d0-b394f858298c>
  a skos:Concept;
  skos:prefLabel "statuair marmer"@nl;
  skos:scopeNote "Zuiver wit marmer met een fijne kristallijne structuur, dat wordt gebruikt in de architectuur en de beeldhouwkunst. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/65a40dac-8313-4542-986b-638943395b19>
  a skos:Concept;
  skos:prefLabel "rosso verona"@nl;
  skos:scopeNote "Rosso Verona: marmer welke gewonnen wordt nabij Verona, Italië. De kleur van de steen varieert van licht tot donker rood met een gewolkte structuur. Grijs tot zwarte aders komen altijd voor, deze zijn niet of slecht vergroeid. Open gaten kunnen voorkomen. Het breukvlak is grofkorrelig."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6dd30367-b2d0-44cf-bd2a-637c3e1525b6>
  a skos:Concept;
  skos:prefLabel "Campan"@nl;
  skos:scopeNote "Marmersoort, groen met rode, grijze en witte plekken, afkomstig uit Campan (Pyreneeën), reeds door de Romeinen toegepast. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6ebb93d5-28ee-40c1-ba5d-343efb1ee4ff>
  a skos:Concept;
  skos:prefLabel "Purbeck marmer"@nl;
  skos:scopeNote "Marmer dat wordt gewonnen in de omgeving van het schiereiland Purbeck-eiland in het Engelse Dorset. Voornamelijk gebruikt als bouwsteen. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/6fdb9768-cd8f-4c2c-8c4c-3fa46347f4ec>
  a skos:Concept;
  skos:prefLabel "Parisch marmer"@nl;
  skos:scopeNote "Een transparant wit marmer met doorzichtige, schilferachtige kristallen. Het werd gewonnen op het eiland Paros in de Cycladen en het werd door de oude Grieken gebruikt voor beeldhouwkunst en architectuur. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/71621ee9-8bfc-473c-bef5-d87262a6c6fa>
  a skos:Concept;
  skos:prefLabel "rosso di francia"@nl;
  skos:scopeNote "Een rood marmer met grote onregelmatige en vuursteenachtige blauwe vlekken. Komt oorspronkelijk uit het zuidoosten van Frankrijk. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/72a4cdde-6219-44ee-993e-3c09352e99d8>
  a skos:Concept;
  skos:prefLabel "Portasantamarmer"@nl;
  skos:scopeNote "Een purperachtige rood-wit gewolkte steen afkomstig van het eiland Iasus of het eiland Chios. Naar men zegt was het in de oudheid geliefd bij keizer Claudius. Later werd het gebruikt in de deurposten van de Porta Santa van de Sint-Pietersbasiliek in Rome. Hier komt ook de naam vandaan. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/72b08b9f-1ec7-466d-89a1-5aca6c4fc6c0>
  a skos:Concept;
  skos:prefLabel "nero antico"@nl;
  skos:scopeNote "Een zwart marmer voor sierdoeleinden, waar fragmenten van werden gevonden rond Romeinse ruïnes en waarvan men vermoedt dat het afkomstig was uit Laconië. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/72b3c3df-a266-4c26-aa4c-6928d600d78e>
  a skos:Concept;
  skos:prefLabel "Rockingham zwart marmer"@nl;
  skos:scopeNote "Een gitzwart marmer met onregelmatige witte aders. Het komt voor in Virginia en wordt beschouwd als het meest hoogwaardige Amerikaanse marmer. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/75ee16b3-f57c-4599-be8d-3107555522da>
  a skos:Concept;
  skos:prefLabel "Cockeysville-marmer"@nl;
  skos:scopeNote "Een fijnkorrelig, magnesiumrijk, wit marmer uit Cockeysville, Maryland. Het bevat spaarzame bleke strepen of stroken die een vaalgrijs effect creëren. Het is een van de meest populaire marmersoorten die in de 19de eeuw werden gebruikt in gebouwen in Washington D.C., onder andere in het bovenste tweederde deel van het Washington Monument, en in de monolithische zuilen van de aangebouwde delen van het Capitool. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/75f17cd8-bb2f-4efa-82a7-1b37c4859336>
  a skos:Concept;
  skos:prefLabel "Formosa marmer"@nl;
  skos:scopeNote "Een grijs-wit gespikkeld marmer, soms ook met rode vlekken, afkomstig uit Nassau in Duitsland. Dit marmer bevat vaak een grote hoeveelheid fossielen. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/76decec4-2fcd-4bb4-b3de-decf897ae332>
  a skos:Concept;
  skos:prefLabel "vert Tinos"@nl;
  skos:scopeNote "Marmer uit Griekenland met donkergroen fond en lichtgroene levendige adering, veroorzaakt door het mineraal serpentijn. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/81ec9c80-4364-4800-9877-0be27aa940e7>
  a skos:Concept;
  skos:prefLabel "bigio e nero antico"@nl;
  skos:scopeNote "Een marmer van het Turkse eiland Marmara Adasi (stond in de oudheid bekend als het eiland Proconnesus in de Zee van Marmara). Het heeft een vage grijze kleur met zwarte aders en hoekvormige witte vlekken, of het heeft hoekvormige zwarte delen op een witte ondergrond. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/852afbce-a2fc-46db-8209-249cacb22869>
  a skos:Concept;
  skos:prefLabel "noir de Mazy"@nl;
  skos:scopeNote "Belgisch zwart marmer zonder witte vlekken, in feite een kalksteen uit het Devoon. Vindplaats ten westen van Namen. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/86e4dddb-84ec-4fca-b3b9-f3d42e3d7aa7>
  a skos:Concept;
  skos:prefLabel "Carraramarmer"@nl;
  skos:scopeNote "Wit, soms blauw geaderd marmer uit de rijke groeven van Carrara in de Alpi Apuane. Die liggen dicht bij zee, en via de havenplaats Avenza was de steen gemakkelijk te verschepen. De Romeinen kenden de groeven al onder de naam Lapidicinae Lunenses. Men onderscheidt de soorten statuario (zuiver wit), bianco di Carrara (wit met adertjes) en bardiglio (grijs). (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/f6b56af8-9338-4997-8ede-95619d42c741>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/87c45497-2d06-4014-a637-c6c0df1e9878>
  a skos:Concept;
  skos:prefLabel "Eleusinisch marmer"@nl;
  skos:scopeNote "Een fijn, zwart marmer uit Attica, geliefd in het oude Griekenland, dat vooral werd gebruikt voor friezen en binnenhuisarchitectuur. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8851396e-8cff-4c8d-a6f2-3bba522e15e5>
  a skos:Concept;
  skos:prefLabel "griotte-marmer"@nl;
  skos:scopeNote "Een purperachtig rood marmer, soms met witte vlekken, te vinden in de vallei van Barouse en andere gebieden in de Franse Pyreneeën. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/93f272ca-8311-4a3b-b8fa-10fd588f9521>
  a skos:Concept;
  skos:prefLabel "Lee marmer"@nl;
  skos:scopeNote "Type wit marmer met middelfijne structuur afkomstig uit Lee, Massachusetts. Het kan soms lichtgrijs van uiterlijk zijn. Een dunne band Lee marmer is gebruikt in het Washington-monument in Washington, D.C. maar het bleek te duur te zijn. Het is echter wel gebruikt in sommige delen van het Capitool, dat werd gebouwd in de jaren 50 van de 19de eeuw. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/949c0bda-a357-45f9-a9b8-d5397e618080>
  a skos:Concept;
  skos:prefLabel "verde di levanto"@nl;
  skos:scopeNote "Een serpentijn uit de Italiaanse Rivièra, tussen La Spezia en Genua. Er zijn twee varianten: de ene is purperachtig of zwart gevlekt en donkerrood met enkele groene kiezels of aders, de andere is groen met veel witte aders. Het is moeilijk te bewerken, maar glanst wel snel. Het lijkt op sommige soorten gevlekt marmer uit de Amerikaanse staat Tennessee. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/9a96a662-8d30-4287-a5a4-5cdcd71bb012>
  a skos:Concept;
  skos:prefLabel "Bottinico marmer"@nl;
  skos:scopeNote "Italiaanse marmersoort die donker, crèmekleurig, licht crèmekleurig met bruine markeringen of lichtbruin met witachtige vlekken kan zijn. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/9bb8e7bf-0ea2-4a03-b365-1b50b38286bc>
  a skos:Concept;
  skos:prefLabel "luculleummarmer"@nl;
  skos:scopeNote "Egyptisch marmer dat door koolstof zwart van kleur is. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/9f86d7d1-030c-4820-86d5-a7dc5b345a2d>
  a skos:Concept;
  skos:prefLabel "roze Tennessee-marmer"@nl;
  skos:scopeNote "Een fijn, roze marmer, geschikt voor beeldhouwwerk, dat in een aantal variaties wordt gevonden. Tennessee-marmers zijn over het algemeen harder en compacter dan andere Amerikaanse marmers, waardoor ze geschikter zijn voor gebruik buitenshuis, maar waardoor ze ook moeilijker kunnen worden bewerkt en gepolijst. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a2b2fd8f-f79a-4972-8642-74606345c662>
  a skos:Concept;
  skos:prefLabel "Hymettisch marmer"@nl;
  skos:scopeNote "Een blauwachtig wit marmer met stroken van parallelle grijze lijnen, dat afkomstig is uit Mount Hymettus, in de buurt van Athene. Als gevolg van de aanwezigheid van kleine talkaderen kan het soms lichtgroen van kleur zijn. Het verspreidt een onaangename geur wanneer het in stukken wordt gezaagd of wanneer het wordt gewreven. Dit marmer wordt hierom soms ook âuienmarmerâ of 'marmor cipolla' genoemd. Hymettisch marmer werd vaak gebruikt voor zowel heidense als christelijke sarcofagen. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a739c4c9-7022-497c-afa9-8b454f2b3a68>
  a skos:Concept;
  skos:prefLabel "turquin"@nl;
  skos:scopeNote "Italiaans marmer, blauw met witte aderen. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
