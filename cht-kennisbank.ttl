<https://data.cultureelerfgoed.nl/term/id/cht/045db438-c304-4319-839a-fa7a6b957be4>
  a skos:Concept;
  skos:prefLabel "specieborden"@nl;
  skos:scopeNote "Rechthoekig houten plankje dat aan een lange en aan een korte kant een opstaande kant heeft. Aan de onderzijde is een stok als handvat aangebracht."@nl;
  skos:altLabel "speciebord"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
