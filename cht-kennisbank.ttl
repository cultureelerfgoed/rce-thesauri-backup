<https://data.cultureelerfgoed.nl/term/id/cht/fe944ecb-9c86-4a8e-87e0-f196bac83383>
  a skos:Concept;
  skos:prefLabel "jacht"@nl;
  skos:scopeNote "Jacht is het jagen op dieren. Jagen is het vervolgen van dieren, in het bijzonder wilde dieren, met als doel om het buit te maken en te doden. Er zijn drie hoofdvormen van jacht, te weten: jacht met honden, jacht met roofvogels en vangjacht. (Van Dale)"@nl;
  skos:altLabel "drijven (jacht)"@nl, "jaag"@nl, "jagen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/4242ae9e-ffa8-43be-9a08-e6fe9ca87da2>;
