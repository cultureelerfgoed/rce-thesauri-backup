<https://data.cultureelerfgoed.nl/term/id/cht/e35dc354-0676-46a1-8f45-49fadb969cc7>
  a skos:Concept;
  skos:prefLabel "klinkerwegen"@nl;
  skos:scopeNote "Klinkerwegen zijn wegen met een bestrating van klinkers, toegepast voor duurzaamheid en esthetiek."@nl;
