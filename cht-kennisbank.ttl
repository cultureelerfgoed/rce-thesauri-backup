<https://data.cultureelerfgoed.nl/term/id/cht/9fc66d89-a20e-4145-864f-025c2a22b299>
  a skos:Concept;
  skos:prefLabel "oplosmiddelen"@nl;
  skos:scopeNote "Een oplosmiddel is een vloeistof waarin een andere stof kan oplossen, hetzij vast, vloeibaar of gasvormig."@nl;
