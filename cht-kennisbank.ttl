<https://data.cultureelerfgoed.nl/term/id/cht/b9250173-4436-4bf1-b201-ae7a7b79f1d6>
  a skos:Concept;
  skos:prefLabel "acrylonitrilbutadieen styreen"@nl;
  skos:scopeNote "Acrylonitril-butadieen-styreen (ABS) is een thermoplast en een copolymeer dat gebruikt wordt voor starre voorwerpen. Het bestaat uit 5 tot 30% 1,3-butadieen en zo'n 50% styreen, met de rest acrylonitril."@nl;
  skos:altLabel "acrylonitril-butadieen-styreen"@nl, "ABS"@nl, "acrylonitrilbutadieenstyreen"@nl;
