<https://data.cultureelerfgoed.nl/term/id/cht/a8269327-4f59-4d4a-a0db-bb0fa069469c>
  a skos:Concept;
  skos:prefLabel "vlek"@nl;
  skos:scopeNote "Een vlek is een verkleurde plek op een voorwerp, veroorzaakt door de afzetting van een verontreiniging uit een oplossing. De vlek kan zich als een kleurstof aan een object hechten."@nl,
    "Een vlek is een lokale vervuiling of verkleuring veroorzaakt door een niet inherent materiaal dat IN de verflaag is gedrongen, of chemisch gereageerd heeft met de laag."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/df8b3e91-b4a3-4310-a6d0-e6bebea9e810>
  a skos:Concept;
