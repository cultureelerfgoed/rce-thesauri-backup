<https://data.cultureelerfgoed.nl/term/id/cht/48c50b0e-e237-4d7d-9393-48bf9f95f964>
  a skos:Concept;
  skos:prefLabel "streekdorpen"@nl;
  skos:scopeNote "Een streekdorp is een lang uitgestrekt dorp dat zich heeft ontwikkeld langs een kanaal, dijk, weg, oeverwal of kreekrug. Hierdoor ontstaat langgerekte, aaneengesloten bebouwing die ook wel lintbebouwing of lineaire bebouwing wordt genoemd. (Wikipedia)"@nl;
  skos:altLabel "dijkdorp"@nl, "dijkdorpen"@nl, "lintdorp"@nl, "lintdorpen"@nl, "straatdorp"@nl,
