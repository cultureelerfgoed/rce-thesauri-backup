<https://data.cultureelerfgoed.nl/term/id/cht/e3cde916-fba3-4cd9-967a-fa975dd76aea>
  a skos:Concept;
  skos:prefLabel "akten"@nl;
  skos:scopeNote "Meestal gewaarmerkte documenten waarin een eigendomsoverdracht wordt vastgelegd, met name met betrekking tot onroerend goed. (AAT-Ned)"@nl;
  skos:altLabel "akte"@nl;
