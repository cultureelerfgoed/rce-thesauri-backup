<https://data.cultureelerfgoed.nl/term/id/cht/7806bbb4-bea8-48c3-8922-f2e82d200381>
  a skos:Concept;
  skos:prefLabel "proces"@nl;
  skos:scopeNote "Een proces is een serie logische, samenhangende activiteiten die leiden tot een van te voren bepaald doel."@nl;
