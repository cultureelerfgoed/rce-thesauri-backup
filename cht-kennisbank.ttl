<https://data.cultureelerfgoed.nl/term/id/cht/b0ed6b25-1eaa-4f59-95d8-4a629a466d5f>
  a skos:Concept;
  skos:prefLabel "hevelaken"@nl;
  skos:scopeNote "Aak waarbij de planken van het vlak in het voorschip tot ver boven de waterlijn omhooggebogen zijn. Is geschikt voor vlak en stromend water. De ‘Hagenaar’ en de ‘Hasselteraak’ zijn hevelaken. (MARDOC)"@nl;
  skos:altLabel "hevelaak"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/8a3ac8f9-6f7b-4c51-8742-c6499601ce5b>;
