    <https://data.cultureelerfgoed.nl/term/id/cht/7bc77065-548e-457f-965b-5cab1b10da41>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/06106942-1b08-4fc7-b913-4e7c5867222e>
  a skos:Concept;
