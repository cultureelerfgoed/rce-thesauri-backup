<https://data.cultureelerfgoed.nl/term/id/cht/fd393538-b9f2-4b68-8623-ae2ab17d1dca>
  a skos:Concept;
  skos:prefLabel "pasadizo's"@nl;
  skos:scopeNote "Geheime gang, zoals die in Spaanse koninklijke paleizen voorkwamen (Madrid). (Haslinghuis)"@nl;
