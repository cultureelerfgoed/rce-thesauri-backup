  a skos:Concept;
  skos:prefLabel "Florale Jugendstil"@nl;
  skos:scopeNote "Florale Jugendstil is een subtak van de Jugendstil waarbij asymmetrie en zogenaamde zweepslagmotieven van belang zijn. (Bouwstijlen in Nederland 1040-1940 / Roland Blijdestijn, Ronald Stenvert, 2000)"@nl;
