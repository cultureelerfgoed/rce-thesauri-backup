<https://data.cultureelerfgoed.nl/term/id/cht/d3e3b73b-237b-4c87-8896-6a4e7c5c684d>
  a skos:Concept;
  skos:prefLabel "erfverpachter"@nl;
  skos:scopeNote "De Erfverpachter is de eigenaar die zijn onroerende zaak belast met een recht van erfpacht ten behoeve van de erfpachter."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a25a2f3d-a179-41c7-8d37-cd4da30b7d9f>;
