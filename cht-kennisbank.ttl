<https://data.cultureelerfgoed.nl/term/id/cht/ffcd6ff9-d05b-41ae-9cf8-787818606a88>
  a skos:Concept;
  skos:prefLabel "spermaceti-olie"@nl;
  skos:scopeNote "Van/met spermaceti gemaakte olie; dient o.m. als smeermiddel bij temperaturen rondom het vriespunt."@nl;
