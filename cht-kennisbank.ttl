<https://data.cultureelerfgoed.nl/term/id/cht/65d6cb4e-a18f-4962-9fc2-eec2ee55e114>
  a skos:Concept;
  skos:prefLabel "busstations"@nl;
  skos:scopeNote "Busstations zijn grote haltes waar verschillende buslijnen samenkomen en waar passagiers kunnen overstappen."@nl;
