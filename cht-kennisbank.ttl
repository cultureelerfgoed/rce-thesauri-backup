<https://data.cultureelerfgoed.nl/term/id/cht/fa32817e-de13-4fbb-a7ea-9d89cc272681>
  a skos:Concept;
  skos:prefLabel "wegkruizen"@nl;
  skos:scopeNote "Een wegkruis is een in katholieke streken veelvoorkomend gedenkteken op de kruising van wegen en straten. Het is een religieuze uiting die de voorbijganger eraan herinnert dat Christus aan het kruis is gestorven. (Wikipedia)"@nl;
  skos:altLabel "veldkruis"@nl, "veldkruizen"@nl, "wegkruis"@nl;
