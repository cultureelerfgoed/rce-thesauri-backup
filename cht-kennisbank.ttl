<https://data.cultureelerfgoed.nl/term/id/cht/0f753f98-abdc-4ee0-a15c-f5992cc7c895>
  a skos:Concept;
  skos:prefLabel "rosmolenkotten"@nl;
  skos:scopeNote "Vier-, zes-, achthoekig of rond rosmolengebouw. (Molenwoordenboek G.J. Pouw)"@nl;
