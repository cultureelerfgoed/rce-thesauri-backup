  a skos:Concept;
  skos:prefLabel "kunstroven"@nl;
  skos:scopeNote "Kunstroven verwijst naar de illegale toe-eigening van kunstwerken, vaak tijdens conflicten of oorlogen, waarbij deze werken worden gestolen en vaak verkocht of verborgen. Het valt binnen de bredere categorie roven."@nl;
  skos:altLabel "kunstroof"@nl;
