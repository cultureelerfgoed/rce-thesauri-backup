<https://data.cultureelerfgoed.nl/term/id/cht/19758542-86e4-4b1c-b698-d5dd707ec789>
  a skos:Concept;
  skos:prefLabel "doorbinden"@nl;
  skos:scopeNote "Doorbinden is het opbossen van veldbossen uit een rietoogstgebied, doorgaans een waterrijk gebied. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/190b9fce-fb0d-4b41-b46d-e1795ae38304>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/19a7bb98-d3d9-4407-a8f2-15758ae2475d>
  a skos:Concept;
  skos:prefLabel "vrachtauto's"@nl;
  skos:scopeNote "Wagens voor goederenvervoer. Gebruik 'sleperswagens' voor voertuigen getrokken door paarden, die meestal geen zijkanten hebben, met horizontale draagvlakken en met de achterwielen lager gezet dan het vloerniveau. (AAT-Ned)"@nl;
  skos:altLabel "vrachtauto"@nl, "vrachtwagen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/dec3cb60-0105-49ac-a19f-d52c1f1ac5b4>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/51aac881-b569-4184-ba87-cfda4ac4c346>,
