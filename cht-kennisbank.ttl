  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/223a1bee-0bed-4a6d-9242-09e377f8bb17>
  a skos:Concept;
  skos:prefLabel "zuigermantels"@nl;
