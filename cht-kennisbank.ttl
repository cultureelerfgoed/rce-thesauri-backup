  a skos:Concept;
  skos:prefLabel "tintinnabulums"@nl;
  skos:scopeNote "Ceremonieel klokje aan een draagstok voorzien van het wapen van de kerk of de titelheilige. Onderscheidingsteken voor een door de paus als zodanig aan-geduide basilica minor (dit zijn de basilieken buiten de stad Rome). Staat in een standaard opgesteld aan de zuidzijde van het altaar, steeds in combinatie met het conopeum, dat aan de noordzijde van het altaar staat."@nl;
  skos:altLabel "tintinabulum"@nl, "tintinnabulum"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/abfc1bb7-04d7-43a0-9e99-dd4c5a4f2c15>;
