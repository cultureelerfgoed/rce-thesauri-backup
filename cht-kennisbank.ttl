<https://data.cultureelerfgoed.nl/term/id/cht/16833701-6897-4d16-a543-890bf6019bb2>
  a skos:Concept;
  skos:prefLabel "kilometerraaien"@nl;
  skos:scopeNote "Lijnen, loodrecht op de lengteas van een rivier, gedacht op onderlinge afstand van 1 kilometer als indeling van het traject. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "kilometerraai"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/929f2b49-e558-4543-a710-41a893c3c5dd>;
