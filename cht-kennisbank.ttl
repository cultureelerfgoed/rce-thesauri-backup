<https://data.cultureelerfgoed.nl/term/id/cht/0ca47650-b6f5-4278-819b-d07d156e6796>
  a skos:Concept;
  skos:prefLabel "cannalures"@nl;
  skos:scopeNote "Cannalures zijn decoratieve groeven of ribbels die vaak worden aangetroffen in klassieke architectuur of kunstvoorwerpen, met name in zuilen en andere architectonische elementen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f6b4e26a-f95c-4539-8039-9ad242401217>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/ac6cdf27-9013-4b2f-a300-fb3143cb7624>
  a skos:Concept;
  skos:prefLabel "cargadoorlepels"@nl;
  skos:scopeNote "Cargadoorlepels zijn speciale lepels die werden gebruikt door cargadoors (scheepsmakelaars) in de maritieme handel, vaak als ceremonieel of symbolisch object."@nl;
  skos:altLabel "cargadoorslepel"@nl, "cargadoorlepel"@nl, "Oostzeelepels"@nl, "Ooostzeelepel"@nl,
    "cargadoorslepels"@nl;
