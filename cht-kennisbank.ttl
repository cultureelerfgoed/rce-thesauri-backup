<https://data.cultureelerfgoed.nl/term/id/cht/b888a15c-631d-443c-84b5-d8578b63c790>
  a skos:Concept;
  skos:prefLabel "blusemmers"@nl;
  skos:scopeNote "In sommige kerken zijn nog (eeuwen)oude blusemmers aanwezig, vervaardigd van leer en touw of metaal. De blusemmers werden vanaf de gracht of de waterput aan elkaar doorgegeven tot aan de vlammen."@nl;
  skos:altLabel "blusemmer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/741ce018-10d2-4f48-abe1-95bfd4c08fdd>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/7fb90b56-36bb-4964-afa2-b39358a438bc>
  a skos:Concept;
  skos:prefLabel "mengvaten"@nl;
  skos:scopeNote "Een mengvat is een vat om vloeistoffen met elkaar te mengen. Voorbeeld: water en wijn."@nl;
  skos:altLabel "mengvat"@nl, "pronkemmer"@nl, "pronkemmers"@nl;
