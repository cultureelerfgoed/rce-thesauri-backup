<https://data.cultureelerfgoed.nl/term/id/cht/34e78c89-97ec-4437-8924-308792196bbe>
  a skos:Concept;
  skos:prefLabel "stadsmeierrecht"@nl;
  skos:scopeNote "Een Stadsmeierrecht is elk altijd durend gebruiksrecht, dat voortvloeit uit een overeenkomst tussen de gemeente Groningen en een persoon aan wie daarbij door die gemeente een altijddurend gebruiksrecht is toegekend op aan de gemeente toebehorende onroerende zaken gelegen in Oost-Groningen en de Gronings-Drentse Veenkolonieën."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bcc9ece8-29e8-46f8-b0ab-144d51f43c72>;
