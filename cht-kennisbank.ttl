<https://data.cultureelerfgoed.nl/term/id/cht/59c3e23d-8242-4382-a1da-c2b8233d2337>
  a skos:Concept;
  skos:prefLabel "galerijgraven"@nl;
  skos:scopeNote "Galerijgraven zijn graven in een bovengrondse wand of muur waarvan er meerdere boven en/of naast elkaar (in galerijen) in een muur of heuvel worden geplaatst. De toepassing is overgenomen uit landen als Italië en Spanje. (Uitvaart.nl)"@nl;
  skos:altLabel "galerijgraf"@nl, "inschruifgraf"@nl, "inschuifgraven"@nl;
