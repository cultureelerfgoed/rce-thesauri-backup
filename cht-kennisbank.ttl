<https://data.cultureelerfgoed.nl/term/id/cht/6571ba62-a2b4-47d3-a9e3-95a9602ac2c6>
  a skos:Concept;
  skos:prefLabel "zerkenlichters"@nl;
  skos:scopeNote "Houten constructie waarmee de zware zerken in de kerk of op het kerkhof werden opgetild."@nl;
  skos:altLabel "zerkenlichter"@nl;
