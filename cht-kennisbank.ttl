<https://data.cultureelerfgoed.nl/term/id/cht/e2a890ca-2f45-4f04-bab7-1f86545956a8>
  a skos:Concept;
  skos:prefLabel "Christiaans hout"@nl;
  skos:scopeNote "Christiaans hout is naaldhout dat afkomstig is uit Noorwegen en via Christiania is ingevoerd. Christiania is een oude naam voor de stad Oslo. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e367e686-7fb0-4d33-8626-8aa2967e3d14>
  a skos:Concept;
  skos:prefLabel "Danzigs hout"@nl;
  skos:scopeNote "Hout, afkomstig uit de omgeving van Danzig (thans Gdansk, Polen), zowel eiken (barde danzekins hout: 1365 Damme – W.V., sluis; 1409 Westkapelle – W.V.) als grenen (1774 Nijkerk – Gld.; 1838 Amsterdam, Mozes en Aäronkerk). (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e60b1648-41ea-402f-a457-9f29f5fc14b1>
  a skos:Concept;
  skos:prefLabel "Meyenburgs hout"@nl;
  skos:scopeNote "Meyenburgs hout is hout dat afkomstig is uit de omgeving van Meyenburg (in Meckelenburg aan een zijrivier van de Elbe), waarnaast loofhout ook naaldhout voorkomt. (Haslinghuis)"@nl;
  skos:altLabel "Meyenburgse delen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6a52c326-d332-461d-8861-92db384c2f1d>;
