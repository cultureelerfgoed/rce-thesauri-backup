<https://data.cultureelerfgoed.nl/term/id/cht/df8d1e07-da84-4c0f-ba22-fac35c7a3949>
  a skos:Concept;
  skos:prefLabel "beenderhuizen"@nl;
  skos:scopeNote "Beenderhuisjes zijn kleine gebouwtjes voor het bewaren van knekels uit geruimde graven. Uit ruimtebesparende overwegingen ruimt men graven na een bepaalde periode. In het verleden was het de gewoonte deze te bewaren in knekelhuisjes (Latijn: ossuarium). Zo'n huisje noemde men: knekel-, beenderen- of bottenhuisje. In Nederland is er niet één meer van over maar het gebruik is er nog wel. De knekels worden nu meestal begraven in een knekelput of verzamelgraf. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "beenderhuis"@nl, "beenderhuisje"@nl, "beenderhuisjes"@nl, "bekkeneelshuisje"@nl,
    "bekkeneelshuisjes"@nl, "knekelhuis"@nl, "knekelhuisje"@nl, "knekelhuisjes"@nl, "knekelhuizen"@nl,
    "ossuarium"@nl, "ossuariums"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ff83794d-1f6f-430b-aa7d-1b9d1a38ceb6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

