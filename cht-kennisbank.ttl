<https://data.cultureelerfgoed.nl/term/id/cht/079feecf-1fde-429a-b57c-1d6260e66701>
  a skos:Concept;
  skos:prefLabel "divisies"@nl;
  skos:scopeNote "Onderverdeling met ondergeschiktheid van kleinere delen van een ruimte (gotiek), ruimtevorm. (Haslinghuis)"@nl;
  skos:altLabel "divisie"@nl;
