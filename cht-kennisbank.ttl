<https://data.cultureelerfgoed.nl/term/id/cht/0c4a38ab-e2ad-4f46-a49e-d68106160d24>
  a skos:Concept;
  skos:prefLabel "professiekruizen"@nl;
  skos:scopeNote "Een houten kruis dat werd uitgereikt bij de inkleding van religieuzen."@nl;
  skos:altLabel "professiekruis"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5d0e5e7e-9034-4fdc-8888-a2580cf24c48>;
