<https://data.cultureelerfgoed.nl/term/id/cht/5586670a-1663-48c1-8728-7142f211317a>
  a skos:Concept;
  skos:prefLabel "essenhout"@nl;
  skos:scopeNote "Essenhout is het hout van de es (Fraxinus excelsior). Essenhout is taai en sterk en is vooral gebruikt voor het vervaardigen van gereedschappen. (Haslinghuis)"@nl;
  skos:altLabel "essehout"@nl, "essen (hout)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ba6bdd8e-2f33-4268-a6a0-791e94a6a782>;
