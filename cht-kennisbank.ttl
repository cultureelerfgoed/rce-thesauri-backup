<https://data.cultureelerfgoed.nl/term/id/cht/1679a9de-cdb8-41b2-b46a-be7e2ba3c623>
  a skos:Concept;
  skos:prefLabel "tunneltraversen"@nl;
  skos:scopeNote "Tunneltraverses zijn verbindende tunnels die dwars onder de sporen van het spoorwegemplacement lopen zodat de reiziger niet over de sporen hoeft te lopen bij het oversteken naar een ander perron."@nl;
  skos:altLabel "tunneltraverse"@nl, "tunneltraverses"@nl;
