<https://data.cultureelerfgoed.nl/term/id/cht/94c6c301-7710-4c85-a984-fe3bd4ca4185>
  a skos:Concept;
  skos:prefLabel "disselbomen"@nl;
  skos:scopeNote "Een dissel is een buis of V-vormige stang waarmee men een wagen, koets of aanhangwagen koppelt aan het trekdier of het trekkende voertuig, bijvoorbeeld een auto, vrachtwagen of tractor. (Wikipedia)"@nl;
  skos:altLabel "disselboom"@nl, "wagenboom"@nl;
