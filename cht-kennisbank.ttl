<https://data.cultureelerfgoed.nl/term/id/cht/acaf516d-fd7a-41a1-b446-0d47d05575e8>
  a skos:Concept;
  skos:prefLabel "linnenpersen"@nl;
  skos:scopeNote "Eikenhouten pers waarmee, vaak in meer lagentussen een aantal planken, linnengoed werd glad geperst, nadat het eerst was gereinigd, gebleekt, gesteven, gedroogd en gemangeld. Staat in menig pastorie en klooster, waar hij herinnert aan de tijd voor het strijkijzer."@nl;
  skos:altLabel "lakenpers"@nl, "lakenpersen"@nl, "linnenpers"@nl;
