  a skos:Concept;
  skos:prefLabel "stereobaten"@nl;
  skos:scopeNote "Onderbouw van m.n. Griekse tempel, afgedekt door de (zie) enthynteria. Daarop staat de (zie) crepidoma, waarvan de bovenste trede de (zie) stylobaat is. (Haslinghuis)"@nl;
