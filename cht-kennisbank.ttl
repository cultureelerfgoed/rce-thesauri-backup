<https://data.cultureelerfgoed.nl/term/id/cht/e7aa9bda-fdba-4096-8358-00b93a1f45d4>
  a skos:Concept;
  skos:prefLabel "waterplannen"@nl;
  skos:scopeNote "Waterplannen zijn beleidsplannen waarin door gemeenten, provincies of anderen administratieve gebieden een visie wordt gegeven over al het openbare water en uitspraken worden gedaan over beeldbepalende watergebieden die in beheer zijn bij particulieren. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "waterplan"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/3e629a26-b406-4b7e-9ed7-b8106946b067>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e7f3684c-3753-48ae-9ef9-b5656899e70b>
  a skos:Concept;
  skos:prefLabel "hangen"@nl;
  skos:scopeNote "Als je een tentoonstelling ‘hangt’, stel je schilderijen tentoon in een tentoonstellingsruimte."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/190b9fce-fb0d-4b41-b46d-e1795ae38304>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e7f63224-d471-4be2-9ef8-414faa6ce29e>
  a skos:Concept;
  skos:prefLabel "smidstangen"@nl;
  skos:scopeNote "Smidstangen zijn lange smalle ijzeren tangen die de smeden in hun werkplaatsen gebruiken."@nl;
  skos:altLabel "smidstang"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/89c4841b-6283-41dc-940f-9e741e8193a6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e88aaa7f-499d-46e2-aca8-7047f1356b0b>
  a skos:Concept;
  skos:prefLabel "nadonkeren"@nl;
  skos:scopeNote "Men spreekt van het nadonkeren van een oppervlak als de kleur een donkerder tint krijgt door inwerking van licht of chemicaliën of bewaring in het donker."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
