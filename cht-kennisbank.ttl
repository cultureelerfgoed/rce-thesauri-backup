  a skos:Concept;
  skos:prefLabel "herenhuizen"@nl;
  skos:scopeNote "Herenhuizen zijn woonhuizen voor aanzienlijken, vooral buiten de steden. Deze herenhuizen komen voor op buitenplaatsen in bosrijke gebieden of langs rivieren."@nl;
  skos:altLabel "herenhuis"@nl;
