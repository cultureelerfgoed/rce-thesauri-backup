<https://data.cultureelerfgoed.nl/term/id/cht/16f82de5-8bcf-418a-ab8e-0131d2d68891>
  a skos:Concept;
  skos:prefLabel "helicopteronderdelen"@nl;
  skos:scopeNote "Onderdelen van een helicopter. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "helicopteronderdeel"@nl;
