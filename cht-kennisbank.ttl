<https://data.cultureelerfgoed.nl/term/id/cht/278ecf7a-f714-4cf5-9fbf-cd073b63cd96>
  a skos:Concept;
  skos:prefLabel "milieu en omgevingsfactoren"@nl;
  skos:scopeNote "Milieu en omgevingsfactoren omvatten de externe fysieke omstandigheden, zoals temperatuur, vochtigheid en vervuiling, die de toestand en het behoud van objecten kunnen beïnvloeden."@nl;
