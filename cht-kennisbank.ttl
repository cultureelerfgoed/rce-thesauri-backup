<https://data.cultureelerfgoed.nl/term/id/cht/1aa9f057-e3a1-4948-a2c6-2054f96037cb>
  a skos:Concept;
  skos:prefLabel "driedimensionaal"@nl;
  skos:scopeNote "Het begrip driedimensionaal of 3D duidt aan dat iets drie meetkundige dimensies heeft."@nl;
