<https://data.cultureelerfgoed.nl/term/id/cht/0ce6721a-0957-4da9-8193-3f09aafbce16>
  a skos:Concept;
  skos:prefLabel "Gemengde Tuinstijl"@nl;
  skos:scopeNote "De gemengde stijl is een tuinstijl in de periode 1860 - 1930 waarin de landschapsstijl wordt gecombineerd met regelmatige structuren of de formele stijl. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "Gardeneske stijl"@nl, "Style mixte"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/594fd333-f17d-4457-9a23-8bcbd4f497eb>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/fb25d175-4746-44fc-ad43-4d4df02a23b3>,
