<https://data.cultureelerfgoed.nl/term/id/cht/fd29bf63-68c8-45db-9609-4843082935c8>
  a skos:Concept;
  skos:prefLabel "tussenstijlen"@nl;
  skos:scopeNote "Wordt zowel gebruikt voor de horizontale of verticale delen die een beglaasd gedeelte verdelen in vensterruiten en het glas op zijn plaats houden, als voor de verticale delen die de panelen in paneeldeuren verdelen. Voor de staanders die openingen verdelen die op een rij staan wordt 'middelstijlen' gebruikt. (AAT-Ned)"@nl;
  skos:altLabel "tussenstijl"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/04770e4f-1c11-40e7-a256-9de8c6d569c6>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/257348ee-776a-4403-9a11-80e9c584b159>
  a skos:Concept;
  skos:prefLabel "ozon"@nl;
  skos:scopeNote "Ozon is luchtverontreiniging die voortkomt uit reacties tussen andere verontreinigingen en stikstofdioxide, met name onder invloed van zonlicht."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a09b6596-b025-41bc-b3a7-7c11d707b503>;
