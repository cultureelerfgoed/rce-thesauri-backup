<https://data.cultureelerfgoed.nl/term/id/cht/aadee707-3c41-4c73-8b9b-e2907b371bb1>
  a skos:Concept;
  skos:prefLabel "remwerken"@nl;
  skos:scopeNote "Met remwerk wordt het stangenstelsel voor het remsysteem omschreven."@nl;
  skos:altLabel "remwerk"@nl;
