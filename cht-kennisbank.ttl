  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/7c79af1e-8164-4397-a1bc-9f2b737a20ee>
  a skos:Concept;
  skos:prefLabel "tweekapsboerderijen"@nl;
  skos:scopeNote "Tweekapsboerderijen zijn boerderijen met aangebouwde schuur, waardoor er twee daken (of kappen) naast elkaar liggen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
