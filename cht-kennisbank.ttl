  a skos:Concept;
  skos:prefLabel "eekschillersputjes"@nl;
  skos:scopeNote "Putje waarin eekschillers stonden om niet te hoeven bukken bij het schillen van de eikenstammetjes. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
