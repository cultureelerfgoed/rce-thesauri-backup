<https://data.cultureelerfgoed.nl/term/id/cht/48efd20c-50e8-4bf9-ad44-02d9a2adef51>
  a skos:Concept;
  skos:prefLabel "salpeter"@nl;
  skos:scopeNote "Salpeter, ook bekend als kaliumnitraat, is een mineraal dat vaak wordt gebruikt als conserveringsmiddel in voedsel, als kunstmest in de landbouw, en in de productie van buskruit en vuurwerk vanwege zijn oxiderende eigenschappen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/082603d8-7d16-4bac-bbd9-979b4a37432d>
  a skos:Concept;
  skos:prefLabel "vezelproducten"@nl;
  skos:scopeNote "Vezelproducten verwijst naar materialen die zijn samengesteld uit natuurlijke of synthetische vezels, zoals textiel, papier en composietmaterialen. Deze producten worden gewaardeerd om hun sterkte, flexibiliteit en brede toepassing in verschillende industrieën."@nl;
  skos:altLabel "vezelproduct"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/dcc1d6f2-79c0-4af0-bf26-7a584426b751>
  a skos:Concept;
  skos:prefLabel "wasbleek"@nl;
  skos:scopeNote "Wasbleek is een behandeling die wordt toegepast om was te reinigen en te bleken, zodat deze lichter van kleur wordt en geschikt voor verdere verwerking. Dit proces wordt vaak toegepast in de textiel- en kaarsenindustrie."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/425c459b-f954-49c1-a6e7-420820d1b665>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/425c459b-f954-49c1-a6e7-420820d1b665>
  a skos:Concept;
  skos:prefLabel "wassen (reinigen)"@nl;
  skos:scopeNote "Reinigen met water of een andere vloeistof. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/06a2fab7-0ef1-4eda-a282-20153013381e>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/dcc1d6f2-79c0-4af0-bf26-7a584426b751>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/4e1673d4-3c44-4b4d-82c3-dda0fe7750a4>
  a skos:Concept;
  skos:prefLabel "waxine"@nl;
  skos:scopeNote "Waxine is een paraffinewasproduct dat wordt gebruikt in de productie van kleine kaarsen, vaak geplaatst in metalen cups. Deze kaarsen worden gebruikt voor decoratie en verlichting vanwege hun lange brandduur en gelijkmatige vlam."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/48979a0e-6eb9-4496-903d-a82e4241030c>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/48979a0e-6eb9-4496-903d-a82e4241030c>
  a skos:Concept;
  skos:prefLabel "paraffine"@nl;
  skos:scopeNote "Paraffine is een koolwaterstofverbinding bestaande uit rechte alkaanketens van ca 22 tot 36 koolstofatomen, en wordt gewoonlijk gewonnen uit ruwe olie, alhoewel synthetische vormen tegenwoordig ook worden gemaakt. Het is verkrijgbaar in een aantal zuiverheidsgraden, die lopen van vormen met een betrekkelijk laag smeltpunt tot harde microkristallijne wassen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/65d9dddc-f9a2-4583-b548-ad131517b5a7>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/4e1673d4-3c44-4b4d-82c3-dda0fe7750a4>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8112e543-14fe-48c0-82d7-bb481eb1609b>
  a skos:Concept;
  skos:prefLabel "zwelmiddelen"@nl;
  skos:scopeNote "Zwelmiddelen zijn stoffen die in volume toenemen wanneer ze vocht opnemen. Deze materialen worden vaak gebruikt in de bouw, bijvoorbeeld in afdichtingsmiddelen en lijmen, om scheuren en openingen te dichten door uitzetting."@nl;
  skos:altLabel "zwelmiddel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/0ded3489-c906-4d86-8821-5770c87f1e76>
  a skos:Concept;
  skos:prefLabel "katoenfluweel"@nl;
  skos:scopeNote "Katoenfluweel is een luxe textielsoort gemaakt van katoen, gekenmerkt door zijn zachte en dichte pool. Het materiaal wordt vaak gebruikt voor kleding, gordijnen, en bekleding vanwege zijn comfortabele en elegante uitstraling."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a5835fe7-c0e0-4750-a5f5-c2632321a8fa>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e5b53a94-0f47-4ab4-a5eb-9ad5220ac1d1>
  a skos:Concept;
  skos:prefLabel "voeringkatoen"@nl;
  skos:scopeNote "Voeringkatoen is een lichte en soepele katoenen stof die gebruikt wordt als binnenvoering in kledingstukken, jassen, en accessoires. Het biedt comfort en bescherming, en helpt de buitenstof glad en comfortabel aan te laten voelen."@nl;
  skos:altLabel "voerkatoen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/a5835fe7-c0e0-4750-a5f5-c2632321a8fa>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/839c79a8-5fdd-4f5d-83d8-7df782df6c85>
  a skos:Concept;
  skos:prefLabel "roggenleer"@nl;
  skos:scopeNote "Roggenleer is een type leer dat wordt vervaardigd uit de huid van roggen. Het wordt gewaardeerd om zijn unieke textuur, die vaak korrelig en parelachtig is, en zijn buitengewone duurzaamheid, waardoor het veel wordt gebruikt in luxe lederwaren."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/58039588-a7e8-40d3-a1d3-5d6ae95f5aa5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/72283fc9-bc6f-4c42-a9ed-990f2885033a>
  a skos:Concept;
  skos:prefLabel "runderleer"@nl;
  skos:scopeNote "Runderleer is een veelgebruikt leer dat wordt verkregen uit de huid van runderen. Het is bekend om zijn sterkte, soepelheid en veelzijdigheid, en wordt gebruikt in een breed scala aan producten, van schoenen tot meubels en accessoires."@nl;
  skos:altLabel "rundleer"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/58039588-a7e8-40d3-a1d3-5d6ae95f5aa5>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/95c2d112-0c2e-44a9-9ea9-25693b1fc5ed>
  a skos:Concept;
  skos:prefLabel "verchroomd metaal"@nl;
  skos:scopeNote "Verchroomd metaal is een type metaal dat is bedekt met een dunne laag chroom, aangebracht om het oppervlak te beschermen tegen corrosie, slijtage, en om een glanzend, spiegelend uiterlijk te geven. Deze techniek wordt vaak toegepast op objecten die zowel duurzaamheid als esthetiek vereisen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b9fd0887-297b-4bab-bea5-cb288d068816>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/b2f0fa82-d095-4d87-a5d5-645447ab4d99>
  a skos:Concept;
  skos:prefLabel "verguld metaal"@nl;
  skos:scopeNote "Verguld metaal verwijst naar metaal dat is bedekt met een dunne laag goud. Dit proces, bekend als vergulden, wordt gebruikt om het metaal een luxe uitstraling te geven en het te beschermen tegen oxidatie en andere vormen van slijtage."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b9fd0887-297b-4bab-bea5-cb288d068816>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/e7e539e5-f902-4a9a-8452-7aca1fdc7c74>
  a skos:Concept;
  skos:prefLabel "verzilverd metaal"@nl;
  skos:scopeNote "Verzilverd metaal is metaal dat is gecoat met een laag zilver. Dit proces, verzilveren genoemd, wordt vaak toegepast om objecten een aantrekkelijk uiterlijk te geven en om de corrosiebestendigheid van het metaal te verbeteren."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b9fd0887-297b-4bab-bea5-cb288d068816>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/a75e6b89-53fa-4237-bf03-7c7939f32b5f>
  a skos:Concept;
  skos:prefLabel "labradoriet"@nl;
  skos:scopeNote "Labradoriet is een veldspaatmineraal dat bekend staat om zijn opvallende kleurenspel, bekend als labradorescentie. Deze iriserende kleurschakeringen variëren van blauw en groen tot geel en rood, afhankelijk van de hoek van lichtinval. Labradoriet wordt vaak gebruikt in sieraden en als decoratief mineraal vanwege zijn unieke optische eigenschappen en aantrekkingskracht."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/541cf6bb-3273-4fa4-bcc8-8f579f552c03>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/f5c21eda-36a4-40a6-ae94-417c1e6994a1>
  a skos:Concept;
  skos:prefLabel "mineraalgebonden mortel"@nl;
  skos:scopeNote "Mineraalgebonden mortel is een mortel waarin de bindmiddelen bestaan uit minerale stoffen, zoals kalk of cement. Deze mortel wordt vaak gebruikt in de restauratie van historische gebouwen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/76079c9c-8e0d-4487-a35c-c1793bbaf0d7>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/32322bbf-0d46-4bd5-a5a5-1aecbb11da09>
  a skos:Concept;
  skos:prefLabel "rode pigmenten"@nl;
  skos:scopeNote "Rode pigmenten zijn kleurstoffen die in poedervorm worden gebruikt om materialen een rode kleur te geven. Deze pigmenten worden vaak gewonnen uit natuurlijke bronnen zoals ijzeroxide, maar kunnen ook synthetisch worden geproduceerd. Ze worden toegepast in verf, inkt, en andere kleurmiddelen."@nl;
  skos:altLabel "rode pigment"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2d4ff601-9025-4667-811d-a4fe8da87b4d>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/34f06b64-011b-42fc-b80c-7ffd877f9c1d>,
    <https://data.cultureelerfgoed.nl/term/id/cht/383e4e9f-051d-48ba-9ede-49d10c495e56>,
    <https://data.cultureelerfgoed.nl/term/id/cht/640b4336-2e46-477d-a0c0-10a1469411de>,
    <https://data.cultureelerfgoed.nl/term/id/cht/641b7b99-3a96-4bb8-8e66-8abdc6f8acfb>,
    <https://data.cultureelerfgoed.nl/term/id/cht/e88e9dec-ac40-4505-addc-2d6db9503b46>,
    <https://data.cultureelerfgoed.nl/term/id/cht/fa681e75-0987-4e23-83d1-8001970b3e28>,
    <https://data.cultureelerfgoed.nl/term/id/cht/fad9b386-338a-422f-8cb6-252702e31755>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/2101da1e-65f4-4f94-9295-2edb7ce42471>
  a skos:Concept;
  skos:prefLabel "witte pigmenten"@nl;
  skos:scopeNote "Witte pigmenten zijn kleurstoffen die in poedervorm wordt gebruikt om materialen een witte kleur te geven. Het meest voorkomende witte pigment is titaniumdioxide, dat bekend staat om zijn dekkracht en reflecterende eigenschappen. Het wordt veel gebruikt in verf, coatings, en kunststoffen."@nl;
  skos:altLabel "witte pigment"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2d4ff601-9025-4667-811d-a4fe8da87b4d>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/4c88e12b-01fe-408f-9488-ead57b5c09a3>,
    <https://data.cultureelerfgoed.nl/term/id/cht/56854d84-fe56-45b9-bbf2-5f64833f1bd6>,
    <https://data.cultureelerfgoed.nl/term/id/cht/9ea3a325-c53e-4e84-92ac-dc08e150a356>,
    <https://data.cultureelerfgoed.nl/term/id/cht/e938d121-0579-417c-831a-2438683b7b9c>,
    <https://data.cultureelerfgoed.nl/term/id/cht/68a3affb-18f7-4d9c-bb57-f86c87bada9f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/99a3cc31-4853-4e93-9399-68c1a0d0e9ce>
  a skos:Concept;
  skos:prefLabel "zwarte pigmenten"@nl;
  skos:scopeNote "Zwarte zijn kleurstoffen die in poedervorm wordt gebruikt om materialen een zwarte kleur te geven. Vaak wordt dit pigment verkregen uit koolstofhoudende materialen zoals houtskool of roet, en het wordt gebruikt in inkt, verf, en andere kleurstoffen om diepe, ondoorzichtige zwarte tinten te creëren."@nl;
  skos:altLabel "zwarte pigment"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2d4ff601-9025-4667-811d-a4fe8da87b4d>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/4324c185-984d-4292-829e-b5a926f6343e>,
    <https://data.cultureelerfgoed.nl/term/id/cht/bd9bc9c6-2c6e-40a7-9b19-3eb41c2e22d6>,
    <https://data.cultureelerfgoed.nl/term/id/cht/a281cf4d-0089-4524-a0b3-92da9d0cbf86>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8b480ebd-49fc-441e-bef7-112a78b154b5>
  a skos:Concept;
  skos:prefLabel "natuurlijke polymeren"@nl;
  skos:scopeNote "Natuurlijke polymeren zijn polymeren die in de natuur voorkomen, zoals cellulose, zetmeel, en eiwitten. Deze polymeren zijn biologisch afbreekbaar en worden veel gebruikt in verschillende toepassingen, waaronder textiel, voedselverpakking, en medische producten."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/362a9c1d-41b3-46e0-bb2c-f3f3cfdc21b0>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/a3042051-6b66-495b-8f68-2f3e80e1a343>,
    <https://data.cultureelerfgoed.nl/term/id/cht/99e6e033-35bf-4471-845e-4670719fad90>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/fb3a364f-9676-4318-89ab-b4d2a499f768>
  a skos:Concept;
  skos:prefLabel "synthetische polymeren"@nl;
  skos:scopeNote "Synthetische polymeren zijn door mensen gemaakte polymeren, zoals nylon, polyethyleen, en PVC. Deze polymeren worden vervaardigd door polymerisatie van monomeren en worden op grote schaal gebruikt in de productie van kunststoffen, textiel, en vele andere industriële producten."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/362a9c1d-41b3-46e0-bb2c-f3f3cfdc21b0>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/74bee7a3-42ee-40ff-890b-276d1bb9f615>
  a skos:Concept;
  skos:prefLabel "kokkelschelpen"@nl;
  skos:scopeNote "Kokkelschelpen zijn schelpen afkomstig van de kokkel, een mariene tweekleppige weekdier. Deze schelpen, behorend tot de bredere categorie schelp, worden vaak gevonden op stranden en zijn kenmerkend door hun ronde vorm en geribbelde oppervlak."@nl;
  skos:altLabel "kokkelschelp"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c1726829-b45a-484d-ae76-d42f419f7703>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3a135049-311d-4097-882e-693013af9b2f>
  a skos:Concept;
  skos:prefLabel "mosselschelp"@nl;
  skos:scopeNote "Mosselschelpen zijn de schelpen van mosselen, mariene tweekleppige weekdieren. Deze schelpen, die onder de bredere categorie schelp vallen, hebben een langwerpige, donkerblauwe tot zwarte buitenkant en een gladde binnenkant."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c1726829-b45a-484d-ae76-d42f419f7703>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/16ea86da-96c6-4505-b07d-33d981967734>
  a skos:Concept;
  skos:prefLabel "skyr"@nl;
  skos:scopeNote "Skyr is een IJslandse zuivelproduct dat lijkt op yoghurt, maar dikker en rijker aan eiwitten is. Het wordt traditioneel gemaakt door melk te verwarmen en bacterieculturen toe te voegen. Skyr valt onder de bredere categorie zuivel en wordt vaak als gezond alternatief voor yoghurt of kwark gebruikt."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fdd18b2a-f24a-4569-8373-e6d0cb63e805>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/876c333d-00ec-4f25-b180-31bd9dad2a22>
  a skos:Concept;
  skos:prefLabel "kefir"@nl;
  skos:scopeNote "Kefir is een gefermenteerde zuiveldrank die rijk is aan probiotica en wordt gemaakt door kefirkorrels aan melk toe te voegen. Deze korrels, bestaande uit bacteriën en gisten, fermenteren de melk tot een licht bruisende drank. Kefir valt onder de bredere categorie zuivel en is bekend om zijn gezondheidsbevorderende eigenschappen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fdd18b2a-f24a-4569-8373-e6d0cb63e805>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/c15636eb-2c9b-4edb-a90e-550b0a8367d4>
  a skos:Concept;
  skos:prefLabel "smetana"@nl;
  skos:scopeNote "Smetana is een rijke, zure room die veel wordt gebruikt in de Centraal- en Oost-Europese keuken. Het valt onder de bredere categorie zuivel en wordt vaak toegevoegd aan soepen, sauzen en desserts om een romige textuur en lichtzure smaak te geven."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fdd18b2a-f24a-4569-8373-e6d0cb63e805>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/cc4f0769-97f4-41c1-8894-23048a5b7634>
  a skos:Concept;
  skos:prefLabel "umer"@nl;
  skos:scopeNote "Umer is een traditionele gefermenteerde zuiveldrank uit bepaalde Centraal-Aziatische regio's. Het wordt bereid door melk te fermenteren, vergelijkbaar met kefir, en wordt geclassificeerd onder de bredere categorie zuivel. Umer wordt vaak gedronken vanwege zijn verfrissende smaak en mogelijke gezondheidsvoordelen."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/fdd18b2a-f24a-4569-8373-e6d0cb63e805>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/aeabdf0d-1035-4b14-909b-2e11df3ff953>
  a skos:Concept;
  skos:prefLabel "koordzijde"@nl;
  skos:scopeNote "Koordzijde is een sterke, gladde zijden draad die vaak wordt gebruikt in borduurwerk en textielafwerkingen. Het wordt gesponnen van fijne zijden vezels en valt onder de bredere categorie zijde (textiel). Koordzijde is geliefd vanwege zijn glans en duurzaamheid, en wordt toegepast in zowel decoratief als functioneel naaien."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/570a2de4-ddee-4070-9288-75295b290a99>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/9b4678a2-6445-438d-94c2-f6a875f38558>
  a skos:Concept;
  skos:prefLabel "wijdel"@nl;
  skos:scopeNote "Wijdel is een type zijden vezel dat vaak gebruikt wordt in textielproductie. Het is een fijn en flexibel materiaal, dat onder de bredere categorie zijde (vezel) valt. Wijdel wordt gewaardeerd om zijn zachte textuur en sterkte, wat het ideaal maakt voor het vervaardigen van luxueuze stoffen en kledingstukken."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6b0681f6-2710-4e8f-b1fc-4cf0da1e90ea>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/7ce8d37e-fea9-4a3d-8629-69002968a28a>
  a skos:Concept;
  skos:prefLabel "knoflookstrengen"@nl;
  skos:scopeNote "Knoflookstrengen zijn bundels van samengevlochten knoflookbollen, die vaak worden gebruikt voor zowel culinaire als decoratieve doeleinden. Ze vallen onder de bredere categorie voedsel. Knoflookstrengen zijn praktisch voor opslag en het drogen van knoflook, waardoor de houdbaarheid wordt verlengd."@nl;
  skos:altLabel "knoflookstreng"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/231e97d9-93a7-470c-9213-80e2ff05de5f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/61eb7aef-c4cc-4bd5-bfd1-90b34adf075c>
  a skos:Concept;
  skos:prefLabel "knoflook"@nl;
  skos:scopeNote "Knoflook (Allium sativum) is een plant uit de lookfamilie (Alliaceae). Tot deze familie behoren andere soorten als de ui en de bieslook. (Wikipedia)"@nl;
  skos:altLabel "Allium sativum"@nl, "Allium sativa"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/47b6161f-e23c-40d1-8861-37fb4b229fae>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/158bd5f2-a81a-4b8c-9cf1-b81a1b0c0068>
  a skos:Concept;
  skos:prefLabel "reerug"@nl;
  skos:scopeNote "Reerug is een delicaat stuk wildvlees afkomstig van de rug van een ree. Dit vlees valt onder de bredere categorie voedsel en wordt beschouwd als een delicatesse vanwege zijn malse textuur en rijke smaak. Het wordt vaak bereid in culinaire gerechten voor speciale gelegenheden."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/231e97d9-93a7-470c-9213-80e2ff05de5f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/1049c665-6d25-40be-99b7-a37cdf0ba489>
  a skos:Concept;
  skos:prefLabel "vispatés"@nl;
  skos:scopeNote "Vispatés zijn smeerbare mengsels gemaakt van fijngemalen vis, vaak gecombineerd met kruiden en andere smaakmakers. Ze vallen onder de bredere categorie voedsel en worden meestal geserveerd als voorgerecht of snack, vaak op toast of crackers."@nl;
  skos:altLabel "vispaté"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/231e97d9-93a7-470c-9213-80e2ff05de5f>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/aae78a31-4508-4823-b723-e146ed35cd7a>
  a skos:Concept;
  skos:prefLabel "vleesproducten"@nl;
  skos:scopeNote "Vleesproducten omvatten een breed scala aan voedingsmiddelen gemaakt van dierlijk vlees, zoals worsten, ham en patés. Ze vallen onder de bredere categorie voedsel en worden bereid door verschillende technieken zoals roken, drogen of koken, afhankelijk van de gewenste smaak en textuur."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/231e97d9-93a7-470c-9213-80e2ff05de5f>;
  skos:narrower <https://data.cultureelerfgoed.nl/term/id/cht/e57748d7-65e8-48e1-9b80-fa9eb5876c85>,
    <https://data.cultureelerfgoed.nl/term/id/cht/efaf18e4-3558-459e-bd5e-8e5c11b0e32f>,
    <https://data.cultureelerfgoed.nl/term/id/cht/841352e9-3288-4fbf-8d5f-60902c360485>,
    <https://data.cultureelerfgoed.nl/term/id/cht/cb87fdf9-6bfc-4b60-b6e8-558287e9101b>,
    <https://data.cultureelerfgoed.nl/term/id/cht/b4ff4d55-ea49-4f09-8d58-aced11457015>,
    <https://data.cultureelerfgoed.nl/term/id/cht/614976b9-1699-4a66-8b39-fe448b6ad99b>,
