<https://data.cultureelerfgoed.nl/term/id/cht/38a63873-ab16-46d9-8953-965ffff0fed9>
  a skos:Concept;
  skos:prefLabel "gekken"@nl;
  skos:scopeNote "Gekken zijn draaibare kappen op schoorstenen. Ze kunnen van hout of metaal zijn. De gek richt zich door middel van een windvaan op de wind, zodat de rook aan de open zijde onbelemmerd kan wegstromen. (Haslinghuis)"@nl;
  skos:altLabel "gek"@nl, "gheck"@nl, "schoorsteengek"@nl, "schoorsteengekken"@nl;
