<https://data.cultureelerfgoed.nl/term/id/cht/4b442cac-0182-4df2-a282-111642acaf71>
  a skos:Concept;
  skos:prefLabel "lobbensteden"@nl;
  skos:scopeNote "Lobbensteden zijn het gevolgd van stedenbouwkundige concepten, deze steden bestaan theoretisch gezien uit een gesloten centrum met daarrond radiale stedelijke lobben die zich rond een netwerk van wegen en openbaar vervoersassen concentreren. Tussen de stedelijke lobben is er plaats voor groen en vaak een dorpse structuur. (Ecopolis)"@nl;
  skos:altLabel "lobbenstad"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/ec38530c-0050-458e-8f97-fb3276fc5cab>;
