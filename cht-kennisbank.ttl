  a skos:Concept;
  skos:prefLabel "proen"@nl;
  skos:scopeNote "Proen zijn driehoekige steuntjes van keramiek die bij het bakproces tussen de majolica voorwerpen werden geplaatst om te voorkomen dat de geglazuurde stukken aan elkaar zouden bakken.(Encyclo.nl)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/9b30d1b2-6088-4438-9589-ee7abea89c60>;
