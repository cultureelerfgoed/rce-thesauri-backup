<https://data.cultureelerfgoed.nl/term/id/cht/7b4695b4-074d-4178-9d89-4ef3432de10a>
  a skos:Concept;
  skos:prefLabel "heestergroepen"@nl;
  skos:scopeNote "Heestergroepen zijn aangeplante groepen heesters in gazons, langs lanen of randen van parkbos. Een heestergroep is een architectonisch beplantingselement in een parkaanleg. De heestergroep heeft een ruimtelijke structurerende functie en een sierwaarde zoals kleur en textuur van de heestergroep ter afwisseling van de overige beplanting. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "Engels hout"@nl, "bloemhout"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/57663f83-f6f6-4525-b0e0-cbc9a5436efa>;
