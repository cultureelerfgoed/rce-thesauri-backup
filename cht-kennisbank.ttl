  a skos:Concept;
  skos:prefLabel "kapers (hoofdbedekking)"@nl;
  skos:scopeNote "1) vrouwen- of kindermuts met een afhangende, nek en schouders en gedeeltelijk ook de borst bedekkende strook."@nl;
  skos:altLabel "kaper (hoofdbedekking)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/5dec9aa2-5ced-4f77-b929-c043b90b2a8f>;
