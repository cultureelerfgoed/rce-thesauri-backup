  a skos:Concept;
  skos:prefLabel "kraftpapier"@nl;
  skos:scopeNote "Kraft papier is een sterk, houtvrij papier vervaardigd met het alkalische sulfaatproces. Kraft papier is bruin van kleur en moet gebleekt worden om het in een lichtere kleur te verkrijgen. Bij de conservering van schilderijen worden stroken Kraftpapier aan de randen van een doekschilderij geplakt om het opspannen en vlak maken van het schilderij in een hulplijst/werklijst mogelijk te maken."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2d28d9aa-77e8-40ab-b0fe-f04d99f57955>;
