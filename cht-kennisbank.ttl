<https://data.cultureelerfgoed.nl/term/id/cht/e36c1b47-1199-4d84-958c-b418e99752de>
  a skos:Concept;
  skos:prefLabel "brandgruben"@nl;
  skos:scopeNote "Brandgruben zijn graven waarbij de crematieresten samen met houtskool of delen van de brandstapel worden begraven in een kuil. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "brandgrube"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/d6eef960-5cb5-4dd5-b68d-cc1929ed20c0>;
