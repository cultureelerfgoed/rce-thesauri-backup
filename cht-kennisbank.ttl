<https://data.cultureelerfgoed.nl/term/id/cht/5edce4c0-d35f-4d1b-80b1-23352c1c94eb>
  a skos:Concept;
  skos:prefLabel "gietharsen"@nl;
  skos:scopeNote "Gietharsen zijn composieten. Het wordt gemaakt van een basis polyol en een harder segment (meestal MDI of TDI). (Wikipedia)"@nl;
