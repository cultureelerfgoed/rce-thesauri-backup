  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/7e638d56-2a82-4b17-a1a8-d0c84e880e48>
  a skos:Concept;
  skos:prefLabel "zwerfstenen"@nl;
  skos:scopeNote "Benaming voor grote keien, die tijdens de ijstijden (met name tijdens het Saalien) vanuit Scandinavië zijn meegevoerd door gletsjers. (Thesaurus landschap)"@nl;
  skos:altLabel "zwerfsteen"@nl, "veldkei"@nl, "zwerfkei"@nl;
