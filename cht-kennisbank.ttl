<https://data.cultureelerfgoed.nl/term/id/cht/fea1c043-6b95-47ec-931e-42445a028251>
  a skos:Concept;
  skos:prefLabel "meerwallen"@nl;
  skos:scopeNote "Meerwallen zijn door het water langs een meer opgestuwde ruggen, die overwegend bestaan uit kleiafzettingen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
