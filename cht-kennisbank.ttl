<https://data.cultureelerfgoed.nl/term/id/cht/78076f58-4a35-45dc-a3b0-52a6d529bfb8>
  a skos:Concept;
  skos:prefLabel "archiefbewaarplaatsen"@nl;
  skos:scopeNote "Gebouwen waarin archieven zijn ondergebracht, dat zijn instellingen die niet-actieve openbare documenten of andere belangrijke historische documenten opslaan, bijhouden en verzorgen. De faciliteiten omvatten doorgaans rekken en laden voor de opslag van dozen, mappen en andere containers of documenten; delen van de faciliteit kunnen klimaatgeregeld zijn. (AAT)"@nl;
  skos:altLabel "archiefbewaarplaats"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/e488a93b-9a82-4836-a8ca-e8d940b83ef4>;
