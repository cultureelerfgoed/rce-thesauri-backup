  a skos:Concept;
  skos:prefLabel "drinkwatertonnen"@nl;
  skos:scopeNote "Een drinkwaterton is een opslag voor drinkwater. Onder drinkwater wordt water verstaan dat direct geschikt is voor menselijke consumptie."@nl;
