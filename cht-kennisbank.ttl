<https://data.cultureelerfgoed.nl/term/id/cht/cefaaf3c-c777-4073-95f2-95ca33c84686>
  a skos:Concept;
  skos:prefLabel "steken (molen)"@nl;
  skos:scopeNote "De afstand tussen de hartlijnen van de kammen (of staven). Als de kammen van de wielen niet op steek staan, is dat te horen aan het bonkend en stotend geluid. (Molenwoordenboek B.D. Poppen)"@nl;
  skos:altLabel "steek (molen)"@nl;
