<https://data.cultureelerfgoed.nl/term/id/cht/0aa2172f-97e7-4565-8c6a-90f53e404b26>
  a skos:Concept;
  skos:prefLabel "chevrons"@nl;
  skos:scopeNote "Chevrons zijn geluiddempende kartels aan de achterkant van de straalmotoren van sommige moderne vliegtuigen. Wanneer koude en warme lucht uit verschillende delen van de motor mengen ontstaat turbulentie. Door deze trillende lucht ontstaat geluid. De chevrons zorgen ervoor dat het mengen geleidelijker plaatsvindt, zodat er minder turbulentie (en dus geluid) ontstaat"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/6e0d9edf-70d6-4bc4-a744-94c656f0b596>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8ddae827-d874-471c-a1d0-8eb7c80679e8>
  a skos:Concept;
