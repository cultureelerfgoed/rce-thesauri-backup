  a skos:Concept;
  skos:prefLabel "kusten"@nl;
  skos:scopeNote "Land dat direct aan zee ligt. Soms wordt hiermee verwezen naar het land dat bij vloed door de zee wordt overspoeld, maar meer algemeen verwijst het naar een grotere strook land langs zee. (AAT)"@nl;
  skos:altLabel "kust"@nl;
