<https://data.cultureelerfgoed.nl/term/id/cht/8b716b72-838c-4d15-b4d2-c4fb27e75522>
  a skos:Concept;
  skos:prefLabel "jachtakten"@nl;
  skos:scopeNote "Jachtakten zijn akten om te jagen. Te onderscheiden zijn de grote jachtakte die volledige jachtpermissie geeft en de kleine jachtakte die het vangen van sommige vogels toestaat."@nl;
  skos:altLabel "jachtakte"@nl, "jachtvergunning"@nl, "jachtvergunningen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/3816ef5b-5fa0-4f1d-af0e-4e5f1cd96897>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/169b8258-47d2-494a-b326-03f6d3384b53>
  a skos:Concept;
  skos:prefLabel "pavonazetto"@nl;
  skos:scopeNote "Een witte of bleekgele marmersoort, purperachtig geaderd, naar verluidt de favoriet van keizer Hadrianus. Het woord pavonazzo betekent pauwblauw, violet of paars in het Italiaans. Het oude marmer is ook bekend als Frygisch marmer, omdat men denkt dat het afkomstig is uit Frygië in Klein-Azië. (AAT-Ned)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/26af6bc7-7d5c-4664-9fc3-95c5c2f3a160>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/16a20a97-e426-4488-b4ad-80d8d472c893>
  a skos:Concept;
  skos:prefLabel "kerkgeschiedenis"@nl;
  skos:scopeNote "Bestudering van de geschiedenis van de christelijke kerk, haar secten en verschillende kerkgemeenschappen. (AAT-Ned)"@nl;
