<https://data.cultureelerfgoed.nl/term/id/cht/d39a461e-2d0a-4b32-90e9-9c373ef5ad9a>
  a skos:Concept;
  skos:prefLabel "spuigaten (scheepvaart)"@nl;
  skos:scopeNote "Gat in het opboeisel of aan dek voor de afvoer van water, waaronder regen, overkomend water, buiswater, opgepompt water uit het ruim enz."@nl;
