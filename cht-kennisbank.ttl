<https://data.cultureelerfgoed.nl/term/id/cht/14705f45-304a-40aa-9e1c-b43c7135ec53>
  a skos:Concept;
  skos:prefLabel "perenhout"@nl;
  skos:scopeNote "Hout van de boom behorende tot het genus Pyrus, vaal rozeachtig bruin van kleur met een uiterst fijne textuur. Het wordt gebruikt voor het maken van kommen, borstelgrepen, tekeninstrumenten en kabinetten. (Toegepaste Kunst Project, RKD)"@nl;
  skos:altLabel "perehout"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/186d9d1b-ec98-40f2-bb73-a09776b51c61>;
