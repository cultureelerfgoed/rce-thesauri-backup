  a skos:Concept;
  skos:prefLabel "makreelgepen"@nl;
  skos:scopeNote "Makreelgepen (Scomberesocidae) vormen een familie van vissen uit de orde van de Geepachtigen (Beloniformes). De eerste bekende makreelgepen stammen uit het Mioceen. (Wikipedia)"@nl;
  skos:altLabel "Scomberesocidae"@nl, "makreelgeep"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/78672fa4-8815-4427-995e-21a2cc90bd39>;
