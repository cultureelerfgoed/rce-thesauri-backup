<https://data.cultureelerfgoed.nl/term/id/cht/f76c88c0-a332-4e02-8734-c01b524ef789>
  a skos:Concept;
  skos:prefLabel "mengselregelschroeven"@nl;
  skos:scopeNote "Met de mengselregelschroef in de carburateur wordt het stationaire toerental geregeld. Hiermee wordt de hoeveelheid lucht buiten de smoorklep om bij stationair toerental geregeld."@nl;
  skos:altLabel "mengselregelschroef"@nl;
