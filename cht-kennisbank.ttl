<https://data.cultureelerfgoed.nl/term/id/cht/2035cba8-d10c-47a5-b10f-2a5295a396b2>
  a skos:Concept;
  skos:prefLabel "batist (textiel)"@nl;
  skos:scopeNote "Fijne, zachte, dunne stof in effenbinding, gemaakt van één van de belangrijkste vezelsoorten zoals katoen, linnen, rayon, zijde of wol. (Toegepaste Kunst Project, RKD)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/86d3631a-1f3f-4b51-bbbb-dadebc310ecc>;
