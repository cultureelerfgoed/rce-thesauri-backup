  a skos:Concept;
  skos:prefLabel "spaakkettingen"@nl;
  skos:scopeNote "Ketting aan staartbalk met aan het eind een ring welke om een spaak van het kruirad wordt gestoken om terugdraaien te voorkomen."@nl;
