<https://data.cultureelerfgoed.nl/term/id/cht/bfd7494a-8cb9-416c-b90b-374fbbf8edf5>
  a skos:Concept;
  skos:prefLabel "kanaalplaatvloeren"@nl;
  skos:scopeNote "Kanaalplaatvloeren zijn vrijdragende vloeren bestaande uit prefab voorgespannen gewapend betonnen vloerelementen die, ter besparing van het eigengewicht, zijn voorzien van holle kanalen. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "holle plaatvloer"@nl, "holle plaatvloeren"@nl, "kanaalplaatvloer"@nl;
