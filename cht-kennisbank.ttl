  a skos:Concept;
  skos:prefLabel "emailleverf"@nl;
  skos:scopeNote "Verf die gebruikt wordt bij het brandschilderen, bestaand uit een mengsel van (gekleurd) glaspoeder en water of olie, eventueel met een vulmiddel. Na het brandschilderen is het resultaat meestal (semi-)transparant. (Werkgroep Vlakglas)"@nl;
