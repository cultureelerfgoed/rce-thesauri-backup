<https://data.cultureelerfgoed.nl/term/id/cht/e1582d2d-8f71-4785-9c44-a91d5edebe5a>
  a skos:Concept;
  skos:prefLabel "organisch materiaal"@nl;
  skos:scopeNote "Materiaal dat koolstof bevat, inclusief de materialen die afkomstig zijn van levende organismen. (AAT)"@nl;
  skos:altLabel "organische materialen"@nl;
