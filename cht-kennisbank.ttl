  a skos:Concept;
  skos:prefLabel "arbeiders"@nl;
  skos:scopeNote "De personen die in een economie arbeid verrichten. Gebruik ‘arbeid’ voor de menselijke activiteit waardoor de goederen worden geproduceerd of diensten geleverd waarnaar in een economie vraag is. (AAT)"@nl;
