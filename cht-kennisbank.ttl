<https://data.cultureelerfgoed.nl/term/id/cht/90042fa9-ba45-441a-b5e2-72fa27a80ed5>
  a skos:Concept;
  skos:prefLabel "composities"@nl;
  skos:scopeNote "Composities verwijzen naar de rangschikking en organisatie van elementen binnen een kunstwerk, architecturaal ontwerp of ander creatief object. Het gaat om de manier waarop verschillende onderdelen worden samengebracht om een samenhangend geheel te vormen."@nl;
  skos:altLabel "compositie"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/24656072-e4a3-424b-bcde-b9ab4dbb7593>;
