<https://data.cultureelerfgoed.nl/term/id/cht/14711fe9-2441-4b66-9562-bda751bd4c81>
  a skos:Concept;
  skos:prefLabel "nautilusschelpen"@nl;
  skos:scopeNote "Te gebruiken voor de schelp van de Nautilus macromphalus, afkomstig uit de tropische Grote en Indische Oceaan, gebruikt voor het maken van decoratieve voorwerpen zoals bekers, zoutvaatjes en juwelen, en als snijmateriaal. (AAT-Ned)"@nl;
  skos:altLabel "nautilusschelp"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/c1726829-b45a-484d-ae76-d42f419f7703>;
