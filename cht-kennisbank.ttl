  a skos:Concept;
  skos:prefLabel "kransen (molen)"@nl;
  skos:scopeNote "In oliemolens, kamwiel op de wentelas, dat via het spinwiel de overwerker in beweging brengt. (Molenwoordenboek B.D. Poppen)"@nl;
