  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0058d3c3-aaca-4764-a0c4-5aa60dd2a068>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/d239c54b-b7b7-45a7-97ec-a8ad97828ec8>
  a skos:Concept;
  skos:prefLabel "pluimveefokkerijen"@nl;
  skos:scopeNote "Pluimveefokkerijen zijn fokkerijen die op het fokken van pluimvee gericht zijn. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
