  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/61f37e43-8f9d-44a6-9244-1090931ff299>
  a skos:Concept;
  skos:prefLabel "albumine"@nl;
  skos:scopeNote "Albumine is het wit van een ei, dat water en een aantal eiwitten (proteïnen) bevat. Albumine werd gebruikt als bindmiddel in de beeldlaag van albuminepapier en albuminenegatieven."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/96dfb275-b038-4acd-a745-cfec32c1ee18>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/8f2c1aa7-6393-45e7-a2ad-5cf726109ed2>
  a skos:Concept;
  skos:prefLabel "vrijwoningen"@nl;
  skos:scopeNote "Huisjes waarin behoeftigen gratis konden wonen, ook wel vrijwoningen genoemd. (Haslinghuis)"@nl;
  skos:altLabel "godskamer"@nl, "godskameren"@nl, "vrijwoning"@nl;
