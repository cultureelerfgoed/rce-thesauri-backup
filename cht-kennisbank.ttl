<https://data.cultureelerfgoed.nl/term/id/cht/ee66753c-f858-4c53-a16d-e6befefe2ef1>
  a skos:Concept;
  skos:prefLabel "deurringen"@nl;
  skos:scopeNote "Trekkers voor meubelonderdelen of deuren met als voornaamste grijpbaar element hangende ringen. (AAT)"@nl;
  skos:altLabel "deurring"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/04770e4f-1c11-40e7-a256-9de8c6d569c6>;
