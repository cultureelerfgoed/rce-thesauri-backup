<https://data.cultureelerfgoed.nl/term/id/cht/3c9050a8-6df4-4cec-8ca5-791358e10973>
  a skos:Concept;
  skos:prefLabel "Maarten (lei)"@nl;
  skos:scopeNote "Leisoort die herhaaldelijk in laatmiddeleeuwse bronnen wordt genoemd. Vermoedelijk afkomstig uit de Fosse (groeve) Martin, wellicht in Rimogne (F). Er worden zowel blauwe als groene leien van deze soort genoemd. De naam wordt vaak verbasterd. (Haslinghuis)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/bc50e54d-2c3e-4b8e-8b4f-ab865b297b08>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

<https://data.cultureelerfgoed.nl/term/id/cht/3c9c8107-1ba2-4d82-a812-379116a307df>
  a skos:Concept;
  skos:prefLabel "communiedwalen"@nl;
  skos:scopeNote "Linnen kleed, niet zelden afgezet met kant, dat over de ballustrade van de communiebank ligt. Het afhangende deel van de dwaal werd door de communicanten onder de kin gehouden tijdens de uitreiking van de communie, om eventuele kruimels op te vangen."@nl;
  skos:altLabel "communiedwaal"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/63fd2d4a-56f9-4d75-a13d-39cd5f75599b>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

