<https://data.cultureelerfgoed.nl/term/id/cht/e91866c0-6dac-4a33-965a-4860c339ca30>
  a skos:Concept;
  skos:prefLabel "elektronische orgels"@nl;
  skos:scopeNote "Het elektronisch orgel is geen pijporgel maar een elektronisch instrument waarbij het specifieke orgelgeluid op digitale wijze is opgeslagen en via luidsprekers wordt weergegeven. (Rijksdienst voor het Cultureel Erfgoed)"@nl;
  skos:altLabel "elektronisch orgel"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/be6e0552-d096-4909-893a-ca674b2de09c>;
