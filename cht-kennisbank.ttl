<https://data.cultureelerfgoed.nl/term/id/cht/feae2093-d5ba-4d68-93c9-98869692365b>
  a skos:Concept;
  skos:prefLabel "maliënmotieven"@nl;
  skos:scopeNote "Ornament bestaande uit een reeks over elkaar liggende ringen of schijven. (Haslinghuis)"@nl;
  skos:altLabel "maliënmotief"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/2837063b-cbf2-44dd-a92d-cd378d695a43>;
