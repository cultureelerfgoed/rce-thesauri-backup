<https://data.cultureelerfgoed.nl/term/id/cht/d2b1ce03-8120-45cf-83cf-0b3fcb51a6ac>
  a skos:Concept;
  skos:prefLabel "koppelingsplaten"@nl;
  skos:scopeNote "Metalen schijf waar op aan weerszijden koppelingsvoeringen zijn geklonken of gelijmd; wordt op de ingaande as van de versnellingsbak bevestigd."@nl;
