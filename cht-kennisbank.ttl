<https://data.cultureelerfgoed.nl/term/id/cht/be1d748c-5652-4660-bc4e-8072610f4a54>
  a skos:Concept;
  skos:prefLabel "klokvormig"@nl;
  skos:scopeNote "De vorm, volledig of in de omtrek, van een doorsnede van een omgekeerde kop met uitwaaierende rand en bolle bovenkant; lijkt sterk op een klok. (AAT)"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/b1e39c43-c749-45fa-b814-c293b5b5491d>;
