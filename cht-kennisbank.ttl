<https://data.cultureelerfgoed.nl/term/id/cht/801b824e-22c1-4766-99b8-f81cd2bd058f>
  a skos:Concept;
  skos:prefLabel "havenstations"@nl;
  skos:scopeNote "Havenstations zijn emplacementstypen met de combinatie van een perron en een aanlegsteiger voor een aansluitende bootverbinding."@nl;
