<https://data.cultureelerfgoed.nl/term/id/cht/16e002a7-c54c-4423-a44a-afffd3eb1ffb>
  a skos:Concept;
  skos:prefLabel "vaseline"@nl;
  skos:scopeNote "Vaseline is een mengsel van minerale oliën en wassen in pastavorm, dat wordt gebruikt als smeermiddel en waterafstotend middel."@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/aa872ce6-a74c-4f81-96ec-6ee0e717f92a>;
