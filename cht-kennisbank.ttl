<https://data.cultureelerfgoed.nl/term/id/cht/8b269f46-d01b-481d-bd2a-4cc3b2b7fb24>
  a skos:Concept;
  skos:prefLabel "slavenmolens"@nl;
  skos:scopeNote "Molens die aangedreven werden door slaven, zoals bv. de diabolomolens die gevonden werden bij de opgravingen van pompei. (Molenwoordenboek G.J. Pouw)"@nl;
  skos:altLabel "slavenmolen"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/0198a25a-3469-469e-8103-a613e32fcdc6>;
