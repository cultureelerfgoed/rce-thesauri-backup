<https://data.cultureelerfgoed.nl/term/id/cht/1035182d-d8e4-40aa-833f-5959562f7410>
  a skos:Concept;
  skos:prefLabel "informatiearchitectuur"@nl;
  skos:scopeNote "Overzicht en samenhang van de functionele informatievoorziening en opdeling ervan in onderliggende informatiedomeinen."@nl;
