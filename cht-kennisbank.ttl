<https://data.cultureelerfgoed.nl/term/id/cht/ff4d00dc-b808-47ad-8135-1916729bfbf9>
  a skos:Concept;
  skos:prefLabel "zweetluikjes"@nl;
  skos:scopeNote "Uitneembaar luikje in de wegering aangebracht onder het gang­boord om de ruimte tussen de huid, inhouten en wegering te kun­nen ventileren."@nl;
  skos:altLabel "zweetluikje"@nl;
