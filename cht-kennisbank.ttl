    <https://data.cultureelerfgoed.nl/term/id/cht/30839d50-8283-42d9-bf1a-c590bbad89bd>,
    <https://data.cultureelerfgoed.nl/term/id/cht/a3892058-7d31-4017-9b74-c66356219e73>,
    <https://data.cultureelerfgoed.nl/term/id/cht/a371a3cc-7d3f-4f1f-a6a7-6eb7be075414>,
