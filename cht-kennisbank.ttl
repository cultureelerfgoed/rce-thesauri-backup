  a skos:Concept;
  skos:prefLabel "achterzomers"@nl;
  skos:scopeNote "Balk of hanenbalk in een driehoeksspant. (Haslinghuis)"@nl, "Bij een wipmolen en een spinnenkop de balk die zich bevindt aan de onderzijde van de achterkant van het bovenhuis. Rust op de voeghouten of burriebalken en steekt, in tegenstelling tot die van de standerdmolen, aan weerszijden van het bovenhuis uit als een spruit. De boveneinden van de schoren van de trapconstructie zijn eraan bevestigd. (Haslinghuis)"@nl;
  skos:altLabel "achterzomer"@nl, "spruitbalk"@nl, "spruitbalken"@nl;
  skos:broader <https://data.cultureelerfgoed.nl/term/id/cht/f08de543-cbc1-48ba-98fc-975758d3bea3>;
  skos:inScheme <https://data.cultureelerfgoed.nl/term/id/cht/b532325c-dc08-49db-b4f1-15e53b037ec3> .

