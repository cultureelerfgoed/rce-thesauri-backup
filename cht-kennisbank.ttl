<https://data.cultureelerfgoed.nl/term/id/cht/8eb14bae-e1e1-4dac-9682-a7a9b6bd43a9>
  a skos:Concept;
  skos:prefLabel "technische hogescholen"@nl;
  skos:scopeNote "Hoger technisch onderwijs-instelling. Opvolger van de Polytechnische School en later omgezet in technische universiteiten. (AAT)"@nl;
