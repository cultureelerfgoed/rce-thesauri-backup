    skos:prefLabel "Liquidatie van A.F. Aan"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 29 december 1944 werd de Haagse politieman A.F. Aan op weg naar zijn woning in de Ribesstraat in Den Haag door het verzet doodgeschoten. Aan was lid van de NSB. Toen de geallieerden in september 1944 naderden nam het aantal sabotagedaden en liquidaties van Duitsers, verraders en collaborateurs door het verzet toe."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/17709> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "NIOD, contextinformatie bij Archief 086 Beauftragten des Reichskommissars"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-02-25T09:40:34.014Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/c26ef329-6533-752c-cd85-4c0ba73d078c.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/e21c2a2e-0259-11e7-904b-d89d6717b464/media/c26ef329-6533-752c-cd85-4c0ba73d078c";
