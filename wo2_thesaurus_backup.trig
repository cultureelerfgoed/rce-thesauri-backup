    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nimh-beeldbank.defensie.nl/memorix/396cf26e-eb18-11df-a391-13966e870614";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://nimh-beeldbank.defensie.nl/foto-s/396d72fc-eb18-11df-a391-13966e870614>,
      <https://beeldbankwo2.nl/nl/beelden/detail/1a083680-025a-11e7-904b-d89d6717b464/media/b5214448-89dc-f41e-3f4c-044bd547ca24>;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Fort_Westervoort&oldid=52306360"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/6141>;
    dcterms:created "2019-04-26T08:43:51.000Z"^^xsd:dateTime;
    skos:prefLabel "Fort Westervoort"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Bij Fort Westervoort werd tijdens de Duitse inval op 10 mei 1940 voor het eerst, tijdens de Tweede Wereldoorlog, gevochten op Nederlandse bodem. Bij de strijd, tussen 10 en 14 mei 1940, sneuvelden hier veertien Nederlandse militairen. Tijdens de bezetting raakte het in onbruik om medio 1944 door Duitse luchtdoelartillerie-eenheden (Flak) weer bezet te worden, waarna het fort op 12 april 1945 door Canadese strijdkrachten werd ingenomen. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
