    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/mediabank-horizontal/702ccf50-c574-67de-c4fd-a35b78d8c8fe.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/d98be588-025a-11e7-904b-d89d6717b464/media/702ccf50-c574-67de-c4fd-a35b78d8c8fe";
    dcterms:source "https://www.japansekrijgsgevangenkampen.nl/Thanbyuzayat.htm"@nl, "https://2nd4thmgb.com.au/camp/thabbyuzayat-415k-burma/"@en;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/b7354d29-49d5-4fe0-922a-3f3b5929fa84>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1699>, <https://data.niod.nl/WO2_Thesaurus/21047>;
    dcterms:created "2024-08-05T12:51:03.932Z"^^xsd:dateTime;
    skos:prefLabel "Thanbyuzayat"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Thanbyuzayat (sinds 16 augustus 1942 genaamd Thailand 3B) was een krijgsgevangenkamp aan de Birma Siam Spoorweg. Het lag aan de bestaande spoorlijn tussen kustplaatsen Ye en Moulmein en het was tevens het beginpunt van de Birma Siam Spoorweg richting Thailand. Het kamp fungeerde als werkkamp en hospitaalkamp. De werkzaamheden waren o.a. het inladen van bouwmateriaal en gereedschap, het maken van spoorbielzen, de aanleg van de spoorbaan tot Wegali en de opvang van zieken uit de andere kampen langs de Birma Siam Spoorweg."@nl;
    skos:altLabel "Thanbyuzayat – 415 (0)"@nl, "Thailand 3B"@nl, "Thai kamp Thambuysayat"@nl,
      "Thaicamp III"@nl, "Tanbyusaijat"@nl .
  
