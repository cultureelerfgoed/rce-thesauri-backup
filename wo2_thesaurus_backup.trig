    <https://data.niod.nl/organizationsWO2/startDate> "1940-11-16"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/db4ef65d-5af2-6b2c-f617-4d77855017c3.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/2f061ffc-025a-11e7-904b-d89d6717b464/media/db4ef65d-5af2-6b2c-f617-4d77855017c3";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://cc.museon.nl/default.aspx#id=%20233872>;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-06"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Het Nationaal-Socialistisch Studenten Front (NSSF) was de studentenorganisatie van de Nationaal-Socialistische Beweging (NSB). De NSSF bestudeerde nationaalsocialistisch gedachtegoed en bevorderde de verspreiding ervan in het hoger onderwijs. Deelname aan de NSSF stond open voor alle studenten, maar in de praktijk waren voornamelijk NSB’ers lid."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/locations/7990>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2244>, <https://data.niod.nl/WO2_Thesaurus/20641>;
    dcterms:created "2016-10-04T13:07:41.000Z"^^xsd:dateTime;
    skos:prefLabel " Nationaal-Socialistisch Studenten Front"@de, " Nationaal-Socialistisch Studenten Front"@nl,
      "' Nationaal-Socialistisch Studenten Front'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Nationaal-Socialistisch Studenten Front (NSSF) werd op 16 november 1940 opgericht met toestemming van Mussert. De doelstellingen van de organisatie waren het bestuderen van de nationaalsocialistische beginselen en de verbreiding hiervan op universiteiten en hogescholen, het bevorderen van het hoger onderwijs in nationaalsocialistische zin en het versterken van de band tussen volk en student. Hoewel het lidmaatschap open stond voor alle studerenden, ging het in de praktijk meestal samen met het lidmaatschap van de NSB."@nl;
    skos:altLabel "Nationaal-Socialistisch Studentenfront"@nl, "Nationaal Socialistisch Studenten Front"@nl,
      "Studentenfront"@nl, "Nationaal Socialistisch Studentenfront"@nl, "Studenten Front"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
