    dcterms:source "https://www.bezoek-ede.nl/militair-toerisme/oorlogsherinneringen-ede/april-1945-bevrijding-van-ede"@nl,
      "https://www.bezoek-ede.nl/militair-toerisme/75-jaar-bevrijding"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/6983>;
    dcterms:created "2020-08-27T08:49:25.000Z"^^xsd:dateTime;
    skos:prefLabel "Bevrijding Ede"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De bevrijding van Ede vond plaats op 17 april 1945. Op 16 april ging de Polar Bear divisie in Arnhem, gesteund door Canadese tanks, op pad om Ede, Bennekom en Wageningen te bevrijden. Ten oosten van de Simon Stevinkazerne in Ede zaten zo'n 300 Duitse militairen. De Duitsers vluchtten en ruim vijftig SS'ers werden gevangen genomen. Op 17 april trok het Calgary Regiment van de 1e Canadese tank brigade Ede binnen."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
