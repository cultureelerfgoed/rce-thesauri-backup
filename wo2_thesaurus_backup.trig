    dcterms:created "2024-08-07T12:08:12.907Z"^^xsd:dateTime;
    skos:prefLabel "Slag bij Nieuwolda"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Slag bij Nieuwolda vond plaats in de ochtend van 10 mei 1940. Drie uur lang hielden de 37 Nederlandse militairen de Duitse aanval van tegen. Er kwamen zes Duitse militairen en een Nederlandse militair, Harmannus Klaas Westerhoff, om het leven."@nl .
  
