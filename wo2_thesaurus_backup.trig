    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>;
    dcterms:created "2019-11-08T15:17:49.000Z"^^xsd:dateTime;
    skos:prefLabel "De duikhoek; blad voor de Noord-Oostpolder"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het illegale blad De Duikhoek : Blad voor de Noordoostpolder werd van januari 1944 tot en met februari 1945 uitgegeven in Lemmer en Vollenhove. De inhoud bestond vrijwel geheel uit fragmenten van het manuscript van het na de oorlog verschenen boek De Duikhoek door P. Grilk en W. van Leening."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8752> a <http://schema.org/Thing>, skos:Concept;
