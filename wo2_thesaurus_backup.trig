    skos:prefLabel "Groepsadministrateur"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De groepsadministrateur was de functionaris binnen de NSB die binnen een lokale groep verantwoordelijk was voor het innen van contributies, donaties, inschrijfgelden en andere niet verplichte bijdragen. Over deze gelden legde hij verantwoording af aan de kringadministrateur. De groepsadministrateur was samen met de kringadministrateur ook belast met de ledenadministratie. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2244> .
  
