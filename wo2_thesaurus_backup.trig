    <http://schema.org/startDate> "1945-01-05"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2682>;
    dcterms:created "2021-02-10T13:42:21.325Z"^^xsd:dateTime;
    skos:prefLabel "Liquidatie van Hendrik Lansink"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De liduidatie van Hendrik Lansink vond plaats op 5 januari 1945 in Amsterdam. Lansink was lid van de NSB en adjunct-commies bij het Gewestelijk Arbeidsbureau. Iemand kwam aan de deur met een envelop van het Departement van Sociale Zaken en moest deze persoonlijk overhandigen. Lansink meldde zich en werd meteen doogeschoten."@nl .
  
