    dcterms:source "https://de.wikipedia.org/w/index.php?title=Reichstagsbrand&oldid=162753790"@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
