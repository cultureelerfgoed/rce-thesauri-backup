  <https://data.niod.nl/WO2_Thesaurus/2517> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-06-13T08:23:46.246Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> <https://resolver.kb.nl/resolve?urn=urn:gvn:NIOD01:AE0749&role=thumbnail>;
