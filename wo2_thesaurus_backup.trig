    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/f6b1d26c-025a-11e7-904b-d89d6717b464/media/6020c134-69e5-0d31-91e7-effaf427efa5";
    <http://schema.org/location> "Doetinchem";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/f6ac6480-025a-11e7-904b-d89d6717b464/media/b1520406-0b4e-d256-3e84-e7a81240b96d>,
