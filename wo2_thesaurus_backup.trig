      "Hetty. A true story, Hetty E. Verolme, Fremantle 2009"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2021-01-27T09:04:58.037Z"^^xsd:dateTime;
