  <https://data.niod.nl/WO2_Thesaurus/17581> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:04:11.492Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/17488>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/6/6a/20110501Gestapo-Lager_Neue_Bremm11.jpg/1920px-20110501Gestapo-Lager_Neue_Bremm11.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://en.wikipedia.org/wiki/Neue_Bremm#/media/File:20110501Gestapo-Lager_Neue_Bremm11.jpg";
    dcterms:source "https://en.wikipedia.org/wiki/Neue_Bremm"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2017>;
    dcterms:created "2021-09-07T14:55:52.173Z"^^xsd:dateTime;
    skos:prefLabel "Neue Bremm"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Kamp Neue Bremm was een nazi-martelkamp in Saarbrücken van begin 1943 tot eind 1944. Het werd in 1943 door de Gestapo opgericht met het doel om gevangenen te breken die niet meteen voor de dood waren bestemd. Er was geen toezicht van andere instellingen. Er zaten zowel mannen als vrouwen die in Arbeitskommando's tewerk werden gesteld. Er verbleven zo'n 20.000 gevangenen, waaronder Joden uit Oost-Europa, Fransen, Belgen, Britten en Italianen."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/17582> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    dcterms:modified "2021-09-07T15:27:40.703Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/17583>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/3/3d/Bundesarchiv_Bild_146-1990-021-20%2C_Arado_Ar_68.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Arado#/media/Bestand:Bundesarchiv_Bild_146-1990-021-20,_Arado_Ar_68.jpg";
    dcterms:source "https://nl.m.wikipedia.org/wiki/Arado"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/17579>;
    dcterms:created "2021-09-07T15:16:32.641Z"^^xsd:dateTime;
    skos:prefLabel "Arado"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Arado was een Duitse vliegtuigfabrikant in Warnemünde. Het was een voortzetting van de firma Friedrichshaven en er werden vanaf 1924 vliegtuigen geproduceerd. Arado werd in de oorlog leverancier van vliegtuigen aan de nieuwe Luftwaffe. In 1936 werd het bedrijf genationaliseerd. Gevangenen uit Kamp Rathenow werden hier tewerk gesteld. In 1945 werd het bedrijf gesloten."@nl;
    skos:altLabel "Arado Flugzeugwerke GmbH"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/17586> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:30:59.306Z"^^xsd:dateTime;
