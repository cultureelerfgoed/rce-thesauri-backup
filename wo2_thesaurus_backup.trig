    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://archief.zaanstad.nl/beeldbank/beeldbank-beelden/detail/794d535a-a3be-c741-9c67-a6cceac5acaf";
    dcterms:source "https://nl.wikipedia.org/wiki/Theologische_Universiteit_Kampen_(Broederweg)"@nl,
      "https://www.stadsarchiefkampen.nl/doorzoek-alles?mivast=69&mizig=210&miadt=69&miaet=1&micode=00383&minr=18334065&miview=inv2&milang=nl"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2392>;
    dcterms:created "2021-08-05T12:55:21.196Z"^^xsd:dateTime;
    skos:prefLabel "Theologische Universiteit Kampen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "In 1854 werd de Theologische School te Kampen gesticht. In 1939 veranderde de naam in Theologische Hogeschool en in 1987 in Theologische Universiteit. Tijdens de Tweede Wereldoorlog was het moeilijk voor studenten en docenten om lessen te volgen en te geven. "@nl;
    skos:altLabel "Theologische School"@nl, "Theologische Hogeschool"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/17318> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:04:35.444Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/9810>;
    dcterms:source "https://nl.wikipedia.org/wiki/Technische_Universiteit_Delft"@nl, "https://www.delta.tudelft.nl/article/vijf-verwarrende-jaren"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2392>;
    dcterms:created "2021-08-05T13:15:54.652Z"^^xsd:dateTime;
    skos:prefLabel "Technische Universiteit Delft"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Technische Universiteit Delft is voortgekomen uit de Koninklijke Academie ter opleiding van burgerlijke ingenieurs die op 8 januari 1842 werd opgericht. Vanaf 22 mei 1905 werd het academische niveau van de opleiding erkend en kreeg de Technische Hoogeschool van Delft de status van universiteit. In november 1940 werd er gestaakt tegen het verbod van de Duitse bezetter aan Joodse hoogleraren om les te geven. De hogeschool werd door de bezetter gesloten, maar op 15 april 1941 heropend onder Duits toezicht. Delftse studenten en docenten bleven zich tegen de Duitse bezetter verzetten maar aan de andere kant was het aantal tekenaars van de loyaliteitsverklaring erg hoog."@nl;
    skos:altLabel "Technische Hoogeschool van Delft"@nl, "TU Delft"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/17319> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:04:46.738Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/9696>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/d7d9a9ed-d3de-4996-de5a-04a3a8ad81d3.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/64c0a914-025a-11e7-904b-d89d6717b464/media/d7d9a9ed-d3de-4996-de5a-04a3a8ad81d3";
    dcterms:source "https://nl.wikipedia.org/wiki/Wageningen_University_%26_Research"@nl,
      "https://resource.wur.nl/nl/show/Studenten-en-hun-verzet-in-WO-II.htm"@nl, "https://mijngelderland.nl/inhoud/verhalen/studentenrazzia-in-wageningen"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2392>;
    dcterms:created "2021-08-05T13:45:35.459Z"^^xsd:dateTime;
    skos:prefLabel "Wageningen University & Research"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Wageningen University werd in 1876 opgericht als Rijkslandbouwschool. In 1918 werd het de Landbouwhogeschool, in 1986 de Landbouwuniversiteit en in 2016 de WUR. Op 6 februari 1943 vond er op meerdere universiteiten een razzia plaats als represaille voor de aanslag op Hendrik Seyffardt. Er werden 43 studenten in Wageningen opgepakt en naar Kamp Vught gebracht. Tijdens de laatste maanden van de Tweede Wereldoorlog werden gebouwen, boeken, instrumenten en planten van de universiteit zo zwaar beschadigd dat er geen les meer kon worden gegeven."@de;
    skos:altLabel "Rijkslandbouwschool"@nl, "WUR"@nl, "Landbouwhogeschool"@nl .
  
