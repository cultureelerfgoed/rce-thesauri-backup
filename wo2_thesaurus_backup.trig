    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/8724>, <https://data.niod.nl/WO2_Thesaurus/8723>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/2669>;
    dcterms:created "2017-09-20T11:34:53.000Z"^^xsd:dateTime;
    skos:prefLabel "Comité van Revolutionaire Marxisten"@nl, "'Comité van Revolutionaire Marxisten'"@de,
      "'Comité van Revolutionaire Marxisten'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Comité van Revolutionaire Marxisten (CRM) kwam voort uit het Marx-Lenin-Luxemburg-front. In 1942 werd de leiding van het MLL-front gearresteerd en de restanten van deze organisatie vielen in de zomer van 1942 uiteen in het Comité van Revolutionaire Marxisten en de Communistenbond Spartacus. Het CRM publiceerde het illegale blad De Rode October en Het Kompas, en daarnaast werkte men samen met groepen die onderduikers verzorgden. Betrokken personen waren onder meer Piet van ’t Hart, Sal Santen, Wout Tieleman en Andries, Antoine en Willy Dolleman."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
