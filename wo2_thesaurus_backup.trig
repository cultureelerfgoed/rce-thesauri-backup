      "B. van Berkel, Tobie Goedewaagen. Een onverbeterlijke nationaalsocialist (1895-1980) (Amsterdam 2013) "@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2024-08-12T12:03:08.700Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1941-11-25"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://resolver.kb.nl/resolve?urn=urn:gvn:EVDO02:NIOD05_2988&size=large"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://resolver.kb.nl/resolve?urn=urn:gvn:EVDO02:NIOD05_2988"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/d3bb79b2-0259-11e7-904b-d89d6717b464/media/c42915d2-d4e5-78a6-c3d3-08218373f43e>,
      <https://beeldbankwo2.nl/nl/beelden/detail/2bbac17c-025a-11e7-904b-d89d6717b464/media/95037b39-00f0-5115-f383-96b53c16773b>,
      <https://beeldbankwo2.nl/nl/beelden/detail/cc06f52e-025a-11e7-904b-d89d6717b464/media/34e6a2c1-4f14-245a-2fd8-48d69908d6d3>;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Nederlandsche_Kultuurkamer&oldid=63270868"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-06"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Nederlandsche Kultuurkamer (NKK) was een nationaalsocialistisch instituut waar kunstenaars, schrijvers, muzikanten en podiumartiesten zich verplicht moesten registreren. In 1944 telde de NKK zo’n 42.000 leden. Nieuwe leden moesten een verklaring ondertekenen dat men geen Joodse voorouders had. Doel van de NKK was het verwijderen van Joden uit het culturele leven. Ook probeerde de Duitse bezetter via de NKK de pers en de kunsten te controleren en censureren."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/demoadmin>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/corporaties/5069>, <https://data.niod.nl/WO2_Thesaurus/9612>,
      <https://data.niod.nl/WO2_Thesaurus/9613>, <https://data.niod.nl/WO2_Thesaurus/9614>,
      <https://data.niod.nl/WO2_Thesaurus/events/7628>, <https://data.niod.nl/WO2_Thesaurus/corporaties/8540>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/8557>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1743>, <https://data.niod.nl/WO2_Thesaurus/20640>,
      <https://data.niod.nl/WO2_Thesaurus/20645>;
    dcterms:created "2016-08-01T19:19:12.000Z"^^xsd:dateTime;
    skos:prefLabel "Nederlandsche Kultuurkamer"@nl, "'Nederlandsche Kultuurkamer'"@de,
      "Dutch Chamber of Culture"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Nederlandsche Kultuurkamer (NKK) werd op 25 november 1941 door Seyss-Inquart ingesteld met als doel de nazificatie van de Nederlandse cultuur. Iedereen die het vak van kunstenaar, schrijver, muzikant, podiumartiest, etc. wilde uitoefenen, moest zich bij de Kultuurkamer inschrijven en zich conformeren aan de instructies. De toelatingsprocedure bestond uit een omvangrijke vragenlijst en een Ariërverklaring, waaruit bleek dat Joden volledig uit het culturele leven zouden worden gebannen. De Kultuurkamer kwam in de praktijk nooit goed van de grond."@nl;
    skos:altLabel "Nederlandse Kultuurkamer"@nl, "Kultuurkamer"@nl, "Cultuurkamer"@nl,
      "N.K.K."@nl, "Nederlandse Cultuurkamer"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/5101>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
