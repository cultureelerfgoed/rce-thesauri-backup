    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/37c4560e-025a-11e7-904b-d89d6717b464/media/aef54d8f-976c-6a58-216c-6b65cd9b2208";
    <http://schema.org/startDate> "1954-02-01"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1870>;
    dcterms:created "2021-09-29T08:50:38.591Z"^^xsd:dateTime;
    skos:prefLabel "Inwerkingtreding vaarplichtbeloning"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De vaarplichtbeloning treed in werking op 1 februari 1954. Het was een speciale beloning voor de bewezen diensten tijdens de Tweede Wereldoorlog door zeelieden van de Nederlandse koopvaardij. Middels het Bedrijfspensioenfonds voor de Koopvaardij kon een zeeman aanspraak maken op deze financiële bonus. De voorwaarden voor het verkrijgen van deze beloning waren dat de vaarplicht had gegolden voor de betreffende zeeman, de taken tussen 6 juni 1940 en 31 augustus 1944 waren vervuld en de zeeman zestig jaar oud was. Het gold aanvankelijk alleen voor 'Nederlanders'. Dit werd pas op 2 mei 1958 gewijzigd."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/17652> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Bons, Welmoed. \"De koopvaardij in de Tweede Wereldoorlog.\" Gens Nostra 75, no. 3 (2020): 146-163. Dissel, Anita van, Martin Elands, Hylke Faber en Pieter Stolk, eds. De Nederlandse koopvaardij in oorlogstijd. Amsterdam: Boom, 2014."@nl;
