    <http://schema.org/startDate> "1935-09-15"^^xsd:date;
    dcterms:source "http://www.go2war2.nl/artikel/1651/Neurenberger-Wetten-15-09-1935---14-11-1935.htm"@nl,
      "https://de.wikipedia.org/w/index.php?title=Nürnberger_Gesetze&oldid=163318398"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
