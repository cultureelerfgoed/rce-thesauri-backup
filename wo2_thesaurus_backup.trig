    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/7819>;
    dcterms:created "2019-01-23T19:32:27.000Z"^^xsd:dateTime;
    skos:prefLabel "Commissaris der provincie Zuid-Holland"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Tijdens de Duitse bezetting werden bijna alle commissarissen van de Koningin ontslagen door de Duitsers en werden NSB'ers geïnstalleerd met als titel Commissaris der provincie. In Zuid-Holland bleef Herman Adriaan van Karnebeek tot zijn dood op 29 maart 1942 in functie. Hij werd in februari 1943 opgevolgd door de fanatieke nationaalsocialist Robert van Genechten,  Nadat hij van alle gedeputeerden te horen had gekregen dat ze niet bereid waren met hem samen te werken, liet Van Genechten verstek gaan. Het commissariaat werd vervolgens tot 1945 waargenomen door E.M.J. Bolsius."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7750> a <http://schema.org/Thing>,
