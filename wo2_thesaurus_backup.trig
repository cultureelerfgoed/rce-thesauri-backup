    skos:prefLabel "Boerenfront"@nl, "'Boerenfront'"@de, "'Boerenfront'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Boerenfront was een organisatie van de NSB, gegroeid uit een der afdelingen van de Agrarische Dienst van de NSB, en ontstaan in juli 1940 ter voorbereiding van de Volksvoedingsstand. Boerenleider was Evert Jan Roskam. In november 1940 fuseerde het Boerenfront met de organisatie Landbouw en Maatschappij in Drenthe tot het Agrarisch Front."@nl;
    skos:altLabel "Nederlandsch Boerenfront"@nl, "Nederlands Boerenfront"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Organization> .
  
