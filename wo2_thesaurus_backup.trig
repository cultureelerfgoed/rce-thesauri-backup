    skos:prefLabel "Liquidatie van Theodorus Leonardus Verstappen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De liquidatie van Theodorus Leonardus Verstappen vond plaats op 10 augustus 1944 in Gemert. Verstappen was slager en lid van de NSB. Hij werd doodgeschoten."@nl .
  
