    skos:prefLabel "Depot der Koninklijke Marechaussee (Apeldoorn)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote """Het Depot der Koninklijke Marechaussee te Apeldoorn vormde vanaf juni 1942 tot juni 1943 het terrein van de Politieofficiersopleiding. De opleiding vormde samen met het Politie-Opleidingsbataljon (P.O.B.) in Schalkhaar de twee politieopleidingscentra tijdens de bezetting en paste binnen de plannen van Hanns Albin Rauter om de Nederlandse politie te nazificeren.
"""@nl;
    skos:altLabel "Van Haeftenkazernekazerne"@nl .
  
