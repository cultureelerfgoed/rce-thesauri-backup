      "http://ftp.hofvantwente.nl/Reo/plannen/NL.IMRO.1735.BGxDeldenerbroek-/NL.IMRO.1735.BGxDeldenerbroek-OP10/b_NL.IMRO.1735.BGxDeldenerbroek-OP10_tb6.pdf"@nl;
