    skos:prefLabel "A.G.D."@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "A.G.D. (Anti Geruchten Dienst) was een verzetsblad dat vanaf 10 oktober 1944 tot 30 november dagelijks verscheen in Amsterdam. Het blad bestond uit nieuwsberichten die werden overgenomen van de BBC."@nl;
    skos:altLabel "Anti Geruchten Dienst"@nl .
  
