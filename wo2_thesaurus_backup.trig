    skos:broader <https://data.niod.nl/WO2_Thesaurus/2350>, <https://data.niod.nl/WO2_Thesaurus/2343>;
    dcterms:created "2018-09-21T05:55:36.000Z"^^xsd:dateTime;
    skos:prefLabel "Operatie Montclair"@nl, "Unternehmen Montclair"@de, "Operation Montclair"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Operatie Montclair was de naam van de Geallieerde aanval (van Amerikaanse en Australische strijdkrachten) tussen 1 mei en 15 augustus 1945 bedoeld om de Japanse strijdkrachten te verslaan en Nederlands-Indië, Sarawak, Brunei, Labuan, Borneo en de zuidelijke Filipijnen te bezetten."@nl;
    skos:altLabel "Operation Montclair"@nl .
  
