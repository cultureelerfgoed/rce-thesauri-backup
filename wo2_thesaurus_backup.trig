    skos:prefLabel "Stalag 372 Pskow"@de, "Stalag 372 Pskow"@en, "Stalag 372 Pskow"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Stalag 372 was een Duits krijgsgevangenkamp in Pskow (Pleskau), Rusland. Het kamp was gevestigd in de stallen van het 5e Omsk Infantry Regiment en van augustus 1941 tot december 1943 in gebruik. Het was bestemd voor Russische krijgsgevangenen. Zo'n 75.000 soldaten en burgers kwamen hier om het leven. "@nl;
    skos:altLabel "Stalag 372"@nl, "Stalag 372 Pleskau"@nl, "Stalag Pleskau"@nl .
  
