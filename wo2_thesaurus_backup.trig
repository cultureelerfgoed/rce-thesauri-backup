    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/6407>, <https://data.niod.nl/WO2_Thesaurus/kampen/6411>;
    dcterms:created "2017-06-26T14:05:15.000Z"^^xsd:dateTime;
    skos:prefLabel "Stalag XVIII-A"@nl, "Stalag XVIII-A"@de, "Stalag XVIII-A"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Stalag XVIII-A was een Duits krijgsgevangenkamp ten zuiden van de stad Wolfsberg, Oostenrijk. Het ontstond in het voorjaar van 1941 omdat Oflag XVIII-B dat op 19 oktober 1939 geopend was als Stalag werd aangewezen in verband met de Arbeitseinsatz. Het aantal Franse gevangenen was het grootst. In december 1943 arriveerden zo'n 150 Nederlanders in het kamp. In augustus 1944 meldde het Rode Kruis 313 Arbeitskommando's die aan deze Stalag waren verbonden. Op 18 december 1944 kwamen er 46 gevangenen om het leven door een bombardement van Amerikaanse vliegtuigen. Het kamp werd op 11 mei 1945 door het Britse leger bevrijd."@nl;
    skos:altLabel "Lager Wolfsberg"@nl, "Oflag XVIII B"@nl, "Oflag XVIII-B"@nl, "Stalag XVIII A"@nl,
      "Stalag XVIII-A Wolfsberg"@nl .
  
