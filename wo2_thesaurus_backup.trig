      <https://data.niod.nl/WO2_Thesaurus/7815>;
    dcterms:created "2019-04-12T11:30:15.000Z"^^xsd:dateTime;
    skos:prefLabel "Bisschop Hamerhuis (Nijmegen)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Het Bisschop Hamerhuis, een voormalig missiehuis te Nijmegen, werd op 26 september 1944 gebruikt als opvangplek en noodziekenhuis voor  Britse Airbornes na de Slag om Arnhem. Naast verzorging van de gewonden werden de militairen opgevangen, konden ze bijkomen en werden ze voorzien van nieuwe uniformen."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/locations/8297> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2025-12-17T15:25:00.886Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/10290>;
    dcterms:source "https://www.tracesofwar.nl/sights/1520/Anti-tank-kanon-Waalbrug.htm"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/isPointofInterest> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/locations/9382>, <https://data.niod.nl/WO2_Thesaurus/events/4391>;
    dcterms:created "2019-04-12T11:56:15.000Z"^^xsd:dateTime;
    skos:prefLabel "Duits anti-tank kanon nabij Waalbrug (Nijmegen)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Het Duits anti-tank kanon nabij de Waalbrug te Nijmegen werd ingezet tijdens Operatie Market-Garden. Het betreft een Duits kanon van het type 50mm PAK 38 (PanzerAbwehrKanone), en was in september 1944 betrokken bij de gevechten rond het Hunnerpark en het Keizer Lodewijkplein in Nijmegen."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/locations/8298> a skos:Concept, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
