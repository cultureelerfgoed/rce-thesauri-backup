    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Oder-Neissegrens&oldid=48426007"@nl,
      "https://nl.wikipedia.org/w/index.php?title=Verdrijving_van_Duitsers_na_de_Tweede_Wereldoorlog&oldid=48641022"@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2642>, <https://data.niod.nl/WO2_Thesaurus/locations/8020>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/4796>;
    dcterms:created "2016-10-04T11:45:13.000Z"^^xsd:dateTime;
    skos:prefLabel "Oder-Neiße-Grenze"@de, "Oder–Neisse line"@en, "Oder-Neissegrens"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "De Oder-Neissegrens ontleent zijn naam aan de twee rivieren die de grens vormen tussen Duitsland en Polen en werd vastgesteld tijdens de Conferentie van Potsdam (17 juli tot 2 augustus 1945). De overeengekomen grensverlegging had tot gevolg dat het grondgebied van Duitsland drastisch verkleind werd en zo'n tien miljoen Duitsers, de zogeheten Heimatvertriebenen, het gebied moesten verlaten."@nl;
    skos:altLabel "Oder-Neiße-Linie"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4530> .
  
