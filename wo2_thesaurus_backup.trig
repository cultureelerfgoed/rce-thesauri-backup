    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Cambodjatribunaal (Buitengewone Kamers in de Gerechten van Cambodja, ofwel: Extraordinary Chambers in the Courts of Cambodia ; Tribunaux cambodgiens de chambres extraordinaires ; ECCC/CETC)  is een strafhof in Cambodja ter berechting van genocide, schendingen van de Geneefse Conventies, misdaden tegen de menselijkheid, moord en martelingen, gepleegd ten tijde van het bewind van de Rode Khmer (1975-1979)."@nl;
    skos:altLabel "Buitengewone Kamers in de Gerechten van Cambodja"@nl, "CETC"@nl, "Cambodja Tribunaal"@nl,
      "ECCC"@nl, "Extraordinary Chambers in the Courts of Cambodia"@nl;
