    <http://schema.org/location> "Golf van Leyte";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/fbe67946-0259-11e7-904b-d89d6717b464/media/ce2d33e2-aaf3-8d4a-3465-b73c34223232>,
      <https://beeldbankwo2.nl/nl/beelden/detail/fbe5dbb2-0259-11e7-904b-d89d6717b464/media/e222cba2-8a93-5221-6f78-9c146a0e25fa>,
