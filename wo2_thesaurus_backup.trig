    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/2b797104-025a-11e7-904b-d89d6717b464/media/a57a68c2-0b7d-bd71-fd79-51a79a7f08c1?mode=detail&view=horizontal&q=hagespraak%20de%20bevrijding&rows=1&page=20";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://www.openbeelden.nl/media/1127313>,
      <https://beeldbankwo2.nl/nl/beelden/detail/fb03cd66-025a-11e7-904b-d89d6717b464/media/628226ba-0ea6-55c8-de0b-04a8d2d491b6>;
    <http://schema.org/startDate> "1940-06-22"^^xsd:date;
    dcterms:source "https://beeldbankwo2.nl/nl/beelden/detail/2b78b7f0-025a-11e7-904b-d89d6717b464/media/58566f4a-c10f-b037-93a8-97c05f8e0561"@nl,
