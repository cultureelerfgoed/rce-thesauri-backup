      "http://www.blondepiet.nl/de-dropping/ "@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2675>;
    dcterms:created "2019-03-13T15:07:21.000Z"^^xsd:dateTime;
    skos:prefLabel "Wapendropping bij Eibergen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Wapendropping bij Eibergen vond op 27 maart 1945 plaats en de wapens waren bestemd voor de ondergrondse strijdkrachten van het gewest Zuid-West Twente. Deze actie, uitgevoerd door de Britse luchtmacht, kreeg de codenaam 'James'. Hoewel de dropping grotendeels geslaagd was, viel één van de containers in handen van de Duitsers."@nl;
    skos:altLabel "James"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/5472>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4669>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
