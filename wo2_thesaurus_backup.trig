    skos:prefLabel "AB (Advies Bureau)"@nl, "'AB (Advies Bureau)'"@de, "'AB (Advies Bureau)'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "AB (Advies Bureau) was een illegale organisatie opgericht in 1943 in Den Haag met het doel het werk verschillende verzetsgroepen in Den Haag te coördineren. Daarnaast ging de groep onderduikers verzorgen. De groep gaf tevens het illegale blad ‘De Stem van Strijdend Nederland; dagelijks nieuwsblad voor ’s-Gravenhage en omstreken’ (nr. 771 in L. Winkel, De Ondergrondse Pers) uit."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization>;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Organization> .
  
