    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://www.nationaalarchief.nl/onderzoeken/fotocollectie/ac057332-d0b4-102d-bcf8-003048976d84";
    <http://schema.org/location> "Venlo";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/1f2e07c0-025a-11e7-904b-d89d6717b464/media/2cc4631b-7493-1c27-f42d-2d4dd8511cc5>,
