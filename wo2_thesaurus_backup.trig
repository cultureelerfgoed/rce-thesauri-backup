    dcterms:created "2019-05-10T10:00:09.000Z"^^xsd:dateTime;
    skos:prefLabel "Transport Amsterdam - Kamp Vught, 26-05-1943"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Transport Amsterdam - Kamp Vught, 26-05-1943 vertrekt met vervolgden waarschijnlijk vanaf Amsterdam Muiderpoort. Op deze dag werden circa 3000 joden samengedreven op het Jonas Daniël Meijerplein te Amsterdam en daarvandaan per tram naar Station Amsterdam Muiderpoort gebracht. De grootse groep wordt naar Kamp Westerbork gedeporteerd, maar ook een deel naar Kamp Vught. Na per trein op Station Vught te zijn aangekomen gaan de vervolgden te voet of per bus verder naar Kamp Vught."@nl .
  
