    skos:prefLabel "Erz"@de, "Minerals"@en, "Delfstoffen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Delfstoffen zijn gesteenten en mineralen die kunnen worden aangewend tot nut van de mensheid en die economisch voordelig kunnen worden gewonnen."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/21920> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-02-23T12:25:37.704Z"^^xsd:dateTime;
