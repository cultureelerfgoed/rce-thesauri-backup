    skos:prefLabel "St. Lambrecht"@nl, "St. Lambrecht"@de, "St. Lambrecht"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "St Lambrecht was een buitenkamp van KZ Mauthausen. Er was een mannen- en vrouwenkamp. Het vrouwenkamp was enige tijd een buitenkamp van KZ Ravensbruck. Hieronder bevonden zich onder meer een grote groep Jehovah Getuigen. Het kamp was in gebruik van februari/maart 1943 tot mei 1945."@nl;
    skos:altLabel "St.-Lambrecht"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
