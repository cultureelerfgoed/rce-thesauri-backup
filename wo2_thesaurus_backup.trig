    dcterms:created "2021-10-20T13:06:46.265Z"^^xsd:dateTime;
    skos:prefLabel "Slag om Aken"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Slag bij Aken was een veldslag die plaatsvond tussen 2 oktober en 21 oktober 1944 rondom de stad Aken. Op 2 oktober trokken Amerikaanse troepen de buitenwijken in. Er ontstond een felle en dagenlange confrontatie met de Duitsers, eindigend in bombardementen op de stad. Op 21 oktober capituleerde kolonel Gerhard Wilck, tegen het bevel van Hitler in."@nl .
  
