    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://archief.amsterdam/beeldbank/detail/de798cae-f263-ef9e-2e11-287207484dd8";
    dcterms:source "https://isgeschiedenis.nl/nieuws/dierentuinen-in-oorlogstijd"@nl,
      "https://nl.wikipedia.org/wiki/Artis"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2824>;
    dcterms:created "2021-02-16T09:32:56.235Z"^^xsd:dateTime;
    skos:prefLabel "Dierentuin Artis"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote """ARTIS in Amsterdam bestaat sinds 1838 en is een stadspark met dieren, bomen en planten, musea, een Planetarium, Aquarium en monumenten. ARTIS bleef als enige Nederlandse dierentuin open tijdens de Duitse bezetting. Tijdens de mobilisatie waren er soldaten gelegerd en gedurende de oorlog verbleven er onderduikers.
ARTIS lag middenin een deel van de stad dat de Duitsers in februari 1941 aanmerkten als 'Joodsche Wijk'. Het park werd vanaf september voor Joden verboden.   """@nl;
    skos:altLabel "De Stichting tot Instandhouding van de Diergaarde van het Koninklijk Zoölogische Genootschap Natura Artis Magistra"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/11110> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2021-03-03T09:18:16.552Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/11111>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/a46fe83c-cef9-125c-9c2a-f448f6810d56.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/154f7f4a-025a-11e7-904b-d89d6717b464/media/a46fe83c-cef9-125c-9c2a-f448f6810d56";
    dcterms:source "https://isgeschiedenis.nl/nieuws/dierentuinen-in-oorlogstijd"@nl,
      "https://nl.wikipedia.org/wiki/Ouwehands_Dierenpark"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2824>;
    dcterms:created "2021-02-16T12:08:49.261Z"^^xsd:dateTime;
    skos:prefLabel "Ouwehands Dierenpark"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Ouwehands Dierenpark in Rhenen werd opgericht door Cor Ouwehand en opende zijn poorten in 1932. Toen op 10 mei 1940 de Duitsers Nederland binnenvielen lag het park opeens nabij de Grebbelinie en raakte zwaar beschadigd. De Nederlandse legerleiding vond dat de roofdieren uit voorzorg afgemaakt moesten worden vanwege ontsnappingsgevaar. In 1942 ging het park weer open, maar in september 1944 werd er opnieuw flink gevochten rond de Grebbeberg. In februari 1945 moest Ouwehand op bevel van de Duitsers het gebied verlaten en evacueerde hij de dieren richting Doorn. "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/11112> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "51.928160727819716"^^xsd:float;
    <http://www.w3.org/2003/01/geo/wgs84_pos#long> "4.444027106102831"^^xsd:float;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2025-12-24T09:22:16.988Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/ams/thumb/1000x1000/8c16c831-3277-5983-16a7-ab846096fb55.jpg";
    dcterms:source "https://isgeschiedenis.nl/nieuws/dierentuinen-in-oorlogstijd"@nl,
      "https://nl.wikipedia.org/wiki/Diergaarde_Blijdorp"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2824>, <https://data.niod.nl/WO2_Thesaurus/locations/9576>;
    dcterms:created "2021-02-16T13:42:19.910Z"^^xsd:dateTime;
    skos:prefLabel "Diergaarde Blijdorp (Rotterdam)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "In 1857 werd in de Rotterdamse binnenstad, bij de Kruiskade, de Rotterdamsche Diergaarde geopend. In 1937 werd besloten de dierentuin te verhuizen naar een nieuwe locatie in de wijk Blijdorp waar van 1939-1941 aan werd gebouwd. Tijdens de bombardementen op Rotterdam in mei 1940 werd de dierentuin zwaar getroffen en kwamen veel dieren om. De nieuwe locatie werd versneld op 7 juni 1940 in gebruik genomen. Door een succesvol fokprogramma was het aantal dieren bij de bevrijding groter dan vóór de oorlog. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/11114> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    dcterms:modified "2021-06-21T14:33:09.364Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/6e688ec4-6fa5-c550-b89f-6ad632df8159.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/2a098ee4-025a-11e7-904b-d89d6717b464/media/6e688ec4-6fa5-c550-b89f-6ad632df8159";
    dcterms:source "https://www.hetschermereiland.nl/collectie-en-historie/item/401-schermerhorn-in-woii-het-zuidje-met-wegwijzer-naar-marine-lazarett-20-11-1942.html"@nl,
      "https://de.m.wikipedia.org/wiki/Marinelazarette_der_Kriegsmarine#Bereich_Belgien_und_die_Niederlande"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4571>;
    dcterms:created "2021-02-16T14:33:01.311Z"^^xsd:dateTime;
    skos:prefLabel "Marine-Lazarette"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Tijdens de Tweede Wereldoorlog had de Kriegsmarine 80 Marine-Lazarette langs de Noord- en Oostzee. In Nederland waren deze Lazarette gevestigd in Bergen op Zoom, Heiloo en Eindhoven. Het Lazarett in Bergen op Zoom verhuisde in oktober 1944 naar Rotterdam en het Lazarett in Eindhoven ging in oktober 1944 naar Rastede in Duitsland. Het Lazarett in Heiloo was gevestigd in de St. Willibrordus dat in Duitse handen was. Willibrordus was gunstig gelegen, dichtbij de havens van IJmuiden en Den Helder. De stichting hield er een zwembad aan over."@nl;
    skos:altLabel "Marinehospitalen"@nl .
  
