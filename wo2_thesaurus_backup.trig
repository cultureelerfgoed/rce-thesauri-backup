    dcterms:created "2020-07-30T08:12:47.000Z"^^xsd:dateTime;
    skos:prefLabel "NSB mag zonder vergunning openbare optochten in uniform houden"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Op 31 oktober 1940 bepaalde de Höheren SS und Polizeiführer Rauter dat de NSB zonder voorafgaande toestemming van de plaatselijke autoriteiten en de procureur-generaal toestemming had om in het openbaar en in uniform optochten te houden. De WA kreeg ook de opdracht om de plaatselijke politie 'bij te staan' bij het uitoefenen van haar taken. Door deze maatregel kregen zowel de WA als de NJS meer bewegingsruimte om zich publiekelijk te manifesteren."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9128> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Lea Appel, Het brood der doden. Geschiedenis en ondergang van een joods meisjes-weeshuis (Bosch & Keuning: Baarn, 1982)"@nl;
