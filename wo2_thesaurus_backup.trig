    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Verzuiling&oldid=48615732"@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/demoadmin>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1765>, <https://data.niod.nl/WO2_Thesaurus/2717>;
    dcterms:created "2016-08-01T19:21:07.000Z"^^xsd:dateTime;
    skos:prefLabel "Versäulung"@de, "Pillarisation"@en, "Verzuiling"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Verzuiling is de verdeling van een samenleving in groepen op levensbeschouwelijke of sociaal-economische basis, waarbij de groepen in bepaalde mate van elkaar zijn afgeschermd."@nl;
    skos:definition "Verzuiling is de verdeling van een samenleving in groepen op levensbeschouwelijke of sociaal-economische basis, waarbij de groepen in bepaalde mate van elkaar zijn afgeschermd. In Nederland werd de scheiding vormgegeven doordat iedere zuil zijn eigen kerk, omroep, krant, standsorganisatie, vakbond, politieke partij, woningbouwvereniging, scoutinggroep, scholen, ziekenhuis, sportverenigingen en zelfs winkels en bedrijven had. Voor het midden van de 20e eeuw was deze situatie zelfs zo frappant, dat bijvoorbeeld bepaalde Nederlandse winkelbedrijven bij voorkeur personeelsleden aanstelden die lid waren van een bepaald kerkgenootschap."@nl .
  
