    dcterms:created "2018-07-16T06:31:00.000Z"^^xsd:dateTime;
    skos:prefLabel "Oflag IX-A/Z"@de, "Oflag IX-A/Z"@en, "Oflag IX-A/Z"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Oflag IX-A/Z was een Duits krijgsgevangenkamp en een subkamp van Oflag IX-A/H. Het heette eerst Oflag IX-C en lag in Rotenburg an den Fulda, Duitsland. Het was een kamp voor geallieerde officieren, ingericht in 1939 met de komst van 700 Poolse officieren. In 1945 werd het kamp geëvacueerd en moesten de gevangenen naar het Oosten marcheren. Op 13 april 1945 werden ze in Wimmelburg door het Amerikaanse leger bevrijd. "@nl;
    skos:altLabel "Oflag IX-AZ"@nl, "Oflag IX A/Z"@nl, "Oflag IX AZ"@nl, "Oflag IX-A/Z Rotenburg"@nl,
      "Oflag IX-A/Z Rotenburg an der Fulda"@nl, "Oflag Rotenburg"@nl, "Oflag Rotenburg an der Fulda"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/6474> a <http://schema.org/Thing>, skos:Concept,
