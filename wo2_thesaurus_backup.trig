    skos:prefLabel "Inrichtingen voor Gerepatrieerden uit Indië"@nl, "Inrichtingen voor Gerepatrieerden uit Indië"@de,
      "Inrichtingen voor Gerepatrieerden uit Indië"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Inrichtingen voor Gerepatrieerden uit Indië (IGI) waren tehuizen en noodverzorgingshuizen voor Indische repatrianten in de periode 1946-1947. De oprichting en het beleid hiervan viel toe aan het Centraal Bureau Verzorging Oorlogsslachtoffers. In mei 1947 woonden landelijk ruim 12.500 Indische Nederlanders in IGI's."@nl;
    skos:altLabel "Inrichting voor Gerepatrieerden uit Indië"@nl, "IGI"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/10581>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/10660> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "L. de Jong, Koninkrijk der Nederlanden in de Tweede Wereldoorlog. Deel 6, 286 e.v."@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-01-19T12:26:36.670Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/feb85aae-19d6-5d84-f425-601f2f80d933.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/d28d7892-0259-11e7-904b-d89d6717b464/media/feb85aae-19d6-5d84-f425-601f2f80d933";
    skos:relatedMatch <https://data.niod.nl/WO2_biografieen/Karel-Johannes-Frederiks>,
      <https://data.niod.nl/WO2_biografieen/Rita-Clara-Bosman>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2014>;
    dcterms:created "2020-12-01T08:04:00.667Z"^^xsd:dateTime;
    skos:prefLabel "Plan-Frederiks"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het Plan-Frederiks was een plan van secretaris-generaal K.J. Frederiks en secretaris-generaal J. van Dam om bepaalde Joden, in verband met hun maatschappelijke betekenis, vrij te stellen van deportatie. In de zomer van 1942 stemde Generalkommissar zur besonderen Verwendung Fritz Schmidt in met plan. Enkele honderden Joden werden op deze lijst geplaatst. Zij stonden bekend als de Barneveldgroep of de Barneveldlijst. De groep werd vanaf december 1942 ondergebracht in zogenaamde Beschermingskampen, Huize De Schaffelaar en Huize De Biezen in Barneveld en Villa Bouchina in Doetichem. Toch werden zij uiteindelijk naar Kamp Westerbork, Theresienstadt en Bergen-Belsen gedeporteerd."@nl;
    skos:altLabel "Plan Frederiks"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/8286> .
  
