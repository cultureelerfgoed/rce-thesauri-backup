    <http://schema.org/startDate> "1949-08-23"^^xsd:date;
    <http://schema.org/endDate> "1949-11-02"^^xsd:date;
    dcterms:source "https://www.youtube.com/watch?v=SjkYXMXSZmo"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/4379>, <https://data.niod.nl/WO2_Thesaurus/2629>,
      <https://data.niod.nl/WO2_Thesaurus/5110>;
    dcterms:created "2019-04-02T15:02:35.000Z"^^xsd:dateTime;
    skos:prefLabel "De Rondetafelconferentie"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Tijdens De Rondetafelconferentie, van 23 augustus 1949 tot 2 november 1949 in Den Haag, vinden er politieke onderhandelingen plaats tussen vertegenwoordigers van Nederland, de Republiek Indonesië en de Bijeenkomst van Federaal Overleg (BFO, de vertegenwoordiging van de verschillende staten die Nederland in de Indonesische archipel heeft gecreëerd). De conferentie eindigde met de afspraak de Nederlandse soevereiniteit over te dragen aan de Verenigde Staten van Indonesië."@nl;
    skos:altLabel "Rondetafelconferentie"@nl, "Konperensi Meja Bundar"@nl, "Ronde Tafel Conferentie"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8269> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:33:48.791Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8145>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/wo2nedindieThema> "Japans bestuur";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/250x250/36ed6986-6d61-6d42-79b1-cad0a2648d1e.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/5b78ca8a-025a-11e7-904b-d89d6717b464/media/36ed6986-6d61-6d42-79b1-cad0a2648d1e";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/56272ea0-025a-11e7-904b-d89d6717b464/media/bda79d25-1d63-4f64-75eb-ee6aa51851a9>,
      <https://www.archieven.nl/nl/search-modonly?mivast=298&mizig=210&miadt=298&micode=402&milang=nl&miview=inv2>;
    <http://schema.org/startDate> "1942-04-29"^^xsd:date;
    <http://schema.org/description> "Op de verjaardag van de Japanse keizer lanceert het propagandadepartement van het leger de Tiga-A (Drie-A) beweging. Het Japanse bestuur wil de Indonesische bevolking vertrouwd maken met de ‘Groot Oost-Aziatische Welvaartssfeer’: de economische invloedsfeer die onder Japanse leiding in Azië wordt opgebouwd. De Maleise leuze van de Tiga-A beweging is: ‘Tjahaja Asia Nipon, Pelindoeng Asia hipon, Pemimpin Asia hipon’ (Japan is het Licht, de Beschermer en de Leider van Azië). De Tiga-A beweging is een onderdeel van het beleid om Java te Japaniseren. Daartoe worden ook de Japanse jaartelling (1942 wordt het jaar 2062), de Japanse uurtijd (de Tokio-tijd), de Japanse feestdagen, de keizerverering en het verplichte eerbewijzen aan Japanse militairen ingevoerd. Op alle inheemse lagere scholen wordt Japanse les opgenomen in het onderwijsprogramma. Er komt tegelijkertijd een algemeen verbod op de Nederlandse taal."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/7762>, <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2019-04-03T11:25:17.000Z"^^xsd:dateTime;
    skos:prefLabel "Lancering Tiga-A beweging"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Lancering van de de Tiga-A (Drie-A) beweging vindt plaats op de verjaardag van de Japanse keizer op 29 april 1942. De Maleise leuze van de Tiga-A beweging is: ‘Tjahaja Asia Nipon, Pelindoeng Asia hipon, Pemimpin Asia hipon’ (Japan is het Licht, de Beschermer en de Leider van Azië). De Tiga-A beweging is een onderdeel van het beleid om Java te Japaniseren."@nl .
  
