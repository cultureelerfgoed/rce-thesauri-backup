    dcterms:created "2020-08-18T06:45:13.000Z"^^xsd:dateTime;
    skos:prefLabel "Vervolgprocessen Auschwitz"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Vervolgprocessen van Auschwitz vonden in 1973, 1981, 2015 en 2016 plaats in verschillende Duitse steden. Individuele werknemers van concentratiekamp Auschwitz, die vaak al op leeftijd waren, stonden hier terecht. Zo kreeg in 2015 oorlogsmisdadiger Oskar Gröning, de 'Boekhouder van Auschwitz',  zijn vonnis te horen."@nl;
    skos:altLabel "Proces Detmold"@nl, "Proces Lüneburg"@nl .
  
