      "https://nl.wikipedia.org/w/index.php?title=Rotterdamsche_Bank&oldid=69628007"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/20703>;
    dcterms:created "2026-05-20T10:42:59.680Z"^^xsd:dateTime;
    skos:prefLabel "Rotterdamsche Bankvereeniging"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Rotterdamsche Bankvereeniging (ROBAVER), ook de Rotterdamsche Bank genoemd, was een Nederlandse bank met vestigingen in diverse steden. Tijdens het Bombardement op Rotterdam werd het hoofdkantoor verwoest. Het nieuwe kantoor aan de Coolsingel begon in 1941 en was pas in 1949 voltooid. Tijdens de bezetting werd Joods personeel ontslagen. Een vestiging in Velp werd door de Sicherheitsdienst (SD) als gevangenis gebruikt."@nl;
    skos:altLabel "Rotterdamsche Bank"@nl, "Rotterdamse Bank"@nl, "ROBAVER"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/7998>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
