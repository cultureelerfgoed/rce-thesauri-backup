    skos:prefLabel "Arrestatie van Truus van Lier"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Arrestatie van Truus van Lier vond plaats op 14 september 1943 in Haarlem. Na de liquidatie van Gerardus Johannes Kerlen zette de SD een beloning van 10.000 gulden op haar hoofd. Ze kon uiteindelijk gearresteerd worden door verraad."@en;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9053> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Wikipedia"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
