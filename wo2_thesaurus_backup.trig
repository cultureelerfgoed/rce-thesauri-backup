    dcterms:source "https://nl.wikipedia.org/wiki/Reichsschule_Heythuysen"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    skos:relatedMatch <https://data.niod.nl/WO2_Thesaurus/11247>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/17300>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/6032>;
    dcterms:created "2021-08-03T08:22:08.313Z"^^xsd:dateTime;
    skos:prefLabel "Reichsschule Heythuysen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Reichsschule Heythuysen was een door de SS opgericht opleidingsinstituut en internaat voor Nederlandse meisjes. Doel was ze op te leiden als levenspartner voor SS-ers. Het werd op 1 september 1942 in Heythuysen opgericht en dat was op dezelfde datum als de opening van de Reichsschule Valkenburg voor jongens. Jkvr. Julia op ten Noort werd dankzij haar goede relatie met Heinrich Himmler de directrice maar in 1944 opgevolgd door Fraülein Hiesz. Aan het eind van de oorlog gingen de leerlingen uit veiligheidsoverwegingen naar een evacuatieoord in Reichenau. Toen de Franse troepen in april 1945 daar binnenvielen sloot de school. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/1730> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
