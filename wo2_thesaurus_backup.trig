    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/4f3aec76-025a-11e7-904b-d89d6717b464/media/054a1b8d-5839-ddd0-d922-4dccb24b2448";
    <http://schema.org/location> "Parijs";
    dcterms:source "https://nl.wikipedia.org/wiki/Radio_Vrij_Nederland"@nl;
    skos:relatedMatch <https://data.niod.nl/WO2_biografieen/Josepha-Mendels>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2365>;
    dcterms:created "2021-06-01T12:10:32.025Z"^^xsd:dateTime;
    skos:prefLabel "Radio Vrij Nederland"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Radio Vrij Nederland werd kort na de Duitse inval in Nederland opgericht door een aantal Nederlandse correspondenten in Parijs. Op 19 mei 1940 vond de eerste uitzending plaats vanuit Parijs. Eén maand lang, drie uitzendingen per dag. De uitzendingen werden op 10 juni 1940 beëindigd omdat de Duitse troepen vlak voor Parijs stonden. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/13020> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:04:42.964Z"^^xsd:dateTime;
    <https://data.niod.nl/eventsWO2/fromLocation> <https://data.niod.nl/WO2_Thesaurus/kampen/3654>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/cf99a05a-79b6-03c7-7fce-893d28026cc9.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/170e8e2a-025a-11e7-904b-d89d6717b464/media/cf99a05a-79b6-03c7-7fce-893d28026cc9";
    <http://schema.org/location> "Bergen-Belsen";
    <http://schema.org/startDate> "1944-06-29"^^xsd:date;
    <http://schema.org/endDate> "1944-07-10"^^xsd:date;
    dcterms:source "https://www.joodsamsterdam.nl/transport-222/"@nl, "https://www.trouw.nl/nieuws/nog-steeds-vragen-over-ruil-duitsers-joden-in-44~ba425654/"@nl,
      "https://www.nporadio1.nl/nieuws/geschiedenis/0ba11fa5-ea69-453d-8dd8-51e309f15e11/hoe-222-joden-werden-gered-door-een-ruil-met-een-duitse-sekte-ovt-michael-menno-kalmann"@nl;
    <https://data.niod.nl/eventsWO2/toLocation> <https://data.niod.nl/WO2_Thesaurus/locations/18421>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/3654>;
    dcterms:created "2021-06-03T08:49:39.631Z"^^xsd:dateTime;
    skos:prefLabel "Exchange Jews Bergen-Belsen - Palestine"@en, "Uitruil Joden Bergen-Belsen - Palestina"@nl,
      "Austausch Juden Bergen-Belsen - Palästina"@de;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Op 29 juni 1944 verlieten 222 Joden Kamp Bergen-Belsen om op 10 juli in Haifa te arriveren. Het was een uitwisseling met een groep Duitse Tempeliers uit Palestina en het resultaat van onderhandelingen tussen de Britten en de Duitsers. Palestina was in Engelse handen en leden van de Duitse Tempeliers waren daar gevangen genomen. Er bestond een Palestina-lijst, de Istanboellijst, waar zo'n 1100 Joden op stonden die voor uitwisseling in aanmerking kwamen. De voor de uitwisseling in aanmerking komende Joden van de lijst waren echter onvindbaar of overleden en daarom stelden de Duitsers voor Joden uit Bergen-Belsen voor deze uitwisseling te gebruiken. De Duitsers werden door de Engelsen gehouden aan de verplichting om de vermiste personen van de Istanboellijst op te sporen, want deze 222 Joden vulden slechts tijdelijk de lege plaatsen op."@nl;
    skos:altLabel "Ruil Duitsers-Joden 1944"@nl, "Transport 222"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
