    <http://schema.org/location> "Walcheren";
    <http://schema.org/startDate> "1942-08-04"^^xsd:date;
    <http://schema.org/endDate> "1942-08-31"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1922>;
    dcterms:created "2022-01-05T15:02:02.933Z"^^xsd:dateTime;
    skos:prefLabel "Evacuatie van Walcheren 1942"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Tijdens de Evacuatie van Walcheren in augustus 1942 werden ongeveer 10.000 bewoners die niet werkten, zoals bejaarden, van het eiland geëvacueerd. Ongeveer 7.500 van hen vonden zelf onderdak binnen de provincie Zeeland. De rest werd ondergebracht in de aangewezen opvanggemeenten in Noord-Brabant."@nl .
  
