    dcterms:created "2022-01-06T14:58:46.135Z"^^xsd:dateTime;
    skos:prefLabel "Evacuatie van Westervoort"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Evacuatie van Westervoort vond plaats op 16 november 1944. De evacuatie werd op 14 november bekendgemaakt, maar de inwoners vertrokken pas vrijwillig op 16 november nadat er hevige beschietingen hadden plaatsgevonden tussen de geallieerden vanuit de Betuwe en de Duitsers vanuit de Liemers. De inwoners kregen evacuatieadressen toegewezen in Hengelo (Gld) en Keijenborg. Een aantal mensen vond zelf onderdak bij familie en vrienden. "@nl .
  
