    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://www.4en5mei.nl/herdenken-en-vieren/oorlogsmonumenten/monumenten_zoeken/oorlogsmonument/4129>;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Quarantainestation_Heijplaat&oldid=58226430"@de;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/17282>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1669>;
    dcterms:created "2021-02-10T09:43:28.650Z"^^xsd:dateTime;
    skos:prefLabel "Quarantainestation Heijplaat"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het Quarantainestation Heijplaat werd aanvankelijk als inrichting voor zeelieden gebruikt. Vanaf december 1938 werd het complex gebruikt voor de opvang van Joodse vluchtelingen uit Duitsland en Oostenrijk. In november 1939 sloot het vluchtelingenkamp en werden de vluchtelingen overgeplaatst. Toen in het voorjaar van 1945 een tyfusepidemie uitbrak in Spijkenisse werden zieken door het Rode Kruis opgevangen in Heijplaat. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
