    skos:prefLabel "'Volk en Vaderland'"@de, "'Volk en Vaderland'"@en, "Volk en Vaderland"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "Volk en Vaderland (vaak afgekort tot 'VoVa') was van 1933 tot 1945 het weekblad van de NSB, uitgegeven door de nationaalsocialistische uitgeverij Nenasu. Het verscheen in het formaat van een krant en het was propagandistisch van inhoud. Iedere week werd overal in Nederland gecolporteerd met Volk en Vaderland en geregeld leidde deze propagandistische colportage tot relletjes met anti-NSB'ers. De redactie was gevestigd in het pand op de Maliebaan 31."@nl;
    skos:altLabel "VoVa"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/20064>, <https://data.niod.nl/WO2_Thesaurus/20065> .
  
