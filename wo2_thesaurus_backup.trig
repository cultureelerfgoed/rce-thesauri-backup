    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "COVIM, de Centrale Commissie tot Organisatie van Vrouwenarbeid in Mobilisatietijd werd opgericht in september 1939 in Nederlands-Indië, met het doel vrouwenarbeid te organiseren voor de defensie-inspanning. Onder de centrale COVIM kwamen plaatselijke afdelingen, die onder meer EHBO-cursussen organiseerden, hulp aan luchtbeschermingsdiensten verleenden, transporten van slachtoffers voorbereidden, noodkeukens inrichtten en dergelijke."@nl;
    skos:altLabel "Centrale Commissie tot Organisatie van Vrouwenarbeid in Mobilisatietijd"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2344>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7706> a <http://schema.org/Thing>,
      skos:Concept;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:35:28.227Z"^^xsd:dateTime;
