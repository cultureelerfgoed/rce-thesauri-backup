    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/c04ec8f2-0259-11e7-904b-d89d6717b464/media/dc0a3c72-5d10-6039-b9ce-c31a4cd12ad5";
    dcterms:source "https://sztetl.org.pl/pl/miejscowosci/o/53-ostrow-mazowiecka/116-miejsca-martyrologii/49256-oboz-jeniecki-w-komorowie"@nl;
