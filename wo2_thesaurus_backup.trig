    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Een advocaat-fiscaal (AF) was een jurist binnen de bijzondere rechtspleging. Een AF kon werken bij een Bijzonder Gerechtshof of bij de Bijzondere Raad van Cassatie. De AF ondersteunde de procureur-fiscaal, een speciale openbaar aanklager die ook voor een van deze twee instellingen kon werken. Bij de Bijzondere Gerechtshoven kon de AF optreden namens de procureur-fiscaal. Hij kon verdachten vervolgen, aanklagen en straffen eisen. Bij de Bijzondere Raad van Cassatie ondersteunde de AF de procureur-fiscaal bij het opstellen van het advies over de beslissing van zaken."@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/19586>;
    dcterms:created "2024-05-23T08:06:25.863Z"^^xsd:dateTime;
    skos:prefLabel "Advocaat-Fiscaal"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "Een advocaat-fiscaal (AF) was een jurist binnen de bijzondere rechtspleging. Een AF kon werken bij een Bijzonder Gerechtshof of bij de Bijzondere Raad van Cassatie. De AF ondersteunde de procureur-fiscaal, een speciale openbaar aanklager die ook voor een van deze twee instellingen kon werken. Bij de Bijzondere Gerechtshoven kon de AF optreden namens de procureur-fiscaal. Hij kon verdachten vervolgen, aanklagen en straffen eisen. Bij de Bijzondere Raad van Cassatie ondersteunde de AF de procureur-fiscaal bij het opstellen van het advies over de beslissing van zaken."@nl;
    skos:altLabel "Advocaat Fiscaal"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <https://data.niod.nl/thesaurus_wo2/ImagesWW2/Legislation>;
    skos:hiddenLabel "AF"@nl .
  
