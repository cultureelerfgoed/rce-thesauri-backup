    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/7ce9d1d5-5a81-e74e-0c89-228238a02eda.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/07306aaa-025a-11e7-904b-d89d6717b464/media/7ce9d1d5-5a81-e74e-0c89-228238a02eda";
    <http://schema.org/location> "Londen";
