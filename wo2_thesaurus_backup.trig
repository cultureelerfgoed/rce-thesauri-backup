    <http://schema.org/startDate> "1945-04-09"^^xsd:date;
    dcterms:source "https://www.rtvoost.nl/nieuws/326824/WOII-in-foto-s-tanks-door-de-straten-van-Nijverdal"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/6983>;
    dcterms:created "2020-10-12T14:37:06.166Z"^^xsd:dateTime;
    skos:prefLabel "Bevrijding Nijverdal"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Op 9 april 1945 werd Nijverdal bevrijd. Voordat de Duitsers vertrokken werd de brug in de Rijksweg naar Almelo opgeblazen en vervolgens die in Hulsen. Vanuit Rijssen en over het Hexel kwam de Tweede Canadese Infanterie Divisie Nijverdal binnenrijden. Er was nauwelijks verzet. De volgende morgen trokken de Canadezen naar Hellendoorn, waarmee de gehele gemeente was bevrijd. "@nl .
  
