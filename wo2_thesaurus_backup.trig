    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Een wachtmeester had de rang van onderofficier binnen de Rijkspolitie (reguliere politie). De reguliere politie nam vanaf 1 januari 1948 het opsporen en verhoren van verdachten over van de opsporingsdiensten van de bijzondere rechtspleging."@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/19853>;
