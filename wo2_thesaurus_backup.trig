    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>;
    dcterms:created "2019-11-07T10:23:49.000Z"^^xsd:dateTime;
    skos:prefLabel "Afgeluisterd"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Afgeluisterd was een verzetsblad dat vanaf 6 juni 1944 tot 6 oktober 1944 dagelijks verscheen in Putte: een grensdorp dat gedeeltelijk in de Nederlandse provincie Noord-Brabant ligt als in de Belgische provincie Antwerpen. De oplage fluctueerde van tussen de één stuk de eerste twee weken tot 1500 na Dolle Dinsdga (5 september 1944), maar verscheen meestal in een oplage van 300 stuk. Na de Bevrijding van Putte verscheen het blad legaal onder de titel De Zuidwesthoek."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8659> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "PPN: 268596484"@de;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2019-11-13T11:19:33.000Z"^^xsd:dateTime;
