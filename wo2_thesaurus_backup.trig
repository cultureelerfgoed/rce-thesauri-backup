    skos:prefLabel "Transport Kamp Amersfoort - Westerbork, 16-07-1942"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Transport van een groep van 309 joden vanuit Kamp Amersfoort naar Westerbork. Deze groep werd diezelfde dag toegevoegd aan het transport van Westerbork naar Auschwitz-Birkenau."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/5896> .
  
  <https://data.niod.nl/WO2_Thesaurus/17292> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/diggelenm>;
    dcterms:modified "2021-07-27T10:53:36.033Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/17293>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1571>;
    dcterms:created "2021-07-27T08:42:53.026Z"^^xsd:dateTime;
    skos:prefLabel "Rattenlijn Noord"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Rattenlijn Noord was een vluchtroute waarlangs in de eindfase van de Tweede Wereldoorlog een aantal hooggeplaatste nazi-leiders naar Flensburg in Schleswig-Holstein vluchtten. Karl Dönitz had als opvolger van Adolf Hitler de laatste Nazi-regering (Flensburgregering) daarnaartoe verplaatst in mei 1945. Enkele bekende nationaal-socialisten die van deze rattenlinie gebruik maakten waren Heinrich Himmler, Oswald Pohl, Rudolf Höss, Arthur Liebehenschel, Karl Gebhardt, en Karl Brandt. In tegenstelling tot andere rattenlijnen, voerde deze niet buiten Europa. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/8571> .
  
  <https://data.niod.nl/WO2_Thesaurus/17299> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-06-03T13:46:37.922Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/9898>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://imageviewer.kb.nl/ImagingService/imagingService?id=ddd:010331125:mpeg21:p003:image&w=1000";
