    dcterms:created "2023-05-08T08:44:36.602Z"^^xsd:dateTime;
    skos:prefLabel "Amerikaanse bombardementen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De eerste Amerikaanse bombardementen op doelen in Nederland vonden vanaf augustus 1942 plaats. Gedurende de oorlog werden vooral Nederlandse vliegvelden en bruggen gebombardeerd. In mei 1945 werden de voedseldroppingen onder de codenaam Operation Chowhound uitgevoerd."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/19542> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Zwanenburg, G.J., En nooit was het stil, Deel 2, pag. 43"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2023-08-23T09:49:45.149Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/10268>;
    <http://schema.org/startDate> "1943-07-25"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/19538>;
    dcterms:created "2023-05-09T07:13:43.657Z"^^xsd:dateTime;
    skos:prefLabel "Bombardement op Fokkerfabrieken in Amsterdam-Noord, 25 juli 1943"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De geallieerde bombardementen op Amsterdam-Noord in juli 1943 waren gericht op de Fokker vliegtuigfabrieken aldaar. Het eerste bombardement op 17 juli kwam echter grotendeels in de woonwijken van de Bloemenbuurt terecht. Op zondag 25 juli raakten 10 Engelse Mitchell bommenwerpers de vliegtuigfabriek Fokker en vernietigden het complex grotendeels. Meer dan 200 mensen verloren bij de bombardementen het leven."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/19582> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Peter Serrien, Tranen over Mortsel. De laatste getuigen over het zwaarste bombardement ooit in België (Antwerpen: Uitgeverij Manteau. 2013)"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2023-06-14T07:33:12.838Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/19584>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/7/78/Mortsel-anno-1943-bombardement-op-fout-doelwit-kost-936-levens.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/w/index.php?title=File:Mortsel-anno-1943-bombardement-op-fout-doelwit-kost-936-levens.jpg&oldid=746955180";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <http://nimh-beeldbank.defensie.nl/memorix/5652c3ed-3121-4af5-801c-bb4263c51cc4>,
      <https://beeldbankwo2.nl/nl/beelden/detail/b0c201ec-0259-11e7-904b-d89d6717b464/media/e6622652-6ac5-cbb3-7fca-bbd6a9478b5f>;
    <http://schema.org/startDate> "1943-04-05"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Bombardement_op_Mortsel&oldid=64403051"@nl,
      "https://www.vrt.be/vrtnws/nl/2020/07/07/de-936-oorlogsdoden-waarover-gezwegen-moest-worden/"@nl,
      "https://mainzerbeobachter.com/2023/04/05/het-bombardement-op-mortsel/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/19540>;
    dcterms:created "2023-06-05T11:43:23.893Z"^^xsd:dateTime;
    skos:prefLabel "Bombardement op Mortsel"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Het Bombardement op Mortsel vond plaats op 5 april 1943. De Minerva-autofabriek in Mortsel werd door de Duitsers omgevormd tot de Frontreparateurbetrieb Erla VII dat vliegtuigonderdelen voor de Luftwaffe fabriceerde. De 1ste en 2de Bomb Divisions van de VIII Bomber Command van de United States Army Air Force bestaande uit 104 B-17 Flying Fortress en B-24 Liberator bommenwerpers bombardeerde de wapenfabriek met circa 815 bommen waarvan er slechts 4 op de Erla-fabriek vielen. De Erla-fabriek, de nabijgelegen Gevaert-fabriek, een ziekenhuis, vier scholen en 3424 huizen in de omliggende woonwijk Oude-God werden verwoest. Er kwamen zeker 936 burgers om en er vielen 1342 gewonden, waardoor het bombardement op Mortsel één van de hevigste bombardementen in België was."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/19628> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    dcterms:modified "2025-06-12T08:45:18.301Z"^^xsd:dateTime;
