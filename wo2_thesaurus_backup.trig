    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het illegale blad De Domme Hollander werd waarschijnlijk uitgegeven door de letterkundige Maurits Dekker."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8748> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "PPN: 269244573"@nl;
