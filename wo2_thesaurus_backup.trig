    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/ravend>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2163>, <https://data.niod.nl/WO2_Thesaurus/2210>;
    dcterms:created "2026-02-18T11:16:49.135Z"^^xsd:dateTime;
    skos:prefLabel "Kunsthandel Ween en Klepman"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Kunsthandel Ween en Klepman was een kunsthandel die in 1912 werd opgericht op het Rokin 16, Amsterdam. Vanaf 1936 werd de kunsthandel gerund door Salomon Klepman en zijn zoon Joseph Klepman. In 1940 werd het bedrijf overgenomen door Belfort N.V., onder leiding van Jan Hendrik Wallien maar bleef handelen onder de originele bedrijfsnaam. Een groot deel van de familie Klepman werd in 1943 vermoord in Auschwitz, waaronder Joseph Klepman."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/21934> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/VosJ>;
    dcterms:modified "2026-04-07T07:50:04.032Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/en/9/9b/Fuhrermuseum_model.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://en.wikipedia.org/wiki/File:Fuhrermuseum_model.jpg"@nl;
    dcterms:source """https://en.wikipedia.org/wiki/F%C3%BChrermuseum
https://nl.wikipedia.org/wiki/Linzer_Sammlung"""@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/ravend>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1816>, <https://data.niod.nl/WO2_Thesaurus/1829>;
    dcterms:created "2026-02-18T11:26:36.258Z"^^xsd:dateTime;
    skos:prefLabel "Führermuseum Linz"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het Führermuseum was een niet-gerealiseerd kunstmuseum bedacht door Adolf Hitler voor de stad Linz in Oostenrijk. Het doel van Hitler was om Linz de culturele hoofdstad van Europa te maken met een groots kunstmuseum als middelpunt. Het ontwerp voor het complex werd gemaakt door Hermann Giesler. Via de Sonderauftrag Linz werden voor de collectie van het museum duizenden objecten aangekocht en geroofd door heel Europa. Hans Posse (tot 1942) en Hermann Voss (vanaf 1942) werden hiervoor aangesteld."@nl;
    skos:altLabel "Linzer Sammlung"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/21935> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-02-23T12:53:59.464Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/6/67/The_Sacrifice_of_Iphigenia_by_Jan_Havickszoon_Steen.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/wiki/Category:Goudstikker_collection?uselang=de#/media/File:The_Sacrifice_of_Iphigenia_by_Jan_Havickszoon_Steen.jpg"@nl;
    dcterms:source "https://www.proveana.de/de/koerperschaft/sonderauftrag-linz"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/ravend>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1816>, <https://data.niod.nl/WO2_Thesaurus/20712>;
    dcterms:created "2026-02-18T11:26:36.269Z"^^xsd:dateTime;
    skos:prefLabel "Sonderauftrag Linz"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Sonderauftrag Linz werd opgericht in 1939 en was een door Adolf Hitler opgerichte organisatie die rechtstreeks aan hem ondergeschikt was. De taak van de organisatie was om kunstwerken te verzamelen voor het door Hitler geplande Führermuseum in Linz. De collectie kwam tot stand door middel van confiscatie en aankoop en was ook bedoeld om over de musea van het Duitse Rijk te verdelen."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/21936> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
