    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/De_Wachttoren#/media/Bestand:Watchtower_May_1918_(Dutch_Edition).png";
    dcterms:source "https://nl.wikipedia.org/wiki/De_Wachttoren"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2543>, <https://data.niod.nl/WO2_Thesaurus/2376>;
    dcterms:created "2021-09-08T11:48:26.608Z"^^xsd:dateTime;
    skos:prefLabel "De Wachttoren"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "De Wachttoren is de belangrijkste publicatie van Jehova's getuigen. Tijdens de Duitse bezetting werd het tijdschrift gedrukt bij drukkerij C.V. v/h Ridderinkhof, Ruys & Co in Amsterdam en kende het een geregelde aanvoer."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/17587> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    dcterms:modified "2021-09-23T11:43:36.811Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/17588>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/1/16/KZ-Schandelah-Beton.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/wiki/File:KZ-Schandelah-Beton.jpg";
    dcterms:source "https://de.wikipedia.org/wiki/KZ-Au%C3%9Fenlager_Schandelah"@nl, "https://www.kz-gedenkstaette-neuengamme.de/en/history/satellite-camps/satellite-camps/schandelah/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/3688>, <https://data.niod.nl/WO2_Thesaurus/1670>;
    dcterms:created "2021-09-08T12:03:14.577Z"^^xsd:dateTime;
    skos:prefLabel "Schandelah"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Concentratiekamp Schandelah was een buitenkamp van Neuengamme en lag in de buurt van Braunschweig, Nedersaksen. Het kamp werd in 1944 gebouwd toen de oorlogsbrandstofindustrie werd verwoest door bombardementen van de geallieerden. Het was een belangrijke faciliteit voor de Duitsers voor onderzoek en productie van synthetische benzine uit olieschalie. Gevangenen moesten olieschalie winnen, accommodaties bouwen en experimentele ovens laden. In november 1944 zaten er ongeveer 800 gevangenen van diverse nationaliteiten. Vanwege de oprukkende Amerikaanse troepen werden de gevangenen op 10 april 1945 naar het opvangkamp Wöbbelin vervoerd. Daar werden ze op 2 mei 1945 door Amerikaanse soldaten bevrijd."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/1759> a <http://schema.org/Thing>, skos:Concept;
