    skos:prefLabel "Val Kabinet Konoe"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Val Kabinet Konoe vindt plaats op 16 oktober 1941. Premier Konoe Fumimaro slaagt er niet in de Verenigde Staten te bewegen tot opheffing of een afzwakking van het algemeen handelsembargo. Keizer Hirohito vraagt Tojo Hideki een nieuw kabinet te vormen."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8163> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
