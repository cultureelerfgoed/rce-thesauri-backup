    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/ravend>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4578>;
    dcterms:created "2026-02-18T11:29:56.899Z"^^xsd:dateTime;
    skos:prefLabel "Herrenloses Gut"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Herrenloses Judengut zijn objecten die eigenaarloos werden ingebracht bij de Liro roofbank zonder dat de bezetter deze onder een specifieke familie of eigenaar registreerde. Deze objecten werden vervolgens geregistreerd onder de noemer van Herrenloses Juden Gut."@nl;
    skos:altLabel "Herrenloses Juden Gut"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/21948> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>, <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    dcterms:modified "2026-02-19T09:39:39.969Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/21952>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://www.historisches-lexikon-bayerns.de/images/4/4c/Central_Collecting_Point.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://www.historisches-lexikon-bayerns.de/Lexikon/Central_Art_Collecting_Point_%281945-1949%29#/media/Datei:Central_Collecting_Point.jpg"@nl;
    dcterms:source "https://www.nga.gov/munich-central-collecting-point-archive"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/ravend>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/21912>;
    dcterms:created "2026-02-18T11:32:22.443Z"^^xsd:dateTime;
    skos:prefLabel "München Central Collecting Point"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het München Central Collecting Point was het grootste centrale verzamelpunt dat werd opgericht om onderdak te bieden aan de door de nazi's in beslag genomen kunstwerken en andere culturele voorwerpen. Hier werden de objecten geïdentificeerd, gefotografeerd en teruggegeven aan hun landen van herkomst. De kunstwerken die via het centrale verzamelpunt in München werden teruggegeven, waren afkomstig uit vele Europese musea en particuliere collecties, waarvan een groot deel Frans en Nederlands was. Het centrale verzamelpunt beëindigde zijn teruggaveactiviteiten in 1951."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
