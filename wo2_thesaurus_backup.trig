    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/download/default/91371202-fbb4-b85d-79f2-a9eb9c248c01.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/f942de86-025a-11e7-904b-d89d6717b464/media/91371202-fbb4-b85d-79f2-a9eb9c248c01"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Het Tribunaal te Alkmaar was een speciale rechtbank die na de Tweede Wereldoorlog werd ingesteld om personen te beoordelen die verdacht werden van collaboratie. Zo oordeelden Tribunalen over personen die lid waren geweest van de NSB of openlijk steun hadden betoond aan de Duitse bezetter. De Tribunalen konden onder andere een internering (gevangenisstraf) van maximaal 10 jaar opleggen en (een gedeelte van) het vermogen afnemen. Ze konden ook (tijdelijk) bepaalde burgerrechten afnemen, zoals kiesrecht, het bekleden van publieke ambten, of het dienen in het leger. Verdachten die personen hadden verraden of vermoord, of bij het Duitse leger waren gegaan, werden berecht door een Bijzonder Gerechtshof."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/19276>;
    dcterms:created "2023-02-10T14:47:04.704Z"^^xsd:dateTime;
    skos:prefLabel "Tribunaal Alkmaar"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "Het Tribunaal Alkmaar was een rechtscollege binnen de Bijzondere Rechtspleging dat was ingesteld om de minder zware gevallen van collaboratie te behandelen. Tribunalen waren bevoegd om maximaal 10 jaar gevangenisstraf op te leggen."@nl;
    skos:altLabel "Tribunaal te Alkmaar"@nl, "Tribunaal voor het Arrondissement Alkmaar"@nl;
    skos:hiddenLabel "Trib. Alkmaar"@nl .
  
