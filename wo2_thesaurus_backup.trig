    dcterms:created "2021-01-27T11:21:35.603Z"^^xsd:dateTime;
    skos:prefLabel "Aanslag op Hermann Heinrich Pennings"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Op 19 februari 1945 vond een aanslag plaats waarbij SS'er en SD'er Hermann Heinrich Pennings op de Rotterdamse Coolsingel in zijn hoofd werd geschoten. De kogel in Pennings kaak werd operatief verwijderd in vermoedelijk het Rotterdamse marineziekenhuis. Hiervan moest hij nog maanden herstellen. Als represaille werden op 20 februari 1945 tien mensen gefusilleerd."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/10965> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-03-04T11:08:28.849Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/9582>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/lei/thumb/1000x1000/98c3b1d5-757b-c3f9-2f8f-ce123e7fe4c9.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://www.erfgoedleiden.nl/schatkamer/beeldbank-wo-ii/zoeken-in-beeldbank-woii/detail/033a7268-26be-11e3-b2b5-3cd92befe4f8";
    <http://schema.org/location> "Den Haag";
    <http://schema.org/startDate> "1940-06-05"^^xsd:date;
    dcterms:source "http://noviopost.nl/archief-Novioposta/nr05/nr05b.pdf"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2213>;
    dcterms:created "2021-01-27T11:51:03.787Z"^^xsd:dateTime;
    skos:prefLabel "Oprichting DDPN"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 5 juni 1940 werd door de Duitsers de Deutsche Dienstpost Niederlande (DDPN) ingesteld. Dit gebeurde om in Nederland de post te verzorgen van de militaire eenheden die hier gelegerd werden, maar ook voor de post van de Duitse instanties die in Nederland gevestigd werden. De Nederlandse PTT bleef ook in bedrijf. In totaal zijn er in meer dan dertig plaatsen kantoren van de DDPN geweest. Daarnaast waren er nog Abgabe- en Abholstellen want DDNP bezorgde niet aan huis. In april 1945 werden de laatste kantoren opgeheven."@nl;
    skos:altLabel "Oprichting Deutsche Dienstpost Niederlande"@nl .
  
