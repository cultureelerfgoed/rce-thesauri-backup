    dcterms:created "2022-01-10T13:12:34.690Z"^^xsd:dateTime;
    skos:prefLabel "Evacuatie van Haarlem"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Evacuatie van Haarlem vond plaats vanaf 19 september 1944. Om de Duitse verdedigingslinie in Haarlem te voltooien moest een groot deel van de inwoners van Haarlem-Noord evacueren. 4.140 woningen kwamen leeg te staan. Na 5 mei 1945 konden de inwoners van Haarlem-Noord terug naar hun woningen."@nl .
  
