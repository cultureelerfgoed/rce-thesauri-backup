    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>;
    dcterms:created "2019-11-07T14:09:22.000Z"^^xsd:dateTime;
    skos:prefLabel "Berichten van de GPD (Geallieerde Persdienst)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het illegale blad Berichten van de GPD (Geallieerde Persdienst) werd van eind juni 1944 tot begin november 1944 uitgegeven in Tilburg (Noord-Brabant) door L.J. van den Gevel, in samenw. met H.C.C. Want. Het blad verscheen ook onder de titel: Persdienst van de GPD. "@nl;
    skos:altLabel "Persdienst van de GPD"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8683> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "PPN: 268960208"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2020-09-01T06:46:45.000Z"^^xsd:dateTime;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>;
    dcterms:created "2019-11-07T14:10:54.000Z"^^xsd:dateTime;
    skos:prefLabel "Berichten van 5 october 1944"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het illegale blad Berichten van 5 October 1944 werd vanaf 5 oktober 1944 uitgegeven in Diemen (Noord-Holland) door H. Dierdorp. Aanvankelijk werd in Diemen een illegaal blad uitgegeven met de titel Berichten van ... October door een meneer Spits ten kantore van een levensverzekeringsmaatschappij. In de zomer van 1944 moest deze man onderduiken en vanaf 5 oktober 1944 werd zijn werk voortgezet door H. Dierdorp."@nl .
  
