    <http://schema.org/location> "Woudenberg";
    <http://schema.org/startDate> "1940-05-10"^^xsd:date;
    <http://schema.org/endDate> "1940-05-21"^^xsd:date;
    dcterms:source "https://www.oudwoudenberg.nl/documents/OWBlad/Oud%20Woudenberg%202005-3%20HCatharina%20-%20Koepel-%20Evacues%20Wieringermeer.pdf"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1922>, <https://data.niod.nl/WO2_Thesaurus/2322>;
    dcterms:created "2022-01-10T13:02:35.032Z"^^xsd:dateTime;
    skos:prefLabel "Evacuatie van Woudenberg, Scherpenzeel en Renswoude"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Evacuatie van Woudenberg, Scherpenzeel en Renswoude vond plaats op 10 en 11 mei 1940, vanwege de Duitse inval in Nederland en de ligging van de plaatsen in de Grebbelinie. Ongeveer 6.000 inwoners werden geëvacueerd naar Wieringermeer, Barsingerhorn, Winkel, Wieringerwaard en Oudorp. De evacuatie was al in februari 1940 voorbereid. Ongeveer 1.500 inwoners keerden na de capitulatie op 15 mei 1940 op eigen gelegenheid terug naar huis. De overige evacués werden op 20 en 21 mei 1940 met bussen teruggebracht."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/18596> a <http://schema.org/Thing>, skos:Concept,
