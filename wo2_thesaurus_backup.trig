    dcterms:created "2018-11-07T14:18:56.000Z"^^xsd:dateTime;
    skos:prefLabel "Arbeitseinsatzlager Erika, 1944 - 1945"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Arbeitseinsatzlager Erika functioneerde vanaf ergens in het najaar 1944 tot aan de bevrijding op 11 april 1945 weer als een justitieel strafkamp om de overvolle gevangenissen te ontlasten. Het kamp werd nu geleid door de SS en SD. De kampgevangenen bestonden uit opgepakte verzetsstrijders, ontduikers van de ‘Arbeidsinzet’ en studenten die weigeren om een loyaliteitsverklaring te tekenen. Ook bevonden zich mensen uit de wijde omgeving, die niet Duitsgezind waren."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
