      "https://histvermaassluis.nl/het-fluitincident-een-kwajongensstreek-met-gruwelijke-gevolgen/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2677>;
