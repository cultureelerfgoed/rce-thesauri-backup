    skos:prefLabel "Keisatsubu"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Keisatsubu waren gewestelijke kantoren voor politiezaken in het door Japan bezette Nederlands-Indië en stond onder direct gezag van de Gunseikanbu."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7789> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-04-09T14:39:37.201Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8028>;
    dcterms:source "https://en.wikipedia.org/w/index.php?title=Persatuan_Muslim_Indonesia&oldid=868188095"@en;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2506>, <https://data.niod.nl/WO2_Thesaurus/20702>;
    dcterms:created "2019-01-29T10:29:15.000Z"^^xsd:dateTime;
    skos:prefLabel "Persatuan Muslim Indonesia"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Persatuan Muslim Indonesia (PERMI) bestond van 1930 tot 18 oktober 1937 en werd opgericht door de voormalige leden van de Sumatera Thawalib. Het doel van de organisatie was een onafhankelijk Indonesië, maar dan wel op islamitische basis (geen scheiding tussen kerk en staat). De macht van de partij begon af te brokkelen toen de Nederlandse machthebbers de bewegingsruimte van de partij begon in te perken en belangrijke figuren arresteerden. "@nl;
    skos:altLabel "PERMI"@nl, "Union of Indonesian Muslims"@en, "Unie van Indonesische Moslims"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7790> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "Peter Post - The Encyclopedia of Indonesia in the Pacific War"@en;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:33:47.488Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8019>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/3/3b/Insignia_of_the_South_East_Asia_Command.svg/500px-Insignia_of_the_South_East_Asia_Command.svg.png";
    dcterms:source "https://en.wikipedia.org/w/index.php?title=South_East_Asia_Command&oldid=860126703"@en;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/events/8227>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1865>, <https://data.niod.nl/WO2_Thesaurus/1854>,
      <https://data.niod.nl/WO2_Thesaurus/20711>;
    dcterms:created "2019-01-29T11:00:27.000Z"^^xsd:dateTime;
    skos:prefLabel "South East Asia Command"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De South East Asia Command (SEAC) bestond van augustus 1943 tot november 1946 naast de South West Pacific Area. Het betrof een gecombineerde gevechtseenheid van de geallieerden, opgericht door de legerleiding van de Britten en Amerikanen. De leiding was in handen van admiraal Lord Louis Mountbatten. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2350>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7791> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "Peter Post - The Encyclopedia of Indonesia in the Pacific War"@en;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:34:35.814Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8019>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/e/ea/GHQ_Southwest_Pacific_Area_%28SWPA%29_shoulder_sleeve_insignia.jpg";
    dcterms:source "https://en.wikipedia.org/w/index.php?title=South_West_Pacific_Area_(command)&oldid=878485493"@en;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1865>, <https://data.niod.nl/WO2_Thesaurus/1854>,
      <https://data.niod.nl/WO2_Thesaurus/20711>;
    dcterms:created "2019-01-29T11:27:57.000Z"^^xsd:dateTime;
    skos:prefLabel "South West Pacific Area"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De South West Pacific Area (SWPA) was een legereenheid die bestond van 30 maart 1942 tot 2 september 1945. Het was bedacht door de Nieuw-Zeelandse en Australische strijdkrachten en opgericht door de gecombineerde legerleiding van de Amerikanen en de Britten. De SWPA stond onder leiding van de Amerikaanse generaal Douglas MacArthur met als doel controle te verkrijgen over de gebieden van en rondom Nederland-Indië en Nieuw-Guinea.   "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2350>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7792> a <http://schema.org/Thing>,
      skos:Concept;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:33:17.296Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8028>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/events/8272>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4561>, <https://data.niod.nl/WO2_Thesaurus/20702>;
    dcterms:created "2019-01-29T11:57:33.000Z"^^xsd:dateTime;
    skos:prefLabel "Keibodan"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Keibodan bestond van 29 april 1943 tot het eind van de Japanse bezetting in Indonesië en werd opgericht door de bezetter. Het was de hulppolitie die de Kempetai ondersteuning gaf en bestond uit lokale mensen."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/4382> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7793> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "B.R. Immerzeel - Verzet in Nederlands-Indië tegen de Japanse bezetting 1942-1945"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:35:54.972Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8028>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/2669>;
    dcterms:created "2019-01-29T12:41:16.000Z"^^xsd:dateTime;
    skos:prefLabel "Groep Kramer/Wernink"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Groep Kramer/Wernink was een verzetsorganisatie waarvan gelijk na de Japanse-bezetting al de activiteiten begonnen. Dankzij samenwerking met nachtwakersgroepen beschikte de groep over veel informatie over de bezetter. Deze inlichtingen werden gebruikt voor sabotagedaden en voorbereidingen op een geallieerde landing. Na de arrestatie van een RAF-piloot, die informatie over de bezetter naar Australië wilde smokkelen, werd het verzet volledig opgerold en de belangrijkste figuren geëxecuteerd.  "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/4382>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7794> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "Leo de Jong - Het Koninkrijk der Nederlanden in de Tweede Wereldoorlog"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:35:01.084Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8028>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/2669>;
    dcterms:created "2019-01-30T09:46:47.000Z"^^xsd:dateTime;
    skos:prefLabel "Groep-Welten"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Groep-Welten bestond kortstondig van juli 1942 tot september 1942 en werd opgezet door L.J. Welten. Zijn doel was het plaatsen van een zender, om contact te kunnen leggen met de geallieerden. Welten werd echter al in september opgepakt en de zender, welke zo goed als af was, is nooit in gebruik genomen. "@nl;
    skos:altLabel "Groep Welten"@nl, "Welten-groep"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/4382>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7795> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>, <http://schema.org/Event>;
