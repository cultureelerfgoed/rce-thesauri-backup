    <http://schema.org/startDate> "1944-07-08"^^xsd:date;
    dcterms:source "https://wikimiddenbrabant.nl/Vliegtuigcrash_Van_Hogendorpstraat,_8_juli_1944"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2329>;
    dcterms:created "2025-10-09T11:35:57.584Z"^^xsd:dateTime;
    skos:prefLabel "Vliegtuigcrash Van Hogendorpstraat Tilburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De crash van een Duitse bommenwerper in de Van Hogendorpstraat in Tilburg vond plaats op 8 juli 1944. Tegen middernacht stort een Duitse bommenwerper neer op het huis Van Hogendorpstraat 135, nabij de Hasseltstraat, waarna een grote brand uitbreekt. Daarbij komen de vijf bewoners van het pand om het leven. Ook de vier bemanningsleden van het Duitse toestel dat kort daarvoor was opgestegen van Fliegerhorst Gilze-Rijen met als doelwit de Seinemonding kwamen om."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/21859> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
