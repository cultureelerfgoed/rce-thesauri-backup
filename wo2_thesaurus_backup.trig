      <https://data.niod.nl/WO2_Thesaurus/corporaties/4622>;
    dcterms:created "2019-03-12T13:00:18.000Z"^^xsd:dateTime;
    skos:prefLabel "Overval distributiekantoor Asperen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Overval op het distributiekantoor van Asperen op 18 januari 1945 vond onder leiding van OD-lid Evert Nool en een dag nadat deze groep ook een boerderij van een NSB-boer had overvallen. Door een tip van een infiltrant die voor de Duitse Abwehr werkt, valt de Geheime Feldpolizei op 25 januari 1945 enkele adressen in Leerdam, Heukelum en Asperen binnen en worden de verzetsmannen opgepakt. Ze worden naar de strafgevangenis in Utrecht overgebracht en uiteindelijk op 31 maart 1945 door de Duitsers gefusilleerd in fort De Bilt bij Utrecht."@nl .
  
