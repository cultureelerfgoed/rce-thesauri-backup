    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4717>, <https://data.niod.nl/WO2_Thesaurus/1613>,
      <https://data.niod.nl/WO2_Thesaurus/20640>;
    dcterms:created "2019-02-13T12:10:18.000Z"^^xsd:dateTime;
    skos:prefLabel "SS-Freiwilligen-Standarte Nordwest"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De SS-Freiwilligen-Standarte Nordwest was een onderdeel van de Waffen SS dat in april 1941 was opgericht om Nederlandse en Vlaamse vrijwilligers in op te nemen. De eisen gesteld aan de raciale en fysieke conditie van de vrijwilligers waren minder streng dan elders in de Waffen SS. De SS-Freiwilligen-Standarte Nordwest zou in het najaar van 1941 opgaan in het Vrijwilligerslegioen Niederlande."@nl;
    skos:altLabel "SS Freiwilligen-Standarte Nordwest"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
