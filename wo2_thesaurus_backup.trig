    <http://schema.org/endDate> "1944-10-27"^^xsd:date;
    dcterms:source "https://wikimiddenbrabant.nl/Granaatinslagen_Broekhoven_I,_26_en_27_oktober_1944"@nl,
      "https://wikimiddenbrabant.nl/Granaatinslagen_Broekhoven_II,_26_en_27_oktober_1944"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/8508>;
    dcterms:created "2025-10-08T12:49:33.824Z"^^xsd:dateTime;
    skos:prefLabel "Granaatinslagen Broekhoven Tilburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De granaatinslagen in de wijk Broekhoven in Tilburg vonden plaats op 26 en 27 oktober 1944. Tijdens de gevechten van de Nederlanders, Britten en Schotten om Tilburg te bevrijden ligt Broekhoven onder granaatvuur omdat daar Duitse artilleriestellingen staan. Het oostelijke deel van Broekhoven wordt het zwaarst getroffen. Hierbij komen vijftien personen om het leven. In een ander deel van Broekhoven vallen in totaal zeven doden. Op 27 oktober 1944 wordt Tilburg bevrijd."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
