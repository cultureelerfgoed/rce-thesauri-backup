      <https://data.niod.nl/WO2_biografieen/Pieter-Marinus-Heertjes>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Binnenlandse Strijdkrachten (BS) werden gevormd uit verschillende verzetsgroepen aan het einde van de Tweede Wereldoorlog. De BS arresteerden in de eerste maanden na de bevrijding verdachten van collaboratie. Vanaf februari 1946 namen de Politieke Opsporings Diensten (POD’s) die taak volledig van de BS over."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/10920>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2527>, <https://data.niod.nl/WO2_Thesaurus/1618>,
      <https://data.niod.nl/WO2_Thesaurus/1854>, <https://data.niod.nl/WO2_Thesaurus/20711>;
    dcterms:created "2016-10-04T13:07:39.000Z"^^xsd:dateTime;
    skos:prefLabel "'Binnenlandse Strijdkrachten'"@de, "'Binnenlandse Strijdkrachten'"@en,
      "Binnenlandse Strijdkrachten"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:exactMatch <https://digitaalerfgoed.poolparty.biz/westerbork/2920>;
    skos:topConceptOf <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Nederlandse Binnenlandse Strijdkrachten (NBS) was een op 5 september 1944 officieel opgezette bundeling van de tot dan toe weinig samenwerkende verzetsgroepen, de Ordedienst (OD), de Landelijke Knokploegen (LKP) en de Raad van Verzet (RVV). De Binnenlandse Strijdkrachten bestonden uit de Bewakingstroepen (BT), soms ook Niet Strijdend Gedeelte (NSG) genoemd, en het Strijdend Gedeelte (SG) die ook Stoottroepen werden genoemd. Bewakingstroepen voerden tijdens de bevrijding vooral politietaken uit, zoals ordehandhaving en het oppakken van (vermeende) collaborateurs. Het Strijdend Gedeelte streed in het gewapend verzet of met het geallieerde leger mee. De NBS werd vanaf 8 augustus 1945 geleidelijk ontbonden en veel manschappen gingen op in nieuwe militaire eenheden."@nl;
    skos:altLabel "Binnenlandsche Strijdkrachten"@nl, "Nederlandsche Binnenlandsche Strijdkrachten"@nl,
      "Nederlandse Binnenlandse Strijdkrachten"@nl, "Binnenl. Strijdkrachten (NBS)"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/locations/8139>, <https://data.niod.nl/WO2_Thesaurus/events/8109>,
      <https://data.niod.nl/WO2_Thesaurus/events/9592>, <https://data.niod.nl/WO2_Thesaurus/events/10936>,
      <https://data.niod.nl/WO2_Thesaurus/events/8132>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization>;
    skos:hiddenLabel "N.B.S."@nl, "B.S."@nl, "NBS"@nl, "BS"@nl .
  
