    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/08b27904-025a-11e7-904b-d89d6717b464/media/eef20a22-9f66-0e65-b014-a0ba2fa88da3";
    dcterms:source "https://www.japansekrijgsgevangenkampen.nl/Non%20Pladuk.htm"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/b7354d29-49d5-4fe0-922a-3f3b5929fa84>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1699>, <https://data.niod.nl/WO2_Thesaurus/21031>;
    dcterms:created "2024-08-05T10:40:33.962Z"^^xsd:dateTime;
    skos:prefLabel "Non Pladuk"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Non Pladuk was het basiskamp van de Birma Siam Spoorweg. Het kamp fungeerde als werkkamp en vervolgens als hospitaalkamp. Eind 1943 werd aan de andere kant van de weg een tweede kamp gebouwd, Non Pladuk II genaamd. De kampen werden na bombardementen op 22 februari 1945 opgeheven. De werkzaamheden waren o.a. de aanleg van spoorrails, het in- en uitladen van voedsel en munitie bij de werk- en opslagplaats Hashimoto en het bouwen van kamp II."@nl;
    skos:altLabel "Nong Pladuk"@nl, "Nompladuk"@nl, "Non Pladuk - 0"@nl, "Nompladuk II"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Thing> .
  
