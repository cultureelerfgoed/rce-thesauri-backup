    <http://schema.org/location> "Katwijk";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://www.erfgoedleiden.nl/schatkamer/beeldbank-wo-ii/zoeken-in-beeldbank-woii/detail/1616862e-26be-11e3-b56f-3cd92befe4f8>,
