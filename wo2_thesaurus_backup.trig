    <https://data.niod.nl/eventsWO2/toLocation> <https://data.niod.nl/WO2_Thesaurus/locations/11458>;
    skos:relatedMatch <https://data.niod.nl/WO2_biografieen/Adolf-Frans-Petalo>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
