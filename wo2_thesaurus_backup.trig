    dcterms:created "2019-02-12T09:51:26.000Z"^^xsd:dateTime;
    skos:prefLabel "PAGI"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De PAGI was bestond van oktober 1942 tot het eind van de Japanse bezetting in Nederlands-Indië en werd opgericht door Pieter Hendrick van den Eeckhout. Het doel van de groep was de Indo-Europeanen gelijk stellen met de inheemse bevolking en de Japanse bezetter ondersteunen. De groep heeft nooit heel veel leden gehad, maar staat wel bekend om zijn wreedheden in de Jappenkampen jegens voornamelijk de Nederlandse gevangenen. "@nl;
    skos:altLabel "Persaudaraan Asia Golongan Indo"@de, "Aziatische Broederschap van de Indo-Europeanen"@nl,
      "Indo-European Group of the Asia Brotherhood"@en;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
