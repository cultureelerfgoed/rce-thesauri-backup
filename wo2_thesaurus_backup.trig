    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://www.archieven.nl/nl/search-modonly?mivast=298&mizig=210&miadt=298&miaet=1&micode=244&minr=3244893&miview=inv2#MF3244893";
    <http://schema.org/location> "Indonesië";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://www.nationaalarchief.nl/onderzoeken/fotocollectie/a8a51747-ea9c-fe54-7a31-e4d4f5de1841>,
      <https://beeldbankwo2.nl/nl/beelden/detail/ddf6a342-025a-11e7-904b-d89d6717b464/media/a634ee0d-4d13-8df1-ed2d-247bc9b351ae>;
    <http://schema.org/startDate> "1940-05-10"^^xsd:date;
    <http://schema.org/description> "Na het bericht van de Duitse inval in Nederland worden in Nederlands-Indië NSB’ers, Duitsers, Oostenrijkers en ‘vijandelijke onderdanen’ gearresteerd. In totaal telt de groep bijna 2.800 mannen en 147 Duitse vrouwen met hun kinderen. Onder de Duitsers bevinden zich naast nationaal-socialisten ook Duitse joden, politieke vluchtelingen uit Duitse gebieden en zelfs genaturaliseerde ex-Duitsers."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/events/10662>, <https://data.niod.nl/WO2_Thesaurus/events/10663>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2322>, <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2019-03-19T08:33:37.000Z"^^xsd:dateTime;
    skos:prefLabel "Start internering 'vijandelijke onderdanen' Nederlands-Indië"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Start internering 'vijandelijke onderdanen' Nederlands-Indië vond plaats na het bericht van de Duitse inval in Nederland en hierbij werden in Nederlands-Indië NSB’ers, Duitsers, Oostenrijkers en andere ‘vijandelijke onderdanen’ gearresteerd. In totaal telde de groep bijna 2.800 mannen en 147 Duitse vrouwen met hun kinderen. Onder de Duitsers bevonden zich naast nationaalsocialisten ook Duitse joden, politieke vluchtelingen uit Duitse gebieden en zelfs genaturaliseerde ex-Duitsers."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4795>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4765>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/7709> .
  
