    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/c06a7290-025a-11e7-904b-d89d6717b464/media/7d77e437-5cf8-bf9b-df36-7277ab8c7dfe";
    <http://schema.org/startDate> "1942-03-11"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
