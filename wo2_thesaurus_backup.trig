    <http://schema.org/startDate> "1944-10-23"^^xsd:date;
    dcterms:source "https://wikimiddenbrabant.nl/Moord_op_Wim_van_Wezel,_Oude_Rielsebaan,_23_oktober_1944"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2682>;
    dcterms:created "2025-10-08T13:48:32.458Z"^^xsd:dateTime;
    skos:prefLabel "Moord op Wim van Wezel Tilburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De moord op Wim van Wezel in Tilburg vond plaats op 23 oktober 1944. Wim van Wezel wordt doodgeschoten door leden van de verzetsgroep waar hij mee samenwerkt. Zij vinden Van Wezel een gevaar vanwege zijn roekeloze gedrag en willen hem gevangennemen. Wanneer Van Wezel zijn pistool trekt, wordt hij neergeschoten. Hij wordt ter plekke begraven en pas 31 oktober gevonden door zijn schoonvader."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/21846> a <http://schema.org/Thing>, skos:Concept,
