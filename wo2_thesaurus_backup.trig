    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/b7354d29-49d5-4fe0-922a-3f3b5929fa84>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1690>, <https://data.niod.nl/WO2_Thesaurus/1631>,
      <https://data.niod.nl/WO2_Thesaurus/8204>, <https://data.niod.nl/WO2_Thesaurus/19098>;
    dcterms:created "2025-01-06T20:21:53.887Z"^^xsd:dateTime;
    skos:prefLabel "Vredeburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Vredeburg was een mannenkamp en een republikeins kamp in het centrum van Yogyakarta, op de hoek van de Kampementstraat (nu Jl. Panembahan Senopati) en de Residentlaan (nu Jl. Margo Mulya). Het kamp was ondergebracht in enkele gebouwen binnen Fort Vredebrug. In de periode van 16 juni 1942 tot februari 1944 waren hier 897 mannen geïnterneerd waaronder ambtenaren die voorheen in de Yogyakarta Gevangenis zaten en burgers uit Yogyakarta en omgeving. In de periode van 12 oktober 1945 tot 2 november 1945 functioneerde Vredeburg als republikeins kamp. 1200 mannen en oudere jongens werden opgepakt en opgesloten in de onderaardse cellen van Fort Vredeburg om vervolgens in andere republikeinse kampen in Yogyakarta en omgeving ondergebracht te worden."@nl;
    skos:altLabel "Fort Vredeburg"@nl, "Benteng"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/21489> a <http://schema.org/Thing>, skos:Concept,
