    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/ams/thumb/350x350/e3ee0358-055a-209f-0cea-4d59f7a90a79.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://archief.amsterdam/beeldbank/detail/8a92a30a-4c25-17b6-a15c-cdd357956b7d";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/360b02c2-025a-11e7-904b-d89d6717b464/media/fe892e1b-e57c-9ad9-4171-550698ed6e3b>;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Gerrit_van_der_Veenstraat&oldid=56726912"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
