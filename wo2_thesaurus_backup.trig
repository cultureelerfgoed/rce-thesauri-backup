    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Biologische_oorlogvoering&oldid=48835462"@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/demoadmin>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2300>;
    dcterms:created "2016-08-01T19:20:12.000Z"^^xsd:dateTime;
    skos:prefLabel "Bakteriologische Kriegsführung"@de, "Bacteriological warfare"@en,
      "Bacteriologische oorlogvoering"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Bacteriologische oorlogvoering is oorlogvoering waarbij bacteriën als wapens worden gebruikt. Tijdens de Tweede Wereldoorlog gebruikten de Japanse bezetters van China de pest tegen de Chinese bevolking. De Duitsers zetten in 1943 de drooggemalen Pontijnse moerassen in Italië weer onder water zodat malaria kon terugkeren en eventueel de door het gebied oprukkende geallieerde troepen de ziekte zouden oplopen."@nl;
    skos:altLabel "Biologische oorlogvoering"@nl .
  
