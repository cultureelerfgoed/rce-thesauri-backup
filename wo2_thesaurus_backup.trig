    <http://schema.org/startDate> "1944-07-18"^^xsd:date;
    dcterms:source "https://en.wikipedia.org/w/index.php?title=Kuniaki_Koiso&oldid=884917473"@en;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2019-03-29T09:10:10.000Z"^^xsd:dateTime;
    skos:prefLabel "Aantreden premier Kuniaki Koiso"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Het Aantreden premier Kuniaki Koiso op 18 juli 1944 volgt op de val van het kabinet Tojo. De val van kabinet Tojo is het gevolg van de Amerikaanse verovering van Saipan in de Marianen Eilanden op 7 juli 1944, waarbij de Japanse marine zware verliezen moet incasseren. Japan komt nu binnen het bereik van Amerikaanse B-29 bommenwerpers."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8230> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-03-08T14:56:35.995Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/9566>;
