    skos:prefLabel "Passagiers St. Louis in Quarantaine op Heijplaat"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote """Nederland nam 181 opvarenden van de St. Louis op: allen werden in quarantaine genomen op in Quarantainestation Heijplaat bij Rotterdam.  
Bron:https://heijmerikx.nl/"""@nl;
