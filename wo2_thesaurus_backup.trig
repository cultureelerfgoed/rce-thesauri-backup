    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/2bbf1682-025a-11e7-904b-d89d6717b464/media/67f3b75a-38c4-43d4-4cc7-c1c4a26eeb4b";
    <http://schema.org/startDate> "1943-09-25"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2682>;
    dcterms:created "2021-02-11T12:06:56.532Z"^^xsd:dateTime;
    skos:prefLabel "Liquidatie van Hendrik Oosterveen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De liquidatie van Hendrik Oosterveen vond plaats op 25 september 1943 in De Wijk. Oosterveen was landbouwer en lid van de NSB. Hij werd gezien als verrader en door twee mannen die zich uitgaven voor politieagenten in zijn woning doodgeschoten. Zijn vrouw raakte zwaargewond."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/11084> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Recht op Wraak. Liquidaties in Nederland 1940-1945, Jack Kooistra en Albert Oosthoek, Leeuwarden 2009"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:26:11.766Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/11085>;
    <http://schema.org/startDate> "1944-07-25"^^xsd:date;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2682>;
    dcterms:created "2021-02-11T14:23:02.789Z"^^xsd:dateTime;
    skos:prefLabel "Liquidatie van Teunis Ouwerkerk"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De liquidatie van Teunis Ouwerkerk vond plaats op 25 juli 1944 in de polder 'Den Duyl' bij Almkerk. Ouwerkerk was een schipper en bekend onder zijn bijnaam Nappie. Zijn grote voorbeeld was keizer Napoleon, vandaar zijn bijnaam. Bij het verzet stond hij bekend als verrader. Hij werd door vier personen in landwachtuniform in een auto meegenomen, doodgeschoten en in de polder gedumpt."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/11087> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Recht op wraak. Liquidaties in Nederland 1940-1945, Jack Kooistra en Albert Oosthoek, Leeuwarden 2009"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
