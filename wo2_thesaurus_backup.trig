    skos:prefLabel "Groep Schoemaker"@nl, "'Groep Schoemaker'"@de, "'Groep Schoemaker'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Groep Schoemaker was een verzetsgroep van studenten in Delft rond professor Richard Schoemaker, die vanaf 1940 actief was met het verzamelen van wapens en spionage. Na verraad werd Schoemaker opgepakt, waarna hij op 3 mei 1942 werd gefusilleerd."@nl;
    skos:altLabel "Schoemaker-Groep"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
