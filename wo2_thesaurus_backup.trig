  <https://data.niod.nl/WO2_Thesaurus/events/7056> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    dcterms:modified "2022-02-01T11:47:59.373Z"^^xsd:dateTime;
