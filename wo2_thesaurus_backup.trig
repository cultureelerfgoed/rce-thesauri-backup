      "Bombing of Enkhuizen, October 6, 1940"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Het eerste bombardement op Enkhuizen vond plaats op 6 oktober 1940. De explosieven vielen in de omgeving van de Oostertuinstraat en Paktuinen. Hierbij kwam 1 persoon om het leven."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/18454> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    dcterms:modified "2021-12-01T11:39:26.419Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/9344>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/c/cd/Legerkamp_Waalsdorp%2C_de_App%C3%A8lplaats%2C_ca._1916.jpg/500px-Legerkamp_Waalsdorp%2C_de_App%C3%A8lplaats%2C_ca._1916.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/wiki/File:Legerkamp_Waalsdorp,_de_App%C3%A8lplaats,_ca._1916.jpg";
    dcterms:source "https://nl.wikipedia.org/wiki/Legerkamp_Waalsdorp"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1873>;
    dcterms:created "2021-12-01T11:21:24.908Z"^^xsd:dateTime;
    skos:prefLabel "Legerkamp Waalsdorp"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Legerkamp Waalsdorp bestond uit een kazerne en een militair oefenterrein en lag in de duinen ten noorden van Den Haag. Na de oorlog werden de functies van de kazerne overgeheveld naar de Alexanderkazerne. De oorlogsherdenkingsplaats Waalsdorpervlakte ligt op een deel van het voormalige oefenterrein. Tijdens de bezetting was de Grüne Polizei in de kazerne gevestigd en op de bijbehorende oefenterreinen werden executies uitgevoerd. "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/18456> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2024-01-25T10:58:27.462Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/18457>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/25e3c6bf-ee61-340f-f224-99b7d42ba73b.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/104b4308-025a-11e7-904b-d89d6717b464/media/25e3c6bf-ee61-340f-f224-99b7d42ba73b";
    <http://schema.org/startDate> "1940-05-10"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/wiki/Legerkamp_Waalsdorp"@nl, "https://zuid-holland.75jaarvrijheid.nl/nieuw/2431275/slag-om-de-residentie-80-jaar-geleden"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/19539>;
    dcterms:created "2021-12-01T12:43:05.297Z"^^xsd:dateTime;
    skos:prefLabel "Bombardement op Legerkamp Waalsdorp"@nl, "Bombardierung von Legerkamp Waalsdorp"@de,
      "Bombing of Legerkamp Waalsdorp"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 10 mei 1940 werd Legerkamp Waalsdorp door de Duitse luchtmacht gebombardeerd. 58 Soldaten van het 1e Depot Infanterie kwamen hierbij om het leven. De naastgelegen Nieuwe Alexanderkazerne werd eveneens beschadigd. In totaal kwamen 137 militairen om het leven. Het bombardement maakte deel uit van de Duitse aanval onder de codenaam Fall Festung, oftewel de Slag om de Residentie."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2322> .
  
  <https://data.niod.nl/WO2_Thesaurus/18458> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:24:57.098Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/9582>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/7/7a/Bezuidenhout%2C_Den_Haag%2C_10_mei_1940%2C_Duitse_parachutisten.png/1920px-Bezuidenhout%2C_Den_Haag%2C_10_mei_1940%2C_Duitse_parachutisten.png";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Slag_om_Den_Haag#/media/Bestand:Bezuidenhout,_Den_Haag,_10_mei_1940,_Duitse_parachutisten.png";
    <http://schema.org/location> "Den Haag";
    <http://schema.org/startDate> "1940-05-10"^^xsd:date;
    dcterms:source "https://zuid-holland.75jaarvrijheid.nl/nieuw/2431275/slag-om-de-residentie-80-jaar-geleden"@nl,
      "https://commons.wikimedia.org/wiki/File:Aanval_op_Den_Haag_10_mei_1940_kaart.svg"@nl,
      "https://nl.wikipedia.org/wiki/Slag_om_Den_Haag"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2322>;
    dcterms:created "2021-12-01T13:11:07.772Z"^^xsd:dateTime;
    skos:prefLabel "Battle for The Hague"@en, "Slag om de Residentie"@nl, "Schlacht um Den Haag"@de;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 10 mei 1940 vond de Slag om de Residentie plaats. De Duitse luchtmacht viel onder de codenaam Fall Festung de vliegvelden Ypenburg, Ockenburg en Valkenburg aan en de stad Den Haag. Ook vonden er bombardementen plaats op Legerkamp Waalsdorp en de Nieuwe Alexanderkazerne. Doel was om koningin Wilhelmina tot overgave te dwingen. De vliegvelden kwamen in handen van de Duitsers maar een inname van Den Haag werd voorkomen. Aan het eind van de dag hadden de Nederlanders de vliegvelden heroverd. Aan Nederlandse zijde kostte deze slag 515 doden."@nl;
    skos:altLabel "Fall Festung"@nl, "Slag om Den Haag"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/18459> a <http://schema.org/Thing>, skos:Concept,
