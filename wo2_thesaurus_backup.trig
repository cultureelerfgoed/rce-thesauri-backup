    skos:prefLabel "Changarraya"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Changarraya was een krijgsgevangenkamp aan de Birma-Siam-spoorweg, gelegen op 301 km van Non Pladuk en 114 km van Thanbyuzayat vlak bij de grens tussen Birma (Myanmar) en Thailand. De werkzaamheden waren o.a. de aanleg van de spoordijk."@nl;
    skos:altLabel "Changarraya – 301 (114)"@nl, "Changaraya"@nl, "Djangara"@nl, "Kamp 114"@nl,
      "Siam KM. 299"@nl, "Changaraya no. 5"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/21099> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "15.972865308292034"^^xsd:float;
    <http://www.w3.org/2003/01/geo/wgs84_pos#long> "97.71839848396424"^^xsd:float;
    dcterms:references "Leffelaar, H.L. en E. van Witsen - Werkers aan de Birmaspoorlijn, 1982, pg 103"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/b7354d29-49d5-4fe0-922a-3f3b5929fa84>;
