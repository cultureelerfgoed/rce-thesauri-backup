    <http://schema.org/location> "Hoogeveen";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/66dc13d2-025a-11e7-904b-d89d6717b464/media/e17e0c96-e7d0-2c12-cdb7-95044620c435>;
