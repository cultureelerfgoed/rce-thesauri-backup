    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://en.wikipedia.org/wiki/%C5%81achwa_Ghetto#/media/File:Lakhvaghettomap.jpg";
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/5326>, <https://data.niod.nl/WO2_Thesaurus/8176>;
    dcterms:created "2017-06-26T06:42:57.000Z"^^xsd:dateTime;
    skos:prefLabel "Getto van Lachwa"@nl, "Ghetto Lachwa"@de, "Ghetto of Lachwa"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Het getto van Łachwa (of Lakhva ) werd op 1 april 1942 door nazi-Duitsland gecreëerd in de stad Łachwa in bezet Oost-Polen (nu Lakhva, Wit-Rusland), met als doel de vervolging, terreur en uitbuiting van de lokale Joden. In het getto zaten ongeveer 2350 Joden. Op deze locatie vond een van de eerste Joodse getto opstanden plaats. De Duitsers liquideerden het getto in september 1942. "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/5236> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2020-10-13T06:59:36.633Z"^^xsd:dateTime;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/5326>, <https://data.niod.nl/WO2_Thesaurus/8176>;
    dcterms:created "2017-06-26T06:43:04.000Z"^^xsd:dateTime;
    skos:prefLabel "Getto van Murafa"@nl, "Ghetto Murafa"@de, "Ghetto of Murafa"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Het getto van Murafa, Transnistrië (nu: Oekraïne), werd in september 1941 door Duitse en Roemeense strijdkrachten ingericht die op 21 juli 1941 Murafa hadden bezet. Dit open getto bevond zich in 'Old Murafa' waar van oorsprong de Joodse gemeenschap woonde. In oktober en december 1941 arriveerden in Murafa zo'n 3500 Joden uit Roemenië. Op 18 maart 1944 werd het getto geliquideerd."@nl;
    skos:altLabel "Ghetto van Murafa"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/5237> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2020-10-13T06:58:57.306Z"^^xsd:dateTime;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/5326>, <https://data.niod.nl/WO2_Thesaurus/8176>;
    dcterms:created "2017-06-26T06:43:11.000Z"^^xsd:dateTime;
    skos:prefLabel "Getto van Radun"@nl, "Ghetto Radun"@de, "Ghetto of Radun"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Het getto van Radun, Belarus (nu: Wit-Rusland), werd op 16 november 1941 door Nazi-Duitsland gecreëerd voor 2000 lokale joden. Tijdens de liquidatie van het getto zijn meer dan 1500 Joden door Duitse troepen en lokale politiemensen vermoord."@nl;
    skos:altLabel "Ghetto van Radun"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/5238> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
