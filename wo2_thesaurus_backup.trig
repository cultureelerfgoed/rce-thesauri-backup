  <https://data.niod.nl/WO2_Thesaurus/2659> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "J.C.H. de Pater, Het schoolverzet (’s-Gravenhage, 1969)"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2022-11-16T12:52:39.959Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/hcl/thumb/1000x1000/a3377f09-8bde-805e-b65b-7cdc62dbf16f.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://historischcentrumleeuwarden.nl/beeldbank/5fcf96f2-aea9-11e3-9f58-0b1b7d443419";
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/demoadmin>;
