    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De rang algemeen secretaris bestond vanaf 1932 in de NSB en werd bekleed door Kees van Geelkerken. Met de invoering van de rang van plaatsvervangend leider voor Van Geelkerken eind juli 1937 verviel de rang algemeen secretaris."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2244> .
  
  <https://data.niod.nl/WO2_Thesaurus/20060> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "Volk en Vaderland jrg. 5 (1937) nr. 31, 30 juli 1937 en B. van der Boom, Kees van Geelkerken. De rechterhand van Mussert (Utrecht/Antwerpen 1990) p. 75-79"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
