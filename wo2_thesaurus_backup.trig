      "https://atlantis.rhcl.nl/HttpHandler/icoon.ico?file=792775"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbank.rhcl.nl/detail.php?id=393653",
      "https://beeldbank.rhcl.nl/detail.php?id=393653"@nl;
    dcterms:source "http://www.gahetna.nl/collectie/archief/ead/index/eadid/2.09.42.01"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Stichting Toezicht Politieke Delinquenten (STPD) begeleidde vrijgelaten personen met hun terugkeer in de samenleving (reclassering). Veel personen die voorwaardelijk buiten vervolging werden gesteld, stonden drie jaar onder toezicht van de STPD."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1576>, <https://data.niod.nl/WO2_Thesaurus/19586>,
      <https://data.niod.nl/WO2_Thesaurus/20705>;
    dcterms:created "2016-10-04T13:07:41.000Z"^^xsd:dateTime;
    skos:prefLabel "'Stichting Toezicht Politieke Delinquenten'"@de, "'Stichting Toezicht Politieke Delinquenten'"@en,
      "Stichting Toezicht Politieke Delinquenten"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "De Stichting Toezicht Politieke Delinquenten werd op 20 september 1945 opgericht uit verontrusting over de sociale en morele ontwrichtingsverschijnselen veroorzaakt door de massale zuiveringsmaatregelen en de Bijzondere Rechtspleging. Personen, verdacht van collaboratie, konden buiten vervolging worden gesteld als ze onder toezicht werden gesteld van de Stichting Toezicht Politieke Delinquenten. De Stichting werd in 1951 opgeheven."@nl;
    skos:altLabel "STPD"@nl, "Stichting tot Toezicht op Politieke Delinquenten"@nl, "Stichting Toezicht Pol. Del"@nl,
      "Stichting Politieke Delinquenten"@nl, "Toezicht Politieke Delinquenten"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization>;
    skos:definition "Der Stichting Toezicht Politieke Delinquenten werd op 20 september 1945 opgericht uit verontrusting over de sociale en morele ontwrichtingsverschijnselen veroorzaakt door de massale zuiveringsmaatregelen en de Bijzondere Rechtspleging. Het doel van de Stichting was vooral het bevorderen van het terugkeren van daarvoor in aanmerking komende politieke delinquenten met hun gezin naar normale verhoudingen en ze weer in te schakelen in het maatschappelijk leven ; het verlenen van hulp en het deelnemen aan voor de heropvoeding noodzakelijke werkzaamheden. Personen, verdacht van collaboratie, konden buiten vervolging worden gesteld als ze onder toezicht werden gesteld van de Stichting Toezicht Politieke Delinquenten. De Stichting werd in 1951 opgeheven."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/4686> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
