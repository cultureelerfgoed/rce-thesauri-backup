    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://en.wikipedia.org/wiki/Convoy_PQ_17#/media/File:Convoy_PQ-17_map_1942-en.svg";
    <http://schema.org/location> "Barentszzee";
    <http://schema.org/startDate> "1942-07-05"^^xsd:date;
    dcterms:source "https://en.wikipedia.org/wiki/Convoy_PQ_17"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3511>;
    dcterms:created "2021-09-29T13:01:48.749Z"^^xsd:dateTime;
    skos:prefLabel "Scheepsramp Paulus Potter"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Scheepsramp met de Paulus Potter vond plaats op 5 juli 1942. De Paulus Potter was een Nederlands schip dat werd ingezet in het Arctische konvooi PQ17. Het verliet op 27 juni 1942 Reykjavik richting Archangelsk. Door luchtverkenningen was gezien dat twee Duitse oorlogsschepen niet in hun gebruikelijke haven in Trondheim lagen. Dit zorgde voor paniek en konvooi PQ17 kreeg het bevel te ontbinden. Elk schip ging zijn eigen weg in de Noordelijke IJszee met rampzalige gevolgen. 24 van de 36 vrachtschepen werden vernietigd waaronder de Paulus Potter. Op 5 juli werd het aangevallen door Duitse vliegtuigen waardoor het schip moest worden verlaten. De bemanning zette koers naar Nova Zembla in sloepen.  "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/1870> .
  
  <https://data.niod.nl/WO2_Thesaurus/17672> a <http://schema.org/Thing>, skos:Concept,
