    skos:prefLabel "Reserveringskampen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Reserveringskampen waren concentratiekampen waar de bezetter bekende Joden in opsloot en ze in eerste instantie spaarde. Dit konden Joden zijn die in de wetenschap een hoge positie hadden of op een andere manier bekend waren, maar ook Joden die lid waren geweest van de NSB of die aan Duitse zijde gevochten hadden in de Eerste Wereldoorlog. De term Joodsche tehuizen werd hiervoor ook gebruikt."@nl;
    skos:altLabel "Joodsche tehuizen"@nl, "Joodse Tehuizen"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/10660> .
  
