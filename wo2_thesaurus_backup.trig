    skos:prefLabel "Stulln"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote """Aussenlager Stulln was van februari tot midden oktober 1942 een buitenkamp van Flossenbürg. De gevangenen waren ondergebracht op een afgescheiden gedeelte van het Reichsarbeitsdienst-kamp Waldfrieden. Op 17 oktober 1942 werden 99 gevangenen verplaatst naar Aussenlager Dresden (SS-Pionierkaserne).
"""@nl;
    skos:altLabel "Aussenlager Stulln"@nl, "Aussenlager Waldfriede"@nl .
  
