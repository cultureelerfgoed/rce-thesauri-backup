  <https://data.niod.nl/WO2_Thesaurus/corporaties/7759> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-01-19T10:43:45.906Z"^^xsd:dateTime;
    <http://schema.org/startDate> "1921-05-01"^^xsd:date;
    <http://schema.org/endDate> "1940-09-12"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Lijst_van_gouverneurs_en_commissarissen_van_de_Koning_in_Zeeland&oldid=50501332"@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/10791>;
    dcterms:created "2019-01-23T19:53:10.000Z"^^xsd:dateTime;
    skos:prefLabel "Commissaris der provincie Zeeland, 1921 - 1940"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Commissaris der Provincie Zeeland was van 1921 tot september 1940 Johan Willem Quarles van Ufford. Op 12 september 1940 werd hij door rijkscommissaris Seyss-Inquart, als eerste Commissaris van de Koningin in Nederland, uit zijn functie ontheven en moest hij Zeeland onmiddellijk verlaten. Vanaf 1944 tot 1948 was hij wederom in Zeeland Commissaris van de Koningin."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7760> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-01-19T10:46:43.320Z"^^xsd:dateTime;
    <http://schema.org/startDate> "1944-11-15"^^xsd:date;
    <http://schema.org/endDate> "1948-02-01"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Lijst_van_gouverneurs_en_commissarissen_van_de_Koning_in_Zeeland&oldid=50501332"@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/10791>;
    dcterms:created "2019-01-23T20:13:48.000Z"^^xsd:dateTime;
    skos:prefLabel "Commissaris der provincie Zeeland, 1944 - 1948"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote """De Commissaris der Provincie Zeeland was van 1944 tot 1948 Johan Willem Quarles van Ufford, die ook al van 1921 tot 1940 Commissaris was geweest. Op 12 september 1940 werd hij door rijkscommissaris Seyss-Inquart, als eerste Commissaris van de Koningin in Nederland, uit zijn functie ontheven en op 15 november 1944 werd hij door het kabinet Gerbrandy in de bevrijde provincie Zeeland in zijn ambt hersteld.
"""@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7761> a <http://schema.org/Thing>,
