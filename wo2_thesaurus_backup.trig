    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/563a59a8-025a-11e7-904b-d89d6717b464/media/c7c8097d-193d-c7b5-e415-480152141fda";
    <http://schema.org/location> "Bennekom";
    <http://schema.org/startDate> "1944-10-20"^^xsd:date;
    <http://schema.org/endDate> "1944-10-22"^^xsd:date;
    dcterms:source "https://www.bezoek-ede.nl/militair-toerisme/oorlogsherinneringen-ede/oktober-1944-de-evacuatie-van-bennekom"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1922>, <https://data.niod.nl/WO2_Thesaurus/events/4391>;
    dcterms:created "2022-01-06T11:02:20.151Z"^^xsd:dateTime;
    skos:prefLabel "Evacuatie van Bennekom"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Evacuatie van Bennekom vond plaats tussen 20 en 22 oktober 1944. Vanaf september 1944 verschenen er steeds meer Duitse stellingen in het dorp om de optrekkende geallieerden tegen te houden. Op 20 oktober 1944 gaf de Wehrmacht het bevel om Bennekom te ontruimen. Een dag later vertrokken de inwoners van Bennekom richting Ede. Vanaf 12 mei 1945 konden de inwoners van Bennekom terugkeren naar hun huizen."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/6619> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/18581> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:25:00.767Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/10451>;
