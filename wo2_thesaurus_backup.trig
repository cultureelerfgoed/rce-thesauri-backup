    skos:prefLabel "Ishihara Sangyo K.K. "@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Ishihara Sangyo K.K. was één van de vele bedrijven van zakenman Hiroichiro Ishihara en functioneerde van 1943 tot de Japanse capitulatie. Het doel van de organisatie was om de mineralen van Maleisië, Java, Sumatra en de Filipijnen te exploiteren ten behoeve van het Japanse leger. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/4382>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
