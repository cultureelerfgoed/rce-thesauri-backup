    dcterms:created "2019-04-02T14:00:20.000Z"^^xsd:dateTime;
    skos:prefLabel "Veroordeling PNI-leden"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Bij de veroordeling PNI-leden veroordeelt de Landraad (rechtbank) op 21 december 1930 in Bandoeng Soekarno en andere voormannen van de PNI tot gevangenisstraffen wegens ‘deelneming aan een vereeniging die tot oogmerk heeft het plegen van misdrijven’. Soekarno wordt veroordeeld tot vier jaar hechtenis. In april 1931 wordt de PNI ontbonden."@nl .
  
