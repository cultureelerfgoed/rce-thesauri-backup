    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/5/5a/Villa_Mari%C3%ABnboom_Groesbeekseweg_428_Nijmegen_Groenewoud_uit_1910.jpg/250px-Villa_Mari%C3%ABnboom_Groesbeekseweg_428_Nijmegen_Groenewoud_uit_1910.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Bestand:Villa_Mari%C3%ABnboom_Groesbeekseweg_428_Nijmegen_Groenewoud_uit_1910.jpg";
    dcterms:source "https://www.noviomagus.nl/Herinnering/Bombardement/09-09-08.htm"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/isPointofInterest> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/locations/9382>;
    dcterms:created "2019-04-12T12:27:36.000Z"^^xsd:dateTime;
    skos:prefLabel "Hotel Mariënboom (Nijmegen)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "Hotel Mariënboom, van de joodse eigenaar Theo Rubens, was gelegen tegenover klooster Mariënbosch, een Duits militair hospitaal. Daardoor zat Mariënboom altijd vol met Duitse soldaten die er kwamen eten of drinken, wat weer tot gevolg had dat de joodse eigenaar tot 9 april 1944 hier gewoon de boel draaiende heeft mogen houden. Pas toen werd hij afgevoerd naar Kamp Westerbork en heeft hij de oorlog overleefd. "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/locations/8299> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "51.811932"^^xsd:float;
    <http://www.w3.org/2003/01/geo/wgs84_pos#long> "5.884564"^^xsd:float;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2025-12-17T15:27:02.365Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/6d2c62a2-5bd4-4fec-96f3-d4bf78b63e81.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/c4dbb8f2-025a-11e7-904b-d89d6717b464/media/6d2c62a2-5bd4-4fec-96f3-d4bf78b63e81";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://studiezaal.nijmegen.nl/detail.php?id=327033>;
    dcterms:source "https://nl.wikipedia.org/wiki/Neboklooster"@nl, "https://www.noviomagus.nl/Rx.php?Url=Gastredactie/Been/Nebo.htm"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/isPointofInterest> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/locations/9382>, <https://data.niod.nl/WO2_Thesaurus/events/4391>,
      <https://data.niod.nl/WO2_Thesaurus/7815>;
    dcterms:created "2019-04-12T12:52:54.000Z"^^xsd:dateTime;
    skos:prefLabel "Neboklooster (Nijmegen)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Het Neboklooster werd tijdens de Duitse bezetting van Nederland geconfisqueerd en in gebruik door de Duitse Wehrmacht. Na de geallieerde luchtlandingen op 17 september 1944 bij Groesbeek, vluchtten zij voor de geallieerde troepen en werd het klooster gebruikt door Amerikaanse en Britse militairen die onderweg waren naar Nijmegen. Het Neboklooster bevond zich tijdens Market-Garden in de frontlinie. Het werd door het Rode Kruis gebruikt als noodhospitaal."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/locations/8300> a skos:Concept, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "51.832170"^^xsd:float;
    <http://www.w3.org/2003/01/geo/wgs84_pos#long> "5.857959"^^xsd:float;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2025-12-17T15:27:27.614Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/isPointofInterest> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/locations/9382>;
    dcterms:created "2019-04-12T13:26:01.000Z"^^xsd:dateTime;
    skos:prefLabel "Vluchtelingenopvang Sint Annastichting (Nijmegen)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "De Vluchtelingenopvang Sint Annastichting zat onder het pand van de Sint Annastichting in Nijmegen. Hier bevonden zich enkele schuilkelders, gebruikt tijdens de gevechten van Operatie Market-Garden, waaronder een door de Duitsers aangelegde bunker. Deze schuilkelders werden vooral na de bevrijding van Nijmegen in 1944 gebruikt als opvanglocatie voor mensen die door de gevechten hun huis hadden verloren. Tevens was het tijdens de Nijmeegse frontperiode voor veel mensen zonder een eigen kelder onveilig om in hun eigen huis te blijven, dus konden zij ook terecht in de openbare schuilkelders. De Vluchtelingencommissie onder leiding van de heer Stoopman regelde verdere verzorging zoals eten en sporadisch vermaak voor de kinderen."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/locations/8305> a skos:Concept, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "52.378888888889"^^xsd:float;
    <http://www.w3.org/2003/01/geo/wgs84_pos#long> "4.9005555555556"^^xsd:float;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/ravend>;
