    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://www.nationaalarchief.nl/onderzoeken/fotocollectie/ad94b4c4-d0b4-102d-bcf8-003048976d84";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://www.nationaalarchief.nl/onderzoeken/fotocollectie/ad94b65e-d0b4-102d-bcf8-003048976d84>,
