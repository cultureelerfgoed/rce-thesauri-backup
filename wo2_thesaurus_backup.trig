    dcterms:created "2020-03-25T10:51:09.000Z"^^xsd:dateTime;
    skos:prefLabel "Obertraubling"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:exactMatch <https://digitaalerfgoed.poolparty.biz/westerbork/2403>;
    skos:scopeNote "Aussenlager Obertraubling was van 20 februari 1945 tot 16 april 1945 een buitenkamp van Flossenbürg. De ongeveer 600 gevangenen (voor de helft Joden) waren ondergebracht in het grotendeels verwoeste casino en tewerkgesteld om de gebombardeerde Fliegerhorst te herstellenm, maar waren daar veelal te ziek voor. Ongeveer 170 mannen zijn in deze twee maanden gestorven."@nl;
    skos:altLabel "Aussenlager Obertraubling"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
