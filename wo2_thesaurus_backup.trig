    <http://schema.org/startDate> "1944-12-05"^^xsd:date;
    dcterms:source "http://historie.venlo.nl/gebeurtenisinfo.asp?gebeurtenisID=268"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/klijne>;
