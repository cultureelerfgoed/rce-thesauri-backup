    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>,
      <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/5326>, <https://data.niod.nl/WO2_Thesaurus/8176>;
    dcterms:created "2017-02-03T10:20:51.000Z"^^xsd:dateTime;
    skos:prefLabel "Getto van Rzeszow"@nl, "Ghetto Rzeszow"@de, "Ghetto of Rzeszow"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Het getto van Rzeszow, Polen, werd door Nazi-Duitsland op 17 december 1941 officieel geïnstalleerd maar al vanaf juni 1941 waren de Joden gedwongen naar dit gebied te verhuizen. In 1940 werd de naam Rzeszow door de Duitsers gewijzigd in Reichshof. Begin juli 1942 zaten er 22.000 personen in het getto. Tussen december 1942 en juni 1943 vonden er meerdere 'resettlement Aktions' plaats die leidden tot executies of transport naar werk- en concentratiekampen. In september 1943 werd het getto gesloten en de resterende gevangenen vervoerd naar werkkampen of concentratiekamp Auschwitz. "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/5039> a <http://schema.org/Thing>, skos:Concept,
