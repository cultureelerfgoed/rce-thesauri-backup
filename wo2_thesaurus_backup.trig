    skos:prefLabel "Durchgangslager"@de, "Transit camps"@en, "Doorgangskampen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Doorgangskampen zijn kampen waarin mensen worden verzameld en gesorteerd om vervolgens doorgestuurd te worden naar andere kampen, bijvoorbeeld concentratiekampen of vernietigingskampen. Veel Joodse Nederlanders gingen via doorgangskamp Westerbork in Drenthe naar kampen in Duitsland of Polen."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2053>, <https://data.niod.nl/WO2_Thesaurus/2788>,
      <https://data.niod.nl/WO2_Thesaurus/2887>, <https://data.niod.nl/WO2_Thesaurus/2805>,
      <https://data.niod.nl/WO2_Thesaurus/5127> .
  
  <https://data.niod.nl/WO2_Thesaurus/20280> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
