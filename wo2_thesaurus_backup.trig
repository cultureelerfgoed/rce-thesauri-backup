    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/108f746a-025a-11e7-904b-d89d6717b464/media/6a27af8b-68be-5cdb-9c6c-3c87ca321211";
    <http://schema.org/startDate> "1941-03-20"^^xsd:date;
    dcterms:source "https://nl.m.wikipedia.org/wiki/Nieuwesluis_(Wieringermeer)"@nl, "https://www.joodswerkdorpslootdorp.nl/"@nl,
      "https://www.joodsmonument.nl/nl/page/42430/werkdorp-wieringermeer"@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/6023>;
    dcterms:created "2020-10-30T09:23:52.735Z"^^xsd:dateTime;
    skos:prefLabel "Ontruiming Joods Werkdorp Wieringermeer"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Joods Werkdorp Wieringermeer werd op 20 maart 1941 ontruimd, op zo'n 60 achterblijvers na die voor het vee en de gewassen zorgde. Een deel van de achterblijvers dook onder en overleefde. De rest, zo'n 230 werkdorpers, werden naar Amsterdam gebracht met bussen. Zowel bij de ontruiming als bij het later ophalen van de 'werkdorpers' uit Amsterdam was de SS'er Klaus Barbie betrokken. Op 11 juni 1941 werden 58 werkdorpers opgepakt in Amsterdam en via Kamp Schoorl en Westerbork naar Mauthausen gedeporteerd. Ze kwamen allen om het leven."@nl;
    skos:altLabel "Ontruiming Joods Werkdorp Nieuwesluis"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/9082>;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/10161> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2020-11-03T13:00:40.367Z"^^xsd:dateTime;
    <http://schema.org/startDate> "1942-01-01"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/9002>;
    dcterms:created "2020-11-03T12:59:16.780Z"^^xsd:dateTime;
    skos:prefLabel "Bevestiging van het Handvest Verenigde Naties"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Bevestiging van het Handvest van de Verenigde Naties vond plaats op 1 januari 1942. Op deze dag werd het Handvest bevestigd door de Declaration by United Nations. 26 landen ondertekenden de verklaring, waaronder de Nederlandse regering in ballingschap. Dit vormde de basis voor de latere oprichting van de Verenigde Naties."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/10162> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
