    <https://data.niod.nl/organizationsWO2/startDate> "1933-06-28"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/2228dec6-8a94-8bf7-8866-ec3ccf19d0e1.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/b349bf0e-0259-11e7-904b-d89d6717b464/media/2228dec6-8a94-8bf7-8866-ec3ccf19d0e1"@nl;
