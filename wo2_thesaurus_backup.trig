    skos:broader <https://data.niod.nl/WO2_Thesaurus/1686>, <https://data.niod.nl/WO2_Thesaurus/locations/6565>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/4717>;
    dcterms:created "2019-03-01T11:21:53.000Z"^^xsd:dateTime;
    skos:prefLabel "Gevangenis Kasteel Groot Engelenburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Kasteel Groot Engelenburg werd van 6 april 1945 tot 14 april 1945 door het zogeheten Kommando Zeppelin onder leiding van Andries Pieters gebruikt als gevangenis en executieplaats. De groep was hiernaartoe gezonden door Ludwig Heinemann, hoofd van de Sicherheitsdienst in Zutphen, en samen met een aantal SD’ers maakten zij in Brummen en omgeving jacht op het verzet. Hoewel ze maar acht dagen in het kasteel verbleven martelden zij in deze periode tientallen gevangenen en werden acht gevangenen omgebracht."@nl;
    skos:altLabel "Kasteel Groot-Engelenburg"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/locations/7949> a <http://schema.org/Thing>, skos:Concept,
