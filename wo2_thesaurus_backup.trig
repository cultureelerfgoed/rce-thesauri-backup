    <http://schema.org/startDate> "1944-09-17"^^xsd:date;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/locations/8137>, <https://data.niod.nl/WO2_Thesaurus/events/4391>;
    dcterms:created "2019-03-15T19:43:21.000Z"^^xsd:dateTime;
    skos:prefLabel "Inname brug bij Grave"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote """De Brug bij Grave was een onmisbare schakel in de verbindingsweg met de Britse tankstrijdmacht die uit het zuiden op weg was naar Arnhem en maakte daarom deel uit van de levensader voor de 82e Luchtlandingsdivisie. Na de luchtlandingen bij Overasselt en Grave werd de brug van beide zijden aangevallen door de Amerikaanse para's. Na beschietingen over en weer lukte het hen uiteindelijk om de kanonnen uit te schakelen en de brug in te nemen.
"""@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8144> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-03-02T15:41:59.479Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/9563>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/wo2nedindieThema> "Inval Japan";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/640x480/67ae6930-555e-a90c-672f-07631f5f1d59.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/091d396a-025a-11e7-904b-d89d6717b464/media/67ae6930-555e-a90c-672f-07631f5f1d59";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://nimh-beeldbank.defensie.nl/foto-s/76ecbe57-b3c2-0c7f-50bb-64ac75d2aa02>,
      <https://images.memorix.nl/nda/thumb/250x250/e8f88169-78b5-8348-f3af-d05f8f92f039.jpg>,
      <https://beeldbankwo2.nl/nl/beelden/detail/f6a2557c-0259-11e7-904b-d89d6717b464/media/ae0b3948-fc55-94e0-42bb-831484382927>;
    <http://schema.org/startDate> "1942-03-08"^^xsd:date;
    <http://schema.org/endDate> "1942-03-09"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Japanse_bezetting_van_Nederlands-Indi%C3%AB&oldid=53239173"@nl;
    <http://schema.org/description> "Op het militaire vliegveld Kalidjati vinden op 8 en 9 maart 1942 de capitulatiebesprekingen plaats. De Japanse delegatie wordt geleid door luitenant-generaal Imamura Hitoshi, de commandant van het 16de Leger en de Nederlandse delegatie staat onder leiding van gouverneur-generaal Tjarda van Starkenborgh Stachouwer en bestaat uit hoge militairen en ambtenaren. Na het mislukken van de bespreking over een gedeeltelijke overgave van het KNIL, stuurt Imamura de gouverneur-generaal en de aanwezige ambtenaren weg. Luitenant-Generaal Ter Poorten wordt opnieuw gevraagd of hij de algemene en onvoorwaardelijke capitulatie van het gehele KNIL wil ondertekenen. Imamura laat weten dat bij een Nederlandse weigering de oorlog wordt hervat tot het KNIL is vernietigd. Om 18.20 uur tekent Ter Poorten de algemene capitulatie van het KNIL. "@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2350>, <https://data.niod.nl/WO2_Thesaurus/2326>,
      <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2019-03-18T09:25:58.000Z"^^xsd:dateTime;
    skos:prefLabel "Capitulatie van Nederlands-Indië"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Aan De Capitulatie van Nederlands-Indië gaan besprekingen vooraf. Deze vinden plaats op het militaire vliegveld Kalidjati op 8 en 9 maart 1942. Om 18.20 uur tekent luitenant-generaal Ter Poorten de algemene capitulatie van het KNIL. De volgende dag, 9 maart, werd om 07.45 uur de algemene capitulatie via de NIROM bekend gemaakt."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8149> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2021-06-14T15:17:30.719Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/15071>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/wo2nedindieThema> "Internationale betrekkingen";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/640x480/092337c5-c453-3921-0b75-d225537db450.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/f0238266-0259-11e7-904b-d89d6717b464/media/092337c5-c453-3921-0b75-d225537db450";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <http://opac-gonext.oclc.org:8180/xslt/DB=8/XMLPRS=Y/PPN?PPN=113727682>,
      <https://www.delpher.nl/nl/kranten/view?coll=ddd&identifier=ddd:110612857:mpeg21:a0042>,
      <https://www.delpher.nl/nl/kranten/view?coll=ddd&identifier=ddd:011176701:mpeg21:a0097>;
    <http://schema.org/startDate> "1941-12-22"^^xsd:date;
    <http://schema.org/endDate> "1942-01-14"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Arcadiaconferentie&oldid=53377129"@nl;
    <http://schema.org/description> "In Washington D.C. wordt van 22 december 1941 tot 14 januari 1942 de Arcadia Conferentie gehouden. Tijdens de conferentie stellen de Verenigde Staten en Groot-Brittannië een gezamenlijke oorlogsstrategie vast: de Europa-eerst-strategie. De strategie houdt in dat de oorlog tegen Japan ondergeschikt is aan die tegen Duitsland, omdat de laatste voor een veel gevaarlijker tegenstander wordt gehouden. Pas nadat Duitsland is verslagen zal de Verenigde Staten zich volledig richten op het verslaan van Japan."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2629>, <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2019-03-18T15:30:32.000Z"^^xsd:dateTime;
    skos:prefLabel "Arcadiaconferentie"@nl, "Arcadia Conference"@en, "Arcadia-Konferenz"@de;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Arcadiaconferentie wordt gehouden in Washington D.C. van 22 december 1941 tot 14 januari 1942. Tijdens de conferentie stellen de Verenigde Staten en Groot-Brittannië een gezamenlijke oorlogsstrategie vast: de \"Europe first\". De strategie houdt in dat de oorlog tegen Japan ondergeschikt is aan die tegen Duitsland, omdat de laatste voor een veel gevaarlijker tegenstander wordt gehouden."@nl;
    skos:altLabel "Arcadia-Conferentie"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8150> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:31:07.513Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8165>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/wo2nedindieThema> "Inval Japan";
    <http://schema.org/location> "Washington D.C.";
    <http://schema.org/startDate> "1941-12-28"^^xsd:date;
    <http://schema.org/description> "Tijdens de Arcadia-conferentie in Washington D.C. wordt besloten de verdediging van Zuidoost-Azië onder een gemeenschappelijke militaire bevelsorganisatie te plaatsen: het American-British-Dutch-Australian Command (ABDACOM). De belangrijkste taak van ABDACOM is te voorkomen dat Japan de zogenaamde Maleise barrière doorbreekt, een denkbeeldige lijn die van Zuid-Sumatra en Singapore, via Java naar Nieuw-Guinea en Noord-Australië loopt. De regering van Nederlands-Indië is vooraf niet geraadpleegd over de oprichting van ABDACOM."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2350>, <https://data.niod.nl/WO2_Thesaurus/corporaties/7729>,
      <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2019-03-18T15:46:53.000Z"^^xsd:dateTime;
    skos:prefLabel "Oprichting ABDACOM"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Oprichting ABDACOM (American-British-Dutch-Australian Command) vindt plaats op 28 december 1941. Tijdens de Arcadiaconferentie in Washington D.C. werd besloten om de verdediging van Zuidoost-Azië onder een gemeenschappelijk militaire bevelsstructuur te plaatsen."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8152> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
