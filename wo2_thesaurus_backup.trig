    skos:prefLabel "'Gevangenis Amstelveenseweg'"@de, "Amstelveenseweg Prison"@en, "Gevangenis Amstelveenseweg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "De gevangenis Amstelveenseweg (officieel Huis van Bewaring II geheten) aan de Havenstraat 6 in Amsterdam was een gevangenis en een interneringskamp (bijzondere rechtspleging). Tijdens de Tweede Wereldoorlog zaten hier opgepakte verzetsdeelnemers gevangen. Na de Duitse bezetting was het in gebruik als interneringskamp (bijzondere rechtspleging). Hier zaten verdachten van en veroordeelden voor collaboratie opgesloten."@nl;
    skos:altLabel "Huis van Bewaring II Amsterdam"@nl, "Huis van Bewaring aan de Amstelveenseweg"@nl,
      "Gevangenis aan de Amstelveenseweg"@nl, "Strafgevangenis II Amstelveenseweg"@nl, "Huis van Bewaring II aan de Amstelveensweg"@nl,
      "Huis van Bewaring II te Amsterdam"@nl;
