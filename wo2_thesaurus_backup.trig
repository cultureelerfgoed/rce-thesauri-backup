    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Provinciaal_ziekenhuis_(Noord-Holland)#/media/Bestand:Medemblik_-_rijksmonument_28413_-_Landswerf_2_20110814.jpg"@nl;
    <http://schema.org/startDate> "1944-03-02"^^xsd:date;
    <http://schema.org/endDate> "1944-04-21"^^xsd:date;
    dcterms:source "https://www.noordhollandsdagblad.nl/cnt/dmf20180921_67417897/oorlogsmonument-voor-de-landswerf-het-vergeten-leed-van-een-psychiatrisch-ziekenhuis?utm_source=google&utm_medium=organic"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2056>;
    dcterms:created "2020-07-29T14:19:58.000Z"^^xsd:dateTime;
    skos:prefLabel "Ziekenhuisrazzia's in Medemblik"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Tijdens de razzia's in het Provinciaal Ziekenhuis in Medemblik werden op 2 maart en 21 april 1944 zestien Joodse psychiatrische patiënten opgepakt, waaronder ook onderduikers die zich voordeden als patiënt. Vijftien van hen zijn gedeporteerd naar Westerbork en vergast in Auschwitz. Door het verraad van NSB-personeelsleden van het ziekenhuis kon de bezetter de razzia uitvoeren. Een Joodse vrouw kwam na de oorlog terug."@nl;
    skos:altLabel "Razzia Medemblik"@nl .
  
