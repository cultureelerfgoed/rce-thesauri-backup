    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/w/index.php?title=File:Erelijst_van_Gevallenen_1940-1945.JPG&oldid=452752374";
    dcterms:source "http://www.erelijst.nl/over-erelijst"@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
