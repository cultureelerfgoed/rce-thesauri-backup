    <http://schema.org/startDate> "1939-10-01"^^xsd:date;
    dcterms:source "https://www.ushmm.org/wlc/en/article.php?ModuleId=10005200"@en, "https://nl.wikipedia.org/w/index.php?title=Aktion_T4&oldid=45865715"@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    <https://data.niod.nl/EventsWO2/dateDescription> "oktober 1939 - mei 1945"@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
