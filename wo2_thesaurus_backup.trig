    <https://data.niod.nl/organizationsWO2/endDate> "1945-06-26"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Het Algemeen Nederlandsch Beheer van Onroerende Goederen (ANBO) was een vastgoedorganisatie. Het werd in december 1941 opgericht door Dirk Hidde de Vries. Het ANBO onteigende, beheerde en verkocht Joods vastgoed. Dit deed het ANBO in opdracht van de Duitse bezetter samen met N.V. Administratiekantoor Nobiscum en de Niederländische Grundstücksverwaltung (NGV)."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/20712>;
    dcterms:created "2023-03-15T09:10:17.666Z"^^xsd:dateTime;
    skos:prefLabel "Algemeen Nederlandsch Beheer Onroerende Goederen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Algemeen Nederlandsch Beheer van Onroerende Goederen (ANBO) werd in december 1941 opgericht door de Haagse makelaar Dirk Hidde de Vries. De organisatie hield zich bezig met het onvrijwillige beheer en de gedwongen verkoop van vastgoed dat aan Joden toebehoorde. Het ANBO wordt samen met N.V. Administratiekantoor Nobiscum beschouwd als de grootste spelers ten aanzien van de verkoop van geroofd vastgoed van Joden tijdens de bezetting."@nl;
    skos:altLabel "Algemeene Maatschappij Beheer Onroerende Goederen"@nl, "Algemeen Nederlandsch Beheer van Onroerende Goederen"@nl,
      "A.N.B.O."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization>;
    skos:hiddenLabel "Algemeen Nederlandse Beheer van Onroerende Goederen"@nl .
  
