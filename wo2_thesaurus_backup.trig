    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/19853>;
    dcterms:created "2023-08-22T14:34:14.917Z"^^xsd:dateTime;
    skos:prefLabel "Plaatsvervangend Leider"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De rang plaatsvervangend leider bestond vanaf eind juli 1937 in de NSB. Kees van Geelkerken bekleedde deze rang totdat hij op 28 december 1944 als plaatsvervangend leider werd vervangen door Musserts vertrouweling Frederik Ernst Müller."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2244> .
  
  <https://data.niod.nl/WO2_Thesaurus/20061> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "E. Fraenkel-Verkade (red.), Correspondentie van mr. M.M. Rost van Tonningen. Deel 1 1921-mei 1942 (Den Haag 1967) p. 127."@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2025-07-31T14:09:01.635Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/19853>;
    dcterms:created "2023-08-22T14:35:48.544Z"^^xsd:dateTime;
    skos:prefLabel "Tweede Plaatsvervangend Leider"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De rang tweede plaatsvervangend leider bestond vanaf eind augustus 1940 in de NSB. Het streven van Seyss-Inquart om de tweede man van de NSB Kees van Geelkerken ten behoeve van Meinoud Rost van Tonningen als plaatsvervangend leider uit te schakelen, werd door Mussert gepareerd met een compromis: de NSB-leider zou voortaan twee plaatsvervangers hebben. Rost van Tonningen werd op 28 december 1944 door Mussert afgezet als tweede plaatsvervangend leider."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2244> .
  
