    <http://schema.org/startDate> "1945-05-05"^^xsd:date;
    dcterms:source "https://onh.nl/verhaal/de-bevrijding-van-de-zaanstreek-in-3-beelden-gemengde-gevoelens-klein-verzet-en-wraak"@nl;
