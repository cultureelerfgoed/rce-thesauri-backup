    skos:prefLabel "Plaatsvervangend kringleider"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De plaatsvervangend kringleider was de functionaris binnen de NSB die optrad als plaatsvervanger van de kringleider. De kringleider had de leiding over een lokale kring die bestond uit verschillende groepen. Hij ontving zijn opdrachten van het hoofdkwartier en stuurde de groepsleiders in zijn kring aan."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2244> .
  
