    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/w/index.php?title=File:Bundesarchiv_Bild_101I-615-2486-14A,_Frankreich,_Nachrichtenhelferinnen.jpg&oldid=748105281";
    dcterms:source "https://en.wikipedia.org/w/index.php?title=Ranks_and_insignia_of_the_German_Women%27s_Auxiliary_Services&oldid=1110036621"@en;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
