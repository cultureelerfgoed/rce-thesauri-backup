    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3591>, <https://data.niod.nl/WO2_Thesaurus/2240>,
