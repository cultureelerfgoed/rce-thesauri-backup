    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/download/default/586b9259-d2e6-0787-227c-6a5416dca130.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/2be07516-025a-11e7-904b-d89d6717b464/media/586b9259-d2e6-0787-227c-6a5416dca130";
