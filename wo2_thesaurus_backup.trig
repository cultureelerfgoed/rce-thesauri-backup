    <http://schema.org/startDate> "1944-10-07"^^xsd:date;
    dcterms:source "https://www.tijdbalk-amersfoort.nl/index.php/Razzia_door_de_Duitsers"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2056>;
    dcterms:created "2020-07-21T14:15:28.000Z"^^xsd:dateTime;
    skos:prefLabel "Razzia van Amersfoort"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 7 oktober 1944 werden in Amersfoort 5000 tot 6000 mannen opgepakt bij een razzia. Alle mannen tussen de 17 en 50 jaar werden langs de Leusderweg afgevoerd en gingen te voet richting de Hoge Veluwe. Het doel van de razzia was de Arbeidsinzet: de mannen moesten tot het einde van de oorlog loopgraven aanleggen langs de IJssel."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
