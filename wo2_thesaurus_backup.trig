    <http://schema.org/startDate> "1940-05-10"^^xsd:date;
    dcterms:source "https://www.dehavenloods.nl/nieuws/algemeen/41737/geen-monument-voor-de-vergeten-strijd-op-vliegveld-waalhaven"@nl,
      "https://nl.wikipedia.org/w/index.php?title=Vliegveld_Waalhaven&oldid=65737703"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3544>;
    dcterms:created "2023-10-12T10:35:39.260Z"^^xsd:dateTime;
    skos:prefLabel "Luchtlanding bij Vliegveld Waalhaven "@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Luchtlanding bij Vliegveld Waalhaven vond plaats op 10 mei 1940. Het vliegveld werd ’s ochtends eerst door de Duitse luchtmacht gebombardeerd en vervolgens door Duitse parachutisten aangevallen. Duitse troepen hadden het vliegveld spoedig in handen, waarna de Nederlandse en Britse Royal Air Force het vliegveld meerdere malen bombardeerden om het onbruikbaar te maken. Er vielen in de gevechten zeker 51 Nederlandse en 7 Britse slachtoffers."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/20474> a <http://schema.org/Thing>, skos:Concept,
