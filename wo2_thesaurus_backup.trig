    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://webservices.memorix.nl/mediabank/media/06b87d0a-1b7f-453f-839a-d1f8b90bd449/downloadfile/61e4bca2-abd8-48b8-8e67-4b93d95254f4?apiKey=6934d11e-52c6-11e4-b0d6-2f8b4b1371c5";
