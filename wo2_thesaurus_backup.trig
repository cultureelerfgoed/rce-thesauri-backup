    <http://schema.org/endDate> "1942-05-28"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Tweede_Slag_om_Charkov&oldid=56126668"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/7855>;
    dcterms:created "2020-09-09T10:10:24.000Z"^^xsd:dateTime;
    skos:prefLabel "Tweede Slag om Charkov"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Tweede Slag om Charkov was de tweede van een reeks veldslagen om het Oekraïnse Charkov, een stad die destijds bij de Sovjet-Unie behoorde. Tijdens deze tweede slag, die in mei 1942 plaatsvond, wilden de Sovjettroepen het Duitse leger terugdringen. Dat mislukte: op 24 mei waren de Sovjets rond Charkov volledig omsingeld door de Duitsers, die meer divisies naar het front hadden gestuurd."@nl .
  
