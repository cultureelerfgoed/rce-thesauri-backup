    <http://schema.org/startDate> "1941-05-08"^^xsd:date;
    <http://schema.org/endDate> "1945-05-01"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Operatie_Bernhard&oldid=52392825"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2668>;
    dcterms:created "2018-11-12T10:06:04.000Z"^^xsd:dateTime;
    skos:prefLabel "Operatie Bernhard"@nl, "Operation Bernhard"@en, "Aktion Bernhard"@de;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Operatie Bernhard was een project van Nazi-Duitsland om vervalste Britse bankbiljetten in omloop te brengen. Het project, onder leiding van SS-officier Bernhard Krüger, begon op 8 mei 1941 en heeft voortgeduurd tot begin 1945. Er werden ter zake kundige gevangenen uit concentratiekampen geselecteerd en samengebracht in Sachsenhausen om de valse biljetten te maken. Begin 1945 werd het project verplaatst naar Mauthausen en later nog naar Ebensee."@nl;
    skos:altLabel "Operation Bernhard"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
