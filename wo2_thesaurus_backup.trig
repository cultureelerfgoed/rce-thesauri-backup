  <https://data.niod.nl/WO2_Thesaurus/20817> a <http://schema.org/Thing>, skos:Concept,
      <https://data.niod.nl/thesaurus_wo2/ImagesWW2/Legislation>;
    dcterms:references "Peter Romijn, Snel, streng en rechtvaardig. Politiek beleid inzake de bestraffing en reclassering van ‘foute’ Nederlanders 1945-1955 (Amsterdam: Olympus, 2002), 184."@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    dcterms:modified "2026-05-04T12:43:11.966Z"^^xsd:dateTime;
    dcterms:source "https://wetten.overheid.nl/jci1.3:c:BWBR0002015&z=2015-01-01&g=2015-01-01"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Het Besluit Politieke Delinquenten 1945 was een overheidsbesluit waardoor procureurs-fiscaal (speciale openbaar aanklagers binnen de bijzondere rechtspleging) de mogelijkheid kregen om zaken zelf af te handelen. De procureurs-fiscaal (PF’s) konden een verdachte vrijlaten of voorwaardelijk buiten vervolging stellen. In dit laatste geval kon de PF (tijdelijk) bepaalde burgerrechten afnemen, zoals kiesrecht, het bekleden van publieke ambten, of het dienen in het leger. Bij een voorwaardelijke buitenvervolgingstelling hoefden verdachten niet meer voor een Tribunaal of Bijzonder Gerechtshof te verschijnen. Het Besluit regelde ook de opsporing en bewaring (voorarrest) van alle personen die verdacht werden van collaboratie."@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/20818>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/19586>;
    dcterms:created "2024-05-23T09:10:54.533Z"^^xsd:dateTime;
    skos:prefLabel "Besluit Politieke Delinquenten 1945"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "Het Besluit Politieke Delinquenten 1945 was een overheidsbesluit waardoor procureurs-fiscaal (speciale openbaar aanklagers binnen de bijzondere rechtspleging) de mogelijkheid kregen om zaken zelf af te handelen. De procureurs-fiscaal (PF’s) konden een verdachte vrijlaten of voorwaardelijk buiten vervolging stellen. In dit laatste geval kon de PF (tijdelijk) bepaalde burgerrechten afnemen, zoals kiesrecht, het bekleden van publieke ambten, of het dienen in het leger. Bij een voorwaardelijke buitenvervolgingstelling hoefden verdachten niet meer voor een Tribunaal of Bijzonder Gerechtshof te verschijnen. Het Besluit regelde ook de opsporing en bewaring (voorarrest) van alle personen die verdacht werden van collaboratie."@nl;
    skos:altLabel "Besluit Pol. Del."@nl, "Besl. Pol. Del."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <https://data.niod.nl/thesaurus_wo2/ImagesWW2/Legislation> .
  
