    dcterms:source "Geheugen van Plan Zuid, http://geheugenvanplanzuid.nl/archief/tijdtijn/koco.htm [geraadpleegd 12 januari 2018]"@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/7699>;
