    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1686>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4673>;
