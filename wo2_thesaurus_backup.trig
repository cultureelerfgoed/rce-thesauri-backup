    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/4/42/NL-HlmNHA_Hrlm_24877%281%29.jpg/500px-NL-HlmNHA_Hrlm_24877%281%29.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/w/index.php?title=File:NL-HlmNHA_Hrlm_24877(1).jpg&oldid=455554585"@nl;
    <http://schema.org/startDate> "1944-10-26"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/9271>;
    dcterms:created "2020-11-17T15:51:49.845Z"^^xsd:dateTime;
    skos:prefLabel "Fusillade in Haarlem, 26 oktober 1944"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote """Op 26 oktober 1944 vond aan de Westergracht te Haarlem de fusillade plaats van 10 personen. De 10 mannen waren naar Haarlem overgebracht vanuit het Amsterdamse Huis van Bewaring aan de Weteringschans.
Voorbijgangers werden verplicht om toe te zien hoe de Duitsers wraak namen voor de liquidatie van SD'er Fake Krist een dag eerder. De verzetsstrijdster Truus Oversteegen was daar bij. Met anderen werd ze aangehouden toen ze toevallig passeerde. 

Naast de fusillade werden ook 4 huizen op de hoek Leidsezijstraat-Westergracht verwoest.
"""@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/7606> .
  
