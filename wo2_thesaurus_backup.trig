    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2684>, <https://data.niod.nl/WO2_Thesaurus/2078>;
    dcterms:created "2019-03-15T09:23:54.000Z"^^xsd:dateTime;
    skos:prefLabel "Overval gemeentehuis Hengelo (Gld)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Overval op het Gemeentehuis Hengelo, dat tijdens de bezetting gebruikt werd als distributiekantoor, vond plaats op 19 mei 1944. Zeven overvallers van verschillende knokploegen trachtte distributiebonnen te stelen uit een kluis in het gemeentehuis, maar de gewaarschuwde Onderluitenant Sminia, groepscommandant van de Marechaussee, voorkwam dit. Er ontstond een vuurgevecht en het lukte de overvallers niet om de bonnen mee te nemen."@nl;
    skos:altLabel "Overval op het Gemeentehuis Hengelo (Gld)"@nl, "Overval Gemeentehuis Hengelo (Gelderland)"@nl,
      "Overval distributiekantoor Hengelo"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2712>, <https://data.niod.nl/WO2_Thesaurus/4889> .
  
