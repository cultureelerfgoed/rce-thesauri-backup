    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8028>;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Koreri&oldid=42750741"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/4382>;
    dcterms:created "2019-01-21T12:16:38.000Z"^^xsd:dateTime;
    skos:prefLabel "Koreri-beweging"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Koreri-beweging (Koreri is, vrij vertaald, een paradijselijke toestand) is een oud geloof, in en rondom Nieuw-Guinea. Het gaat ervan uit dat het geheim van leven en dood, meegenomen door het mythische figuur Manarmakeri, ooit met iemand terug zal keren. Tijdens de bezetting verkondigde de gevangengenomen Angganitha Menufandu dat zij de boodschapper was. Een legertje (genaamd AB-Leger) probeerde Angganitha te bevrijden en begon een strijd tegen de Japanners en andere buitenlanders, maar deze opstand werd in de kiem gesmoord door de gevangenneming en onthoofding van de leiders achter de opstand (inclusief Angganitha).  "@nl;
    skos:altLabel "Koreri Beweging"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7717> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "Peter Post, ed., The Encyclopedia of Indonesia in the Pacific War (Leiden : Brill, 2010)"@nl,
