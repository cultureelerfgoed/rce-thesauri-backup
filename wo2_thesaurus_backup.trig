    skos:prefLabel "Detmerskazerne"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Determerkazerne te Eefde was gedurende de Tweede Wereldoorlog een opleidingsplek van het Nationalsozialistische Kraftfahrkorps (NSKK). Het personeel hiervan werd na de opleiding ingezet als konvooirijders naar en van het Oostfront. Tijdens de bevrijding van Nederland namen Canadese militairen hun intrek in de kazerne."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4619>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4466>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
