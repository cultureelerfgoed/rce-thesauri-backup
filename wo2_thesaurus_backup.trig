    skos:relatedMatch <https://data.niod.nl/WO2_biografieen/Carl-Heinrich-Rudolf-Wilhelm-von-Stulpnagel>;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/events/9427>, <https://data.niod.nl/WO2_Thesaurus/events/9421>,
      <https://data.niod.nl/WO2_Thesaurus/events/9422>, <https://data.niod.nl/WO2_Thesaurus/events/9418>,
