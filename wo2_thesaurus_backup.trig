      <https://data.niod.nl/WO2_Thesaurus/locations/8146>;
    dcterms:source "https://kaartvanindischverzet.nl/indischverzet/voorbereiding-geallieerde-tegenaanval/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2680>, <https://data.niod.nl/WO2_Thesaurus/corporaties/2669>;
    dcterms:created "2019-01-17T14:17:01.000Z"^^xsd:dateTime;
    skos:prefLabel "Rode Zakdoek"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Rode Zakdoek (Sapoe Tangan Merah) was een guerrillabeweging op Sumatra, die door de Japanse-bezetter deze naam kreeg, omdat veel Molukkers een rode zakdoek droegen. KNIL-generaal-majoor Roelof Theodorus Overakker had schriftelijk opgeroepen tot schuilen voor de bezetters en de aanval in te zetten zodra de geallieerde een poging zouden ondernemen om het gebied te bevrijden. Deze oproep werd door de Japanners ontdekt en na razzia's werden de vermeende leden opgepakt en werd Overakker geëxecuteerd."@nl;
    skos:altLabel "Sapen Tangan Merah"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/4382>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7708> a <http://schema.org/Thing>,
