  <https://data.niod.nl/WO2_Thesaurus/events/10350> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Waspik 1940-1945. Verhalen over Waspikse slachtoffers en helden, Leon Baaten, april 2020, Heemkundekring \"Op 't Goede Spoor\""@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-07-14T13:26:51.368Z"^^xsd:dateTime, "2026-07-14T13:26:51.484Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/10394>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://resolver.kb.nl/resolve?urn=urn:gvn:GMUSE01:2009_1159&role=thumbnail";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://resolver.kb.nl/resolve?urn=urn:gvn:GMUSE01:2009_1159";
    <http://schema.org/location> "Waspik";
    <http://schema.org/startDate> "1943-12-03"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2047>;
    dcterms:created "2020-11-19T10:21:45.866Z"^^xsd:dateTime;
    skos:prefLabel "Arrestatie Harrie Kommers in Waspik"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Harrie Kommers werkte op de secretarie van het gemeentehuis in Waspik. Ambtenaren aldaar werkten mee aan het vervalsen van bonkaarten voor distributieartikelen en het maken van valse persoonsbewijzen. In de loop van 1943 kwam de Sicherheitsdienst (SD) op de hoogte van deze activiteiten en op 3 december 1943 werd Harrie Kommers gearresteerd. Kommers werd naar de strafgevangenis in Haaren afgevoerd en in 1944 vrijgelaten."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
