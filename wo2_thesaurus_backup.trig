    <https://data.niod.nl/organizationsWO2/startDate> "1941-07-22"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/9fc1af57-664e-506b-ad8c-9c7ad3dad304.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/de881354-025a-11e7-904b-d89d6717b464/media/9fc1af57-664e-506b-ad8c-9c7ad3dad304";
    dcterms:source "https://www.leiden4045.nl/technische-noodhulp/"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-06"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Technische Noodhulp (TN) was een rampenbestrijdingsdienst. De TN herstelde infrastructuur en gebouwen na brand, bombardementen en andere noodsituaties, zoals stakingen. De TN werd op 22 juli 1941 opgericht door de Duitse bezetter, maar was formeel politiek neutraal. De TN bestond uit ongeveer 3.700 vrijwilligers, voornamelijk leden van de Nationaal-Socialistische Beweging (NSB)."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/6640>, <https://data.niod.nl/WO2_Thesaurus/20640>;
    dcterms:created "2023-05-11T11:57:15.262Z"^^xsd:dateTime;
    skos:prefLabel "Technische Noodhulp"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Technische Noodhulp (TN) werd op Duitse initiatief opgericht op 22 juli 1941 met als voorbeeld de Technische Nothilfe. De plaatselijke groepen van de TN zouden bij nood en rampen worden ingezet en ervoor moeten zorgen dat openbare bedrijven bleven functioneren. De leiding van de TN was in handen van de Duitser dr. F. Beck, die ook de functie bekleedde van Hauptsbereitschafsführer in den Verbindungsstab Niederlande der Technische Nothilfe. Hoewel de TN formeel politiek neutraal was, gaf Beck op 20 maart 1942 het bevel aan de plaatselijke groepen om bij de oprichting van lokale afdelingen van de Nederlandsche SS alle mogelijke ondersteuning te verlenen. Het merendeel van de leden van de TN bestond uit NSB’ers."@nl;
    skos:altLabel "Nederlandse Technische Noodhulp"@nl, "Nederlandsche Technische Noodhulp"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization>;
    skos:hiddenLabel "T.N."@nl, "TeNo"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/19561> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:references "N.J.G. Sikkel (red.), Documentatie. Samengesteld ten behoeve van de Bijzondere Rechtspleging, op last van de Procureur-Fiscaal bij het Bijzonder Gerechtshof te Amsterdam (Amsterdam 1947)"@nl,
      "Voorschrift no. 37 van secretaris-generaal Huygen, 15 juni 1943, bestemd voor districtsleiders en kringleiders, in NSB-archief inv.nr. 392"@nl,
      "Kennisgeving no. 107 van secretaris-generaal Huygen, 26 mei 1944, bestemd voor districtsleiders en kringleiders, in NSB-archief inv.nr. 391"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2024-08-12T12:03:08.633Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/endDate> "1944-05-03"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Alarmdienst, ook wel aangeduid als Nachschubbattalion, was een in 1941 opgerichte Nederlandse legerafdeling die personen en goederen transporteerde voor de Wehrmacht, het Duitse leger. In eerste instantie was lidmaatschap van de Nationaal-Socialistische Beweging (NSB) verplicht voor leden van de Alarmdienst. Vanaf juni 1943 mochten NSB’ers onder de 40 jaar geen lid worden van de Alarmdienst om te stimuleren dat zij bij de Waffen-SS in dienst zouden gaan. Op 3 mei 1944 werd de Alarmdienst opgeheven."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2101>, <https://data.niod.nl/WO2_Thesaurus/2878>,
      <https://data.niod.nl/WO2_Thesaurus/20640>;
    dcterms:created "2023-05-11T12:17:58.573Z"^^xsd:dateTime;
    skos:prefLabel "Alarmdienst"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Alarmdienst kwam op initiatief van de Wehrmacht en met toestemming van Mussert in 1941 tot stand. In geval van alarm (aangeduid als A-Fall) moesten leden van de Alarmdienst beschikbaar zijn voor het transporteren van personen (leden en niet leden van de NSDAP en de NSB) en eventueel levensmiddelen uit gebieden waar een geallieerde invasie dreigde. De Wehrmacht was verantwoordelijk voor het leveren van de benodigde vrachtauto’s en autobussen. Het NSB-lidmaatschap was vereist de Alarmdienst, maar werd in juni 1943 door de NSB-leiding verboden aan leden onder de 40 jaar om zo dienstneming in het Vrijwilligerslegioen Nederland en de Landstorm te bevorderen. De Alarmdienst, die een kwijnend bestaan leidde, is op 3 mei 1944 opgeheven."@nl;
    skos:altLabel "Nachschubbataillon"@nl, "Catastrophedienst"@nl, "Autobusvervoerdienst"@nl,
      "Nachschubkolonne"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/19562> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:references "R. Pluim, Ook zij waren getuigen. Nederlanders bij het Nationalsozialistische Kraftfahrkorps (NSKK) (Amsterdam 2013) "@nl,
      " N.J.G. Sikkel (red.), Documentatie. Samengesteld ten behoeve van de Bijzondere Rechtspleging, op last van de Procureur-Fiscaal bij het Bijzonder Gerechtshof te Amsterdam (Amsterdam 1947) "@nl,
      "Voorschrift no. 26 van Huygen, 12 januari 1943, bestemd voor kringleiders, in NSB-archief inv.nr. 392."@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-02-25T10:58:20.293Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1943-01-12"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/3dec7e87-f434-9724-fcc6-fff2088f324a.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/5d200e8e-025a-11e7-904b-d89d6717b464/media/3dec7e87-f434-9724-fcc6-fff2088f324a";
    <https://data.niod.nl/organizationsWO2/endDate> "1944-09-01"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Transportactie was een Nederlandse transporteenheid van de Wehrmacht, het Duitse leger. De Transportactie werd in januari 1943 opgericht met het doel Wehrmachtsoldaten te transporteren. In de Transportactie dienden voornamelijk leden van de Motor WA, de vervoersorganisatie van de Weerbaarheidsafdeeling (WA). In september 1944 ging de Transportactie op in de Nationalsozialistische Kraftfahrkorps (NSKK), de vervoersorganisatie van het Duitse leger."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2101>, <https://data.niod.nl/WO2_Thesaurus/20711>;
    dcterms:created "2023-05-11T12:30:25.033Z"^^xsd:dateTime;
    skos:prefLabel "Transportactie"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Transportactie kwam op initiatief van de verbindingsofficier van het NSKK F. Hegendörfer en met toestemming van Mussert tot stand in januari 1943. De taak van de Transportactie was het vervoeren van troepen ten behoeve van de Wehrmacht naar plaatsen waar een geallieerde invasie dreigde. Aan het hoofd stond de commandant van de Motor-WA H. Eman die nauw contact onderhield met Hegendörfer. Het merendeel van de manschappen bestond uit leden van de Motor-WA. In september 1944 werd de slecht georganiseerde Transportactie overgenomen door het NSKK. "@nl;
    skos:altLabel "B.M.-Aktion"@nl, "Beweglich-Machung-Aktion"@nl, "B.M.-Aktion (Beweglich-Machung)"@nl,
      "B.M.-actie"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4619>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/19567> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "N.J.G. Sikkel (red.), Documentatie. Samengesteld ten behoeve van de Bijzondere Rechtspleging, op last van de Procureur-Fiscaal bij het Bijzonder Gerechtshof te Amsterdam (Amsterdam 1947)"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-03-26T11:30:55.356Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1941-06-13"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/f056a83f-9ec7-e498-e584-bf39fb5b9e56.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/104a0290-025a-11e7-904b-d89d6717b464/media/f056a83f-9ec7-e498-e584-bf39fb5b9e56";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/10487e8e-025a-11e7-904b-d89d6717b464/media/fa5b4715-e8aa-7f1d-00ac-c51f73e4fcea>,
      <https://beeldbankwo2.nl/nl/beelden/detail/1047b97c-025a-11e7-904b-d89d6717b464/media/cb9f3084-0871-815d-1434-4284f706aab8>,
      <https://beeldbankwo2.nl/nl/beelden/detail/af3c8971-9fe4-f755-4940-e2b3b2976b73/media/95b685d7-2c45-b559-03f9-d4c63b5096f2>;
    dcterms:source "https://www.holocaust-lestweforget.com/penal-camp-ommendutch.html"@nl,
      "https://nl.wikipedia.org/w/index.php?title=Kamp_Erika&oldid=67502706"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-06"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Het Kontrolle Kommando (KK) was de hulppolitie en bewakingsdienst van het strafkamp Kamp Erika bij Ommen. Naast de bewaking van het strafkamp was de KK ook betrokken bij het oppakken van ondergedoken Joden, verzetsdeelnemers en ontduikers van de Arbeitseinsatz. Zeker 50 Nederlanders werden vrijwillig lid van de KK. De KK werd in juni 1941 opgericht met Werner Schwier aan het hoofd. In 1944 werd de KK opgenomen in de Arbeits Kontrolle Dienst (AKD) en vanaf oktober 1944 in de Duitse reguliere politie, de Ordnungspolizei."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4628>, <https://data.niod.nl/WO2_Thesaurus/2715>;
    dcterms:created "2023-05-11T13:17:15.967Z"^^xsd:dateTime;
    skos:prefLabel "Kontrolle Kommando"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Kontrolle Kommando (KK) werd op bevel van Seyss-Inquart in juni 1941 opgericht en stond onder leiding van Bereitschaftsführer dr. W. Schwier. De voornaamste taken van de organisatie waren bewakingsdiensten in kamp Erika te Ommen en bij verschillende Gewestelijke Arbeidsbureaus in de hoedanigheid van hulppolitie. In de zomer van 1944 werd de Arbeits Kontrolle Dienst (AKD) ingesteld die bestond uit het personeel dat dienst had gedaan bij de Gewestelijke Arbeidsbureaus. Vanaf omstreeks oktober 1944 ressorteerde het KK-personeel dat werkte in kamp Erika onder de Ornungspolizei. In dit kamp en bij razzia’s naar ondergedoken Joden en verzetsmensen in de omgeving van Ommen maakten KK-mannen zich schuldig aan mishandeling en moord."@nl;
    skos:altLabel "KK"@nl, "K.K."@nl, "Kontroll-Kommando"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/6643> .
  
  <https://data.niod.nl/WO2_Thesaurus/19568> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2024-08-12T12:03:08.841Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1939-07-21"^^xsd:date;
    dcterms:source "https://en.wikipedia.org/w/index.php?title=Geheime_Feldpolizei&oldid=1141593291"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-08"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Geheime Feldpolizei (GFP) was de spionagedienst en geheime militaire politie van het Duitse leger. De GFP voerde politietaken uit, zoals beveiliging van onder meer officieren in het Duitse leger en het opsporen en verhoren van verdachten. De GFP werd 21 juli 1939 opgericht en in 1942 opgenomen in de overkoepelende Duitse politie- en veiligheidsdienst, de Reichssicherheitshauptamt (RSHA)."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4658>, <https://data.niod.nl/WO2_Thesaurus/3554>,
      <https://data.niod.nl/WO2_Thesaurus/3585>, <https://data.niod.nl/WO2_Thesaurus/20709>;
    dcterms:created "2023-05-11T13:30:54.045Z"^^xsd:dateTime;
    skos:prefLabel "Geheime Feldpolizei"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Geheime Feldpolizei (GFP) werd op 21 juli 1939 opgericht en was de geheime militaire politie van de Wehrmacht. De GFP was verantwoordelijk voor de veiligheid van de Duitse krijgsmacht in de bezette gebieden, maar trad ook meedogenloos op tegen personen die hiervoor geen gevaar vormden. Behalve als militaire politie, functioneerde de GFP ook als inlichtingen- en spionagedienst en als commandotroepen. Bij haar operaties in Griekenland, de Balkan en Oost-Europa waren eenheden van de GFP op grote schaal betrokken bij oorlogsmisdaden en misdaden tegen de menselijkheid. Ook in Noord- en West-Europa maakten haar manschappen zich ook hier schuldig aan martelingen en moorden. In 1942 werd de GFP opgenomen in de Reichssicherheitshauptamt (RSHA)."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/19569> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "G. Meershoek, Dienaren van het gezag. De Amsterdamse politie tijdens de bezetting (Amsterdam 1999)"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-05-19T10:25:28.847Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1941-05-15"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/a286f67c-affe-4e3d-97ac-db33a5c21d04.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/3243593c-025a-11e7-904b-d89d6717b464/media/a286f67c-affe-4e3d-97ac-db33a5c21d04";
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-06"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Het Politiebataljon Amsterdam (PBA) was een Amsterdamse politie-eenheid die actief met de Duitse bezetter collaboreerde. De PBA bestond uit zo’n 250 tot 270 politieagenten die een militaire opleiding en lessen in nationaalsocialistisch gedachtegoed kregen. De PBA was betrokken bij razzia’s, het deporteren van Joden en het bewaken van kampen. Eind 1944 werd de PBA opgeheven."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/22021>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2715>, <https://data.niod.nl/WO2_Thesaurus/20709>;
    dcterms:created "2023-05-11T14:03:17.163Z"^^xsd:dateTime;
    skos:prefLabel "Politiebataljon Amsterdam"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Politiebataljon Amsterdam (PBA) werd op 15 mei 1941 op last van Befehlshaber der Ordnungspolizei Generalmajor O. Schuman opgericht. Het betrof een militair georganiseerde en gekazerneerde eenheid die oorspronkelijk uit 254 agenten bestond. Na het verzoek van de Amsterdams hoofdcommissaris van de politie Sybren Tulp daartoe aan Rauter kreeg het voltallige bataljon een op nationaalsocialistische leest geschoeide opleiding op Politieschool Schalkaar (Politieopleidingsbataljon Schalkaar). Vanaf augustus 1942 tot en met februari 1943 was het PBA zeer intensief betrokken bij het ophalen van Joden uit hun woningen. Agenten van het PBA maakten zich daarbij regelmatig schuldig aan diefstal."@nl;
    skos:altLabel "PBA"@nl, "P.B.A."@nl, "Sybren Tulpcompagnie Politietroepen"@nl, "Sybren Tulpcompagnie"@nl .
  
