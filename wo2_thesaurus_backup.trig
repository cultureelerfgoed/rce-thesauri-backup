    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8019>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> <https://lh3.ggpht.com/eUVaTgcmM2e8dPrHXihT95sd4OvRxexTi_s5x4omXJopdeGiWSNLjZ8nJ5GftCuVn5P6L646GXwWsXu1CRbY63Jk2w=s0>;
