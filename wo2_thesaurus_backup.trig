    <http://schema.org/endDate> "1945-04-30"^^xsd:date;
    dcterms:source "https://nos.nl/75jaarbevrijding/bericht/2331985-geheime-gesprekken-met-nazi-s-over-voedselhulp.html"@nl,
      "https://nos.nl/75jaarbevrijding/bericht/2332237-bernhard-tergt-seyss-vond-hij-niet-leuk.html"@nl,
      "https://nl.wikipedia.org/w/index.php?title=Akkoord_van_Achterveld&oldid=52106743"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/events/6605>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2860>, <https://data.niod.nl/WO2_Thesaurus/2319>;
    dcterms:created "2018-09-21T05:55:06.000Z"^^xsd:dateTime;
    skos:prefLabel "Akkoord van Achterveld"@nl, "Waffenstillstand von Achterveld"@de,
      "Agreement of Achterveld"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote """Het Akkoord van Achterveld (ook bekend als de Voedselconferentie van Achterveld) was een op 28 en 30 april 1945 getekend akkoord tussen de Geallieerden en de Duitse bezetter voor voedselhulp naar het westen van Nederland. Het Akkoord van Achterveld vormde tevens de aanloop tot de capitulatie-onderhandelingen in Wageningen.
"""@nl;
    skos:altLabel "Voedselconferentie van Achterveld"@nl, "Achterveld-akkoord"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/6607> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2021-03-15T16:36:07.777Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8028>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/wo2nedindieThema> "Herbezetting Nederlands-Indië";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/250x250/50bdd494-b7c9-33e5-2b19-ed962c89786d.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/fe7c5860-0259-11e7-904b-d89d6717b464/media/50bdd494-b7c9-33e5-2b19-ed962c89786d"@nl;
    <http://schema.org/location> "Borneo";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://nimh-beeldbank.defensie.nl/foto-s/4c016207-f558-1be6-9085-81705f90a593>,
      <https://beeldbankwo2.nl/nl/beelden/detail/c9fec05a-0259-11e7-904b-d89d6717b464/media/d19028a9-f259-29ae-3786-8a3e71ce0424>,
      <https://beeldbankwo2.nl/nl/beelden/detail/fe88647a-0259-11e7-904b-d89d6717b464/media/e8bf650f-ea12-9ba3-9e79-fd50ce668a38>;
    <http://schema.org/startDate> "1945-05-01"^^xsd:date;
    <http://schema.org/endDate> "1945-07-21"^^xsd:date;
    dcterms:source """https://en.wikipedia.org/w/index.php?title=Borneo_campaign_(1945)&oldid=833227125
"""@nl;
    <http://schema.org/description> "Douglas MacArthur keurt de aanval op Nederlands-Indië goed. De operatie krijgt de codenaam Oboe en zal worden uitgevoerd door Australische troepen. Operatie Oboe kent zes fasen: de verovering van Tarakan (Oboe 1), Balikpapan (Oboe 2), Bandjermasin (Oboe 3), Java (Oboe 4), de rest van Nederlands-Indië (Oboe 5) en ten slotte Brits-Borneo (Oboe 6). Operatie Oboe stuit echter op bezwaren van de Amerikaanse legerleiding en van de Australische regering. Na de verovering van de Filippijnen is de militaire rechtvaardiging voor een invasie van Nederlands- Indië weggevallen. Drie van de zes Oboe-operaties gaan uiteindelijk door. De invasie van Java wordt op 3 april geschrapt."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2350>, <https://data.niod.nl/WO2_Thesaurus/2343>,
      <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2018-09-21T05:55:18.000Z"^^xsd:dateTime;
    skos:prefLabel "Operatie Oboe"@nl, "Unternehmen Oboe"@de, "Operation Oboe"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Operatie Oboe was de naam van de Geallieerde aanval (van Amerikaanse en Australische strijdkrachten) tussen 1 mei en 21 juli 1945 op de Japanse strijdkrachten op en de invasie van Borneo. De invasie van Borneo was de tweede fase van Operatie Montclair."@nl;
    skos:altLabel "Borneo campaign"@nl, "Borneo campagne"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/6608> a <http://schema.org/Thing>, skos:Concept,
