    skos:broader <https://data.niod.nl/WO2_Thesaurus/2244>;
    dcterms:created "2019-02-13T14:35:30.000Z"^^xsd:dateTime;
    skos:prefLabel "Gilde der Voortrekkers"@nl, "'Gilde der Voortrekkers'"@de, "'Gilde der Voortrekkers'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Gilde der Voortrekkers was vanaf 1936 een organisatie binnen de NSB, officieel gericht op propaganda. De organisatie bestond echter voor een groot deel uit leden van de per 31 december 1935 opgeheven WA."@nl;
