    <https://data.niod.nl/eventsWO2/toLocation> <https://data.niod.nl/WO2_Thesaurus/locations/19805>;
    <https://data.niod.nl/organizationsWO2/caused> <https://data.niod.nl/WO2_Thesaurus/events/10311>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2329>, <https://data.niod.nl/WO2_Thesaurus/2698>;
    dcterms:created "2022-09-12T12:47:47.926Z"^^xsd:dateTime;
    skos:prefLabel "Vliegtuigcrash bij Zaandijk"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Vliegtuigcrash bij Zaandijk vond plaats op 11 september 1944. De Amerikaanse B-24J bommenwerper ‘Betty Jane’ was tijdens een missie over Duitsland geraakt door luchtafweergeschut en was niet in staat om terug te keren naar Engeland. Het vliegtuig verloor hoogte boven Nederland waardoor de bemanning besloot het vliegtuig per parachute te verlaten. De negen bemanningsleden werden door het Zaanse verzet in veiligheid gebracht. De Duitsers eisten de uitlevering van de bemanningsleden, maar hier werd in eerste instantie geen gehoor aan gegeven. Toen represailles volgden op 13 september 1944, besloot het verzet de bemanningsleden alsnog uit te leveren. Alle bemanningsleden overleefden de oorlog."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
