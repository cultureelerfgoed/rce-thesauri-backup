    <http://schema.org/startDate> "1945-01-17"^^xsd:date;
    dcterms:source "https://wikimiddenbrabant.nl/Granaatinslag_Hasseltstraat,_17_januari_1945"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/8508>;
    dcterms:created "2025-10-08T09:33:37.446Z"^^xsd:dateTime;
    skos:prefLabel "Granaatinslag Hasseltstraat Tilburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De granaatinslag op de Hasseltstraat in Tilburg vond plaats op 17 januari 1945. Na de bevrijding van Tilburg op 27 oktober 1944 blijft het maandenlang gevaarlijk in de stad. Op 17 januari 1945 komt een granaat neer bij het woonhuis van steenfabrikant Teurlings, Hasseltstraat 200. Ook voor de Hasseltse kerk slaat een granaat in. Negen personen zijn op slag dood. Vijf zwaargewonden overlijden nog dezelfde dag, anderen sterven later aan hun verwondingen. In totaal komen zestien mensen om het leven."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
