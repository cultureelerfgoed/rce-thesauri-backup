    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2009>, <https://data.niod.nl/WO2_Thesaurus/kampen/3655>;
    dcterms:created "2021-12-16T08:54:16.890Z"^^xsd:dateTime;
    skos:prefLabel "Krematorium III"@de, "Crematorium III"@en, "Crematorium III"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Tussen maart en juni 1943 werden de industriële crematoria in Auschwitz-Birkenau in gebruik genomen. Crematorium III was van juni 1943 tot november 1944 in gebruik. Het gebouw bevond zich geheel bovengronds en kon 768 mensen verwerken. Later werd de efficiëntie opgeschroefd en kon de gaskamer maximaal 2500 personen in 24 uur verwerken. In november 1944 werd het crematorium gesloopt en op 20 januari 1945 blies de SS de laatste restanten op."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/18489> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    dcterms:modified "2022-03-09T13:22:50.261Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/kampen/9331>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/f/f7/KZ_Auschwitz_I_%28Stammlager%29%2C_Final_Solution%2C_by_Tizian_Sander_2010.JPG/500px-KZ_Auschwitz_I_%28Stammlager%29%2C_Final_Solution%2C_by_Tizian_Sander_2010.JPG";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/wiki/File:KZ_Auschwitz_I_(Stammlager),_Final_Solution,_by_Tizian_Sander_2010.JPG";
    <http://schema.org/startDate> "1940-08-15"^^xsd:date;
    <http://schema.org/endDate> "1943-07-01"^^xsd:date;
    dcterms:source "https://www.jewishvirtuallibrary.org/crematoria-and-gas-chambers-at-auschwitz-birkenau"@nl,
      "https://nl.wikipedia.org/wiki/Auschwitz-Birkenau"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/18498>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2009>, <https://data.niod.nl/WO2_Thesaurus/kampen/9331>;
    dcterms:created "2021-12-16T09:29:08.787Z"^^xsd:dateTime;
    skos:prefLabel "Crematorium I"@nl, "Krematorium I"@de, "Crematorium I"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote """Crematorium I was de eerste gaskamer in concentratiekamp Auschwitz. Het crematorium was operationeel van 15 augustus 1940 tot juli 1943. Nadat de bunker werd verbouwd tot gaskamer vonden hier de eerste vergassingen plaats in december 1941. Deze eerste slachtoffers waren Russische krijgsgevangenen. De gaskamer kon 340 personen per 24 uur verwerken. Tot mei 1942 functioneerde de gaskamer en tot eind juli 1943 het crematorium.
Toen in Auschwitz-Birkenau Bunker 1 en 2 als gaskamers waren ingericht en daarna de crematoria werd crematorium I eerst een opslagruimte en daarna een schuilkelder voor de SS. Na de oorlog werd crematorium I gedeeltelijk gereconstrueerd."""@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
