    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/6411>;
    dcterms:created "2018-07-16T07:58:57.000Z"^^xsd:dateTime;
    skos:prefLabel "Stalag XVIII-D"@nl, "Stalag XVIII-D"@de, "Stalag XVIII-D"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Stalag XVIII-D was een Duits krijgsgevangenkamp in Maribor, Slovenië. In het Duits heette het Marburg an der Drau en het lag eeuwenlang in Oostenrijk. Het kwamp was vanaf begin 1941 tot het einde van de oorlog operationeel. In juli 1945 verbleven er zo'n 4500 Britse en Gemenebest gevangenen. Er vonden geregeld ontsnappingen met hulp van Joegoslavische partizanen plaats. In augustus 1944 werden er 105 geallieerde gevangenen uit een werkkamp beheerd door Stalag XVIII-D door de partizanen bevrijd."@nl;
    skos:altLabel "Stalag Marburg an der Drau"@nl, "Stalag XVIII D"@nl, "Stalag XVIII-D Marburg an der Drau"@nl,
      "Stalab XVIII-D Maribor"@nl, "Stalag 306"@nl .
  
