    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/w/index.php?title=File:COLLECTIE_TROPENMUSEUM_Het_schip_de_Imhoff_ligt_op_de_rede_van_Donggala._TMnr_60008284.jpg&oldid=844292475";
    <http://schema.org/location> "Indische Oceaan ";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://www.oorlogsbronnen.nl/zoekresultaat?id=http%3A%2F%2Farchievenwo2.nl%2Farchieven%2Farchief-blok%2F2147438760>,
      <https://www.archieven.nl/nl/search-modonly?mivast=298&mizig=210&miadt=298&micode=400ENG&milang=nl&miview=inv2>;
    <http://schema.org/startDate> "1942-01-18"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Van_Imhoff_(schip,_1914)&oldid=52517254"@nl;
    <http://schema.org/description> "Het s.s. Van Imhoff wordt op Indische Oceaan door een Japans verkenningsvliegtuig gebombardeerd en slaat lek. Het zinkende schip wordt door de scheepsbemanning en de bewaking verlaten zonder achterlating van voldoende reddingsmiddelen voor de gevangenen. De Van Imhoff transporteert 473 gevangenen Duitsers en NSB’ers van Sumatra naar Brits-Indië. Bij de scheepsramp verliezen ruim 400 gevangenen het leven. "@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2350>, <https://data.niod.nl/WO2_Thesaurus/3511>,
      <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2019-03-19T14:47:41.000Z"^^xsd:dateTime;
    skos:prefLabel "Scheepsramp Van Imhoff"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Scheepsramp s.s. Van Imhoff vindt plaats op 18 januari 1942 in de Indische Oceaan, nadat het schip door een Japanse verkenningsvliegtuig wordt gebombardeerd en lek slaat. De Van Imhoff transporteert 473 gevangenen Duitsers en NSB’ers van Sumatra naar Brits-Indië. Het zinkende schip wordt door de scheepsbemanning en de bewaking verlaten zonder achterlating van voldoende reddingsmiddelen voor de gevangenen, waardoor er 415 gevangenen om het leven komen."@nl;
    skos:altLabel "Van Imhoff"@nl .
  
