    dcterms:created "2020-03-19T11:11:05.000Z"^^xsd:dateTime;
    skos:prefLabel "Dresden (Goehle Werk)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote """Aussenlager Dresden (Goehle Werke) was van 9 oktober 1944 tot midden april 1945 een buitenkamp van Flossenbürg, gevestigd in de Goehle Werk (Riesaer Strasse 32). De ongeveer 700 vrouwelijke gevangenen, hoofdzakelijk Polen en Russen, werden tewerkgesteld aan het maken van munitie voor 8,8 cm Flak-geschut.
"""@nl;
    skos:altLabel "Aussenlager Dresden (Goehle Werk)"@nl, "Aussenlager Goehle Werk"@nl,
      "Goehle Werk"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/8827> a <http://schema.org/Thing>, skos:Concept,
