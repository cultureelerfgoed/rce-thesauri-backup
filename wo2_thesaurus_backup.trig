    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het illegale blad Deutsche Soldatenzeitung für die Niederlande werd van 27 april 1943 tot en met 3 mei 1945 uitgegeven in Haarlem onder redactie van T.N. van Disseldorp en F.H. Tielens."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8745> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "PPN: 269129146"@nl;
