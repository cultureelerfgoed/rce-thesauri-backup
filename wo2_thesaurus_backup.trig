    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het illegale blad Hier is Londen werd van 6 november 1944 tot en met 8 mei 1945 uitgegeven in Amsterdam door de familie Simonis."@nl;
    skos:altLabel "Alles sal reg kom (Amsterdam)"@nl .
  
