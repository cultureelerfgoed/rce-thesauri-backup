    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/f/f8/Bedieningshuisje_bij_de_Deventerbrug_-_Apeldoorn_-_20360243_-_RCE.jpg/320px-Bedieningshuisje_bij_de_Deventerbrug_-_Apeldoorn_-_20360243_-_RCE.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Bestand:Bedieningshuisje_bij_de_Deventerbrug_-_Apeldoorn_-_20360243_-_RCE.jpg";
