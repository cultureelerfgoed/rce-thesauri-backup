    skos:prefLabel "Antijüdische Gesetze"@de, "Anti-Jewish measures"@en, "Anti-joodse maatregelen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:exactMatch <https://digitaalerfgoed.poolparty.biz/westerbork/1009>;
    skos:scopeNote "Anti-Joodse maatregelen zijn maatregelen die tijdens het naziregime tegen de Joden werden ingesteld: o.a. ontneming staatsburgerschap; niet mogen bekleden van openbare ambten; uitsluiting van Joden voor onderwijs en banen; verlies van stemrecht, verbod op huwelijken en seksuele contacten tussen Joden en niet-Joden; in beslag name Joodse bezittingen, verplichte dracht van de Jodenster."@nl;
    skos:altLabel "Anti-Joodse maatregelen"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/20300> a <http://schema.org/Thing>, skos:Concept;
