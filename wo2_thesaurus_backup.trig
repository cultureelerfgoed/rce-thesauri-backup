    dcterms:source "https://nos.nl/artikel/2335884-unieke-filmbeelden-geven-kijkje-in-kibboets-van-franeker-eind-jaren-30"@nl,
      "https://historischcentrumfraneker.nl/films/franeker-1937-1939-de-franeker-kibboets/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/18503>;
    dcterms:created "2021-12-23T13:31:22.084Z"^^xsd:dateTime;
    skos:prefLabel "Ontruiming kibboets Franeker"@nl, "Räumung Kibbuz Franeker"@de, "Eviction Kibbutz Franeker"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Op 3 november 1941 vielen de Duitsers samen met de Franeker politie de kibboets in Franeker binnen en arresteerden de aanwezige bewoners voor het hamsteren van voorraden. Twee persoon konden ontsnappen en de rest werd overgebracht naar gevangenis Blokhuispoort in Leeuwarden. De groep ging later op transport naar Kamp Westerbork. Dit betekende het einde van de kibboets Franeker."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/18516> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
