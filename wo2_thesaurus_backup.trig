    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:04:11.718Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/18230>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/4462bc98-ed7f-9b08-a9d5-13071b80e483.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/ca3c5f3c-0259-11e7-904b-d89d6717b464/media/4462bc98-ed7f-9b08-a9d5-13071b80e483";
    <http://schema.org/startDate> "1943-05-13"^^xsd:date;
    dcterms:source "https://en.wikipedia.org/wiki/Afrika_Korps"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/17938>;
    dcterms:created "2021-11-10T10:14:40.058Z"^^xsd:dateTime;
    skos:prefLabel "Kapitulation Deutsches Afrikakorps"@de, "Overgave Afrikakorps"@nl,
      "Surrender German Africa Corps"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De overgave van het Afrikakorps en de Italiaanse troepen vond plaats op 13 mei 1943. Onder aanvoering van de Duitse legerleider Erwin Rommel had het Duitse Afrikakorps (Deutsches Afrikakorps of DAK) vanaf februari 1941 de Italiaanse bondgenoten gesteund in Noord-Afrika. Vanaf 1942 werden de Duitsers door de Britten en Amerikanen steeds verder teruggedrongen."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/17942> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:36:19.663Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/9663>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/68f917eb-0a3e-79f0-6342-de4285f246d4.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/bfdf4e68-025a-11e7-904b-d89d6717b464/media/68f917eb-0a3e-79f0-6342-de4285f246d4";
    dcterms:source "https://www.hktegelen.nl/events/lezing/"@nl, "https://jck.nl/nl/page/venlo"@nl,
      "https://www.nmkampvught.nl/ontdekken/het-verhaal/vermoord-in-vught/bosman-gerrit/"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/4884>;
    dcterms:created "2021-11-10T10:55:12.263Z"^^xsd:dateTime;
    skos:prefLabel "Buitenkommando Venlo"@nl, "Aussenkommando Venlo"@de, "Aussenkommando Venlo"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Vanaf april 1944 werden gevangenen uit Kamp Vught ingezet door de Bauleitung der Luftwaffe Venlo. De Duitse bezetter wilde in 1943 meerdere Luftwaffe-vliegvelden uitbreiden en zat verlegen om arbeidskrachten. In dit Aussenkommando zaten Belgen, Fransen en Nederlanders. Hun taak was het aanleggen van rolbanen en start- en landingsbanen na een bombardement repareren. Vanwege het gevaar voor bombardementen kreeg het Aussenkommando de bijnaam Himmelfahrtkommando."@nl;
    skos:altLabel "Aussenkommando Venlo"@nl .
  
