    dcterms:created "2023-07-20T10:38:33.243Z"^^xsd:dateTime;
    skos:prefLabel "Groepsleidster"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De rang groepsleidster hopman behoorde tot het middenkader voor meisjes in de Nationale Jeugdstorm. Voor het bekleden van een rang van het middenkader was een minimumleeftijd van 21 jaar vereist. In geval van bijzondere geschiktheid kon hiervan worden afgeweken. De voorgeschreven afkorting van de rang groepsleidster was Grl. De rang groepsleidster was ook de functionaris binnen de Nationaal-Socialistische Vrouwenorganisatie (NSVO) die de leiding had over een lokale groep van leden. De groepsleidster was ondergeschikt aan de kringleidster. De territoriale indeling van de NSVO in groepen, kringen en districten liep parallel aan die van de NSB en kende dezelfde hiërarchische structuur."@nl;
    skos:altLabel "Grl."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4553>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4621> .
  
