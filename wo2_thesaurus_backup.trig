    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/4c670368-025a-11e7-904b-d89d6717b464/media/f05b290d-6aab-cccc-5deb-fd9c32f08d83";
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/7245>, <https://data.niod.nl/WO2_Thesaurus/events/19538>;
    dcterms:created "2023-06-19T14:22:35.232Z"^^xsd:dateTime;
    skos:prefLabel "Bombardementen op Walcheren"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "In oktober 1944 werden dijken en Duitse geschutsopstellingen op Walcheren zwaar gebombardeerd door de Royal Air Force. Dit was ter voorbereiding van de landingsoperatie door Britse en Canadese eenheden op Walcheren, Operation Infatuate."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/19640> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    dcterms:modified "2023-06-19T14:43:07.410Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/b3030963-056d-c45b-88b3-8713a5e900c3.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/1e3eaf0e-025a-11e7-904b-d89d6717b464/media/b3030963-056d-c45b-88b3-8713a5e900c3";
    <http://schema.org/startDate> "1945-01-01"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
