    dcterms:created "2025-11-25T10:32:11.807Z"^^xsd:dateTime;
    skos:prefLabel "Stapf Bilderdienst"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Stapf Bilderdienst was een Duits fotopersbureau gevestigd in Amsterdam. De Duitse nationaalsocialist Franz Anton Stapf richtte het in 1935 op. Het fotopersbureau leverde voor en tijdens de Duitse bezetting van Nederland foto- en propagandamateriaal aan de Nederlandse pers."@nl .
  
