    dcterms:created "2021-02-04T14:19:10.898Z"^^xsd:dateTime;
    skos:prefLabel "Liquidatie van Simon de Graaf"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De liquidatie van Simon de Graaf vond plaats op 28 september 1944 in Zutphen. De Graaf was lid van de NSB en werd verdacht van verraderlijke praktijken. Hij was slager en werd gedood in de slagerij van de Joodse eigenaar Weijl. "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/11023> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Recht op wraak. Liquidaties in Nederland 1940-1945, Jack Kooistra en Albert Oosthoek, Leeuwarden 2009"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
