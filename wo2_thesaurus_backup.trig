    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/18213>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/c/cd/Stadsarchief_Amsterdam%2C_Afb_010179000216.jpg/1920px-Stadsarchief_Amsterdam%2C_Afb_010179000216.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://en.wikipedia.org/w/index.php?title=SS_Tjisalak&oldid=923162137#/media/File:Stadsarchief_Amsterdam,_Afb_010179000216.jpg";
    <http://schema.org/startDate> "1944-03-26"^^xsd:date;
    dcterms:source "https://en.wikipedia.org/w/index.php?title=SS_Tjisalak&oldid=923162137"@de,
      "https://nl.wikipedia.org/w/index.php?title=Tjisalak_(schip,_1917)&oldid=54772892"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3511>;
    dcterms:created "2020-07-08T07:56:38.000Z"^^xsd:dateTime;
    skos:prefLabel "Scheepsramp Tjisalak"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Scheepsramp SS Tjisalak vond plaats op 26 maart 1944 in de Indische Oceaan na torpedering door de Japanse onderzeeboot I-8. Een van de passagiers ging met het schip ten onder, de rest van de opvarenden kon zichzelf in veiligheid brengen op sloepen. De Japanners dwongen de 102 overlevenden over te stappen op het dek van de onderzeeboot en vermoordden de overlevenden. Slechts vijf bemanningsleden wisten te overleven."@en,
      "De Tjisalak was een cargostoomschip van de toenmalige Java-China-Japan Lijn (JCJL). Op 26 maart 1944 werd het stoomschip getorpedeerd door de Japanse onderzeeboot I-8 onder commandant korvetkapitein Ariizumi in de Indische Oceaan. Van de 103 mensen overleefden slechts 5 personen de ramp, temeer omdat de Japanners na het zinken van het schip de overlevenden alsnog om het leven brachten."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2350>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4551> .
  
