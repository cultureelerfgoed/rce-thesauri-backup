    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/w/index.php?title=File:Groepen_vrouwen_staan_aangetreden_op_een_appelplaats_Een_kampbewaardster_geeft_,_Bestanddeelnr_900-4805.jpg&oldid=1285658815";
    dcterms:source "https://kampamersfoort.nl/tijdlijn/"@nl, "https://achterhetijzerdraad.com/2014/09/15/het-ijzerdraad-veranderde-in-een-rozentuin/"@nl,
      "https://www.amersfoortopdekaart.nl/hoogtepunten/bergkwartier-bosgebied/kamp-amsvorde/pointofinterest/detail"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/4999>, <https://data.niod.nl/WO2_Thesaurus/1873>,
      <https://data.niod.nl/WO2_Thesaurus/8176>;
    dcterms:created "2026-10-20T14:52:33.789Z"^^xsd:dateTime;
    skos:prefLabel "Kamp Amsvorde"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Kamp Amsvorde in Amersfoort was een legerplaats en interneringskamp (bijzondere rechtspleging). Het kamp bevond zich naast Huis te Kalkwegh dichtbij Kamp Amersfoort. De legerplaats van het Nederlandse leger werd in 1941 in gebruik genomen als opleidingscentrum en kazerne van het SS-Wachkommando Nord-West. Hier werden Nederlanders en Duitsers opgeleid tot bewakingseenheden. Vanaf 1945 was Kamp Amsvorde een interneringskamp. Hier zaten voornamelijk vrouwelijke verdachten van en veroordeelden voor collaboratie opgesloten."@nl;
    skos:altLabel "Amsvorde-kamp"@nl, "Centraal Bewaringskamp Amsvorde"@nl, "Lager Amsvorde"@nl,
      "Ziekenkamp Amsvorde"@nl, "Verblijfs- en Bewaringskamp Amsvorde"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
