    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/c/cf/K%C3%B6ln_Klingelp%C3%BCtz_Zellent%C3%BCr.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/w/index.php?title=File:K%C3%B6ln_Klingelp%C3%BCtz_Zellent%C3%BCr.jpg&oldid=606678561";
    dcterms:source "https://de.wikipedia.org/w/index.php?title=Klingelp%C3%BCtz&oldid=234771997"@de,
      "https://museenkoeln.de/ns-dokumentationszentrum/default.aspx?s=764"@de;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1686>, <https://data.niod.nl/WO2_Thesaurus/8176>,
      <https://data.niod.nl/WO2_Thesaurus/locations/11372>;
    dcterms:created "2023-08-29T09:18:42.051Z"^^xsd:dateTime;
    skos:prefLabel "Gevangenis Klingelpütz"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "De Klingelpütz gevangenis bevond zich in Keulen. Van het begin van de oorlog tot de bevrijding op 25 mei 1945 fungeerde Klingelpütz als Polizeigefängnis. Er zaten tienduizenden buitenlandse dwangarbeiders, politieke gevangenen en terdoodveroordeelden gevangen. De gevangenis werd ook gebruikt als executieplaats. De gevangenis werd gebruikt door de Gestapo, maar ook door speciale gerechtshoven zoals het Sondergerichte van Aachen, Dortmund, Düsseldorf, Duisburg, Essen, Hagen, Koblenz, Keulen, Münster, Wuppertal, het Volksgerichtshof van Berlijn en het Reichsgericht van Leipzig."@nl;
    skos:altLabel "Klingelpuetz Keulen"@nl, "Klingelpuetz Köln"@nl, "Klingelpuetz gevangenis"@nl,
      "Polizeigefängnis Klingelpuetz"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
