    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://en.wikipedia.org/wiki/Stalag_XI-B#/media/File:POWs_at_Stalag_11B_at_Fallingbostel_in_Germany_welcome_their_liberators,_16_April_1945._BU3661.jpg";
    dcterms:source "https://en.wikipedia.org/wiki/Stalag_XI-B"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/6411>;
    dcterms:created "2018-07-16T07:44:53.000Z"^^xsd:dateTime;
    skos:prefLabel "Stalag 357"@nl, "Stalag 357"@de, "Stalag 357"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Stalag 357 was een Duits krijgsgevangenkamp in Oerbke, Duitsland, en was bestemd voor Britse en Amerikaanse krijgsgevangenen. Het kamp ontstond in 1944 nadat in maart/april 1942 Stalag XI D/321 werd ontbonden en overgenomen door Stalag XI B Fallingbostel als een \"gedeeltelijk kamp\". In 1944/1945 kwam dat in gebruik als Stalag 357. Op 16 april 1945 werden de gevangenen door Britse troepen bevrijd. "@nl;
    skos:altLabel "Stalag 357 Oerbke"@nl .
  
