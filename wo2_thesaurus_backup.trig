  <https://data.niod.nl/WO2_Thesaurus/events/8154> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:37:36.870Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8142>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/wo2nedindieThema> "Internationale politiek Nederlands-Indië";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://cc.museon.nl/default.aspx#/query/b590a491-c7d6-48dc-8716-3ae22f92b907>;
    <http://schema.org/startDate> "1941-09-19"^^xsd:date;
    dcterms:source "http://mediawiki.arts.kuleuven.be/geschiedenisjapan/index.php?title=Groot_Oost-Aziatische_Welvaartssfeer&oldid=155298"@nl;
    <http://schema.org/description> "Japan wil in Azië een economische invloedssfeer in opbouwen van waaruit het al zijn benodigde grondstoffen kan importeren. Het gebied van de ‘Groot-Oostaziatische Gemeenschappelijke Welvaartsfeer’ omvat de landen Australië, Birma, Brits-Borneo, Brits-Indië, China, de Filippijnen, Frans-Indo-China, Malakka, Nederlands-Indië, Nieuw Zeeland, Thailand en alle eilanden in het westelijke deel van de Grote Oceaan."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/4382>, <https://data.niod.nl/WO2_Thesaurus/corporaties/7706>;
    dcterms:created "2019-03-19T09:02:01.000Z"^^xsd:dateTime;
    skos:prefLabel "Aankondiging ‘Groot-Oostaziatische Welvaartssfeer’"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Aankondiging ‘Groot-Oostaziatische  Welvaartssfeer’ vond plaats op 19 november 1941. Het idee achter de Groot Oost-Aziatische Welvaartssfeer was de vereniging van Oost-Aziatische landen."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8155> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-03-08T14:57:03.921Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8019>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/wo2nedindieThema> "Inval Japan";
    <http://schema.org/location> "Singapore";
    <http://schema.org/startDate> "1940-11-26"^^xsd:date;
    dcterms:source "https://www.atlcom.nl/ap_archive/pdf/AP%202017%20nr.%202/Van%20Wijk.pdf"@nl;
    <http://schema.org/description> "In Singapore maken militaire delegaties van Nederlands-Indië, Engeland, Australië en de Verenigde Staten afspraken over een gezamenlijk optreden bij Japanse agressie in Zuidoost-Azië. Er vinden voordat de oorlog uitbreekt drie stafconferenties plaats. Aan de eerste conferentie nemen alleen Engelse en Nederlandse militaire delegaties deel.  Hierna volgen nog twee stafconferenties respectievelijk op 22 tot 25 februari 1941 en op 21 tot 27 april 1941, waarbij tenslotte alle vier landen deelnemen."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/events/8156>, <https://data.niod.nl/WO2_Thesaurus/events/8157>,
      <https://data.niod.nl/WO2_Thesaurus/events/8158>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2350>, <https://data.niod.nl/WO2_Thesaurus/2629>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/4752>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4613>;
    dcterms:created "2019-03-19T09:28:15.000Z"^^xsd:dateTime;
    skos:prefLabel "Stafconferenties tussen Groot-Brittannië, Nieuw-Zeeland, Australië, Nederland en de Verenigde Staten"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Bij de Stafconferenties tussen Groot-Brittannië, Nieuw-Zeeland, Australië, Nederland en de Verenigde Staten maken militaire delegaties van deze landen in Singapore afspraken over een gezamenlijk optreden bij Japanse agressie in Zuidoost-Azië. Voor het uitbreken van de Pacifische Oorlog vinden er drie stafconferenties plaats. Aan de eerste conferentie nemen alleen Britse en Nederlandse militaire delegaties deel."@nl .
  
