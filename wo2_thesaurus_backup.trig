    dcterms:created "2019-03-01T10:40:11.000Z"^^xsd:dateTime;
    skos:prefLabel "Koning Willem III-kazerne (Apeldoorn)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:exactMatch <https://digitaalerfgoed.poolparty.biz/westerbork/2998>;
    skos:scopeNote "De Willem III-kazerne in Apeldoorn was een kazerne, gevangenis en interneringskamp (bijzondere rechtspleging). Tijdens de Duitse bezetting was het in gebruik als kazerne van de Luftwaffe en als gevangenis voor verzetsdeelnemers. Na de Slag om Arnhem werd de kazerne van 25 september 1944 tot 26 oktober 1944 tot Airborne Military Hospital Apeldoorn omgedoopt. De kazerne was van mei 1945 tot december 1945 in gebruik als interneringskamp. Hier zaten verdachten van en veroordeelden voor collaboratie opgesloten."@nl;
    skos:altLabel "Willem III-kazerne"@nl, "Willem III-kazerne Apeldoorn"@nl, "Willem III kazerne"@nl,
      "Willem 3-kazerne"@nl, "Interneringskamp Willem III kazerne"@nl, "Interneeringskamp Koning Willem III kazerne"@nl,
      "Kamp Willem III Kazerne"@nl, "Kamp Koning Willem III Kazerne"@nl, "Airborne Military Hospital Apeldoorn"@nl;
