    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/events/9348>, <https://data.niod.nl/WO2_Thesaurus/events/7246>,
      <https://data.niod.nl/WO2_Thesaurus/events/9347>, <https://data.niod.nl/WO2_Thesaurus/events/19637>;
