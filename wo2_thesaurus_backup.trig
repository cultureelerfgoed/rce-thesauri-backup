    <http://schema.org/startDate> "1945-02-20"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2682>;
    dcterms:created "2021-02-17T09:48:05.665Z"^^xsd:dateTime;
    skos:prefLabel "Liquidatie van Jan Steketee"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De liquidatie van Jan Steketee vond plaats op 20 februari 1945 in Rotterdam. Steketee was een zwarthandelaar en actief in een grote bende in Rotterdam-Zuid en Noordereiland. Hij verstrekte informatie over de illegaliteit aan de Sicherheitsdienst (SD). Steketee zat op 20 februari vast op het politiebureau Sandelingplein en zou overgebracht worden naar de Aussenstelle. Bij het verlaten van het politiebureau werd hij door een KP'er doodgeschoten."@nl .
  
