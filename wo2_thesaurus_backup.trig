    skos:broader <https://data.niod.nl/WO2_Thesaurus/1699>, <https://data.niod.nl/WO2_Thesaurus/19101>;
    dcterms:created "2024-09-12T12:17:56.554Z"^^xsd:dateTime;
    skos:prefLabel "Ranau"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Ranau was een krijgsgevangenkamp in de bergen bij de plaats Ranau tussen de plaatsen Jesselton (westkust) en Sandakan (oostkust) op Borneo. Begin 1945 vonden dodenmarsen plaats vanuit kamp Sandakan naar kamp Ranau. Van de groep die Ranau wist te bereiken zijn bijna alle krijgsgevangenen overleden aan ziekte of executie. Zes krijgsgevangenen wisten te ontsnappen."@nl;
    skos:altLabel "Borneo 2D"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/21331> a <http://schema.org/Thing>, skos:Concept,
