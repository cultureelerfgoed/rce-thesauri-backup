    <http://schema.org/startDate> "1938-09-29"^^xsd:date;
    <http://schema.org/endDate> "1938-09-30"^^xsd:date;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2947>, <https://data.niod.nl/WO2_Thesaurus/2629>;
    dcterms:created "2020-04-23T07:07:00.000Z"^^xsd:dateTime;
    skos:prefLabel "Conferentie van München"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Op de Conferentie van München (29-30 september 1938) bespraken Hitler, Mussolini, Chamberlain (Engeland) en Daladier (Frankrijk) de internationale situatie naar aanleiding van de Duitse claims op Sudeten-Duitse gebieden in Tsjechoslowakije. In het Verdrag van München, afgesloten op 30 september, werden de Sudeten-Duitse gebieden aan Duitsland afgestaan en een Duits-Engels niet-aanvalsverdrag afgesloten. Hitler verzekerde dat met de verwerving van Sudeten-Duitsland zijn laatste territoriale eis was vervuld. De Engelse ministerpresident Chamberlain sprak bij zijn terugkeer in Engeland van 'peace for our time'."@nl;
    skos:altLabel "Akkoorden van München"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event>;
    skos:notation "Conferentie van München (29-30 september 1938)" .
  
