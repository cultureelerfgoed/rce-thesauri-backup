      "https://nl.wikipedia.org/w/index.php?title=Speciaal:Citeren&page=Secretaris-generaal_van_een_Nederlands_ministerie&id=47135519"@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/demoadmin>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/20646>;
    dcterms:created "2016-08-12T14:35:43.000Z"^^xsd:dateTime;
    skos:prefLabel "Generalsekretär"@de, "Secretary-General"@en, "Secretarissen-generaal"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Een secretaris-generaal van een Nederlands ministerie is de hoogste ambtenaar van een Nederlands ministerie. Tijdens de Tweede Wereldoorlog hadden de secretarissen-generaal een bijzondere positie door de afwezigheid van koningin en ministers. De secretarissen-generaal behielden de leiding over hun departement maar waren verantwoording schuldig aan het Duits bestuur in Nederland (Arthur Seyss-Inquart)."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/3468> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-02-23T10:55:52.652Z"^^xsd:dateTime, "2026-02-23T10:55:52.878Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/250x250/923c6113-90c2-523e-8d68-03908912a6d6.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://beeldbankwo2.nl/nl/beelden/detail/d3d20060-0259-11e7-904b-d89d6717b464/media/923c6113-90c2-523e-8d68-03908912a6d6";
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Eugenetica&oldid=46793928"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/demoadmin>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/1912>, <https://data.niod.nl/WO2_Thesaurus/2404>,
      <https://data.niod.nl/WO2_Thesaurus/9079>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1977>, <https://data.niod.nl/WO2_Thesaurus/1906>;
    dcterms:created "2016-08-15T11:53:27.000Z"^^xsd:dateTime;
    skos:prefLabel "Eugenik"@de, "Eugenics"@en, "Eugenetica"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Eugenetica is het pseudowetenschappelijke onderzoek naar het verbeteren van de genetische samenstelling van een (menselijke) populatie. Eugenetica vormde de basis voor verschillende discriminerende en racistische wetten, zoals huwelijksverboden, segregatie, gedwongen sterilisatie en genocide op sociaal ongewensten, etnische bevolkingsgroepen en mensen met een beperking."@nl;
    skos:altLabel "Eugenetiek"@nl;
    skos:definition "Eugenetica is het pseudowetenschappelijke onderzoek naar het verbeteren en veredelen van de genetische samenstelling van een (menselijke) populatie. De term werd in 1883 geïntroduceerd door Francis Galton. In de 20ste eeuw vormde eugenetica in verschillende landen de basis voor discriminerende en racistische wetten die in uiterste gevallen leidden tot huwelijksverboden, segregatie, gedwongen sterilisatie en genocide op bepaalde groepen sociaal ongewensten, etnische bevolkingsgroepen en mensen met een beperking. Na de Tweede Wereldoorlog werd eugenetica steeds vaker als mensonterend gezien."@nl .
  
