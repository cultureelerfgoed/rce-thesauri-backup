    dcterms:created "2020-09-23T06:34:57.000Z"^^xsd:dateTime;
    skos:prefLabel "Kamp Oranienburg in gebruik genomen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Kamp Oranienburg werd op 21 maart 1933 in gebruik genomen. Het behoorde daarmee tot een van de eerste nazi-concentratiekampen. De gevangenen in het eerste jaar waren vooral communisten, sociaal-democraten en andere politieke tegenstanders van de nazi's."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
