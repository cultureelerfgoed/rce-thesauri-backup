  <https://data.niod.nl/WO2_Thesaurus/corporaties/8519> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "Nota van de PRA ’s-Gravenhage over Deutsche Schutzgruppe, ongedateerd, in archief 49-0182 Deutsche Schutzgruppe (NIOD)"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2024-08-12T12:03:08.851Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1941-06-01"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/8817a660-7962-905c-d906-5d823093a682.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/960509c0-025a-11e7-904b-d89d6717b464/media/8817a660-7962-905c-d906-5d823093a682";
    dcterms:source "https://www.archieven.nl/nl/zoeken?mizig=210&miadt=298&miaet=1&micode=001&minr=958598&miview=inv2"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-06"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Deutsche Schutzgruppe diende als hulptroepen van de Wehrmacht, het Duitse leger. De Deutsche Schutzgruppe werd in 1941 opgericht met het doel om infrastructuur en overheidsgebouwen in bezet Nederland te bewaken tijdens opstanden of stakingen. De Deutsche Schutzgruppe bestond uit Duitse burgers die in Nederland woonden en die verplicht enkele uren of dagen per week een militaire dienst vervulden."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2714>, <https://data.niod.nl/WO2_Thesaurus/1854>,
      <https://data.niod.nl/WO2_Thesaurus/20719>;
    dcterms:created "2019-05-15T18:59:24.000Z"^^xsd:dateTime;
    skos:prefLabel "Deutsche Schutzgruppe"@nl, "'Deutsche Schutztruppe'"@en, "Deutsche Schutzgruppe"@de;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Deutsche Schutzgruppe werd in het voorjaar van 1941 opgericht om als hulptroeppen van de Wehrmacht bij oproer en stakingen te kunnen worden ingezet voor de bewaking van gebouwen, bruggen, stations, spoorlijnen, haven en andere belangrijke objecten. Oorspronkelijk maakten alle Duitsers van 18 tot 65 jaar, die niet in militaire dienst waren en voor 10 mei 1940 in Nederland woonden, verplicht deel uit van deze organisatie. Vanaf 1943 moesten ook alle Duitsers die na mei 1940 naar Nederland gekomen waren en geen militaire dienst vervulden, verplicht aan de militaire oefeningen van de Schutzgruppe deelnemen. Na de invasie in Normandië op 6 juni 1944 werd de Schutzgruppe (met uitzondering van NSDAP-functionarissen en degenen die voor een ‘Kriegswichtig’ bedrijf werkten) opgeroepen voor bewakingsdoeleinden. De manschappen kwamen toen daadwerkelijk in militaire dienst en hadden dezelfde plichten en rechten als alle militairen van de Duitse krijgsmacht. "@nl;
    skos:altLabel "Schutzgruppe"@nl, "Deutschen Schutzgruppen aus Reichsdeutschen in den Niederlanden"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
