    skos:prefLabel "Bezetter aan de Maliebaan"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "De Bezetter had zich aan de Maliebaan op verschillende adressen gevestigd. Zo zat in de Utrechtse straat de NSB, de Ordnungspolizei, de Wehrmacht, SiPo, SS en de redactie van het blad 'Volk en Vaderland'.  "@nl;
    skos:altLabel "Bezetting aan de Maliebaan"@nl .
  
