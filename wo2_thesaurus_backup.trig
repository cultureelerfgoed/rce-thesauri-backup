    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Het Opvoedersgilde was de opvoed- en onderwijsorganisatie van de Nationaal-Socialistische Beweging (NSB). Het Opvoedersgilde werd opgericht in september 1940. Het doel was de beroepsgroepen die betrokken waren bij opvoeding en onderwijs naar nationaalsocialistisch model te hervormen. Het Opvoedersgilde beoordeelde de politieke betrouwbaarheid van docenten en behandelde klachten over slechte behandeling van NSB-leerlingen. Ook gaf het gilde het maandblad Opvoeden in Volkschen Geest uit."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2244>, <https://data.niod.nl/WO2_Thesaurus/2916>;
    dcterms:created "2016-10-04T13:07:41.000Z"^^xsd:dateTime;
    skos:prefLabel "'Opvoedersgilde'"@de, "'Opvoedersgilde'"@en, "Opvoedersgilde"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Opvoedersgilde was een NSB-organisatie die op 21 september 1940 werd opgericht. Het gilde streefde naar de herziening van opvoeding en onderwijs in nationaalsocialistische zin en de vereniging van alle volksgenoten die beroepsmatig betrokken waren bij de opvoeding van en het onderwijs aan de ‘Dietsche jeugd’. Het Opvoedersgilde gaf het maandblad Opvoeding in Volkschen Geest uit. De werkzaamheden van zijn afdelingen en plaatselijke groepen bestond voornamelijk uit organisatorische aangelegenheden, terwijl de invloed van de Opvoedersgilde buiten de eigen kring zeer gering was."@nl;
    skos:altLabel "Opvoeders Gilde"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Organization> .
  
