    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbank.nimh.nl/foto-s/detail/31e703bc-7c0e-47f8-6e5c-a09ae9f733b8/media/d1f6478f-60be-67f7-48fb-e40e1c960954";
    <http://schema.org/startDate> "1944-08-19"^^xsd:date;
    dcterms:source "https://www.verliesregister.studiegroepluchtoorlog.nl/ahome/lossregister/results?sglo=T3941A"@de;
    <https://data.niod.nl/eventsWO2/toLocation> <https://data.niod.nl/WO2_Thesaurus/locations/19581>;
