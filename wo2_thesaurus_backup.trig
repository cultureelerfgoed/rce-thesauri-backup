    skos:prefLabel "Courage"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Courage was een verzetsblad dat vanaf september 1944 tot 5 mei 1945 in een oplage van 300 stuks dagelijks verscheen in Loosdrecht. Het bestond uit uitgetypte berichten uit Groot-Britannië."@nl .
  
