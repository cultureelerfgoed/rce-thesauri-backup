    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2190>, <https://data.niod.nl/WO2_Thesaurus/2210>;
    dcterms:created "2021-10-19T12:47:44.936Z"^^xsd:dateTime;
    skos:prefLabel "Mijnbouwbedrijf Oranje-Nassau"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Oranje-Nassau was een particulier mijnbouwbedrijf in Zuid-Limburg voor de winning van steenkool. Het was het grootste particuliere mijnbedrijf in Nederland. Het was operationeel tussen 1899 en 1974. Drie mijnen waren gevestigd nabij Heerlen (Oranje-Nassau I, III en IV) en een in Schaesberg (Oranje-Nassau II)."@nl;
    skos:altLabel "Steenkolenmijn Oranje-Nassau"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/17730> .
  
