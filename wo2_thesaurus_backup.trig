    <http://schema.org/startDate> "1942-06-09"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Korps_Insulinde&oldid=52295539"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/7746>, <https://data.niod.nl/WO2_Thesaurus/events/8185>;
