    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/wiki/File:Wietzendorf_Gedenkstein_Stalag_XD_02.jpg";
    dcterms:source "https://www.tracesofwar.nl/sights/16121/Kampbegraafplaats-Stalag-XD-310.htm"@nl,
      "https://www.ww2aerialreconstudies.com/stalag-x-d-310.html"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
