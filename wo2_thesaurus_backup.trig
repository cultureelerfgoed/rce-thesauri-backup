    <https://data.niod.nl/organizationsWO2/startDate> "1938-04-18"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/ams/thumb/350x350/32a6101b-089e-6e4b-1a29-f788f1977784.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://archief.amsterdam/beeldbank/detail/ff934af5-a88a-e1f5-655e-7705aedb32ad";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/2b53ff78-025a-11e7-904b-d89d6717b464/media/bf7e29df-1714-a54e-05c0-f565fc05c51b>;
    dcterms:source "https://socialhistory.org/bwsa/biografie/kies"@nl, "https://nl.wikipedia.org/w/index.php?title=Troelstra_Beweging_Nederland&oldid=41260127"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1941-06-27"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Troelstra Beweging Nederland (TBN) was een socialistische politieke partij onder leiding van Paul Kiès. Kiès richtte de TBN in 1938 op en koos tijdens de Duitse bezetting van Nederland voor collaboratie met de Duitsers. Op 27 juli 1941 ging de TBN op in de Nationaal-Socialistische Nederlandsche Arbeiderspartij-Van Rappard (NSNAP-Van Rappard)."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2506>;
    dcterms:created "2019-02-13T14:36:04.000Z"^^xsd:dateTime;
    skos:prefLabel "Troelstra Beweging Nederland"@nl, "Troelstra Beweging Nederland"@de,
      "Troelstra Beweging Nederland"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Troelstra Beweging Nederland (TBN) was een voornamelijk in Friesland actieve politieke partij onder leiding van voormalig SDAP’er Paul Kiès. In tegenstelling tot de overgrote meerderheid van de leden koos Kiès na de Duitse inval wel voor collaboratie. De opname van de TNB in de NSNAP-Van Rappard in het voorjaar van 1941 werd bekrachtigd op een gemeenschappelijke bijeenkomst van beide partijen op 27 juni 1941."@nl;
    skos:altLabel "Troelstra Beweging"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
