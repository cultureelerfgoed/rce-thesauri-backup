    dcterms:created "2021-03-15T12:45:14.617Z"^^xsd:dateTime;
    skos:prefLabel "Vliegveld Bergen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "Vliegveld Bergen was een van oorsprong Nederlands militair vliegveld. Door de Duitsers werd het vliegveld uitgebreid. Op Bergen waren jachtvliegtuigen en nachtjagers van de Luftwaffe gestationeerd. In juni 1944 werd het vliegveld door de Duitsers onklaar gemaakt. Begin mei 1945 werd het vliegveld in het kader van Operation Chowhound gebruikt als droppingsterrein voor voedselpakketten."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2110>, <https://data.niod.nl/WO2_Thesaurus/events/11165> .
  
