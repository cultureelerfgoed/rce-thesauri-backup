    <http://schema.org/location> "Deventer";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/87bfc29c-025a-11e7-904b-d89d6717b464/media/748d491f-1914-d7c1-e4c5-c87aa3394212>,
