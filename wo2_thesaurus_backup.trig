    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://www.beeldbank.noord-hollandsarchief.nl/memorix/2b46a69e-fb8f-11df-9e4d-523bc2e286e2";
    <http://schema.org/location> "Middellandse Zee";
    <http://schema.org/startDate> "1942-06-14"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3511>;
    dcterms:created "2021-09-29T11:13:24.484Z"^^xsd:dateTime;
    skos:prefLabel "Scheepsramp Tanimbar"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Scheepsramp met de Tanimbar vond plaats op 14 juni 1942. De Tanimbar was een Nederlands schip van de Stoomvaart Maatschappij Nederland dat onderdeel werd van Operatie Harpoon. In de nacht van 11 op 12 juni 1942 vertrok het konvooi vanaf Gibraltar richting Malta, maar werd vrijwel de gehele reis geteisterd door Italiaanse luchtaanvallen. Op 14 juni werd het schip fataal geraakt en tot zinken gebracht. 22 bemanningsleden kwamen om en negen raakten gewond. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/1870> .
  
  <https://data.niod.nl/WO2_Thesaurus/17665> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Bezemer, K.W.L.  Geschiedenis van de Nederlandse koopvaardij in de Tweede Wereldoorlog / Dl. 1 en dl. 2. Tweede druk. Amsterdam: Elsevier, 1987. "@nl;
