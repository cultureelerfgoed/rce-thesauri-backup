    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/6/68/Bundesarchiv_Bild_121-0316%2C_Krakau%2C_Gef%C3%A4ngnis_Montelupich%2C_H%C3%A4ftling.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://en.wikipedia.org/wiki/Montelupich_Prison#/media/File:Bundesarchiv_Bild_121-0316,_Krakau,_Gef%C3%A4ngnis_Montelupich,_H%C3%A4ftling.jpg"@nl;
    dcterms:source "https://www.tracesofwar.nl/sights/22032/Montelupich-Gevangenis-Krakau.htm"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1686>, <https://data.niod.nl/WO2_Thesaurus/locations/17045>;
    dcterms:created "2020-07-23T11:09:03.000Z"^^xsd:dateTime;
    skos:prefLabel "Gevangenis Montelupich"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Montelupich Gevangenis in Krakau stond tussen 1940 en 1944 onder supervisie van de Gestapo. In deze periode werden hier 50.000 mensen gevangen gehouden. Na de oorlog viel de gevangenis in handen van de Sovjet-Unie en werden hier 40 doodsvonnissen van oorlogsmisdadigers uitgevoerd."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    skos:definition "De Montelupich Gevangenis in Krakau stond tussen 1940 en 1944 onder supervisie van de Gestapo. In deze periode werden hier 50.000 mensen gevangen gehouden, waarvan veel mensen naar Auschwitz-Birkenau en Plaszow werden gedeporteerd. Daarnaast vonden er op grote schaal executies en martelingen plaats. Na de oorlog viel de gevangenis in handen van het NKVD, het Volkscommissariaat voor Binnenlandse Zaken van de Sovjet-Unie. Na het eerste Auschwitz-proces werden hier 40 doodsvonnissen van oorlogsmisdadigers uitgevoerd."@nl .
  
