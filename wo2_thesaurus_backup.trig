    <http://schema.org/startDate> "1945-05-08"^^xsd:date;
    dcterms:source "https://museumvlaardingen.nl/bevrijding"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/6983>;
    dcterms:created "2021-06-16T12:18:18.412Z"^^xsd:dateTime;
    skos:prefLabel "Bevrijding Vlaardingen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De bevrijding van Vlaardingen vond plaats op 8 mei 1945. De eerste geallieerden reden op die dinsdagochtend de stad binnen. Het waren drie ondergedoken Amerikaanse vliegeniers, een Amerikaanse parachutist en zijn chauffeur, een tolk en een Nederlandse Rode Kruisarts. Samen met het verzet Vlaardingen/Westland hadden ze hun leider uit het Oranjehotel bevrijd en daarna volgde een triomftocht door Vlaardingen."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/15306> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
