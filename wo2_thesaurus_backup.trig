    skos:prefLabel "Deppner-executies"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Deppner-executies waren een lange serie van executies van verzetsstrijders in Kamp Vught tussen eind juli en begin september 1944, vanwege de nadering van geallieerde troepen. De executies werden uitgevoerd in opdracht van de SS-officier en SD-functionaris Erich Deppner, die daarvoor nooit is gestraft. Minstens 450 mensen kwamen hierbij om het leven."@nl;
    skos:altLabel "Deppner-executies in Kamp Vught"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
