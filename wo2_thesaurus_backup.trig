    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/8820>;
    dcterms:created "2022-03-22T10:52:37.689Z"^^xsd:dateTime;
    skos:prefLabel "Calmeyer-lijst"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Calmeyer-lijst bestond uit verzoekschriften van Joden om herziening van de registratie als Jood. Deze aanvragen werden ingediend bij het bureau van Hans Calmeyer, hoofd van de Entscheidungsstelle van de Abteilung Innere Verwaltung. Calmeyer behandelde deze verzoeken en heeft van de in totaal 5667 verzoeken 3709 goedgekeurd. Dit leidde voor betrokkenen tot afstel van deportatie."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/18954>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
