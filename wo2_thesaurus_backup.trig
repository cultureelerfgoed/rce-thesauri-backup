    skos:broader <https://data.niod.nl/WO2_Thesaurus/locations/9822>;
    dcterms:created "2019-03-13T11:23:24.000Z"^^xsd:dateTime;
    skos:prefLabel "Kazemat S-84 Doesburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "De Kazemat S-84 te Doesburg behoorde tot de tweede linie achter de Dierensche Hank en de Lamme IJssel. Het type kazemat werd ook wel 'stekelvarken' genoemd en werd bewapend met één lichte mitrailleur. Het maakte deel uit van een grotere linie van kazematten langs de IJssel, die tijdens de Duitse invasie op 10 mei 1940 zwaar onder vuur werden genomen."@nl;
    skos:altLabel "Stekelvarken"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/3563>, <https://data.niod.nl/WO2_Thesaurus/events/7865>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
