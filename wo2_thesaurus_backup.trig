      <https://data.niod.nl/WO2_Thesaurus/8176>;
    dcterms:created "2020-03-19T14:45:20.000Z"^^xsd:dateTime;
    skos:prefLabel "Dresden (Universelle)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote """Aussenlager Dresden (Universelle) was van oktober 1944 tot midden april 1945 een buitenkamp van Flossenbürg gevestigd in de Universelle Maschinenfabrik (Florastrasse 14). De ongeveer 700 gevangenen waren vrouwen afkomstig uit concentratiekamp Ravensbrück, voornamelijk Duitse politieke gevangenen, 'asocialen' en Sinti en Roma die tewerkgesteld werden bij de bouw van regelaars voor vliegtuigmotoren. 
"""@nl;
    skos:altLabel "Aussenlager Dresden (Universelle)"@nl, "Dresden (Universelle Maschinenfabrik)"@nl,
      "Aussenlager Dresden (Universelle Maschinenfabrik)"@nl, "Aussenlager Universelle Maschinenfabrik"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/8830> a <http://schema.org/Thing>, skos:Concept,
