    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/mediabank-horizontal/20feecf1-c335-d734-b36d-4eb4da81ef0e.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/938f3bac-025a-11e7-904b-d89d6717b464/media/20feecf1-c335-d734-b36d-4eb4da81ef0e?mode=detail&view=horizontal&q=openluchtmuseum&rows=1&page=8";
    <http://schema.org/startDate> "1944-09-01"^^xsd:date;
    <http://schema.org/endDate> "1945-01-31"^^xsd:date;
    dcterms:source "https://www.4en5mei.nl/oorlogsmonumenten/monumenten_zoeken/oorlogsmonument/2583"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
