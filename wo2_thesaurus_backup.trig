    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/w/index.php?title=Operatie_Taifun&oldid=55847415#/media/Bestand:Eastern_Front_1941-06_to_1941-12.png"@nl;
    <http://schema.org/startDate> "1941-10-02"^^xsd:date;
    <http://schema.org/endDate> "1942-01-07"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Operatie_Taifun&oldid=55847415"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
