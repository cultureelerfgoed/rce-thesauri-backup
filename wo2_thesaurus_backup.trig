    dcterms:source "https://www.joodsamsterdam.nl/bureau-joodsche-zaken/"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2715>, <https://data.niod.nl/WO2_Thesaurus/20709>;
    dcterms:created "2021-06-10T12:11:05.474Z"^^xsd:dateTime;
    skos:prefLabel "Bureau Joodsche Zaken"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Bureau Joodsche Zaken (Bureau 11) was een eenheid van de Amsterdamse politie en gevestigd op de Nieuwe Doelenstraat 13 in Amsterdam. Vanaf 1928 zat daar het bureau van de Rijkspolitie der Nederlandse Centrale inzake Falsificaten dat zich vóór de oorlog bezighield met het opsporen en arresteren van oplichters. Tijdens de bezetting veranderden de activiteiten van het bureau. Er werden veel meer personen gearresteerd en opgesloten of naar Duitsland overgebracht. Ook was er melding van mishandelingen en dreigementen. Vanaf 1 juni 1942 werd het Bureau Joodsche Zaken officieel opgericht en kreeg Rudolf Wilhelm Dahmen von Buchholz de leiding. Het bureau werd een concurrent van de Colonne Heinnecke toen het ook de woningen van arrestanten begon leeg te halen."@nl;
    skos:altLabel "Bureau Joodse Zaken"@nl, "Bureau 11"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/22054>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
