    <http://schema.org/location> "Den Haag";
    <http://schema.org/startDate> "1969-06-02"^^xsd:date;
    dcterms:source "https://anderetijden.nl/aflevering/551/De-excessennota"@nl;
    skos:relatedMatch <https://data.niod.nl/WO2_Thesaurus/17805>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/8386>;
    dcterms:created "2019-04-24T09:38:36.000Z"^^xsd:dateTime;
    skos:prefLabel "Publicatie Excessennota"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Bij de Publicatie Excessennota op 2 juni 1969, de nota betreffende het archievenonderzoek naar gegevens omtrent het handelen van Nederlandse militairen in de periode 1945-1950 te Indonesië, concludeert de regering dat er ‘stellig […] door Nederlandse militairen handelingen [zijn] gepleegd, die als wandaden moeten worden gebrandmerkt […] maar [de regering] handhaaft haar opvatting, dat de krijgsmacht als geheel zich in Indonesië correct heeft gedragen’. Voor de Zuid-Celebesaffaire wordt een voorbehoud gemaakt."@nl .
  
