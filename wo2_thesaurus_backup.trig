  <https://data.niod.nl/WO2_Thesaurus/17552> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-06-21T13:59:23.752Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/d54125f0-e9b3-01ce-c5f3-ddb69f7451dc.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/023ec428-025b-11e7-904b-d89d6717b464/media/d54125f0-e9b3-01ce-c5f3-ddb69f7451dc";
    dcterms:source "https://kunst-en-cultuur.infonu.nl/geschiedenis/180722-de-vervolging-van-jehovas-getuigen-tijdens-de-oorlog.html"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2543>;
    dcterms:created "2021-09-06T12:37:46.289Z"^^xsd:dateTime;
    skos:prefLabel "Afzweringverklaring"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De afzweringverklaring was de verklaring die gearresteerde Jehova's Getuigen moesten ondertekenen om aan vervolging te ontsnappen. Hiermee verklaarden zij hun geloof tot dwaalleer, maakten ze zich los van de geloofsgemeenschap en beloofden zij hun geloofsgenoten aan te geven. De meesten deden dit niet en werden naar concentratiekampen afgevoerd. De Jehova's Getuigen werden vanaf 1933 door de nazi's vervolgd."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/17553> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-03-02T15:38:15.355Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/17555>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/588324e5-be70-3cf3-734e-d9a5162cc79a.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/c1aed0f6-025a-11e7-904b-d89d6717b464/media/588324e5-be70-3cf3-734e-d9a5162cc79a";
    <http://schema.org/location> "Basel";
    <http://schema.org/startDate> "1934-09-01"^^xsd:date;
    dcterms:source "https://kunst-en-cultuur.infonu.nl/geschiedenis/180722-de-vervolging-van-jehovas-getuigen-tijdens-de-oorlog.html"@nl,
      "https://nl.wikipedia.org/wiki/Verklaring_van_Feiten"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2543>;
    dcterms:created "2021-09-06T13:21:44.506Z"^^xsd:dateTime;
    skos:prefLabel "Telegrammen aan Hitler"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "In september 1934 vond er in Basel een internationaal congres plaats met als thema 'Vreest hen niet'. Onder het publiek bevonden zich 1000 Duitse Jehova's getuigen. In een resolutie verklaarden de aanwezigen dat zij op 7 oktober hun predikingsactiviteit zouden hervatten ondanks het opgelegde verbod van de nazi's. Een exemplaar van de resolutie ging naar de Zwitserse pers en naar Hitler. Op 8 en 9 oktober stuurden Jehova's in Europa, de VS en Groot-Brittannië duizenden telegrammen naar de Rijksregering in Berlijn met dezelfde boodschap \"Stop verdere vervolging van Jehova's getuigen; anders zal God u en uw nationale partij vernietigen\". In 1935 verbood Hitler de organisatie van Jehova's getuigen maar de leden gingen ondergronds verder met hun activiteiten of vluchtten naar Nederland."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/17554> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    dcterms:modified "2021-09-07T09:17:33.911Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8020>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/30fbb4fc-0323-e24f-8ea7-073cd65506a8.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/aee23e5a-0259-11e7-904b-d89d6717b464/media/30fbb4fc-0323-e24f-8ea7-073cd65506a8";
    <http://schema.org/location> "Duitsland";
    <http://schema.org/startDate> "1933-04-01"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2543>;
    dcterms:created "2021-09-06T13:42:27.407Z"^^xsd:dateTime;
    skos:prefLabel "Vervolging Jehova's Getuigen in nazi-Duitsland"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "In april 1933 begon de vervolging van Jehova's Getuigen in nazi-Duitsland. De Jehova's weigerden in het leger te dienen, volksliederen te zingen en de Hitlergroet te brengen. Ook weigerden ze in de oorlogsindustrie te werken."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
