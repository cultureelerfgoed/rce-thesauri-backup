    skos:prefLabel "Gemeenschap Oud Illegale Werkers Nederland"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote """In de Gemeenschap Oud-Illegale Werkers Nederland, opgericht op 1 oktober 1944 in het bevrijde Zuiden van Nederland en opgeheven in 1950, waren voormalige verzetsgroepen vertegenwoordigd. De Gemeenschap hield zich onder meer bezig met de zuivering, met politieke delinquenten en met de positie van Nederlandse militairen na de oorlog. Vertegenwoordigers van de Gemeenschap Oud-Illegale Werkers Nederland waren opgenomen in het dagelijks bestuur van de Groote Advies-Commissie der Illegaliteit.
        
        """@nl;
    skos:altLabel "G.O.I.W.N."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
