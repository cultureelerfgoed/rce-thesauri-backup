      <https://beeldbankwo2.nl/nl/beelden/detail/245cd92e-025a-11e7-904b-d89d6717b464/media/158cdd5b-868c-9a34-08a4-7383ffb746b1>;
    <http://schema.org/startDate> "1944-09-17"^^xsd:date;
    <http://schema.org/endDate> "1944-09-18"^^xsd:date;
    dcterms:source "https://www.limburger.nl/cnt/dmf20190829_00120460"@nl;
    <http://schema.org/name> "Heerlen";
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/6983>;
    dcterms:created "2018-10-18T11:41:26.000Z"^^xsd:dateTime;
    skos:prefLabel "Befreiung von Heerlen"@de, "Liberation of Heerlen"@en, "Bevrijding Heerlen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De bevrijding van Heerlen vond plaats op 17 en 18 september 1944. De bevrijding van Limburg begon op 12 september met de inname van Mesch door de Amerikanen. Een verkenningspatrouille werd vooruit gestuurd naar Heerlen en meldde dat er geen Duitsers meer leken te zijn. Maar op 17 september verschenen er weer Duitse soldaten in Heerlen. Op 18 september wisten de Amerikanen heel Heerlen te bevrijden. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
