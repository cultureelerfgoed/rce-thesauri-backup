    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/808f9ac6-b036-5a4c-6cbe-be65e6a7b7c6.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/3154d5d2-025a-11e7-904b-d89d6717b464/media/808f9ac6-b036-5a4c-6cbe-be65e6a7b7c6";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/e88282be-0259-11e7-904b-d89d6717b464/media/6808e292-2f05-a5c1-d114-48c62f9b74b1>,
      <https://beeldbankwo2.nl/nl/beelden/detail/cc60679e-025a-11e7-904b-d89d6717b464/media/d308bf6d-e335-014b-483f-6fb3fc9de4e9>,
      <https://beeldbankwo2.nl/nl/beelden/detail/3150d8c4-025a-11e7-904b-d89d6717b464/media/5474a7df-eda1-be3e-c5f2-70f8695cbc70>;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Nationaal-Socialistische_Nederlandsche_Arbeiderspartij&oldid=46795519"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1941-12-14"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Nationaal-Socialistische Nederlandsche Arbeiderspartij-Van Rappard (NSNAP-Van Rappard) was een nationaalsocialistische politieke partij die in 1932 werd opgericht door Ernst Herman ridder van Rappard. De NSNAP-Van Rappard ontstond na het uiteenvallen van de Nationaal-Socialistische Nederlandsche Arbeiderspartij (NSNAP). In 1941 werd de partij op Duits bevel opgenomen in de Nationaal-Socialistische Beweging (NSB)."@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/19556>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4620>, <https://data.niod.nl/WO2_Thesaurus/20640>;
    dcterms:created "2018-01-18T19:06:29.000Z"^^xsd:dateTime;
    skos:prefLabel "N.S.N.A.P.-Van Rappard"@nl, "'NSNAP Van Rappard'"@de, "'NSNAP Van Rappard'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Nationaal-Socialistische Nederlandsche Arbeiderspartij (NSNAP) van Ernst Herman ridder van Rappard bestond van 1932 tot eind 1941. De nazipartij streefde naar het opgaan van Nederland in het Duitse Rijk en noemde zich enige tijd NSNAP-Hitler-beweging, totdat Hitler dit verbood. De weinig succesvolle NSNAP-Van Rappard werd in 1939 ontbonden, maar heropgericht na de Duitse inval. In zomer van 1941 telde zij 15.000 leden. Op bevel van de Duitse autoriteiten ging de NSNAP-Van Rappard in december van dat jaar op in de NSB die de enig toegestane politieke partij werd."@nl;
    skos:altLabel "NSNAP Van Rappard"@nl, "NSNAP Hitlerbeweging"@nl, "Nationaal-Socialistische Nederlandsche Arbeiderspartij Van Rappard"@nl,
      "Rappard-partij"@nl, "Rappart-partij"@nl, "Van Rappard-partij"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
