    dcterms:created "2019-03-07T14:02:19.000Z"^^xsd:dateTime;
    skos:prefLabel "Politieofficiersopleiding"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Politieofficiersopleiding werd in juni 1942 opgericht en vestigde zich aanvankelijk in het Depot van de Koninklijke Marechaussee, de latere Van Haeftenkazerne in Apeldoorn en in juni 1943 verhuisde de school naar het Apeldoornsche Bosch. De opleiding vormde samen met het Politie-Opleidingsbataljon (P.O.B.) in Schalkhaar de twee politieopleidingscentra tijdens de bezetting en paste binnen de plannen van Hanns Albin Rauter om de Nederlandse politie te nazificeren.  "@nl;
    skos:altLabel "Politie Officiers School "@nl, "Politieofficiersschool"@nl .
  
