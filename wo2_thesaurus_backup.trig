    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://en.wikipedia.org/wiki/Stalag_VII-A#/media/File:StalagVII-A_idtag.jpg";
    dcterms:source "https://en.wikipedia.org/wiki/Stalag_VII-A"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/6411>;
    dcterms:created "2018-02-20T09:07:45.000Z"^^xsd:dateTime;
    skos:prefLabel "Stalag VII-A"@nl, "Stalag VII-A"@de, "Stalag VII-A"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Stalag VII-A ten noorden van Moosburg in Beieren was het grootste krijgsgevangenkamp tijdens de Tweede Wereldoorlog. In september 1939 opende het kamp dat was ontworpen om tot 10.000 Poolse gevangenen te huisvesten. Het was ook een doorgangskamp waar gevangenen uit alle naties die tegen Duitsland vochten doorheen kwamen. Op 29 april 1945 werd het kamp door de Amerikanen bevrijd. Er bevonden zich toen 76.248 gevangenen in het hoofdkamp en ruim 40.000 in de Arbeitskommando's. Er stierven ongeveer 1000 gevangenen in het kamp waarvan meer dan 800 Russen. Na de bevrijding werd het een civiel interneringskamp voor Duitse mannen en vrouwen."@nl;
    skos:altLabel "Moosburg"@nl, "Stalag VII A"@nl, "Stalag VII-A Moosburg"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/5985> a <http://schema.org/Thing>, skos:Concept,
