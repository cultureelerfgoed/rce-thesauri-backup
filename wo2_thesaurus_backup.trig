    skos:prefLabel "Maliebaan (Utrecht)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "De Maliebaan is een kilometerlange straat in de stad Utrecht, net buiten de singels. Verschillende verzetspartijen, maar ook Duitsgezinde instanties zaten in deze Utrechtse straat - kriskras door elkaar - gevestigd. "@nl .
  
