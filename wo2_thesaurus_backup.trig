    skos:prefLabel "Gauleiter"@nl, "Gauleiter"@de, "Gauleiter"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Gauleiter (gouwleiders) waren de hoogste partijfunctionarissen van de NSDAP in een provincie of landstreek (Gau). Zij vielen rechtstreeks onder Hitler. Vanaf september 1939 bekleedden de Gauleiter tevens de functie van Reichsverteidigungskommissar in hun Gau. Ook Nederlandse nationaalsocialistische organisaties hanteerden soms de term gouwleider."@nl;
    skos:altLabel "Gouwleiders"@nl, "Gouwleider"@nl .
  
