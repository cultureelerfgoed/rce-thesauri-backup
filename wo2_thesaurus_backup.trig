    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/wiki/File:Crematorium_IV.jpg";
    <http://schema.org/startDate> "1943-03-22"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/18491>;
    dcterms:created "2021-12-20T10:43:55.034Z"^^xsd:dateTime;
    skos:prefLabel "Ingebruikname Crematorium IV"@nl, "Inbetriebnahme Krematiorium IV"@de,
      "Installation Crematorium IV"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "De ingebruikname van Crematorium IV in Birkenau vond plaats op 22 maart 1943. De bouw begon in november 1942. Het crematorium stond dicht bij Kanada III, de plaats waar goederen van gevangenen werden uitgezocht. Hier begon op 7 oktober 1944 de opstand van het Sonderkommando. De Sonderkommando's slaagden erin om crematorium IV in brand te steken en schakelden het daardoor uit."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/18502> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:04:37.092Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/18513>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/d7e422d7-cb7a-9b99-8e1d-b2eea8ecc191.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/b759b5f8-025a-11e7-904b-d89d6717b464/media/d7e422d7-cb7a-9b99-8e1d-b2eea8ecc191";
    <http://schema.org/startDate> "1942-03-17"^^xsd:date;
    dcterms:source "https://oorlogsslachtoffersijmond.nl/categorie/57/beverwijk-kibboets-1939-42"@nl,
      "https://jck.nl/nl/page/beverwijk"@nl;
    skos:relatedMatch <https://data.niod.nl/WO2_Thesaurus/corporaties/4815>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/18500>;
    dcterms:created "2021-12-20T11:27:03.285Z"^^xsd:dateTime;
    skos:prefLabel "Ontruiming kibboets Beverwijk"@nl, "Räumung Kibbuz Beverwijk"@de,
      "Eviction Kibbutz Beverwijk"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "In maart 1942 kregen de Joden van Beverwijk het bevel naar Amsterdam te verhuizen. Vanuit Amsterdam werden ze naar Kamp Westerbork en de concentratiekampen in Oost-Europa gedeporteerd. De bewoners van de kibboets Beverwijk werden naar de kibboets in Laag-Keppel gestuurd, maar sommigen doken onder of wisten aansluiting te vinden bij de Dutch-Paris ontsnappingslijn. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/18503> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Kibboets Beverwijk. Palestina-pioniers in Velsen-Noord en Beverwijk, Saskia Sluiter, De Vrijstaat Roetz 2019"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:05:08.347Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/18504>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/53687300-601f-88ae-5c89-40ee4208bec2.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/cb71a668-025a-11e7-904b-d89d6717b464/media/53687300-601f-88ae-5c89-40ee4208bec2";
    <http://schema.org/startDate> "1935-01-01"^^xsd:date;
    <http://schema.org/endDate> "1941-11-21"^^xsd:date;
    dcterms:source "https://nos.nl/artikel/2335884-unieke-filmbeelden-geven-kijkje-in-kibboets-van-franeker-eind-jaren-30"@nl,
      "https://historischcentrumfraneker.nl/films/franeker-1937-1939-de-franeker-kibboets/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/18515>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1892>;
    dcterms:created "2021-12-20T12:30:13.551Z"^^xsd:dateTime;
    skos:prefLabel "Kibboets Franeker"@nl, "Kibbuz Franeker"@de, "Kibbutz Franeker"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De kibboets in Franeker was een Joodse landbouwschool die door Dath Waärets in 1935 was gesticht. De kibboets Beverwijk was van dezelfde vereniging. Jonge zionisten werden hier voorbereid op emigratie naar Palestina. De kibboets was gevestigd in het voormalige stationsgebouw aan de Harlingerweg 45. De landbouwopleiding duurde een tot twee jaar en leverde een Palestinacertificaat op. In de hele periode van 1935-1941 verbleven er zo'n tachtig studenten in de kibboets. Bijna de helft van de bewoners is naar Palestina geëmigreerd. Op 21 november 1941 vielen de Duitsers samen met de Franeker politie de kibboets binnen en arresteerden de aanwezige bewoners voor het hamsteren van voorraden. Dit was het einde van de kibboets Franeker."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/18505> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Kibboets Beverwijk. Palestina-pioniers in Velsen-Noord en Beverwijk, Saskia Sluiter, De Vrijstaat Roetz 2019"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:04:10.939Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/14651>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/9/9a/Overzicht_-_Laag-Keppel_-_20128414_-_RCE.jpg/500px-Overzicht_-_Laag-Keppel_-_20128414_-_RCE.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/wiki/File:Overzicht_-_Laag-Keppel_-_20128414_-_RCE.jpg";
    <http://schema.org/startDate> "1941-01-01"^^xsd:date;
    <http://schema.org/endDate> "1943-03-29"^^xsd:date;
    dcterms:source "https://hummelo.nl/geschiedenis-hummelo/rondom-de-hessenweg/634-joodse-geschiedenis-hummelo-en-keppel-rdh079-24-2-2009.html"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/18514>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1892>;
    dcterms:created "2021-12-20T13:14:16.337Z"^^xsd:dateTime;
    skos:prefLabel "Kibboets Laag-Keppel"@nl, "Kibbuz Laag-Keppel"@de, "Kibbutz Laag-Keppel"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De kibboets in Laag-Keppel was van 1941 tot in maart 1943 in gebruik. Het was een Hachsjara-centrum waar Palestina-pioniers werden opgeleid en voorbereid op emigratie naar Palestina. Er woonden ongeveer veertig pioniers die op bevel van de Duitse bezetter uit de kustgebieden moesten vertrekken. In 1942 kwamen hier ook een aantal pioniers uit de kibboets Beverwijk terecht. De kibboets was gevestigd in een woonhuis aan de Rijksweg. Vanaf juni 1942 werden de burgemeesters in de provincie Gelderland aangeschreven om lijsten met Joodse inwoners samen te stellen. De beschikking van 29 maart 1943 leidde uiteindelijk tot gedwongen evacuatie van de bewoners van de Kiboets naar Kamp Vught. Vanuit Vught werden ze via Kamp Westerbork naar vernietigtingskampen zoals Sobibor en Auschwitz getransporteerd."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/18506> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Kibboets Beverwijk. Palestina-pioniers in Velsen-Noord en Beverwijk, Saskia Sluiter, De Vrijstaat Roetz 2019"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    dcterms:modified "2025-08-13T09:27:00.124Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/18509>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/3/31/Stolpersteine_Gouda_Ridder_van_Catsweg61_geheel.jpg/1280px-Stolpersteine_Gouda_Ridder_van_Catsweg61_geheel.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Catharinahoeve_(Gouda)#/media/Bestand:Stolpersteine_Gouda_Ridder_van_Catsweg61_geheel.jpg";
    <http://schema.org/startDate> "1937-01-01"^^xsd:date;
    <http://schema.org/endDate> "1943-06-01"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/wiki/Catharinahoeve_(Gouda)"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1892>;
    dcterms:created "2021-12-20T13:44:15.544Z"^^xsd:dateTime;
    skos:prefLabel "Kibboets Gouda"@nl, "Kibbuz Gouda"@de, "Kibbutz Gouda"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De kibboets in Gouda was een landbouwopleiding voor Joodse jongeren tussen de vijftien en achttien jaar en gevestigd in boerderij \"Catharinahoeve\". De jeugdfarm werd in 1937 gerealiseerd met een legaat van Catharina van Zon. Daarna viel het onder de verantwoordelijkheid van de Joodse Centrale voor Beroepsopleiding. De groepsleiding was in handen van het Joodse echtpaar Litten. Tijdens het begin van de Duitse bezetting werden de leden van de jeugdfarm vrijgesteld van deportatie. Ze waren onmisbaar voor de voedselproductie. In 1943 dreigde ook voor hen deportatie en de leden gingen in onderduik. Van de 27 leden hebben er 18 de oorlog overleefd. Vanaf 1 juni 1943 werd de kibboets opgeheven. Na de oorlog kreeg de opleiding een herstart maar in 1953 werd de Catharinahoeve verkocht. "@nl;
    skos:altLabel "Joodse Jeugdfarm Catharinahoeve"@nl, "Catharinahoeve"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/18510> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Kibboets Beverwijk. Palestina-pioniers in Velsen-Noord en Beverwijk, Saskia Sluiter, De Vrijstaat Roetz 2019"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:04:28.337Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/18511>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/d/df/Huize_Voorburg_te_Elden.jpg/500px-Huize_Voorburg_te_Elden.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/wiki/File:Huize_Voorburg_te_Elden.jpg";
    <http://schema.org/startDate> "1941-06-01"^^xsd:date;
    <http://schema.org/endDate> "1942-10-03"^^xsd:date;
    dcterms:source "https://www.ipor.nl/2019/10/04/arnhem-herdenkt-vermoorde-palestina-pioniers-bij-huize-voorburg-in-elden/"@nl;
    skos:relatedMatch <https://data.niod.nl/WO2_Thesaurus/13020>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/18512>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1892>;
    dcterms:created "2021-12-20T14:24:39.081Z"^^xsd:dateTime;
    skos:prefLabel "Kibboets Elden"@nl, "Kibbuz Elden"@de, "Kibbutz Elden"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De kibboets in Elden werd in juni 1941 opgericht toen emigratie naar Palestina niet meer mogelijk was. De kibboets was bestemd voor pioniers met een afgeronde hachsjara-opleiding die in het bezit waren van een Palestinacertificaat. De locatie was Huize Voorburg aan de Drielsedijk in Elden dat eigendom was van de vluchtelingenfamilie Kahn uit Duitsland. Op 3 oktober 1942 kwam er een eind aan het bestaan van de kibboets. De ruim 40 bewoners werden door de SS en politie weggevoerd en via Kamp Westerbork naar Bergen-Belsen gedeporteerd. Enkelen overleefden de oorlog omdat ze als ruiljoden door de Duitsers werden uitgewisseld met Duitse krijgsgevangenen. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/18512> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Kibboets Beverwijk. Palestina-pioniers in Velsen-Noord en Beverwijk, Saskia Sluiter, De Vrijstaat Roetz 2019"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
