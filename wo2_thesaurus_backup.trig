    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/695a78ec-025a-11e7-904b-d89d6717b464/media/6c8140ec-6211-468d-f59a-2bc81b362c0e";
    dcterms:source "https://www.joodsamsterdam.nl/loosdrecht/"@nl, "https://www.joodsmonument.nl/nl/page/117620/paviljoen-loosdrechtse-rade"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/isPointofInterest> true;
    skos:relatedMatch <https://data.niod.nl/WO2_Thesaurus/18469>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/locations/17006>;
    dcterms:created "2021-12-06T13:43:42.789Z"^^xsd:dateTime;
    skos:prefLabel "Paviljoen Loosdrechtse Rade"@nl, "Paviljoen Loosdrechtse Rade (Loosdrecht)"@de,
      "Paviljoen Loosdrechtse Rade"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "Het Paviljoen Loosdrechts Rade was eigendom van de Joodse familie Deutsch. De bewoners waren grotendeels jongeren van 16-17 jaar die in het najaar van 1938 vanuit Duitsland en Oostenrijk naar Nederland waren gekomen. De eerste directeur werd Jacov Zurawel uit Israël die in Nederland de zionistische jeugd moest organiseren. Doel was de bewoners voor te bereiden op een leven in Palestina. In 1940 woonden er zeventig mensen in het Paviljoen. In totaal verbleven er 99 mensen waarvan 54 de oorlog overleefden, 28 omkwamen en van de rest het lot niet bekend is."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/1892> .
  
