    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Penitentiaire_Inrichting_Wolvenplein&oldid=50910272"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/11468>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1686>, <https://data.niod.nl/WO2_Thesaurus/locations/9587>;
    dcterms:created "2018-06-19T05:43:23.000Z"^^xsd:dateTime;
    skos:prefLabel "Gevangenis Wolvenplein"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De gevangenis Wolvenplein was vanaf 1856 gevestigd aan het Wolvenplein in Utrecht. Tijdens de Duitse bezetting van Nederland fungeerde deze als Untersuchungs- und Strafgefängnis. Met ruim 500 gevangenen zat de gevangenis ver boven het vooroorlogse maximum van 172 gevangenen. Ook kwamen lijfstraffen en gewelddadige mishandelingen veel voor. Na de bevrijding diende de gevangenis als strafgevangenis voor mensen verdacht van collaboratie."@nl;
    skos:altLabel "Untersuchungs- und Strafgefängnis Wolvenplein"@nl, "Wolvenplein"@nl,
      "Strafgevangenis Wolvenplein"@nl, "Huis van Bewaring Wolvenplein"@nl, "Criminologisch Instituut Wolvenplein"@nl,
      "Penitentiaire Inrichting Wolvenplein"@nl, "Strafgevangenis te Utrecht"@nl, "Strafgevangenis Utrecht"@nl,
      "Strafgevangenis aan het Wolvenplein te Utrecht"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
