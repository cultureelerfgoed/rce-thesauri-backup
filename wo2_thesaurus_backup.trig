    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/15af3a7a-025a-11e7-904b-d89d6717b464/media/69e1bc38-73ff-0bd9-fcde-5d7faff48572";
    <http://schema.org/location> "Hoek van Holland";
    <http://schema.org/startDate> "1940-05-13"^^xsd:date;
    <http://schema.org/endDate> "1940-05-14"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1922>, <https://data.niod.nl/WO2_Thesaurus/2322>;
    dcterms:created "2022-01-05T14:39:44.542Z"^^xsd:dateTime;
    skos:prefLabel "Evacuatie van Hoek van Holland 1940"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Evacuatie van Hoek van Holland van 1940 vond plaats in de nacht van 13 op 14 mei 1940. Zo'n 800 inwoners van de Oude Hoek vluchtten voor de bombardementen en beschietingen door het Duitse leger als gevolg van de aanwezigheid van Engelse speciale troepen in het dorp. Zij trokken in een stoet naar 's-Gravenzande. In de loop van 14 mei vluchtten nog eens circa 2.500 bewoners uit de Nieuwe Hoek naar Naaldwijk en Honselerdijk. Eind mei waren alle evacués teruggkeerd naar Hoek van Holland."@nl .
  
