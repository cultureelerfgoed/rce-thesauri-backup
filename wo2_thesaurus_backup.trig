    dcterms:created "2019-02-27T09:01:34.000Z"^^xsd:dateTime;
    skos:prefLabel "Uitbreiding werkterrein Joodse Raad Amsterdam"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Uitbreiding van het werkterrein van de Joodse Raad Amsterdam vond plaats op 31 oktober 1941 en de Raad kreeg hiermee landelijke dekking, nadat al vanaf juli 1941 een netwerk van provinciale en plaatselijke vertegenwoordigers was opgericht. In onder meer Arnhem en Nijmegen kwamen lokale vestigingen. De taken verschilden, maar bestonden vooral uit het geven van sociale hulp en assistentie."@nl .
  
