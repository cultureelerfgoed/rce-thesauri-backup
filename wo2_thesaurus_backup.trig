    dcterms:references "Onbekende kinderen. De laatste trein uit Westerbork. Daphne Meijer, Amsterdam 2001"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:33:53.165Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/d385475c-caf5-64dd-08f0-c1a8d7cd37ab.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/171e2c22-025a-11e7-904b-d89d6717b464/media/d385475c-caf5-64dd-08f0-c1a8d7cd37ab";
    dcterms:source "https://historiek.net/het-weeshuis-van-kamp-westerbork/22174/"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/18985>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/4869>;
    dcterms:created "2022-05-19T12:49:28.540Z"^^xsd:dateTime;
    skos:prefLabel "Weeshuis Kamp Westerbork"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Het weeshuis in Kamp Westerbork was in barak 35 gevestigd. Naarmate er meer Joodse (onderduik)kinderen zonder ouders naar het kamp kwamen werd barak 35 ingericht met aparte kinderslaapzalen, een spreek- en behandelruimte voor een kinderarts en een eigen keuken. De Joodse familie Birnbaum ontfermde zich over deze Joodse weeskinderen. Als er twijfel over hun identiteit was werden ze geadministreerd als Unbekanntes Kind. De weeskinderen werden in 1943 en 1944 naar de vernietigingskampen gedeporteerd. Uiteindelijk werden de laatste 50 kinderen met de laatste trein uit Westerbork op 13 september 1944 naar Bergen-Belsen gedeporteerd. Slechts één kind overleefde de reis niet. "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/1898> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
