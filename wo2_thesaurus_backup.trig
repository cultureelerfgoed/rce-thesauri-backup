    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>;
    dcterms:created "2019-11-08T14:15:10.000Z"^^xsd:dateTime;
    skos:prefLabel "Het Compas"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het Compas was een verzetsblad dat van juli 1941 tot juni 1942 met een oplage van 100 tot 250 stuks werd uitgegeven in Bussum door de plaatselijk afdeling van de Communistische Partij van Nederland. Het blad was op verzetsblad De Waarheid gebaseerd en nadat de gehele groep was gearresteerd verscheen een voortzetting op de blad onder die titel in Bussum."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8735> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "PPN: 269069879"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2020-09-01T15:16:36.000Z"^^xsd:dateTime;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>, <https://data.niod.nl/WO2_Thesaurus/corporaties/5606>;
    dcterms:created "2019-11-08T14:23:31.000Z"^^xsd:dateTime;
    skos:prefLabel "Het contra signaal; sol iustitiae, illustra nos!"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het illegale blad Het Contra Signaal verscheen in het najaar van 1943 in 's-Gravenhage. Het blad bevatte signalementen van Duitse agenten en gevaarlijke personen, en werd uitgegeven als onderdeel van het werk van de Falsificatie Centrale (FC). Het blad is opgegaan in: Signalementenblad. "@nl .
  
