    dcterms:created "2023-06-19T14:40:56.668Z"^^xsd:dateTime;
    skos:prefLabel "Operatie Bodenplatte"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Operation Bodenplatte was de Duitse codenaam van de grootschalige luchtaanvallen van de Luftwaffe op geallieerde vliegvelden in Nederland, België, Luxemburg en Frankrijk op 1 januari 1945. Hiermee hoopten ze het Duitse Ardennenoffensief te kunnen ondersteunen."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/19681> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    dcterms:modified "2023-08-30T14:12:27.642Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/ec8e7d4d-cd98-e634-fd13-1a7fec01bde1.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/017fd144-025b-11e7-904b-d89d6717b464/media/ec8e7d4d-cd98-e634-fd13-1a7fec01bde1";
    <http://schema.org/startDate> "1940-10-01"^^xsd:date;
    <http://schema.org/endDate> "1942-03-01"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3537>;
    dcterms:created "2023-06-22T08:06:27.473Z"^^xsd:dateTime;
    skos:prefLabel "Bombardementen op militaire doelen in Duitsland"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De bombardementen gericht op militaire en transport doelen in nazi Duitsland door de geallieerden waren precisiebombardementen die 's nachts werden uitgevoerd. In de zomer van 1941 werd geconstateerd dat deze weinig effectief waren, de doelen werden nauwelijks geraakt. Als gevolg hiervan verschoven vanaf maart 1942 de doelwitten van de geallieerde bombardementen in nazi Duitsland naar steden. De bommenwerpers vlogen vanuit Groot-Brittannië over bezet Nederland en werden hier regelmatig neergeschoten."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/19682> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    dcterms:modified "2023-08-30T14:12:12.287Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/ec8e7d4d-cd98-e634-fd13-1a7fec01bde1.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/017fd144-025b-11e7-904b-d89d6717b464/media/ec8e7d4d-cd98-e634-fd13-1a7fec01bde1";
    <http://schema.org/startDate> "1942-03-01"^^xsd:date;
    <http://schema.org/endDate> "1945-05-08"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3537>;
    dcterms:created "2023-06-22T08:06:50.684Z"^^xsd:dateTime;
    skos:prefLabel "Grotere bombardementen op Duitse steden"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De grotere bombardementen op Duitse steden begonnen vanaf maart 1942 nadat Arthur Harris aan het hoofd van Bomber Command kwam. Toen was gebleken dat precisiebombardementen van militaire en transporten doelen onmogelijk waren schakelden de Britten over naar het uitschakelen van het moraal van de Duitse bevolking door Duitse steden te bombarderen. De bommenwerpers vlogen vanuit Groot-Brittannië over bezet Nederland en werden hier regelmatig neergeschoten. Ook werden in Nederland zwaardere bombardementen uitgevoerd, vooral op de Duitse oorlogsindustrie."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/19948> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    dcterms:modified "2023-08-10T12:27:38.240Z"^^xsd:dateTime;
