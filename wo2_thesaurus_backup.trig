    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/59b74d5b-0a04-dc62-3fb2-5584ce39d650.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/08b34cc6-025a-11e7-904b-d89d6717b464/media/59b74d5b-0a04-dc62-3fb2-5584ce39d650";
    <http://schema.org/location> "Straat van Malakka";
    <http://schema.org/startDate> "1944-06-26"^^xsd:date;
    dcterms:source "https://www.japansekrijgsgevangenkampen.nl/Harugiku%20Maru%204.htm"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3511>, <https://data.niod.nl/WO2_Thesaurus/events/19018>;
    dcterms:created "2021-10-21T12:23:52.711Z"^^xsd:dateTime;
    skos:prefLabel "Scheepsramp Harukiki Maru"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Scheepsramp met de Harukiki Maru, voorheen de Van Waerwijck, vond plaats op 26 juni 1944. De Harukiki Maru was een van oorsprong Nederlands koopvaardijschip (Van Waerwijck) dat door de Japanners was gevorderd na de val van Nederlands-Indië. Het werd hernoemd en als helleschip gebruikt om krijgsgevangenen en romusha's te vervoeren. Op 26 juni 1944 voer het schip langs de oostkust van Sumatra met bijna 1200 Nederlandse, Australische, Britse en Noorse krijgsgevangenen aan boord. Het werd getorpedeerd door een Britse duikboot en tot zinken gebracht. 178 krijgsgevangenen, waarvan 113 Nederlanders overleefden de ramp niet. "@nl;
    skos:altLabel "Scheepsramp Van Waerwijck"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/1870> .
  
  <https://data.niod.nl/WO2_Thesaurus/1779> a <http://schema.org/Thing>, skos:Concept;
