    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/w/index.php?title=File:Gedempte_Doelwater_monument_24_oktober_1944_(2).jpg&oldid=469235776";
    <http://schema.org/startDate> "1944-10-24"^^xsd:date;
    dcterms:source "https://oorlogsgravenstichting.nl/personen/2702/johannes-pieter-jacobus-ameling#images-gallery-1"@nl;
    <https://data.niod.nl/organizationsWO2/isCausedBy> <https://data.niod.nl/WO2_Thesaurus/8568>,
      <https://data.niod.nl/WO2_Thesaurus/events/19061>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/9271>;
    dcterms:created "2022-08-31T09:19:12.116Z"^^xsd:dateTime;
    skos:prefLabel "Fusillade in Rotterdam, 24 oktober 1944"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Fusillade in Rotterdam aan het Doelwater vond plaats op 24 oktober 1944. Op 24 oktober 1944 waren op verschillende plaatsen in Rotterdam schietpartijen ontstaan tussen Duitse militairen, Nederlandse politieagenten en verschillende verzetsgroepen. Ook werd het Hoofdbureau van de politie aan het Haagsche Veer overvallen. Diezelfde avond worden de verzetsdeelnemers Johannes Pieter Jacobus Ameling, Cornelis Diteweg, Pieter Johannes van der Meer en Charles Rudolf van Efferen worden door de Ordnungspolizei als represaille geëxecuteerd aan het Doelwater direct naast het Hoofdbureau van de politie aan het Haagsche Veer."@nl;
    skos:altLabel "Fusillade aan het Doelwater"@nl, "Fusillade aan het Haagsche Veer"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/19061> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Albert Willem Oosthoek, Nieuw licht op liquidaties. Knokploegen Rotterdam 1944-1945 (Soesterberg: Uitgeverij Aspekt: 2015)"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
