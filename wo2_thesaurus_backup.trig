    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/2669>;
    dcterms:created "2017-11-03T19:47:12.000Z"^^xsd:dateTime;
    skos:prefLabel "'Verzetsgroep Deventer, Ter Wolde, Twello, Voorst'"@de, "'Verzetsgroep Deventer, Ter Wolde, Twello, Voorst'"@en,
      "Verzetsgroep Deventer, Ter Wolde, Twello, Voorst"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Deze Verzetsgroep uit Deventer, Ter Wolde, Twello en Voorst hield zich aanvankelijk bezig met het laten onderduiken van mensen die door de Duitsers gezocht werden. Later werden sabotage-activiteiten ontplooid, waarbij de groep door verraad gearresteerd werd. Op 19 november 1942 werd een groot deel van de groep, met leden van de verzetsgroep Oranjevendel uit Zwolle en een communistische verzetsgroep uit Amsterdam (in totaal 33 mensen), op het vliegveld Soesterberg gefusilleerd. "@nl;
    skos:altLabel "Sabotagegroep Twello"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/5617> a <http://schema.org/Thing>,
