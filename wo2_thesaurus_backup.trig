    <http://schema.org/startDate> "1943-05-26"^^xsd:date;
    dcterms:source "https://www.dbnl.org/tekst/pres003onde01_01/pres003onde01_01_0031.php"@nl,
      "https://www.wikidata.org/w/index.php?title=Q63536884&oldid=935035486"@nl;
    <https://data.niod.nl/eventsWO2/toLocation> <https://data.niod.nl/WO2_Thesaurus/kampen/4884>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
