    dcterms:modified "2020-10-09T06:55:24.000Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/640x480/8ef1e402-eabe-b279-c46e-ac52445fd2b0.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/34ed8162-025a-11e7-904b-d89d6717b464/media/8ef1e402-eabe-b279-c46e-ac52445fd2b0"@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/demoadmin>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/events/9629>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1719>;
