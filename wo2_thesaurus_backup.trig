    skos:prefLabel "'Hagespraken'"@de, "'Hagespraken'"@en, "Hagespraken"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Hagespraken zijn jaarlijkse massabijeenkomsten die de NSB op het eigen landgoed rondom de Goudsberg bij Lunteren organiseerde. De benaming 'Hagespraak' refereert aan de gelijknamige bijeenkomsten van zelfstandige Saksische boeren die tot het einde van de Republiek der Zeven Verenigde Nederlanden in 1795 plaatsvonden. Boeren die niet door het leenstelsel gebonden waren, kwamen op eigen initiatief in de openlucht bijeen op een ‘hagesprake’ om bestuurszaken te bespreken. In totaal organiseerde de NSB in totaal zes hagespraken (1936, 2x 1937, 1938, 1939, 1940)."@nl;
    skos:altLabel "Hagespraak"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/locations/7216> .
  
