    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/7fbab85e-025a-11e7-904b-d89d6717b464/media/9aefc42c-b55a-55a3-2be3-a220979d2c09";
    <http://schema.org/startDate> "1945-04-08"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2574>;
    dcterms:created "2022-03-17T10:19:43.819Z"^^xsd:dateTime;
    skos:prefLabel "Executie bij Anloo"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 8 april 1945 werden 10 verzetsdeelnemers bij het onderduikershol in het Evertsbos bij Anloo door de Sicherheitsdienst (SD) geëxecuteerd. Ze waren in het Scholtenhuis in Groningen verhoord en daarna naar het Huis van Bewaring overgebracht. De SD wilde aan het eind van de oorlog geen getuigen achterlaten. Bij het hol waren al eerder drie verzetsdeelnemers gearresteerd en het was een makkelijke plek om lijken te begraven. Na de bevrijding werden de lijken geïdentificeerd en herbegraven."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/5106> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/18852> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:26:51.846Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/6569>;
    <http://schema.org/startDate> "1945-01-14"^^xsd:date;
    dcterms:source "https://wageningen1940-1945.nl/namen/burgerslachtoffers/steven-van-delden/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2574>;
    dcterms:created "2022-03-17T10:30:18.750Z"^^xsd:dateTime;
    skos:prefLabel "Executie gevangenen Rotterdamsche Bank (Velp), 14-01-1945"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 14 januari 1945 executeerde de SD zeven mannen in de omgeving van de Emmapiramide. Het betrof gevangenen uit de Rotterdamsche Bank (Velp). Dit gebouw was door de SD omgevormd tot noodgevangenis en stond onder leiding van Obersturmführer Arno Bernhard Huhn. De zeven gevangenen waren betrapt terwijl zij een ontsnappingsplan voorbereidden. Na de oorlog heerste er lange tijd onduidelijkheid over het lot van de geëxecuteerde mannen. Door verklaringen van Huhn werden in april 1947 twee massagraven ontdekt nabij de Emmapiramide. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/7998> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/18853> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:26:52.439Z"^^xsd:dateTime;
