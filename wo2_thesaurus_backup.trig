    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/c9f92816-0c60-662a-47b0-d59fd84f6260.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/4e63e294-025a-11e7-904b-d89d6717b464/media/c9f92816-0c60-662a-47b0-d59fd84f6260";
    dcterms:source "https://www.archieven.nl/nl/zoeken?mivast=0&mizig=210&miadt=298&miaet=1&micode=182&minr=1514434&miview=inv2"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4557>;
    dcterms:created "2021-12-29T13:06:08.619Z"^^xsd:dateTime;
    skos:prefLabel "Afdeling Expositur Joodsche Raad"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De afdeling Expositur van de Joodsche Raad bood hulp bij het invullen van formulieren voor emigratie. In 1942 kwam daar het bepleiten van vrijstellingen voor evacuatie uit de provincies bij. Er waren onderafdelingen voor reis- en verhuisvergunningen, woningen, huisraad, bagage, sleutels van verzegelde woningen, alsmede eventuele ontzegelingen. Veel uit Duitsland en Oostenrijk gevluchte Joden vielen onder deze afdeling. De Oostenrijkse dr. E.I. Sluzker stond aan het hoofd. Mevrouw Th. Sluzker-Rappaport en mr. Leo de Wolff verzorgden de voorlichting. De afdeling was gevestigd in drie panden aan de Jan van Eyckstraat in Amsterdam (15, 19 en 21)."@nl;
    skos:altLabel "Afdeeling Expositur Joodsche Raad"@nl, "Afdeling Expositur Joodse Raad"@nl,
      "Afdeling Expositur der Joodsche Raad"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/18543> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-06-07T14:40:53.408Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/18539>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/ce99e629-13ad-beb7-db53-16268a911a13.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/4e7810fc-025a-11e7-904b-d89d6717b464/media/ce99e629-13ad-beb7-db53-16268a911a13";
    dcterms:source "https://www.archieven.nl/nl/zoeken?mivast=0&mizig=210&miadt=298&miaet=1&micode=182&minr=1514389&miview=inv2"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4557>;
    dcterms:created "2021-12-29T13:19:56.641Z"^^xsd:dateTime;
    skos:prefLabel "Centrale voorlichtingsdienst Joodsche Raad"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Centrale Voorlichtingsdienst was gevestigd aan de Lijnbaansgracht 366 in Amsterdam en stond onder leiding van E. Spier en mr. dr. W. Diamand. Het had als taak de afdelingsleiders van de Raad over het werk van de verschillende afdelingen te informeren. Hiervoor was een onderafdeling Interne Informatie. Daarnaast gaf het uitleg over verordeningen en voorlichting aan personen die voor werkverruiming naar Duitsland werden uitgezonden. Hiervoor waren drie voorlichtingsbureaus elders in de stad beschikbaar."@nl;
    skos:altLabel "Centrale Voorlichtingsdienst der Joodsche Raad"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
