    dcterms:created "2022-03-17T11:16:36.610Z"^^xsd:dateTime;
    skos:prefLabel "Het Verdriet van Roermond: executie op Tweede Kerstdag"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Veertien ondergedoken mannen in Roermond zijn in de nacht van 25 op 26 december 1944 na verraad door de Duitsers opgepakt. Als afschrikwekkend voorbeeld werden zij op Tweede Kerstdag gefusilleerd in het Elmpterbos in de Duitse gemeente Niederkrüchten. Daarna meldden zich alsnog ca. 2.700 mannen, die op 30 december 1944 naar Duitsland werden gedeporteerd."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/7663>, <https://data.niod.nl/WO2_Thesaurus/17758> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/18863> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:26:57.214Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/6569>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/b/b7/Emma_Piramide_met_de_houten_toren.JPG/1280px-Emma_Piramide_met_de_houten_toren.JPG";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/w/index.php?title=File:Emma_Piramide_met_de_houten_toren.JPG&oldid=484411112";
    <http://schema.org/startDate> "1944-12-13"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2574>;
    dcterms:created "2022-03-17T11:19:54.798Z"^^xsd:dateTime;
    skos:prefLabel "Executie nabij Emmapiramide"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "In de bossen nabij de Emmapiramide werden op 13 december 1944 tien jonge mannen geëxecuteerd door de Sicherheitsdienst. Het betrof een represaillemaatregel van Hanns Albin Rauter voor het schieten op posten van Fallschirmjäger. De mannen waren afkomstig uit het gehele land en waren met velen opgesloten in een gebouw van de Rotterdamsche Bank in Velp. Dit gebouw was door de SD omgevormd tot noodgevangenis en stond onder leiding van Obersturmführer Arno Bernhard Huhn."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/18865> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    dcterms:modified "2022-03-22T15:08:45.829Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/3/37/Kindertransport_-_geograph.org.uk_-_366987.jpg?20110104172558";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/wiki/File:Kindertransport_-_geograph.org.uk_-_366987.jpg";
    <http://schema.org/startDate> "1938-12-01"^^xsd:date;
    <http://schema.org/endDate> "1940-05-01"^^xsd:date;
    dcterms:source "https://encyclopedia.ushmm.org/content/en/article/kindertransport-1938-40"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/events/18866>, <https://data.niod.nl/WO2_Thesaurus/events/18869>,
      <https://data.niod.nl/WO2_Thesaurus/events/18870>, <https://data.niod.nl/WO2_Thesaurus/events/18871>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/18470>;
    dcterms:created "2022-03-22T14:16:40.216Z"^^xsd:dateTime;
    skos:prefLabel "Kindertransport program, 1938-1940"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Het Kindertransport programma 1938-1940 werd na de Kristallnacht in Duitsland door de Britse regering ingesteld. Joodse kinderen onder de 17 jaar uit Nazi-Duitsland en de door Duitsland geannexeerde gebieden mochten als vluchteling met een tijdelijk reisvisum naar Engeland. Ouders of voogden mochten niet meekomen. Als de crisis over was zouden de kinderen naar hun families terugkeren. Particuliere burgers of organisaties moesten de betaling garanderen voor de zorg, het onderwijs en de eventuele emigratie van elk kind uit Groot-Brittannië. Tussen december 1938 en mei 1940 werden ongeveer 10.000 kinderen in veiligheid gebracht."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/18866> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    dcterms:modified "2022-03-22T15:10:09.647Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/18210>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/5/5b/Bundesarchiv_Bild_183-1987-0928-501%2C_England%2C_J%C3%BCdische_Fl%C3%BCchtlingskinder.jpg?20210921152217";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/wiki/File:Bundesarchiv_Bild_183-1987-0928-501,_England,_J%C3%BCdische_Fl%C3%BCchtlingskinder.jpg";
    <http://schema.org/startDate> "1938-12-02"^^xsd:date;
    dcterms:source "https://encyclopedia.ushmm.org/content/en/article/kindertransport-1938-40"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/18865>;
    dcterms:created "2022-03-22T14:55:53.649Z"^^xsd:dateTime;
    skos:prefLabel "Eerste kindertransport in Harwich, 2 december 1938"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Het eerste kindertransport naar Engeland arriveerde op 2 december 1938 in Harwich. Het bestond uit ongeveer 200 kinderen van een Joods weeshuis in Berlijn dat in de Kristallnacht was vernield. Vanuit steden zoals Berlijn, Wenen en Praag reisden de kinderen per trein naar havens in België en Nederland en vandaar per schip naar Harwich."@nl .
  
