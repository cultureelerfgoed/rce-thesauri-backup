    dcterms:created "2021-02-04T09:48:01.234Z"^^xsd:dateTime;
    skos:prefLabel "Liquidatie van Jacob Boom"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De liquidatie van Jacob Boom vond plaats op 20 november 1944 in Rotterdam.  Boom was lid van de NSB en SS. Hij werd door een in burger geklede KP'er in zijn woning doodgeschoten. Op de liquidatielijst van de LKP Rotterdam stond als reden: NSB'er met SD-connecties. "@nl .
  
