    <http://schema.org/startDate> "1944-11-01"^^xsd:date;
    <http://schema.org/endDate> "1944-11-06"^^xsd:date;
    dcterms:source "https://www.zeeuwseankers.nl/verhaal/walcheren-bevrijd-november-1944"@nl,
      "https://nos.nl/75jaarbevrijding/bericht/2309248-duitsers-geven-zich-als-makke-schapen-over-in-middelburg"@nl,
      "https://www.oorlogzeeland.nl/index.php/middelburg-bevrijd"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/6983>;
