    dcterms:source "https://www.wieringermeer.nl/cgi-bin/objecten.pl?ident=02072&search=woudenberg&veld=all&inword=1&bool=and&display=list&istart=1  "@nl,
      "https://kranten.archiefalkmaar.nl/issue/WC/1941-09-04/edition/0/page/2?query=woudenberg&f_periodicalcode%5B0%5D=WC&sort=relevance "@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2322>;
    dcterms:created "2020-10-07T07:53:05.000Z"^^xsd:dateTime;
    skos:prefLabel "Opvang evacuees in Wieringermeer"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Opvang van evacuees in Wieringermeer vond plaats in de meidagen van 1940. Nadat op 11 mei 1940 inwoners van Woudenberg gesommeerd werden te vertrekken bood de Wieringermeerbevolking onderdak aan 2600 van hen. Als aandenken voor de genoten gastvrijheid boden gemeente Woudenberg en haar inwoners eind 1941 een glas in loodraam aan, voor het raadhuis in Wieringerwerf. "@nl .
  
