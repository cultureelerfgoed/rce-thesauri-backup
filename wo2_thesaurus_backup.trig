    <http://schema.org/location> "Middelburg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/e7f330ae-025a-11e7-904b-d89d6717b464/media/1d968d6e-cb27-ce52-088d-51f204ab4ff3>,
      <https://beeldbankwo2.nl/nl/beelden/detail/24df68bc-025a-11e7-904b-d89d6717b464/media/2922ae50-0ee8-f12b-c027-136efa5377f5>,
