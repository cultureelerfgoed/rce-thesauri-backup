    skos:prefLabel "'Partisanen Actie Nederland'"@de, "'Partisanen Actie Nederland'"@en,
      "Partisanen Actie Nederland"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Partisanen Actie Nederland was een in maart 1944 in de omgeving van Eindhoven ontstane verzetsgroep, als een samenwerking van twee zelfstandige (niet in landelijk verband opgenomen) knokploegen en was gericht op sabotage en gewapend verzet. Op 24 september 1944 (na de bevrijding van Eindhoven) werd de PAN officieel opgeheven en gingen de leden op in de Binnenlandse Strijdkrachten."@nl;
    skos:altLabel "P.A.N."@nl, "Partizanen Actie Nederland"@nl;
