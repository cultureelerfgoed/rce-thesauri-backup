    dcterms:source "https://www.oorlogsgetroffenen.nl/thema/rechtsherstel/03_06_Onroerende_goederen_en_hypotheken"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/20712>;
    dcterms:created "2024-04-23T14:44:18.135Z"^^xsd:dateTime;
    skos:prefLabel "Landelijke Hypotheekbank N.V."@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Landelijke Hypotheekbank N.V. werd op 9 december 1943 opgericht door de NSB'ers D.H. de Vries en H.C. van Maasdijk, met goedkeuring van de Duitse autoriteiten. Naast het verstrekken van hypotheken op Joods onroerend goed behoorde het tot de taak van deze instelling Joodse hypothecaire kredieten aan niet-joden over te nemen. Door gebrek aan tijd en financiële middelen heeft de Landelijke Hypotheekbank haar taken uiteindelijk niet goed kunnen uitvoeren. Wel heeft ze een aantal hypotheken op grond van Verordening 37/1943 kunnen opeisen."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
