    skos:prefLabel "Nederlandsche Spoorwegen"@nl, "Niederländische Eisenbahnen AG"@de,
      "Dutch Railways"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Nederlandsche Spoorwegen is het Nederlandse nationale spoorwegbedrijf. Tijdens de Duitse bezetting kon de NS voortbestaan als zelfstandig bedrijf. Op 17 september 1944 riep de Regering in ballingschap in Londen de werknemers van de NS op in staking te gaan vanwege de aanstaande Operatie Market Garden. De Spoorwegstaking zou duren tot het eind van de oorlog in mei 1945."@nl;
    skos:altLabel "N.S."@nl, "Nederlandse Spoorwegen"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/5104>;
