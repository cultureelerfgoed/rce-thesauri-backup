    skos:prefLabel "Executie op IJsselkade Zutphen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Executie op IJsselkade Zutphen vond plaats op 31 maart 1945, waarbij tien voornamelijk verzetsmensen werden doodgeschoten. Een man overleefde de executie nadat de kogel afketste op een knoop. De lichamen werden vervolgens in de IJssel gegooid, waarna de overlevende zich zwemmend in veiligheid bracht."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/8004>;
