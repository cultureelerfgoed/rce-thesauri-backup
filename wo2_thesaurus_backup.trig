    skos:prefLabel "S.S."@nl, "SS"@de, "SS"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Schutzstaffel (SS) was de in 1925 opgerichte persoonlijke lijfwacht van Adolf Hitler die uitgroeide tot een veelomvattende organisatie die hoofdverantwoordelijk was voor de veiligheid binnen het Derde Rijk. De SS kreeg onder meer zeggenschap over politie en veiligheidsdiensten, propageerde de raszuiverheid van het Duitse volk en leverde elite-eenheden voor het front maar ook bewakingstroepen voor concentratiekampen."@nl;
    skos:altLabel "Algemene SS"@nl, "Allgemeine SS"@nl, "Schutzstaffel"@nl, "Zwarthemden"@nl;
