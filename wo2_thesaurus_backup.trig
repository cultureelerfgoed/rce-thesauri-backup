    dcterms:source "https://wikimiddenbrabant.nl/Vliegtuigcrash_Vijfhuizen,_21_juli_1944"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2329>;
    dcterms:created "2025-10-09T11:44:37.645Z"^^xsd:dateTime;
    skos:prefLabel "Vliegtuigcrash Vijfhuizen Tilburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De crash van een Britse bommenwerper in buurtschap Vijfhuizen, Tilburg, vond plaats op 21 juli 1944. De bommenwerper wordt op de terugweg na een missie in Duitsland tweemaal door Duitse jagers beschoten. Het toestel komt brandend in stukken neer in buurtschap Vijfhuizen, in het uiterste noordoosten van Tilburg, tegen de grens met Udenhout. Vijf bemanningsleden komen om het leven, twee worden krijgsgevangen gemaakt."@nl .
  
