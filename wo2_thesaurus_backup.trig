    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/c864349a-025a-11e7-904b-d89d6717b464/media/6ff1b2d5-78c4-696b-5d51-768ccc8399e0"@nl;
    dcterms:source "https://www.japansekrijgsgevangenkampen.nl/Pratchai.htm"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/b7354d29-49d5-4fe0-922a-3f3b5929fa84>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1699>, <https://data.niod.nl/WO2_Thesaurus/19085>;
    dcterms:created "2024-08-14T11:27:34.464Z"^^xsd:dateTime;
    skos:prefLabel "Pratchai"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Pratchai was een krijgsgevangenkamp 9 km ten oosten van de plaats Sara Bury in Thailand. Het was opgericht als nieuw basiskamp van de Birma Siam Spoorweg (afdeling IV). Vlakbij het kamp lag een klein vliegveld van waaruit Japanse verkenningsvluchten vertrokken. De werkzaamheden waren o.a. de aanleg van groentetuinen, het maken van opslagplaatsen in de heuvels (rotsen), de aanleg van een weg tussen het kamp en deze opslagplaatsen en de aanleg van aarden wallen."@nl;
    skos:altLabel "Wat Pra Phutta Chai"@nl, "Wat Pra Chai"@nl, "Shobbury (Siam)"@nl .
  
