    dcterms:created "2022-02-15T11:52:14.366Z"^^xsd:dateTime;
    skos:prefLabel "Beth Zekenim"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Beth Zekenim was een bejaardentehuis voor Joodse mannen en vrouwen in Groningen. Het bejaardentehuis werd in 1899 geopend door Israëlitische Vereniging 'Lebinjan Beth Zekenim'. Deze vereniging was in 1878 opgericht. Op 9 maart 1943 werd het tehuis ontruimd tijdens een razzia. 28 bewoners en drie medewerkers werden gedeporteerd en vermoord."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/18686> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:references "H.L. van den Ende, 'Vergeet niet dat je arts bent’. Joodse artsen in Nederland 1940-1945 (Amsterdam: Uitgeverij Boom, 2015)"@nl;
