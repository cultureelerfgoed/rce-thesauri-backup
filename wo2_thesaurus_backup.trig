    skos:prefLabel "Gewestelijk Inspecteur"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De rang gewestelijk inspecteur behoorde tot het hogere kader van de NSB. Aan de territoriale indeling van de NSB in blokken, buurten, groepen, kringen en districten werd in 1942 de indeling in gewesten toegevoegd. Het gewest was vanaf dat moment de grootste territoriale eenheid. Gewestelijk inspecteurs konden worden benoemd voor de volgende arbeidsterreinen: administratie, financiën, organisatie, personeel, propaganda en vorming. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2244> .
  
