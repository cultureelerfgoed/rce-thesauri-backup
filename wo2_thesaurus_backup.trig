    skos:prefLabel "Bogdanovka"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Bogdanovka was een concentratiekamp in Transnistrië, Roemenië, dat bestond van de herfst 1941 tot de winter 1942. Eind december 1941 (van 21 tot 31 december) werden hier ongeveer 40.000 mensen vermoord."@nl .
  
