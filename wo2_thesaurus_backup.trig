    dcterms:created "2023-07-11T14:02:18.738Z"^^xsd:dateTime;
    skos:prefLabel "Maschinenfabrik Augsburg-Nürnberg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Maschinenfabrik Augsburg-Nürnberg (MAN) was een Duitse fabrikant van vrachtwagens en dieselmotoren die ook in onderzeeboten werden gebruikt ten tijde van de Tweede Wereldoorlog. De fabriek bevond zich in Augsburg, maar er was ook een fabriek in Nürnberg. Van eind 1940 tot april 1945 werden ongeveer 8500 dwangarbeiders en concentratiekampgevangenen tewerkgesteld in de MAN. Door de vele geallieerde bombardementen in 1944 werd de fabriek meerdere malen beschadigd. "@nl;
    skos:altLabel "M.A.N."@nl, "MAN"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
