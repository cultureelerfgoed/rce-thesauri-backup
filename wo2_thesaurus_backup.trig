    dcterms:created "2016-10-04T13:07:40.000Z"^^xsd:dateTime;
    skos:prefLabel "Nationalsozialistische Deutsche Arbeiterpartei"@nl, "NSDAP"@de, "National Socialist German Workers' Party"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Nationalsozialistische Deutsche Arbeiterpartei (NSDAP) ontstond op 24 februari 1920 uit de Deutsche Arbeiterpartei (DAP) en had als leider Adolf Hitler. Na zijn benoeming tot rijkskanselier op 30 januari 1933 werd onder leiding van de NSDAP en met behulp van alle daaronder ressorterende organisaties (Hitlerjugend, Deutsche Arbeitsfront, SS, etc.) de hele Duitse samenleving genazificeerd. De NSDAP vormde de belangrijkste pijler van Hitlers dictatuur en was medeverantwoordelijk voor het uitvoeren van de Holocaust en vele andere misdaden van het Derde Rijk. Na de volledige capitulatie van nazi-Duitsland op 8 mei 1945 werden de NSDAP en al haar dochterorganisaties als misdadige organisatie verboden en ontbonden verklaard en haar vermogen werd in beslag genomen. In 1949 werd in de toen ontstane Bondsrepubliek Duitsland en de DDR alle propaganda voor de partij in geschrift, woord of symbool verboden."@nl;
    skos:altLabel "N.S.D.A.P."@nl, "Nazipartij"@nl, "Nationalsozialistische Deutsche Arbeiter-Partei"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4492>, <https://data.niod.nl/WO2_Thesaurus/19873>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/4619> a <http://schema.org/Thing>,
      skos:Concept;
    dcterms:references "Alex Dekker, Ook gij behoort bij ons : het NSKK in de Lage Landen (Meppel, 2013)"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-04-07T14:11:24.625Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1931-04-01"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> <https://collectie.atlasvanstolk.nl/img/AVS/700px/10/AVS105588.jpg>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://collectie.atlasvanstolk.nl/data_nl.asp?startc=1&q0=108405&subj=1&bron=g";
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-08"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    skos:relatedMatch <https://data.niod.nl/WO2_biografieen/Franciscus-Adrianus-Molijn>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Het Nationalsozialistische Kraftfahrkorps (NSKK) hielp het Duitse leger met vervoer. Het NSKK verzorgde onder andere het transport van goederen, wapens en soldaten. Vanaf januari 1941 wierf het NSKK ook buitenlandse vrijwilligers. Tussen de 9.000 en 10.000 Nederlanders gingen bij het NSKK, onder wie veel NSB'ers. Nederlanders die bij de NSKK gingen, verloren na de oorlog hun Nederlandse nationaliteit."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2101>, <https://data.niod.nl/WO2_Thesaurus/20640>;
    dcterms:created "2016-10-04T13:07:40.000Z"^^xsd:dateTime;
    skos:prefLabel "N.S.K.K."@nl, "NSKK"@de, "National Socialist Motor Corps"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Nationalsozialistische Kraftfahrkorps (NSKK) was een paramilitair onderdeel van de NSDAP, oorspronkelijk bedoeld ter bevordering van het gebruik van auto- en motorvervoer. Tijdens de Tweede Wereldoorlog werd het NSKK een hulporganisatie en bevoorradingseenheid voor de Duitse oorlogvoering. Vanaf januari 1941 wierf het NSKK ook buitenlandse vrijwilligers aan. Tussen de 9.000 en 10.000 Nederlanders traden toe, onder wie veel NSB'ers."@nl;
    skos:altLabel "Nationalsozialisches Kraftfahr Korps"@nl, "Nationalsozialisches Kraftfahrer Korps"@nl,
      "Nationalsozialisches Kraftfahrkorps"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/locations/8083>, <https://data.niod.nl/WO2_Thesaurus/16374>,
