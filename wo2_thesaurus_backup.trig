    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/20702>;
    dcterms:created "2019-01-21T11:57:30.000Z"^^xsd:dateTime;
    skos:prefLabel "Kyukan Seido Chosakai "@nl, "'Kyukan Seido Chosakai'"@en, "'Kyukan Seido Chosakai'"@de;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Kyukan Seido Chosakai bestond van 24 september 1942 tot oktober 1943 in Indonesië en werd opgericht na een decreet van de Militaire Administratie van de Japanse bezetter. Het doel van de organisatie was het begrijpen van de lokale gebruiken door de bezetter en deze te kunnen respecteren. Inheemse Indonesische onafhankelijkheidsstrijders en Japanners traden in overleg bij deze organisatie maar onderlinge ontevredenheid zorgde ervoor dat de organisatie na een jaar alweer werd opgeheven."@nl;
    skos:altLabel "Panitia Adat dan Tatanegara Dahulu"@de, "Committee for the Study of Traditional Customs and State Forms"@en;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/4382>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7716> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Event>;
    dcterms:references "Peter Post - The Encyclopedia of Indonesia in the Pacific War"@en;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
