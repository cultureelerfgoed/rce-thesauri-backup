    skos:prefLabel "Maliebaan 107"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "Op Maliebaan 107 woonde de familie Van Ham, die naast de ouders van moeder ook een Joods gezin huisvestte. Boris Lensky, een violist, zat ondergedoken met zijn vrouw en later ook hun dochter. "@nl;
    skos:altLabel "Onderduikadres Boris Lensky"@nl .
  
