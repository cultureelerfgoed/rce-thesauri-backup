    dcterms:created "2020-08-18T14:50:46.000Z"^^xsd:dateTime;
    skos:prefLabel "Maliebaan 15"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "Aan de Maliebaan 15 zat het kantoor van de Beauftragte, de Rijkscommissaris van de provincie Utrecht. De Rijkscommissaris was Henning von Winterfeld, die zelf ook aan de Maliebaan op nummer 12 woonde."@nl;
    skos:altLabel "Kantoor Beauftragte Utrecht"@nl .
  
