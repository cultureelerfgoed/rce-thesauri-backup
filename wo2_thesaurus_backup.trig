    skos:prefLabel "Argelès"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Argelès, ook Camp de concentration d'Argelès-sur-Mer genoemd, was een vluchtelingenkamp en interneringskamp (vijandige burgers) op het strand van Argelès-sur-Mer in Zuid-Frankrijk nabij de Spaanse grens. Het kamp werd in februari 1939 opgericht om de honderdduizenden vluchtelingen en republikeinse strijders op te vangen die Spanje ontvluchtten tijdens en na de Spaanse Burgeroorlog."@nl;
    skos:altLabel "Camp de concentration d'Argelès-sur-Mer"@nl, "Argelers"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/21812> a skos:Concept;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2025-09-22T09:46:21.677Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/d/d5/Nwhk-rdam1919.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/w/index.php?title=File:Nwhk-rdam1919.jpg&oldid=1063819755";
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Nederlandsch_Wetenschappelijk_Humanitair_Komitee&oldid=64244667"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/20707>;
    dcterms:created "2025-09-22T09:36:31.147Z"^^xsd:dateTime;
    skos:prefLabel "Nederlandsch Wetenschappelijk Humanitair Komitee"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Nederlandsch Wetenschappelijk Humanitair Komitee (NWHK) was een organisatie die over homoseksualiteit informeerde en tegen homodiscriminatie streed. Het NWHK werd in 1919 door Jacob Schorer opgericht. Toen op 10 mei 1940 de Duitsers binnenvielen, besloot Schorer het NWHK in alle haast op te heffen en vernietigde hij samen met Han Stijkel en Henri François de ledenadministratie en het archief. Tijdens de bezetting werd de bibliotheek van het NWHK na een inval door de Duitsers in beslag genomen en vernietigd."@nl;
    skos:altLabel "NWHK"@nl, "N.W.H.K."@nl, "Nederlands Wetenschappelijk Humanitair Komitee"@nl .
  
