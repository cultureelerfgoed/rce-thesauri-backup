    dcterms:created "2020-03-19T11:26:10.000Z"^^xsd:dateTime;
    skos:prefLabel "Dresden (Reichsbahnausbesserungswerk)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Aussenlager Dresden (Reichsbahnausbesserungsswerk) was van 15 september 1944 tot 19 februari 1945 een buitenkamp van Flossenbürg gevestigd in het Reichsbahnausbesserungswerk (RAW) in een loods van het Bahnhof Dresden-Friedrichstadt. De eerste 300 Poolse gevangenen waren gearresteerd na de Opstand van Warschau ; de volgende 300 gevangenen kwamen uit concentratiekamp Gross-Rosen. Ze werden tewerkgesteld aan de reparatie van beschadigde wagons. "@nl;
    skos:altLabel "Aussenlager Dresden (Reichsbahnausbesserungswerk)"@nl, "Aussenlager Reichsbahnausbesserungswerk"@nl,
      "Aussenlager RAW"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/8828> a <http://schema.org/Thing>, skos:Concept,
