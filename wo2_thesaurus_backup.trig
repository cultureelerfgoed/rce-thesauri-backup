    <http://schema.org/startDate> "1945-05-03"^^xsd:date;
    dcterms:source "https://de.wikipedia.org/w/index.php?title=Thielbek&oldid=168696069"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/3688>, <https://data.niod.nl/WO2_Thesaurus/3511>;
    dcterms:created "2018-11-29T13:44:16.000Z"^^xsd:dateTime;
    skos:prefLabel "Scheepsramp Thielbek"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "De Scheepsramp met de Thielbek vond plaats op 3 mei 1945 in de Lübecker Bocht. De SS Thielbek was een Duits vrachtschip uit 1927 waarmee 2.800 gevangenen uit het concentratiekamp Neuengamme werden getransporteerd. Er lagen in de buurt ook vele Duitse oorlogsschepen en enkele andere schepen die ook gevangenen uit Neuengamme transporteerde zoals de Cap Arcona met 5.000 gevangenen en de Athen met 2.000 gevangenen. De groep schepen werd op 3 mei 1945 gebombardeerd door de 198 Squadron van de Royal Air Force. De Thielbek en vele andere schepen zonken. Gevangenen die na het bombardement van de zinkende schepen wisten te ontsnappen werden veelal doodgeschoten vanaf rondvarende schepen of door patrouilles van de SS. In totaal zijn er ruim 7000 gevangenen om het leven gekomen en zo'n 350 mensen overleefden de ramp."@nl;
    skos:altLabel "Ramp in de Lübeckerbocht"@nl, "Bombardement in de Lübeckerbocht"@nl,
      "SS Thielbek"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/11206> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/7670> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
