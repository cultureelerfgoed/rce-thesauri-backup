    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/4/44/Auschwitz_I_death_block_11_04.jpg/500px-Auschwitz_I_death_block_11_04.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Blok_11#/media/Bestand:Auschwitz_I_death_block_11_04.jpg"@nl;
    <http://schema.org/endDate> "1945-01-27"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Blok_11&oldid=55498221"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/9331>;
    dcterms:created "2020-07-24T14:09:29.000Z"^^xsd:dateTime;
    skos:prefLabel "Blok 11"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Blok 11 was een kampgevangenis in Auschwitz, waar gevangenen heen werden gebracht als zij de regels hadden overtreden. Het blok, bijgenaamd het 'Dodenblok', stond geïsoleerd van de rest van het kamp. Het bestond voornamelijk uit cellen zonder lichtinval, die dichtgemetseld waren tot aan het plafond. Er werden vaak meerdere gevangenen in één kleine cel opgesloten. Daarnaast waren er speciale 'hongercellen', waar de bewakers de kampgevangenen opzettelijk lieten uithongeren."@nl;
    skos:altLabel "Het dodenblok"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9096> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
