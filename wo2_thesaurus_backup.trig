    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/isPointofInterest> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/locations/10221>, <https://data.niod.nl/WO2_Thesaurus/19671>;
    dcterms:created "2019-03-14T13:43:42.000Z"^^xsd:dateTime;
    skos:prefLabel "Schijnvliegveld Harskamp"@nl, "Scheinflugplatz Harskamp"@de;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "Schijnvliegveld Harskamp was bedoeld als bliksemafleider voor vliegveld Deelen. Dit nepvliegveld had een start- en landingsbanen, verlichting en hangars, met de bedoeling om de geallieerde bemanningen te verwarren. De Duitsers hoopten zo dat de vijand zijn ladingen hier in plaats van op echte landingsbanen zou droppen en bovendien gebruikten de Duitsers het terrein zelf om zo nu en dan een ongebruikte bommenlading te lozen."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/locations/8111> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "51.812207"^^xsd:float;
    <http://www.w3.org/2003/01/geo/wgs84_pos#long> "5.886533"^^xsd:float;
