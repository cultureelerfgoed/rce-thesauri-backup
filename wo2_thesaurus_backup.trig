    <http://schema.org/startDate> "1945-02-17"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/havingap>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/9271>;
    dcterms:created "2020-08-22T09:17:40.000Z"^^xsd:dateTime;
    skos:prefLabel "Fusillade in Halfweg"@nl, "Hinrichtung in Halfweg"@de, "Execution in Halfweg"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Tijdens de fusillade in Halfweg zijn op 17 februari 1945 tien verzetsmensen doodgeschoten op de Spaarndammerdijk. Ze werden overgebracht vanuit het Huis van Bewaring op de Weteringschans in Amsterdam. De executie was een vergelding voor een spoorwegoverval enkele dagen eerder, op 13 februari 1945. "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9284> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Guus Hartendorf, Velser Affaire. Bezettingstijd 1940-1945 in Kennemerland (Haarlem 2001) "@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:27:03.209Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/10382>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/2/2b/Het_voorlopige_verzetsmonument_aan_de_Rijksstraatweg.jpg/500px-Het_voorlopige_verzetsmonument_aan_de_Rijksstraatweg.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://upload.wikimedia.org/wikipedia/commons/thumb/2/2b/Het_voorlopige_verzetsmonument_aan_de_Rijksstraatweg.jpg/1024px-Het_voorlopige_verzetsmonument_aan_de_Rijksstraatweg.jpg>;
    <http://schema.org/startDate> "1945-02-12"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Represaille_Jan_Gijzenbrug&oldid=53586415"@nl;
    skos:relatedMatch <https://data.niod.nl/WO2_biografieen/Walraven-van-Hall>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/havingap>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/9271>;
    dcterms:created "2020-08-22T10:56:45.000Z"^^xsd:dateTime;
    skos:prefLabel "Fusillade in Haarlem, 12 februari 1945"@nl, "Hinrichtung in Haarlem, 12. Februar 1945"@de,
      "Execution in Haarlem, February 12, 1945"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Bij de fusillade op de Jan Gijzenbrug in Haarlem werden op 12 februari 1945 acht mannen doodgeschoten. De executie was een vergelding voor een schietpartij die twee dagen eerder in Haarlem had plaatsgevonden, waarbij een Duitse onderofficier om het leven kwam en een soldaat gewond raakte. De gefusilleerden waren: Klaas de Boer (KP Waterland), Egbert Snijder (KP Waterland),  Walraven van Hall (Nationaal Steunfonds), Henk de Jong (Trouw, LO), Frederik NIeuwenhuijsen (Nationaal Comité van Verzet, Ordedienst), Bastiaan van Beveren (Trouw), Joop Oudenaller (De Vrije Gooi- en Eemlander) en Ben Genemans (KP Amsterdam)."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9287> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
