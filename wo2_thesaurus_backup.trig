    <http://schema.org/location> "Velsen";
    <http://schema.org/startDate> "1942-11-01"^^xsd:date;
    <http://schema.org/endDate> "1944-09-30"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1922>, <https://data.niod.nl/WO2_Thesaurus/events/4330>;
    dcterms:created "2022-01-05T15:14:37.894Z"^^xsd:dateTime;
    skos:prefLabel "Evacuatie van Velsen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Evacuatie van Velsen begon in november 1942. Inwoners die niet werkten moesten de gemeente vóór 30 november 1942 verlaten. Wie zelf geen onderdak kon vinden, werd ondergebracht in Friesland, Groningen of Drenthe. Uiteindelijk werden 35.000 van de 49.000 inwoners geëvacueerd. Er gingen 3.700 woningen verloren in Velsen en IJmuiden, grotendeels door sloop. Vanaf september 1944 wilde de Duitse bezetter door het slopen van bebouwing de verdediging van de vesting IJmuiden verbeteren in verband met de oprukkende geallieerden."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/18571> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Geert-Jan Mellink, Verdreven voor de Atlantikwall. Ontruiming en afbraak van de Nederlandse kuststreek, 1942-1945 (Wbooks: Zwolle, 2016)"@nl;
