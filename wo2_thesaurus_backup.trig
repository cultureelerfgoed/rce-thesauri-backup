    <http://schema.org/startDate> "1943-02-27"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/wiki/Hr.Ms._Colombia_(1941)"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3511>;
    dcterms:created "2021-10-20T13:42:28.153Z"^^xsd:dateTime;
    skos:prefLabel "Scheepsramp Colombia"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Scheepsramp met de Colombia vond plaats op 27 februari 1943. De Colombia was van oorsprong een Nederlands koopvaardijschip van de Koninklijke Nederlandse Stoomboot Maatschappij dat in 1941 was omgebouwd tot onderzeebootmoederschip voor Nederlandse en Britse duikboten op de Indische Oceaan. Het stond onder Britse operationele controle, terwijl het directe bevel bij leden van de Koninklijke Marine lag. Op 27 februari 1943 vertrok het schip van East London (Zuid-Afrika) richting Simonstown (Kaapstad) voor een onderhoudsbeurt. Onderweg werd het getorpedeerd door een Duitse U-boot en tot zinken gebracht. 8 bemanningsleden overleefden de ramp niet. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/1870> .
  
  <https://data.niod.nl/WO2_Thesaurus/17762> a <http://schema.org/Thing>, skos:Concept,
