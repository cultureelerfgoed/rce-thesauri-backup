    skos:prefLabel "Kinrohoshi"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Kinrohoshi is een vorm van zeer eervol vrijwilligerswerk ten behoeve van het Japanse keizerrijk (of de Japanse Keizer). In Indonesië was deze organisatie ook actief tijdens de Japanse bezetting, maar werd werden de zogenaamde vrijwillige werkzaamheden verplicht en werd het een organisatie voor dwangarbeiders. "@nl;
    skos:altLabel "Onbetaalde arbeidsservice"@nl, "Unpaid labor service"@en;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/4382>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
