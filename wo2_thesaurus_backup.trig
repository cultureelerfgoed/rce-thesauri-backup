    skos:narrower <https://data.niod.nl/WO2_Thesaurus/kampen/7463>, <https://data.niod.nl/WO2_Thesaurus/kampen/7464>,
      <https://data.niod.nl/WO2_Thesaurus/19150>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1690>, <https://data.niod.nl/WO2_Thesaurus/19099>;
    dcterms:created "2022-11-15T08:58:20.302Z"^^xsd:dateTime;
    skos:prefLabel "Missiecomplex"@nl, "Missiecomplex"@de, "Missiecomplex"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Missiecomplex was een vrouwenkamp, mannenkamp en opvangkamp op West-Sumatra in Padang. Het kamp bevond zich in het Missiecomplex van de Broeders en Zusters van Liefde van Tilburg aan de Kerkstraat. Het kamp bestond uit een fraterhuis, kathedrale kerk Sint-Xaverius en jongensscholen ten noorden van de straat, een zusterhuis, kapel en meisjesscholen ten zuiden van de straat en een schoolgebouw van de Maria-Vereeniging ten oosten van de straat al wordt dit laatste gebouw soms als apart kamp beschouwd. Van 7 april 1942 tot 19 oktober 1943 fungeerde het Missiecomplex als vrouwenkamp. Van begin september 1943 tot 30 oktober 1943 fungeerde het schoolgebouw van de Maria-Vereeniging als mannenkamp. Van 2 september 1945 tot eind september 1945 was het Missiecomplex een opvangkamp."@nl;
    skos:altLabel "Missiecomplex Padang"@nl, "Padang Missiecomplex"@nl, "MV-schoolgebouw"@nl,
      "Maria-Vereniging"@nl, "Maria Vereniging schoolgebouw"@nl, "Schoolgebouw Maria-Vereeniging"@nl,
      "Maria-Vereeniging"@nl;
    skos:hiddenLabel "Schoolgebouw Maria Vereeniging Padang"@nl .
  
