    dcterms:references "D. Barnouw, ‘De Nationale Jeugdstorm’, in: J. Zwaan (red.), Zwarte Kameraden. Een geïllustreerde geschiedenis van de NSB (Weesp 1984)"@nl,
      "Tekst Redevoering van Mussert op 5 september 1941 voor ‘kernleden’ om verantwoording af te leggen over de koers van de NSB, in NSB-archief inv.nr. 133."@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-08-18T08:52:05.618Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1934-05-01"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/e4fe3b17-3c6f-216a-1e0f-d446bd1c6c3b.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/de8395d6-025a-11e7-904b-d89d6717b464/media/e4fe3b17-3c6f-216a-1e0f-d446bd1c6c3b";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/5627ed0e-025a-11e7-904b-d89d6717b464/media/4016a6a7-bbef-5c5d-d2e0-31ef631687ea>;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Nationale_Jeugdstorm&oldid=61542667"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-06"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Nationale Jeugdstorm was de jeugdorganisatie van de Nationaal-Socialistische Beweging (NSB), opgericht in 1934. De Jeugdstorm was formeel zelfstandig en werkte samen met de Hitlerjugend. De activiteiten van de Jeugdstorm bestonden uit marcheren, sporten, zingen en lessen in nationaalsocialistisch gedachtegoed. De Jeugdstorm bestond uit 12.000 tot 14.000 leden van tussen de 10 en 17 jaar oud."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
