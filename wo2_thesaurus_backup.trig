    skos:prefLabel "Operation Market Garden"@de, "Operation Market-Garden"@en, "Operatie Market-Garden"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Operatie Market-Garden startte op 17 september 1944. Het was een geallieerd offensief waarbij luchtlandingstroepen bruggen over de Rijn, Waal en Maas moesten veroveren en zo de weg vrij maken voor oprukkende grondtroepen. Na negen dagen hevige strijd in de regio Arnhem, Eindhoven en Nijmegen zagen de parachutisten zich gedwongen hun bruggenhoofd op te geven."@nl;
    skos:altLabel "Market Garden"@nl, "Operatie Market Garden"@nl, "Market-Garden"@nl,
      "Operation Market-Garden"@nl;
