    skos:prefLabel "Het Achterhuis (Amsterdam)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:exactMatch <https://digitaalerfgoed.poolparty.biz/westerbork/1765>;
    skos:scopeNote "Het Achterhuis op de Prinsengracht 263 te Amsterdam was de onderduikplek waar Anne Frank met haar ouders, zus, Fritz Pfeffer, de ouders van Pels en hun zoon Peter zaten ondergedoken. De familie Frank zat hier van 6 juli 1942 tot aan hun ontdekking op 4 augustus 1944. Na de oorlog werd op deze locatie het Anne Frank Museum gehuisvest."@nl;
    skos:altLabel "Anne Frank Huis"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4440> .
  
