    dcterms:created "2019-03-14T13:15:55.000Z"^^xsd:dateTime;
    skos:prefLabel "Het Hol (Harfsen)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "Het Hol was een onderduikplek te Harfsen waar een groep van circa zestig SD'ers, SS'ers en landwachters heengingen om onderduikers op te pakken, nadat zij even daarvoor al een inval hadden gedaan in boerderij Het Zonnenberg. Tine van Heesch, een koerierster van het verzet, ging naar Het Hol om de daar aanwezige onderduikers Ynze Dikkerboom en Appie Nauta te waarschuwen. Nauta vluchtte direct na aankomst van Tine van Heesch en wist zo te ontkomen en ook Tine en Ynze leken gered toen de overvallers het derde compartiment binnen Het Hol niet wisten te vinden, maar zij kwamen alsnog om toen er enkele handgranaten Het Hol in werden geworpen."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/locations/8105> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "52.2000965"^^xsd:float;
    <http://www.w3.org/2003/01/geo/wgs84_pos#long> "6.2562596"^^xsd:float;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2025-12-17T15:15:59.722Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/6565>;
    dcterms:source "http://harfsen.eu/oud/BevrijdingstochtHarfsenenOmstreken.pdf"@nl,
      "https://nl.wikipedia.org/w/index.php?title=Het_Hol&oldid=51900420"@nl, "https://nl.wikipedia.org/w/index.php?title=Het_Zonnenberg&oldid=40988976"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/isPointofInterest> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2184>, <https://data.niod.nl/WO2_Thesaurus/locations/10157>,
      <https://data.niod.nl/WO2_Thesaurus/locations/8103>;
    dcterms:created "2019-03-14T13:16:11.000Z"^^xsd:dateTime;
    skos:prefLabel "Het Zonnenberg (Harfsen)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "Het Zonnenberg was een boerderij in Harfsen waar in de nacht van 13 op 14 oktober 1944 circa zestig SD'ers, SS'ers en landwachters vanuit Deventer heengingen om onderduikers op te pakken. In de boerderij van de heer Slagman bevonden zich op dat moment een groot aantal onderduikers, dan na arrestatie werden afgevoerd. De boerderij werd leeggeroofd en in brand gestoken, waarna zij doortrokken naar de aan de locatie gelieerde onderdijkplek Het Hol in Harfsen."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/locations/8106> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "52.148768"^^xsd:float;
    <http://www.w3.org/2003/01/geo/wgs84_pos#long> "5.763403"^^xsd:float;
