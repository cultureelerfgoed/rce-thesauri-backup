  <https://data.niod.nl/WO2_Thesaurus/2572> a <http://schema.org/Thing>, skos:Concept,
      <https://data.niod.nl/thesaurus_wo2/ImagesWW2/Legislation>;
    dcterms:references "Van Dale Groot Woordenboek van de Nederlandse Taal (14e druk, 2005)"@nl,
      "M.H. Severein, Alles is gedaan om het recht te vinden. Bijzondere rechtspleging in Leeuwarden 1945-1949 (Hilversum: Uitgeverij Verloren, 2017), 224."@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:29:55.560Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/640x480/97441789-236c-0908-1015-f6dbcb3731d0.jpg",
      "https://images.memorix.nl/niod/thumb/640x480/97441789-236c-0908-1015-f6dbcb3731d0.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://beeldbankwo2.nl/nl/beelden/detail/d1ce31fc-025a-11e7-904b-d89d6717b464/media/97441789-236c-0908-1015-f6dbcb3731d0",
      "http://beeldbankwo2.nl/nl/beelden/detail/d1ce31fc-025a-11e7-904b-d89d6717b464/media/97441789-236c-0908-1015-f6dbcb3731d0"@nl;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Doodstraf_in_Nederland&oldid=48794705"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De doodstraf werd voor de bijzondere rechtspleging opnieuw ingevoerd. Rechters konden de doodstraf opleggen bij moord of wanneer verraad tot de dood van anderen had geleid. Daarnaast konden rechters de doodstraf opleggen bij misdrijven waarop in de reguliere rechtspraak meer dan 15 jaar gevangenisstraf stond."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/demoadmin>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2569>, <https://data.niod.nl/WO2_Thesaurus/19586>;
    dcterms:created "2016-08-01T19:20:42.000Z"^^xsd:dateTime;
    skos:prefLabel "Todesstrafe"@de, "Death penalty"@en, "Doodstraf"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "Doodstraf is een straf bestaande uit terdoodbrenging. Tijdens de Duitse bezetting werd de doodstraf door de Duitse bezetter in Nederland heringevoerd. In de nadagen van de Tweede Wereldoorlog besloot de Nederlandse regering in ballingschap tot herinvoering. De Bijzondere Rechtspleging veroordeelde 154 mensen tot de doodstraf, van wie er 39 daadwerkelijk werden gefusilleerd."@nl;
    skos:altLabel "Ter dood veroordeeld"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <https://data.niod.nl/thesaurus_wo2/ImagesWW2/Legislation> .
  
