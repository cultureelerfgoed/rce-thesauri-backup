    skos:prefLabel "Overval distributiekantoor Geldermalsen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Overval op Distributiekantoor Geldermalsen werd gedaan door drie verzetsmannen van de KP Soest op 9 september 1943. 7000 bonkaarten werden buitgemaakt. "@nl;
    skos:altLabel "Overval op het Distributiekantoor Geldermalsen"@nl;
