      "https://nl.wikipedia.org/w/index.php?title=Wikipedia:Wikiproject/Verzetskranten/Beginnetjes/Daily_world_news_(verzetsblad,_Arnhem)&oldid=46512157"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>;
    dcterms:created "2019-11-08T14:49:30.000Z"^^xsd:dateTime;
    skos:prefLabel "Daily world news"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Daily world news was een verzetsblad dat met vanaf 1 juni 1943 tot 4 januari 1945 aanvankelijk dagelijks en vanaf 10 oktober 1943 drie keer peer week in een oplage van 505 tot 500 stuks in Arnhem verscheen. De inhoud bestond voornamelijk uit nieuwsberichten."@nl;
    skos:altLabel "DWN"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8743> a <http://schema.org/Thing>, skos:Concept;
