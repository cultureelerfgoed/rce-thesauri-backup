    skos:prefLabel "Loopgraven Rijnkade Arnhem"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "De Loopgraven aan de Rijnkade te Arnhem werden na de gewonnen Slag om Arnhem door de bezetter aangelegd als verdedigingslinie."@nl;
