    <http://schema.org/startDate> "1943-02-26"^^xsd:date;
    dcterms:source "https://www.75jaarvrijheid.nl/nieuw/2430539/razzia-bij-joods-ziekenhuis-bejaardenhuis-en-weeshuis-in-rotterdam-op-26-februari-1943"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/9118>;
    dcterms:created "2020-07-30T08:01:53.000Z"^^xsd:dateTime;
    skos:prefLabel "Razzia's Joodse Zorginstellingen Rotterdam"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "In de Rotterdamse wijk Delfshaven vond op 26 februari 1943 een razzia plaats, waarbij Joodse ouderen, weeskinderen en zieken werden opgepakt. Drie Joodse instellingen werden bij de actie ontruimd: het bejaardentehuis op de Claes de Vrieselaan, het weeshuis aan de Mathenesserlaan en het ziekenhuis aan de Schietbaanlaan. Tweehonderd bewoners en patiënten werden samen met 61 personeelsleden weggevoerd. Een paar dagen later werden de meesten van hen vermoord in Sóbibor."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
