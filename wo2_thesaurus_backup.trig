    dcterms:source "https://nl.wikipedia.org/wiki/Stad_Schiedam_(schip,_1911)"@de;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3511>;
    dcterms:created "2021-11-15T09:25:28.529Z"^^xsd:dateTime;
    skos:prefLabel "Scheepsramp Stad Schiedam"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Scheepsramp met de Stad Schiedam vond plaats op 16 september 1940. De Stad Schiedam was een Nederlands schip van de Halcyon Lijn dat op 13 september uit Bermuda vertrok richting Halifax. Omdat het schip niet snel genoeg was kon het niet met een konvooi meevaren en moest de reis alleen maken. Op 16 september vonden er drie explosies plaats, hoogstwaarschijnlijk veroorzaakt door een combinatie van verdamping van de zwavel die vervoerd werd, stof van het oude schip en vonken van metaal dat tegen elkaar botste door het zware weer. Het schip zonk en twintig bemanningsleden overleefden de ramp niet."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/1870>;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
