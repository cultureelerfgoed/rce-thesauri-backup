    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://search.iisg.amsterdam/Record/ARCH01033>,
      <https://www.nationaalarchief.nl/onderzoeken/fotocollectie/5b5beaa7-4183-9286-17fa-d33ca820ef16>;
    <http://schema.org/startDate> "1920-05-23"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Communistische_Partij_van_Indonesi%C3%AB&oldid=49256322"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/7738>, <https://data.niod.nl/WO2_Thesaurus/events/8385>;
    dcterms:created "2019-04-24T14:17:46.000Z"^^xsd:dateTime;
    skos:prefLabel "Oprichting PKI"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Oprichting PKI, de Partij Kommunist India (later Indonesia) is een voortzetting van de Indische Sociaal Democratische Vereniging en wordt opgericht op 23 mei 1920, na de verbanning van Henk Sneevliet en de andere Europese leiders. De PKI maakt naam door de organisatie van een aantal grote stakingsacties. In december 1925 wordt onder leiding van Tan Malaka het eerste communistische congres gehouden in Semarang."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8408> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
