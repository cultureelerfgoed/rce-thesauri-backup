    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> false;
    skos:relatedMatch <https://data.niod.nl/WO2_biografieen/Willem-Lambertus-Christiaan-Lindenburg>;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
