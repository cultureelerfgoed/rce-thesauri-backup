    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/16ae37a0-025a-11e7-904b-d89d6717b464/media/89e00bad-488d-f2fa-e8a0-12148e7bec4f";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://www.openbeelden.nl/media/958723>,
