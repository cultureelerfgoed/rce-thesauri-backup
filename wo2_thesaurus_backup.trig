    <http://schema.org/location> "Middellandse Zee";
    <http://schema.org/startDate> "1941-04-27"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3511>;
    dcterms:created "2021-09-29T10:42:02.516Z"^^xsd:dateTime;
    skos:prefLabel "Scheepsramp Costa Rica"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Scheepsramp met de Costa Rica vond plaats op 27 april 1941. De Costa Rica was een Nederlands schip van de Koninklijke Nederlandse Stoombootmaatschappij dat tijdens Operatie Demon werd ingezet om Britse, Australische en Nieuw-Zeelandse militairen te evacueren uit Griekenland. Op 24 april 1941 vertrok het schip in konvooi vanuit Alexandrië naar de Griekse havenstad Kalamata. Het konvooi scheepte het hoogste aantal evacués in van de gehele Operatie en moest vanwege drukte in de Soedabaai op Kreta direct terug naar Egypte. Op 27 april werd het zodanig beschadigd door luchtaanvallen dat het schip verlaten moest worden. Alle bemanningsleden overleefden de ramp.  "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/1870> .
  
  <https://data.niod.nl/WO2_Thesaurus/17663> a <http://schema.org/Thing>, skos:Concept,
