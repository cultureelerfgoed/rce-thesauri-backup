    dcterms:created "2022-05-23T12:19:16.974Z"^^xsd:dateTime;
    skos:prefLabel "Gruppe Unbekannte Kinder"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "De Gruppe Unbekannte Kinder bestond uit Joodse kinderen die uit de onderduik waren weggehaald en naar Kamp Westerbork kwamen en waarvan de identiteit niet duidelijk was. Zo'n kind werd als Unbekanntes Kind geregistreerd. Deze onbekende kinderen kwamen in het weeshuis in Kamp Westerbork terecht. "@nl .
  
