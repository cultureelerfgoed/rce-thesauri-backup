    dcterms:created "2016-10-04T13:07:40.000Z"^^xsd:dateTime;
    skos:prefLabel "Nederlandsch Verbond van Vakverenigingen"@nl, "'Nederlandsch Verbond van Vakverenigingen'"@de,
      "Dutch Association of Trade Unions"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Nederlandsch Verbond van Vakverenigingen (NVV) was een vakcentrale, opgericht op 1 januari 1906 door vijftien vakbonden. Op 1 mei 1942 werden het NVV en de daarbij aangesloten vakverenigingen ontbonden. Ze gingen in hun geheel op in het NAF. De leiding berustte bij NSB'er Hendrik Jan Woudenberg. "@nl;
    skos:altLabel "Nederlands Verbond van Vakvereningen"@nl, "Nederlandsch Verbond van Vakvereenigingen"@nl;
