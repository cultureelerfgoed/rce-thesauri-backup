    skos:prefLabel "Beekvliet"@nl, "Beekvliet"@de, "Beekvliet"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Beekvliet was een gijzelaarskamp en onderdeel van Kamp Sint-Michielsgestel. Vanaf 4 mei 1942 werden in de gebouwen van het kleinseminarie Beekvliet enkele honderden gijzelaars gevangen gehouden. De eerste groep gijzelaars in het kamp waren prominente Nederlanders die als Todeskandidaten als represaille gefusilleerd konden worden en de groep Indische gijzelaars. "@nl;
    skos:altLabel "Kleinseminarie Beekvliet"@nl, "Lager Beekvliet"@nl, "Kamp Beekvliet"@nl .
  
