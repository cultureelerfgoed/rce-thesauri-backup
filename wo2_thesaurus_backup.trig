    dcterms:created "2018-11-01T15:18:45.000Z"^^xsd:dateTime;
    skos:prefLabel "Opvangkamp Darmo-wijkkamp"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Opvangkamp Darmo-wijkkamp functioneerde van september tot 6 november 1945 als opvangkamp voor vrouwen en kinderen. Er zaten hier 1100 vrouwen en kinderen. 83 van hen kwamen om tijdens een overval op hun transport naar het kamp. "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/7224> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
