    <http://schema.org/endDate> "1945-04-11"^^xsd:date;
    dcterms:source "https://nos.nl/75jaarbevrijding/bericht/2330115-belgische-commando-s-helpen-hoogeveen-bevrijden"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/6983>;
    dcterms:created "2018-11-28T14:32:55.000Z"^^xsd:dateTime;
    skos:prefLabel "Befreiung von Hoogeveen"@de, "Liberation of Hoogeveen"@en, "Bevrijding Hoogeveen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De bevrijding van Hoogeveen vond plaats op 10 en 11 april 1945 door de 2e Infanteriedivisie van de Canadese strijdkrachten en Belgische parachutisten. Vooruitgescchoven Belgische commandotroepen verkenden vanuit Coevorden de weg voor de Canadese troepen. Ze ondervonden weinig weerstand in het oosten omdat de bezetter was gevlucht. De Canadezen bevrijdden op 11 april het westelijke deel van Hoogeveen."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/7669> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
