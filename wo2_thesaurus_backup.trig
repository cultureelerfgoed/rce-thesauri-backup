    dcterms:created "2020-09-11T09:53:54.000Z"^^xsd:dateTime;
    skos:prefLabel "Operatie Typhoon"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Operatie Typhoon was een onderdeel van de Duitse operatie Barbarossa en had het doel om Moskou te veroveren. Het plan om de hoofdstad van de Sovjet-Unie te annexeren liep uit in de winst voor de Sovjet-Unie, omdat de Duitsers de operatie te traag uitvoerden. "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9419> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2021-06-14T14:06:10.021Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/15062>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/7/7a/Finnish_areas_ceded_in_1940.png"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/w/index.php?title=Vrede_van_Moskou_(1940)&oldid=56068432#/media/Bestand:Finnish_areas_ceded_in_1940.png"@nl;
    <http://schema.org/startDate> "1940-03-12"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Vrede_van_Moskou_(1940)&oldid=56068432"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/9413>;
    dcterms:created "2020-09-11T10:08:20.000Z"^^xsd:dateTime;
    skos:prefLabel "Vrede van Moskou"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Vrede van Moskou was het vredesverdrag tussen Finland en de Sovjet-Unie dat het einde markeerde van de Winteroorlog. Het verdrag werd getekend op 12 maart 1940. Finland moest een groot deel van het land afstaan aan de Sovjet-Unie, wat resulteerde in het motief om tijdens Operatie Barbarossa mee te doen als bondgenoot van Nazi-Duitsland."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9421> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
