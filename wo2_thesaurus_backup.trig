    <http://schema.org/startDate> "1945-03-05"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2682>;
    dcterms:created "2021-02-11T09:58:51.389Z"^^xsd:dateTime;
    skos:prefLabel "Liquidatie van Willem Leendert van der Lugt"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De liquidatie van Willem Leendert van der Lugt vond plaats op 5 maart 1945 in Rotterdam. Van der Lugt was werktuigkundig tekenaar op een machinefabriek. Op de liquidatielijst van de LKP Rotterdam stond als reden: roofovervallen. Van der Lugt werd door twee KP'ers in zijn woning doodgeschoten."@nl .
  
