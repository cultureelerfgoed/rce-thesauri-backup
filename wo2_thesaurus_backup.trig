      <https://data.niod.nl/WO2_Thesaurus/11437>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1977>, <https://data.niod.nl/WO2_Thesaurus/2789>;
    dcterms:created "2016-08-01T19:21:12.000Z"^^xsd:dateTime;
    skos:prefLabel "Sinti und Roma"@de, "Sinti and Roma"@en, "Sinti en Roma"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:exactMatch <https://digitaalerfgoed.poolparty.biz/westerbork/2936>;
    skos:scopeNote "De Roma (meervoud van Rom) zijn van oorsprong nomadische volkeren, waarvan de Sinti (mannelijk Sinto, vrouwelijk Sintezza) de bekendste groep is in Europa is. Sinti en Roma worden soms nog aangeduid met de term ‘zigeuner’ die zij als denigrerend beschouwen. In de Holocaust zijn zeker 400.000 Sinti en Roma vermoord."@nl;
    skos:altLabel "Zigeuners"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2017>, <https://data.niod.nl/WO2_Thesaurus/2028>,
      <https://data.niod.nl/WO2_Thesaurus/11454>, <https://data.niod.nl/WO2_Thesaurus/11455>,
      <https://data.niod.nl/WO2_Thesaurus/5129>;
    skos:definition "De Roma (meervoud van Rom) zijn van oorsprong nomadische volkeren, waarvan de Sinti (mannelijk Sinto, vrouwelijk Sintezza) de bekendste Romastam in Europa is. De term Roma kan zowel op het gehele volk als op een van de groepen slaan. Sinti en Roma hechten aan hun cultuur, tradities en Romani taal. Vooral op de Balkan en in westelijk Anatolië trekken nog Romavolkeren rond. Sinti en Roma worden soms aangeduid met de term ‘zigeuner’ die zij als denigrerend beschouwen. Vanaf de jaren 1970 noemen zij zichzelf daarom officieel ‘Roma’. In de Holocaust zijn zeker 400.000 Sinti en Roma vermoord."@nl .
  
