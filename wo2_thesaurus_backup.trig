    <http://schema.org/startDate> "1945-05-08"^^xsd:date;
    dcterms:source "https://katwijkinoorlog.nl/wij-zijn-vrij-bevrijding/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/6983>;
    dcterms:created "2021-06-16T13:42:00.088Z"^^xsd:dateTime;
    skos:prefLabel "Bevrijding Katwijk"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De bevrijding van Katwijk vond plaats op 8 mei 1945. 's Avonds kwamen de eerste vrachtwagens van de Engelse Royal Air Force Katwijk binnen rijden en op 9 mei volgden de Canadezen. Aangezien de Duitse bemanningen van de bunkers al vertrokken waren werden die leeggeroofd. Burgemeester Woldringh verklaarde de stellingen tot verboden terrein in verband met achtergebleven munitie en mijnenvelden."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/15351> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
