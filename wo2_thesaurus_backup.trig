    <http://schema.org/endDate> "1940-08-05"^^xsd:date;
    dcterms:source "https://jck.nl/nl/page/zandvoort"@nl, "https://www.oudzandvoort.nl/geschiedenis/gebouwen/146-de-joodse-synagoge-van-zandvoort"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3524>;
    dcterms:created "2022-08-24T11:25:22.703Z"^^xsd:dateTime;
    skos:prefLabel "Synagoge Zandvoort"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De synagoge in Zandvoort werd in de nacht van 4 op 5 augustus 1940 opgeblazen. In de jaren dertig waren er tientallen Joodse vluchtelingen uit Duitsland naar Zandvoort gevlucht. Na de Duitse inval werd er een SS-eenheid in Zandvoort gelegerd. Daarnaast woonde er een groot aantal NSB'ers. In maart 1942 werden de Joden uit Zandvoort naar Amsterdam geëvacueerd."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
