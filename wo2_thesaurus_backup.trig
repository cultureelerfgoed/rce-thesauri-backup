    skos:prefLabel "Erdöl"@de, "Oil"@en, "Aardolie"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Aardolie, ruwe olie of petroleum is een brandbare vloeistof bestaande uit een mengsel van koolwaterstoffen dat is ontstaan uit organische resten. Het is als meest verhandelde commodity van groot belang voor de wereldeconomie, evenals de producten die via raffinage en kraken uit de aardolie worden verkregen."@nl;
    skos:altLabel "Olie"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/8153> .
  
