    skos:prefLabel "Landgoed Spelderholt (Beekbergen)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "Landgoed Spelderholt functioneerde vanaf het voorjaar van 1944 als woonplek voor Wimmer en vanaf september 1944 ook voor Seyss-Inquart. Heinrich Himmler logeerde tijdens zijn bezoek aan Nederland in februari 1944 vermoedelijk enkele nachten op het landgoed. Na de bevrijding nam Prins Bernhard enige tijd zijn intrek in het kasteel."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/locations7970> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "52.114360"^^xsd:float;
    <http://www.w3.org/2003/01/geo/wgs84_pos#long> "6.296169"^^xsd:float;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/MaarenT>;
    dcterms:modified "2026-01-05T11:00:51.781Z"^^xsd:dateTime;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2870>;
