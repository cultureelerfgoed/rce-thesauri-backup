      <https://www.westfriesarchief.nl/onderzoek/zoeken?mivast=136&mizig=210&miadt=136&miaet=1&micode=2212&minr=8169392&miview=inv2>;
    <http://schema.org/startDate> "1945-05-08"^^xsd:date;
    dcterms:source "https://www.westfriesarchief.nl/historie/thema-s/oorlog-en-vrede/hoorn-bezet-en-bevrijd"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
