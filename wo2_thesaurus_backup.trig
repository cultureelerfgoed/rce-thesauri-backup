    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://archieven.coda-apeldoorn.nl/detail.php?id=110142";
    dcterms:source "https://nl.wikipedia.org/wiki/Theologische_Universiteit_Apeldoorn"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2392>;
    dcterms:created "2021-08-05T12:14:57.311Z"^^xsd:dateTime;
    skos:prefLabel "Theologische Universiteit Apeldoorn"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Theologische Universiteit Apeldoorn komt voort uit de Theologische School die in 1894 in Den Haag werd gesticht. De school verhuisde in 1919 naar Apeldoorn, kreeg in 1962 de naam Theologische Hogeschool en in 1989 werd die omgedoopt tot Theologische Universiteit Apeldoorn. "@nl;
    skos:altLabel "TUA"@nl, "Theologische School"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/17317> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:04:34.367Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/11335>;
