    dcterms:created "2023-08-08T11:10:21.006Z"^^xsd:dateTime;
    skos:prefLabel "Luftnachrichtenhelferinnen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Luftnachrichtenhelferinnen was een onderdeel van de Luftwaffe waarin vrouwen dienden. Zij hadden centrale posities in radiostations, luisterposten en meldstations van de luchtverkeersleiding. In eerste instantie was dit onderdeel de Flugmeldedienst genoemd, maar in februari 1941 ging deze dienst op in de Luftnachrichtenhelferinnen. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/19949> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:30:44.736Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/f/fa/Jean_de_Mayol_de_Lup%C3%A9_%28dans_le_Signal%29.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/w/index.php?title=File:Jean_de_Mayol_de_Lup%C3%A9_(dans_le_Signal).jpg&oldid=508169592";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/fa3db93c-025a-11e7-904b-d89d6717b464/media/0a7526e4-d794-24eb-d079-06f8f2050462>,
      <http://resolver.kb.nl/resolve?urn=urn:gvn:EVDO02:NIOD07_0441>;
    dcterms:source "https://en.wikipedia.org/w/index.php?title=Signal_(magazine)&oldid=1137424675"@nl,
      "https://www.quartermaster.nl/index.php/signal-h-no-10-1944.html"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2382>, <https://data.niod.nl/WO2_Thesaurus/3585>;
    dcterms:created "2023-08-10T15:15:11.126Z"^^xsd:dateTime;
    skos:prefLabel "Signaal"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "Signaal was een propagandatijdschrift van de Wehrmacht. In het rijk geïllustreerde blad werden de verdiensten van de Duitse strijdkrachten met propagandaverhalen en mooie foto’s uitgelicht. Hoewel het blad nauwelijks in Duitsland werd uitgegeven, werd het wel uitgegeven onder Duitse soldaten en bij de andere asmogendheden. Ook werd het blad in de bezette gebieden verspreid en was het zelfs tot 1941 in de Verenigde Staten beschikbaar. Tussen april 1940 en maart 1945 werden 111 edities in 30 talen uitgegeven. Met 2,5 miljoen exemplaren was het een van de meest gelezen bladen van Europa. "@nl;
    skos:altLabel "Signal"@nl .
  
