    dcterms:modified "2021-08-31T13:55:48.548Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> <https://imageviewer.kb.nl/ImagingService/imagingService?id=ddd:010432889:mpeg21:p006:image&w=250>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://resolver.kb.nl/resolve?urn=ddd:010432889:mpeg21:a0014";
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Vliegdekschip&oldid=48483756"@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/demoadmin>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2278>, <https://data.niod.nl/WO2_Thesaurus/2265>;
    dcterms:created "2016-08-01T19:20:04.000Z"^^xsd:dateTime;
    skos:prefLabel "Flugzeugträgers"@de, "Aircraft carriers"@en, "Vliegdekschepen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Vliegdekschepen zijn schepen met een dek waarvandaan vliegtuigen kunnen opstijgen en dat bovendien is ingericht voor het vervoer, onderhoud van vliegtuigen. Tijdens de zeeoorlog werden twee Nederlandse Shell-tankers omgebouwd tot vliegdekschip.  "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/2271> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "Van Dale Groot Woordenboek van de Nederlandse Taal (14e druk, 2005)"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/freet>;
    dcterms:modified "2021-08-31T13:53:18.177Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/nda/thumb/250x250/786183ba-5719-9d8e-a8d3-6a0ce7aa79f3.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://nimh-beeldbank.defensie.nl/memorix/379eb4da-ecad-b1b3-01cd-9ee492af2529";
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/demoadmin>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2278>, <https://data.niod.nl/WO2_Thesaurus/2265>;
    dcterms:created "2016-08-01T19:20:04.000Z"^^xsd:dateTime;
    skos:prefLabel "U-Boote"@de, "Submarines"@en, "Duikboten"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Duikboten zijn vaartuigen die (gedurende een bepaalde tijd) onder water kunnen varen. De Duitse Kriegsmarine voer tijdens de Tweede Wereldoorlog met U-boten. Marineofficier Karl Dönitz bracht voor U-boten de roedeltactiek (wolf-packs) in. Een strategie waarbij in konvooi varende geallieerde koopvaardijschepen vanuit verschillende kanten, door meerdere U-boten tegelijkertijd worden aangevallen, zoals een roedel wolven dat ook doet met prooi."@nl;
    skos:altLabel "Onderzeeboten"@nl, "Onderzeeërs"@nl, "U-Boten"@nl .
  
