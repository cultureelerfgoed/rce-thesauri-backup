    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/6411>;
    dcterms:created "2018-07-16T07:45:53.000Z"^^xsd:dateTime;
    skos:prefLabel "Stalag XII-C"@nl, "Stalag XII-C"@de, "Stalag XII-C"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Stalag XII-C was een Duits krijgsgevangenkamp in Wiebelsheim bestemd voor krijgsgevangenen en onderofficieren. Het kamp was van april 1940 tot eind september 1941 in gebruik. Daarna werden de gevangenen verdeeld over Stalag XII-A en Stalag XII-D. De capaciteit van het kamp bedroeg zo'n 18.000 gevangenen. Er zaten vooral Franse en Poolse soldaten. 95% van de gevangenen zaten in Arbeitskommando's en werkten vooral in de landbouw. "@nl;
    skos:altLabel "Stalag Wiebelsheim"@nl, "Stalag Wiebelsheim/Hunsrück"@nl, "Stalag XII C"@nl,
      "Stalag XII-C Wiebelsheim"@nl, "Stalag XII-C Wiebelsheim Hunsrueck"@nl, "Stalag XII-C Wiebelsheim Hunsrück"@nl,
      "Stalag XII-C Wiebelsheim/Hunsrueck"@nl, "Stalag XII-C Wiebelsheim/Hunsrück"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/6490> a <http://schema.org/Thing>, skos:Concept,
