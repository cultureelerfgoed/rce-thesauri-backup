    dcterms:source "https://www.tracesofwar.nl/sights/32215/Monument-Kartonfabriek-Beukema-en-Co.htm"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/9271>;
    dcterms:created "2020-09-23T10:35:53.000Z"^^xsd:dateTime;
    skos:prefLabel "Fusillade in Hoogezand"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 4 mei 1943 werden op het terrein van de voormalige N.V. Cartonfabriek Beukema & Co in Hoogezand vijf Nederlanders door de bezetter gefusilleerd als gevolg van  hun betrokkenheid bij de April-Mei stakingen. Na de fusillade zijn de vijf lichamen naar natuurgebied Appèlbergen in Glimmen gebracht en daar vermoedelijk begraven. Hun stoffelijke overschotten zijn, ondanks vele onderzoeken, nooit gevonden."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/2661> .
  
