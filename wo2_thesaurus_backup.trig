    dcterms:created "2021-02-17T11:45:36.923Z"^^xsd:dateTime;
    skos:prefLabel "Liquidatie van Michael Stemkens"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De liquidatie van Michael Stemkens vond plaats op 14 december 1943 in Roggel. Stemkens was bakker, lid van de WA en stond bekend als zeer pro-Duits. Hij werd op 14 december 's avonds op zijn fiets neergeschoten en overleed ter plekke. "@nl .
  
