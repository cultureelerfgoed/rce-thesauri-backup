    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/74d072ee-025a-11e7-904b-d89d6717b464/media/2d945a47-b368-4985-5d58-a64e807e2ab0"@nl;
    <http://schema.org/startDate> "1944-07-13"^^xsd:date;
    dcterms:source "https://www.jaarvanverzet.nl/verzetsactie/liquidatie-geale-kooij/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2682>;
    dcterms:created "2019-02-15T15:08:37.000Z"^^xsd:dateTime;
    skos:prefLabel "Liquidatie van Geale van der Kooij"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De liquidatie van Geale van der Kooij vond plaats op op 13 juli 1944 te Scharnegoutum. Hij was actief voor het NSKK en het verzet in Sneek verdacht hem van afluisteren van de LO Sneek. Na zijn arrestatie door de KP Sneek wilde hij niets zeggen over hoeveel hij wist over het verzet en het was waarschijnlijk een Amerikaanse piloot die hem doodschoot in opdracht van Haitze Wiersma. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/8890>;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/7863> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2022-08-01T10:27:22.367Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/10255>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/mediabank-horizontal/ba42988d-7dd3-2c7d-0b24-f02b1d756c9e.jpg";
    dcterms:source "https://februaristaking.nl/wordpress/geschiedenis-in-hilversum/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/2662>;
    dcterms:created "2019-02-18T14:28:31.000Z"^^xsd:dateTime;
    skos:prefLabel "Februaristaking in Hilversum"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Februaristaking in Hilversum vond plaats op 25 en 26 februari 1941 en was een reactie op de staking die in Amsterdam begon. Fokker medewerker Gerrit Meerbeek was de eerste die pamfletten meenam over de staking in Amsterdam naar de Nederlandse Seintoestellen Fabriek te Hilversum, waarna zij het werk neerlegde en de staking ook elders in Hilversum navolging kreeg. Voor de staking kreeg Hilversum een boete van 2,5 miljoen gulden en werd Gerrit ter dood veroordeeld, wat later werd omgezet naar een gevangenisstraf."@nl .
  
