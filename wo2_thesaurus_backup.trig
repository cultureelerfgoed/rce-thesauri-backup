    dcterms:source "https://www.verzetsmuseum.org/nl/kennisbank/1946-1947-in-actie#:~:text=Niet%20vrijgegeven%20voor%20publicatie:%20gevechten,soldaat%20van%20het%20Indonesische%20regeringsleger."@nl,
      "https://en.wikipedia.org/w/index.php?title=Police_actions_(Indonesia)&oldid=1291525984"@nl;
