    dcterms:source "https://nl.wikipedia.org/wiki/Fleet_Air_Arm"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/17401>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4669>;
    dcterms:created "2021-08-19T13:44:14.331Z"^^xsd:dateTime;
    skos:prefLabel "Fleet Air Arm"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Fleet Air Arm (FAA) was eerst onderdeel van de Royal Air Force (RAF) maar keerde op 14 mei 1937 terug onder de controle van de Britse Admiraliteit. De dienst werd hernoemd in Air Branch of the Royal Navy. Aan het begin van de Tweede Wereldoorlog bestond de FAA uit 20 eskaders met 232 vliegtuigen. Aan het eind van de oorlog had de dienst 59 vliegdekschepen, 3700 vliegtuigen, 72.000 officieren en manschappen en 56 luchtbases over de hele wereld. Tijdens de oorlog werden vliegtuigen een belangrijk wapen op zee omdat ze vliegend vanaf vliegdekschepen met bommen of torpedo's vanaf grote afstand schepen tot zinken konden brengen."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/1739> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "Van Dale Groot Woordenboek der Nederlandse Taal (12e druk, 1992)"@nl;
