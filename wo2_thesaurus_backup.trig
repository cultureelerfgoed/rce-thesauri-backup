    <http://schema.org/startDate> "1941-07-21"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/4854>;
    dcterms:created "2021-03-17T13:16:32.986Z"^^xsd:dateTime;
    skos:prefLabel "Ingebruikname van Majdanek"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "De Ingebruikname van Majdanek vond plaats op 21 juli 1941. In de herfst van 1941 arriveerden zo'n 5.000 Sovjet krijgsgevangenen, daarna volgden Poolse Joden uit het getto van Lublin. Vanaf het najaar van 1942 werd het kamp gebruikt als vernietigingskamp voor Joden."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
