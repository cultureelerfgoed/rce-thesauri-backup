    skos:prefLabel "Algemene Nederlandse Invoer Centrale (ANIC)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Algemene Nederlandse Invoer Centrale (ANIC) werd op 12 oktober 1939 opgericht en was verantwoordelijk voor de uitvoer van de Invoernoodwet 1939 en gevestigd in Den Haag. J.F. Posthuma werd als directeur aangesteld. "@nl;
    skos:altLabel "ANIC"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/18416> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-05-28T13:51:50.681Z"^^xsd:dateTime;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1741>, <https://data.niod.nl/WO2_Thesaurus/1883>,
      <https://data.niod.nl/WO2_Thesaurus/1870>;
    dcterms:created "2021-11-23T13:00:26.137Z"^^xsd:dateTime;
    skos:prefLabel "Commissie Onderscheidingen Koopvaardij"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Op 26 september 1940 werd door de Nederlandse regering de 'Commissie tot het beoordeelen van daden van heldhaftigheid betoond door personeel der koopvaardij', later de Commissie Onderscheidingen Koopvaardij (COK) ingesteld. Door de voordrachten van de commissie werden in de periode tussen 1940-1946, 645 dapperheidsonderscheidingen uitgereikt aan bemanningsleden. Dit waren o.a. de Militaire Willemsorde, de Bronzen Leeuw, het Bronzen kruis en het Kruis van Verdienste. "@nl;
    skos:altLabel "COK"@nl, "Commissie tot het beoordeelen van daden van heldhaftigheid betoond door personeel der koopvaardij"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/17652>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/18417> a <http://schema.org/Thing>, skos:Concept,
