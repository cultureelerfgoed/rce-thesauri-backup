    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/w/index.php?title=File:Monument_Katerveer_Hattem.jpg&oldid=642506465"@nl;
    <http://schema.org/location> "Hattem"@nl;
    <http://schema.org/startDate> "1945-04-10"^^xsd:date;
    dcterms:source "https://www.tracesofwar.nl/sights/46226/Monument-Katerveer-nabij-IJsselbrug.htm"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2574>;
    dcterms:created "2020-09-30T12:30:12.000Z"^^xsd:dateTime;
    skos:prefLabel "Executie in Hattem, 10 april 1945"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De executie in Hattem vond plaats op 10 april 1945. Na de executie op 4 april werden er nog eens 10 gevangenen uit een gevangenis in Zwolle aan het Einsatzkommando voorgeleid. Zeven burgers, 1 Belgische S.A.S. parachutist (The First Belgian Parachute Squadron Special Air Service) en 1 Belgische SS-deserteur werden door de Duitse bezetter nabij de IJsselbrug (Katerveer) gefusilleerd. Eén van de gevangenen overleefde de executie."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9549> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:27:52.928Z"^^xsd:dateTime;
