    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://en.wikipedia.org/wiki/Oflag_XXI-B#/media/File:Szubin.Oflag_64.JPG";
    dcterms:source "https://en.wikipedia.org/wiki/Oflag_XXI-B"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/6411>;
    dcterms:created "2018-02-20T10:27:01.000Z"^^xsd:dateTime;
    skos:prefLabel "Stalag XXI-B Schubin"@de, "Stalag XXI-B Schubin"@en, "Stalag XXI-B Schubin"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Stalag XXI-B was een Duits krijgsgevangenkamp in Szubin, Polen. In december 1939 werd het kamp dat in oktober 1939 rond een Poolse jongenschool door Poolse krijgsgevangenen was gebouwd formeel gevestigd samen met Stalag XXI-B1 in Antoniewo. De Poolse gevangenen werden in de periode maart-mei 1940 naar kampen in Duitsland overgebracht en in juni arriveerden er Franse officieren. In december 1940 verplaatste het kamp zich naar het nabijgelegen dorp Tur. In april 1943 werden alle krijgsgevangenen overgeplaatst naar Stalag Luft III dat een uitbreiding had gekregen. Later werd het kamp heropend als Oflag 64 voor Amerikaanse officieren."@nl;
    skos:altLabel "Stalag Schubin"@nl, "Stalag XXI-B Szubin"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/5994> a <http://schema.org/Thing>, skos:Concept,
