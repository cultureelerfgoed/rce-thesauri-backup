    skos:relatedMatch <https://data.niod.nl/WO2_Thesaurus/18477>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1617>, <https://data.niod.nl/WO2_Thesaurus/8176>;
    dcterms:created "2021-12-07T14:25:44.587Z"^^xsd:dateTime;
    skos:prefLabel "Feldafing"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Opvangkamp Feldafing was het eerste kamp waar alleen Joodse overlevenden werden opgevangen. Het Amerikaanse leger opende het kamp op 1 mei 1945 om zo'n 3000 Hongaarse Joden te huisvesten. Het lag ten zuidwesten van München in de Amerikaanse bezettingszone. Het kamp werd een model voor de uitvoering van het beleid ten aanzien van Joodse overlevenden zoals vastgelegd in het Harrison Report. In 1946 woonden er ongeveer 4000 Joden. Op 1 december 1951 kwam het onder Duits bestuur en in maart 1953 werd het kamp gesloten."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
