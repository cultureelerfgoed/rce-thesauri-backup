    <http://schema.org/startDate> "1945-02-08"^^xsd:date;
    skos:relatedMatch <https://data.niod.nl/WO2_biografieen/Eliazar-Blei-Weissman>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2047>;
    dcterms:created "2021-01-20T09:21:55.314Z"^^xsd:dateTime;
    skos:prefLabel "Arrestatie van Eliazar Blei Weissmann"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De arrestatie van Eliazar Blei Weissmann vond plaats op 8 februari 1945. Weissmann was een van de initiatiefnemers van verzetsblad De Gids. Na zijn ontslag als ambtenaar, vanwege zijn Joodse afkomst, dook hij onder in maart 1941. Op 8 februari 1945 werd Weissmann gearresteerd en opgesloten in de Rotterdamse gevangenis de Haagsche Veer. Op 20 februari werd hij gefusilleerd op de Rotterdamse Coolsingel."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/9278>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/10957> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2021-01-25T14:51:11.877Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/10958>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/e/e9/Gedenkst%C3%A4tte_Fuhlsb%C3%BCttel.JPG/500px-Gedenkst%C3%A4tte_Fuhlsb%C3%BCttel.JPG";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://en.wikipedia.org/wiki/Fuhlsb%C3%BCttel#/media/File:Gedenkst%C3%A4tte_Fuhlsb%C3%BCttel.JPG";
    dcterms:source "https://www.kz-gedenkstaette-neuengamme.de/en/history/satellite-camps/satellite-camps/hamburg-fuhlsbuettel/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/3688>, <https://data.niod.nl/WO2_Thesaurus/1670>;
    dcterms:created "2021-01-25T12:55:09.640Z"^^xsd:dateTime;
    skos:prefLabel "Hamburg-Fuhlsbüttel"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Hamburg-Fuhlsbüttel was van 26 oktober 1944 tot 15 februari 1945 een satellietkamp van concentratiekamp Neuengamme met zo'n 1300 gevangenen. De gevangenen kwamen van satellietkamp Hamburg-Veddel dat grotendeels vernield was door geallieerde bombardementen. Vanaf 1936 was concentratiekamp Fuhlsbüttel een politiegevangenis van waaruit gevangenen naar concentratiekampen werden gebracht. "@nl .
  
