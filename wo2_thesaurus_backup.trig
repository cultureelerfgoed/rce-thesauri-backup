    skos:prefLabel "Gemachtigde van den Hoofdstormer"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De gemachtigde van den hoofdstormer was een hoge rang binnen de Nationale Jeugdstorm. De hoofdstormer kon gemachtigden opdragen namens hem op te treden met door hem vastgestelde bevoegdheden."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4553> .
  
