    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Invasie_van_Sumatra_in_1942&oldid=49263312"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
