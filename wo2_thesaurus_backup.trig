    dcterms:created "2021-04-08T07:42:28.576Z"^^xsd:dateTime;
    skos:prefLabel "Ontruiming van het 'Zigeunerkamp'"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Ontruiming van het 'Zigeunerkamp' in Auschwitz vond plaats in de nacht van 2 op 3 augustus 1944. Zo'n 4200 mensen werden vergast. In het 'Zigeunerkamp' van Auschwitz werden de Sinti en Roma opgesloten en werden families, in tegenstelling tot de rest van het kamp, niet van elkaar gescheiden."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/11457> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    dcterms:modified "2026-03-23T09:35:40.948Z"^^xsd:dateTime;
