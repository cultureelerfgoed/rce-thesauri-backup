  <https://data.niod.nl/WO2_Thesaurus/7689> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2019-04-15T13:26:51.000Z"^^xsd:dateTime;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Zwarte_propaganda&oldid=51575786"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2566>;
    dcterms:created "2018-12-07T13:46:09.000Z"^^xsd:dateTime;
    skos:prefLabel "Black propaganda"@nl, "Black propaganda"@en, "Schwarze Propaganda"@de;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Black propaganda (Zwarte propaganda) is een vorm van psychologische oorlogvoering waarbij valse informatie verspreid wordt die lijkt van een bepaalde bron afkomstig te zijn maar in feite van een andere partij afkomstig is. Het doel hiervan is het zwartmaken, demoniseren of belachelijk maken van de andere partij."@nl;
    skos:altLabel "Zwarte propaganda"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/7705> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-02-15T11:04:35.910Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8028>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/events/8265>, <https://data.niod.nl/WO2_Thesaurus/events/8266>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2506>;
    dcterms:created "2019-01-10T11:06:03.000Z"^^xsd:dateTime;
    skos:prefLabel "Partai Nasional Indonesia "@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Partai Nasional Indonesia (PNI) was de oudste politieke partij van Indonesië. De belangrijkste leider en oprichter van de partij was Soekarno. Het voornaamste doel van de partij was de oprichting van een onafhankelijke nationale staat Indonesië. Hoewel er nog partijen zijn met de naam PNI in zich, is de partij in 1973 opgegaan in andere partijen."@nl;
    skos:altLabel "PARTINDO"@nl, "PNI"@nl, "Indonesische Nationalistische Partij"@nl,
      "Perserikatan Nasional Indonesia"@nl, "Indonesisch Nationaal Verbond"@nl, "Partai Indonesia"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
