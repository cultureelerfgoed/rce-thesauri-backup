    <http://schema.org/location> "Djakarta";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://www.delpher.nl/nl/kranten/view?coll=ddd&identifier=ddd:110530770:mpeg21:a0005>,
      <https://www.delpher.nl/nl/kranten/view?coll=ddd&identifier=ddd:010326451:mpeg21:a0023>;
    <http://schema.org/startDate> "1942-12-07"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2019-03-28T14:21:41.000Z"^^xsd:dateTime;
    skos:prefLabel "Naamswijziging Batavia"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Naamswijziging Batavia naar Djakarta, op 7 december 1942, wordt exact een jaar na de Japanse aanval op Pearl Harbor ingevoerd door de bezetter."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8225> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:34:44.033Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8018>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/wo2nedindieThema> "Binnenlandse politiek";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/nda/thumb/250x250/2c86f3d4-d71c-d620-1241-fcae9f506704.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nimh-beeldbank.defensie.nl/memorix/4ca5c07c-eb18-11df-a391-13966e870614";
    <http://schema.org/location> "Londen";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://www.archieven.nl/nl/search-modonly?mivast=298&mizig=210&miadt=298&micode=233b&milang=nl&miview=inv2>;
    <http://schema.org/startDate> "1942-12-06"^^xsd:date;
    dcterms:source "https://nl.wikisource.org/w/index.php?title=Radiotoespraak_Wilhelmina_7_december_1942&oldid=73477"@nl;
    <http://schema.org/description> "Koningin Wilhelmina houdt in de avond van 6 december in Londen een toespraak voor Radio Oranje over de naoorlogse structuur van het Koninkrijk. In Nederlands-Indië is het op dat moment 7 december. In haar toespraak zegt Wilhelmina Indonesië, Suriname en de Nederlandse Antillen intern zelfbestuur toe binnen het rijksverband. Na de oorlog gaat een rijksconferentie met vertegenwoordigers uit alle gebiedsdelen advies uitbrengen over een nieuwe structuur voor het Koninkrijk. "@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/1717>, <https://data.niod.nl/WO2_Thesaurus/events/8185>,
      <https://data.niod.nl/WO2_Thesaurus/events/8184>;
    dcterms:created "2019-03-28T15:05:07.000Z"^^xsd:dateTime;
    skos:prefLabel "Toespraak Koningin Wilhelmina 6 december 1942"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Toespraak van Koning Wilhelmina wordt in de avond van 6 december 1942 (het is dan 7 december in Nederlands-Indië) in Londen gehouden voor Radio Oranje over de naoorlogse structuur van het Koninkrijk. In haar toespraak zegt Wilhelmina Indonesië, Suriname en de Nederlandse Antillen intern zelfbestuur toe binnen het rijksverband."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8226> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2021-06-22T12:41:57.549Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/16617>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/wo2nedindieThema> "Internationale betrekkingen";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://www.oorlogsbronnen.nl/zoekresultaat?id=http%3A%2F%2Farchievenwo2.nl%2Farchieven%2Farchief-blok%2F-219132855>,
      <https://www.delpher.nl/nl/kranten/view?coll=ddd&identifier=ddd:010401512:mpeg21:a0023>,
      <https://www.delpher.nl/nl/kranten/view?coll=ddd&identifier=ddd:010996922:mpeg21:a0021>;
    <http://schema.org/startDate> "1943-03-14"^^xsd:date;
    <http://schema.org/endDate> "1943-01-24"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Conferentie_van_Casablanca&oldid=51862606"@nl;
    <http://schema.org/description> "Tijdens de conferentie van Casablanca wordt onder druk van de Amerikaanse delegatie de Europa-eerst-strategie gedeeltelijk verlaten. De Engelsen gaan akkoord met het plan om in de Pacific in 1943 langs twee aanvalslijnen in het offensief te gaan. De Amerikaanse marine zet in het bevelsgebied van de Pacific Ocean Areas (POA) de aanval in tegen Gilbert Eilanden, de Marshall Eilanden en de Marianen Eilanden. Het Amerikaanse leger gaat in de South West Pacific Area (SWPA) in de aanval tegen Japanse steunpunten in de Bismarck Archipel en op Nieuw-Guinea."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2350>, <https://data.niod.nl/WO2_Thesaurus/2629>,
      <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2019-03-28T15:42:13.000Z"^^xsd:dateTime;
    skos:prefLabel "Conferentie van Casablanca"@nl, "Casablanca Conference"@en, "Casablanca-Konferenz"@de;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Conferentie van Casablanca was een bijeenkomst van geallieerde leiders, gehouden van 14 tot 24 januari 1943. Onder druk van de Amerikaanse delegatie werd de \"Europe first\" strategie, waartoe was besloten op de Arcadiaconferentie, gedeeltelijk verlaten. Door deze beslissing kwam de focus minder primair op de bevrijding van Europa te liggen maar wordt er ook een offensief gestart tegen de Japanners."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8227> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
