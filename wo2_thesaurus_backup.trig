      "https://www.nhnieuws.nl/nieuws/261019/achter-de-foto-vier-verzetstrijders-worden-herdacht"@nl,
      "https://www.4en5mei.nl/oorlogsmonumenten/zoeken/1275/zaanse-schans-monument-aan-de-leeghwaterweg"@nl;
    <https://data.niod.nl/organizationsWO2/isCausedBy> <https://data.niod.nl/WO2_Thesaurus/19063>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/klijne>;
