  <https://data.niod.nl/WO2_Thesaurus/22020> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    dcterms:modified "2026-05-27T07:30:14.085Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/13396>;
    <http://schema.org/startDate> "1941-06-23"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2047>;
    dcterms:created "2026-05-18T11:33:51.282Z"^^xsd:dateTime;
    skos:prefLabel "Arrestaties examenfeest Zandvoort"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De arrestaties tijdens het examenfeest van Arnold Jan Simons in Zandvoort vonden plaats in de nacht van 22 op 23 juli 1941. Wegens anti-Duitse leuzen en versieringen werden 24 personen gearresteerd op de eindexamen viering van de geslaagde Arnold Jan Simons. De groep werd verhoord en ging via de gevangenis Weteringschans naar Kamp Schoorl. Na twee weken werden de vrouwen vrijgelaten, Arnold Jan Simons werd als laatste vrijgelaten na ruim drie maanden gevangenschap."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/22021> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "52.350333950134555"^^xsd:float;
    <http://www.w3.org/2003/01/geo/wgs84_pos#long> "4.890970490801971"^^xsd:float;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-05-19T10:35:27.659Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/download/high_res/f1676b89-ef68-c1d7-41bc-4328691682ff.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/325508f8-025a-11e7-904b-d89d6717b464/media/f1676b89-ef68-c1d7-41bc-4328691682ff";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/324d90e6-025a-11e7-904b-d89d6717b464/media/9040a632-9545-6105-701c-ca31eb9300a1>;
    dcterms:source "https://www.joodsamsterdam.nl/tulp-kazerne/"@nl, "https://www.stelling-amsterdam.nl/bunkers/amsterdam-tulpkazerne/index.php"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/19569>, <https://data.niod.nl/WO2_Thesaurus/21902>;
    dcterms:created "2026-05-19T10:22:15.043Z"^^xsd:dateTime;
    skos:prefLabel "Tulpkazerne"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Tulpkazerne was een kazerne aan het Cornelis Troostplein in Amsterdam. De kazerne was oorspronkelijk een klooster- en scholencomplex, maar het gebouw werd op 15 mei 1941 gevorderd door de Duitse bezetter en hernoemd naar NSB’er en hoofdcommissaris van de politie Sybren Tulp. In de Tulpkazerne werd het Politiebataljon Amsterdam (PBA) ondergebracht. Op Dolle Dinsdag vluchtte het PBA en nam de Landwacht, Germaansche SS en de Sicherheitsdienst (SD) de kazerne in gebruik. Na de bevrijding na de Koninklijke Marechaussee de kazerne over."@nl;
    skos:altLabel "Tulp-kazerne"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
