    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Lodo_van_Hamel#/media/Bestand:Hamel,_Lodewijk.jpg";
    <http://schema.org/startDate> "1940-08-27"^^xsd:date;
    <http://schema.org/endDate> "1940-08-28"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2674>;
    dcterms:created "2023-06-19T13:41:10.710Z"^^xsd:dateTime;
    skos:prefLabel "Eerste dropping geheim agent op 27 augustus 1940"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De eerste dropping van een geheim agent in bezet Nederland vond plaats op 27 augustus 1940. De gedropte geheim agent was Lodewijk van Hamel. Hij landde in de nacht van 27 op 28 augustus 1940 bij Hillegom. Toen zijn opdracht, een radioverbinding met Londen en een spionagegroep opzetten, was volbracht en hij terug naar Engeland wilde keren werd hij opgepakt. Van Hamel werd opgesloten in het Oranjehotel en uiteindelijk op de Bussumerheide te Laren geëxecuteerd."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/19635> a <http://schema.org/Thing>, skos:Concept,
