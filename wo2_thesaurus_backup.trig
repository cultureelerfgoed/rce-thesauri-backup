    skos:prefLabel "Padanghalaban/Panigoran"@de, "Padanghalaban"@en, "Padanghalaban/Panigoran"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Padanghalaban/Panigoran was een burgerkamp bij het Station Padanghalaban aan de spoorlijn van Medan naar Rantauprapat, circa 20 kilometer ten noorden van Rantauprapat. Rubberonderneming Panigoran lag iets ten westen van de halteplaats. Het kamp was operationeel tussen 5 oktober 1944 en 23 augustus 1945."@nl;
    skos:altLabel "Padanghalaban/Panigoran AB"@nl .
  
