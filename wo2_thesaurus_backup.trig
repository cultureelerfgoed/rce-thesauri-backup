    dcterms:created "2021-11-10T11:21:10.995Z"^^xsd:dateTime;
    skos:prefLabel "Sint-Vincentius"@nl, "Sint-Vincentius"@de, "Sint-Vincentius"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Sint-Vincentius was een krijgsgevangenenkamp, burgerkamp en opvangkamp op West-Java in Batavia. Het kamp bevond zich in het weeshuis en meisjesinternaat van de Zusters Ursulinen in het zuidoosten van Batavia (Bidara Tjina 76). Van april 1943 tot eind februari 1945 fungeerde Sint-Vincentius als krijgsgevangenkamp. Van 4 maart 1945 tot 23 augustus 1945 fungeerde het als burgerkamp en kamphospitaal. Van 23 augustus 1945 tot eind oktober 1945 was Sint-Vincentius een opvangkamp."@nl;
    skos:altLabel "Sint Vincentius"@nl, "Meisjesinternaat Sint-Vincentius"@nl, "Sint-Vincentius Batavia"@nl,
      "Sint-Vincentius Bidaratjina"@nl, "Weeshuis Sint-Vincentius"@nl, "Sint Vincentius Bidaratjina"@nl,
      "Sint Vincentius Bidara Tjina"@nl, "St.-Vincentius"@nl, "St. Vincentius"@nl .
  
