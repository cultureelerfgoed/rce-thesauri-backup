    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://de.wikipedia.org/wiki/Ghetto_Izbica#/media/File:Izhbitz_Ghetto.jpg";
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/5326>, <https://data.niod.nl/WO2_Thesaurus/8176>;
