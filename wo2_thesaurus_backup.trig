    dcterms:created "2023-06-22T13:54:22.363Z"^^xsd:dateTime;
    skos:prefLabel "Vliegveld Ursel"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Vliegveld Ursel werd in 1939 door de Belgische luchtmacht aangelegd. Op 27 mei 1940 namen de Duitse Luftwaffe en tussen 19 oktober 1940 en 10 januari 1941 ook de Italiaanse luchtmacht het vliegveld in gebruik. In september 1944 namen de geallieerden het vliegveld over en noemden het B-67. Na de Tweede Wereldoorlog bleef het vliegveld in gebruik als reservevliegveld. "@nl;
    skos:altLabel "B-67"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
