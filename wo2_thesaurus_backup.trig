    <http://schema.org/startDate> "1945-04-09"^^xsd:date;
    dcterms:source "https://www.75jaarvrijheidhellendoorn.nl/blog/de-slag-om-haarle/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/6983>;
    dcterms:created "2020-10-12T14:59:17.167Z"^^xsd:dateTime;
    skos:prefLabel "Bevrijding Haarle"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Op 9 april 1945 kwamen de Canadezen op het grondgebied van Haarle, maar de Duitsers waren hier nog aanwezig en vochten voor hun leven. Tien Canadezen en evenzoveel Duitsers kwamen om het leven en vele boerderijen werden verwoest. Na deze strijd was Haarle bevrijd. De omgekomen Candadezen werden later overgebracht naar de Canadese begraafplaats te Holten en de Duitsers werden op de militaire begraafplaats te IJsselstein begraven."@nl .
  
