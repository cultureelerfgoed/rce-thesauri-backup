    <http://schema.org/startDate> "1945-05-03"^^xsd:date;
    dcterms:source "https://en.wikipedia.org/w/index.php?title=SS_Deutschland_(1923)&oldid=1150927873"@en;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/3688>, <https://data.niod.nl/WO2_Thesaurus/3511>,
      <https://data.niod.nl/WO2_Thesaurus/5140>;
    dcterms:created "2023-04-24T14:42:56.506Z"^^xsd:dateTime;
    skos:prefLabel "Scheepsramp Deutschland"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "De Scheepsramp met de Deutschland vond plaats op 3 mei 1945 in de Lübecker Bocht. De SS Deutschland was een Duits passagiersschip uit 1921 waarmee een paar duizend gevangenen uit het concentratiekamp Neuengamme werden getransporteerd. Er lagen in de buurt ook vele Duitse oorlogsschepen en enkele andere schepen die ook gevangenen uit Neuengamme transporteerde zoals de Cap Arcona met 5.000 gevangenen en de Thielbek met 2.800 gevangenen. De groep schepen werd op 3 mei 1945 gebombardeerd door de 198 Squadron van de Royal Air Force. De Deutschland zonk, maar er vielen geen slachtoffers. Bij de zinkende schepen zijn in totaal ruim 7000 gevangenen om het leven gekomen en zo'n 350 mensen overleefden de ramp."@nl;
    skos:altLabel "Ramp in de Lübeckerbocht"@nl, "Bombardement in de Lübeckerbocht"@nl,
      "SS Deutschland"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/11206>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
