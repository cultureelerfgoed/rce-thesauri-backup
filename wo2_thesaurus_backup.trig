    <http://schema.org/description> "De Capitulatie van Japan wordt door keizer Hirohito via een eerder opgenomen boodschap op de radio bekend gemaakt. Eerder op 10 augustus 1945 had de Japanse minister van Buitenlandse zaken laten weten dat zijn land bereid is de geallieerde voorwaarden te accepteren."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1593>, <https://data.niod.nl/WO2_Thesaurus/2326>,
      <https://data.niod.nl/WO2_Thesaurus/5110>, <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2016-10-04T11:45:13.000Z"^^xsd:dateTime;
    skos:prefLabel "Capitulatie van Japan"@nl, "VJ-Day"@de, "VJ-Day"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Met de Capitulatie van Japan, internationaal bekend als VJ-Day, komt de Tweede Wereldoorlog definitief ten einde kwam. Eigenlijk gaat het om twee data: de dag waarop de capitulatie bekend werd gemaakt (15 augustus 1945) en de dag waarop de capitulatie-overeenkomst ondertekend werd (2 september 1945)."@nl;
    skos:altLabel "VJ-Day"@nl, "VP-Day"@en, "Victory in the Pacific Day"@en, "Victory over Japan Day"@en .
  
