    <http://schema.org/startDate> "1943-05-26"^^xsd:date;
    dcterms:source "https://www.wikiwand.com/nl/Holocaust_in_Nederland"@nl, "http://www.zuidelijkewandelweg.nl/archief/tijdtijn/razzia's.htm#26%20mei%201943"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2005>, <https://data.niod.nl/WO2_Thesaurus/2056>;
    dcterms:created "2020-07-21T13:05:54.000Z"^^xsd:dateTime;
    skos:prefLabel "Razzia Amsterdam 26 mei 1943"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Bij de Razzia van 26 mei 1943 werden ongeveer 3000 Joden uit Amsterdam-Centrum opgepakt en gedeporteerd. Het Muiderpoortstation was de verzamelplaats waar de opgepakte Joden urenlang moesten wachten op de trein naar Westerbork. Op het terrein werd een foto-reportage gemaakt in opdracht van het weekblad van de Germaanse SS in de Nederlanden, Storm. Een aantal van deze foto's werd in het nummer van 4 juni afgedrukt als onderdeel van een artikel dat eindigde met de zin: ‘Het afscheid is ons niet zwaar gevallen.’"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/locations/8306>;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
