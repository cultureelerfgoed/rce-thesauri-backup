    skos:prefLabel "Instructie-Bataljon"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Instructie-Bataljon was een krijgsgevangenkamp in Magelang op Midden-Java. Het kampement lang in het centrum van Magelang en was ondergebracht in de KNIL-gebouwen zuidwestelijk van het exercitieterrein. In het kamp zijn 300 krijgsgevangenen geïnterneerd geweest."@nl;
    skos:altLabel "Kaderschool"@nl, "Kampement Instructie Bat. in Magelang"@nl, "Instructiebataljon"@nl .
  
