      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "J.N. Houterman, De Groep Van Beest : geschiedenis van een Walcherse verzetsgroep, 1940-1943 (Middelburg : Houterman, 1999)"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-02-23T09:38:11.060Z"^^xsd:dateTime;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/2669>;
