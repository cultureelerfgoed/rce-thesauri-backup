    dcterms:created "2017-02-01T13:26:26.000Z"^^xsd:dateTime;
    skos:prefLabel "Getto van Lublin"@nl, "Ghetto Lublin"@de, "Ghetto of Lublin"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Het getto van Lublin in het Poolse Lublin werd opgericht in maart 1941. Bij de oprichting van het getto woonden er 34.000 joden en een onbekend aantal Roma. Tussen 17 maart en 11 april 1942 werden ongeveer 30.000 bewoners naar hun dood in het vernietigingskamp van Bełżec gebracht en ongeveer 4.000 andere naar Majdanek. Daarna werd het getto ontruimd."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/5020> a <http://schema.org/Thing>, skos:Concept,
