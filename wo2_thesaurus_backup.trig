    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/ed0d2d9c-025a-11e7-904b-d89d6717b464/media/03d5dc02-fa72-8c37-31b0-e690c10041b7";
    <http://schema.org/location> "Middellandse Zee";
    <http://schema.org/startDate> "1942-06-14"^^xsd:date;
    skos:relatedMatch <https://data.niod.nl/WO2_biografieen/Ary-Romijn>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3511>;
    dcterms:created "2021-09-29T12:15:29.182Z"^^xsd:dateTime;
    skos:prefLabel "Scheepsramp Aagtekerk"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Scheepsramp met de Aagtekerk vond plaats op 14 juni 1942. De Aagtekerk was een Nederlands schip van de Vereenigde Nederlandsche Scheepvaartmaatschappij (VNS) dat onderdeel werd van Operatie Vigorous. De Aagtekerk kon echter het konvooi vanuit Egypte niet bijhouden en moest op 14 juni 1942 afhaken en richting Tobroek varen. Het schip kwam onder vuur van Duitse vliegtuigen en werd tot zinken gebracht met 15 dodelijke slachtoffers tot gevolg. In januari had het schip nog een Duitse U-boot geramd waardoor aan een wraakactie werd gedacht. Kapitein A. Romijn overleefde de ramp en zou vele malen gedecoreerd worden voor zijn heldhaftige optredens in de Tweede Wereldoorlog."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/1870> .
  
