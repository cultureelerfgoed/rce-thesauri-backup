  <https://data.niod.nl/WO2_Thesaurus/corporaties/4725> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "H. Schippers, Zwart en Nationaal Front. Latijns georiënteerd rechts-radicalisme in Nederland (1922-1946) (Amsterdan 1986)"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2024-08-12T12:03:08.730Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1934-05-05"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/74f5bc6f-318c-4105-fe0a-a40d257917d5.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/df4a1b0c-025a-11e7-904b-d89d6717b464/media/74f5bc6f-318c-4105-fe0a-a40d257917d5";
    <https://data.niod.nl/organizationsWO2/endDate> "1939-04-11"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Het Zwart Front was een fascistische politieke partij onder leiding van Arnold Meijer. Zwart Front bestond van 5 mei 1934 tot 11 april 1939. Enkele dagen na de opheffing richtte Meijer het meer gematigde Nationaal Front op om meer aanhang te krijgen."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1899>, <https://data.niod.nl/WO2_Thesaurus/2506>,
      <https://data.niod.nl/WO2_Thesaurus/20640>;
    dcterms:created "2016-10-04T13:07:42.000Z"^^xsd:dateTime;
    skos:prefLabel "Schwarze Front"@de, "Black Front"@en, "Zwart Front"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Zwart Front was een Nederlandse fascistische beweging, die op 5 mei 1934 werd opgericht door Arnold Meijer (1905-1965). De partij richtte zich op Mussolini’s Italië en was revolutionair, antikapitalistisch en fel antisemitisch. De geringe aanhang van Zwart Front bestond hoofdzakelijk uit katholieken. In zijn streven om een bredere aanhang te verwerven hief Meijer op 11 april 1939 Zwart Front op en richtte hij negen dagen later Nationaal Front op."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4588>;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Organization> .
  
