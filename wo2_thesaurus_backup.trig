    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/wiki/File:Weesperstraat.jpg";
    dcterms:source "https://www.joodsamsterdam.nl/synagoge-weesperstraat-fedderstichting/"@nl,
      "https://www.delpher.nl/nl/kranten/view?query=fedderstichting&page=1&maxperpage=50&sortfield=datedesc&coll=ddd&identifier=ddd:010858295:mpeg21:a0052&resultsidentifier=ddd:010858295:mpeg21:a0052&rowid=9"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/20698>;
    dcterms:created "2022-02-17T14:36:34.458Z"^^xsd:dateTime;
    skos:prefLabel "Catharina en Isaac Joseph Fedderstichting"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Catharina en Isaac Joseph Fedderstichting, ook wel Ohel Jitschok genoemd, was een bejaardentehuis voor Joodse mannen in Amsterdam. Het tehuis werd opgericht in 1894. Tijdens de oorlog werden alle bewoners slachtoffer van de nazi's. Vanaf 1953 beheerde de Fedderstichting een nieuw bejaardentehuis in Amsterdam: Beth Menoechah."@nl;
    skos:altLabel "Ohel Jitschok"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/18702> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
