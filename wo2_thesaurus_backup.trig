    skos:prefLabel "A.B.D.A.C.O.M."@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De American-British-Dutch-Australian Command, beter bekend onder de afkorting ABDACOM, was een samenwerkingsverband van de Amerikaanse, Britse, Nederlandse en Australische strijdkrachten, opgericht op 28 december 1941 en opgeheven op 25 februari 1942 (door toedoen van succesvolle Japanse militaire-missies). Het doel van de ABDACOM was, onder leiding van de Britse generaal Archibald Wavell, de Nederlandse en Britse koloniën te beschermen tegen een Japanse inval.  "@nl;
    skos:altLabel "American-British-Dutch-Australian Command"@en, "American-British-Dutch-Australian Command"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7730> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "Loe de Jong - Het Koninkrijk der Nederlanden in de Tweede Wereldoorlog"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-02-15T09:28:43.557Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8028>;
