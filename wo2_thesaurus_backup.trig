    skos:prefLabel "Bergen-Belsenproces"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Het Bergen-Belsenproces was een proces, geleid door een Britse krijgsraad en gehouden van 17 september 1945 tot 19 november 1945 in Lüneburg, waarin 45 SS’ers en kapo’s afkomstig van de concentratiekampen Bergen-Belsen en Auschwitz werden beschuldigd van misdaden tegen de menselijkheid. Het proces werd ook wel het Proces van Josef Kramer en 44 anderen genoemd. Een tweede proces werd gehouden van 13 tot 18 juni 1946."@nl;
    skos:altLabel "Bergen-Belsen Proces"@nl, "Proces van Josef Kramer en 44 anderen"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/6106> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:24:10.286Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/0/0a/Karl-Brandt.jpg/500px-Karl-Brandt.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Artsenproces#/media/Bestand:Karl-Brandt.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/a733fcd4-0259-11e7-904b-d89d6717b464/media/df3fc355-4cc6-4e26-527d-6f5354c407d4>;
    <http://schema.org/startDate> "1946-12-09"^^xsd:date;
    <http://schema.org/endDate> "1947-08-20"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Artsenproces&oldid=50604082"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/4399>;
    dcterms:created "2018-03-20T06:52:13.000Z"^^xsd:dateTime;
    skos:prefLabel "Artsenproces"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "Het Artsenproces vond plaats in Neurenberg en Frankfurt am Main en werd gehouden van 9 december 1946 tot 20 augustus 1947. Het was het eerste proces dat de Verenigde Staten na de Tweede Wereldoorlog voerden tegen verdachten van oorlogsmisdaden, vrijwel allemaal artsen. De 23 aangeklaagden in het Artsenproces werden onder meer beschuldigd betrokken te zijn geweest bij medische experimenten op gevangenen. Dit proces werd niet voor een internationaal tribunaal gehouden, maar voor een Amerikaanse rechtbank. Van de 23 verdachten werden er zeven volledig vrijgesproken, zeven anderen kregen de doodstraf en de rest kreeg gevangenisstraf variërend van tien jaar tot levenslang."@nl;
    skos:altLabel "Verenigde Staten van Amerika vs. Karl Brandt, et al."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
