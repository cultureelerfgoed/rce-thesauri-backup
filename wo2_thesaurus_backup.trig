    dcterms:source "https://www.lexikon-provenienzforschung.org/dorotheum"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/ravend>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2163>, <https://data.niod.nl/WO2_Thesaurus/2210>;
    dcterms:created "2026-02-18T11:16:49.054Z"^^xsd:dateTime;
    skos:prefLabel "Dorotheum Versteigerung"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het Dorotheum is een Oostenrijks veilinghuis, opgericht in 1707 en gevestigd in Wenen aan de Dorotheergasse 17. Het Dorotheum ontwikkelde zich tot een van de belangrijkste veilinghuizen in Centraal-Europa. Na de Anschluss in 1938 kwam het onder nationaal-socialistische leiding en werden joodse medewerkers ontslagen. Tijdens de Tweede Wereldoorlog fungeerde het als veilingplatform voor geconfisqueerde kunst en bezittingen. In Nederland verwierf het Dorotheum kunst door bemiddeling van Johann Hans Herbst via instellingen zoals de Dienststelle Mühlmann en Kunsthandel voorheen J.Goudstikker N.V. bst. Het veilinghuis bestaat tot op heden."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/21926> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-02-23T12:25:02.986Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/21967>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/wiki/File:Palais_Leuchtenberg.jpg#/media/Datei:Palais_Leuchtenberg.jpg"@nl;
    dcterms:source "https://de.wikipedia.org/wiki/Adolf_Weinm%C3%BCller"@nl, "https://www.zikg.eu/forschung/projekte/projekte-zi/weinmueller"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/ravend>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2163>, <https://data.niod.nl/WO2_Thesaurus/2210>;
    dcterms:created "2026-02-18T11:16:49.065Z"^^xsd:dateTime;
    skos:prefLabel "Münchener Kunstversteigerungshaus Adolf Weinmüller"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het Münchener Kunstversteigerungshaus Adolf Weinmüller was een Duits veilinghuis dat in 1936 door Adolf Weinmüller werd opgericht in het Leuchtenberg-Palais in München. Tijdens de oorlog speelde het veilinghuis een belangrijke rol in de verkoop van geconfisqueerde kunst. In Nederland verwierf het veilinghuis veel kunst via handelaar D. Katz en in nog grotere mate via A. Miedl. In 1958 werd het veilinghuis overgenomen door Rudolf Neumeister.  Tot 1978 werd het voortgezet onder de originele naam, daarna verder gevoerd als Neumeister Münchener Kunstauktionshaus dat tot op heden bestaat."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/21927> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
