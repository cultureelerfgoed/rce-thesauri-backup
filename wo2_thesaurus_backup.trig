    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://www.oorlogsbronnen.nl/zoekresultaat?id=http%3A%2F%2Farchievenwo2.nl%2Farchieven%2Farchief-blok%2F2147438724>;
    <http://schema.org/startDate> "2000-12-12"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/8386>;
    dcterms:created "2019-04-24T13:24:38.000Z"^^xsd:dateTime;
    skos:prefLabel "Oprichting Stichting Het Gebaar"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Oprichting Stichting Het Gebaar vindt plaats op 12 december 2000 door de regering. Dit 'gebaar' houdt in dat de regering 350 miljoen gulden voor individuele uitkeringen en 35 miljoen voor collectieve doelen beschikbaar stelt aan de Indische gemeenschap. De 385 miljoen gulden is bedoeld als tegemoetkoming vanwege ‘vermoedelijke tekortkomingen in het naoorlogse rechtsherstel’ en een overheidsbeleid dat ‘kil, formalistisch en bureaucratisch’ is geweest."@nl .
  
