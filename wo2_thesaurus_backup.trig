      "https://wikimiddenbrabant.nl/Fusillade_Gorp_en_Rovert,_Goirle,_15_augustus_1942."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/9271>;
    dcterms:created "2020-09-30T12:04:43.000Z"^^xsd:dateTime;
    skos:prefLabel "Fusillade in Goirle, 15 augustus 1942"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De fusillade in Goirle vond plaats op 15 augustus 1942. De Duitsers fusilleerden vijf gijzelaars uit de kampen Haaren en Beekvliet (Sint- Michielsgestel) in de bossen van \"Gorp en Roovert\". De actie werd uitgevoerd op bevel van Christiansen als represaille voor de sabotage aan een spoorlijn in Rotterdam op 7 augustus 1942."@nl .
  
