    skos:scopeNote "Aussenlager Grafenreuth was van eind juni 1943 tot april 1945 een buitenkamp van Flossenbürg."@nl;
    skos:altLabel "Aussenlager Grafenreuth"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
