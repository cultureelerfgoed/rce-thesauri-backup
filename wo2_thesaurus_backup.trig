    <http://schema.org/startDate> "1942-08-06"^^xsd:date;
    dcterms:source "https://www.oorlogsdodennijmegen.nl/gebeurtenis/febd53ce-a1d3-45af-ac87-f52ca44cf0a9"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2329>;
    dcterms:created "2023-10-12T14:17:59.720Z"^^xsd:dateTime;
    skos:prefLabel "Vliegtuigcrash bij Posterholt"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De vliegtuigcrash bij Posterholt vond plaats op 6 augustus 1942. Een Halifax MKII bommenwerper van de RAF werd door een Duitse nachtjager geraakt en stortte neer bij Posterholt. Bemanningsleden Herbert Maurice Gall, John Richard Gilbert en John William Clarke overleefden de crash niet, maar J.C. Stevens, Greenacre, Shipley en Willoughby overleefden als krijgsgevangenen de oorlog."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
