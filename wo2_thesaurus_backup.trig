    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/0/08/Kauno_tvirtove2_2006-06-11.jpg?utm_source=commons.wikimedia.org&utm_campaign=index&utm_content=original";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/w/index.php?title=File:Kauno_tvirtove2_2006-06-11.jpg&oldid=1073048797";
    dcterms:source "https://en.wikipedia.org/w/index.php?title=Kaunas_Fortress&oldid=1365031012"@en;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2017>, <https://data.niod.nl/WO2_Thesaurus/1699>,
      <https://data.niod.nl/WO2_Thesaurus/8176>, <https://data.niod.nl/WO2_Thesaurus/6141>;
    dcterms:created "2026-09-24T13:53:34.815Z"^^xsd:dateTime;
    skos:prefLabel "Fort Kaunas"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Fort Kaunas is een complex van diverse forten rondom de Litouwse stad Kaunas (Kauen, Kowno). Tijdens de Sovjetbezetting van 1940 tot 1941 werden diverse forten gebruikt als gevangenis voor politieke gevangenen van het Narodnyy komissariat vnutrennikh del (NKVD, Volkscommissariaat voor Binnenlandse Zaken). Tijdens de Duitse bezetting van 1941 tot 1944 dienden verschillende forten als krijgsgevangenkamp voor Sovjetsoldaten, en als concentratiekamp en executieplaats voor Joden uit Oost-Europa, Frankrijk, Duitsland, Oostenrijk en Nederland. In Fort VII werden 3.000 Joden vermoord, in Fort IV 1.800 en in het Fort IX 9.000. In totaal kwamen in de forten ongeveer 50.000 personen om."@nl;
    skos:altLabel "Fort van Kaunas"@nl, "Fort Kauen"@nl, "Fort Kowno"@nl, "Kauno tvirtovė"@nl,
      "Кοвенская крепость"@nl, "Festung Kowno"@de, "Kaunas Fortress"@en .
  
