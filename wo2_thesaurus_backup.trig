    dcterms:source "https://decrommeleeck.nl/files/CROMME%20LEEK%20SPANBROEK%20OPMEER%2075%20jaar%205%20borden%20Vrijheid%20LR%20WEB_05.pdf"@nl;
    <https://data.niod.nl/organizationsWO2/isCausedBy> <https://data.niod.nl/WO2_Thesaurus/20557>;
