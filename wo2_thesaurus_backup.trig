    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://www.nationaalarchief.nl/onderzoeken/archief/2.09.06>,
      <https://beeldbankwo2.nl/nl/beelden/detail/073a43a4-025a-11e7-904b-d89d6717b464/media/d4cd6a59-170b-5b60-0a6d-32e3961ba575?mode=detail&view=horizontal&q=portugees&rows=1&page=8>,
      <https://www.openarch.nl/show.php?archive=nim&identifier=cb58e83f-6855-de5f-eb5c-3cbc0d896d56>;
    <http://schema.org/startDate> "1942-02-19"^^xsd:date;
    <http://schema.org/endDate> "1943-02-10"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Slag_om_Timor&oldid=53239471"@nl;
    <http://schema.org/description> "Een strijdmacht van circa 300 Australische en 600 Nederlandse militairen gaat onder leiding van luitenant-kolonel N.L.W. van Straten aan land in Dilly, de hoofdplaats van Portugees Timor om de opmars van de Japanners te stuiten. Op 20 februari 1942 landen circa 3.650 Japanse militairen bij Koepang en Dilly. Het korvet HMAS Armidale, dat met versterkingen naar het eiland onderweg is, wordt door Japanse vliegtuigen tot zinken gebracht. In december 1942 worden de laatste 190 KNIL-soldaten naar Australië geëvacueerd. Op 11 februari 1943 worden de laatste Australische soldaten van Timor teruggehaald."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2350>, <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2019-03-19T13:19:43.000Z"^^xsd:dateTime;
    skos:prefLabel "Slag om Timor"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Tijdens de Slag om Timor, van 19 februari 1942 - 10 februari 1943, strijden KNIL-militairen samen met Australische militairen tegen Japanse strijdkrachten. Voor de Verdediging van Portugees Timor ging op 17 december 1941 een strijdmacht van circa 300 Australische en 600 Nederlandse militairen aan land. De Slag wordt gewonnen door de Japanners. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4551>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4447>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
