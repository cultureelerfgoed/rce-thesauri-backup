    skos:prefLabel "Reisverbod voor Sinti en Roma"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:exactMatch <https://digitaalerfgoed.poolparty.biz/westerbork/2938>;
    skos:scopeNote "Het reisverbod voor Sinti en Roma en woonwagenbewoners, of het trekverbod, werd ingevoerd op 1 juli 1943. De wielen van de woonwagens werden in beslag genomen of moesten eraf gehaald worden. Ook paarden werden in beslag genomen."@nl;
    skos:altLabel "Trekverbod"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
