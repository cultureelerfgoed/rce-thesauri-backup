    skos:broader <https://data.niod.nl/WO2_Thesaurus/3455>;
    dcterms:created "2025-08-13T08:59:34.303Z"^^xsd:dateTime;
    skos:prefLabel "Israelitische gezondheidskolonie Rotterdam Liesbosch"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Israelitische gezondheidskolonie Rotterdam was een initiatief van de Rotterdamse Joodse gemeenschap om bleekneusjes te laten aansterken in de zomermaanden. Het bevond zich bij het Liesbosch in Etten-Leur. Tussen januari en april 1939 werden hier Joodse vluchtelingenkinderen opgevangen."@nl;
    skos:altLabel "Liesbosch"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/21765> a <http://schema.org/Thing>, skos:Concept;
