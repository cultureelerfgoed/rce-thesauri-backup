  <https://data.niod.nl/WO2_Thesaurus/11450> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    dcterms:modified "2021-04-15T07:39:19.563Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/fd92eed2-3c5f-7cd9-fe32-241d068f7949.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/d5e04b3c-0259-11e7-904b-d89d6717b464/media/fd92eed2-3c5f-7cd9-fe32-241d068f7949";
    <http://schema.org/startDate> "1936-03-09"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/11439>;
    dcterms:created "2021-04-07T12:26:05.540Z"^^xsd:dateTime;
    skos:prefLabel "Oprichting van de Internationale Zigeunercentrale"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Oprichting van de Internationale Zigeunercentrale vond plaats op 9 maart 1936 toen deze officieel werd geactiveerd. Het initiatief tot de oprichting van een internationale Zigeunercentrale werd genoemd in een brief van 30 juli 1931 van de Oostenrijkse bondskanselier aan de leden van de Internationale Kriminalpoliteiliche Kommission (IKPK). Deze organisatie beoogde de internationale bestrijding van de misdaad. Eind 1938 verscheen een verordening (Runderlass) van Himmler met als opschrift 'Bekämpfung der Zigeunerplage'. In mei 1940 vonden de eerste deportaties van rond 2.500 Sinti en Roma plaats vanuit west- en noordwest Duitsland."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/11451> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:18:05.053Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/57cc31df-d009-db68-812e-37a398d1bf15.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/8ab4d924-025a-11e7-904b-d89d6717b464/media/57cc31df-d009-db68-812e-37a398d1bf15";
    <http://schema.org/startDate> "1937-12-30"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/11441>;
    dcterms:created "2021-04-07T12:26:20.215Z"^^xsd:dateTime;
    skos:prefLabel "Oprichting van de Nederlandse Zigeunercentrale"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Oprichting van de Nederlandse Zigeunercentrale vond plaats op 30 december 1937 en werd in het Algemeen Politieblad bekendgemaakt. Het Besluit van 23 december 1937 van de minister van Justitie luidde: 1. De inspecteur der Koninklijke Marechaussee is belast met de registratie van alle hier te lande vertoevende Zigeuners waaronder in dit verband zijn te verstaan: woonwagenbewoners en andere zwervende personen; beide deze categorieën slechts voor zooverre de daaronder vallende personen niet de Nederlandsche nationaliteit bezitten. Deze registratie zal worden aangeduid met de naam: Nederlandsche Zigeuner Centrale."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/11452> a <http://schema.org/Thing>, skos:Concept;
