    skos:prefLabel "Bombardement op Ermelo"@nl, "Bombardierung von Ermelo"@de, "Bombing of Ermelo"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Het bombardement te Ermelo vond plaats op 7 november 1944. Vliegtuigen van  de Royal Air Force trachtten de spoorlijn bij Ermelo te bombarderen. In plaats daarvan werd echter het woonhuis aan de Julianalaan 74 getroffen, waardoor 9 mensen om het leven kwamen."@nl;
    skos:altLabel "Bombardement Ermelo"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
