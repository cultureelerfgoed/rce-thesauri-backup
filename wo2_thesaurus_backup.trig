  <https://data.niod.nl/WO2_Thesaurus/corporaties/4504> a <http://schema.org/Thing>,
      skos:Concept;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:34:30.605Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/8/8c/Map_used_to_illustrate_Stahlecker%27s_report_to_Heydrich_on_January_31%2C_1942.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Einsatzgruppen#/media/File:Map_used_to_illustrate_Stahlecker%27s_report_to_Heydrich_on_January_31,_1942.jpg";
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Einsatzgruppen&oldid=46730989"@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2005>, <https://data.niod.nl/WO2_Thesaurus/1854>;
    dcterms:created "2016-10-04T13:07:39.000Z"^^xsd:dateTime;
    skos:prefLabel "Einsatzgruppen"@de, "Einsatzgruppen "@en, "Einsatzgruppen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Einsatzgruppen zijn paramilitaire groepen uit het Derde Rijk die voor en tijdens de Tweede Wereldoorlog actief waren aan het Oostfront. De missie van de Einsatzgruppen was om alle weerstand achter de Duitse frontlinie uit te schakelen en het doden van specifieke groepen zoals Joden, communisten, zigeuners, homoseksuelen, intellectuelen, gehandicapten en partizanen."@nl;
    skos:definition "Einsatzgruppen zijn paramilitaire groepen uit het Derde Rijk die voor en tijdens de Tweede Wereldoorlog actief waren aan het Oostfront. Deze eenheden, die bestonden uit leden van de Sicherheitspolizei (Sipo), Sicherheitsdienst (SD), Ordnungspolizei (Orpo) en Waffen-SS, volgden de Wehrmacht in het spoor van haar opmars. De missie van de Einsatzgruppen was om alle weerstand achter de Duitse frontlinie uit te schakelen. De Einsatzgruppen doodden in hun ogen 'ongewenste elementen' zoals Joden, communisten, zigeuners, homoseksuelen, intellectuelen, gehandicapten en partizanen. De slachtoffers waren voornamelijk burgers die zonder enige vorm van proces werden vermoord."@nl .
  
