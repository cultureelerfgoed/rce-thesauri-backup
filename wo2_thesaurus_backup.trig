    skos:prefLabel "Hachsjara Elden"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Hachsjara Elden bevond zich in Huize Voorburg. Vanaf januari 1941 was dit een agrarisch opleidingscentrum waar Palestina Pioniers zich voorbereiden op emigratie naar Palestina. Een groot deel van de leerlingen waren Joodse vluchtelingenkinderen."@nl;
    skos:altLabel "Huize Voorburg"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/21761> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    dcterms:modified "2025-08-12T12:55:02.582Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/21762>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4631>;
    dcterms:created "2025-08-12T11:42:16.215Z"^^xsd:dateTime;
    skos:prefLabel "Hachsjara Enschede"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Hachsjara Enschede was een agrarisch opleidingscentrum waar Palestina Pioniers zich vanaf 1933 voorbereiden op emigratie naar Palestina. In negen jaar tijd werden ongeveer 100 mensen, vooral mannen, opgeleid. Het grootste deel was gevlucht uit nazi Duitsland."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/21763> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    dcterms:modified "2025-08-18T09:29:37.598Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/21764>;
