  <https://data.niod.nl/WO2_Thesaurus/2586> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:references "M. de Geus, 'Vrederechtspraak in Nederland', in: G. Aalders e.a., Zesde jaarboek van het Rijksinstituut voor Oorlogsdocumentatie (Zutphen 1995)"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/VosJ>;
    dcterms:modified "2026-07-21T11:29:38.374Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1941-08-16"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/84a29f84-e224-1d8f-0f8e-6a52183bbdcf.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/ce9c866a-0259-11e7-904b-d89d6717b464/media/84a29f84-e224-1d8f-0f8e-6a52183bbdcf";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://hdl.handle.net/21.12123/2076>,
      <http://resolver.kb.nl/resolve?urn=urn:gvn:EVDO02:NIOD05_0790>;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Vrederechtspraak&oldid=32299455"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-06"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Vrederechtspraak was een nationaalsocialistische juridische instantie opgericht in 1941. De Vrederechtspraak richtte zich op het berechten van politieke tegenstanders van het nationaalsocialisme. Zogenaamde vredesrechters, meestal overtuigde nationaalsocialisten, werden ingesteld bij de arrondissementsrechtbanken in Amsterdam, Arnhem, Den Bosch, Den Haag en Leeuwarden. Het Vredesgerechtshof behandelde zaken als personen in hoger beroep gingen tegen de uitspraak van de vredesrechters."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/demoadmin>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2568>, <https://data.niod.nl/WO2_Thesaurus/20701>;
    dcterms:created "2016-08-01T19:20:44.000Z"^^xsd:dateTime;
    skos:prefLabel "'Vrederechtspraak'"@de, "'Vrederechtspraak'"@en, "Vrederechtspraak"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Vrederechtspraak was een nationaalsocialistisch juridisch orgaan, dat in de zomer van 1941 werd ingevoerd. De Vrederechtspraak moest alle misdrijven en overtredingen bestraffen die ‘den politieken vrede binnen de volksgemeenschap’ brachten, maar richtte zich in werkelijkheid tegen tegenstanders van het nationaalsocialisme. Bij de arrondissementsrechtbanken van Amsterdam, Arnhem, Den Bosch, Den Haag en Leeuwarden werden een uit één lid bestaande (enkelvoudige) kamers ingesteld, waarvan de leden de titel vredesrechter droegen. Bij het Gerechtshof van Den Haag werd een met drie leden rechtsprekende bijzondere kamer ingesteld, genaamd Vredegerechtshof, die was belast met de rechtspraak in hoger beroep. Alle aangestelde vrederechters waren overtuigde nationaalsocialisten en de meesten behoorden tot de NSB."@nl .
  
