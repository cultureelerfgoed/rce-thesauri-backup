    <http://schema.org/location> "Lingewaard";
    <http://schema.org/startDate> "1944-10-09"^^xsd:date;
    <http://schema.org/endDate> "1944-11-21"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1922>;
    dcterms:created "2022-01-06T12:20:19.889Z"^^xsd:dateTime;
    skos:prefLabel "Evacuatie van de Lingewaard"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Evacuatie van de Lingewaard vond plaats op last van de bezetter vanwege aanhoudende geallieerde bombardementen in het gebied. Op 9 oktober 1944 werd Gendt geëvacueerd, daarna volgden Angeren en Doornenburg. De evacués vertrokken via Pannerden naar Zevenaar en Lobith en andere plaatsen in de gemeente Herwen en Aerdt. De evacués moesten echter op last van de Wehrmacht de gemeente uiterlijk 21 november 1944 verlaten. Van de ongeveer 3.500 evacués verbleven er aan het einde van december 1944 nog ongeveer 700 in Herwen en Aerdt."@nl .
  
