    dcterms:created "2019-01-30T10:04:27.000Z"^^xsd:dateTime;
    skos:prefLabel "Groep-De Lange"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Groep-De Lange bestond vanaf het begin van de Japanse bezetting tot augustus 1942 en werd opgezet door KNIL-kapitein R.G. de Lange. Na de capitulatie moest hij als Nippon-werker op het hoofdbureau van de Staatsspoorwegen doorwerken. Tot zijn arrestatie hielp hij het verzet met transporten en probeerde hij wapens te bemachtigen. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
