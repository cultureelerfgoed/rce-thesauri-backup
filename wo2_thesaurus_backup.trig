      <http://resolver.kb.nl/resolve?urn=ddd:010314465:mpeg21:a0096>, <https://www.4en5mei.nl/herdenken-en-vieren/oorlogsmonumenten/monumenten_zoeken/oorlogsmonument/1884>;
    <http://schema.org/startDate> "1942-07-13"^^xsd:date;
    dcterms:source "https://www.regionaalarchiefalkmaar.nl/collecties/archieven/archieven-2/search/list/withscans/0/findingaid/0623/file/298/start/0/limit/10/flimit/5  "@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2244>;
    dcterms:created "2020-10-07T09:16:16.000Z"^^xsd:dateTime;
    skos:prefLabel "Wieringermeer onder NSB-bestuur"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Het Wieringermeer onder NSB-bestuur begon op 13 juli 1942, nadat burgemeester Gerrit Gesinus Loggers door de bezetter werd geïnterneerd in Kamp Haaren. Wethouder, boer en NSB’er Aris Saal werd aangewezen als tijdelijk burgemeester, in herfst 1943 omgezet naar permanent burgemeesterschap. Op de dag van gevangenschap van burgemeester Loggers, bood wethouder, boer en verzetsman A.C. de Graaf zijn ontslagbrief aan. De gijzeling van burgemeester Loggers duurde tot 20 december 1943, hij dook voor de rest van de oorlog onder."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/kampen/4880>, <https://data.niod.nl/WO2_Thesaurus/1738> .
  
