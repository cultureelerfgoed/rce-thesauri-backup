    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Nenasu&oldid=52902741"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1773>;
    dcterms:created "2019-09-04T19:57:24.000Z"^^xsd:dateTime;
    skos:prefLabel "Nenasu"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Nenasu (Nederlandsch Nationaal Socialistische Uitgeverij) was een Nederlandse uitgeverij, opgericht op 2 februari 1934 door ir. Anton Adriaan Mussert. De Nenasu had tot doel: het uitgeven van boeken, periodieken, dagbladen, brochures [...] alles in den ruimsten zin, en een en ander ter verspreiding van de Nationaal-Socialistische Levenbeschouwing in Nederland. Na de bevrijding werd, tot de liquidatie in 1948, de Nenasu beheerd door het Nederlands Beheersinstituut."@nl;
    skos:altLabel "Nederlandsch Nationaal Socialistische Uitgeverij"@nl, "Nederlandsche Nationaal-Socialistische Uitgeverij"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/8581> a <http://schema.org/Thing>,
