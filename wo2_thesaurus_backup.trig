    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Luftwaffe was de Duitse luchtmacht. In de Luftwaffe diende een onbekend aantal Nederlandse vrijwilligers. Nederlanders die bij de Luftwaffe gingen, verloren hun Nederlandse nationaliteit."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
