    <http://schema.org/startDate> "1924-04-01"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/wiki/Fleet_Air_Arm"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/17380>;
    dcterms:created "2021-08-19T14:25:40.622Z"^^xsd:dateTime;
    skos:prefLabel "Oprichting Fleet Air Arm"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Op 1 april 1942 werd de Fleet Air Arm of the Royal Air Force opgezet als onderdeel van de RAF. De dienst bevatte RAF-onderdelen die inscheepten op vliegdekschepen en slagschepen. Op 14 mei 1937 keerde de FAA terug onder de controle van de Britse Admiraliteit. "@nl;
