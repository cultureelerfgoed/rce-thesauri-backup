    <http://schema.org/location> "Tiel"@nl;
    <http://schema.org/startDate> "1944-12-24"^^xsd:date;
    dcterms:source "https://www.tracesofwar.nl/sights/107975/Gedenkteken-Oorlogsslachtoffers-Tiel.htm"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/9271>;
    dcterms:created "2020-09-30T12:24:05.000Z"^^xsd:dateTime;
    skos:prefLabel "Fusillade in Tiel, 24 december 1944"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Fusillade in Tiel vond plaats op 24 december 1944. Er werden vijf gijzelaars op de binnenplaats van de gevangenis in Tiel door de bezetter gefusilleerd. Het betrof een represaille-actie ter vergelding van eerdere actie van het verzet waarbij een gevangene uit het politiebureau in Tiel was bevrijd."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9548> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:26:47.395Z"^^xsd:dateTime;
