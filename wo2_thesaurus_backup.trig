    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Een dagvaarding was een oproep aan een verdachte of getuige om in de rechtbank te verschijnen. Als deze werd ingetrokken hoefde de persoon niet meer te komen op de tijd en locatie die genoemd stond in de dagvaarding. Dit kon zijn omdat de zaak later zou worden hervat, of omdat de zaak werd stopgezet."@nl,
      "Een annulering van de oproep aan een verdachte of getuige om in de rechtbank te verschijnen. De verdachte of getuige hoefde niet meer in de rechtbank te verschijnen. Dit kon gebeuren als de zaak (tijdelijk) werd stopgezet."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/baltussenl_2>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/19590>;
    dcterms:created "2024-11-06T12:23:43.722Z"^^xsd:dateTime;
    skos:prefLabel "Dagvaarding - intrekking"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "Een dagvaarding was een oproep aan een verdachte of getuige om in de rechtbank te verschijnen. Als de dagvaarding werd ingetrokken, hoefde de verdachte of getuige niet meer in de rechtbank te verschijnen. Dit kon gebeuren als de zaak (tijdelijk) werd stopgezet."@nl;
    skos:altLabel "Intrekking dagvaarding"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/21395> a <http://schema.org/Thing>, skos:Concept,
