    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/dc8521ce-0259-11e7-904b-d89d6717b464/media/1d70c35d-a434-8bc3-93a7-f783505f4885";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://www.nationaalarchief.nl/onderzoeken/fotocollectie/ac161d86-d0b4-102d-bcf8-003048976d84>,
      <https://www.delpher.nl/nl/kranten/view?coll=ddd&identifier=ddd:010405720:mpeg21:a0047>;
    <http://schema.org/startDate> "1944-07-26"^^xsd:date;
    <http://schema.org/endDate> "1944-07-27"^^xsd:date;
    dcterms:source "https://ww2db.com/battle_spec.php?battle_id=75"@en;
    <http://schema.org/description> "Op initiatief van president Roosevelt vindt in Honolulu op Hawaii een conferentie plaats over de te volgen strategie in de Pacific. De twee rivaliserende Amerikaanse commandanten, Chester W. Nimitz (opperbevelhebber Pacific Ocean Areas) en Douglas MacArthur (opperbevelhebber South West Pacific Area), zetten voor president Roosevelt en zijn chef-staf William D. Leahy persoonlijk hun plannen uiteen. Nimitz pleit voor een invasie van Formosa, MacArthur wil de Filippijnen bevrijden. Twee maanden later, in september 1944, besluiten de Amerikaanse verenigde chefs van staven tot het laatste. MacArthur krijgt de kans zijn belofte ‘I shall return’, uitgesproken bij zijn vlucht in 1942, in te lossen. "@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2350>, <https://data.niod.nl/WO2_Thesaurus/2629>;
    dcterms:created "2019-03-29T09:34:51.000Z"^^xsd:dateTime;
    skos:prefLabel "Pearl Harbor Conferentie"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Tijdens de Pearl Harbor Conferentie, van 26 tot 27 juli 1944, bespreken de Amerikanen de strategie voor de strijd in de Pacific. Chester W. Nimitz, opperbevelhebber Pacific Ocean Areas, pleit voor een invasie van Formosa, Douglas MacArthur, opperbevelhebber South West Pacific Area, wil de Filippijnen bevrijden. Twee maanden later, in september 1944, besluiten de Amerikaanse tot het bevrijden van de Filipijnen."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8231> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2023-12-07T15:49:14.431Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/18208>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/wo2nedindieThema> "Geallieerde oorlogsvoering in Azië";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/a/ac/Junyo_Maru.jpg/500px-Junyo_Maru.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/wiki/File:Junyo_Maru.jpg";
    <http://schema.org/location> "Indische Oceaan";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://oorlogsgravenstichting.nl/persoon/36258/maximiliaan-droop>,
      <https://www.4en5mei.nl/oorlogsmonumenten/monumenten_zoeken/oorlogsmonument/2315>,
      <https://oorlogsgravenstichting.nl/persoon/109793/egbert-nienkemper>;
    <http://schema.org/startDate> "1944-09-18"^^xsd:date;
    dcterms:source "https://anderetijden.nl/programma/1/Andere-Tijden/aflevering/515/De-ondergang-van-de-Junyo-Maru"@nl;
    <http://schema.org/description> "Het Japanse transportschip Junyu Maru wordt op de Indische Oceaan tot zinken gebracht door de Engelse onderzeeboot HMS Tradewind. De Junyo Maru vervoert naar schatting 6.500 Javaanse dwangarbeiders en geallieerde krijgsgevangenen van Tandjong Priok naar Padang. Onder de krijgsgevangenen bevinden zich Nederlanders, Amerikanen, Engelsen en Australiërs. Naar schatting 5.620 opvarenden verliezen bij de scheepsramp het leven. Daarmee is de scheepsramp met de Junyo Maru de grootste uit de maritieme geschiedenis."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3511>, <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2019-03-29T09:56:00.000Z"^^xsd:dateTime;
    skos:prefLabel "Scheepsramp Junyo Maru"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Scheepsramp Junyo Maru, op 18 september 1944,  is één van de grootste scheepsrampen uit de maritieme geschiedenis. Het Japanse transportschip Junyo Maru werd op de Indische Oceaan tot zinken gebracht door de Engelse onderzeeboot HMS Tradewind. De Junyo Maru vervoerde naar schatting 6.500 Javaanse dwangarbeiders en geallieerde krijgsgevangenen van Tandjong Priok naar Padang waarvan circa 5.620 opvarenden omkomen."@nl .
  
