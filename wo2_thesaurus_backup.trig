    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/abf71d50-0259-11e7-904b-d89d6717b464/media/defa6d11-8606-eae8-9fac-9f0c354c0e11";
    dcterms:source "https://books.google.nl/books?id=qsRLEAAAQBAJ&pg=PA1958&lpg=PA1958&dq=stalag+XII-C+Wiebelsheim&source=bl&ots=sH8a_Afo50&sig=ACfU3U2YQvFXvCWjrVQhjiVafMDZAuxEDA&hl=nl&sa=X&ved=2ahUKEwjtsJ6N9671AhWB2qQKHXnLCCYQ6AF6BAgdEAM#v=onepage&q=stalag%20XII-C%20Wiebelsheim&f=false"@nl,
