    dcterms:source "https://www.levenindeliemers.nl/verhalen/57-de-evacuatie-van-duiven-westervoort-en-zevenaar"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
