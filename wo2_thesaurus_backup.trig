    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Kamp_Sint-Michielsgestel&oldid=63429965"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/4881>, <https://data.niod.nl/WO2_Thesaurus/events/2531>;
    dcterms:created "2023-01-11T11:07:08.395Z"^^xsd:dateTime;
    skos:prefLabel "Ontruiming Kamp Sint-Michielsgestel"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>,
      <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "De Ontruiming Kamp Sint-Michielsgestel vond plaats op 6 september 1944. Na 5 september 1944 (Dolle Dinsdag) en onder druk van oprukkende geallieerde troepen werden diverse kampen in Nederland ontruimd. Veel van de gegijzelden uit Kamp Sint-Michielsgestel werden vrijgelaten en een gedeelte werd naar Kamp Vught getransporteerd."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/19272> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:references "S.C. Kooijman, ‘Verraders waarvoor in een bevrijd Nederland geen plaats zal zijn’. Institutioneel onderzoek naar het beleidsterrein van de bijzondere rechtspleging, 1945-1952 (’s-Gravenhage: Rijksarchiefdienst, 2000), 49; A.D. Belinfante, In plaats van Bijltjesdag. De geschiedenis van de bijzondere rechtspleging na de Tweede Wereldoorlog (Assen: Van Gorcum, 1978), 617."@nl,
      "Bron: Paul van de Water, Collaboratie en Geweld. Radicalisering en extremisme tijdens de Duitse bezetting in Nederland (Utrecht 2022) 45-68."@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/baltussenl_2>;
    dcterms:modified "2026-08-17T12:58:01.746Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/download/default/fcf4bece-6a7b-e333-4474-a3bd0d2abac4.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/e1b725c0-0259-11e7-904b-d89d6717b464/media/fcf4bece-6a7b-e333-4474-a3bd0d2abac4"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Een Bijzonder Gerechtshof is een speciaal gerechtshof dat na de Tweede Wereldoorlog werd ingesteld om verdachten van collaboratie te berechten. Voor een Bijzonder Gerechtshof verschenen personen die verdacht werden van misdrijven zoals verraad of vrijwillige dienstneming in het Duitse leger. Bijzondere Gerechtshoven konden onder andere gevangenisstraffen en de doodstraf opleggen."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/16869>, <https://data.niod.nl/WO2_Thesaurus/16870>,
      <https://data.niod.nl/WO2_Thesaurus/16872>, <https://data.niod.nl/WO2_Thesaurus/16874>,
      <https://data.niod.nl/WO2_Thesaurus/16875>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1576>, <https://data.niod.nl/WO2_Thesaurus/20701>;
    dcterms:created "2023-01-13T12:16:31.868Z"^^xsd:dateTime;
    skos:prefLabel "Bijzondere Gerechtshoven"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "Bijzondere Gerechtshoven waren gerechtshoven die de Nederlandse regering in Londen op 22 december 1943 instelde om vermeende collaborateurs te berechten. Er zouden uiteindelijk 5 Bijzondere Gerechtshoven in werking treden ('s-Hertogenbosch, Amsterdam, Arnhem, Den Haag en Leeuwarden). De Bijzondere Gerechtshoven behandelden vooral de zaken van personen die verdacht werden van zware misdrijven. Ze waren bevoegd om levenslange detentie of de doodstraf op te leggen. In totaal hebben de Bijzondere Gerechtshoven aan ruim 14.000 personen straffen opgelegd. In 1950 werden de Bijzondere Gerechtshoven opgeheven."@nl;
    skos:altLabel "BGs"@nl, "Bijz. Gerechtshof"@nl, "Bijzonder Gerechtshof"@nl, "Bijzondere Gerechtshof"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/20629>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization>;
    skos:hiddenLabel "BG"@nl, "B.G."@nl .
  
