    dcterms:source "https://nl.wikipedia.org/wiki/Marnix_van_St._Aldegonde_(schip,_1930)"@nl;
    skos:relatedMatch <https://data.niod.nl/WO2_Thesaurus/events/6632>, <https://data.niod.nl/WO2_Thesaurus/events/6633>,
      <https://data.niod.nl/WO2_Thesaurus/17947>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3511>;
    dcterms:created "2021-11-10T13:15:07.950Z"^^xsd:dateTime;
    skos:prefLabel "Scheepsramp Marnix van St. Aldegonde"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Scheepsramp met de Marnix van Sint Aldegonde vond plaats op 6 en 7 november 1943. De Marnix was een Nederlands schip van de Stoomvaart Maatschappij 'Nederland' en was betrokken geweest bij Operatie Torch, Operatie Husky en Operatie Avalanche. Op 27 oktober 1943 vertrok het vanuit Liverpool wederom richting de Middellandse Zee met bestemming Alexandrië in konvooi KMF 25A, waarin nog 3 andere Nederlandse koopvaardijschepen zaten, om troepen te transporteren. Op 6 november werd het schip door Duitse gevechtsvliegtuigen gebombardeerd. Door een goede organisatie kon iedereen veilig het schip verlaten voordat het de volgende ochtend zonk. Er vielen geen slachtoffers. "@nl;
    skos:altLabel "Scheepsramp Marnix van Sint Aldegonde"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/1870> .
  
