    dcterms:created "2021-12-16T11:27:30.482Z"^^xsd:dateTime;
    skos:prefLabel "Crematorium V"@nl, "Krematorium V"@de, "Crematorium V"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Crematorium V was qua bouw en functie eenvoudiger dan II en III omdat het als vernietigingsplaats was ontworpen. Het werd in november 1942 in het aangrenzende berkenbos gebouwd. Crematorium V was vanaf april 1943 tot januari 1945 operationeel. Op 26 januari 1945 blies de SS het crematorium op."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/18493> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Kibboets Beverwijk. Palestina-pioniers in Velsen-Noord en Beverwijk, Saskia Sluiter, De Vrijstaat Roetz 2019"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:05:04.071Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/18499>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/3/34/Landarbeidster_uit_een_kibboets_met_een_schep%2C_Bestanddeelnr_255-1409.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/wiki/File:Landarbeidster_uit_een_kibboets_met_een_schep,_Bestanddeelnr_255-1409.jpg";
    <http://schema.org/startDate> "1935-10-27"^^xsd:date;
    <http://schema.org/endDate> "1938-03-01"^^xsd:date;
    dcterms:source "https://www.joodsamsterdam.nl/kibboets-beverwijk-chinoeg-habayit/"@nl,
      "https://oorlogsslachtoffersijmond.nl/categorie/57/beverwijk-kibboets-1939-42"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1892>;
    dcterms:created "2021-12-16T13:38:49.155Z"^^xsd:dateTime;
    skos:prefLabel "Kibboets Beverwijk, 1935-1938"@nl, "Kibbuz Beverwijk, 1935-1938"@de,
      "Kibbutz Beverwijk, 1935-1938"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De inwijding van Kibboets Beverwijk vond plaats 27 oktober 1935. De kibboets was onderdeel van de organisatie \"Dath-we-Eretz\", een mizrachie-hachsjarah beweging. Een aantal van de leerlingen in Beverwijk studeerde aan de landbouwschool van Assendelft. Men bereidde zich voor op het leven in Palestina. In de eerste periode van 1935-1938 was de kibboets gevestigd aan de Kanaalweg 75 te Beverwijk. Toen de drijvende krachten van de kibboets naar Palestina waren geëmigreerd en er nog geen nieuwe leidinggevenden beschikbaar waren werd in het voorjaar van 1938 de kibboets samengevoegd met de kibboets in Franeker. De bewoners verlieten het pand aan de Kanaalweg in maart 1938. "@nl;
    skos:altLabel "Chinoeg Habayit"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/18495> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2021-12-17T08:34:15.922Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/kampen/4324>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/b/bd/Ebensee-survivors.jpg/500px-Ebensee-survivors.jpg";
    <http://schema.org/startDate> "1945-05-06"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/4324>;
    dcterms:created "2021-12-17T08:29:42.302Z"^^xsd:dateTime;
    skos:prefLabel "Ebensee bevrijd"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote """Eind april 1945 leefden er in Ebensee 18.437 gevangenen. Op 5 mei 1945 gaf de commandant de opdracht alle gevangenen in de tunnels te drijven. De gevangenen verzetten zich echter, waardoor van dit idee werd afgezien.
Op 6 mei 1945 werd het kamp door de derde Amerikaanse pantserdivisie bevrijd. 
Bron: Wikipedia"""@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
