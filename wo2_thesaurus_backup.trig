    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2145>, <https://data.niod.nl/WO2_Thesaurus/20640>;
    dcterms:created "2018-09-27T12:59:57.000Z"^^xsd:dateTime;
    skos:prefLabel "Arbeits Kontrolle Dienst"@nl, "Arbeits Kontrolle Dienst"@de, "'Arbeits Kontrolle Dienst'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Arbeits Kontrolle Dienst (A.K.D.) werd in april 1944 ingesteld, voornamelijk met als doel om mannen en jongens op te halen die zich aan de arbeidsplicht onttrokken, onder andere om in fabrieken in Duitsland te werken. De dienst die uit ongeveer duizend manschappen bestond, werd uit diverse geledingen gerekruteerd, maar bestond in het algemeen uit vrijwilligers uit de Nederlandse politie en leden van de Vrijwillige Hulppolitie. Verder maakten Nederlandse SS’ers, Landwachters  en oud-bewakers van het kamp \"Erika\" te Ommen er deel van uit."@nl;
    skos:altLabel "A.K.D."@nl, "AKD"@nl, "Arbeits Kontroll Dienst"@nl, "Arbeitskontrolldienst"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/19567>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/6644> a <http://schema.org/Thing>,
      skos:Concept;
    dcterms:references "Regionaal Historisch Centrum Limburg"@de;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-06-13T06:48:06.310Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2715>, <https://data.niod.nl/WO2_Thesaurus/20709>;
    dcterms:created "2018-09-27T13:03:29.000Z"^^xsd:dateTime;
    skos:prefLabel "Feldgendarmerie"@nl, "Feldgendarmerie"@de, "Feldgendarmerie"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Feldgendarmerie was de Duitse militaire politie of veldpolitie en maakte deel uit van de Wehrmacht. Ze voerden onder meer bezettings- en bewakingstaken uit in gebieden die direct onder controle van de Wehrmacht stonden zoals België. Die taken varieerden van verkeers- en bevolkingscontroles tot de opsporing en executie van verzetsdeelnemers. De leden van de Feldgendarmerie droegen een metalen halsketting met een plakkaat waarop 'Feldgendarmerie' stond en kregen daarom de bijnaam Kettenhunde."@nl;
    skos:altLabel "Kettenhunde"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/6645> a <http://schema.org/Thing>,
      skos:Concept;
    dcterms:references "P. van de Water, De Landwacht. Paramilitaire terreur in bezet Nederland (Utrecht 2023)"@nl,
      "N.J.G. Sikkel (red.), Documentatie. Samengesteld ten behoeve van de Bijzondere Rechtspleging, op last van de Procureur-Fiscaal bij het Bijzonder Gerechtshof te Amsterdam (Amsterdam 1947)"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2024-08-12T12:03:08.713Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/c/c3/Vrijwillige_Hulppolitie_Wassenaar_%281943%29.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/w/index.php?title=File:Vrijwillige_Hulppolitie_Wassenaar_(1943).jpg&oldid=848779455";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/67613c92-025a-11e7-904b-d89d6717b464/media/9aadff09-6c6d-857c-32f6-b2d685210197>,
      <https://beeldbankwo2.nl/nl/beelden/detail/a9a79380-025a-11e7-904b-d89d6717b464/media/0961a605-29ff-071e-b876-bb4631c07fb2>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Vrijwillige Hulppolitie (VHP) was een politie-eenheid die viel onder de reguliere Duitse politie, de Ordnungspolizei. De VHP was betrokken bij het oppakken en deporteren van Joden. De VHP bestond uit ongeveer 1.000 tot 2.000 leden. Aanmelding bij de VHP was op vrijwillige basis, maar lidmaatschap van de Nationaal-Socialistische Beweging (NSB) of de Schutzstaffel (SS) was vereist. De VHP bestond vanaf mei 1942 en ging in 1944 op in de Nederlandsche Landwacht."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4628>, <https://data.niod.nl/WO2_Thesaurus/2249>,
      <https://data.niod.nl/WO2_Thesaurus/2715>;
    dcterms:created "2018-09-27T13:39:24.000Z"^^xsd:dateTime;
    skos:prefLabel "Vrijwillige Hulppolitie"@nl, "'Vrijwillige Hulppolitie'"@de, "'Vrijwillige Hulppolitie'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Vrijwillige Hulppolitie (VHP) werd formeel op 23 mei 1942 ingesteld en stond onder bevel van de Ordnungspolizei. De leden bestonden uit personen die ‘de nieuwe Europese orde voorstonden en bereid waren, deze naar beste vermogen te dienen’ en lidmaatschap van de NSB of de SS was vereist om te kunnen toetreden. De VHP speelde een belangrijke rol bij het ophalen van Joodse burgers voor deportatie. Naar schatting maakten duizend tot tweeduizend personen deel uit van deze organisatie. Na Dolle Dinsdag werd de VHP aan de Landwacht toegevoegd."@nl;
    skos:altLabel "V.H.P."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2249> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/6652> a <http://schema.org/Thing>,
      skos:Concept;
    dcterms:references "Regionaal Historisch Centrum Limburg"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:04:12.795Z"^^xsd:dateTime;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2569>;
    dcterms:created "2018-09-27T14:22:11.000Z"^^xsd:dateTime;
    skos:prefLabel "Politieke delinquenten"@nl, "Political delinquents"@en, "Politische Delinquenten"@de;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Politieke delinquenten zijn personen die een politiek misdrijf (dat wil zeggen een misdrijf tegen de staat of staatsinrichting) hebben gepleegd. In het bijzonder betreft het personen die steun verleenden aan de Duitse bezetter en daarmee bewust in strijd met de belangen van het Nederlandse volk handelden of afbreuk deden aan het verzet."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/6658> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "N.J.G. Sikkel (red.), Documentatie. Samengesteld ten behoeve van de Bijzondere Rechtspleging, op last van de Procureur-Fiscaal bij het Bijzonder Gerechtshof te Amsterdam (Amsterdam 1947) "@nl,
      " Besluit Mussert, 21 november 1942. NSB-arch. inv.nr.179."@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2024-08-12T12:03:08.678Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1940-10-01"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/download/default/c2b57ab8-fc0d-154e-7bc8-24daf58cb6c0.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/5a02c426-025a-11e7-904b-d89d6717b464/media/c2b57ab8-fc0d-154e-7bc8-24daf58cb6c0"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/f45c162c-0259-11e7-904b-d89d6717b464/media/8d585f0d-98e3-88e3-bf05-2dec0c3b8970>,
      <https://beeldbankwo2.nl/nl/beelden/detail/2b235dd2-025a-11e7-904b-d89d6717b464/media/416ea84f-c21c-042f-a21b-13aabf539aa2>,
      <https://beeldbankwo2.nl/nl/beelden/detail/2b22a1a8-025a-11e7-904b-d89d6717b464/media/a5c8334b-0244-59f2-13e0-d8e714ac0cbb>,
      <http://resolver.kb.nl/resolve?urn=urn:gvn:EVDO02:NIOD05_6372>;
    dcterms:source "http://resolver.kb.nl/resolve?urn=urn:gvn:EVDO02:NIOD05_6372"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-06"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Het Zeevaartfront was de zeevaartorganisatie van de Nationaal-Socialistische Beweging (NSB). Het Zeevaartfront werd op 1 oktober 1941 opgericht door NSB’er Evart van Dieren om de belangenbehartiging en opleiding van zeevarenden in één organisatie te bundelen. Lidmaatschap van de NSB was niet verplicht en alle niet-Joodse Nederlanders konden lid worden. Op 1 december 1942 ging het Zeevaartfront op in de NSB-afdeling Nieuw Zeewezen."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2086>, <https://data.niod.nl/WO2_Thesaurus/2244>;
    dcterms:created "2018-10-03T18:45:37.000Z"^^xsd:dateTime;
    skos:prefLabel "Zeevaartfront"@nl, "'Zeevaartfront'"@de, "'Zeevaartfront'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Zeevaartfront werd 1 oktober 1941 opgericht door Evart van Dieren en was een NSB-organisatie. Het doel was het behartigen van de belangen van de zeevaart in de ruimste zin des woord onder de leus ‘Zeemanstand in Zeemanshand’. Het lidmaatschap van de NSB was niet vereist voor toetreding. Op bevel van Mussert werd het Zeevaartfront per 1 december 1942 opgeheven en de afdeling Nieuw Zeewezen ingesteld die onder hoofdafdeling Arbeidszaken van het hoofdkwartier van de NSB ressorteerde."@nl;
    skos:altLabel "Zeevaart Front"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/6659> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "N.J.G. Sikkel (red.), Documentatie. Samengesteld ten behoeve van de Bijzondere Rechtspleging, op last van de Procureur-Fiscaal bij het Bijzonder Gerechtshof te Amsterdam (Amsterdam 1947)"@nl,
