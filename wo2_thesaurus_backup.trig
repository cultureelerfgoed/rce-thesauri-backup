    skos:prefLabel "Crèche Vereeniging Zuigeling-Inrichting en Kinderhuis"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Crèche van de Vereeniging Zuigeling-Inrichting en Kinderhuis, werd geopend in 1924 en vanaf 1926 geleid door Henriëtte Pimentel. In 1942 en 1943 werd de crèche gebruikt als 'kinderafdeling' van doorgangshuis de Hollandsche Schouwburg, van waaruit (Amsterdamse) Joodse mensen werden afgevoerd naar Westerbork. In september 1943 werd de crèche permanent gesloten."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/18719> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-02-25T09:45:16.932Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://deventit.coda-apeldoorn.nl/HttpHandler/icoon.ico?file=475130";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://archieven.coda-apeldoorn.nl/detail.php?id=172615";
