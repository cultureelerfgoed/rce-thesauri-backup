    <http://schema.org/startDate> "1941-11-24"^^xsd:date;
    <http://schema.org/endDate> "1945-05-08"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Theresienstadt_(concentratiekamp)&oldid=56029336"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/5008>, <https://data.niod.nl/WO2_Thesaurus/5326>;
    dcterms:created "2020-09-14T13:45:52.000Z"^^xsd:dateTime;
    skos:prefLabel "Getto van Theresienstadt"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "De stad Theresienstadt - in het bijzonder de Grote Vesting - was vanaf november 1941 tot het einde van de oorlog in gebruik als getto voor gedeporteerde Joden. Een groot deel werd vanuit hier doorgestuurd naar Kamp Auschwitz-Birkenau of andere vernietigingskampen. Ook zaten er een groep oude of prominente Joden, zoals de leider van de Joodsche Raad David Cohen. In 1944 bezocht het Rode Kruis Theresienstadt. Als voorbereiding hiervoor werden vele Joden naar Auschwitz gestuurd om zo de overbevolking te verbergen."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
