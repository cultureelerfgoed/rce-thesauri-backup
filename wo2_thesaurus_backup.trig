    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>;
    dcterms:created "2019-11-07T15:42:06.000Z"^^xsd:dateTime;
    skos:prefLabel "'De koerier' (Amsterdam)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Koerier was een verzetsblad dat in Amsterdam werd uitgegeven van 18 november 1944 t/m 7 mei 1945. Voorloper was het eveneens door O.B. Weehuizen uitgegeven 'DAGELIJKSCHE BERICHTEN'. Medewerking werd verleend door J . Key en de dames T.van der Does, M. van Heezik, M. van Heezik-Koppelstok, mr. A.R. Kellermann Slotemaker en dra. A. Leyds. Weehuizen schreef wekelijks een politiek overzicht."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8704> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "PPN: 865833079"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2020-12-09T09:35:48.176Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/9937>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>;
    dcterms:created "2019-11-07T15:47:35.000Z"^^xsd:dateTime;
    skos:prefLabel "De koerier; berichtenblad van 'Je Maintiendrai'"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het illegale blad De Koerier : Berichtenblad van Je Maintiendrai werd van 15 september 1944 tot en met 16 april 1945 uitgegeven in Leeuwarden. Het blad verscheen dagelijks. De artikelen werden grotendeels geschreven door ir. Anne Vondeling."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8705> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "PPN: 269719806"@nl;
