    skos:relatedMatch <https://data.niod.nl/WO2_biografieen/Anne-Jannes-Elsinga>;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/corporaties/7948>, <https://data.niod.nl/WO2_Thesaurus/corporaties/7860>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2005>, <https://data.niod.nl/WO2_Thesaurus/2245>;
