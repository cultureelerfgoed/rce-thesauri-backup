    dcterms:source "https://nl.wikipedia.org/w/index.php?title=De_Maasbode;_God_en_mijn_recht&oldid=48687334"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/bakkerm>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>, <https://data.niod.nl/WO2_Thesaurus/corporaties/2669>;
    dcterms:created "2018-03-07T09:03:05.000Z"^^xsd:dateTime;
    skos:prefLabel "Maasbode-groep"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Maasbode-groep was een verzetsgroep te Arnhem-Nijmegen. Zij gaven het rooms-katholieke illegale blad De Maasbode uit (nr. 400 in L. Winkel, De ondergrondse pers), dat verscheen van december 1943-maart 1944, de laatste drie nummers (april-mei 1944) verschenen onder de titel ‘Katholiek Kompas’. Het blad stond los van de opgeheven legale Maasbode uit Rotterdam. De redactie bestond uit Louis Fréquin, W. Lagé en Chr. Deuss. De twee laatstgenoemden hadden contact met de Christofoor-groep. Na de arrestatie van Frequin in mei 1944 – door verraad – stopte de uitgave."@nl;
    skos:altLabel "Maasbode groep"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/6069> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
