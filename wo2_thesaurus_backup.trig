    dcterms:source "https://nos.nl/artikel/2317891-bijzondere-beelden-van-de-eerste-uren-van-de-bevrijding-in-leeuwarden"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
