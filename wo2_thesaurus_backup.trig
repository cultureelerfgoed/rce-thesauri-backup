    dcterms:source "https://www.deverhalenvangroningen.nl/alle-verhalen/het-beruchte-scholtenhuis"@de;
    <https://data.niod.nl/eventsWO2/toLocation> <https://data.niod.nl/WO2_Thesaurus/locations/10037>;
