      <https://data.niod.nl/WO2_Thesaurus/20718>;
    dcterms:created "2016-10-04T13:07:40.000Z"^^xsd:dateTime;
    skos:prefLabel "'Nederlands Informatiebureau'"@de, "'Nederlands Informatiebureau'"@en,
      "Nederlands Informatiebureau"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Nederlands Informatiebureau te New York bestond van 1941 tot 1951 en werd in opgericht om informatie te verschaffen aan Amerikanen over Nederland op economisch, politiek, cultureel, geografisch en historisch gebied. Het gaf deze informatie mondeling, schriftelijk en door middel van boeken, tijdschriften, pamfletten, radio-uitzendingen en lezingen, het organiseren van tentoonstellen en het distribueren van films om Nederland te promoten. Hoofd was N.A.C. Slotemaker de Bruïne. In 1951 werd de naam veranderd in Netherlands Information Service."@nl;
    skos:altLabel "Netherlands Information Bureau"@nl, "Netherlands Information Service"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/4600> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "G. Zondergeld, Ons Socialisme Uw toekomst. Henk Woudenberg en het Nederlands Arbeidsfront (1942-1945) (Apeldoorn/Antwerpen 2010)"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2024-12-05T10:40:29.165Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1906-01-01"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/d9fcb933-4679-8fd1-ba5c-e6353f31c56a.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/5b880a86-025a-11e7-904b-d89d6717b464/media/d9fcb933-4679-8fd1-ba5c-e6353f31c56a";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <http://collectie.atlasvanstolk.nl/data_nl.asp?startc=1&q0=25047&subj=1&bron=g>,
      <https://beeldbankwo2.nl/nl/beelden/detail/5b887c0a-025a-11e7-904b-d89d6717b464/media/bec17711-1c0b-5bdd-7f87-3318574f0060>,
      <https://beeldbankwo2.nl/nl/beelden/detail/5b88e4f6-025a-11e7-904b-d89d6717b464/media/890f5a69-c6d2-a5df-a822-5ae9022bbb5c>,
      <https://beeldbankwo2.nl/nl/beelden/detail/5bdf91ac-025a-11e7-904b-d89d6717b464/media/64b98ad0-ffa4-6f7e-7d0a-8e855d9d81ed>,
      <https://beeldbankwo2.nl/nl/beelden/detail/bda1eb2e-025a-11e7-904b-d89d6717b464/media/0fba3f3f-bd81-8e79-6350-707d4087a784>,
      <https://beeldbankwo2.nl/nl/beelden/detail/30d2a9ae-025a-11e7-904b-d89d6717b464/media/a2ecbbab-1c9b-2a38-99b4-1c05a23a3242>;
    <https://data.niod.nl/organizationsWO2/endDate> "1941-05-01"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Het Nederlandsch Verbond van Vakverenigingen (NVV) was een vakbondsorganisatie die werd opgericht in 1906. Vanaf het begin van de Duitse bezetting van Nederland kreeg het NVV een nationaalsocialistische voorzitter. In 1942 werd het NVV opgenomen in de nationaalsocialistische vakbondsorganisatie Nederlandsch Arbeidsfront (NAF). Na de oorlog hervatte het NVV zijn activiteiten als vakbondsorganisatie."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
