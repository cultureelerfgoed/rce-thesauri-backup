    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/ravend>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2163>, <https://data.niod.nl/WO2_Thesaurus/2210>;
    dcterms:created "2026-02-18T11:16:49.125Z"^^xsd:dateTime;
    skos:prefLabel "Kunsthandel G.C. Dekkers"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Kunsthandel G.C. Dekkers was een kunsthandel die in november 1940 werd opgericht door de broers Gerardus Cornelis “Tin”  Dekkers en Heinrich Gerardus “Hens” Dekkers, maar alleen Gerardus Cornelis hield zich bezig met de kunsthandel. De handel werd vanuit de woonhuizen van de familie Dekkers gedreven. Er werd vooral handel gedreven met individuen in Duitsland. Vanaf 1941 werd veel samengewerkt met veilinghouder Han Jungeling. Na de bezetting werden de broers veroordeeld voor financiële collaboratie. Kunsthandel G.C Dekkers ging hierna verder, al is onbekend op welke schaal en tot wanneer."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/21933> a <http://schema.org/Thing>, skos:Concept,
