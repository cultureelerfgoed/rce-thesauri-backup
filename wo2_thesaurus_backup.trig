    dcterms:source "https://www.joodsmonument.nl/nl/page/45346/centraal-israelitisch-oude-mannen-en-vrouwenhuis"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/18823>, <https://data.niod.nl/WO2_Thesaurus/18824>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/20698>;
    dcterms:created "2022-02-17T14:49:30.272Z"^^xsd:dateTime;
    skos:prefLabel "Centraal Tehuis voor Israëlieten in Nederland"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het Centraal Tehuis voor Israëlieten in Nederland (CeTIN) was een Joods bejaardentehuis in Gouda. Het tehuis heette oorspronkelijk Centraal Israëlietisch Oude Mannen- en Vrouwenhuis voor Nederland en de Koloniën en werd in 1894 geopend. In 1943 werd het CeTIN ontruimd door de nazi's en de bewoners en personeelsleden gedeporteerd."@nl;
    skos:altLabel "CeTIN"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
