    dcterms:source "https://merwedegijzelaars.nl/werkplek/3/bussing-bovengronds-grasleben"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/6385>;
    dcterms:created "2022-01-27T14:37:25.060Z"^^xsd:dateTime;
    skos:prefLabel "Werkplek Büssing in Grasleben"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "In de zoutmijnen in Grasleben werden de onderdelen voor de vliegtuig- en speedbootmotoren gemaakt. In een grote hal bovengronds werden de motoren in elkaar gezet. Daarna gingen ze naar de Büssingfabriek in Braunschweig voor het testen."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/18645> .
  
  <https://data.niod.nl/WO2_Thesaurus/18628> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
