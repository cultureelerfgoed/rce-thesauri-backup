    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/640x480/9f57b140-7194-97d0-c8a5-a9c5a5190c37.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://beeldbankwo2.nl/nl/beelden/detail/f43f1ba2-025a-11e7-904b-d89d6717b464/media/9f57b140-7194-97d0-c8a5-a9c5a5190c37";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1873>, <https://data.niod.nl/WO2_Thesaurus/kampen/5693>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/4717>;
    dcterms:created "2018-09-11T12:17:18.000Z"^^xsd:dateTime;
    skos:prefLabel "Waldlager Harskamp"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Wehrmacht gebruikte deze locatie als Truppenübungsplatz voor de Duitse militairen. De legerplaats, die reeds bestond, werd hiertoe grondig verbouwd en uitgebreid met een Waldlager. Hiertoe werden vele barakken en schuilkelders gebouwd, waarvan de sporen nog zichtbaar zijn. Dit Waldlager bood plaats aan 1200 man, naast de capaciteit van circa 2000 man die de legerplaats bood. Om de geallieerde vliegers om de tuin te leiden werd er bij de legerplaats een schijnvliegveld aangelegd, inclusief startbaan, baanverlichting en een heus vliegveld. Dit vliegveld moest de aandacht afleiden van Fliegerhorst Deelen. Legerplaats Harskamp is na de oorlog gebruikt als interneringskamp voor duizenden collaborateurs. "@nl;
    skos:altLabel "Legerplaats Harskamp"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
