    skos:prefLabel "Het baken (Leeuwarden)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het illegale blad Het Baken verscheen op 1 augustus 1941in Leeuwarden - St. Anna Parochie. Het blad was een gedeeltelijke voortzetting van: Knoop in je oor!"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8673> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "PPN: 26879667X"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
