    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://upload.wikimedia.org/wikipedia/commons/1/15/Eastern_Front_1941-06_to_1941-09.png"@nl;
    <http://schema.org/startDate> "1941-08-23"^^xsd:date;
    <http://schema.org/endDate> "1941-09-26"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Slag_om_Kiev_(1941)&oldid=56493760"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/4396>;
    dcterms:created "2020-09-11T12:22:58.000Z"^^xsd:dateTime;
    skos:prefLabel "Slag om Kiev"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Slag om Kiev was een onderdeel van Operatie Barbarossa en omvatte een strijd tussen de Sovjet-Unie en Nazi-Duitsland. De operatie duurde een maand en vond plaats van 23 augustus tot 26 september 1941. Door de insluiting van bijna het gehele Zuidwestelijk Front van het Rode Leger was de slag een groot succes voor de Duitsers."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9422> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:24:08.556Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/16951>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/1/15/Eastern_Front_1941-06_to_1941-09.png"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Slag_om_Bia%C5%82ystok-Minsk#/media/Bestand:Eastern_Front_1941-06_to_1941-09.png"@nl;
    <http://schema.org/startDate> "1941-07-15"^^xsd:date;
    <http://schema.org/endDate> "1941-08-08"^^xsd:date;
    dcterms:source "https://nl.qwe.wiki/wiki/Battle_of_Uman#:~:text=De%20Slag%20bij%20Uman%20(15,%2Dmajoor%20PG%20Ponedelin%2C%20respectievelijk."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/4396>;
    dcterms:created "2020-09-11T12:37:53.000Z"^^xsd:dateTime;
    skos:prefLabel "Slag bij Uman"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Slag bij Uman, een stad in West-Oekraïne, vond plaats tussen 15 juli en 8 augustus 1941. Het was een Duitse operatie tegen het 6e en 12e Sovjetleger. De strijd eindigde in een nederlaag voor de Sovjet-Unie: na de omsingeling in het zuidoosten van Uman werden het 6e en 12e leger vernietigd."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9423> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
