    dcterms:source "https://www.4en5mei.nl/oorlogsmonumenten/monumenten_zoeken/oorlogsmonument/3851/leuth%2C-monument-voor-ernest-david-harrison"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/locations/6565>;
