    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>;
    dcterms:created "2019-11-08T14:44:23.000Z"^^xsd:dateTime;
    skos:prefLabel "De DAGERAAD; geallieerd ochtendblad; non si male nunc, et olim sic erit"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het illegale blad De Dageraad: geallieerd Ochtendblad; non si male nunc, et olim sic erit werd van oktober 1944 tot en met 24 december 1944 uitgegeven in Amsterdam door P.F.M. Fontaine en B. Fontaine. Het blad was het zondagsblad, behorend bij de gelijknamige dagelijkse uitgave."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8741> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "PPN: 269128190"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2020-09-01T10:22:26.000Z"^^xsd:dateTime;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>;
    dcterms:created "2019-11-08T14:46:02.000Z"^^xsd:dateTime;
    skos:prefLabel "De dageraad; geallieerd ochtendblad"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het illegale blad De Dageraad : Geallieerd Ochtendblad werd van 30 september 1943 tot en met 21 maart 1944 uitgegeven in Haaren (Groninen) door de ambtenaren ter secretarie A.L. Vissers en M.J.G.M. van den Wildenburg. Het blad eindigde met de arrestatie van de makers. Beiden zijn overleden tijdens de evacuatie van het concentratiekamp Sachsenhausen naar Buchenwald in de laatste week van februari 1945."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8742> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "PPN: 269128816"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
