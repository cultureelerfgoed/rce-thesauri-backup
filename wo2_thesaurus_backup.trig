    <http://schema.org/location> "Wierden";
    <http://schema.org/startDate> "1945-03-29"^^xsd:date;
    dcterms:source "https://nos.nl/75jaarbevrijding/bericht/2328683-twintig-mannen-bruut-geexecuteerd-op-fietspad"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/9271>;
    dcterms:created "2020-09-21T14:17:07.000Z"^^xsd:dateTime;
    skos:prefLabel "Fusillade in Wierden, 29 maart 1945"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op de ochtend van 29 maart 1945 werden bij de Ten Bos Textielfabriek aan de Almelosestraat in Wierden 10 mannen gefusilleerd en nog eens 10 mannen aan de Rijssensestraat. De stoffelijke overschotten moesten op last van de SS tot 12.00 verplicht op de straat blijven liggen. De executie was een represaille op enkele aanslagen op spoorlijnen en verkeersknooppunten in de regio van Wierden. Anderhalve week later, op 9 april 1945, bevrijdden Canadese troepen Wierden."@nl .
  
