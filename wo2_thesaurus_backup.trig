    dcterms:source "https://wikimiddenbrabant.nl/Explosie_V1_Vijfhuizen,_18_december_1944"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/19539>;
    dcterms:created "2025-10-08T07:43:17.713Z"^^xsd:dateTime;
    skos:prefLabel "V-1 inslag Vijfhuizen Tilburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De inslag van een Duitse V-1 op Vijfhuizen, Tilburg, vond plaats op 18 december 1944. Omstreeks 12.00 uur, stort een V-1 neer op een akker in buurtschap Vijfhuizen, in het noordoostelijk stadsdeel. Landbouwer Adrianus Broekhoven wordt gedood. Er is lichte schade aan één boerderij; zes boerderijen in de omgeving hebben glasschade."@nl .
  
