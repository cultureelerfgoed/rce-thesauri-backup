    dcterms:source "https://javapost.nl/2013/06/12/de-glodok-affaire-i/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2019-03-29T10:40:15.000Z"^^xsd:dateTime;
    skos:prefLabel "Start Internering van Indo-Europese jongeren"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Start van de Internering van Indo-Europese jongeren op 27 september 1944 in de Glodok-gevangenis in Batavia is de eerste van een reeks arrestaties die ook in andere steden op Java plaatsvindt. Het gaat om een groep van ongeveer 650 jongens in de leeftijd van 16 tot 23 jaar. Het Japanse bestuur besluit tot de maatregel omdat de Indo-Europese jongens blijven weigeren hun Nederlandse afkomst te verloochenen."@nl .
  
