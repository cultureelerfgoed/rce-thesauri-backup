    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/93e21098-025a-11e7-904b-d89d6717b464/media/46067a8d-46c0-3fc3-b6bb-4ccc9b30e492?mode=detail&view=horizontal&q=hemmen&rows=1&page=3";
    <http://schema.org/endDate> "1945-01-06"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Kasteel_Hemmen&oldid=53150536"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/isPointofInterest> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
