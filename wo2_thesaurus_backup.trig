    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://nimh-beeldbank.defensie.nl/memorix/756ba0e4-eb18-11df-a391-13966e870614";
    <http://schema.org/location> "Leusden";
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2675>;
    dcterms:created "2020-11-24T15:15:33.081Z"^^xsd:dateTime;
    skos:prefLabel "Wapendroppings in Leusden"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Vanaf 1943 werden bij de afwerpterreinen ’t Zwart, Kouwenhove en Hardeveld wapens voor het verzet gedropt door geallieerde bommenwerpers. Vanaf februari 1945 werd ook het schijnvliegveld in Den Treek gebruikt. Verzetsgroepen borgen de wapens eerst in de omgeving alvorens het overschot af te voeren naar Rotterdam."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/10446> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references """Themanummers Leusden Toen:
Vliegtuigcrash 1943, mei 2017
Herdenking vliegtuigcrash, mei 2018
The demise of Stirling R9197 3 February 1943"""@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    dcterms:modified "2022-11-10T14:16:31.685Z"^^xsd:dateTime;
