    skos:prefLabel "Rijksarbeidsbureau"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Met de oprichting van het Rijksarbeidsbureau (RAB) werd de openbare arbeidsbemiddeling c.q. de uitzending van arbeiders naar Duitsland een rijkstaak. Het RAB bestond uit een departementaal hoofdbureau, 37 Gewestelijke Arbeidsbureaus (GAB's) en 143 bijkantoren. Het RAB stond onder scherpe controle van de Duitse bezetter. "@nl;
    skos:altLabel "RAB"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/11464> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "De Arbeidsinzet. De gedwongen arbeid van Nederlanders in Duitsland, 1940-1945, B.A. Sijes, Den Haag 1966"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:20:22.385Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/9582>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://resolver.kb.nl/resolve?urn=urn:gvn:EVDO02:NIOD05_0982&role=thumbnail";
