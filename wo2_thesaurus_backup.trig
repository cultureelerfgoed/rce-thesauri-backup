    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/3659>, <https://data.niod.nl/WO2_Thesaurus/kampen/3652>,
      <https://data.niod.nl/WO2_Thesaurus/2354>;
    dcterms:created "2021-02-01T14:09:59.089Z"^^xsd:dateTime;
    skos:prefLabel "De Meppelaars"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Op 19 juli 1944 kwam er een groep van zeventig personen uit Kamp Amersfoort in concentratiekamp Buchenwald aan. Ze waren opgepakt vanwege illegale acties. In deze groep bevonden zich 25 Meppelers en het transport kreeg de naam 'De Meppelaars'. Ze kregen het predikaat 'dikal' (darf in keinem anderen Lager) en kampnummers in de series van 19.000 t/m 22.000. In maart 1945 waren er nog 52 Meppelaars in Buchenwald. Daarna verdwenen er zo'n 35 via evacuatietransporten en bij de bevrijding waren er nog slechts negen Meppelaars in Buchenwald."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/10984> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
