    skos:prefLabel "Overval op het Haagsche Veer"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Overval op het Haagsche Veer vindt plaats op 24 oktober 1944 en hierbij worden 43 gevangenen bevrijd uit het politiebureau te Rotterdam. Hoofddoel van de overval was het bevrijden van 17 versetsmensen van verzetsgoep Franciscusbrigade. KP-Rotterdam en KP-Rotterdam-Zuid werkten hierbij samen onder leiding van verzetsdeelnemer Samuel Esmeijer. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/6367> .
  
  <https://data.niod.nl/WO2_Thesaurus/8569> a <http://schema.org/Thing>, skos:Concept,
