    dcterms:created "2021-02-09T15:29:00.145Z"^^xsd:dateTime;
    skos:prefLabel "Liquidatie van Jacob Cornelis Jongejan"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De liquidatie van Jacob Cornelis Jongejan vond plaats op 24 april 1945 in Rotterdam. Jongejan was leraar Duits M.O. Op de liquidatielijst van de LKP Rotterdam stond als reden: SD-tolk, afpersing en dergelijke. Jongejan werd in de buurt van zijn woning doodgeschoten."@nl .
  
