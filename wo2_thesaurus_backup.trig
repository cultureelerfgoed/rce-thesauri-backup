    dcterms:created "2018-03-07T09:01:01.000Z"^^xsd:dateTime;
    skos:prefLabel "Verzetsgroep ‘Eén voor allen, allen voor één’"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "‘Eén voor allen, allen voor één’ was een verzetsgroep te Barneveld-Voorthuizen. De oprichter was P. Vijge en de groep stond onder leiding van Johnny de Droog. De groep verspreidde vanaf zomer 1941 het illegale blad Comité Eenheid ‘Eén voor allen, allen voor één’ (nr. 114 in L. Winkel, De ondergrondse pers), dat o.a. felle artikelen tegen de Arbeidsdienst bevatte. Op 7 en 8 maart 1942 werd de groep opgerold door verraad van De Droog, die een SD-spion bleek te zijn. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/6065> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "L.E. Winkel, De ondergrondse pers, 1940-1945. 3e dr., geheel herz. / door Hans de Vries (Utrecht: Veen, 1989) (nr. 152)"@nl;
