    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/isPointofInterest> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1873>, <https://data.niod.nl/WO2_Thesaurus/locations/9624>;
    dcterms:created "2019-03-05T09:18:19.000Z"^^xsd:dateTime;
    skos:prefLabel "Kazernes Ede"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "De kazernes in Ede werden door de Duitse bezetter gebruikt om eenheden van de Wehrmacht, Kriegsmarine en de SS onder te brengen. Deze grote militaire aanwezigheid had veel vorderingen en inkwartieringen in Ede tot gevolg. Duitse meisjes die de opleiding volgden tot 'Helferin' werden bijvoorbeeld ingekwartierd in villa Rozenburg en aan de Stationsweg was een Wehrmachtsheim gevestigd, waar militairen de nodige ontspanning vonden."@nl .
  
