    dcterms:created "2016-08-01T19:20:36.000Z"^^xsd:dateTime;
    skos:prefLabel "Dolle Dinsdag"@nl, "Mad Tuesday"@en, "'Dolle Dinsdag'"@de;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:exactMatch <https://digitaalerfgoed.poolparty.biz/westerbork/1235>;
    skos:scopeNote "Dolle Dinsdag is de naam van de chaotische dag op dinsdag 5 september 1944 waarop Nederland in een bevrijdingsroes verkeerde en veel Duitsers en NSB'ers op de vlucht sloegen."@nl;
    skos:altLabel "5 september 1944"@nl, "Dollen Dinsdag"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/7635>;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event>;
    skos:definition "Op dinsdag 5 september 1944 zei premier Gerbrandy in een radiotoespraak dat de geallieerden de Nederlandse grens hadden overschreden. Door dit later fout gebleken bericht raakte Nederland in een bevrijdingsroes. Duitsers en collaborateurs vluchtten massaal weg uit Nederland. Maar nog diezelfde dag werd duidelijk dat er van een Duitse capitulatie geen sprake was."@nl .
  
