    dcterms:created "2020-07-16T13:23:17.000Z"^^xsd:dateTime;
    skos:prefLabel "Onderbreking Aktion T4"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De onderbreking van Aktion T4 werd op 18 augustus 1941 ingelast. De katholieke kerk had geprotesteerd en ook de Duitse bevolking kreeg  langzaamaan door wat er in de euthanasiecentra afspeelde. Dit zorgde voor teveel tegendruk. De 'stop' was eigenlijk meer symbolisch, omdat het programma al gauw werd hervat. Dit keer werd alles het in het geheim gedaan en op kleinere schaal. Het dodental stond toen op 70.000."@nl;
    skos:altLabel "Stop Aktion T4"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event>;
    skos:notation "De onderbreking van Aktion T4 (18 augustus 1941)" .
  
