    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/9667>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/29bd9d39-3383-2076-da85-bf595ca8b71b.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/73713d0c-025a-11e7-904b-d89d6717b464/media/29bd9d39-3383-2076-da85-bf595ca8b71b";
    <http://schema.org/location> "Roermond";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/2554d0e8-025a-11e7-904b-d89d6717b464/media/be0a82f5-ac7d-cfc0-6716-a8a27e12de30>,
      <https://beeldbankwo2.nl/nl/beelden/detail/a9d2fbac-0259-11e7-904b-d89d6717b464/media/0900718b-f0c5-39b7-a3a0-65be18f25e34>;
    <http://schema.org/startDate> "1945-03-01"^^xsd:date;
    dcterms:source "https://nos.nl/artikel/2171441-laatste-oorlogswinter-werd-drama-voor-frontstad-roermond"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/6983>;
    dcterms:created "2018-10-19T08:01:03.000Z"^^xsd:dateTime;
    skos:prefLabel "Befreiung von Roermond"@de, "Liberation of Roermond"@en, "Bevrijding Roermond"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De bevrijding van Roermond vond plaats op 1 maart 1945. In september 1944 werd een deel van Limburg bevrijd, maar Roermond werd toen een frontstad. Eind januari 1945 werd de stad door de Duitsers geëvacueerd. De mannen waren al in Duitsland tewerkgesteld maar vrouwen en kinderen gingen naar Groningen en Friesland. De Amerikaanse bevrijders troffen op 1 maart een nagenoeg lege en verwoeste stad aan. Na de bevrijding van Noord-Nederland keerden de bewoners terug. Ook de tewerkgestelde mannen keerden grotendeels terug."@nl .
  
