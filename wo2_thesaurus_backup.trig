    dcterms:modified "2021-08-25T12:26:31.757Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/c/c4/Stalag_IVG.jpeg/500px-Stalag_IVG.jpeg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://en.wikipedia.org/wiki/Stalag_IV-G#/media/File:Stalag_IVG.jpeg";
