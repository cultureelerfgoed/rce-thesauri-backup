    skos:prefLabel "Wapenstilstand in Compiègne, 22 juni 1940"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:exactMatch <http://www.wikidata.org/entity/Q170360>;
    skos:scopeNote "Op 22 juni 1940 sloten de Fransen een wapenstilstand met Duitsland. Hitler had het spoorwegrijtuig laten terugzetten op de plaats waar het in 1918 stond en was zelf aanwezig om de Franse delegatie te ontvangen."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/11220> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:16:41.360Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/9582>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> <https://collectie.atlasvanstolk.nl/img/AVS/700px/05/AVS053600.jpg>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://collectie.atlasvanstolk.nl/data_nl.asp?startc=1&q0=99751&subj=1&bron=g";
    <http://schema.org/startDate> "1937-05-01"^^xsd:date;
    dcterms:source "https://www.berghapedia.nl/index.php/Aanwijzingen_van_1937"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1716>;
    dcterms:created "2021-03-17T14:56:56.850Z"^^xsd:dateTime;
    skos:prefLabel "Aanwijzingen van 1937"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het document de Aanwijzingen van 1937 werd in mei 1937 goedgekeurd door de ministerraad en was opgesteld in verband met de toenemende oorlogsdreiging in de jaren dertig. Het bevatte instructies voor bestuurders en ambtenaren in het geval van schending van de Nederlandse neutraliteit of bezetting van het Nederlandse grondgebied. De bezetter moest zich houden aan de geldende wetten en aan het internationale volkenrecht. Het was de bezetter verboden de bevolking direct of indirect te laten deelnemen aan krijgshandelingen."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/11223> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-07-16T10:58:54.323Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/1e3ea249-2589-6fe8-0e7a-483661092d14.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/d16152c2-0259-11e7-904b-d89d6717b464/media/1e3ea249-2589-6fe8-0e7a-483661092d14";
    dcterms:source "https://en.wikipedia.org/wiki/Devisenschutzkommando"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2166>, <https://data.niod.nl/WO2_Thesaurus/20712>;
    dcterms:created "2021-03-18T12:41:30.043Z"^^xsd:dateTime;
    skos:prefLabel "Devisenschutzkommando"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Devisenschutzkommando (DSK) was een speciale eenheid van SS-militairen die gedurende de Tweede Wereldoorlog actief was in België, Frankrijk en Nederland. De eenheid werd in 1940 opgericht en was belast met het toezicht op alle valutatransacties van banken in landen die bezet waren door nazi-Duitsland. Het concept transacties in vreemde valuta werd al snel geherinterpreteerd om alles van financiële waarde te betekenen. In de praktijk namen leden van de DSK alles in beslag waarvan ze dachten dat het waardevol was. Er werd op grote schaal gerapporteerd over geweld en marteling die werden gebruikt bij het vinden en verwerven van Joods goud. "@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/11224> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-07-14T13:47:06.659Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/9587>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/cf8efb00-11c1-169c-e4ff-1c1e89d11d38.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/5b7a5828-025a-11e7-904b-d89d6717b464/media/cf8efb00-11c1-169c-e4ff-1c1e89d11d38";
    <http://schema.org/startDate> "1943-07-29"^^xsd:date;
    dcterms:source "https://gedenkplaats-haaren.nl/gevangenen-gijzelaars/hannibalspiel/"@nl,
      "https://www.bibliotheek.nl/catalogus/titel.342741810.html/het-hannibalspiel/"@nl,
      "https://www.archieven.nl/nl/zoeken?mivast=0&mizig=210&miadt=120&miaet=1&micode=OV33&minr=965856&miview=inv2"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    skos:relatedMatch <https://data.niod.nl/WO2_Thesaurus/corporaties/5415>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4571>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/5428>, <https://data.niod.nl/WO2_Thesaurus/corporaties/5427>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2304>;
    dcterms:created "2021-03-18T13:15:14.616Z"^^xsd:dateTime;
    skos:prefLabel "Hannibalspiel"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het Hannibalspiel was de naam van het onderzoek naar drie verzetsgroepen dat werd uitgevoerd door de Duitse Oberleutnant Ulrich Schwartz. Dit spel van de contraspionagedienst van de Kriegsmarine leidde tot de ondergang van groep Erkens, een Rotterdamse verzetsgroep, groep Clarence, een Limburgse/Belgische verzetsgroep en groep Luc, een Belgische verzetsgroep. Op 30 november 1942 kwamen de 52 gevangenen in Kamp Haaren aan. Op 29 juli 1943 begon in de Utrechtse gevangenis het proces tegen 52 gevangenen, waarvan 22 de oorlog niet overleefden."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/11225> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Loe de Jong, Koninkrijk der Nederlanden in de Tweede Wereldoorlog, 1939-1945. Deel 8 – Gevangenen en gedeporteerden (1e helft) (’s-Gravenhage: Martinus Nijhoff, 1978)"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2023-01-23T13:06:06.689Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/378f60fb-f4c7-f65c-2525-fbfc9c43a150.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/654e0390-025a-11e7-904b-d89d6717b464/media/378f60fb-f4c7-f65c-2525-fbfc9c43a150";
    dcterms:source "https://www.tweedewereldoorlog.nl/gijzelaars/represaille/indische-gijzelaars/"@nl,
      "https://gedenkplaats-haaren.nl/gevangenen-gijzelaars/indische-gijzelaars/"@nl;
    skos:relatedMatch <https://data.niod.nl/WO2_biografieen/Jean-Chretien-Baud>, <https://data.niod.nl/WO2_biografieen/Jo-Juda>,
      <https://data.niod.nl/WO2_biografieen/Francois-Marie-Razoux-Schultz>, <https://data.niod.nl/WO2_biografieen/Willem-Andriessen>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/events/19413>, <https://data.niod.nl/WO2_Thesaurus/19414>,
      <https://data.niod.nl/WO2_Thesaurus/19415>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1977>, <https://data.niod.nl/WO2_Thesaurus/2023>;
    dcterms:created "2021-03-18T14:16:07.864Z"^^xsd:dateTime;
    skos:prefLabel "Indische gijzelaars"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Op 19 en 20 juli 1940 werden 231 mensen die vanuit Nederlands-Indië in Nederland met verlof waren door de Duitsers gearresteerd. Ze werden Indische gijzelaars genoemd. Het was een vergelding voor de arrestatie van bijna 2400 Duitsers door de Nederlandse gouverneur-generaal in Nederlands-Indië in mei 1940. De 15 vrouwelijke gijzelaars gingen naar Ravensbrück, de mannen naar Kamp Buchenwald. Op 7 oktober kwamen er 116 Indische gijzelaars bij in Buchenwald maar die kwamen niet uit Nederlands-Indië. De vrouwen kwamen begin november 1940 weer vrij, de mannen die het overleefden kwamen ruim 4 jaar later vrij."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/11226> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    dcterms:modified "2021-03-18T15:09:54.895Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/11227>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/nda/thumb/1000x1000/f0963aae-ce99-f365-0f82-172c791d6b25.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://nimh-beeldbank.defensie.nl/memorix/5485ec6d-3ada-b7b5-2845-bae99b612e44";
    <http://schema.org/location> "Wittem";
    <http://schema.org/startDate> "1944-07-21"^^xsd:date;
    dcterms:source "https://www.stiwotforum.nl/viewtopic.php?t=8161"@nl, "https://nl.wikipedia.org/wiki/Leo_Penders"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2657>;
    dcterms:created "2021-03-18T14:40:02.868Z"^^xsd:dateTime;
    skos:prefLabel "De klap van Wittem"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Op 21 juli 1944 werden door toedoen van een Duitse provocateur 10 kopstukken van het Limburgse verzet, district Gulpen gevangengenomen. Deze actie werd later bekend als De klap van Wittem. De Duitse provocateur was een onderofficier die in het klooster van de paters Redemptoristen te Wittem werd verpleegd. Hij zei oorlogsmoe te zijn en wilde onderduiken, maar verraadde vervolgens de verzetsgroep. Zeven gevangenen kwamen niet meer terug uit de concentratiekampen en twee districtsleiders werden op 5 september 1944 in Valkenburg gefusilleerd."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/11243> a skos:Concept, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
