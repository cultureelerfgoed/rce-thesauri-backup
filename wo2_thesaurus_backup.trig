    dcterms:created "2020-06-09T08:24:56.000Z"^^xsd:dateTime;
    skos:prefLabel "Silbertanne-moord op Engbertus Johannes Roelfsema"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote """De Silbertanne-moord op Engbertus Johannes Roelfsema vond plaats op 29 september 1943 in Toldijk. Roelfsema was chirurg in Meppel en had een gewonde verzetsman geholpen. Hij werd doodgeschoten door van Efferen, Jebbink en Bellmer. De moord was wraak voor de liquidatie van drie NSB'ers.
"""@en .
  
