    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Strijdend_Nederland;_het_contact_met_de_vrije_wereld_(verzetsblad,_Kampen)&oldid=50765774"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/bakkerm>;
