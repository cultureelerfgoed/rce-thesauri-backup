    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Wikipedia:Wikiproject/Verzetskranten/Beginnetjes/Brieven_aan_sociaal-democraten_(verzetsblad,_Den_Haag)&oldid=46516857"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4819>;
