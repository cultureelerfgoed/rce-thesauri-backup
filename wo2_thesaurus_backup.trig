    skos:prefLabel "Jungfern Breschan"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote """Aussenlager Jungfern Breschan (nu Panenské Břežany) was 14 februari 1944 tot 8 mei 1945 een buitenkamp van Flossenbürg waar aanvankelijk 30 Joodse gevangenen afkomstig uit het Getto Theresienstadt tewerkgesteld waren bij landarbeid en bosbouw op het landgoed van Lina Heydrich. Als deze gedeporteerd worden komen in februari 1944 15 Jehova's Getuigen (waaronder Nederlanders) uit het concentratiekamp Sachsenhausen.
"""@nl;
    skos:altLabel "Aussenlager Panenské Břežany"@nl, "Aussenlager Jungfern Breschan"@nl,
      "Panenské Břežany"@nl;
