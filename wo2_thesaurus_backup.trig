    dcterms:source "https://www.justis.nl/producten/gratie/wat-is-gratie"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Gratie was de vermindering of kwijtschelding van een opgelegde straf. Alleen de koningin kon gratie verlenen. De minister van Justitie adviseerde de koningin als er een gratieverzoek werd gedaan."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
