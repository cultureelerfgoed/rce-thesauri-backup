    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/f36926f0-025a-11e7-904b-d89d6717b464/media/d9617ff2-4e93-a88b-ffa5-e1293aee6070";
    <http://schema.org/location> "Enschede";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/b902da10-025a-11e7-904b-d89d6717b464/media/2c2c256f-9976-b155-c35f-5c28b905c6f5>,
      <https://beeldbankwo2.nl/nl/beelden/detail/f36fe6ca-025a-11e7-904b-d89d6717b464/media/20bf3c63-ba71-44a5-7750-9b41c3e29cd7>,
      <https://beeldbankwo2.nl/nl/beelden/detail/3631d4b0-025a-11e7-904b-d89d6717b464/media/4932515a-8801-ac04-2fe6-2a583f478e7c>;
    <http://schema.org/startDate> "1945-04-01"^^xsd:date;
    dcterms:source "https://stadsarchief.enschede.nl/00001/oorlogen/oorlog/00047/"@nl;
    <http://schema.org/name> "Enschede";
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/6983>;
    dcterms:created "2018-10-31T10:43:35.000Z"^^xsd:dateTime;
    skos:prefLabel "Befreiung von Enschede"@de, "Liberation of Enschede"@en, "Bevrijding Enschede"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De bevrijding van Enschede vond plaats op 1 april 1945. Op eerste Paasdag marcheerden Britse soldaten vanuit het zuiden Enschede binnen. Het westen was moeilijker te bereiken vanwege het Twentekanaal, maar de Engelsen veroverden de Lonnekerbrug. Op 2 april werd ook het vliegveld veroverd. "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/7120> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
