    dcterms:modified "2025-04-06T09:25:10.285Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1939-09-01"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/640x480/aa3f7b15-5396-7f52-6c8d-c2196039ddca.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/d1b796be-0259-11e7-904b-d89d6717b464/media/aa3f7b15-5396-7f52-6c8d-c2196039ddca"@nl;
    dcterms:source "https://www.dbnl.org/tekst/_maa003198201_01/_maa003198201_01_0037.php"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1940-09-11"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2244>;
    dcterms:created "2018-11-29T11:38:47.000Z"^^xsd:dateTime;
    skos:prefLabel "Mussert-Garde"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Mussert-Garde was een nationaalsocialistische paramilitaire jeugdorganisatie dat formeel onderdeel was van de NSB en in de zomer van 1939 door de NSB’er Henk Feldmeijer werd opgericht. Het opereerde aanvankelijk achter de schermen vanwege het wettelijke verbod voor weerkorpsen. De NSB-leiding streefde ernaar om door dit keurkorps jongeren aan te trekken en tegelijkertijd het kader te vormen voor een nieuw op te richten weerkorps. Feldmeijer stond bij de Mussert-Garde daarentegen de organisatie en de ideologie van Himmlers SS voor ogen. Na de Duitse inval wilde de NSB-leider Mussert dat de Mussert-Garde als zijn persoonlijk elitekorps zou optreden naast de heropgerichte WA. De Duitsers dwongen hem op in september 1940 tot opheffing van dit korps en erin toe te stemmen dat de Nederlandsche SS onder leiding van Feldmeijer kwam te staan. De Mussertgarde werd op 16 september 1940 ontbonden."@nl;
    skos:altLabel "Mussertgarde"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Organization> .
  
