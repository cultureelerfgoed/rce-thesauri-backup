    <http://schema.org/startDate> "1944-06-22"^^xsd:date;
    <http://schema.org/endDate> "1944-08-19"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Operatie_Bagration&oldid=55204086"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3558>;
    dcterms:created "2020-09-10T11:59:34.000Z"^^xsd:dateTime;
    skos:prefLabel "Operatie Bagration"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Operatie Bagration was de codenaam voor een offensief door het Rode Leger op het Oostfront van 22 juni tot 19 augustus 1944. De operatie resulteerde in de herovering van Wit-Rusland en het oosten van Polen. Dit had grote gevolgen voor het Duitse Rijk: een verlies aan manschappen, materieel en terrein was groter dan bij de slag om Stalingrad of de nederlaag in Normandië. De naam van de operatie verwijst naar Pjotr Bagration, een Russisch generaal ten tijde van de invasie van Rusland door Napoleon Bonaparte."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9402> a <http://schema.org/Thing>, skos:Concept,
