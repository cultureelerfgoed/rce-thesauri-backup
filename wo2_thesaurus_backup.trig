    dcterms:created "2019-03-12T11:40:54.000Z"^^xsd:dateTime;
    skos:prefLabel "Opvangplek Openluchtmuseum Arnhem"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Opvangplek Openluchtmuseum Arnhem functioneerde als zodanig nadat de bezetter de Slag om Arnhem had gewonnen, maar de inwoners van Arnhem en Oosterbeek werden geëvacueerd. Circa 600 vluchtelingen vonden van september 1944 tot januari 1945 onderdak in het museum, waarbij ook de historische gebouwen werden betrokken. Na het vertrek van de vluchtelingen werd vanaf 2 april 1945 op het terrein van het museum Duitse artillerie (houwitsers) opgesteld, bevond zich er een groot aantal loopgraven en werden militairen ondergebracht in de oude huisjes."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/3455>, <https://data.niod.nl/WO2_Thesaurus/3585>,
      <https://data.niod.nl/WO2_Thesaurus/events/4411>, <https://data.niod.nl/WO2_Thesaurus/1829>;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
