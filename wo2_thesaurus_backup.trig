    skos:broader <https://data.niod.nl/WO2_Thesaurus/1690>, <https://data.niod.nl/WO2_Thesaurus/8204>,
      <https://data.niod.nl/WO2_Thesaurus/19098>;
    dcterms:created "2025-01-06T21:37:03.935Z"^^xsd:dateTime;
    skos:prefLabel "Pakis Tajoe"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Pakis Tajoe was een mannenkamp vlak bij de kustplaats Tayu, 25 kilometer ten noorden van Pati, Midden-Java. Het kamp was ondergebracht in een bijgebouw van de suikerfabriek Pakis. In de periode van augustus 1943 tot 20 januari 1944 waren hier 40 mannen geïnterneerd die om verschillende redenen eerder buiten de kampen waren gebleven, waaronder BPM-personeel, missionarissen en Nederlandse artsen."@nl;
    skos:altLabel "Suikerfabriek Pakis"@nl, "S.F. Pakkies"@nl .
  
