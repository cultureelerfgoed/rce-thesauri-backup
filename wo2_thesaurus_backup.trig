    dcterms:source "https://merwedegijzelaars.nl/werkplek/1/bussing-flumo-zoutmijn-graslebenwalbeck"@nl,
      "https://de.wikipedia.org/w/index.php?title=KZ-Au%C3%9Fenlager_Weferlingen&oldid=168201101"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/18626>;
