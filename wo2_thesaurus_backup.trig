    skos:prefLabel "Stafleider"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De stafleider gaf leiding aan de gewestleiders van de Nationale Jeugdstorm en werd daarin bijgestaan door de landelijke staf. De stafleider was tegenover de hoofdstormer verantwoordelijk voor het optreden van de Jeugdstorm in het algemeen."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4553> .
  
  <https://data.niod.nl/WO2_Thesaurus/19892> a <http://schema.org/Thing>, skos:Concept;
