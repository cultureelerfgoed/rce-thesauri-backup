      <http://collectie.atlasvanstolk.nl/data_nl.asp?startc=1&q0=30464&subj=1&bron=g>, <https://beeldbankwo2.nl/nl/beelden/detail/0945a756-025a-11e7-904b-d89d6717b464/media/7b1912c9-7e35-6285-fc77-464fd7510d2c>;
    <http://schema.org/startDate> "1947-08-24"^^xsd:date;
    <http://schema.org/description> "Op initiatief van de VN gaat een Commissie van Goede Diensten (CGD) bemiddelen tussen Nederland en de Republiek Indonesië. De drie commissieleden voeren gesprekken met vertegenwoordigers van de Nederlands-Indische regering en de Republiek Indonesië. De internationale gemeenschap bemoeit zich steeds nadrukkelijker met het Nederlands-Indonesisch conflict. Hierbij staan net gedekoloniseerde landen als India en Pakistan aan Indonesische zijde. Maar ook de Verenigde Staten, de Sovjet Unie en Australië staan kritisch ten opzichte van Nederland. Engeland en vooral Frankrijk en België hebben meer begrip voor het Nederlandse standpunt."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/4379>, <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2019-04-01T10:42:38.000Z"^^xsd:dateTime;
    skos:prefLabel "Start bemiddeling Commissie van Goede diensten tussen Nederland en de Republiek Indonesië"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Start bemiddeling Commissie van Goede diensten tussen Nederland en de Republiek Indonesië is op 24 augustus 1947. De oprichting van de commissie vindt plaats op initiatief van de VN. De drie commissieleden voeren gesprekken met vertegenwoordigers van de Nederlands-Indische regering en de Republiek Indonesië."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8254> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:32:17.586Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/17838>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/wo2nedindieThema> "Koloniale oorlog";
    <http://schema.org/location> "Balongsari";
    <http://schema.org/startDate> "1947-12-09"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Bloedbad_van_Rawagede&oldid=53230658"@nl;
    <http://schema.org/description> "Op zoek naar de leider van een guerrillagroep trekken Nederlandse militairen op 9 december door het dorp Rawahgedeh in het district Krawang op Java. Bij de ondervraging van de bevolking in de dagen daarop executeren de Nederlandse militairen standrechtelijk honderden mannen; de aantallen die later de ronde doen variëren van 150 tot 431. Volgens krantenberichten uit die dagen zou het gaan het om ‘bendeleden’. In een reactie noemen de Verenigde Naties de actie bij Rawahgedeh ‘doelbewust en meedogenloos’. Niemand wordt vervolgd."@nl;
    skos:relatedMatch <https://data.niod.nl/WO2_biografieen/Fons-Wijnen>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/4379>;
    dcterms:created "2019-04-01T11:55:31.000Z"^^xsd:dateTime;
    skos:prefLabel "Bloedbad van Rawagede"@nl, "Rawagede massacre"@en, "Massaker von Rawagede"@de;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Bij het Bloedbad van Rawagede overvallen Nederlandse militairen op 9 december 1947 het dorp Rawagede (het huidige Balongsari) in het district Krawang op Java op zoek naar de leider van een guerrillagroep. De dagen daarop executeren de Nederlandse militairen buitenrechtelijk honderden mannen; de aantallen slachtoffers die later de ronde doen variëren van 150, volgens vooral Nederlandse bronnen, tot 431, volgens vooral Indonesische bronnen."@nl;
    skos:altLabel "Bloedbad van Rawahgedeh"@nl, "Bloedbad van Rawagade"@nl, "Bloedbad van Rawagedeh"@nl,
      "Bloedbad van Rawagadeh"@nl .
  
