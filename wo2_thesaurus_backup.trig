  <https://data.niod.nl/WO2_Thesaurus/9309> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    dcterms:modified "2025-08-26T14:11:35.598Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/2/2c/Swedish_Red_Cross_men_outside_their_buses.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/wiki/Category:White_Buses_(humanitarian_aid_in_1945)#/media/File:Swedish_Red_Cross_men_outside_their_buses.jpg";
    <http://schema.org/startDate> "1945-03-15"^^xsd:date;
    <http://schema.org/endDate> "1945-04-26"^^xsd:date;
    dcterms:source "https://nos.nl/75jaarbevrijding/bericht/2331986-nederlandse-vrouwen-gered-uit-concentratiekamp-ravensbruck.html"@de;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    skos:relatedMatch <https://data.niod.nl/WO2_biografieen/Mien-Sneevliet-Draaijer>,
      <https://data.niod.nl/WO2_biografieen/Trijntje-de-Haan-Zwagerman>, <https://data.niod.nl/WO2_biografieen/Selma-van-de-Perre-Velleman>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4665>;
    dcterms:created "2020-08-26T07:25:23.000Z"^^xsd:dateTime;
    skos:prefLabel "Witte Bussen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De voorzitter van het Zweedse Rode Kruis, Graaf Folke Bernadotte, had in maart/april 1945 in het geheim onderhandeld met Heinrich Himmler, die eventueel wel vrede met de Westerse bondgenoten wilde sluiten. De Witte Bussen van het Zweedse Rode Kruis, voorzien van een rood kruis op het dak, wisten in april 1945 ruim 15.000 concentratiekamp gevangenen te redden. Onder het totale aantal waren ongeveer 11.000 Joden. De gevangenen werden verzameld in Kamp Neuengamme en vanaf daar naar Zweden gebracht. Ook werden honderden Nederlandse vrouwen uit Kamp Ravensbrück, Dachau en Mauthausen gered. Onderweg werden de vrachtwagens en ambulances beschoten door geallieerde vliegtuigen in de buurt van Schwerin, waarbij een aantal doden vielen. De gevangenen die in de kampen waren overgebleven werden op dodenmarsen gestuurd, waarbij een groot deel om het leven kwam."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/11206>, <https://data.niod.nl/WO2_Thesaurus/events/18873>;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
