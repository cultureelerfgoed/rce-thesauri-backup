    skos:prefLabel "De koerier; streekblad voor de Hoeksche Waard e.o."@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het illegale blad De Koerier : Streekblad voor de Hoeksche Waard e.o. werd van 7 oktober 1944 tot mei 1945 uitgegeven in Oud-Beijerland (Zuid-Holland) onder hoofdredactie van C.M. Langeveld. Het blad verscheen aanvankelijk wekelijks; vanaf januari 1945 2x per week."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8706> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "PPN: 041668677"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2020-09-01T12:02:02.000Z"^^xsd:dateTime;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>;
    dcterms:created "2019-11-07T15:52:12.000Z"^^xsd:dateTime;
    skos:prefLabel "De koerier; mededelingenblad van 'Je Maintiendrai'"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het illegale blad De Koerier : Mededelingenblad van Je Maintiendrai werd van 4 januari 1945 tot en met eind april 1945 uitgegeven in Warga (Friesland) onder redactie van ds. J.J. Kalma. Het verscheen wekelijks. Het blad bevatte voorlichtende artikelen en een militair weekoverzicht."@nl .
  
