    <http://www.w3.org/2003/01/geo/wgs84_pos#long> "12.9898"^^xsd:float;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    dcterms:modified "2021-08-25T09:39:39.221Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/54cc5060-40d2-1307-2992-6a05426fb80d.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/aab0d148-0259-11e7-904b-d89d6717b464/media/54cc5060-40d2-1307-2992-6a05426fb80d";
    dcterms:source "https://en.wikipedia.org/wiki/Stalag_IV-D"@nl, "https://krijgsgevangen.nl/stalag-iv-d-torgau/"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/6411>;
    dcterms:created "2018-07-13T09:02:25.000Z"^^xsd:dateTime;
    skos:prefLabel "Stalag IV-D"@nl, "Stalag IV-D"@de, "Stalag IV-D"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Stalag IV-D was een Duits krijgsgevangenkamp in Torgau, Duitsland. Het kamp was over twee locaties verdeeld. Het administratieve deel zat in een voormalige kazerne en de andere locatie was een voormalige vlaggenfabriek en drukkerij. Vanaf 1941 zaten hier ongeveer 800 krijgsgevangenen van diverse nationaliteiten die via Arbeitskommandos in de regio te werk werden gesteld. Eind april werd het kamp bevrijd door Amerikaanse en Russische troepen."@nl;
    skos:altLabel "Stalag IV D"@nl, "Stalag IV-D Torgau"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/6434> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "51.301398"^^xsd:float;
    <http://www.w3.org/2003/01/geo/wgs84_pos#long> "13.108592"^^xsd:float;
