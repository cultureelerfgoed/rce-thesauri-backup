    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/b/bd/Landgoed_Laag_Soeren_voormalig_BETHESDA%2C_links_het_badhuis.jpg/500px-Landgoed_Laag_Soeren_voormalig_BETHESDA%2C_links_het_badhuis.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Bestand:Landgoed_Laag_Soeren_voormalig_BETHESDA,_links_het_badhuis.jpg";
    dcterms:source "https://mijngelderland.nl/inhoud/verhalen/het-badhuis-in-laag-soeren"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/isPointofInterest> true;
    <https://data.niod.nl/EventsWO2/location> "Laag-Soeren";
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2843>, <https://data.niod.nl/WO2_Thesaurus/events/4411>,
      <https://data.niod.nl/WO2_Thesaurus/locations/9622>, <https://data.niod.nl/WO2_Thesaurus/7815>;
    dcterms:created "2019-03-06T13:14:04.000Z"^^xsd:dateTime;
    skos:prefLabel "Badhuis Laag-Soeren"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Badhuis Laag-Soeren was een kuuroord dat in juli 1942 in beslag werd genomen door de SS en daarna gebruikt werd als Erholungsheim. Dit was een ontspannings-/herstellingsoord voor militairen en vrijwilligers van de Waffen-SS die aan het Oostfront gevochten hadden die hier op krachten konden komen. Later werd het kuuroord gebruikt als ziekenhuis en vanaf de Slag om Arnhem deed de locatie dienst als Hauptverbandplatz van de 9.SS-Panzer Division 'Hohenstaufen'."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4886> .
  
