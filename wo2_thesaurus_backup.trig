  <https://data.niod.nl/WO2_Thesaurus/events/18964> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2022-04-29T09:38:04.451Z"^^xsd:dateTime;
