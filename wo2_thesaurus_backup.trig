    dcterms:source "http://mediawiki.arts.kuleuven.be/geschiedenisjapan/index.php?title=Groot_Oost-Aziatische_Welvaartssfeer&oldid=155298"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/events/8154>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1887>;
    dcterms:created "2019-01-15T09:35:46.000Z"^^xsd:dateTime;
    skos:prefLabel "Groot Oost-Aziatische Welvaartssfeer"@nl, "Großostasiatische Wohlstandssphäre"@de,
      " Greater East Asia Co-Prosperity Sphere"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Groot Oost-Aziatische Welvaartssfeer was een in 1940 ontstaan Japans idee dat de vereniging van Oost-Aziatische landen voorstond, om zo los te kunnen komen van de westerse koloniale machten in Azië en samenwerking af te kunnen dwingen met ander grote machtsblokken. Door landen die bezet werden door Japan werd het idee echter gezien als een uitbreiding van de Japanse greep op Oost-Azië. Hoewel er vanaf 1942 tot het eind van de oorlog een Ministerie van Groot Oost-Azië was, bleef de feitelijke macht, in bezette gebieden, in handen van het Japans Keizerlijke Leger."@nl;
    skos:altLabel "Dai Tōa Kyōei-ken"@nl, "Greater East Asia Co-Prosperity Sphere"@en,
      "Grote Oost-Aziatische Welvaartssfeer"@nl, "Sfeer van gemeenschappelijk welvaart van Groter Oost Azië"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/7797>, <https://data.niod.nl/WO2_Thesaurus/events/4382> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7707> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
