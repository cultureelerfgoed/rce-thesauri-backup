    dcterms:source "https://www.pegasusarchive.org/pow/cSt_12B.htm"@nl, "https://books.google.nl/books?id=rsRLEAAAQBAJ&pg=PA442&lpg=PA442&dq=stalag+XII-B/527&source=bl&ots=B7eXidf8-H&sig=ACfU3U0SpUqpBBymeE8XYIQkpLEYyw73BA&hl=nl&sa=X&ved=2ahUKEwiZ4M6U8q71AhXFC-wKHZtMAiYQ6AF6BAgbEAM#v=onepage&q=stalag%20XII-B%2F527&f=false"@nl;
