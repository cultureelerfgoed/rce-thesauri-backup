    skos:prefLabel "Al-Irshad Al-Islamiya"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Al-Irshad Al-Islamiya bestaat sinds 6 september 1914 en is opgericht door Ahmad Surkati. Net als bij de Muhammadiya hebben zij als doel moslims de moderne tijd te laten omarmen en hen dit te later rijmen met hun geloof. Het verschil is dat de achterban van Al-Irshad wordt gevormd door Indonesiërs van Arabische afkomst."@nl;
    skos:altLabel "Jam'iyat al-Ishlah wal Irshad al-Islamiyya"@nl, "The Arab Association for Reform and Guidance"@en;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
