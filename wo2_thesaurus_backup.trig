    skos:broader <https://data.niod.nl/WO2_Thesaurus/2163>, <https://data.niod.nl/WO2_Thesaurus/2210>;
    dcterms:created "2026-02-18T11:16:49.096Z"^^xsd:dateTime;
    skos:prefLabel "Kunsthandel Rudolf Elion & Co."@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Kunsthandel Rudolf Elion & Co. werd opgericht door de Joodse kunsthandelaar Ruben Elion. In de jaren dertig was de kunsthandel gevestigd aan de Prinsengracht 438 in Amsterdam en vanaf 1941 op nr. 701.Tijdens de Duitse bezetting kwam Elion door verdrinking om het leven. De kunsthandel werd overgenomen door de Duitse trustmaatschappij Omnia Treuhandgesellschaft, die het bedrijfseigendom beheerde en liquideerde. In 1943 werd de kunsthandel definitief gesloten. Alle kunstvoorwerpen worden tot op heden vermist."@nl;
    skos:altLabel "R. Elion & Co"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
