    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/19853>;
    dcterms:created "2023-08-22T14:06:37.965Z"^^xsd:dateTime;
    skos:prefLabel "Districtsbeheerder"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De districtsbeheerder was de functionaris binnen de NSB die voor de districtsleider alle zaken regelde die betrekking hadden op de organisatie en de functionarissen binnen een district. Hij verrichtte deze werkzaamheden overeenkomstig de door het hoofdkwartier van de NSB gegeven opdrachten en voorschriften. Bij de uitvoering van zijn taak pleegde hij overleg met de districtsleider."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2244> .
  
  <https://data.niod.nl/WO2_Thesaurus/20042> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "NSB, Deel V Het District (Utrecht 1 oktober 1937) p. 14-17. Dit document is aanwezig in NSB-archief inv.nr 1985."@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2025-07-28T14:43:45.639Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/19853>;
    dcterms:created "2023-08-22T14:07:40.500Z"^^xsd:dateTime;
    skos:prefLabel "Districtsadministrateur"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De districtsadministrateur, later aangeduid met de rang administratief districtsinspecteur, was de functionaris binnen de NSB die binnen het district optrad als vertegenwoordiger van hoofdafdeling Financiën van het hoofdkwartier. Hij gaf leiding aan de werkzaamheden van de kring- en groepsadministrateurs en controleerde regelmatig hun werkzaamheden. "@nl;
    skos:altLabel "Administratief Districtsinspecteur"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2244> .
  
  <https://data.niod.nl/WO2_Thesaurus/20043> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "NSB, Deel V Het District (Utrecht 1 oktober 1937) p. 18-21. Dit document is aanwezig in NSB-archief inv.nr 1985. Zie ook NSB, Distinctieven der Beweging. Uitgegeven in opdracht van de Organisatieleider der N.S.B. (z.p. z.j.; oorlogsperiode) p. 10."@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2025-07-28T14:45:28.301Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/19853>;
    dcterms:created "2023-08-22T14:08:54.552Z"^^xsd:dateTime;
    skos:prefLabel "Districtspenningmeester "@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De districtspenningmeester was de functionaris binnen de NSB die was belast met de financiële administratie en het beheer van de gelden van het district. Hij gaf leiding aan de werkzaamheden van de kring- en groepspenningmeesters en controleert regelmatig of de door het district toegewezen gelden, aangevuld door winsten gemaakt door bepaalde kring- en groepsdiensten, besteed werden volgens de voorschriften van de districtsleider."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2244> .
  
  <https://data.niod.nl/WO2_Thesaurus/20044> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "Standaardbrief Van Geelkerken, 1 oktober 1937, met de mededeling dat reorganisatie per deze datum ingaat, in: NSB-archief inv.nr. 346. Voor de positie en de taken van de Districtsleider zie: NSB, Deel V Het District (Utrecht 1 oktober 1937), aanwezig in NSB-archief inv.nr. 1985. Zie ook NSB, Distinctieven der Beweging. Uitgegeven in opdracht van de Organisatieleider der N.S.B. (z.p. z.j.; oorlogsperiode) p. 10."@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2025-07-31T13:44:46.602Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/19853>;
    dcterms:created "2023-08-22T14:10:14.258Z"^^xsd:dateTime;
    skos:prefLabel "Plaatsvervangend Districtsleider"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De plaatsvervangend districtsleider was de functionaris binnen de NSB die optrad als plaatsvervanger van de districtsleider. De districtsleider stond aan het hoofd stond van een district, bestaande uit meerdere kringen. Hij ontving zijn opdrachten van of namens de leider en stuurde de kringleiders in zijn kring district aan. Vanaf 1 oktober 1937 bestond de functie plaatsvervangend districtsleider toen de indeling in gewesten werd vervangen door die in districten. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2244> .
  
  <https://data.niod.nl/WO2_Thesaurus/20045> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "NSB, Distinctieven der Beweging. Uitgegeven in opdracht van de Organisatieleider der N.S.B. (z.p. z.j.; oorlogsperiode) p. 10."@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2025-07-28T14:46:36.134Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/19853>;
    dcterms:created "2023-08-22T14:14:28.570Z"^^xsd:dateTime;
    skos:prefLabel "Districtsvormingsleider"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Districtspropagandaleider was de functionaris binnen de NSB die in het district verantwoordelijk was voor de propaganda. Hij gaf onder meer leiding aan de werkzaamheden van de kringpropagandisten."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2244> .
  
