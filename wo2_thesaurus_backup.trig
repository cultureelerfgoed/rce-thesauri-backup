    skos:prefLabel "Scheepsramp Lisbon Maru"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Scheepsramp met de Lisbon Maru vond plaats op 1 en 2 oktober 1942. De Lisbon Maru was een Japans helleschip waarmee circa 2.000 Engelse krijgsgevangenen vanuit Hongkong naar Japan werden getransporteerd. Het schip werd op 1 oktober 1942 getorpedeerd door de Amerikaanse onderzeeboot USS Grouper en zonk op 2 oktober 1942. Ongeveer 800 van de Engelse krijgsgevangenen verdronken of werden neergeschoten door de Japanse bewakers. "@nl;
    skos:altLabel "Lisbon Maru"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/1902> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2017-12-18T14:08:07.000Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://service.archief.nl/gaf/api/file/v1/img/f073bbe8-173c-4031-b115-f453e85f0a3b?h=1000";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://www.nationaalarchief.nl/onderzoeken/fotocollectie/65e95d1e-cda8-8ac6-db8c-16a48a07f318";
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Imperialisme&oldid=48736969"@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/demoadmin>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1887>;
    dcterms:created "2016-08-01T19:19:28.000Z"^^xsd:dateTime;
    skos:prefLabel "Imperialismus"@de, "Imperialism"@en, "Imperialisme"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Imperialisme is het proces waarbij landen hun macht in andere delen van de wereld uit willen breiden door gebieden te veroveren en te beheersen. "@nl;
    skos:definition "Imperialisme is het proces waarbij landen hun macht in andere delen van de wereld uit willen breiden door gebieden te veroveren en te beheersen. Het overnemen gebeurt niet, zoals bij Kolonialisme, alleen om de economische redenen. Het gaat er ook vooral om, om de eigen cultuur en politiek over te brengen of te forceren op de overheerste bevolking."@nl .
  
