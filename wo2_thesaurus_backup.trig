    <http://schema.org/startDate> "1942-05-04"^^xsd:date;
    <http://schema.org/endDate> "1942-05-08"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Slag_in_de_Koraalzee&oldid=52103620"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3536>, <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2019-03-28T12:03:04.000Z"^^xsd:dateTime;
    skos:prefLabel "Slag in de Koraalzee"@nl, "Battle of the Coral Sea"@en, "Schlacht im Korallenmeer"@de;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Tijdens De slag in de Koraalzee, van 6 mei tot 8 mei 1942, behaalt de Japanse marine een tactische overwinning maar lijdt het een strategische nederlaag. In dit treffen lijdt de Japanse Gecombineerde Vloot in tegenstelling tot de Amerikaanse marine lichte verliezen. De zeeslag dwingt echter de Japanners om een geplande overzeese aanval op Port Moresby, aan de zuidkant van Australisch Nieuw-Guinea, op te geven."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8223> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2021-03-15T16:54:09.526Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8028>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/wo2nedindieThema> "Indonesisch nationalisme";
    <http://schema.org/location> "Batavia";
    <http://schema.org/startDate> "1942-07-09"^^xsd:date;
    <http://schema.org/description> "Soekarno, die door de Nederlanders van zijn verbanningsoord Benkoelen naar Padang is gebracht, wordt door de Japanse autoriteiten naar Batavia ontboden. Na zijn aankomst overlegt hij met de andere nationalistische voormannen, Soetan Sjahrir en Mohammed Hatta. Enkele dagen later vindt in het Paleis Koningsplein een ontmoeting plaats met luitenant-generaal Imamura, de hoogste Japanse autoriteit op Java. Soekarno verklaart bereid te zijn om met het Japanse militaire bestuur samen te werken. Imamura zegt hem op zijn beurt ‘een sterkere deelneming van de [Indonesische] bevolking aan het bestuur’ toe. Over de staatkundige toekomst van Indonesië wordt niets afgesproken."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2019-03-28T13:27:33.000Z"^^xsd:dateTime;
    skos:prefLabel "Terugkeer Soekarno uit ballingschap"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Bij de Terugkeer Soekarno uit ballingschap op 9 juli 1942 wordt hij door de Japanse autoriteiten naar Batavia ontboden. Na onderhandelingen verklaart Soekarno zich bereid om met het Japanse bestuur samen te werken. Imamura zegt hem op zijn beurt ‘een sterkere deelneming van de (Indonesische bevolking) aan het bestuur’ toe."@nl .
  
