    <http://schema.org/location> "Bombay";
    <http://schema.org/startDate> "1944-04-14"^^xsd:date;
    dcterms:source "https://en.wikipedia.org/wiki/1944_Bombay_explosion"@nl;
    skos:relatedMatch <https://data.niod.nl/WO2_Thesaurus/17788>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3511>;
    dcterms:created "2021-10-21T09:02:17.688Z"^^xsd:dateTime;
    skos:prefLabel "Scheepsramp Generaal van der Heyden"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Scheepsramp met de Generaal van der Heyden vond plaats op 14 april 1944. De Generaal van der Heyden was een Nederlands schip van de Koninklijke Paketvaart Maatschappij dat op 14 april in een van de havens van Bombay lag, het Victoria Dok. Die dag kwam het Britse munitieschip Fort Stikine door een ongeluk tot ontploffing. Omdat de Generaal van der Heyden slechts 150 meter hiervandaan lag werd het geraakt door brokstukken en ging verloren. 15 bemanningsleden kwamen om het leven."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/1870> .
  
