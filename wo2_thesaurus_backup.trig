  <https://data.niod.nl/WO2_Thesaurus/17563> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-03-02T15:37:14.698Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/11277>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/e/e0/Erklaerung_1933-06-25_%28seite_1%29.jpg/500px-Erklaerung_1933-06-25_%28seite_1%29.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Verklaring_van_Feiten#/media/Bestand:Erklaerung_1933-06-25_(seite_1).jpg";
    <http://schema.org/location> "Berlijn";
    <http://schema.org/startDate> "1933-06-25"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/wiki/Verklaring_van_Feiten"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2543>;
    dcterms:created "2021-09-07T08:12:17.590Z"^^xsd:dateTime;
    skos:prefLabel "Verklaring van Feiten"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "De Verklaring van Feiten was een publieke verklaring van Jehova's getuigen tijdens de vervolging in nazi-Duitsland. De geloofsgemeenschap was politiek neutraal, had het recht om in het openbaar te prediken en was slachtoffer van een misleidende informatiecampagne van andere religies. De auteur van het document was Joseph Franklin Rutherford, president van het Wachttorengenootschap. De verklaring werd vrijgegeven op een congres in Berlijn op 25 juni 1933 en leidde tot een nog heviger vervolging van Duitse Jehova's."@nl;
    skos:altLabel "Declaration of Facts"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/17567> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Dissel, Anita van, Martin Elands, Hylke Faber en Pieter Stolk, eds. De Nederlandse koopvaardij in oorlogstijd. Amsterdam: Boom, 2014."@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-03-02T15:56:40.566Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/028b8280-01c8-6093-b5c4-21bd13cd5f17.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/ed067e16-025a-11e7-904b-d89d6717b464/media/028b8280-01c8-6093-b5c4-21bd13cd5f17";
    <http://schema.org/startDate> "1940-06-06"^^xsd:date;
    <https://data.niod.nl/organizationsWO2/videoURL> "https://youtu.be/3WBcPMhC0dQ";
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1870>;
    dcterms:created "2021-09-07T08:42:23.420Z"^^xsd:dateTime;
    skos:prefLabel "Invoer Vaarplicht"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "De Invoer van de Vaarplicht vond plaats op 6 juni 1940. De vaarplicht was een dienstplicht voor de bemanning van de Nederlandse Koopvaardijschepen. Deze zeelieden werden verplicht persoonlijke diensten ten behoeve van de scheepvaart te verrichten tijdens de Tweede Wereldoorlog. De meeste Nederlandse zeelieden waren voor de Duitse inval nog op zee en konden door de vaarplicht pas ver na het einde van de oorlog naar huis terug. Iedere zeeman die zich aan deze plicht onttrok werd als deserteur gezien en als zodanig gestraft."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/17568> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Dissel, Anita van, Martin Elands, Hylke Faber en Pieter Stolk, eds. De Nederlandse koopvaardij in oorlogstijd. Amsterdam: Boom, 2014. Bezemer, K.W.L.  Geschiedenis van de Nederlandse koopvaardij in de Tweede Wereldoorlog / Dl. 1 en dl. 2. Tweede druk. Amsterdam: Elsevier, 1987. "@nl;
