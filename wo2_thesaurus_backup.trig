    skos:prefLabel "Zentralverwaltungswirtschaft"@de, "Planned economy"@en, "Planeconomie"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Een Planeconomie is een centraal geleide economie waarin alleen de staat recht heeft op het verstrekken van goederen en diensten, waardoor het marktmechanisme (balans vraag en aanbod) komt te vervallen."@nl;
    skos:altLabel "Vierjarenplannen"@nl, "Vijfjarenplannen"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/21352> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:references "Correspondentie van mr. M.M. Rost van Tonningen. Deel 1 1921- mei 1942 (Den Haag 1967) 68-69."@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2024-10-15T15:46:58.368Z"^^xsd:dateTime;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/4888>;
    dcterms:created "2024-10-15T15:39:11.004Z"^^xsd:dateTime;
    skos:prefLabel "S.A.-Rost"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De S.A.-Rost was een Haags paramilitair weerkorps dat bestond uit een vijftigtal jonge aanhangers van NSB-voorman Meinoud Rost van Tonningen. Het korps, dat actief was tussen 1939 en eind 1940, was anti-Joods en sterk pro-Duits. De leden vergezelden Rost naar vergaderingen en waren regelmatig betrokken bij vechtpartijen."@nl;
    skos:altLabel "SA-Rost"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
