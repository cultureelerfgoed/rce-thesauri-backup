    skos:prefLabel "Joods Kinderdorp Ilaniah"@nl, "Children’s village Ilaniah"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Kinderdorp Ilaniah werd in juli 1947 opgericht en was gevestigd in het complex van het Apeldoornsche Bosch, dat tijdens de oorlog een Joodse psychiatrische kliniek was. Ilaniah diende als opvangplek voor ongeveer 440 Joodse kinderen, waar zij voorbereid werden op het vertrek naar Israël in oktober 1948. De jongens kregen hier lessen in hout bewerken en boeken binden. Meisjes volgden naaicursussen."@nl;
    skos:altLabel "Kibbutz Ilaniah"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/locations/11426>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/locations/8293> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2021-06-25T08:44:30.903Z"^^xsd:dateTime;
