  <https://data.niod.nl/WO2_Thesaurus/19890> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "N.K.C.A. in ’t Veld, De SS en Nederland. Documenten uit SS-archieven 1935-1945. Deel 1 (Den Haag 1976) p. 248."@nl,
      "A. Dekker, Ook Gij behoort bij ons. Het NSKK in de Lage Landen (z.p. 2013) p. 199."@nl,
      "N.J.G. Sikkel (red.), Documentatie. Samengesteld ten behoeve van de Bijzondere Rechtspleging, op last van de Procureur-Fiscaal bij het Bijzonder Gerechtshof te Amsterdam (Amsterdam 1947) p. 191"@nl,
      "NSB, Distinctieven der Beweging. Uitgegeven in opdracht van de Organisatieleider der N.S.B. (z.p. z.j.; oorlogsperiode) p. 20 "@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2025-07-31T12:59:47.480Z"^^xsd:dateTime;
    dcterms:source "https://nl.wikipedia.org/wiki/Nederlandsche_SS"@nl, "https://nl.wikipedia.org/w/index.php?title=Lijst_van_rangen_en_insignes_van_het_Nationalsozialistisches_Kraftfahrkorps&oldid=63799261"@nl,
      "https://nl.wikipedia.org/wiki/Lijst_van_militaire_rangen_van_de_Schutzstaffel"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/19853>;
    dcterms:created "2023-07-20T09:46:31.727Z"^^xsd:dateTime;
    skos:prefLabel "Oberscharführer"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De rang van SS-Oberscharführer (afkorting: Oscha.) in de SS en de Waffen-SS is vergelijkbaar met de rang van stafsergeant. De Waffen-SS was de militaire tak van de SS. Vanaf juni 1940 werden Nederlanders geworven voor de Waffen-SS. De rang opperschaarleider in de Nederlandsche SS was het equivalent van de rang SS-Oberscharführer in de SS en de Waffen-SS. Deze rang was vergelijkbaar met de rang van stafsergeant. Vanaf januari 1944 werden ook in de Nederlandsche SS de Duitse rangaanduidingen gebruikt. De rang opperschaarleider in de Nederlandsche Landwacht was het equivalent van de rang SS-Oberscharführer in de SS en de Waffen-SS en werd ook in de Nederlandsche SS gebruikt. De rang opperschaarleider was vergelijkbaar met de rang van stafsergeant. De rang van Oberscharführer (hogere sectieleider) in de Nationalsozialistisches Kraftfahrkorps (NSKK) is vergelijkbaar met de rang van sergeant. Het NSKK was een paramilitair onderdeel van de NSDAP dat in de oorlog diende als bevoorradingseenheid aan de verschillende fronten. Met steun van de NSB-leiding begon in januari 1941 de werving van Nederlandse vrijwilligers voor het NSKK."@nl;
    skos:altLabel "NSKK-Oberscharführer"@nl, "NSKK Oberscharführer"@nl, "SS-Oberscharführer"@nl,
      "SS Oberscharführer"@nl, "Oscha."@nl, "Opperschaarleider"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4619>, <https://data.niod.nl/WO2_Thesaurus/2249>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/4717>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4521>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/4886> .
  
