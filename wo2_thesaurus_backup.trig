    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/16a53998-025a-11e7-904b-d89d6717b464/media/37237336-a154-d4ba-750e-39345cf97b9f";
    <http://schema.org/startDate> "1944-08-02"^^xsd:date;
    <http://schema.org/endDate> "1944-08-03"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
