    skos:prefLabel "Slag om Soerabaja"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Bij de Slag om Soerabaja vallen Britse troepen op 10 november 1945 de stad binnen als een Brits ultimatum over de inlevering van wapens in Soerabaja niet wordt nageleefd. Ondersteund door tanks, jachtbommenwerpers en scheepsgeschut, veroveren ze Soerabaja in moeizame straatgevechten waarbij naar schatting meer dan 15.000 Indonesiërs om het leven komen. Op 29 november 1945 is de stad in Britse handen."@nl;
    skos:altLabel "Peristiwa Surabaya"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8246> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2021-03-15T16:48:34.295Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8028>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/wo2nedindieThema> "Bersiap";
