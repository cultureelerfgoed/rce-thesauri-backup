    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://en.wikipedia.org/wiki/Oflag_IX-A/H#/media/File:Schloss-Spangenberg_Germany_October-2010_Front-View.jpg";
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/6407>;
