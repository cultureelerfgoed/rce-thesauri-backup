    <http://schema.org/startDate> "1940-05-10"^^xsd:date;
    dcterms:source "https://historiek.net/de-zelfmoordgolf-van-mei-1940/69171/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2322>;
    dcterms:created "2020-09-14T06:53:59.000Z"^^xsd:dateTime;
    skos:prefLabel "Zelfmoordgolf mei 1940"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Zelfmoordgolf van mei 1940 vond tijdens en vlak na de Duitse inval plaats. Honderden, vooral Joodse, mensen besloten in de eerste oorlogsmaand de toekomst onder Duits bewind niet af te wachten en stapten uit het leven. Sommigen deden dat alleen, anderen met hun partner of gezin. Het aantal zelfdodingen was in de eerste oorlogsmaand vijf keer zo hoog als het gemiddelde van mei in andere jaren. Ook daarna pleegden Joden die geen uitweg zagen voor deportatie zelfmoord."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9427> a <http://schema.org/Thing>, skos:Concept,
