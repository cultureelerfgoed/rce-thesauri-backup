    dcterms:created "2020-02-25T07:54:46.000Z"^^xsd:dateTime;
    skos:prefLabel "Tötungsanstalt Bernburg"@nl, "Tötungsanstalt Bernburg"@en, "Tötungsanstalt Bernburg"@de;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Tötungsanstalt Bernburg was tussen november 1940 en 1943 gevestigd in de psychiatrische inrichting van de stad Bernburg. Hier werden 14.384 personen (9.384 psychiatrische patiënten en 5.000 gevangenen afkomstig uit 6 concentratiekampen) door middel van vergassing vermoord."@nl;
    skos:altLabel "Bernburg"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/8815> a <http://schema.org/Thing>, skos:Concept,
