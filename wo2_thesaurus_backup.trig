    dcterms:references "N.J.G. Sikkel (red.), Documentatie. Samengesteld ten behoeve van de Bijzondere Rechtspleging, op last van de Procureur-Fiscaal bij het Bijzonder Gerechtshof te Amsterdam (Amsterdam 1947)"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    dcterms:modified "2025-05-20T13:12:26.834Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1941-10-22"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/d91a6d44-a1e3-2423-1d7d-fcba3b1deaf0.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/e0ceeaf8-0259-11e7-904b-d89d6717b464/media/d91a6d44-a1e3-2423-1d7d-fcba3b1deaf0";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/cbb8818c-025a-11e7-904b-d89d6717b464/media/611c5604-067e-474c-2f25-5cd3c8578512>,
      <https://beeldbankwo2.nl/nl/beelden/detail/2d2bd4ba-025a-11e7-904b-d89d6717b464/media/8c261e49-7d2f-0890-2b00-6d2bd2f82dbc>,
      <https://beeldbankwo2.nl/nl/beelden/detail/2d2a3114-025a-11e7-904b-d89d6717b464/media/7428c107-4d72-e747-2753-4e08ca4b8514>;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-06"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Nederlandsche Landstand was de boerenorganisatie van de Nationaal-Socialistische Beweging (NSB). De Nederlandsche Landstand werd op 22 oktober 1941 opgericht met als doel de landbouw en visserij onder nationaalsocialistische controle te brengen. Alle boeren, tuinders, vissers en hun familieleden waren verplicht lid van de Nederlandsche Landstand."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/corporaties/4438>, <https://data.niod.nl/WO2_Thesaurus/events/10726>,
      <https://data.niod.nl/WO2_Thesaurus/events/10727>, <https://data.niod.nl/WO2_Thesaurus/events/10729>,
      <https://data.niod.nl/WO2_Thesaurus/events/10736>, <https://data.niod.nl/WO2_Thesaurus/events/10739>,
      <https://data.niod.nl/WO2_Thesaurus/events/10742>, <https://data.niod.nl/WO2_Thesaurus/events/10744>,
      <https://data.niod.nl/WO2_Thesaurus/events/10746>, <https://data.niod.nl/WO2_Thesaurus/events/10747>,
      <https://data.niod.nl/WO2_Thesaurus/10749>, <https://data.niod.nl/WO2_Thesaurus/events/10752>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2186>, <https://data.niod.nl/WO2_Thesaurus/20640>;
    dcterms:created "2016-10-04T13:07:40.000Z"^^xsd:dateTime;
    skos:prefLabel "Nederlandsche Landstand"@nl, "'Nederlandsche Landstand'"@de, "'Nederlandsche Landstand'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Nederlandsche Landstand werd per verordening van Seyss-Inquart ingesteld op 22 oktober 1941 en had als doel het onder nationaalsocialistische leiding brengen van alle organisaties op het gebied van landbouw en visserij. De Landstand was een publiekrechtelijke organisatie, onder toezicht van de secretaris-generaal van Landbouw en Visserij. Evert Jan Roskam kreeg naast zijn leiderschap van de NSB-mantelorganisatie Agrarisch Front ook de leiding van de Nederlandsche Landstand. Het Agrarisch Front vormde de kern van de Landstand. Op grond van de oprichtingsverordening werd iedereen die boer of visser was of tot hun gezin behoorde, tot lid van de Landstand gerekend."@nl;
    skos:altLabel "Nederlandse Landstand"@nl, "Landstand"@nl, "Nederlandschen Landstand"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/locations/10755>, <https://data.niod.nl/WO2_Thesaurus/locations/10732>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/4609> a <http://schema.org/Thing>,
