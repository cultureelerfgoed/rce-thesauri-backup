    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8028>;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=GAPI&oldid=40095974"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2506>;
    dcterms:created "2019-01-23T13:05:40.000Z"^^xsd:dateTime;
    skos:prefLabel "GAPI"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De GAPI (Gabungan Politik Indonesia) werd in 1939 opgericht en was een samenwerkingsverband tussen alle Indonesische politieke partijen die streden voor onafhankelijkheid, uitgezonderd de PNI. De partijen hadden afgesproken niet meer alleen de strijd voor onafhankelijkheid aan te gaan, maar voortaan enkel als GAPI actie te ondernemen. "@nl;
    skos:altLabel "Gabungan Partai Politik Indonesia"@de, "Indonesische Politieke Federatie"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7744> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "Peter Post - The Encyclopedia of Indonesia in the Pacific War"@en,
      "Loe de Jong - Het Koninkrijk der Nederlanden in de Tweede Wereldoorlog"@nl;
