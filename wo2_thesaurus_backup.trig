    skos:prefLabel "Executie in Rotterdam, Kralingseweg, 18 oktober 1944"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 18 oktober 1944 vond op de schietbaan aan de Kralingseweg te Rotterdam de executie plaats van Jacob Nieuwstraten. Hij was ter dood veroordeeld wegens verboden wapenbezit en illegaal werk."@nl .
  
