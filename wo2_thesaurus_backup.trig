    dcterms:created "2019-11-07T10:57:33.000Z"^^xsd:dateTime;
    skos:prefLabel "Anoniem"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Anoniem was een verzetsblad uit Haarlem dat met een oplage van 300 stuks van 9 maart 1945 tot 4 mei 1945 eens in de drie weken verscheen. Het blad bestond uit opiniestukken over de problemen voor de jeugd die na de bezetting zouden (kunnen) ontstaan."@nl;
    skos:altLabel "'Anoniem'"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8664> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "PPN: 268598843"@nl;
