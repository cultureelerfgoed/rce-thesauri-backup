      <https://data.niod.nl/WO2_Thesaurus/11225>, <https://data.niod.nl/WO2_Thesaurus/events/5831>;
    dcterms:created "2023-01-23T12:37:03.859Z"^^xsd:dateTime;
    skos:prefLabel "Transport Buchenwald - Kamp Haaren, 15-11-1941"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 15 november 1941 werden alle overgebleven 239 Indische gijzelaars die zich nog in Kamp Buchenwald bevonden naar Kamp Haaren getransporteerd. Gedurende het transport kregen de Indische gijzelaars niets te drinken."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/19509> a <http://schema.org/Thing>, skos:Concept,
