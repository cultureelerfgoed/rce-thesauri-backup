    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/dbba7d2a-0259-11e7-904b-d89d6717b464/media/1fde5434-c18f-0e5f-6b7a-9b754b9ba6e2";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://nimh-beeldbank.defensie.nl/foto-s/dae764a4-f0ac-442b-5715-5adf26f89e0c>,
      <http://opac-gonext.oclc.org:8180/xslt/DB=8/XMLPRS=Y/PPN?PPN=050634909>, <http://opac-gonext.oclc.org:8180/xslt/DB=8/XMLPRS=Y/PPN?PPN=097763012>;
    <http://schema.org/startDate> "1943-10-01"^^xsd:date;
    dcterms:source "https://en.wikipedia.org/w/index.php?title=Louis_Mountbatten,_1st_Earl_Mountbatten_of_Burma&oldid=889228785"@en;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/7790>, <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2019-03-28T16:22:26.000Z"^^xsd:dateTime;
    skos:prefLabel "Benoeming Mountbatten tot opperbevelhebber SEAC"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De benoeming van Mountbatten tot opperbevelhebber SEAC (South East Asia Command) vond plaats op 1 oktober 1943. Als opperbevelhebber SEAC kreeg hij de leiding over de verdediging van Brits-Indië en herovering van Birma."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8228> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2021-03-15T15:37:22.813Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/9564>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/wo2nedindieThema> "Herbezetting Nederlands-Indië";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/250x250/9e781325-159d-20c8-fd8a-da925bbe6970.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/539fa3e2-025a-11e7-904b-d89d6717b464/media/9e781325-159d-20c8-fd8a-da925bbe6970";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/00a44e68-025a-11e7-904b-d89d6717b464/media/7024386c-e4fe-5554-3d3b-e99a7aa6dded>,
      <https://beeldbankwo2.nl/nl/beelden/detail/b0adddba-025a-11e7-904b-d89d6717b464/media/e8ed13bb-7c57-70d6-f1ed-8e0d72c7eac3>,
      <https://nimh-beeldbank.defensie.nl/foto-s/a5070032-d9d2-747b-7adb-b473c160db43>;
    <http://schema.org/startDate> "1944-04-21"^^xsd:date;
    <http://schema.org/endDate> "1944-04-27"^^xsd:date;
    dcterms:source "http://in.beeldengeluid.nl/collectie/details/expressie/25378/false/true"@nl;
    <http://schema.org/description> "Amerikaanse troepen gaan op twee plaatsen aan land bij Hollandia in Nieuw-Guinea. De Japanse legerleiding is volkomen verrast door de aanval. Met de gedurfde operatie passeert MacArthur sterke Japanse troepenconcentraties op de noordkust van Nieuw-Guinea. Zijn strategie wordt vergemakkelijkt doordat de Amerikaanse militaire inlichtingendiensten in staat zijn het gecodeerde berichtenverkeer van het Japanse leger te lezen. De verovering van het zwak verdedigde Hollandia brengt MacArthur in één klap 650 km dichterbij de Filippijnen. De operatie kost aan slechts 150 Amerikaanse soldaten het leven en wordt beschouwd als een van MacArthurs grootste triomfen."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2350>, <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2019-03-29T09:00:04.000Z"^^xsd:dateTime;
    skos:prefLabel "Herovering van Hollandia "@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Bij de Herovering van Hollandia van 21 tot 27 april 1944 gaan Amerikaanse troepen onder leiding van generaal MacArthur over tot een verrassingsaanval bij Hollandia in Nieuw-Guinea. Met de gedurfde operatie passeert MacArthur sterke Japanse troepenconcentraties op de noordkust van Nieuw-Guinea. De verovering van het zwak verdedigde Hollandia brengt MacArthur in één klap 650 km dichterbij de Filippijnen."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8229> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2019-04-14T06:49:57.000Z"^^xsd:dateTime;
