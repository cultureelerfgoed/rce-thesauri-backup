    <http://schema.org/startDate> "1945-05-08"^^xsd:date;
    dcterms:source "https://www.ad.nl/dordrecht/met-de-bevrijding-van-het-zuiden-begon-in-dordrecht-de-oorlog-pas-echt~ab39be45/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/6983>;
    dcterms:created "2020-08-27T08:49:02.000Z"^^xsd:dateTime;
    skos:prefLabel "Bevrijding Dordrecht"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De bevrijding van Dordrecht vond plaats op 8 mei 1945. Het Canadese leger marcheerde op 11 mei door Dordrecht en burgemeester Bleek werd op die dag opnieuw geïnstalleerd. Na de bevrijding van West-Brabant in november 1944 kwam Dordrecht in de frontlinie te liggen. Het Hollands Diep was een niet te slechten barrière en de Duitsers begonnen aan een wanhoopsoffensief."@nl .
  
