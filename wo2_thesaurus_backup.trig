    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/285317c8-025a-11e7-904b-d89d6717b464/media/b8bff8e9-b0ab-af19-1cba-09a0ca5d158d";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/282bb282-025a-11e7-904b-d89d6717b464/media/9a4f6b39-fafa-ff0d-5eaf-bf705839d770>,
      <https://beeldbankwo2.nl/nl/beelden/detail/94fd7602-025a-11e7-904b-d89d6717b464/media/8bc15a37-3545-7ab0-8118-ebf9831ebbc4>,
      <https://beeldbankwo2.nl/nl/beelden/detail/2852b5b2-025a-11e7-904b-d89d6717b464/media/70f39b31-39d0-c3e2-8848-e004c61402d3>,
      <https://beeldbankwo2.nl/nl/beelden/detail/284f79c4-025a-11e7-904b-d89d6717b464/media/5c03f886-d2fa-fd5f-5310-05cd3996d6cc>;
    dcterms:source "https://www.archieven.nl/nl/zoeken?miview=inv2&mivast=0&mizig=210&miadt=298&micode=088&milang=nl"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-06"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Het Arbeitsbereich der NSDAP in den Niederlanden was de Nederlandse afdeling van de Nationalsozialistische Deutsche Arbeiterpartei (NSDAP). De NSDAP organiseerde samen met de Nationaal-Socialistische Beweging (NSB) politieke bijeenkomsten in Nederland om nationaalsocialistisch gedachtegoed te verspreiden. Voor 15 oktober 1940 heette de organisatie Landesgruppe Niederlande van de Auslands-Organisation der NSDAP."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4618>, <https://data.niod.nl/WO2_Thesaurus/1906>;
    dcterms:created "2023-05-11T07:36:29.724Z"^^xsd:dateTime;
    skos:prefLabel "Arbeitsbereich der NSDAP in den Niederlanden"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Arbeitsbereich der NSDAP in den Niederlanden was de instantie van de nazipartij voor Nederland. Tot 15 oktober 1940 stond zij bekend als Landesgruppe Niederlande van de Auslands-Organisation der NSDAP. Het Arbeitsbereich behartigde de belangen van de NSDAP in Nederland en organiseerde samen met de NSB gemeenschappelijke manifestaties en politieke scholingsbijeenkomsten. Aan het hoofd stond Generalkommissar zur besonderen Verwendung Fritz Schmidt en later diens opvolger Willi Ritterbusch. "@nl;
    skos:altLabel "Arbeitsbereich der NSDAP Niederlanden"@nl, "Arbeitsbereich der NSDAP-Niederlanden"@nl,
      "Arbeitsbereich NSDAP Niederlanden"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/19554> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:references "N.J.G. Sikkel (red.), Documentatie. Samengesteld ten behoeve van de Bijzondere Rechtspleging, op last van de Procureur-Fiscaal bij het Bijzonder Gerechtshof te Amsterdam (Amsterdam 1947) "@nl,
      "Rondschrijven van Nationale Jeugdstorm hoofdstormer Van Geelkerken en Reichsjugendführung Befehlsstelle Niederlande over ‘vrijwilligers-aanmelding voor Germaansche Landdienst’, 15 juni 1942. NSB-archief, inv.nr. 1149."@nl,
      "R. Oomen, Jeugd van het ‘nieuwe Europa’ Transnationale connecties van de Nationale Jeugdstorm bij het Europees Jeugdverbond, in: Tijdschrift voor Geschiedenis jrg. 130, nr.4, p. 618-621"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2024-08-12T12:03:08.661Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/2f05a144-025a-11e7-904b-d89d6717b464/media/35cfe789-80f7-7c4f-eb28-790bffb8afe0>;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-08"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Germaansche Landdienst was een Duitse nationaalsocialistische jeugdorganisatie gericht op het koloniseren van door Duitsland bezette gebieden in Oost-Europa. De Germaansche Landdienst rekruteerde vanaf 1942 ongeveer 500 Nederlandse jongeren tussen de 14 en 16 jaar, voornamelijk leden van de nationaalsocialistische jeugdorganisatie Nationale Jeugdstorm. Zij kregen in Duitsland een agrarische opleiding."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4553>, <https://data.niod.nl/WO2_Thesaurus/2255>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/4534>, <https://data.niod.nl/WO2_Thesaurus/2244>;
    dcterms:created "2023-05-11T08:31:24.666Z"^^xsd:dateTime;
    skos:prefLabel "Germaansche Landdienst"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Germaansche Landdienst was de organisatie die onder leiding van de Hitlerjugend in het gebied Danzig-West Pruisen een opleiding voor het boerenbedrijf verzorgde. Het was bedoeling dat de deelnemers na voltooiing van de opleiding zich als kolonisten zouden vestigen in de bezette oostelijke gebieden (Oekraïne e.d.). De leider van de Nationale Jeugdstorm Kees van Geelkerken riep Nederlandse jongens en meisjes in de leeftijd van 14 t/m 16 jaar op zich aan te melden voor de Germaansche Landdienst. Honderden leden van deze NSB-organisatie gaven hieraan gehoor. "@nl;
    skos:altLabel "Germaanse Landdienst"@nl, "Germaanschen Landdienst"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/19555> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:references "N.J.G. Sikkel (red.), Documentatie. Samengesteld ten behoeve van de Bijzondere Rechtspleging, op last van de Procureur-Fiscaal bij het Bijzonder Gerechtshof te Amsterdam (Amsterdam 1947)"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2025-04-06T13:10:19.702Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1940-09-28"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/59ae234d-7831-8006-ae5e-c8b61c0312eb.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/e2bb3ba0-0259-11e7-904b-d89d6717b464/media/59ae234d-7831-8006-ae5e-c8b61c0312eb";
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Geerto_Snijder&oldid=63307904"@nl,
      "https://www.dbnl.org/tekst/bouw029kron01_01/bouw029kron01_01_2199.php"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1941-11-25"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Nederlandsche Kultuurkring (NKK) was een nationaalsocialistische organisatie gericht op culturele samenwerking tussen Nederland en Duitsland. De NKK was een elitair gezelschap van Duitsgezinde intellectuelen die de Nederlandse cultuur onder toezicht van de Duitse bezetter wilden plaatsen. De organisatie werd op 28 september 1940 opgericht door professor G.A.S. Snijder en ging in november 1941 op in de Nederlandsche Kultuurraad (NKR)."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1743>, <https://data.niod.nl/WO2_Thesaurus/20640>;
    dcterms:created "2023-05-11T10:00:07.792Z"^^xsd:dateTime;
    skos:prefLabel "Nederlandsche Kultuurkring"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Nederlandsche Kultuurkring werd op 28 september 1940 opgericht door professor G.A.S. Snijder als organisatie van intellectuelen die ‘in overeenstemming met de bezettende overheid’ werkzaam wilden zijn. De oprichting vond plaats in nauw overleg met Seyss-Inquart en zijn ondergeschikten. De Kultuurkring streefde ernaar om tegenover de bezetter de positie te verwerven van representatief lichaam van het Nederlandse culturele leven en dit zo onder zijn toezicht te plaatsen. De Kultuurkring ging eind november 1941 over in de Nederlandsche Kultuurraad."@nl;
    skos:altLabel "Nederlandsche Kultuur Kring"@nl, "Nederlandsche Cultuurkring"@nl, "Nederlandse Kultuurkring"@nl,
      "Nederlandse Cultuurkring"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/5101>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/19556> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:references "N.J.G. Sikkel (red.), Documentatie. Samengesteld ten behoeve van de Bijzondere Rechtspleging, op last van de Procureur-Fiscaal bij het Bijzonder Gerechtshof te Amsterdam (Amsterdam 1947)"@nl,
      "G. Broek, Weerkorpsen. Extreemrechtse strijdgroepen in Amsterdam, 1923-1942 (Amsterdam 2014) "@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2024-08-12T12:03:08.746Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/aec4204c-e65f-a4b6-ce57-184b528db823.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/315ad7e8-025a-11e7-904b-d89d6717b464/media/aec4204c-e65f-a4b6-ce57-184b528db823";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/31515fce-025a-11e7-904b-d89d6717b464/media/1ff5f32e-c154-fc9a-d577-3b6e83d02ecf>,
      <https://beeldbankwo2.nl/nl/beelden/detail/3153e582-025a-11e7-904b-d89d6717b464/media/9c0e0745-dfe2-51b5-e72b-28dcb966bc04>;
    dcterms:source "https://resources.huygens.knaw.nl/bwn1880-2000/lemmata/bwn6/rappard"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1941-12-14"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Storm Afdeeling van de NSNAP-Van Rappard was de knokploeg van de Nationaal-Socialistische Nederlandsche Arbeiderspartij van Ernst Herman van Rappard. De organisatie was geïnspireerd op de Sturmabteilung (SA) van de Nationalsozialistische Deutsche Arbeiterpartei (NSDAP). De knokploeg bewaakte partijbijeenkomsten, verspreidde propaganda, hielp bij collectes en viel Joden en politieke tegenstanders aan. Toen de NSNAP-Van Rappard in 1941 opging in de Nationaal-Socialistische Beweging (NSB) werd de Storm Afdeeling opgeheven."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/5818>, <https://data.niod.nl/WO2_Thesaurus/4888>;
    dcterms:created "2023-05-11T10:24:56.041Z"^^xsd:dateTime;
    skos:prefLabel "Storm Afdeeling van NSNAP-Van Rappard"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Storm Afdeeling (SA) van de NSNAP-Van Rappard was opgezet als kopie van de SA (Sturmabteilung) van Hitlers nazipartij. Het weerkorps had tot taak de orde te bewaren bij partijbijeenkomsten, maar werd ook ingezet voor het verspreiden van propagandamateriaal en bij de colportage. Hiernaast zocht de SA de confrontatie met Joden, leden van de Nederlandsche Unie en NSB’ers en waren verschillende leden betrokken bij brandstichtingen bij synagogen. Toen in december 1941 de NSNAP-Van Rappard op Duits bevel opging in de NSB, hield ook de SA op te bestaan."@nl;
    skos:altLabel "Dietsche Sport- en Kamverband"@nl, "Storm Afdeeling NSNAP-Van Rappard"@nl,
      "SA van NSNAP-Van Rappard"@nl, "SA NSNAP-Van Rappard"@nl, "SA Van Rappard"@nl, "S.A. van NSNAP-Van Rappard"@nl,
      "S.A. NSNAP-Van Rappard"@nl, "SA-NSNAP-Van Rappard"@nl, "Storm Afdeling van NSNAP-Van Rappard"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/19557> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "N.K.C.A. in ’t Veld, De SS en Nederland. Documenten uit SS-archieven 1935-1945. Deel 1 (Den Haag 1976)"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2024-08-12T12:03:08.783Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1940-12-30"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/bcc483cb-572c-1632-8217-21d0306b28b7.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/5ba49f7a-025a-11e7-904b-d89d6717b464/media/bcc483cb-572c-1632-8217-21d0306b28b7";
    dcterms:source "https://www.archieven.nl/nl/zoeken?mivast=0&mizig=210&miadt=298&miaet=1&micode=077&minr=1174774&miview=inv2&milang=nl"@nl,
      "https://en.wikipedia.org/w/index.php?title=Germanische_Leitstelle&oldid=1205566296"@en;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-08"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Germanische Leitstelle was de propaganda- en rekruteringsafdeling van de Waffen-SS, het legeronderdeel van de Schutzstaffel (SS). Vanaf maart 1942 ging de Germanische Leitstelle ook in Nederland actief vrijwilligers werven voor de Waffen-SS. De Germanische Leitstelle werd de overkoepelende organisatie van de Nederlandsche SS, de Nationale Jeugdstorm en het Studentenfront van de Nationaal-Socialistische Beweging (NSB) in Nederland."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4717>;
    dcterms:created "2023-05-11T11:09:17.830Z"^^xsd:dateTime;
    skos:prefLabel "Germanische Leitstelle"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Germanische Leitstelle, opgericht eind 1940, hield zich oorspronkelijk bezig met het coördineren van de ideologische vorming van vrijwilligers in de Waffen-SS. Door toedoen van Himmler kreeg zij er vanaf maart 1942 verschillende nieuwe taken bij: de werving in Germaanse landen voor de gewapende formaties van de SS en politie, het houden van toezicht op en het ondersteunen van de autochtone SS-formatie in deze landen en het ideologisch beïnvloeden van nationaalsocialistische jongerenorganisaties daar. In Nederland ging het om de Nationale Jeugdstorm en het Nationaal-Socialistische Studentenfront. Door de tegenwerking van rijkscommissaris Seyss-Inquart en ook Rauter, die als höhere SS- und Polizeiführer zijn greep op de SS in Nederland wilde houden, bleef de invloed van de Germanische Leitstelle hier beperkt."@nl;
    skos:altLabel "Germanische Freiwilligen Leitstelle"@nl, "Germanische Leitstelle Niederlande"@nl,
      "Germanische Freiwilligen-Leitstelle"@nl, "SS-Amt VI Germanische Leitstelle"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/19558> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:references "G. Groeneveld, Zwaard van de geest. Het bruine boek in Nederland 1921-1945 (Nijmegen 2002)"@nl,
      "L. de Jong, Het Koninkrijk der Nederlanden in de Tweede Wereldoorlog. Deel 5. Maart ’41-Juli ’42. Eerste helft (’s-Gravenhage 1974) "@nl,
      " Nationaal Archief, Inventaris van het archief van de Centrale Dienst voor Sibbekunde, 1941-1944."@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2024-08-12T12:03:08.640Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1940-08-27"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://resolver.kb.nl/resolve?urn=urn:gvn:EVDO02:NIOD05_4824&size=large";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://resolver.kb.nl/resolve?urn=urn:gvn:EVDO02:NIOD05_4824";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/cea24992-0259-11e7-904b-d89d6717b464/media/35112e0f-f0d8-0188-d3e1-771b49fd3601>;
    dcterms:source "https://www.nationaalarchief.nl/onderzoeken/archief/2.04.68"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1944-09-05"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Centrale Dienst voor Sibbekunde (CDS) deed afstammingsonderzoek naar leden van de Nationaal-Socialistische Beweging (NSB) en de Schutzstaffel (SS) om hun ‘raszuiverheid’ vast te stellen. Daarnaast legde de CDS een ‘Jodencartotheek’ aan om Joden te identificeren en registreren ter voorbereiding op de Jodenvervolging. De dienst werd in augustus 1941 opgericht en werd geleid door Ludo ten Cate. De CDS was een afdeling van het Departement van Opvoeding, Wetenschap en Kultuurbescherming en later van het Departement van Binnenlandse Zaken. Op 5 september 1944 werd de CDS opgeheven."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2016>, <https://data.niod.nl/WO2_Thesaurus/20640>;
    dcterms:created "2023-05-11T11:23:59.182Z"^^xsd:dateTime;
    skos:prefLabel "Centrale Dienst voor Sibbekunde"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Centrale Dienst (CDS) voor Sibbekunde werd in augustus 1941 opgericht als semi-overheidsinstelling en ressorteerde eerst onder het Departement van Opvoeding, Wetenschap en Kultuurbescherming en later onder het Departement van Binnenlandse Zaken. Het hoofd Ludo ten Cate was sinds 1940 leider van het Ras- en Sibbe-ambt van der Nederlandsche SS en kreeg in 1942 ook de leiding over de afdeling Sibbekunde van de NSB. De afstammingsonderzoeken die de CDS uitvoerde naar Joden en de aangelegde ‘Jodencartotheek’ moesten voorkomen dat een deel van hen ten onrechte tot ‘halfjood’ of ‘Arier’ kon worden verklaard en dus niet vervolgd zou worden. Op Dolle Dinsdag (5 september) werd de CDS opgeheven."@nl;
    skos:altLabel "C.D.S."@nl, "Centrale Dienst Sibbekunde"@nl, "C.D.v.S."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
