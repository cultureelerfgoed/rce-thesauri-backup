    dcterms:created "2018-11-01T16:05:55.000Z"^^xsd:dateTime;
    skos:prefLabel "Jongenskamp Djoernatan"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Jongenskamp Djoernatan functioneerde van 25 januari 1945 tot 11 april 1945, voor jongens en jonge mannen met een anti-Japanse houding. 25 van de 197 geïnterneerde hebben het kamp niet overleefd. "@nl .
  
