    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/brd/thumb/1000x1000/245813b4-a331-d4be-5b8b-8940507b691b.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://stadsarchief.breda.nl/collectie/beeld/films-en-foto-s/detail/c0461038-bb74-ca49-dc4d-0f61703e0c21"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <http://nimh-beeldbank.defensie.nl/memorix/2ebd1182-eb18-11df-a391-13966e870614>;
