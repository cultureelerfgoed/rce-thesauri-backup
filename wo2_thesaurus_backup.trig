  <https://data.niod.nl/WO2_Thesaurus/18772> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:32:52.829Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/18774>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/3/3f/H%C3%B6rstel%2C_ehem._Flugplatz_--_2014_--_9611.jpg/500px-H%C3%B6rstel%2C_ehem._Flugplatz_--_2014_--_9611.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://de.wikipedia.org/wiki/Fliegerhorst_Hopsten#/media/Datei:H%C3%B6rstel,_ehem._Flugplatz_--_2014_--_9611.jpg";
    dcterms:source "https://de.wikipedia.org/wiki/Fliegerhorst_Hopsten"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/18773>, <https://data.niod.nl/WO2_Thesaurus/18775>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2110>;
    dcterms:created "2022-03-07T13:15:55.002Z"^^xsd:dateTime;
    skos:prefLabel "Fliegerhorst Hopsten"@nl, "Fliegerhorst Hopsten"@de, "Fliegerhorst Hopsten"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Fliegerhorst Hopsten was een luchtmachtbasis van de Duitse luchtmacht tussen Hopsten en Dreierwalde in Noord-Duitsland. De vliegbasis met drie banen werd in 1938 gebouwd en op 25 oktober 1939 in gebruik genomen. In de periode 1940-1944 vonden er voortdurend uitbreidingen plaats. Eind 1944 toen de Duitse troepen zich terugtrokken was het een gunstige locatie voor de verdediging van het Duitse rijk. Door de vele bombardementen door de geallieerden waren er veel herstelwerkzaamheden nodig om de basis in bedrijf te houden. Hiervoor werden dwangarbeiders ingezet waaronder ook gevangenen uit Kamp Amersfoort. Op 6 april 1945 werd de vliegbasis opgeblazen en overgedragen aan de geallieerde troepen. In 1959 werd op dezelfde plaats een nieuwe basis gebouwd."@nl .
  
