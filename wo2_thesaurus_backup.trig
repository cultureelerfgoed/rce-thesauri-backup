    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/isPointofInterest> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/locations/10232>;
    dcterms:created "2019-03-13T13:40:27.000Z"^^xsd:dateTime;
    skos:prefLabel "Veerpont Druten"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "De Veerpont te Druten was op 20 september 1944 onderdeel van een Britse beschieting op Duitse militaire. De Britse militairen waren op verkenning langs de Waal bij Druten, toen er een Duitse patrouille de rivier over kwam en de Britten zich verscholen achter de dijk en het Veerhuis. Toen de Duitse soldaten nietsvermoedend halverwege de Veerdam waren, schoot een Britse soldaat zijn geweer leeg op de soldaten, waardoor er drie Duitse militaire om het leven kwamen er één zwaargewond krijgsgevangen werd genomen en er één terug het water over wist te vluchten."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/3585>, <https://data.niod.nl/WO2_Thesaurus/events/4391>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/4460>;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
