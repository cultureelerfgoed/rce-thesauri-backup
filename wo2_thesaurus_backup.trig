    skos:broader <https://data.niod.nl/WO2_Thesaurus/8181>;
    dcterms:created "2019-01-28T13:33:50.000Z"^^xsd:dateTime;
    skos:prefLabel "Gaimusho"@nl, "Aussenministerium von Japan"@de, "Ministry of Foreign Affairs of Japan"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Gaimusho is het Japanse Ministerie van Buitenlandse Zaken. Tijdens de Tweede Wereldoorlog leverde dit ministerie ook mensen voor de hogere posities van de Kempeitai."@nl;
    skos:altLabel "Ministerie van Buitenlandse Zaken van Japan"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2350>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
