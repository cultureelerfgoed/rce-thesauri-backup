    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://en.wikipedia.org/wiki/Shefayim#/media/File:Shefayim_1944.jpg";
    <http://schema.org/location> "Shefayim";
    <http://schema.org/startDate> "1939-08-12"^^xsd:date;
    <http://schema.org/endDate> "1939-08-13"^^xsd:date;
    dcterms:source "https://www.joodsamsterdam.nl/ss-dora/"@nl, "https://en.wikipedia.org/wiki/Shefayim"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/18602>;
    dcterms:created "2022-01-12T13:37:42.248Z"^^xsd:dateTime;
    skos:prefLabel "Aankomst SS Dora in Palestina"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "In de nacht van 12 augustus 1939 werden de vluchtelingen aan boord van de Dora naar het strand van Shefayim gebracht. Dit was dichtbij de kibboets ten noorden van Tel Aviv. Het was een toegankelijke plek en ver verwijderd van de Britse militaire installaties. De nieuwe immigranten werden eerst in Kfar Shemariahu geconcentreerd en daarna naar verschillende opvangcentra gebracht."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/18614> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:00:39.506Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/18615>;
