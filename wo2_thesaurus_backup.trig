    skos:prefLabel "Oprichting Joodsche Raad van Haarlem"@nl, "Gründung Judenrat Haarlem"@de,
      "Founding of Judenrat Haarlem"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Op 2 mei 1941 werd de Joodsche Raad van Haarlem opgericht. Het was één van de provinciale Raden die vanuit de Joodsche Raad voor Amsterdam werden ingesteld. De Joodsche Raad voor Amsterdam werd in 1941 omgezet in de Joodsche Raad voor Nederland."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/18555> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:04:15.836Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/9881>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/21d22428-72f9-d20c-c809-1c42f323d484.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/b74728e8-025a-11e7-904b-d89d6717b464/media/21d22428-72f9-d20c-c809-1c42f323d484";
    <http://schema.org/startDate> "1943-02-02"^^xsd:date;
    dcterms:source "https://www.archieven.nl/nl/zoeken?mivast=0&mizig=210&miadt=236&miaet=1&micode=3417&minr=1062671&miview=inv2"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/18522>;
