    dcterms:source "https://www.tweedewereldoorlog.nl/kennis/themas/wereldwijde-schaal-conflict/nederlanders-wereldwijd/azie-australie/"@nl,
      "https://www.australie.nl/australie/reisgids/geschiedenis-van-australie/tweede-wereldoorlog-in-australie/"@nl;
