    <http://schema.org/startDate> "1943-09-28"^^xsd:date;
    <http://schema.org/endDate> "1943-09-29"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Razzia_van_29_september_1943&oldid=56021717"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2005>;
    dcterms:created "2018-11-14T08:02:41.000Z"^^xsd:dateTime;
    skos:prefLabel "Laatste grote razzia in Amsterdam, 28-29 september 1943"@nl, "Amsterdam 'Judenrein' erklärt"@de,
      "Amsterdam is declared 'Judenrein' "@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "In de nacht van 28 op 29 september 1943 vond de laatste grote razzia in Amsterdam plaats. Hierbij werden 5.000 personen, inclusief het bestuur en de medewerkers van de Joodsche Raad, opgepakt en via het Amstelstation naar kamp Westerbork getransporteerd. Onder de gedeporteerden bevonden zich Abraham Asscher, David Cohen en artiestenduo 'Johnny & Jones'. Het was het slotstuk van een serie van Duitse maatregelen om Nederland \"judenrein\" te maken."@nl;
    skos:altLabel "Laatste grote razzia in Amsterdam"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
