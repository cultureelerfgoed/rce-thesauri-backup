  <https://data.niod.nl/WO2_Thesaurus/20777> a <http://schema.org/Thing>, skos:Concept,
      <https://data.niod.nl/thesaurus_wo2/ImagesWW2/Legislation>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    dcterms:modified "2026-05-04T12:49:34.981Z"^^xsd:dateTime;
    dcterms:source "https://www.nationaalarchief.nl/onderzoeken/archief/2.09.08"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De directeur-generaal stond aan het hoofd van het Directoraat-Generaal voor de Bijzondere Rechtspleging (DGBR). Het DGBR coördineerde de bijzondere rechtspleging en was verantwoordelijk voor het opsporen, arresteren en eventueel vervolgen van verdachten. De directeur-generaal van het DGBR was B.I.A.A. ter Veer (1898-1987)."@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/19586>;
