    skos:prefLabel "Leuwigadjah"@de, "Leuwigadjah"@en, "Leuwigadjah"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Leuwigadjah was een burgerkamp op West-Java ten noordwesten van Bandoeng. Het kamp bevond zich op de boerderij Vredesteijn bij Leuwigdjah een kilometer ten zuiden van Tjimahi. Van juni 1942 tot 23 augustus 1945 werden hier krijgsgevangenen, burgermannen en jongens tewerkgesteld. Een kilometer ten westen van de boerderij ligt Ereveld Leuwigadjah waar gevangenen uit de omgeving werden begraven. "@nl;
    skos:altLabel "Boerderij Vredesteijn Leuwigadjah"@nl, "Leuwigajah"@nl, "Boerderij Vredesteijn"@nl,
      "Boerderij Vredesteijn bij Leuwigadjah"@nl, "Boerderij Vredesteijn te Leuwigadjah"@nl,
      "Boerderij Vredesteijn Tjimahi"@nl .
  
