"""@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-01-16T15:51:11.950Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/cf3d80b0-0259-11e7-904b-d89d6717b464/media/58e7f083-115f-d50e-53ec-5acdd33670ce>,
