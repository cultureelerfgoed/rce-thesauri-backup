    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/mediabank-horizontal/fac6836f-520a-61e2-825e-155697481c1c.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://images.memorix.nl/niod/thumb/mediabank-horizontal/fac6836f-520a-61e2-825e-155697481c1c.jpg";
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/events/8269>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2560>, <https://data.niod.nl/WO2_Thesaurus/20702>;
    dcterms:created "2019-01-24T09:47:08.000Z"^^xsd:dateTime;
    skos:prefLabel "Tiga A"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Tiga A bestond van 29 maart 1942 tot eind 1942 en werd opgericht door de Japanse bezetter in Indonesië. Het doel om de inheemse bevolking te winnen voor de Japanse zaak blijkt wel uit de propagandaslogan van de beweging: \"Japan de leider van Azië, Japan het licht van Azië, Japan de bevrijder van Azië. Door onvrede onder de bevolking over het uitblijven van onafhankelijkheid en de angst van de bezetter dat de Tiga A gebruikt zou worden als organisatie voor meer onafhankelijkheid werd de beweging eind 1942 opgeheven en vervangen door de PUTERA."@nl;
    skos:altLabel "AAA-Beweging"@nl, "Triple A-Movement"@en;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/4382>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7763> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "Peter Post - The Encyclopedia of Indonesia in the Pacific War"@en;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-04-09T11:28:03.742Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8028>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/en/a/a6/IslamicAssociationPartyofIndonesia.png";
    dcterms:source "https://en.wikipedia.org/w/index.php?title=Indonesian_Islamic_Union_Party&oldid=878132677"@en;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2506>;
    dcterms:created "2019-01-24T10:11:42.000Z"^^xsd:dateTime;
    skos:prefLabel "Partai Sarekat Islam Indonesia"@nl, "Islamic Association Party of Indonesia"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Partai Sarekat Islam Indonesia (PSII) werd opgericht in 1923 door Tjokroaminoto en was de opvolger van de Sarekat Islam in Nederlands-Indië. Tijdens de Japanse bezetting werd de partij verboden, maar leden van de partij namen wel zitting in door de bezetter opgerichte bewegingen. De partij werd in 1973 opgeheven, maar in 1999 weer opgericht."@nl;
    skos:altLabel "Sarekat Islam"@nl, "PSII"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7764> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
