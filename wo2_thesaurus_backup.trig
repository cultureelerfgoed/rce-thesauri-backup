    dcterms:references "Jack Kooistra, Albert Oosthoek. Recht op wraak : liquidaties in Nederland 1940-1945. Leeuwarden : PENN uitgeverij, 2009"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
