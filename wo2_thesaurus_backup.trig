    dcterms:created "2018-11-12T11:36:20.000Z"^^xsd:dateTime;
    skos:prefLabel "Verklaring tot Spergebied van het kustgebied"@nl, "Erklärung zum Sperrgebiet des Küstengebiets"@de,
      "Declaration of the coastal area to exclusion zones"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Verklaring tot spergebied van het Nederlandse kustgebied was op 1 mei 1942. Vanaf toen werd overal in Nederland het strand en duingebied tot 1 kilometer landinwaarts verboden terrein voor burgers. Het spergebied was bedoeld om vluchtpogingen naar Engeland te voorkomen en om het strand vrij van hindernissen te houden."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/7298> .
  
