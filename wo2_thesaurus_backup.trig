    <http://schema.org/location> "Tjilatjap";
    <http://schema.org/startDate> "1942-02-27"^^xsd:date;
    dcterms:source "https://javapost.nl/2014/04/04/tjilatjap-het-duinkerken-van-java/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1870>;
    dcterms:created "2021-10-05T12:14:44.489Z"^^xsd:dateTime;
    skos:prefLabel "Evacuatie Tjilatjap"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Evacuatie van Tjilatjap begon op 27 februari 1942. Als laatste geallieerde haven in Nederlands-Indië was Tjilatjap (Zuid-Java) het laatste uitwijkpunt voor evacués. De haven was chaotisch en vol vluchtelingen, Nederlandse en geallieerde militairen, bemanningsleden en schepen. Op 1 maart beval commandant C.E.L. Helfrich officiëel de evacuatie van Tjilatjap. De evacuatie was al vanaf 27 februari op gang gekomen toen Helfrich schepen die Colombo (Sri Lanka) of Australië konden bereiken alvast de opdracht gaf om 200 mijl uit de kust te gaan liggen om een situatie als Pearl Harbor te voorkomen, waarbij veel schepen verloren gingen. Hiervan moesten echter 7 schepen toch terug om te helpen bij de evacuatie."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/16381>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
