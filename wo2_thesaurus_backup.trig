    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/10248>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://service.archief.nl/gaf/api/file/v1/img/c3e3310a-facd-4c3d-bdf5-d88a65213c1a?h=1000";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://www.nationaalarchief.nl/onderzoeken/fotocollectie/ad9ae4a2-d0b4-102d-bcf8-003048976d84";
    <http://schema.org/location> "Londen";
    <http://schema.org/startDate> "1940-05-12"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/18413>;
    dcterms:created "2021-09-22T10:08:34.003Z"^^xsd:dateTime;
    skos:prefLabel "Oprichting Netherland(s) Shipping and Trading Committee"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Netherland(s) Shipping and Trading Committee (NSTC) werd opgericht op 12 mei 1940. Het werd ook wel de Scheepvaartcommissie en later de Nederlandse Scheepvaart en Handelscommissie genoemd en was een Nederlandse commissie die na de Duitse inval in Nederland werd opgericht in Londen. Er waren ook afdelingen in New York en Parijs. Deze laatste werd opgeheven na de Duitse bezetting van Frankrijk. De Nederlandse gezant in Groot-Brittannië, E.M.F.J. Michiels van Verduynen, bevestigde 12 mei 1940 schriftelijk de benoeming van de vier leden van de nieuwe commissie: als voorzitter D. Hudig en tot secretarissen S.M.D. Valstar, C.C. Gischler en P. Dijkstra. "@nl;
    skos:altLabel "Oprichting NSTC"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/17641> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Dissel, Anita van, Martin Elands, Hylke Faber en Pieter Stolk, eds. De Nederlandse koopvaardij in oorlogstijd. Amsterdam: Boom, 2014. Bezemer, K.W.L.  Geschiedenis van de Nederlandse koopvaardij in de Tweede Wereldoorlog / Dl. 1 en dl. 2. Tweede druk. Amsterdam: Elsevier, 1987. "@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:20:21.273Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> <https://collectie.atlasvanstolk.nl/img/AVS/700px/03/AVS030321.jpg>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://collectie.atlasvanstolk.nl/data_nl.asp?startc=1&q0=39984&subj=1&bron=g";
    <http://schema.org/startDate> "1940-05-22"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1870>, <https://data.niod.nl/WO2_Thesaurus/18413>;
    dcterms:created "2021-09-22T10:20:12.058Z"^^xsd:dateTime;
    skos:prefLabel "Benoeming NSTC tot custodian"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Netherland(s) Shipping and Trading Committee (NSTC), ook wel de 'Shipping' genoemd was aanvankelijk opgericht als adviescommissie met vooraanstaande personen uit de Nederlandse rederswereld in Londen na de Duitse inval in Nederland. Op 22 mei 1940 kreeg de NSTC van minister Max Steenberghe de taak om als custodian (beheerder) te functioneren van de gehele Nederlandse koopvaardijvloot (de schepen, scheepsladingen en uiteindelijk ook de bemanningsleden). De NCTS kon in deze positie ook beter fungeren als rechtspersoon in Groot-Brittannië inzake verzekeringskwesties.  De custiodianvolmacht van de commissie gold niet voor schepen van rederijen die hun vestigingszetels naar overzeese gebieden hadden verplaatst."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/17642> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
