    skos:prefLabel "Dachau bevrijd"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Op 29 april 1945 werd Dachau bevrijd door de Amerikaanse troepen. Zij troffen iets buiten het kamp een goederentrein aan tot op het bot uitgemergelde lichamen van dode gevangenen afkomstig uit Bergen-Belsen. "@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
