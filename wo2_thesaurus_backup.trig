    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/19285>;
    <https://data.niod.nl/eventsWO2/fromLocation> <https://data.niod.nl/WO2_Thesaurus/locations/19798>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/79720d00-363f-8f16-6130-ae3101c4f6b2.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/c3203c54-025a-11e7-904b-d89d6717b464/media/79720d00-363f-8f16-6130-ae3101c4f6b2";
    <http://schema.org/startDate> "1940-09-24"^^xsd:date;
    dcterms:source "https://www.verliesregister.studiegroepluchtoorlog.nl/ahome/lossregister/results?sglo=T0851"@nl,
      "https://www.planviewer.nl/imro/files/NL.IMRO.1916.Schakenbosch-ON01/b_NL.IMRO.1916.Schakenbosch-ON01_tb13.pdf"@nl,
      "https://fcafa.com/2012/01/19/wellington-aircraft-of-311-sqn/"@en, "https://aircrewremembered.com/trojacek-karel-josef.html"@en;
    <https://data.niod.nl/eventsWO2/toLocation> <https://data.niod.nl/WO2_Thesaurus/locations/11277>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2329>;
    dcterms:created "2023-01-17T11:36:19.483Z"^^xsd:dateTime;
    skos:prefLabel "Vliegtuigcrash bij Leidschendam"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Vliegtuigcrash bij Leidschendam vond plaats op 24 september 1940 rond half 5 ‘s ochtends. Tijdens een bombardementsmissie bij Berlijn werd de Britse Wellington bommenwerper van het 311 Squadron (Tsjech) van de Royal Air Force (RAF) geraakt door luchtafweergeschut en stortte het neer in het weiland naast de Tuinenlaan en spoorbaan bij Leidschendam. Van de 6 bemanningsleden pleegde Karel Kuňka zelfmoord uit angst voor represailles voor zijn familie in bezet Tsjecho-Slowakije. Bemanningsleden Karel Josef Trojacek, Arnošt Zabrs, Zdeněk Prochazka, Václav Kilián en František Knotek werden na enkele dagen op de vlucht te zijn geweest, opgepakt en gevangen gezet in Stalag Luft III en Stalag IV-b. De Wellington bommenwerper werd door de Duitser gerepareerd om testvluchten mee uit te voeren."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
