    <http://schema.org/location> "Zaandam";
    <http://schema.org/startDate> "1940-10-20"^^xsd:date;
    dcterms:source "http://winterhulp.info/index.php/eenpansmaaltijd"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2875>;
    dcterms:created "2021-06-01T10:06:06.534Z"^^xsd:dateTime;
    skos:prefLabel "Eenpansmaaltijd"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Eenpansmaaltijd was de naam van openbare bijeenkomsten ter 'bevordering van de gemeenschapszin door het samenbrengen van allen (Duitsers en Nederlanders) om één tafel, ongeacht de rangen en standen'. Het tweede doel was 'geld inzamelen voor de Winterhulp' door middel van een collecte en verkoop van loten. De eerste bijeenkomst was op 20 oktober 1940 in Zaandam. Deze bijeenkomsten waren altijd op een zondagmiddag waarbij ook vrouwen en kinderen aanwezig waren."@nl;
    skos:altLabel "Een-pans-maaltijd"@nl, "Eintopfessen"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/12705> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:24:52.263Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/12706>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/5acea9d1-c235-5924-6a7a-b8c5ff4bda22.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/1601f1c0-025a-11e7-904b-d89d6717b464/media/5acea9d1-c235-5924-6a7a-b8c5ff4bda22";
    <http://schema.org/startDate> "1940-05-10"^^xsd:date;
    <http://schema.org/endDate> "1940-05-11"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/wiki/Slag_bij_Mill"@nl, "https://www.bhic.nl/ontdekken/verhalen/duitse-pantsertrein-ontspoort"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2322>;
    dcterms:created "2021-06-01T11:37:11.360Z"^^xsd:dateTime;
    skos:prefLabel "Slag bij Mill"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De slag bij Mill vond plaats op 10 en 11 mei 1940. Duitse invasietroepen konden ongehinderd de Peel-Raamstelling passeren en nabij het dorp Zeeland een troepenmacht afzetten. De Nederlandse verdediging vanuit de kazernes bij Mill had het spoor geblokkeerd met aspergeversperring waardoor de Duitse pantsertrein ontspoorde. Na twee dagen vechten en een zwaar bombardement op de streek werd de slag door de Duitsers gewonnen."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/12707> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
