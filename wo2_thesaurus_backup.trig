    skos:prefLabel "Stalag 352 Masjukowtschina"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Stalag 352 was een Duits krijgsgevangenkamp in Masjukowtschina bij Minsk, Wit-Rusland en bestond uit twee secties. Een in Masjukowtschina en één in Minsk. Het kamp was van juni 1941 tot juli 1944 in gebruik. Er zijn zo'n 80.000 Russische gevangenen omgekomen. "@nl;
    skos:altLabel "Minsk"@nl, "Waldlager Masjukowtschina"@nl .
  
