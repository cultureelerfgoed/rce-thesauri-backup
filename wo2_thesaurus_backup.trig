    skos:prefLabel "Station Amsterdam Muiderpoort"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:exactMatch <http://www.wikidata.org/entity/Q50724>;
    skos:scopeNote "Station Amsterdam Muiderpoort fungeerde tijdens de Duitse bezetting van Nederland als één van de deportatieplaatsen waarvandaan joden naar Kamp Westerbork werden gedeporteerd. Het eerste transport vanaf hier vertrok op 3 oktober 1942, het laatste op 26 mei 1944. In totaal zijn er ruim 11.000 vervolgden vanaf hier naar Kamp Westerbork afgevoerd."@nl;
    skos:altLabel "Muiderpoortstation"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/9085> .
  
