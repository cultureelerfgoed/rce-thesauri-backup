    dcterms:source "https://onzemarinevloot.weebly.com/hrms-endeh.html"@nl, "https://nl.wikipedia.org/w/index.php?title=Hr.Ms._Endeh_(schip,_1941)&oldid=66399333"@nl,
      "https://www.tracesofwar.nl/articles/2882/Ontsnappingspoging-met-Hr-Ms-Endeh.htm"@nl,
      "https://mass.cultureelerfgoed.nl/endeh-hrms"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3511>;
    dcterms:created "2024-03-21T12:53:22.728Z"^^xsd:dateTime;
    skos:prefLabel "Scheepsramp Endeh"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Scheepsramp met de Endeh vond plaats op 2 maart 1942. De Hr. Ms. Endeh was een hulpmijnenveger van de Nederlandse marine en probeerde na de Slag op de Javazee vanuit de haven Tandjong Priok uit te wijken naar geallieerd gebied. Nabij het eiland Pulau Kelepa werd het schip door een Japanse torpedobootjager tot zinken gebracht. Bij de scheepsramp kwamen 7 personen om en in de daaropvolgende dagen overleden nog eens 4 door ontberingen of piraterij. De overige 13 overlevenden werden op 24 maart 1942 krijgsgevangenen gemaakt."@nl;
    skos:altLabel "Ontsnappingspoging Endeh"@nl, "Ontsnappingspoging met Hr. Ms. Endeh"@nl,
      "Scheepsramp Hr. Ms. Endeh"@nl .
  
