    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Wereldtentoonstelling&oldid=48541582"@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
