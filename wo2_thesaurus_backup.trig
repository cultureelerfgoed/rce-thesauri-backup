    <http://schema.org/startDate> "1942-08-04"^^xsd:date;
    dcterms:source "https://www.amsterdam.nl/stadsarchief/stukken/dieren/duivenbrigade/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/5109>;
    dcterms:created "2022-08-25T13:59:53.815Z"^^xsd:dateTime;
    skos:prefLabel "Maatregel ten aanzien van postduiven"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Op 4 augustus 1942 werd bekend gemaakt dat alle postduiven moesten worden afgemaakt. De Duitsers waren bang dat de vogels bij een Engelse landing voor spionage gebruikt zouden worden. De pootjes dienden als bewijs ingeleverd te worden."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
