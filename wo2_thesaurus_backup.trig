    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/68bdd08c-025a-11e7-904b-d89d6717b464/media/0a4639d3-e160-49b6-9050-d8c069352e29"@nl;
    <http://schema.org/startDate> "1945-02-27"^^xsd:date;
    dcterms:source "http://monument-rozenoord.nl/27-februari-1945/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/havingap>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/9271>;
    dcterms:created "2020-08-22T12:17:22.000Z"^^xsd:dateTime;
    skos:prefLabel "Fusillade Rozenoord - 27 februari 1945"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Als represaille voor de mislukte aanslag op Zollsekretär Willy Fischer te Midwoud, werd op 27 februari 1945 een vijftal 'terroristen en saboteurs' doodgeschoten bij executieplek Rozenoord. De vijf Todeskandidaten, afkomstig uit het Huis van Bewaring aan de Weteringschans te Amsterdam, waren:  Zeger Besterveld, Leonardus Bosch, Dirk van der Heijden, Jakobus Friedrich van der Heijden en Jacobus Antonius Roman."@nl .
  
