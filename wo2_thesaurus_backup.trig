    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/events/6221>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2055>, <https://data.niod.nl/WO2_Thesaurus/2590>,
      <https://data.niod.nl/WO2_Thesaurus/2005>;
