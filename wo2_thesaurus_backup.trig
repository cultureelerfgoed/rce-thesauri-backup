    skos:prefLabel "Evacuatie van Amersfoort"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Evacuatie van Amersfoort werd vanaf 12 mei 1940 in gang gezet. Bijna 44.000 inwoners verlaten hun huizen, omdat de stad gevechtsterrein tussen Duitsland en de geallieerden leek te worden. Vele Amersfoorters vluchten naar Noord-Holland."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
