    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/f697ed20-025a-11e7-904b-d89d6717b464/media/48661f38-742f-7601-0a88-feb4e90d24db"@nl;
    dcterms:source "https://onsamsterdam.nl/artikelen/het-decoreren-van-het-leven"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/ravend>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2163>, <https://data.niod.nl/WO2_Thesaurus/2210>;
    dcterms:created "2026-02-18T11:16:48.967Z"^^xsd:dateTime;
    skos:prefLabel "Kunsthandel Katz"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Firma D. Katz kunsthandel in Dieren werd in 1930 opgericht door de Joodse broers Benjamin en Nathan Katz. Tijdens de bezetting verkocht de firma grote hoeveelheden kunst aan onder anderen Alois Miedl, Walter Andreas Hofer en Hans Posse. In februari 1941 werd de kunsthandel geliquideerd en geariseerd. Nathan en Benjamin bleven adviseren op de achtergrond tot ze naar Zwitserland mochten uitwijken. De kunsthandel werd na de bevrijding onderzocht op verdenking van economische samenwerking, maar de zaak werd geseponeerd. De Firma Katz opende daarna opnieuw zijn deuren tot 1964."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/21918> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-02-23T12:23:12.636Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/21959>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://webservices.memorix.nl/mediabank/media/d0333537-9379-f6a7-3eeb-5d00218c30ae/downloadoriginal/0936f8a4-2b16-b64d-c113-2b8da6c9a1be?apiKey=eb37e65a-eb47-11e9-b95c-60f81db16c0e"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://archief.amsterdam/beeldbank/detail/d0333537-9379-f6a7-3eeb-5d00218c30ae"@nl;
    dcterms:source "https://www.amsterdam.nl/stadsarchief/nieuws/houthakker/"@nl, "https://research.rkd.nl/nl/detail/https%3A%2F%2Fdata.rkd.nl%2Fartists%2F40044"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/ravend>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2163>, <https://data.niod.nl/WO2_Thesaurus/2210>;
    dcterms:created "2026-02-18T11:16:48.981Z"^^xsd:dateTime;
    skos:prefLabel "Kunsthandel Houthakker"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Kunsthandel Houthakker was een Amsterdamse kunsthandel die in 1921 werd opgericht door de Joodse Bernard Houthakker (Amsterdam, 24 september 1884 - Amsterdam, 3 februari 1963). Om de kunsthandel te behoeden van confiscatie werd het in 1940 geliquideerd. Vervolgens richtte hij de kunsthandel ‘Rembrandt van Rijn’ op met een niet-joodse directeur. De constructie mislukte en in 1941 werd alsnog de Verwalter Carl Hansel aangesteld. Hij heeft de kunsthandel daarna leeggeroofd. Bernard en zijn familie wisten de oorlog allemaal te overleven, waarna de kunsthandel in augustus 1945 weer in zijn bezit kwam."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/21919> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-02-23T12:21:55.232Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/21960>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/d/d4/Stadsarchief_Amsterdam%2C_Afb_OSIM00008003540.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/wiki/File:Stadsarchief_Amsterdam,_Afb_OSIM00008003540.jpg#/media/Bestand:Stadsarchief_Amsterdam,_Afb_OSIM00008003540.jpg"@nl;
    dcterms:source "https://nl.wikipedia.org/wiki/Frederik_Muller_%26_Co"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/ravend>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2163>, <https://data.niod.nl/WO2_Thesaurus/2210>;
    dcterms:created "2026-02-18T11:16:48.990Z"^^xsd:dateTime;
    skos:prefLabel "Frederik Muller & Co."@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het veilinghuis Frederik Muller & Co. werd opgericht door Frederik Muller in 1843 en ontwikkelde zich vanaf 1919 tot de eerste internationaal opererende kunstveiling in Nederland. Tijdens de Duitse bezetting stond het veilinghuis onder leiding van Bernhard Mensing, die in 1929 zijn vader Anton Mensing opvolgde. Frederik Muller & Co was één van de belangrijkste veilinghuizen in Nederland en organiseerde tijdens de bezetting vele succesvolle veilingen. Onder de geveilde objecten bevonden zich ook goederen afkomstig uit Joods bezit, waaronder kunstwerken uit de collectie van Jacques Goudstikker. Slechts een beperkt deel van het bedrijfsarchief is bewaard gebleven. In 1961 werd het veilinghuis geliquideerd."@nl;
    skos:altLabel "Frederik Muller & Cie"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/2192> a <http://schema.org/Thing>, skos:Concept;
