    skos:prefLabel "Evacuatie van Kamp Neuengamme"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "De Evacuatie van Kamp Neuengamme begon op 9 april 1945 met het transport van Deense en Noorse gevangenen met de Witte Bussen van het Deense en Zweedse Rode Kruis naar Zweden. Tegelijkertijd werden de overgebleven gevangenen door de SS naar andere kampen gebracht of naar de schepen Thielbek, Athen en Cap Arcona bij de Lübecker Bocht gebracht. Op 2 mei 1945 verliet de SS, samen met de laatste gevangenen, het schoongemaakte en opgeruimde kamp.  "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/4468>, <https://data.niod.nl/WO2_Thesaurus/events/7669>,
      <https://data.niod.nl/WO2_Thesaurus/events/7670>, <https://data.niod.nl/WO2_Thesaurus/9309>,
      <https://data.niod.nl/WO2_Thesaurus/19529>;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
