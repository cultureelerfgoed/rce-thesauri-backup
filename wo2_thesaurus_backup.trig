    dcterms:modified "2026-02-23T12:38:24.078Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/2f1ca281-4328-e518-6f49-7204615718ef.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/e35a7d28-0259-11e7-904b-d89d6717b464/media/2f1ca281-4328-e518-6f49-7204615718ef"@nl;
    dcterms:source "https://nl.wikipedia.org/wiki/Carinhall"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/ravend>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1816>, <https://data.niod.nl/WO2_Thesaurus/locations/8020>;
    dcterms:created "2026-02-18T11:26:36.280Z"^^xsd:dateTime;
    skos:prefLabel "Carinhall"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:exactMatch <http://www.wikidata.org/entity/Q222728>;
    skos:scopeNote "Carinhall was het jachtslot van Hermann Göring. De omvangrijke en grotendeels geroofde kunstverzameling van Göring bevond zich in Carinhall totdat de verzameling in 1943 deels werd verplaatst naar een opslagplaats bij Altaussee. Daar werden de werken in 1945 door de geallieerden ontdekt en naar het Central Collecting Point in München gebracht om zoveel mogelijk terug te keren naar de landen van herkomst."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/21937> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-02-23T12:50:44.336Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/21969>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/1/11/Den_Haag_-_Sophialaan_11.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/wiki/File:Den_Haag_-_Sophialaan_11.jpg"@nl;
    dcterms:source """https://www.dfs.ny.gov/consumers/holocaust_claims/perpetrators_methods/bio/katejan_muhlmann
https://en.wikipedia.org/wiki/Kajetan_M%C3%BChlmann"""@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/ravend>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1816>, <https://data.niod.nl/WO2_Thesaurus/20712>;
    dcterms:created "2026-02-18T11:26:36.291Z"^^xsd:dateTime;
    skos:prefLabel "Dienststelle Mühlmann"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Dienststelle Mühlmann was een door de nazi’s opgerichte kunstrooforganisatie die tijdens de Tweede Wereldoorlog actief was in Nederland. Onder leiding van Kajetan Mühlmann inventariseerde, confisqueerde en verhandelde zij kunstwerken, vaak afkomstig uit Joods bezit.  Daarnaast faciliteerde zij gedwongen verkopen via kunsthandelaren. Ook wezen ze objecten toe aan Duitse musea en nazileiders. Het kantoor van de roofinstelling was op de Sophialaan 11 in Den Haag."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/21938> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-02-23T12:53:31.805Z"^^xsd:dateTime;
    dcterms:source "https://www.restitutiecommissie.nl/advies/kunsthandel-katz-b/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/ravend>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1816>, <https://data.niod.nl/WO2_Thesaurus/corporaties/5824>;
    dcterms:created "2026-02-18T11:26:36.302Z"^^xsd:dateTime;
    skos:prefLabel "Referat Sonderfragen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het Referat Sonderfragen was een afdeling binnen het Generalkommissariat zur besonderen Verwendung tijdens de Duitse bezetting. De afdeling werd in de praktijk geleid door Felix Wickel en stond onder de politieke verantwoordelijkheid van Fritz Schmidt. Het Referat hield zich bezig met culturele beïnvloeding, informatieverzameling en kunstverwerving, onder meer ten behoeve van het Sonderauftrag Linz. Ook stelde het Referat rapporten op over de politieke situatie en de stemming onder de Nederlandse bevolking. In de kunsthandel gebruikte het Referat joodse handelaren zoals de gebroeders Katz als tussenpersonen om verkopers over te halen die niet rechtstreeks met de bezetter wilden samenwerken."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/21939> a <http://schema.org/Thing>, skos:Concept,
