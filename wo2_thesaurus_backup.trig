    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/c/c9/Wolfswaard%2C_voorgevel_-_Wageningen_-_20248838_-_RCE.jpg/250px-Wolfswaard%2C_voorgevel_-_Wageningen_-_20248838_-_RCE.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/wiki/File:Wolfswaard,_voorgevel_-_Wageningen_-_20248838_-_RCE.jpg";
    dcterms:source "http://www.wo2meteigenogen.nl/vliegeniers-over-de-rijn/"@nl, "http://www.wo2meteigenogen.nl/onderduikers/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2184>;
    dcterms:created "2019-04-26T08:01:53.000Z"^^xsd:dateTime;
    skos:prefLabel "Boerderij De Wolfswaard"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Boerderij De Wolfswaard te Wageningen was een plek waar tal van verzetsactiviteiten plaatsvonden tijdens de Duitse bezetting van Nederland. De OD kwam er samen en er werd een illegale zender gebouwd waarmee uitgezonden werd tijdens de April-Meistakingen van 1943. Ook was het een plek waar onderduikers terecht konden, totdat er op 20 mei 1944 een inval was en twee joodse onderduikers en verzetsmensen en eigenaren van de bovenwoning Eltien en Neeltje Krijthe werden opgepakt."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
