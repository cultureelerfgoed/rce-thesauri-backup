    dcterms:created "2020-08-20T07:41:57.000Z"^^xsd:dateTime;
    skos:prefLabel "Maliebaan 108"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "Aan de Maliebaan 108 zat de Informatiedienst van de Luftwaffe, de 'Nachrichttenabteilung'. De Duitse luchtmacht had meerdere van deze kantoren, in Duitsland en alle bezette gebieden, maar geen zat in zo’n monumentaal pand gevestigd als deze."@nl;
    skos:altLabel "Nachrichttenabteilung Utrecht"@nl .
  
