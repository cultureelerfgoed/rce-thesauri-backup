    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/9184>, <https://data.niod.nl/WO2_Thesaurus/2740>;
    dcterms:created "2020-08-10T13:58:01.000Z"^^xsd:dateTime;
    skos:prefLabel "Opkomst Surinaamse Gangs"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Opkomst van Surinaamse Gangs vond plaats tussen juli 1942 en november 1943 en was een indirect gevolg van komst van de Amerikanen. De jeugdbendes ontstonden door de toename van urbanisatie, criminaliteit, nieuwe hang naar welvaart en de invloed van Amerikaanse films. De Blackout-gang, Zorro-gang, Big-Ten-gang en de Hitler-gang bestonden voornamelijk uit jongens tussen de 15 en 23 jaar. Zij maakten zich schuldig aan overvallen, intimidatie, aanrandingen en vechtpartijen. "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/9216> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:references "Liesbert van der Horst, Wereldoorlog in de West. Suriname, de Nederlandse Antillen en Aruba 1940-1945 (Hilversum: Uitgeverij Verloren, 2004)"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-06-03T14:32:01.056Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1942-11-23"^^xsd:date;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/9538>;
    dcterms:source "http://ecclesia-suriname.com/gemeenten-in-suriname.php"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> false;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2878>;
    dcterms:created "2020-08-10T14:33:22.000Z"^^xsd:dateTime;
    skos:prefLabel "Comité Christelijke Kerken"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Comité Christelijke Kerken was een reactie tegen de toenemende opkomst van jeugdbendes en prostitutie in Suriname. De organisatie werd op 23 november 1942 opgericht en bracht in datzelfde jaar een brochure uit tegen de 'zedenverwildering': de afbraak van normen en waarden, voornamelijk op seksueel gebied."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/9184>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/9217> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "Liesbert van der Horst, Wereldoorlog in de West. Suriname, de Nederlandse Antillen en Aruba 1940-1945 (Hilversum: Uitgeverij Verloren, 2004)"@nl;
