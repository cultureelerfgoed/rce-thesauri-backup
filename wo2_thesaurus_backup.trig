    <http://schema.org/endDate> "1944-09-21"^^xsd:date;
    dcterms:source "https://www.saak.nl/battlefield%20tour/2011%20156%20battalion/156%20battalion%20the%20parachute%20regiment%20nl.html"@nl,
      "https://www.saak.nl/battlefield%20tour/2018%20frontlijnpad/frontlijnpad.htm"@nl,
