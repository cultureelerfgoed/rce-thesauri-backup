    <http://schema.org/location> "Atlantische Oceaan";
    <http://schema.org/startDate> "1942-08-09"^^xsd:date;
    dcterms:source "https://uboat.net/allies/merchants/ships/2019.html"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
