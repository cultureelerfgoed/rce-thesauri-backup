    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/events/9227>, <https://data.niod.nl/WO2_Thesaurus/18784>,
