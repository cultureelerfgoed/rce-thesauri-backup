    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Dienst der Grensbewaking bewaakte direct na de Tweede Wereldoorlog de Nederlandse grenzen. De dienst viel onder het Militair Gezag, dat na de bevrijding het bestuur van Nederland overnam."@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1605>, <https://data.niod.nl/WO2_Thesaurus/2709>,
