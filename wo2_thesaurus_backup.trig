    dcterms:created "2016-08-01T19:19:42.000Z"^^xsd:dateTime;
    skos:prefLabel "Judenfrage"@de, "Judenfrage"@en, "Jodenvraagstuk"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De term Jodenvraagstuk werd vanaf eind 18e eeuw gebruikt voor de kwestie van de positie van de Joden in de maatschappij en de vraagstukken die speelden in het proces van Joodse emancipatie naar gelijke burgerrechten. Het begrip Jodenvraagstuk heeft daarnaast ook een antisemitische lading: dan wordt bedoeld het vraagstuk rond de problemen die Joden zouden veroorzaken binnen de maatschappij. De nationaalsocialistische Jodenvervolging werd betiteld als de “Endlösung der Judenfrage”."@nl;
    skos:altLabel "Joodsche quaestie"@nl, "Joodse Kwestie"@nl .
  
