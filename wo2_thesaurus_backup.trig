    dcterms:created "2018-07-13T10:57:56.000Z"^^xsd:dateTime;
    skos:prefLabel "Stalag VI-A"@nl, "Stalag VI-A"@de, "Stalag VI-A"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Stalag VI-A in Hemer was één van de grootste krijgsgevangenkampen in Duitsland. Na de inval in Polen ontstond er behoefte aan extra krijgsgevangenkampen. Het werd op 10 oktober 1939 in gebruik genomen en was gehuisvest in een al bestaande kazerne. In 1940 kwamen daar 36 houten barakken bij. Er zaten eind 1944 ook vier Nederlandse soldaten vast die begin 1945 naar Stalag IV-B werden overgebracht. Op 14 april 1945 bevrijdden de Amerikanen de gevangenen. In Hemer bevinden zich twee oorlogsbegraafplaatsen voor de 23.900 slachtoffers van het kamp."@nl;
    skos:altLabel "Stalag VI-A Hemer Iserlohn"@de, "Stalag VI A"@nl, "Stalag VI-A Hemer Iserlohn"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/6444> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "52.724722"^^xsd:float;
    <http://www.w3.org/2003/01/geo/wgs84_pos#long> "7.183611"^^xsd:float;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    dcterms:modified "2021-12-21T14:33:25.633Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/8/8f/Kamp_Versen_2-1.JPG";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Stalag_VI_B_Versen#/media/Bestand:Kamp_Versen_2-1.JPG";
    dcterms:source "https://nl.wikipedia.org/wiki/Stalag_VI_B_Versen"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    skos:relatedMatch <https://data.niod.nl/WO2_Thesaurus/kampen/3662>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/6411>;
    dcterms:created "2018-07-13T10:58:12.000Z"^^xsd:dateTime;
    skos:prefLabel "Stalag VI-B"@nl, "Stalag VI-B"@de, "Stalag VI-B"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Stalag VI-B lag bij het dorp Versen, vlakbij de grens met Nederland. Het was één van de 15 Emslandlager. Voorheen was het Kamp IX Versen. Het was een krijgsgevangenkamp dat in de zomer van 1938 werd ingericht voor 1500 arbeiders die onder toezicht stonden van de Reichsarbeitsdienst. In september 1939 werd het kamp overgenomen door het Oberkommando der Wehrmacht om er krijgsgevangenen onder te brengen. In 1942 werd Stalag VI-B opgenomen in Stalag VI-C Bathorn en vanaf november 1944 werd het een buitenkamp van concentratiekamp Neuengamme. Het kreeg toen de naam Kamp Meppen-Versen. Toen in maart 1945 de geallieerden dichterbij kwamen werden de gevangenen op dodenmarsen naar Neuengamme gestuurd."@nl;
    skos:altLabel "Stalag VI B"@nl, "Stalag VI-B Neu-Versen"@nl, "Stalag VI-B Neu-Versen Emsland"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/6445> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    dcterms:modified "2021-12-23T09:48:09.454Z"^^xsd:dateTime;
