    dcterms:created "2019-01-21T11:33:54.000Z"^^xsd:dateTime;
    skos:prefLabel "Kung Yung Pao"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Kung Yung Pao ontstond tijdens en bleef bestaan tot het eind van de Japanse bezetting van Nederlands-Indië. De krant werd opgericht door Tiang Tjoei Oey en was, tijdens de bezetting, de enige krant gericht op de Chinese bevolking. Dit kwam door de pro-Japanse invalshoek van de krant. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4763> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7715> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:37:39.802Z"^^xsd:dateTime;
