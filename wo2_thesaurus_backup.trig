    skos:broader <https://data.niod.nl/WO2_Thesaurus/2020>, <https://data.niod.nl/WO2_Thesaurus/1690>,
      <https://data.niod.nl/WO2_Thesaurus/kampen/7603>, <https://data.niod.nl/WO2_Thesaurus/8204>,
      <https://data.niod.nl/WO2_Thesaurus/19098>;
    dcterms:created "2024-12-30T10:52:50.133Z"^^xsd:dateTime;
    skos:prefLabel "Bantjeui-gevangenis"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Bantjeui-gevangenis functioneerde als vrouwen- en mannenkamp en als gevangenis voor politiek gevangenen. De gevangenis was gelegen aan de Bantjeujweg (nu Jl. Banceuy) vlak bij de Groote Postweg (nu Jl. Asia Afrika) in het centrum van Bandung, Java. In de periode van september 1943 tot augustus 1945 werden hier mannen, vrouwen en kinderen geïnterneerd, o.a. politiek gevangenen (mannen en vrouwen), oudere en zieke Indo-Europeanen en Ambonezen, Joden en vrijmetselaars."@nl .
  
