    <http://schema.org/location> "Rotterdam";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/57a825fe-025a-11e7-904b-d89d6717b464/media/7142e356-52eb-cd0c-7090-cd730483e13b>,
