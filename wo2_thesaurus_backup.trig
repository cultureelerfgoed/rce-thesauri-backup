    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://service.archief.nl/gaf/api/file/v1/img/027fabcb-57b0-4bf9-8ac7-81fc8522c337?h=1000";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://www.nationaalarchief.nl/onderzoeken/fotocollectie/a8993814-d0b4-102d-bcf8-003048976d84";
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Speciaal:Citeren&page=Wederopbouw&id=46944769"@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/demoadmin>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/events/5138>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1561>;
    dcterms:created "2016-08-01T19:19:00.000Z"^^xsd:dateTime;
    skos:prefLabel "Wiederaufbau"@de, "Reconstruction"@en, "Wederopbouw"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Wederopbouw is het opnieuw bouwen van iets nadat het verwoest is. Met Wederopbouw wordt vaak de periode na afloop van de Tweede Wereldoorlog aangeduid, waarin het na de Duitse bezetting ontwrichte Nederland weer werd opgebouwd."@nl;
    skos:altLabel "Herstelwerkzaamheden"@nl, "Puinruimen"@nl;
    skos:definition "Met wederopbouw wordt over het algemeen een niet precies afgebakende periode na afloop van de Tweede Wereldoorlog aangeduid (pakweg de tweede helft van de jaren veertig en het begin van de  jaren vijftig) waarin het na de Duitse bezetting ontwrichte Nederland weer werd opgebouwd. Tijdens de oorlog was veel infrastructuur, zoals bruggen, wegen en spoorwegen vernield. Ook waren huizen, fabrieken en gebouwen vernietigd of beschadigd. Door een vereniging van krachten en beschikbare hulp van onder andere het Marshallplan, werd Nederland weer opgebouwd."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/1575> a <http://schema.org/Thing>, skos:Concept;
