    dcterms:references """José Huurdeman, Ondergronds in de Tweede Wereldoorlog, Verhalen uit de
Gelderse Vallei, Veluwe en Krimpenerwaard, Leusden, 2019."""@nl,
      "Hans Onderwater, “Operatie Manna”, de geallieerde voedseldroppings april/mei 1945, Weesp, 1985."@nl,
      """Ronald Polak, Afgemarcheerd!, de ontwapening van 13.000 Duitse soldaten in
afwachting van hun voettocht naar Duitsland, Leusden 9-23 mei 1945, Leusden, 2018."""@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
