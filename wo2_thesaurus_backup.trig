      <https://data.niod.nl/WO2_Thesaurus/20711>;
    dcterms:created "2016-10-04T13:07:38.000Z"^^xsd:dateTime;
    skos:prefLabel "'Bijzondere Vrijwillige Landstorm'"@de, "'Bijzondere Vrijwillige Landstorm'"@en,
      "Bijzondere Vrijwillige Landstorm"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Bijzondere Vrijwillige Landstorm (niet verwarren met De ‘Landstorm Nederland’ die later tijdens de bezettingsperiode bestond) was een aparte categorie vrijwilligers binnen de Vrijwillige Landstorm. Het ging hier om dienstplichtige militairen zonder mobilisatiebestemming die, in tijden van nood, als bijzondere vrijwilliger onder de wapenen konden komen om de overheid te hulp te komen bij het handhaven van de binnenlandse orde en rust. In de meidagen van 1940 leverden zij strijd en moesten de eenheden de nodige gesneuvelden betreuren. Door de bezetter werd de Nederlandse krijgsmacht, inclusief de Vrijwillige Landstorm, in 1940 opgeheven."@nl;
    skos:altLabel "B.V.L."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
