  <https://data.niod.nl/WO2_Thesaurus/9061> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "J. Sintemaartensdijk, De Bleekneusjes van 1945 (Boom; Amsterdam 2002)"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    dcterms:modified "2022-01-25T13:19:52.727Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/3550993c-025a-11e7-904b-d89d6717b464/media/b9f4671f-23f3-f705-6daf-aed7394df99c>;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Bleekneusje&oldid=56233673"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/havingap>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2955>;
    dcterms:created "2020-07-15T08:56:33.000Z"^^xsd:dateTime;
    skos:prefLabel "Bleekneusjes"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Bleekneusjes zijn kinderen die tijdens de hongerwinter vanuit de stad naar het platteland werden gebracht. Tijdens de hongerwinter waren sommige kinderen zo verzwakt, of hadden families zo weinig te eten, dat de kinderen bij pleeggezinnen op het platteland werden ondergebracht om aan te sterken. Zij kwamen bijvoorbeeld in Urk terecht."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2864>, <https://data.niod.nl/WO2_Thesaurus/2887> .
  
  <https://data.niod.nl/WO2_Thesaurus/9062> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "NIOD"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/freet>;
    dcterms:modified "2021-08-31T13:20:27.878Z"^^xsd:dateTime;
    dcterms:source "https://nl.wikipedia.org/wiki/Zeemijn"@nl;
    skos:relatedMatch <https://data.niod.nl/WO2_biografieen/Gerrit-Korf>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/havingap>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/17525>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3571>;
    dcterms:created "2020-07-15T09:41:49.000Z"^^xsd:dateTime;
    skos:prefLabel "Zeemijnen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Zeemijnen werden door zowel Duitsland als de geallieerden ingezet. Vele schepen en onderzeeboten zonken hierdoor. Er waren contactmijnen die tot ontploffing kwamen als ze in aanraking kwamen met een schip. En invloedsmijnen die tot ontploffing kwamen door akoestische trillingen van een scheepsschroef of door het drukverschil in water als een schip passeert. Een groot deel van de mijnen bleef liggen en werden in de loop van de jaren geruimd. Dit proces is nog altijd niet afgerond."@nl .
  
