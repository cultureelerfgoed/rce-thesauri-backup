    <http://schema.org/endDate> "1942-08-20"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/6086>;
    dcterms:created "2022-03-09T13:30:18.040Z"^^xsd:dateTime;
    skos:prefLabel "Opheffing Berg-Stichting"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Opheffing van de Berg-Stichting vond plaats op 19 augustus 1942 op last van de Duitse autoriteiten. De Duitse bezetter had een reorganisatie van niet-commerciële verenigingen en stichtingen afgekondigd. Het tehuis bleef bestaan, maar werd vanaf november 1942 beheerd door de Joodse Vereniging voor Verpleging en Verzorging (JVvVV)."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/18796> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Ineke Hilhorst e.a., De slag om de Berg-Stichting. Het verhaal van de holocaust opnieuw verteld (Van Wijland: Laren, 2017)"@nl;
