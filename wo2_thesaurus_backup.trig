    skos:prefLabel "D'Ansembourg vlucht voor Amerikaanse troepen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "Op 6 september 1944 vluchtte Commissaris der provincie Limburg en NSB-kopstuk D'Ansembourg bij nadering van de Amerikaanse troepen naar het Schloss Herdingen, een kasteel op het landgoed van zijn schoonouders in het Ruhrgebied. "@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/17715> a <http://schema.org/Thing>, skos:Concept,
