    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Wanneer iemand in vreemde krijgsdienst trad, ging men bij het Duitse leger of bij het leger van een Duitse bondgenoot. Onder ‘vreemde krijgsdienst’ viel bijvoorbeeld dienst bij de Wehrmacht, de Waffen-SS en de Landstorm. Nederlanders die vrijwillig bij deze organisaties in dienst traden, werd het Nederlanderschap afgenomen."@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/19586>;
    dcterms:created "2024-05-23T08:06:31.285Z"^^xsd:dateTime;
    skos:prefLabel "Vreemde krijgsdienst"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "Wanneer iemand in vreemde krijgsdienst trad, ging men bij het Duitse leger of bij het leger van een Duitse bondgenoot. Onder ‘vreemde krijgsdienst’ viel bijvoorbeeld dienst bij de Wehrmacht, de Waffen-SS en de Landstorm. Nederlanders die vrijwillig bij deze organisaties in dienst traden, werd het Nederlanderschap afgenomen."@nl;
    skos:altLabel "Vreemden krijgsdienst"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/3585>;
