    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/10497>;
    <http://schema.org/startDate> "1944-10-21"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2682>;
    dcterms:created "2021-03-03T08:14:23.966Z"^^xsd:dateTime;
    skos:prefLabel "Liquidatie van Evert Bronkhorst"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De liquidatie van Evert Bronkhorst vond plaats op 21 oktober 1944 in Garderen. Bronkhorst begaf zich meermaals bij het Schober's Bosje om hout te kappen en dit werd door verzetsman Jan van den Broek opgemerkt. In het Bosje bevond zich een onderduikershol en Bronkhorst stond als onbetrouwbaar bekend bij het verzet. Twee verzetsmannen gekleed in Duitse uniformen, Matous Lorenzini en Joop Brood (de vader van zanger/schilder Herman Brood) hielden Bronkhorst aan en toen die het onderduikershol wilde verraden schoot Brood hem neer."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/11147> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
