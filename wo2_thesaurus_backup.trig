    skos:prefLabel "Secretaris-Penningmeester van Secties"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De secretaris-penningmeester was de penvoerder voor een sectie van een NSB-front (bijvoorbeeld het Economisch Front) of een NSB-gilde (bijvoorbeeld het Opvoedersgilde) en daarnaast belast met de financiële administratie en het beheer van de gelden hiervan. Naast de territoriale indeling in kringen, districten en gewesten die aansloot op de territoriale indeling van de NSB, kenden de fronten en gilden van NSB dikwijls ook een indeling in secties (afdelingen) van bedrijfsgroepen, vakgebieden of beroepen.  "@nl;
    skos:altLabel "Secretaris-Penningmeester Secties"@nl, "Secretaris-Penningmeester der Secties"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2244> .
  
