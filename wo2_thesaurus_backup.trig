    dcterms:created "2018-03-07T09:03:23.000Z"^^xsd:dateTime;
    skos:prefLabel "Groep N.O."@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote """De verzetsgroep N.O. (Neutrale Organisatie) te Schiedam verspreidde aanvankelijk de uitgaven van andere illegale groepen. Van juni 1944-juni 1945 gaf de groep een eigen illegaal blad uit, De N.O. (nr. 548 in L. Winkel, De ondergrondse pers). De ontslagen burgemeester, mr. dr. F.L.J. van Haaren, schreef de hoofdartikelen die eindigden met een gedicht, dat steeds een parafrase was op het thema: Vergeten ... nooit!
"""@nl;
    skos:altLabel "Neutrale Organisatie"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
