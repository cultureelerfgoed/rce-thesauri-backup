    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/2669>;
    dcterms:created "2017-09-13T10:57:02.000Z"^^xsd:dateTime;
    skos:prefLabel "Groep Henk Höften"@nl, "'Groep Henk Höften'"@de, "'Groep Henk Höften'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote """De Groep Henk Höften was een verzetsgroep die ook wel de SDAP-groep werd genoemd. Het was een sociaal-democratisch netwerk (van mensen uit de AJC) in Almelo rond ambtenaar Henk Höften. Ze verzorgden vanaf 1942 tot aan hun arrestatie in oktober 1944 onderduikers in Almelo en ten noorden. De Groep Henk Höften was gelieerd aan de KP-Almelo. Andere betrokken personen waren onder meer Willem Mondriaan en Nico Affourtit.
"""@nl;
    skos:altLabel "Groep Henk Hoeften"@nl, "SDAP-groep"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/5426> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "Coen Hilbrink, De illegalen. Illegaliteit in Twente en het aangrenzende Salland, 1940-1945 (Groningen, 1989)"@nl;
