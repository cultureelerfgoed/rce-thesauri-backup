    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/0/0f/Jan_Thijssen_%281908_%E2%80%93_1945%29.jpg/500px-Jan_Thijssen_%281908_%E2%80%93_1945%29.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Jan_Thijssen_(verzetsstrijder)#/media/File:Jan_Thijssen_(1908_%E2%80%93_1945).jpg";
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Speciaal:Citeren&page=Radiodienst_van_de_Raad_van_Verzet&id=49662211"@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/2669>;
    dcterms:created "2017-09-13T10:59:37.000Z"^^xsd:dateTime;
    skos:prefLabel "Radiodienst van de Raad van Verzet"@nl, "'Radiodienst van de Raad van Verzet'"@de,
      "'Radiodienst van de Raad van Verzet'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Radiodienst van de Raad van Verzet beheerde en onderhield een binnenlands netwerk van radiozenders. De Radiodienst werd door Jan Thijssen in januari 1944 opgericht. Het binnenlandse netwerk werd in de zomer van 1944 operationeel en het was tot aan het einde van de Duitse bezetting in gebruik door de RVV en de daarmee samenwerkende verzetsorganisaties. Vanaf medio januari 1944 werkten de medewerkers van de Radiodienst nauw samen met de agenten van het  Bureau Inlichtingen (BI)."@nl;
    skos:altLabel "Radiodienst"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4824>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4465>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
