    dcterms:created "2018-07-11T08:56:04.000Z"^^xsd:dateTime;
    skos:prefLabel "Weferlingen"@nl, "Weferlingen"@de;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Het KZ Weferlingen was van augustus 1944 tot april 1945 een Buitenkamp van Buchenwald en lag in de omgeving van Walbeck. Er zaten gemiddeld 400 gevangenen die in de kalimijnen Buchberg dwangarbeid moesten verrichten voor het exploratiebedrijf Dallmann, voor Büssing AG en de vestiging van Niedersächsische Motorenwerke. De schachten werden uitgebreid om motoren te produceren voor vliegtuigen, onderzeeërs en speedboten. De schuilnaam van het kamp was Gazelle. Ook waren hier Merwedegijzelaars geïnterneerd. "@nl;
    skos:altLabel "KZ Weferlingen"@de, "Gazelle"@nl, "KZ-Aussenlager Weferlingen"@nl,
      "Lager Walbeck"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/5781>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
