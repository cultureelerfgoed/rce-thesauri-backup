    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/ee359074-025a-11e7-904b-d89d6717b464/media/3b30e534-2004-0fba-e54e-c01a7f678719";
    <http://schema.org/location> "Straat van Mozambique";
    <http://schema.org/startDate> "1942-07-08"^^xsd:date;
    dcterms:source "https://www.wrecksite.eu/wreck.aspx?134613"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3511>;
    dcterms:created "2021-09-29T12:44:56.439Z"^^xsd:dateTime;
    skos:prefLabel "Scheepsramp Alchiba"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Scheepsramp met de Alchiba vond plaats op 8 juli 1942. De Alchiba was een Nederlands schip van de N.V. Van Nievelt Goudriaan's Scheepvaartbedrijf dat deel uitmaakte van Operatie Dervish. Na deze succesvolle operatie werd het later ook ingezet om oorlogsmaterieel van Durban, Zuid-Afrika naar het Verenigd Koninkrijk te brengen. Onderweg werd het schip aangevallen door een Japanse duikboot en tot zinken gebracht op 8 juli 1942. Het was het laatste schip dat de Japanners in de Straat van Mozambique tot zinken brachten."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/1870> .
  
  <https://data.niod.nl/WO2_Thesaurus/17670> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
