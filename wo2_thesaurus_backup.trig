    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Speciaal:Citeren&page=Weerbaarheidsafdeling&id=48196602"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-06"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    skos:relatedMatch <https://data.niod.nl/WO2_biografieen/Hendrik-van-der-Molen>, <https://data.niod.nl/WO2_biografieen/Carolus-Ludovicus-Swaalf>,
      <https://data.niod.nl/WO2_biografieen/Christiaan-Kole>, <https://data.niod.nl/WO2_biografieen/Gerard-Zuidervliet>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Weerbaarheidsafdeling (WA) was de ordedienst en knokploeg van de Nationaal-Socialistische Beweging (NSB). De organisatie werd in 1932 opgericht. Leden van de WA vochten met tegenstanders van de NSB en met Joden. Veel WA-leden meldden zich aan voor militaire organisaties zoals de Waffen-SS. In 1941 stelde NSB-leider Mussert lidmaatschap van de WA verplicht voor mannelijke NSB-leden tussen de 18 en 40 jaar."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
