    <http://schema.org/startDate> "1944-07-09"^^xsd:date;
    dcterms:source "https://wikimiddenbrabant.nl/Inval_Coba_Pulskens,_Diepenstraat,_9_juli_1944"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2698>, <https://data.niod.nl/WO2_Thesaurus/2004>;
    dcterms:created "2025-10-08T13:32:58.534Z"^^xsd:dateTime;
    skos:prefLabel "Inval Coba Pulskens Tilburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De inval bij Coba Pulskens aan de Diepenstraat in Tilburg vond plaats op 9 juli 1944. Er waren drie geallieerde piloten ondergebracht door Leonie van Harssel. De Duitse politie schiet de drie piloten dood en Pulskens en Van Harssel woden gearresteerd. Pulskens wordt in Ravenbrück vergast maar Van Harssel overleeft de oorlog."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
