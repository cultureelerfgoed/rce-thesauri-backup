    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/2bdf6b9e-025a-11e7-904b-d89d6717b464/media/bbe0facd-fcaf-0a7c-2b12-81b9c884f228";
    <http://schema.org/startDate> "1942-07-12"^^xsd:date;
    dcterms:source "https://resolver.kb.nl/resolve?urn=MMCODA01:000159764:mpeg21:a0009"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/klijne>;
