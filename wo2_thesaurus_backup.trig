    dcterms:created "2020-07-27T11:19:07.000Z"^^xsd:dateTime;
    skos:prefLabel "Misdrijven tegen de menselijkheid"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "Het begrip 'misdrijven tegen de menselijkheid', of 'misdaden tegen de mensheid', is een juridische term die voor het eerst aan de orde kwam bij het Tribunaal van Neurenberg. Het was gehecht aan het Verdrag van Londen van 8 augustus 1945, waarin afspraken werden vastgelegd over de vervolging en bestraffing van oorlogsmisdadigers."@nl;
    skos:altLabel "Misdaden tegen de mensheid"@nl .
  
