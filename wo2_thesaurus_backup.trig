    <http://schema.org/name> "Doesburg";
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/6983>;
    dcterms:created "2018-10-31T10:48:10.000Z"^^xsd:dateTime;
    skos:prefLabel "Befreiung von Doesburg"@de, "Liberation of Doesburg"@en, "Bevrijding Doesburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Bevrijding van Doesburg (Gelderland), op 15 april 1945.Van 3 tot 15 april wordt Doesburg met artillerievuur bestookt door Canadese strijdkrachten. Op 15 april verlaten de Duitse strijdkrachten Doesburg, nadat een ‘Sprengkommando’ de toren van de Martinikerk, de synagoge, de watertoren, de walmolen en de brug over de IJssel hebben opgeblazen."@nl .
  
