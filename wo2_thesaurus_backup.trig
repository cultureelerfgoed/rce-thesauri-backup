    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/5/58/Kriegsgefangene_Bhf_Fallingbostel.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://de.wikipedia.org/wiki/Stalag_XI_D#/media/Datei:Kriegsgefangene_Bhf_Fallingbostel.jpg";
    dcterms:source "https://de.wikipedia.org/wiki/Stalag_XI_D"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/6411>;
    dcterms:created "2018-07-16T07:44:40.000Z"^^xsd:dateTime;
    skos:prefLabel "Stalag XI-D"@nl, "Stalag XI-D"@de, "Stalag XI-D"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Stalag XI-D was een Duits krijgsgevangenkamp in Oerbke bij Bad Fallingbostel. Het was één van de vier hoofdkampen in Wehrkreis XI Hannover. Het waren allemaal tussenstations voor de kampen die in Noordwest-Duitsland krijgsgevangenen als dwangarbeiders gebruikten. De gevangenen werden in het kamp geregistreerd en een afdeling van het arbeidsbureau in de Stalag bracht dan de gevangenen in werkdetachementen van zo'n 30-30 man samen en verhuurde die aan bedrijven en gemeenschappen. De eerste Russische krijgsgevangenen arriveerden in juli 1941 toen er nog geen gebouwen waren. Het sterftecijfer was erg hoog vanwege slechte huisvesting en zorg. Vanaf 12 augustus 1942 werd het kamp onderdeel van Stalag XI-B en in 1944 werd op het terrein Stalag 357 opgericht. In 1941 werd er een begraafplaats aangelegd. Het is een collectief graf voor maximaal 30.000 doden die tot 1945 in het kamp zijn omgekomen. Na de oorlog gebruikten de Britse troepen de Stalag als interneringskamp voor nazi's."@nl;
    skos:altLabel "Stalag XI D"@nl, "Stalag XI-D Oerbke"@nl, "Stalag 321"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/6485> a <http://schema.org/Thing>, skos:Concept,
