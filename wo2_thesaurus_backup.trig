    skos:broader <https://data.niod.nl/WO2_Thesaurus/9184>, <https://data.niod.nl/WO2_Thesaurus/2077>;
    dcterms:created "2020-08-10T13:39:07.000Z"^^xsd:dateTime;
    skos:prefLabel "Invoer Distributiesysteem Suriname"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Invoer van Distributiesysteem in Suriname vond plaats in 1944. De Surinaamse bevolking kon producten als suiker, erwten, meel, zeep, olie en rijst alleen nog met distributiebonnen aanschaffen. Ook startte het 'kindervoedingsproject' op scholen, waarbij kinderen op school een extra warme maaltijd kregen."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/9214> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Liesbert van der Horst, Wereldoorlog in de West. Suriname, de Nederlandse Antillen en Aruba 1940-1945 (Hilversum: Uitgeverij Verloren, 2004)"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
