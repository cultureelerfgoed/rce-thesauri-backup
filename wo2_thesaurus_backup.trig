    skos:prefLabel "Politieke Opsporingsdienst Veendam"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "De Politieke Opsporingsdienst (POD) Veendam was een speciale, lokale politiedienst. De POD’s spoorden verdachten van collaboratie op, deden onderzoek en verhoorden verdachten, getuigen en slachtoffers. De POD’s werden op 1 juni 1945 opgericht. Per 1 maart 1946 namen de Politieke Recherche Afdelingen (PRA’s) hun taken over."@nl;
    skos:altLabel "POD Veendam"@nl, "Politieke Opsporings Dienst district Veendam"@nl,
      "Politieke Opsporings Dienst te Veendam"@nl .
  
