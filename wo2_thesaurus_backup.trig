    dcterms:source "https://www.tracesofwar.nl/sights/15861/Monument-Krijgsgevangenenkamp-Stammlager-VI-D.htm"@nl,
      "https://de.wikipedia.org/wiki/Stammlager_VI_D"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/6411>;
    dcterms:created "2018-07-13T10:58:45.000Z"^^xsd:dateTime;
    skos:prefLabel "Stalag VI-D"@nl, "Stalag VI-D"@de, "Stalag VI-D"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Stalag (Stammlager) VI-D in Dortmund was een krijgsgevangenkamp en de centrale voorziening voor de bevoorrading van krijgsgevangenen aan de zware industrie in het Ruhrgebied. Het werd van september 1939 tot augustus 1941 in de Westfalenhalle ingericht en daarna volgde uitbreiding met houten barakken in het omliggende Volkspark Dortmund. Tot maart 1945 verbleven er in totaal 70.000 gevangenen. Een gedenksteen herdenkt de 5095 overleden Sovjet-dwangarbeiders."@nl;
    skos:altLabel "Stalag VI D"@nl, "Stalag VI-D Dortmund"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/6447> a <http://schema.org/Thing>, skos:Concept,
