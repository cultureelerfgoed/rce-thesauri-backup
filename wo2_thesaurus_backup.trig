    dcterms:source "https://anderetijden.nl/aflevering/320/Kamp-Dora"@nl, "https://www.pudv.nl/mittelbau-dora/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
