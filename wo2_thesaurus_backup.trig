    skos:prefLabel "Slag om Woensdrecht"@nl, "Schlacht um Woensdrecht"@de, "Battle of Woensdrecht"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Slag om Woensdrecht van 16 tot en met 24 oktober 1944 tijdens de Slag om de Schelde, was een operatie van Canadese strijdkrachten, waaronder de Royal Hamilton Light Infantry, om toegang tot Zuid-Beveland te krijgen. Pas op 24 oktober en na zware verliezen wonnen de Canadese troepen het gevecht en waren Woensdrecht en omgeving bevrijd."@nl;
    skos:altLabel "Bevrijding van Woensdrecht"@nl;
