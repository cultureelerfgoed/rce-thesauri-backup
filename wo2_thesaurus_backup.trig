    skos:prefLabel "V-Day"@nl, "'V-Day'"@de, "VE-Day"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "V-dag (in het Engels Victory in Europe Day, afgekort VE-day) is de jaarlijkse viering van de overwinningsdag waarop Duitsland op 8 mei 1945 officieel capituleerde. In Oost-Europa wordt, vanwege het tijdsverschil met destijds de Sovjet-Unie, 9 mei als Dag van de Overwinning gevierd."@nl;
    skos:altLabel "VE-Day"@nl, "V Day"@nl, "V-dag"@nl, "V Dag"@nl, "Victory in Europe Day"@nl,
      "Dag van de Overwinning"@nl .
  
