    dcterms:created "2022-02-01T11:59:48.761Z"^^xsd:dateTime;
    skos:prefLabel "Digital humanities"@nl, "Digital humanities"@en, "Digital humanities"@de;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Digital humanities zijn een domein van de wetenschappen op het raakvlak van computerwetenschappen, digitale technieken en de klassieke disciplines van de geesteswetenschappen. Het omvat het systematische gebruik van digitale bronnen in de geesteswetenschappen, evenals de analyse van hun afgeleide werken."@nl;
    skos:altLabel "Digitale geesteswetenschappen"@nl .
  
