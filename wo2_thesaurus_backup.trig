    <http://schema.org/startDate> "1945-03-28"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2682>;
    dcterms:created "2021-02-17T12:18:03.156Z"^^xsd:dateTime;
    skos:prefLabel "Liquidatie van Ale Toering"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De liquidatie van Ale Toering vond plaats op 28 maart 1945 in Makkinga. Toering werd neergeschoten door Spijkervet uit Steenwijk en Petrus de Boer uit Haulerwijk. Hij was bezig met het opplakken van pamfletten voor de Duitse bezetter. Toering was gehuwd met Jannesje Kleiker die op 1 augustus 1945 overleed in Kamp Westerbork. Zij zat daar wegens 'politieke onbetrouwbaarheid'."@nl .
  
