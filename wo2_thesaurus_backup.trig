    skos:broader <https://data.niod.nl/WO2_Thesaurus/1922>, <https://data.niod.nl/WO2_Thesaurus/2322>;
    dcterms:created "2022-01-06T09:37:07.740Z"^^xsd:dateTime;
    skos:prefLabel "Evacuatie van Tiel 1940"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Evacuatie van Tiel van 1940 vond plaats op 13 mei 1940. Vanwege de Duitse invasie moesten ruim 10.000 inwoners van Tiel onverwachts evacueren naar Gouda, IJsselstein en Boskoop. Na de capitulatie op 15 mei 1940 konden zij weer naar huis."@nl .
  
