    <http://schema.org/startDate> "1945-04-14"^^xsd:date;
    <http://schema.org/name> "Zwolle";
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/6983>;
    dcterms:created "2018-10-31T10:47:06.000Z"^^xsd:dateTime;
    skos:prefLabel "Befreiung von Zwolle"@de, "Liberation of Zwolle"@en, "Bevrijding Zwolle"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De bevrijding van Zwolle (Overijssel) vond plaats op 14 april 1945. Het Frans-Canadese regiment was opgerukt tot Wijthmen, vlakbij Zwolle. Uit angst voor burgerslachtoffers en schade aan de stad werd een aanval met granaatvuur heroverwogen. Een verkenningsmissie moest eerst de Duitse troepensterkte in kaart brengen. Korporaal Léo Major zorgde er samen met het verzet voor dat de Duitsers op de vlucht sloegen. Daarna verliep de opmars van de geallieerden voorspoedig."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
