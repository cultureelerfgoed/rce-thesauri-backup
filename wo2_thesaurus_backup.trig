  <https://data.niod.nl/WO2_Thesaurus/locations/10681> a skos:Concept, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "52.088046179736885"^^xsd:float;
