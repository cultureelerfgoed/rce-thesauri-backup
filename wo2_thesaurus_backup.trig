    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/w/index.php?title=Special:Search&limit=20&offset=20&profile=default&search=nieuw-Vossemeer&advancedSearch-current=%7B%7D&ns0=1&ns6=1&ns12=1&ns14=1&ns100=1&ns106=1&searchToken=zkly5ujbk4llk0qqx40d8ye#%2Fmedia%2FFile%3AJuliana_in_Nieuw-Vossemeer.jpg";
    <http://schema.org/startDate> "1944-11-22"^^xsd:date;
    <http://schema.org/endDate> "1944-11-22"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/6983>;
    dcterms:created "2020-11-11T15:06:39.764Z"^^xsd:dateTime;
    skos:prefLabel "Brandongeval vliegtuigtank Nieuw-Vossemeer"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het Brandongeval met een vliegtuigtank in Nieuw-Vossemeer vond plaats op 22 november 1944. Geallieerde vliegtuigen kwamen boven Nieuw-Vossemeer Duitse jagers tegen. Eén van de geallieerde vliegtuigen richtte zich op de Duitsers en om vlotter te kunnen handelen maakte de piloot zijn volle reservetank los en liet deze naar beneden vallen. De volle tank kwam in Nieuw-Vossemeer in de Achterstraat terecht. Er ontstond een ontploffing waarbij vijf kinderen ernstig verbrand raakten. Slechts een van hen overleefde de ramp. Het is nooit duidelijk geworden wat de oorzaak van de ontploffing en de brand was."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/10299> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Guus Hartendorf, Velser Affaire. Bezettingstijd 1940-1945 in Kennemerland (Haarlem 2001) "@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
