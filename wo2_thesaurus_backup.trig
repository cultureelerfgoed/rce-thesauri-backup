    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/w/index.php?title=File:Branden_op_de_Ginkelse_Heide_bij_Ede_tijdens_de_luchtlandingen_op_18_september_1944..jpg&oldid=579893113";
    <http://schema.org/startDate> "1944-09-17"^^xsd:date;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
