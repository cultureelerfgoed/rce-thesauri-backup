    skos:prefLabel "Executies in Kampen, 8 oktober 1944"@nl, "Hinrichtungen in Kampen, 8. Oktober 1944"@de,
      "Executions in Kampen, October 8, 1944"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 8 oktober 1944 werden twee Kampenaren die weigerden werkzaamheden voor de Duitse Wehrmacht te verrichten in de tuin van de Koornmarktskazerne in Kampen gefusilleerd. Het waren Jan Kool en Johannes Schreuder."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/18860> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references """Jan Heerze & Jelle Reitsma, 	Apeldoorn '40-'45. Het verhaal achter de Apeldoornse oorlogsmonumenten (Apeldoorn: Stichting Bevrijding '45)"""@de;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:26:55.665Z"^^xsd:dateTime;
