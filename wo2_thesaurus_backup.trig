    <http://schema.org/startDate> "1939-07-01"^^xsd:date;
    dcterms:source "https://wetten.overheid.nl/BWBR0001998/2010-10-10#:~:text=1%20Hij%20die%20door%20handelen,ten%20hoogste%20%E2%82%AC%204%20500."@nl;
