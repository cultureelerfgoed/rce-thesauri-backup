    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://www.4en5mei.nl/herdenken-en-vieren/oorlogsmonumenten/monumenten_zoeken/oorlogsmonument/1858>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/11437>;
    dcterms:created "2021-04-07T10:57:44.174Z"^^xsd:dateTime;
    skos:prefLabel "Woonwagenkamp de Stegen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Woonwagenkamp de Stegen bevond zich bij Stegen 35 in Beek (Limburg). Het was een soort wild kampje, de familie Franz had grond gepacht. Hier is nu een monument voor gedeporteerde zigeuners."@nl;
    skos:altLabel "Woonwagenkamp Beek"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/11441> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references """Vervolging van zigeuners in Nederland 1940-1945, Dr. B. A. Sijes in samenwerking met Th.M. de Graaf, A. Kloosterman, J.F.A. van Loenen , G.J. van Setten, A.L. Visser. 
Uitgave Ministerie van Onderwijs en Wetenschappen RIOD Monografieën, nr. 13, Vervolging van zigeuners in Nederland 1940-1945, Den Haag, 1979"""@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:17:25.367Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/9582>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/zeb/thumb/1000x1000/338497b3-0043-cd67-c3d8-969f6765a5a5.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://digitaal.zeeuwsebibliotheek.nl/foto/a1984196-97d0-11e3-8e58-4364e861b437";
    <http://schema.org/location> "Den Haag";
    <http://schema.org/startDate> "1937-12-23"^^xsd:date;
    <http://schema.org/endDate> "1939-01-13"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/11451>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2788>;
    dcterms:created "2021-04-07T10:59:03.921Z"^^xsd:dateTime;
    skos:prefLabel "Nederlandsche Zigeuner Centrale 1937-1939"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "In het Algemeen Politieblad van 30 december 1937 werd de oprichting van de Nederlandsche Zigeuner Centrale bekendgemaakt. Het Besluit van 23 december 1937 van de minister van Justitie luidde: 1. De inspecteur der Koninklijke Marechaussee is belast met de registratie van alle hier te lande vertoevende Zigeuners waaronder in dit verband zijn te verstaan: woonwagenbewoners en andere zwervende personen; beide deze categorieën slechts voor zooverre de daaronder vallende personen niet de Nederlandsche nationaliteit bezitten. Deze registratie zal worden aangeduid met de naam: Nederlandsche Zigeuner Centrale. Op 13 januari 1939 werd de Zigeuner Centrale opgeheven. Dit hield verband met de de hoge kosten die een dergelijke centrale met zich mee zou brengen. Er werden geen gegevens naar de internationale Centrale in Wenen gestuurd omdat de politie in het algemeen over geringe technische middelen beschikte. Men kon niet voldoen aan de eisen die een Zigeunercentrale stelde, namelijk het maken van speciale foto’s en vingerafdrukken."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/11443> a <http://schema.org/Thing>, skos:Concept;
