    skos:prefLabel "Festung Holland"@de, "Fortress Holland"@en, "Vesting Holland"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Met Vesting Holland werd tussen 1922 en 1940 het vitaal beschouwde deel van Nederland aangeduid dat het strategische kerngebied van de Nederlandse landsverdediging vormde. Voor de Duitsers was Festung Holland een belangrijke stelling. Daarom lieten zij delen ervan onder water lopen om het te kunnen verdedigen."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/4428> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-07-16T11:13:34.514Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8019>,
      <https://data.niod.nl/WO2_Thesaurus/locations/8018>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/wo2nedindieThema> "Internationale betrekkingen";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> <https://resolver.kb.nl/resolve?urn=urn:gvn:EVDO02:NIOD07_0423&role=thumbnail>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://resolver.kb.nl/resolve?urn=urn:gvn:EVDO02:NIOD07_0423";
    <http://schema.org/location> "Placentia Bay";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://www.nationaalarchief.nl/onderzoeken/archief/2.09.06>,
      <https://www.delpher.nl/nl/kranten/view?coll=ddd&identifier=ddd:011222114:mpeg21:a0179>,
      <https://www.delpher.nl/nl/kranten/view?coll=ddd&identifier=ddd:010424708:mpeg21:a0006>;
    <http://schema.org/startDate> "1941-08-14"^^xsd:date;
    dcterms:source "http://www.history.com/topics/world-war-ii/atlantic-charter"@en, "https://en.wikipedia.org/w/index.php?title=Atlantic_Charter&oldid=765685762"@en;
    <http://schema.org/description> "Op 9-14 augustus 1941 vindt in de Placentia Bay bij het Canadese eiland New Foundland een conferentie plaats tussen Amerikaanse president Franklin D. Roosevelt en de Britse premier Winston Churchill. De conferentie wordt afgesloten met de verklaring van het Atlantisch Handvest waarin de landen hun visie op de naoorlogse wereld formuleren. De derde bepaling van het Atlantisch Handvest luidt: ‘Third, they [de Verenigde Staten en Groot-Brittannië] respect the the right of all peoples to choose the form of government under which they will live; and they wish to see sovereign rights and self government restored to those who have been forcibly deprived of them.’ "@nl;
    skos:relatedMatch <https://data.niod.nl/WO2_biografieen/Franklin-Delano-Roosevelt>,
      <https://data.niod.nl/WO2_biografieen/Winston-Churchill_2>;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1561>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4706>,
      <https://data.niod.nl/WO2_Thesaurus/events/8185>, <https://data.niod.nl/WO2_Thesaurus/events/8184>;
    dcterms:created "2016-10-04T11:45:13.000Z"^^xsd:dateTime;
    skos:prefLabel "Atlantik-Charta"@de, "Atlantic Charter"@en, "Atlantic Charter"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Atlantic Charter (Atlantisch Handvest) was een politiek manifest dat regeringsleiders Churchill en Roosevelt op 14 augustus 1941 opstelden. Zij formuleerden acht uitgangspunten voor een naoorlogse wereld die tijdens een conferentie op 1 januari 1942 door 26 landen werden onderschreven en aldus de basis legden voor de oprichting van de Verenigde Naties op 24 oktober 1945."@nl;
    skos:altLabel "Atlantisch handvest"@nl .
  
