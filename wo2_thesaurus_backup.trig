    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Pemoeda&oldid=51531193"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2886>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4545>;
    dcterms:created "2019-01-23T12:29:34.000Z"^^xsd:dateTime;
    skos:prefLabel "Pemoeda Indonesia"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote """Pemoeda Indonesia (pemoeda betekent jeugd of jongeren) was een in de jaren 1920 ontstane jongerenorganisatie, opgericht door Algemeene Studieclub te Bandoeng. Het woord Pemoeda werd tijdens de Japanse bezetting door meerde jeugdorganisaties gebruikt die streden voor onafhankelijkheid. Naar verluid verkondigde Soekarno onder druk van de Pemoeda's eerder de onafhankelijkheidsverklaring dan hij zelf voor ogen had.  
"""@nl;
    skos:altLabel "Pemuda Indonesia"@en;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7742> a <http://schema.org/Thing>,
