    dcterms:source "https://merwedegijzelaars.nl/werkplek/7/brabag-en-de-asw-bohlen-lippendorf"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/6387>;
    dcterms:created "2022-02-01T11:36:11.927Z"^^xsd:dateTime;
    skos:prefLabel "Werkplek BRABAG en de A.S.W., Böhlen/Lippendorf"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Vanuit Kamp De Kippe en Alpenrose werden gevangenen tewerkgesteld bij de Böhlener Werke van de A.S.W. (Aktiengesellschaft Sächsische Werke). De A.S.W. was eigenaar van de electriciteitscentrale die met bruinkool werd gestookt. BRABAG (BRAunkohle Benzin AG) maakte synthetische benzine uit bruinkool. Deze fabriek stond naast de electriciteitscentrale. Het werk bestond vooral uit puinruimen vanwege de vele bombardementen."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/kampen/6388> .
  
  <https://data.niod.nl/WO2_Thesaurus/18632> a <http://schema.org/Thing>, skos:Concept;
