    skos:prefLabel "Lichamelijk beperkten"@nl, "Körperbehinderten"@de, "Physically disabled"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Lichamelijk bepertken zijn personen met een lichamelijke of motorische defect of beperking waardoor zij gehinderd worden in handelingen en/of bewegingen. De handicap kan ontstaan doordat lichaamsdelen niet volgroeid of beschadigd zijn (fysieke afwijkingen) of doordat lichamelijke functies verstoord zijn (functionele afwijkingen)."@nl;
    skos:altLabel "Lichamelijk gehandicapten"@nl, "Invaliden"@nl, "Doven"@nl, "Blinden"@nl,
      "Doofstommen"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/2049> a <http://schema.org/Thing>, skos:Concept;
