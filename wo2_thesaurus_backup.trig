    dcterms:created "2024-08-05T19:37:17.663Z"^^xsd:dateTime;
    skos:prefLabel "Phu My"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Phu My was een krijgsgevangenkamp bij de plaats Phu My, ca. 60 km ten zuidoosten van Saigon (nu Ho Chi Minhstad) in de delta van de Saigon-rivier. Het kamp was voorheen een kamp voor contractarbeiders, nadat zij waren gevlucht voor bombardementen werd het een krijgsgevangenkamp. De werkzaamheden waren o.a. het bouwen van hutten voor 1000 tot 1500 krijgsgevangenen, aanvoer van stenen t.b.v. de aanleg van een vliegveld, sloten graven rondom het vliegveld en het kamp en het graven van een kuil in het kamp t.b.v. een massagraf."@nl;
    skos:altLabel "Phumy"@nl, "Fumy"@nl, "Fumi"@nl .
  
