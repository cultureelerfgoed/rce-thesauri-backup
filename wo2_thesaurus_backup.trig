    <http://schema.org/startDate> "1943-06-21"^^xsd:date;
    <http://schema.org/endDate> "1943-06-22"^^xsd:date;
    dcterms:source "https://www.wo2slachtoffers.nl/bio/53991/Kok-Hermanus-Matheus.htm"@nl,
