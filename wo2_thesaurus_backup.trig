    dcterms:created "2021-02-15T11:46:42.305Z"^^xsd:dateTime;
    skos:prefLabel "Liquidatie van Lint"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De liquidatie van Lint vond plaats op 5 september 1944 in Delft. Lint was Oberfluhrwärter in het Oranjehotel en stond bekend om zijn brute optreden. Op Dolle Dinsdag ging hij op de vlucht met een woonboot achter een Duitse sleepboot op de Vliet in Delft. Ter hoogte van de Calvéfabrieken werd hij doodgeschoten. "@nl .
  
