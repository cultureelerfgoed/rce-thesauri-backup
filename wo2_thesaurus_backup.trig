    dcterms:created "2019-01-23T12:47:14.000Z"^^xsd:dateTime;
    skos:prefLabel "Militair bestuur voor Nederland"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Duitse overheersing van Nederland begon met de Duitse inval. Op de dag van de capitulatie (14 mei 1940) week de voltallige Nederlandse ministerraad uit naar Londen. Op 20 mei 1940 trad het militair bestuur voor Nederland in functie, onder de Militärbefehlshaber Alexander Freiherr von Falkenhausen. Op 29 mei 1940 werd dit militaire bestuur vervangen door een civiel bestuur."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7743> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "Loe de Jong - Het Koninkrijk der Nederlanden in de Tweede Wereldoorlog"@nl,
      "J. Dankers en J. Verheul - Bezet Gebied dag in dag uit"@nl;
