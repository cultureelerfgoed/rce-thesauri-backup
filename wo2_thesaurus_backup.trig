    dcterms:modified "2024-08-12T12:03:08.736Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1926-07-04"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/a850cade-db8e-c599-a52e-b79e95b1ebfd.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/a6ef2fc8-0259-11e7-904b-d89d6717b464/media/a850cade-db8e-c599-a52e-b79e95b1ebfd";
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-08"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Hitlerjugend was de jeugdorganisatie van de Nationaalsocialistische Duitse Arbeiderspartij (NSDAP). Vanaf 1939 was lidmaatschap verplicht voor alle Duitse jongeren boven 17 jaar en vanaf 1941 voor jongeren ouder dan 10 jaar. De organisatie voor meisjes, de Bund Deutscher Mädel, was een onderdeel van de Hitlerjugend. Tijdens de bezetting van Nederland werkte de Hitlerjugend nauw samen met de Nationale Jeugdstorm van de Nationaal-Socialistische Beweging (NSB)."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/corporaties/4464>, <https://data.niod.nl/WO2_Thesaurus/corporaties/6167>,
      <https://data.niod.nl/WO2_Thesaurus/19554>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2886>, <https://data.niod.nl/WO2_Thesaurus/1906>;
    dcterms:created "2016-10-04T13:07:39.000Z"^^xsd:dateTime;
    skos:prefLabel "Hitlerjugend"@de, "Hitlerjugend"@en, "Hitlerjugend"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Hitlerjugend was de jeugdbeweging van de NSDAP en werd op 4 juli 1926 opgericht. Vanaf 1939 was het lidmaatschap verplicht voor alle jongeren boven zeventien jaar en vanaf 1941 voor alle jongeren ouder dan tien jaar. De organisatie voor meisjes, de Bund Deutscher Mädel, was een onderdeel van de Hitlerjugend. Tijdens de bezetting werkte de Hitlerjugend in ons land nauw samen met de Nationale Jeugdstorm van de NSB."@nl;
    skos:altLabel "Hitler Jugend"@nl, "Hitlerjeugd"@nl, "Hitler-Jugend"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/17718>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization>;
    skos:hiddenLabel "HJ"@nl, "H.J."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/4535> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "S.C. Kooijman, ‘Verraders waarvoor in een bevrijd Nederland geen plaats zal zijn’. Institutioneel onderzoek naar het beleidsterrein van de bijzondere rechtspleging, 1945-1952 (’s-Gravenhage: Rijksarchiefdienst, 2000), 64."@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2024-06-04T14:43:14.382Z"^^xsd:dateTime;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Hoge_Raad_der_Nederlanden&oldid=48808655"@nl,
      "https://www.rechtspraak.nl/Organisatie-en-contact/Organisatie/Hoge-Raad-der-Nederlanden/Over-de-Hoge-Raad"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    <http://schema.org/description> "De Hoge Raad der Nederlanden is de hoogste rechter in Nederland op het gebied van civiel recht, strafrecht en belastingrecht. Hij is dat ook voor Aruba, Curaçao, Sint Maarten en Bonaire, Saba en Sint Eustatius. De Hoge Raad is geen derde instantie maar cassatierechter, beantwoordt de Hoge Raad rechtsvragen en draagt zo bij aan de ontwikkeling van het recht en de rechtsbescherming. De Hoge Raad zetelt in Den Haag en is belast met het toezicht op de rechtseenheid en rechtsontwikkeling van het Nederlandse recht. Tijdens de Duitse bezetting bleef de Hoge Raad in functie. In november 1940 werd de voorzitter van de Hoge Raad, mr. Lodewijk Visser geschorst vanwege zijn Joodse afkomst. De overblijvende leden bleven in functie en tekenden de Ariërverklaring. De zetel van de Hoge Raad werd in 1943 tijdelijk verplaatst van Den Haag naar Nijmegen. Na de bevrijding verweet men de Hoge Raad een slappe en legalistische houding."@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Hoge Raad der Nederlanden nam vanaf 1952 de taken over van de Bijzondere Raad van Cassatie. Veroordeelden konden bij de Hoge Raad in beroep (cassatie) gaan."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/events/7983>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2618>, <https://data.niod.nl/WO2_Thesaurus/20701>;
    dcterms:created "2016-10-04T13:07:39.000Z"^^xsd:dateTime;
    skos:prefLabel "'Hoge Raad der Nederlanden'"@de, "'Hoge Raad der Nederlanden'"@en,
      "Hoge Raad der Nederlanden"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Hoge Raad der Nederlanden (kortweg Hoge Raad) is de hoogste rechtsprekende instantie in Nederland, Aruba, Curaçao en Sint Maarten op civielrechtelijk, strafrechtelijk en belastingrechtelijk gebied. Tijdens de Duitse bezetting bleef de Hoge Raad in functie. "@nl;
    skos:altLabel "Hoge Raad"@nl, "Hooge Raad der Nederlanden"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
