    dcterms:modified "2024-08-12T12:03:08.883Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1940-05-29"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/download/default/bfd01f8a-0383-4e5c-4edf-66139362d932.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/e5749f58-0259-11e7-904b-d89d6717b464/media/bfd01f8a-0383-4e5c-4edf-66139362d932"@nl;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Generalkommissariat_f%C3%BCr_Verwaltung_und_Justiz&oldid=48694088"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-09"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Het Generalkommissariat für Verwaltung und Justiz was het door de Duitse bezetter ingestelde departement van bestuur en justitie. Het hield toezicht op wetgeving, binnenlands bestuur, justitie (met uitzondering van politiezaken), cultuur, onderwijs, kerkelijke aangelegenheden, volksgezondheid en jeugdzorg. Het departement was onderdeel van het Rijkscommissariaat, het burgerlijk bestuur van bezet Nederland. Het departement werd op 29 mei 1940 ingesteld met Friedrich Wimmer aan het hoofd."@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/corporaties/8820>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4656>;
    dcterms:created "2018-01-22T13:24:22.000Z"^^xsd:dateTime;
    skos:prefLabel "Generalkommissariat für Verwaltung und Justiz"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Generalkommissariat für Verwaltung und Justiz (bestuur en justitie) werd op 29 mei 1940 ingesteld met aan het hoofd dr. Friedrich Wimmer. Vier Generalkommissariate, die deel uitmaakten van het Reichskommissariat, gaven sturing aan de Nederlandse bestuursorganen en hielden toezicht op hun functioneren. Het Generalkommissariat für Verwaltung und Justiz had tot bevoegdheden wetgeving, binnenlands bestuur en justitie (met uitzondering van politiezaken), cultuur, onderwijs, kerkelijke aangelegenheden, volksgezondheid en jeugdzorg. Vanaf herfst 1943 tot kort voor het einde van de bezetting waren de meeste afdelingen in Apeldoorn gevestigd."@nl;
    skos:altLabel "Generaalkommissariaat Bestuur en Justitie"@nl, "Generaalkommissariaat voor Bestuur en Justitie"@nl,
      "Generalkommissar für Verwaltung und Justiz"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/5824> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "Inventaris 061 Generalkommissariat zur besonderen Verwendung (NIOD)."@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-02-23T12:53:31.805Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1940-05-29"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/640x480/7936c650-3376-8153-2835-b4ad59daf1cb.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/e17b3074-0259-11e7-904b-d89d6717b464/media/7936c650-3376-8153-2835-b4ad59daf1cb"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/e18ad470-0259-11e7-904b-d89d6717b464/media/0e179cc6-4db2-3ff4-cc41-3dd896e6ce37>;
    dcterms:source "https://portal.ehri-project.eu/units/nl-002896-mf955263"@nl, "https://www.archieven.nl/nl/zoeken?miview=inv2&mivast=0&mizig=210&miadt=298&micode=061&milang=nl"@nl,
      "https://nl.wikipedia.org/w/index.php?title=Generalkommissariat_zur_besonderen_Verwendung&oldid=48694089"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-09"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Het Generalkommissat zur besonderen Verwendung was het door de Duitse bezetter ingestelde departement voor bijzondere aangelegenheden. Het verspreidde het nationaalsocialistische gedachtegoed via propaganda en censuur in de Nederlandse politiek en cultuur. Het departement was onderdeel van het Rijkscommissariaat, het burgerlijk bestuur van bezet Nederland. Het departement werd op 29 mei 1940 ingesteld met Fritz Schmidt aan het hoofd."@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/20993>, <https://data.niod.nl/WO2_Thesaurus/21938>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4656>;
    dcterms:created "2018-01-22T13:24:40.000Z"^^xsd:dateTime;
    skos:prefLabel "Generalkommissariat zur besonderen Verwendung"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Generalkommissat zur besonderen Verwendung (bijzondere aangelegenheden) werd op 29 mei 1940 ingesteld met aan het hoofd Fritz Schmidt. Vier Generalkommissariate, die deel uitmaakten van het Reichskommissariat, gaven sturing aan de Nederlandse bestuursorganen en hielden toezicht op hun functioneren. Het Generalkommissat zur besonderen Verwendung had tot taak leiding te geven aan de politieke ontwikkeling in Nederland om zo de meningsvorming van de Nederlanders in nationaalsocialistische richting te sturen."@nl;
    skos:altLabel "Generaalkommissariaat Bijzondere Aangelegenheden"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/5825> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "L. de Jong, Het Koninkrijk der Nederlanden in de Tweede Wereldoorlog, Deel 4. Mei ’40- maart ’41. Eerste helft (s’-Gravenhage 1972-1974)"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2024-08-12T12:03:08.878Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1940-05-29"^^xsd:date;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/7949>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/download/default/f1a895fb-000e-a19f-61f8-973336178010.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/df7dbff8-0259-11e7-904b-d89d6717b464/media/f1a895fb-000e-a19f-61f8-973336178010"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/df7c0db6-0259-11e7-904b-d89d6717b464/media/48ef9cec-456b-21a4-3511-e6656a65d30d>,
      <https://beeldbankwo2.nl/nl/beelden/detail/5ac9e524-025a-11e7-904b-d89d6717b464/media/8645535f-965c-1e00-8a47-05a03e7a1048>;
    dcterms:source "https://www.archieven.nl/nl/zoeken?miview=inv2&mivast=0&mizig=210&miadt=298&micode=077&milang=nl"@nl,
      "https://nl.wikipedia.org/w/index.php?title=Generalkommissariat_f%C3%BCr_das_Sicherheitswesen&oldid=48694086"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-09"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Het Generalkommissariat für das Sicherheitswesen was het door de Duitse bezetter ingestelde departement van openbare orde en veiligheid. Het stuurde de Schutzstaffel (SS) en de Nederlandse politie aan en hield zich bezig met de Jodenvervolging en het onderdrukken van verzet. Het departement was onderdeel van het Rijkscommissariaat, het burgerlijk bestuur van bezet Nederland. Het departement werd ingesteld op 29 mei 1940 en stond onder leiding van de SS’er Hanns Albin Rauter."@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/corporaties/5166>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4656>;
    dcterms:created "2018-01-22T14:29:16.000Z"^^xsd:dateTime;
    skos:prefLabel "Generalkommissariat für das Sicherheitswesen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Generalkommissariat für das Sicherheitswesen (openbare orde en veiligheid) werd op 29 mei 1940 ingesteld met aan het hoofd Höhere SS- und Polizeiführer Hanns Albin Rauter. Vier Generalkommissariate, die deel uitmaakten van het Reichskommissariat, gaven sturing aan de Nederlandse bestuursorganen en hielden toezicht op hun functioneren. Het Generalkommissariat für das Sicherheitswesen was verantwoordelijkheid voor de openbare orde en veiligheid. In deze hoedanigheid hield het zich intensief bezig met de Jodenvervolging en de onderdrukking van alle vormen van verzet."@nl;
    skos:altLabel "Generaalkommissariaat Openbare Orde en Veiligheid"@nl, "Generaalkommissariaat voor Openbare Orde en Veiligheid"@nl,
      "Generalkommissar für das Sicherheitswesen"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
