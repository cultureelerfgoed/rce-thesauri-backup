    skos:prefLabel "F-Kikan"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De F-Kikan (F-Groep) was een groep onder leiding van de Japanse majoor Iwaichi Fujiwara. Het werd in september 1941 opgericht en functioneerde tot het eind van de oorlog en had als doel om, in de bezette gebieden, anti-geallieerde acties door de inheemse bevolking te bevorderen. "@nl;
    skos:altLabel "Fujiwara Kikan"@nl, "F-Groep"@nl, "F-Group"@en, "F-Agency"@en, "F Kikan"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/4382>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
