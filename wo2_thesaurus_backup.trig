    <http://schema.org/startDate> "1942-08-25"^^xsd:date;
    dcterms:source "https://www.marhisdata.nl/schip&id=6121"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
