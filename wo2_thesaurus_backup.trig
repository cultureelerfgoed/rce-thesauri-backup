    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-08"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Organisation Todt (OT) was een Duitse overheidsorganisatie en bouwmaatschappij, opgericht in 1933. De organisatie was vernoemd naar de Duitse rijksminister Fritz Todt. De OT bouwde grootschalige verdedigingswerken, zoals de Atlantikwall, en herstelde infrastructuur. De OT werkte in Nederland samen met lokale aannemers, maar maakte in het kader van de Arbeitseinsatz ook gebruik van dwangarbeiders."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/locations/8006>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/20715>;
    dcterms:created "2016-10-04T13:07:41.000Z"^^xsd:dateTime;
    skos:prefLabel "Organisation Todt"@de, "Organisation Todt"@en, "Organisation Todt"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Organisation Todt (OT) werd op 28 juni 1933 opgericht en was vernoemd naar de Generalbevollmächtigte für die Bauwirtschaft, Rijksminister Fritz Todt. De organisatie hield zich tijdens de oorlog voornamelijk bezig met de bouw van verdedigingswerken, zoals de Atlantikwall, en het herstel van door luchtaanvallen beschadigde verbindingen. Nederlanders hebben niet alleen op vrijwillige basis, maar in het kader van de Arbeidseinsatz ook gedwongen gewerkt voor de OT. "@nl;
    skos:altLabel "O.T."@nl, "Organisatie Todt"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/7971>, <https://data.niod.nl/WO2_Thesaurus/locations/7981>,
