    skos:prefLabel "Kamp Siegburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Kamp Siegburg was een gevangenis en tuchthuis in de stad Siegburg in Duitsland. De gevangenis functioneerde tijdens de Tweede Wereldoorlog als een tuchthuis en gevangenis voor politieke gevangenen en dwangarbeiders. Op 10 april 1945 werden de gevangenen door Amerikaanse soldaten bevrijd. "@nl;
    skos:altLabel "Tuchthuis Siegburg"@nl, "Tuchthuis te Siegburg"@nl, "Zuchthaus Siegburg"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/19579> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-06-10T13:03:28.075Z"^^xsd:dateTime;
