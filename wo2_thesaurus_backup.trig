    dcterms:created "2020-07-16T08:57:39.000Z"^^xsd:dateTime;
    skos:prefLabel "Buchenwaldproces"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Het Buchenwaldproces maakte deel uit van de Dachauprocessen en vond plaats tussen 11 april en 14 augustus 1947. Tweeëntwintig oorlogsmisdadigers kregen de doodstraf toegewezen en vijf werden berecht met levenslang. Tot 1965 vonden nog 38 processen plaats, waarbij elf terdoodveroordelingen werden voltrokken."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/9072> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2021-03-15T15:36:17.032Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://nl.wikipedia.org/w/index.php?title=Euthanasiecentrum_Hadamar&oldid=56014129#/media/Bestand:Hadamar,_Euthanasiecentrum,_monument.jpg"@nl,
      "https://nl.wikipedia.org/w/index.php?title=Euthanasiecentrum_Hadamar&oldid=56014129#/media/Bestand:Hadamar_May_4_1945.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/w/index.php?title=Euthanasiecentrum_Hadamar&oldid=56014129"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/999b4be4-025a-11e7-904b-d89d6717b464/media/275ebd60-ad33-2c20-6fc0-18196c767862>;
    <http://schema.org/startDate> "1946-10-08"^^xsd:date;
    <http://schema.org/endDate> "1945-10-15"^^xsd:date;
    dcterms:source "https://encyclopedia.ushmm.org/content/en/article/the-hadamar-trial"@nl,
      "https://nl.wikipedia.org/w/index.php?title=Euthanasiecentrum_Hadamar&oldid=56014129"@nl;
    <http://schema.org/description> "Het Hadamarproces was het eerste proces waar de nazi's terechtstonden die in euthanasiecentrum Hadamar hadden gewerkt. De zaak duurde van 8 tot 15 oktober 1945. Hoewel de Amerikanen alle werknemers wilden vervolgen, kon dat niet door het tekortschieten van het internationaal recht. Uiteindelijk werden toch zeven medewerkers van het euthanasiecentrum berecht wegens hun aandeel aan de misdaden jegens de 476 Poolse en Russische dwangarbeiders, burgers van bondgenoten van de VS. Directeur Alfons Klein kreeg samen met verplegers Karl Willig en Heinrich Ruolff de doodstraf. Tegen nazi-arts Adolf Wahlmann werd levenslang geëist. De overige medewerkers kregen een tijdelijke gevangenisstraf."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/9065>, <https://data.niod.nl/WO2_Thesaurus/2611>;
    dcterms:created "2020-07-16T09:49:01.000Z"^^xsd:dateTime;
    skos:prefLabel "Hadamarproces"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het Hadamarproces was het eerste proces waar de nazi's terechtstonden die in euthanasiecentrum Hadamar hadden gewerkt. De zaak duurde van 8 tot 15 oktober 1945. Uiteindelijk werden zeven medewerkers van het euthanasiecentrum berecht wegens hun aandeel aan de misdaden jegens de 476 Poolse en Russische dwangarbeiders."@nl;
    skos:altLabel "Hadamar trial"@nl, "Hadamar-proces"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/9073> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
