    dcterms:created "2021-02-15T12:42:42.902Z"^^xsd:dateTime;
    skos:prefLabel "Liquidatie van Charlotta Berendina Cornelia Sanders"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De liquidatie van Charlotte Berendina Cornelia Sanders vond plaats op 4 juli 1944 in Arnhem. Sanders was lid van de NSB en werd samen met haar man geliquideerd. Als represaille werd de Joodse leraar Jozua Bromet gedood door de SS'ers Gerrit Jan Koopman en Adolf de Man."@nl .
  
