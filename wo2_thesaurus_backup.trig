    dcterms:created "2019-03-11T14:22:42.000Z"^^xsd:dateTime;
    skos:prefLabel "Jachtlaan 138 (Apeldoorn)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "Jachtlaan 138 te Apeldoorn was in 1944 het adres van de verzetsman Marcelis Andries van Bemmel en zijn gezin. Hij was in 1941 in Apeldoorn geplaatst als opperwachtmeester van de Marechaussee en was sinds 1943 hoofdwachtmeester van de Staatspolitie. Van Bemmel was actief betrokken bij het verzet in Apeldoorn en omgeving, maar werd het slachtoffer van verraad."@nl;
    skos:altLabel "Woonhuis Marcelis van Bemmel"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/locations/8036> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "52.220256"^^xsd:float;
    <http://www.w3.org/2003/01/geo/wgs84_pos#long> "5.962347"^^xsd:float;
    dcterms:references "Jan Heerze e.a., Een school in oorlogstijd. De Koninklijke HBS tussen 1940 en 1945 (Apeldoorn: KSG, 2015)."@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2020-09-01T07:45:59.000Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/e/eb/Apeldoorn_HBS_389031.jpg/500px-Apeldoorn_HBS_389031.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Bestand:Apeldoorn_HBS_389031.jpg";
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2390>;
    dcterms:created "2019-03-11T14:54:12.000Z"^^xsd:dateTime;
    skos:prefLabel "Koninklijke HBS Apeldoorn"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Op de Koninklijke HBS te Apeldoorn werd tijdens de bezetting tot 1942 nog les gegeven, al waren de anti-joodse maatregelen van de bezetter merkbaar vanaf 1940. In november 1940 werd de joodse leraar Jacob Wijler ontslagen en in september 1941 moesten ook de zes joodse leerlingen van school. In maart 1943 werd de HBS door de Duitsers gevorderd om als onderkomen te dienen voor soldaten en deed later ook nog dienst als ‘Sammelsanitäten-park’: een onderkomen voor geneeskundige troepen."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/3585>;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/locations/8037> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "52.22200127975887"^^xsd:float;
    <http://www.w3.org/2003/01/geo/wgs84_pos#long> "6.002626740777031"^^xsd:float;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
