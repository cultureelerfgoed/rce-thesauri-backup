    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://webservices.memorix.nl/mediabank/media/d9125e10-d91e-4efe-aebf-1836357cac1d/downloadfile/bd1e10f2-e6e4-46bb-852e-cc6fbffed6d2?apiKey=6934d11e-52c6-11e4-b0d6-2f8b4b1371c5";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://hdl.handle.net/21.12103/d9125e10-d91e-4efe-aebf-1836357cac1d";
    <http://schema.org/startDate> "1942-07-31"^^xsd:date;
    dcterms:source "https://wikimiddenbrabant.nl/Bombardement_Sint_Josephstraat_-_Hoogvensestraat,_31_juli_1942"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/19538>;
    dcterms:created "2025-10-08T07:31:46.586Z"^^xsd:dateTime;
    skos:prefLabel "Bombardement op Sint Josephstraat Tilburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Het bombardement op de Sint Josephstraat in Tilburg vond plaats op 31 juli 1942. In de nacht van 30 op 31 juli 1942 werpt een Brits vliegtuig boven de binnenstad van Tilburg vier bommen uit. De eerste bom slaat in bij Sint Josephstraat 26 (later Prinsenhoeven) op de hoek met de Hoogvensestraat. De tweede slaat in op een binnenplaats achter Sint Josephstraat 24, op de andere hoek met de Hoogvensestraat. De derde bom slaat in voor Sint Josephstraat 24 en 22 en de vierde valt op Sint Josephstraat 29 (later Prinsenhoeven). Drie mensen raken zwaargewond, drie anderen komen om. Vijftien gezinnen moeten tijdelijk evacueren."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/21824> a <http://schema.org/Thing>, skos:Concept,
