    dcterms:created "2023-06-22T14:44:09.304Z"^^xsd:dateTime;
    skos:prefLabel "Fliegerhorst Plantlünne/Wesel"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Fliegerhorst Plantlünne/Wesel was een militair vliegveld dat vanaf 1935 in gebruik was als noodvliegveld. In 1940 werd het vliegveld door krijgsgevangenen uit de Sovjet-Unie in Duitsland uitgebreid. Op 10 april 1945 werd het vliegveld door de geallieerden veroverd. Vanaf dit vliegveld stegen de RAF bommenwerpers op die de schepen Cap Arcona en de Thielbeck tot zinken brachten.  Na de Tweede Wereldoorlog werd het vliegveld niet meer als zodanig gebruikt. "@nl;
    skos:altLabel "Militärflugplatz Plantlünne/Wesel"@nl, "Vliegveld Wesel"@nl, "Vliegveld Plantlünne/Wesel"@nl,
      "Vliegveld Plantlünne"@nl, "Fliegerhorst Plantlünne"@nl, "Militärflughafen Plantlünne Wesel"@nl,
