    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Bloedbad_van_Katyn&oldid=58916463"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
