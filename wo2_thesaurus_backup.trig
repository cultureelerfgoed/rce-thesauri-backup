    skos:prefLabel "Perhimpunan Indonesia"@nl, "'Perhimpunan Indonesia'"@de, "'Perhimpunan Indonesia'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Perhimpunan Indonesia (PI) werd in 1908 te Leiden opgericht als vereniging voor Indonesische studenten. Vanaf de jaren twintig kwam er een grotere nadruk op antikoloniale, antikapitalistische en communistische denkbeelden en wijdde de vereniging zich geheel aan de Indonesische nationalistische politiek. Tijdens de Duitse bezetting gaf de vereniging het illegale blad De Bevrijding uit, naast het bestaande verenigingsblad Indonesia."@nl;
    skos:altLabel "PI"@nl, "P.I."@nl, "Perhimpoenan Indonesia"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/8634>, <https://data.niod.nl/WO2_Thesaurus/8693>,
