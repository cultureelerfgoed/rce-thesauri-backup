    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1922>, <https://data.niod.nl/WO2_Thesaurus/2322>;
    dcterms:created "2022-01-06T09:31:06.906Z"^^xsd:dateTime;
    skos:prefLabel "Evacuatie van Noordwest-Veluwe"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Evacuatie van de Noordwest-Veluwe vond plaats op 10 mei 1940, na de Duitse inval in Nederland. Om de 24.000 inwoners van het gebied tussen Barneveld, Nijkerk en Hoevelaken te beschermen tegen de beschietingen die het Nederlandse leger zou uitvoeren om de Duitse opmars te vertragen, moesten zij allemaal vertrekken. Evacués werden opgevangen in Putten, Harderwijk en Ermelo. Op 15 mei 1940 konden de inwoners naar hun woningen terugkeren."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/9354> .
  
