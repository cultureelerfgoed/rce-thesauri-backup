""";
    <http://schema.org/startDate> "1939-07-16"^^xsd:date;
    dcterms:source "https://www.joodsamsterdam.nl/ss-dora/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/18602>;
    dcterms:created "2022-01-12T11:21:26.228Z"^^xsd:dateTime;
    skos:prefLabel "Vertrek SS Dora vanuit Amsterdam"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Op zondag 16 juli 1939 vertrok de Dora vanuit Amsterdam naar Palestina. Aan boord waren meer dan 300 Duits-Joodse vluchtelingen en zo'n 20 Nederlandse Joden. In Antwerpen en Vlissingen werden nog ruim 200 Duits-Joodse vluchtelingen opgehaald. Op 12 augustus 1939 konden de vluchtelingen bij Shefayim, een kibboets aan de kust van de Middellandse Zee, het schip verlaten."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/18606> a <http://schema.org/Thing>, skos:Concept,
