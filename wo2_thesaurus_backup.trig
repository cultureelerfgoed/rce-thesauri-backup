    <http://schema.org/name> "'s-Hertogenbosch";
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/6983>, <https://data.niod.nl/WO2_Thesaurus/events/6617>;
    dcterms:created "2018-10-31T10:38:05.000Z"^^xsd:dateTime;
    skos:prefLabel "Befreiung von 's-Hertogenbosch"@de, "Liberation of 's-Hertogenbosch"@en,
      "Bevrijding 's-Hertogenbosch"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De bevrijding van 's-Hertogenbosch vond plaats op 27 oktober 1944 door de 53ste divisie van het 2e Leger van de Britse strijdkrachten. De slag om 's-Hertogenbosch startte op 22 oktober. In de nacht van 23 op 24 oktober vielen er zo'n 50.000 granaten op de stad. Vanaf 25 oktober konden de Britten de binnenstad gaan veroveren dankzij de aanleg van een nieuw bruggenhoofd."@nl;
    skos:altLabel "Bevrijding van Den Bosch"@nl .
  
