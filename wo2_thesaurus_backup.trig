    <http://schema.org/endDate> "1943-01-28"^^xsd:date;
    dcterms:source "https://www.japansekrijgsgevangenkampen.nl/Tacoma%20Maru%202.htm"@nl;
    <https://data.niod.nl/eventsWO2/toLocation> <https://data.niod.nl/WO2_Thesaurus/locations/17200>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/5831>, <https://data.niod.nl/WO2_Thesaurus/events/19018>;
    dcterms:created "2024-02-07T09:59:25.810Z"^^xsd:dateTime;
    skos:prefLabel "Transport Tacoma Maru 2, 25-01-19 - 28-01-1943"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Het Transport Tacoma Maru 2 vond plaats tussen 25 januari 1943 en 28 januari 1943. Het Japans helleschip Tacoma Maru 2 transporteerde 2000 Nederlandse krijgsgevangenen van Tandjong Priok naar Singapore. Het was het tiende krijgsgevangenentransport richting de Birma-Siamspoorweg en wordt daarom ook aangeduid als Java Party 10. "@nl;
    skos:altLabel "Java Party 10"@en .
  
  <https://data.niod.nl/WO2_Thesaurus/events/21110> a <http://schema.org/Thing>, skos:Concept,
