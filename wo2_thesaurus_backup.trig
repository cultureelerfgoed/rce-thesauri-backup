    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/wo2nedindieThema> "Japans bestuur";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/250x250/e5047315-610b-60b7-bb1e-928c227db2ab.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/00ebec54-025b-11e7-904b-d89d6717b464/media/e5047315-610b-60b7-bb1e-928c227db2ab";
    <http://schema.org/location> "Java";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://www.nationaalarchief.nl/onderzoeken/fotocollectie/1e426c5f-4128-49b6-1964-f6685147df2d>,
      <https://beeldbankwo2.nl/nl/beelden/detail/00ed7b82-025b-11e7-904b-d89d6717b464/media/92eecd13-b388-ef0b-f261-29c150a73fa2>;
    <http://schema.org/startDate> "1943-04-29"^^xsd:date;
    <http://schema.org/description> "Op Java worden de Keibodan en de Seinendan opgericht. Bij de Keibodan dienen Javaanse jongeren van 23 tot 35 jaar als hulppolitieagenten. Bij de Seinendan dienen jongeren van 14 tot 23 jaar bij de luchtbescherming. Beide organisaties zijn ongewapende hulpkorpsen waartoe honderdduizenden Javaanse vrijwilligers toetreden. De oprichting van de semi-militaire hulpkorpsen is een onderdeel van de mobilisatie van de bevolking."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/8185>, <https://data.niod.nl/WO2_Thesaurus/corporaties/7792>;
    dcterms:created "2019-04-03T12:49:30.000Z"^^xsd:dateTime;
    skos:prefLabel "Oprichting Keibodan en Seinendan"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Oprichting Keibodan en Seinendan vindt plaats op 29 april 1943 te Java. Bij de Keibodan dienen Javaanse jongeren van 23 tot 35 jaar als hulppolitieagenten. Bij de Seinendan dienen jongeren van 14 tot 23 jaar bij de luchtbescherming."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8273> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:36:05.620Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8145>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/wo2nedindieThema> "Dagelijks leven";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/nda/thumb/250x250/852827a6-cbe4-7b17-d2a2-3d8944d4b914.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nimh-beeldbank.defensie.nl/memorix/3a34fbba-eb18-11df-a391-13966e870614";
    <http://schema.org/location> "Java";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/fdf38124-025a-11e7-904b-d89d6717b464/media/2996b118-27e5-a1e1-3919-73ca6ac16c12>,
      <https://www.geheugenvannederland.nl/nl/geheugen/view?coll=ngvn&identifier=NFA02%3Acas-10321-10>,
      <https://beeldbankwo2.nl/nl/beelden/detail/fd107696-0259-11e7-904b-d89d6717b464/media/40b7a108-db46-6be1-e7b8-75425e21ffad>;
    <http://schema.org/startDate> "1943-10-19"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Romoesja&oldid=52945412"@nl;
    <http://schema.org/description> "Op Java wordt door het Japanse militaire bestuur een organisatie opgericht om op grote schaal inheemse arbeiders te werven: de Badan Pembantoe Peradjoerit Pekerdja. Soekarno zet zich actief in om zijn landgenoten over te halen zich aan te sluiten. De arbeidskrachten, die worden ingezet ten behoeve van de Japanse oorlogseconomie, zijn vooral bekend geworden onder hun Japanse naam romusha. De meerderheid wordt tewerkgesteld op Java. De werving vindt vaak plaats onder dwang, de werkomstandigheden zijn zwaar en door ziekte, ondervoeding en mishandeling komen grote aantallen Javanen om het leven. Vanaf 1944 worden naar schatting 160.000 tot 200.000 Javaanse romusha’s overzee ingezet. Onder andere bij de aanleg van de Pakan Baroe-spoorlijn en de Birma-spoorlijn.  "@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/7727>, <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2019-04-03T13:15:12.000Z"^^xsd:dateTime;
    skos:prefLabel "Oprichting Badan Pembantu Perajurit Pekerja"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Oprichting Badan Pembantu Perajurit Pekerja vindt op 19 oktober 1943 plaats te Java door het Japanse militaire bestuur. Het is een organisatie opgericht om op grote schaal inheemse arbeiders te werven. De arbeidskrachten, die worden ingezet ten behoeve van de Japanse oorlogseconomie, zijn vooral bekend geworden onder hun Japanse naam romusha."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8274> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:17:02.453Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8145>,
      <https://data.niod.nl/WO2_Thesaurus/locations/8028>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/wo2nedindieThema> "Japans bestuur";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/250x250/a9caf6db-828d-433e-efb6-55d91e35f7f7.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/09c7f88c-025a-11e7-904b-d89d6717b464/media/a9caf6db-828d-433e-efb6-55d91e35f7f7";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://nimh-beeldbank.defensie.nl/foto-s/60fe0858-0c44-c1db-1dd6-f08ef82afc53>,
      <https://beeldbankwo2.nl/nl/beelden/detail/f6bfdfc0-0259-11e7-904b-d89d6717b464/media/0a4ceb6a-06ea-89e9-64a0-8429f299b273>;
    <http://schema.org/startDate> "1943-04-16"^^xsd:date;
    <http://schema.org/description> "Poetera (Poesat Tenaga Rakjat – Centraal Volks Vermogen) is de opvolger van de Tiga A-beweging en wordt geleid door de vier nationalisten Soekarno, M. Hatta, K.H. Dewantoro en H.M. Mansoer. De beweging heeft tot doel ‘een krachtig nieuw Java te scheppen als schakel in de Groot Oostaziatische Gemeenschappelijke Welvaartssfeer, door Groot-Japan te helpen bij het bereiken van de overwinning in de Groot-Oostaziatische Oorlog’. Soekarno’s eis om ‘Indonesia’ in de naam van de beweging op te nemen, de rood-witte vlag te voeren en het ‘Indonesia Raya’ te mogen zingen, wordt door de Japanners afgewezen. Poetera biedt Soekarno een podium om de bevolking van Java te bereiken. Poetera wordt op 7 januari 1944 opgeheven."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/7761>, <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2019-04-03T13:31:24.000Z"^^xsd:dateTime;
    skos:prefLabel "Oprichting van PUTERA"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Oprichting van Poetera (Poesat Tenaga Rakjat – Centraal Volks Vermogen) als opvolger van de Tiga A-beweging was op 16 april 1943. Poetera wordt geleid door de vier nationalisten Soekarno, M. Hatta, K.H. Dewantoro en H.M. Mansoer. De beweging heeft tot doel ‘een krachtig nieuw Java te scheppen als schakel in de Groot Oostaziatische Gemeenschappelijke Welvaartssfeer, door Groot-Japan te helpen bij het bereiken van de overwinning in de Groot-Oostaziatische Oorlog’."@nl;
    skos:altLabel "Oprichting van Poetera"@nl .
  
