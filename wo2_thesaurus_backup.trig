    dcterms:source "https://drenthe.75jaarvrijheid.nl/1941/2429250/vergeten-bombardementen-in-assen-doden-vijftien-mensen"@nl,
      "http://www.drentheindeoorlog.nl/?aid=360"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/19538>;
    dcterms:created "2021-03-17T09:58:38.338Z"^^xsd:dateTime;
    skos:prefLabel "Bombardement op Assen, 3 januari 1941"@nl, "Bombardierung von Assen, 3. Januar 1941"@de,
      "Bombing of Assen, January 3, 1941"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 3 januari 1941 vielen er vijf brisantbommen in de Eschstraat in Assen waarbij zeven mensen om het leven kwamen. Engelse vliegtuigen kwamen terug van missies boven Duitsland en mochten niet met scherp gestelde bommen terugvliegen naar Engeland. Meestal lieten ze die dan op een spoorweglijn vallen om het transport van de Duitsers te ontregelen, maar dit ging geregeld mis."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
