    skos:prefLabel "Liquidatie van Geertje van Enk"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De liquidatie van Geertje van Enk vond plaats op 15 februari 1945 in Den Haag. Van Enk was lid van de NSB. Ze werd samen met haar man in haar woning doodgeschoten."@nl .
  
