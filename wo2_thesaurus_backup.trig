  <https://data.niod.nl/WO2_Thesaurus/corporaties/8576> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "L. de Jong, Het Koninkrijk der Nederlanden in de Tweede Wereldoorlog. Deel 5, Maart '41-Juli '42 ('s-Gravenhage : Martinus Nijhoff, 1974)"@nl,
      "et Volk, 15 november 1940, avondblad, Het Dagblad van Rotterdam, 28 december 1943"@nl,
      "E. Fraenkel-Verkade (red.), Correspondentie van mr. M.M. Rost van Tonningen. Deel 1 1921-mei 1942 (Den Haag 1967) "@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2024-08-12T12:03:08.870Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1940-10-11"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://resolver.kb.nl/resolve?urn=urn:gvn:EVDO02:NIOD05_0389&size=large";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://resolver.kb.nl/resolve?urn=urn:gvn:EVDO02:NIOD05_0389";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://resolver.kb.nl/resolve?urn=KBNRC01:000052444:mpeg21:pdf>,
      <http://www.haagsebeeldbank.nl/afbeelding/104a7241-a15b-4420-b686-41cf63e2a56e>;
    <https://data.niod.nl/organizationsWO2/endDate> "1943-12-23"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Organisatiecommissie voor het Bedrijfsleven, ook wel de Commissie Woltersom genoemd, was de in oktober 1940 ingestelde commissie die het Nederlandse bedrijfsleven naar nationaalsocialistisch model moest omvormen. In de commissie waren verschillende bedrijfstakken vertegenwoordigd, zoals de industrie, handel, ambacht, het verkeerswezen, bankwezen en verzekeringswezen. De voorzitter was Herman Louis Woltersom. Op 23 december 1943 werd de commissie opgeheven."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2958>, <https://data.niod.nl/WO2_Thesaurus/3593>,
      <https://data.niod.nl/WO2_Thesaurus/20645>;
    dcterms:created "2019-09-04T19:27:04.000Z"^^xsd:dateTime;
    skos:prefLabel "Organisatiecommissie voor het Bedrijfsleven"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Organisatiecommissie voor het Bedrijfsleven (Commissie Woltersom) werd in oktober 1940 ingesteld. De commissie, onder voorzitterschap van de Rotterdamse bankier dr. H.L. Woltersom, had tot taak het invoeren van een geleide economie en binnen het bedrijfsleven het leidersbeginsel. Alle bestaande organisaties van het bedrijfsleven waren in de commissie vertegenwoordigd, die onder auspiciën van Generalkommissariat für Finanz und Wirtschaft dr. H. Fischböck functioneerde. Ondanks het feit dat drie commissieleden NSB’ers waren, beschouwden veel aanhangers van de Nieuwe Orde, onder wie secretaris-generaal voor Bijzondere Economische Zaken Rost van Tonningen, de Commissie Woltersom als een club reactionairen die vasthield aan liberaal-kapitalistische beginselen. De moeizaam functionerende commissie werd op 23 december 1943 opgeheven door secretaris-generaal H. Hirschfeld van het departement van Handel, Nijverheid en Scheepvaart. "@nl;
    skos:altLabel "Commissie Woltersom"@nl, "Organisatie Woltersom"@nl, "Organisatie-Woltersom"@nl,
      "Reorganisatiecommissie Woltersom"@nl, "Organisatie-Commissie voor het Bedrijfsleven"@nl,
      "Kommission Woltersom"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
