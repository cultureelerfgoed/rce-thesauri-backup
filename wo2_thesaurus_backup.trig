    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/3d225a00-e095-3856-3a89-f32d28bdbae5.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/44e35cfe-025a-11e7-904b-d89d6717b464/media/3d225a00-e095-3856-3a89-f32d28bdbae5";
    dcterms:source "https://vma-apw.adlibhosting.com/AIS/Details/collect/4487"@nl, "https://nl.wikipedia.org/w/index.php?title=Huize_Lydia&oldid=68777940"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4673>;
    dcterms:created "2026-09-21T10:30:35.791Z"^^xsd:dateTime;
    skos:prefLabel "Huize Lydia"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Huize Lydia aan het Roelof Hartplein in Amsterdam was een Katholiek tehuis voor ongetrouwde vrouwen. Tijdens de Tweede Wereldoorlog namen de Wehrmacht en de Sicherheitsdienst (SD) hun intrek in het gebouw. Zo werden er ongeveer honderd Duitse administratief medewerksters, zogenaamde Funkmädel, ondergebracht en fungeerde het als gaarkeuken voor de in Amsterdam gelegerde SD’ers. Na de bevrijding nam de Binnenlandse Strijdkrachten en het Canadese leger het gebouw in gebruik. Vanaf oktober 1945 werd het een opvanglocatie voor terugkerende dwangarbeiders en concentratiekampgevangenen."@nl;
    skos:altLabel "Huis Lydia"@nl, "Buurthuis Lydia"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
