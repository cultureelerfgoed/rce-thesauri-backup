    dcterms:created "2022-08-04T13:56:59.120Z"^^xsd:dateTime;
    skos:prefLabel "Executie in Rotterdam, Kralingseweg, 27 september 1944"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 27 september 1944 vond op de schietbaan aan de Kralingseweg te Rotterdam de executie plaats van Pieter van der Pligt, Pieter Kraaijeveld en Johannes Bernardus Dierijck. Zij werden verdacht van terroristische activiteit, roofovervallen en het zich uitgeven als ambtenaar van de Sicherheitsdienst. "@nl .
  
