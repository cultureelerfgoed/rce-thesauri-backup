    skos:prefLabel "MAIBKATRA"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De MAIBKATRA bestond van maart 1943 tot het eind van de Japanse bezetting van Nederlands-Indië en werd opgericht door de bezetter. Het doel van de raad was het controleren van politiek actieve moslims. In naam was het een organisatie die opkwam voor de islamitische zaak en de bezetter had invloedrijke Ulama's op de belangrijkste posten gezet. "@nl;
    skos:altLabel "Madjelis Agama Islam untuk Bantuan Kemakmuran Asia Timur Raya"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7830> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "B. Kromhout, De Voorman. Henk Feldmeijer en de Nederlandse SS (Amsterdam/Antwerpen 2012)"@nl,
      "N.K.C.A. in ’t Veld, De SS en Nederland. Documenten uit SS-archieven 1935-1945. Deel 1 (Den Haag 1976)"@nl,
      "E. van Roekel, Jongens van Nederland. Nederlandsche vrijwilligers in de Waffen-SS (Houten/Antwerpen 2011)"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-08-18T14:13:30.471Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1940-05-26"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/b9407548-a698-07da-6bd7-b77d80552b33.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/33749c6c-025a-11e7-904b-d89d6717b464/media/b9407548-a698-07da-6bd7-b77d80552b33"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/96bbe834-025a-11e7-904b-d89d6717b464/media/d36f6e07-aa9d-2f3b-5049-ffb385724850>,
      <https://beeldbankwo2.nl/nl/beelden/detail/3373a6d6-025a-11e7-904b-d89d6717b464/media/a64976ab-43e4-bb12-15f2-7434d80d961b>,
      <https://beeldbankwo2.nl/nl/beelden/detail/337a0f80-025a-11e7-904b-d89d6717b464/media/3e6375a6-6ff9-1ae4-ed39-6f0d1fda52b9>;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-08"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De SS-Standarte Westland was een onderdeel van de Waffen-SS, het legeronderdeel van de Schutzstaffel (SS). De SS-Standarte Westland werd in 1940 opgericht en streed vanaf juni 1941 aan het Oostfront. De SS-Standarte Westland bestond voornamelijk uit Nederlandse en Vlaamse vrijwilligers. In december 1940 ging de eenheid op in de SS-Panzer-Division Germania en in januari 1941 in SS-Panzer-Division Wiking. Nederlanders die bij de Waffen-SS gingen, verloren na de oorlog hun Nederlandse nationaliteit."@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/events/7836>, <https://data.niod.nl/WO2_Thesaurus/events/7831>,
      <https://data.niod.nl/WO2_Thesaurus/events/7834>, <https://data.niod.nl/WO2_Thesaurus/events/7833>,
      <https://data.niod.nl/WO2_Thesaurus/9440>, <https://data.niod.nl/WO2_Thesaurus/events/7837>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4717>, <https://data.niod.nl/WO2_Thesaurus/1613>,
      <https://data.niod.nl/WO2_Thesaurus/20640>;
    dcterms:created "2019-02-13T07:59:11.000Z"^^xsd:dateTime;
    skos:prefLabel "SS-Standarte Westland"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De SS-Standarte Westland werd naar een bevel van Hitler op 26 mei 1940 speciaal opgericht voor Nederlandse en Vlaamse vrijwilligers. Gezien het destijds voor nazi-Duitsland gunstige verloop van de oorlog was het niet waarschijnlijk dat deze eenheid nog op het slagveld zou worden ingezet. Himmler wilde het regiment vooral gebruiken om jonge Nederlanders en Vlamingen te doordringen van de Groot-Germaanse SS-ideologie. Om deze reden verleende NSB-leider Mussert nauwelijks steun aan de werving voor de SS-Standarte Westland. Vanaf november 1940 maakte het regiment deel uit van de nieuw opgerichte Waffen-SS-divisie Germania (een maand later werd hernoemd tot Wiking) die vanaf juni 1941 tot het eind van de oorlog vrijwel onafgebroken werd ingezet."@nl;
    skos:altLabel "Standarte Westland"@nl, "Westland"@nl, "S.S.-Standarte Westland"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/7835>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4495>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
