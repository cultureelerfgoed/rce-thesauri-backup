    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Ethische_politiek&oldid=52655964"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/8385>;
    dcterms:created "2019-04-24T13:46:15.000Z"^^xsd:dateTime;
    skos:prefLabel "Start Ethische politiek Nederland-Indië"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Start Ethische politiek is van kracht vanaf 17 september 1901. De term Ethische politiek geeft aan dat het Nederlands koloniale beleid er meer op is gericht de belangen van de Indonesische bevolking te behartigen."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8403> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2020-12-08T13:23:27.309Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8145>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/wo2nedindieThema> "Indonesisch nationalisme";
    <http://schema.org/startDate> "1908-05-20"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Boedi_Oetomo&oldid=53498742"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/8385>;
    dcterms:created "2019-04-24T13:50:45.000Z"^^xsd:dateTime;
    skos:prefLabel "Oprichting Vereniging Boedi Oetomo"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Oprichting Vereniging Boedi Oetomo (‘Het schoone streven’) vindt plaats op 20 mei 1908 en de vereniging heeft tot doel om de toegang tot westers onderwijs voor Javanen te verbeteren. Vrijwel alle leerlingen van middelbare scholen op Java sluiten zich bij de vereniging aan. Boedi Oetomo is daarmee de eerste Indonesische emancipatiebeweging."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8404> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2020-12-08T13:25:29.848Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/wo2nedindieThema> "Indonesisch nationalisme";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/7/7c/COLLECTIE_TROPENMUSEUM_Groepsportret_tijdens_een_ledenvergadering_van_de_Sarekat_Islam_%28SI%29_in_Kaliwoengoe_TMnr_60009089.jpg/250px-COLLECTIE_TROPENMUSEUM_Groepsportret_tijdens_een_ledenvergadering_van_de_Sarekat_Islam_%28SI%29_in_Kaliwoengoe_TMnr_60009089.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/wiki/File:COLLECTIE_TROPENMUSEUM_Groepsportret_tijdens_een_ledenvergadering_van_de_Sarekat_Islam_(SI)_in_Kaliwoengoe_TMnr_60009089.jpg";
    <http://schema.org/startDate> "1912-10-10"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Sarekat_Islam&oldid=51540949"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/8385>;
    dcterms:created "2019-04-24T13:58:53.000Z"^^xsd:dateTime;
    skos:prefLabel "Oprichting Sarekat Islam"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Oprichting Sarekat Islam (Islamitische Vereniging) vindt plaats op 10 oktober 1912 door Raden Oemar Saïd Tjokroaminoto. Het ledenaantal groeit explosief, in 1916 telt de vereniging 16.000 leden. De Sarekat Islam is een volksvereniging met leden in heel Nederlands-Indië. Aanvankelijk was het hoofddoel het bevorderen van de materiële vooruitgang van de leden, maar al gauw werd de S.I. een politieke vereniging."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8405> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2020-12-08T13:24:59.777Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/wo2nedindieThema> "Indonesisch nationalisme";
    <http://schema.org/startDate> "1912-09-06"^^xsd:date;
    dcterms:source "http://resources.huygens.knaw.nl/bwn/BWN/lemmata/bwn5/douwes_de"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/8385>;
    dcterms:created "2019-04-24T14:05:31.000Z"^^xsd:dateTime;
    skos:prefLabel "Oprichting Indische Partij"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Oprichting Indische Partij vindt plaats op 6 spetember 1912 door E.F.E. Douwes Dekker samen met Soewardi Soerjaningrat en Tjipto Mangoenkoesomo. De Indische partij is de eerste partij die streeft naar een onafhankelijke staat. In die staat moeten alle etnische groepen in de archipel een plaats krijgen. De Indische Partij wordt in 1913 door het gouvernement verboden."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8406> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
