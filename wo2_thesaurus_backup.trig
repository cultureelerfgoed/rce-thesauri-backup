    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://service.archief.nl/gaf/api/file/v1/img/66b99c0b-803e-4b96-9998-93db786416e5?h=1000";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://www.nationaalarchief.nl/onderzoeken/fotocollectie/acd50b9c-d0b4-102d-bcf8-003048976d84";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <http://opac-gonext.oclc.org:8180/xslt/DB=8/XMLPRS=Y/PPN?PPN=822228092>,
      <https://www.nationaalarchief.nl/onderzoeken/fotocollectie/abd9999c-d0b4-102d-bcf8-003048976d84>;
    <http://schema.org/startDate> "1962-04-06"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Nieuw-Guinea_Raad&oldid=53631694"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/8386>;
    dcterms:created "2019-04-24T14:40:28.000Z"^^xsd:dateTime;
    skos:prefLabel "Installatie Nieuw-Guinea Raad"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Installatie Nieuw-Guinea Raad vindt plaats op 6 april 1962 te Hollandia. De raad heeft 28 leden: 21 Papoea’s, zes Nederlanders en een Keiees. Zestien leden zijn gekozen door de bevolking en twaalf benoemd door gouverneur Platteel. De verkiezingen zijn een eerste stap op weg naar zelfbeschikking door de Papoea’s."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8411> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2019-04-24T14:49:29.000Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8028>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/wo2nedindieThema> "Nederlands-Indisch bestuur";
    <http://schema.org/startDate> "1962-10-01"^^xsd:date;
    dcterms:source "https://www.openimages.eu/media/17560/Nieuws_uit_Nieuw_Guinea_afscheid_van_gouverneur_Plateel.nl"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/8386>;
    dcterms:created "2019-04-24T14:46:32.000Z"^^xsd:dateTime;
    skos:prefLabel "Overdracht Nieuw-Guinea door Nederland"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Overdracht Nieuw-Guinea vindt plaats door Nederland aan de Tijdelijk Uitvoerend Gezagsorgaan van de VN (UNTEA: United Nations Temporary Executive Authority) op 1 oktober 1962. Dit orgaan neemt het gezag over. UNTEA is verantwoordelijk voor de handhaving van wet en orde in Westelijk Nieuw-Guinea/West-Irian, de bescherming van de rechten van de inwoners en voorlichting aan de bevolking over de nieuwe situatie."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8412> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2019-04-24T14:53:27.000Z"^^xsd:dateTime;
