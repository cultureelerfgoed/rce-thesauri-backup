    <http://schema.org/startDate> "1918-05-18"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Volksraad_(Nederlands-Indi%C3%AB)&oldid=49553640"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/8385>, <https://data.niod.nl/WO2_Thesaurus/corporaties/7768>;
    dcterms:created "2019-04-24T14:11:59.000Z"^^xsd:dateTime;
    skos:prefLabel "Installatie Volksraad "@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Installatie Volksraad wordt officieel verricht door gouverneur-generaal Van Limburg Stirum door de opening van de eerste zitting op 18 mei 1918. De Volksraad, die 60 leden heeft en de gehele bevolking van Nederlands-Indië vertegenwoordigt, had alleen adviserende bevoegdheden."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8407> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
