    skos:prefLabel "Airstrip Barneveld"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "Airstrip Barneveld werd tegenover boerderij De Gelkenhorst door de Canadezen aangelegd. Het kleine tijdelijke vliegveld was vanaf 17 april 1945 enkele weken in gebruik en vooral bedoeld voor lichte en onbewapende verkenningsvliegtuigen."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/locations/8054> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "52.132497"^^xsd:float;
