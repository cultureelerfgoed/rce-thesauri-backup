    dcterms:created "2022-02-21T12:45:48.596Z"^^xsd:dateTime;
    skos:prefLabel "Portugees Israëlitisch Ziekenhuis Amsterdam"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het Portugees Israëlitisch Ziekenhuis was een Joods ziekenhuis in Amsterdam. Het ziekenhuis werd geopend in 1916 en had plaats voor ongeveer 50 patiënten. Van mei 1943 tot de zomer van 1944 werden Joodse mannen getrouwd met een niet-Joodse vrouw hier gedwongen gesteriliseerd. Halverwege 1943 werd een groot deel van de patiënten en medewerkers gedeporteerd. "@nl .
  
