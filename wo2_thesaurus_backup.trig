    skos:prefLabel "Districts-Commandeur"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De rang districts-commandeur behoorde tot de hoogste rangen in de Nederlandsche Landwacht. De districts-commandeur (provinciaal commandeur) was verantwoordelijk voor de Nederlandsche Landwacht in zijn provincie. Hiernaast was er voor de drie grote steden een districts-commandeur (stedelijk commandeur) aangesteld. Van de veertien districts-commandeurs behoorde er zeven tot de WA en zeven tot de Nederlandse SS."@nl;
    skos:altLabel "Provinciaal-Commandeur"@nl, "Districts Commandeur"@nl, "Provinciaal Commandeur"@nl,
      "Stedelijk Commandeur"@nl, "Stedelijk-Commandeur"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2249> .
  
