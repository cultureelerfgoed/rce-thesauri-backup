    skos:prefLabel "'Afweerdienst'"@de, "'Afweerdienst'"@en, "Afweerdienst"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Afweerdienst, opgericht in 1935, was een onderdeel van de NSB waaraan de leden van de NSB moesten rapporteren over de maatschappelijke problemen die zij ondervonden vanwege hun NSB-lidmaatschap. Hoofd van de Afweerdienst was W. van der Goes van Naters."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/4438> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "N.J.G. Sikkel (red.), Documentatie. Samengesteld ten behoeve van de Bijzondere Rechtspleging, op last van de Procureur-Fiscaal bij het Bijzonder Gerechtshof te Amsterdam (Amsterdam 1947) "@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2024-12-05T10:30:04.795Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1940-11-11"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/582b83d4-65c9-cb6d-2348-9cea43fc4330.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/5a1e0ec0-025a-11e7-904b-d89d6717b464/media/582b83d4-65c9-cb6d-2348-9cea43fc4330";
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-06"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Het Nederlandsch Agrarisch Front (NAF) was de landbouworganisatie van de Nationaal-Socialistische Beweging (NSB). De NAF probeerde boeren onder nationaalsocialistische controle te brengen. De NAF ontstond door het samengaan van de Boerenbond Landbouw en Maatschappij en het Boerenfront van de NSB."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4608>, <https://data.niod.nl/WO2_Thesaurus/2244>;
    dcterms:created "2016-10-04T13:07:38.000Z"^^xsd:dateTime;
    skos:prefLabel "Nederlandsch Agrarisch Front"@nl, "Nederlandsch Agrarisch Front"@de,
      "'Nederlands Agrarisch Front'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Nederlandsch Agrarisch Front ontstond op 11 november 1940 uit een fusie van de organisatie Landbouw en Maatschappij met het Boerenfront van NSB. Het Agrarisch Front was een mantelorganisatie van de NSB. Het Agrarisch Front behoorde op 19 maart 1941 tot de landbouworganisaties die overkoepeld werden door de Commissie Posthuma (eerste Productie-slag 1941). Binnen deze overkoepeling had het Agrarisch Front de leiding en het vormde de organisatorische kern van de op 24 oktober 1941 door Seyss-Inquart ingestelde Nederlandse Landstand."@nl;
    skos:altLabel "Nederlands Agrarisch Front"@nl, "Agrarisch Front"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Organization> .
  
