    skos:prefLabel "Onderduikhol Speulderbos"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "Het Onderduikhol in het Speulderbos bij het buurtschap Drie in de gemeente Ermelo werd tussen februari 1943 en juli 1944 gebruikt door Engelse piloten en voortvluchtige landgenoten. In juli 1944 werd de plek door de Duitsers ontdekt. Op dat moment woonden er 13 mannen, maar zij konden via de vluchtgang veilig ontsnappen."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2695>, <https://data.niod.nl/WO2_Thesaurus/2698> .
  
