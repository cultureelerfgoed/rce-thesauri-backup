    skos:prefLabel "Jüdische Unterstützungsstelle"@nl, "Jüdische Unterstützungsstelle"@de,
      "'Jüdische Unterstützungsstelle'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Jüdische Unterstützungsstelle was een speciaal door de Rijkscommissaris in het leven geroepen bureau dat financiële bijstand bood aan de werkloze Joodse partners uit een gemengd huwelijk. Eén van de groepen Joden die (tijdelijk) gevrijwaard bleef van vervolging was die der gemengd gehuwden. Voor deze groep hanteerde de Duitse bezetter een ingewikkeld beleid van vrijstellingen. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization>;
    skos:hiddenLabel "Judische Unterstutzungsstelle"@nl, "Juedische Unterstuetzungsstelle"@nl .
  
