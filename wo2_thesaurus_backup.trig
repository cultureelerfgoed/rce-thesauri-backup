    <http://schema.org/location> "Doetinchem";
    <http://schema.org/startDate> "1940-05-10"^^xsd:date;
    dcterms:source "https://mijngelderland.nl/inhoud/routes/beleef-doetinchem/doetinchem-in-de-tweede-wereldoorlog"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/7865>;
    dcterms:created "2019-03-13T11:44:43.000Z"^^xsd:dateTime;
    skos:prefLabel "Opblazen Oude IJsselbrug Doetinchem"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Het Opblazen van de Oude IJsselbrug te Doetinchem vond plaats op 10 mei 1940. Het doel van de Nederlandse strijdkrachten was om de Duitse opmars te vertragen, waarin zij geen succes hadden omdat de Wehrmacht andere bruggen had gekozen om Doetinchem in te trekken. Bij het opblazen van de brug kwam kapitein Van Voltelen om het leven (vermoedelijk was hij de eerste Nederlandse officier die door oorlogshandelingen om het leven kwam). "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8074> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    dcterms:modified "2023-06-13T09:40:13.121Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/9632>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/mediabank-horizontal/3e18babe-515b-2989-6020-2ea072f26f5d.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/f6cb8964-025a-11e7-904b-d89d6717b464/media/undefined"@nl;
    <http://schema.org/startDate> "1945-03-19"^^xsd:date;
    <http://schema.org/endDate> "1945-03-23"^^xsd:date;
    dcterms:source "https://spannendegeschiedenis.nl/liberation-route/doetinchem-bombardement"@nl,
      "https://mijngelderland.nl/inhoud/canons/doetinchem/drie-bombardementen-in-maart-1945 "@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/19538>;
    dcterms:created "2019-03-13T12:10:21.000Z"^^xsd:dateTime;
    skos:prefLabel "Bombardement op Doetinchem"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Het bombardement op Doetinchem vond plaats op 19, 21 en 23 maart 1945 en werd uitgevoerd door de geallieerde luchtmacht. Het historische stadscentrum werd onherstelbaar beschadigd en het stadhuis, de synagoge en de Catherinakerk gingen in vlammen op. In totaal werden 120 gebouwen verwoest en vielen er 143 doden en honderden gewonden."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
