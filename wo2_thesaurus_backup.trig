    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2376>;
    dcterms:created "2020-08-06T14:12:44.000Z"^^xsd:dateTime;
    skos:prefLabel "Teroenga"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "Teroenga was een Joods tijdschrift, dat in 1939 werd opgericht in Suriname. Tijdens de Tweede Wereldoorlog diende het maandblad als informatiebron voor de Joods-Surinaamse bevolking."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/9199> a <http://schema.org/Thing>, skos:Concept,
