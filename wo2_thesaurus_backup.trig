    skos:relatedMatch <https://data.niod.nl/WO2_Thesaurus/13020>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/18510>;
    dcterms:created "2021-12-23T11:15:28.625Z"^^xsd:dateTime;
    skos:prefLabel "Ontruiming kibboets Elden"@nl, "Räumung Kibbuz Elden"@de, "Eviction Kibbutz Elden"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Op 3 oktober 1942 werd de kibboets in Elden ontruimd. De ruim 40 bewoners werden door de SS en politie weggevoerd en via Kamp Westerbork naar Bergen-Belsen gedeporteerd. Enkelen overleefden de oorlog omdat ze vanuit Bergen-Belsen door de Duitsers werden uitgewisseld met Duitse krijgsgevangenen en naar Palestina gingen. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
