    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Operatie_Black_Tulip&oldid=50270869"@nl;
    <https://data.niod.nl/organizationsWO2/isCausedBy> <https://digitaalerfgoed.poolparty.biz/westerbork/1247>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1561>, <https://data.niod.nl/WO2_Thesaurus/2583>;
    dcterms:created "2018-01-18T19:41:06.000Z"^^xsd:dateTime;
    skos:prefLabel "Operatie Black Tulip"@nl, "Unternehmen 'Black Tulip'"@de, "Operation Black Tulip"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote """Operatie Black Tulip is de benaming voor het beleid van de Nederlands regering na de Tweede Wereldoorlog om in Nederland wonende Duitsers het land uit te zetten. De operatie werd op 11 september 1946 in gang gezet door minister van Justitie Hans Kolfschoten. Personen met de Duitse nationaliteit (waaronder mensen die al zeer lange tijd in Nederland woonden) werden gedetineerd in kampen bij de Duitse grens, met name in Kamp Mariënbosch bij Nijmegen. In totaal zijn 3691 personen met de Duitse nationaliteit in de periode 1946-1950 uit Nederland gedeporteerd.
        """@nl;
    skos:altLabel "Black Tulip"@nl .
  
