    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/4/40/Lageplan_Au%C3%9Fenlager_KZ_-_Dachau_in_Haunstetten.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/w/index.php?title=File:Lageplan_Au%C3%9Fenlager_KZ_-_Dachau_in_Haunstetten.jpg&oldid=481221901";
    dcterms:source "https://de.wikipedia.org/w/index.php?title=KZ-Au%C3%9Fenlager_Haunstetten&oldid=226883233"@de,
      "http://www.tenhumbergreinhard.de/1933-1945-lager-1/1933-1945-lager-a/haunstetten.html"@de;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/4319>, <https://data.niod.nl/WO2_Thesaurus/1670>;
    dcterms:created "2023-07-12T11:43:36.397Z"^^xsd:dateTime;
    skos:prefLabel "Haunstetten "@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Kamp Haunstetten was een buitenkamp of Aussenlager van kamp Dachau in de Duitse plaats Haunstetten nabij Augsburg. Haunstetten functioneerde van 9 februari 1943 tot 13 april 1944. Het kamp bevond zich op een grindgroeve waar krijgsgevangenen 22 barakken bij moesten bouwen. Hierin zaten 2700 krijgsgevangenen en dwangarbeiders gevangen die in de nabijgelegen Maschinenfabrik Augsburg-Nürnberg (MAN) en Messerschmitt AG fabrieken werden tewerkgesteld voor de Duitse oorlogsindustrie. Na een geallieerd bombardement op 13 april 1944 werden de gevangenen naar Kamp Gablingen en Kamp Augsburg-Pfersee getransporteerd en werd Haunstetten verlaten. Ongeveer 400 gevangenen zijn in het kamp omgekomen, sommigen daarvan tijdens geallieerde bombardementen.  "@nl;
    skos:altLabel "Kamp Haunstetten "@nl, "KZ-Außenlager Haunstetten"@nl, "Aussenlager Haunstetten"@nl,
      "Buitenkamp Haunstetten"@nl, "Werkkamp Haunstetten"@nl, "Augsburg-Haunstetten"@nl .
  
