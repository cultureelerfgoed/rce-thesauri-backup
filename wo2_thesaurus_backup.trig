    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1922>, <https://data.niod.nl/WO2_Thesaurus/2322>;
    dcterms:created "2022-01-06T09:54:57.216Z"^^xsd:dateTime;
    skos:prefLabel "Evacuatie van Culemborg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Evacuatie van Culemborg vond plaats op 14 mei 1940. Vlakbij Culemborg werd hard gevochten. Uit angst dat Culemborg in de frontlinie kwam te liggen, werden de ongeveer 9.000 inwoners van Culemborg geëvacueerd naar Beusichem en Zoelmond. Na de capitulatie op 15 mei 1940 keerden zij terug naar huis."@nl .
  
