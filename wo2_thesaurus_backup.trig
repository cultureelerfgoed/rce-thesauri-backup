    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8028>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/1/1b/Pai_meeting_in_palembang_1939.jpg/500px-Pai_meeting_in_palembang_1939.jpg";
    dcterms:source "https://en.wikipedia.org/w/index.php?title=Persatuan_Arab_Indonesia&oldid=747501444"@en;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2506>, <https://data.niod.nl/WO2_Thesaurus/20702>;
    dcterms:created "2019-01-23T10:51:20.000Z"^^xsd:dateTime;
    skos:prefLabel "Persatuan Arab Indonesia"@nl, "Union of Indonesian Arabs"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Persatuan Arab Indonesia bestond van 4 oktober 1934 tot de Japanse capitulatie in Indonesië. De organisatie werd opgericht door Abdurrahman Baswedan en vocht voor de emancipatie en intergratie van indo-Arabieren. De aanhang zag zichzelf niet langer als Arabieren (welke gevoelens versterkt werden door de bezetting), maar als echte Indonesiërs en besloten na de bezetting zich aan te sluiten bij de bestaande onafhankelijkheidsbewegingen."@nl;
    skos:altLabel "PAI"@nl, "Unie van Indonesische Arabieren"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7741> a <http://schema.org/Thing>,
