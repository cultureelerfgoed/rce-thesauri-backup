    <http://schema.org/startDate> "1944-10-14"^^xsd:date;
    dcterms:source "https://wikimiddenbrabant.nl/Granaatinslagen_Bosscheweg,_14_oktober_1944"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/8508>;
    dcterms:created "2025-10-08T12:36:05.967Z"^^xsd:dateTime;
    skos:prefLabel "Granaatinslagen Bosscheweg Tilburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De granaatinslagen op de Bosscheweg in Tilburg vonden plaats op 14 oktober 1944. In oktober 1944 komt Tilburg in de vuurlinie tussen de Britse en Duitse troepen terecht. In de ochtend van 14 oktober slaan op de Bosscheweg granaten in vanaf de kanaalbrug bij het Longaterrein tot aan de spoorwegovergang bij café Luijben op Bosscheweg 157. Bij het café worden drie slachtoffers gevonden: twee gewonden en een dode. Alle drie waren vanuit Best tijdelijk geëvacueerd naar Tilburg."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
