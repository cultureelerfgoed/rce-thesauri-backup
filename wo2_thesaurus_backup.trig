    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/0836ef78-025a-11e7-904b-d89d6717b464/media/2ccb9278-a327-4c8b-934d-9fcac38e61dd"@nl;
    dcterms:source "https://www.japansekrijgsgevangenkampen.nl/Fukuoka%202B.htm"@nl, "https://www.roll-of-honour.org.uk/Japanese_Homeland/Camp_Rolls/Fukuoka_2B/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1699>, <https://data.niod.nl/WO2_Thesaurus/kampen/8787>;
    dcterms:created "2022-08-11T09:56:28.707Z"^^xsd:dateTime;
    skos:prefLabel "Fukuoka 2B"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Fukuoka 2B was een krijgsgevangenkamp op het eiland Koyagi Shima, in Nagasaki Bay. Het werd op 25 oktober 1942 gerealiseerd en heette vanaf 1 maart 1943 Fukuoka 2B. De gevangenen werkten op de Kawanami scheepswerf en kwamen uit Engeland, Nederland, Amerika en Australië. In september 1945 werd het kamp bevrijd."@nl;
    skos:altLabel "Fukuoka-kamp 2"@nl, "Fukuoka 2B - Nagasaki (Kawanami)"@nl, "Koyagi"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/1904> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
