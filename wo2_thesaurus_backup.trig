    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "51.49624"^^xsd:float;
    <http://www.w3.org/2003/01/geo/wgs84_pos#long> "7.45676"^^xsd:float;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    dcterms:modified "2021-12-21T14:48:02.531Z"^^xsd:dateTime;
