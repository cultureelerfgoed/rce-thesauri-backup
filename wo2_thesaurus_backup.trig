      <https://data.niod.nl/WO2_Thesaurus/18766>, <https://data.niod.nl/WO2_Thesaurus/18768>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/20680>;
    dcterms:created "2022-02-07T12:24:32.825Z"^^xsd:dateTime;
    skos:prefLabel "Israëlitisch Weeshuis Den Haag"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Israëlitisch Weeshuis 'Ezer Jatom' in Den Haag was een weeshuis voor Joodse jongens en meisjes. De vereniging achter het weeshuis werd in 1849 opgericht en op 1 januari 1850 opende het weeshuis zijn deuren. Het weeshuis bood tussen 1933 en 1941 ook onderdak aan Joodse vluchtelingen uit Duitsland en Oostenrijk. Op 5 maart 1943 werd het weeshuis tijdens een razzia ontruimd en werden de medewerkers en kinderen in het weeshuis via Westerbork naar Sobibor gedeporteerd."@nl;
    skos:altLabel "Ezer Jatom"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
