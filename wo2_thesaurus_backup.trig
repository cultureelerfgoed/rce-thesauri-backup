    skos:prefLabel "Maliebaan 82"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "Op Maliebaan 82 woonde dominee G. W. Oberman, die net zoals aartsbisschop Jan de Jong fel tegen de bezetter was. Zo hielp hij Joden, maar ook Nederlanders in armoede ten tijde van de Hongerwinter. "@nl;
    skos:altLabel "Woning dominee G. W. Oberman"@nl .
  
