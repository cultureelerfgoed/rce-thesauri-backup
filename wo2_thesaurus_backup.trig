    <http://schema.org/startDate> "1945-04-21"^^xsd:date;
    <http://schema.org/endDate> "1945-04-26"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Slag_bij_Bautzen_(1945)&oldid=55917299"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/6559>;
