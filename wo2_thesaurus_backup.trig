    skos:prefLabel "Eerste Nederlandse woning bevrijd"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De boerderij De Muggehof in Eijsden was op 12 september 1944 de eerste Nederlandse woning die bevrijd werd. De leden van de familie Smeets die daar woonde waren de eerste bevrijde Nederlanders."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/17750> a <http://schema.org/Thing>, skos:Concept;
