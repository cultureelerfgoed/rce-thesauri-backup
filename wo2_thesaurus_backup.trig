    skos:prefLabel "Vliegveld Twente (Enschede)"@de, "Camp 'Vliegveld Twente' (Enschede)"@en,
      "Vliegveld Twente (Enschede)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Vliegveld Twente was een burgervliegveld, maar werd door de Duitsers uitgebreid tot militair vliegveld, voornamelijk voor nachtjagers van de Luftwaffe. Na de bevrijding in april 1945 nam de RAF het vliegveld in gebruik onder codenaam B.106 voor jachtvliegtuigen en jachtbommenwerpers. Vliegveld Twente was van 1946 tot 1951 in gebruik als interneringskamp (bijzondere rechtspleging). Hier zaten verdachten van en veroordeelden voor collaboratie opgesloten."@nl;
    skos:altLabel "Vliegveld Twenthe"@nl, "Flugplatz Enschede"@nl, "Vliegbasis Twenthe"@nl,
      "Kamp Vliegveld Twente"@nl, "Kamp Vliegveld Twenthe"@nl;
