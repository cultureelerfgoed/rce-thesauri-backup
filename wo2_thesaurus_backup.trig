    dcterms:created "2018-07-16T11:16:36.000Z"^^xsd:dateTime;
    skos:prefLabel "Oflag 64 Schubin"@de, "Oflag 64 Schubin"@en, "Oflag 64 Schubin"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Oflag 64 in Schubin, Polen, werd op 6 juni 1943 ingericht als een Duits krijgsgevangenkamp exclusief voor Amerikaanse officieren die gevangen waren genomen in de Noord-Afrikaanse campagne in Tunesië. In juni 1944 kwamen hier Amerikaanse officieren bij die gevangen waren genomen bij de slag van Normandië. Op 21 januari 1945 zaten hier 1471 krijgsgevangenen. Op 23 januari 1945 werd het kamp door de Russen bevrijd."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
