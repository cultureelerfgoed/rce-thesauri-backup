    dcterms:created "2022-03-17T10:49:44.589Z"^^xsd:dateTime;
    skos:prefLabel "Executie in Hattem, 4 april 1945"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op de Gelderse Dijk in Hattem werden op 4 april 1945 zes gevangenen uit een gevangenis in Zwolle gefusilleerd. Een Einsatzkommando van de Sicherheitsdienst schoot de zes mannen dood als represaille voor een sabotageactie op het spoor. "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/18858> a <http://schema.org/Thing>, skos:Concept,
