    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4557>;
    dcterms:created "2022-01-04T14:18:13.056Z"^^xsd:dateTime;
    skos:prefLabel "Beirat voor niet-Nederlandse Joden"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Beirat voor niet-Nederlandse Joden had als taak de voorbereiding van de emigratie van niet-Nederlandse Joden en de registratie van de persoonlijke gegevens en vermogens. Eerst werden alleen die personen geregistreerd die een geldig visum voor overzee hadden. Later moesten alle niet-Nederlandse Joden op dezelfde wijze geregistreerd worden en bleek het niet om emigratie maar deportatie te gaan."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/18550>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/18553> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
