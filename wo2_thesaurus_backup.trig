    dcterms:created "2021-02-08T15:11:42.116Z"^^xsd:dateTime;
    skos:prefLabel "Liquidatie van Gerrit Jan Harm Hagedoorn"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De liquidatie van Gerrit Jan Harm Hagedoorn vond plaats op 25 september 1944 in Oosterbeek. Hagedoorn was luitenant bij de Staatspolitie. Hij werd op 24 september door de Zuiveringscommissie ontslagen en wegens zijn activiteiten voor de Landstorm op 25 september geliquideerd. "@nl .
  
