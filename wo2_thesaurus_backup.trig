    dcterms:source "https://nl.wikipedia.org/w/index.php?title=KP-Meppel&oldid=49709799"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/4889>;
    dcterms:created "2017-10-13T09:32:56.000Z"^^xsd:dateTime;
    skos:prefLabel "KP Meppel"@nl, "'KP Meppel'"@de, "'KP Meppel'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De verzetsgroep KP Meppel bestond uit meerdere groepen, de Groep Van Spijker, de Groep Jan Gunnink (schuilnaam ‘Ome Hein’) en de Groep Gerrit de Boer. Ook de Knokploeg De Hondsrug was verbonden met de KP Meppel. De groepen hielden zich bezig met allerlei illegale activiteiten, zoals hulp aan onderduikers, het verkrijgen van distributiebonnen en persoonsbewijzen,  de verspreiding van illegale bladen Vrij Nederland en Trouw, vervolging van NSB’ers, sabotage-acties en liquidaties."@nl;
    skos:altLabel "Knokploeg Meppel"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/10658>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
