    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/c1eba8dc-025a-11e7-904b-d89d6717b464/media/52acd9b2-a52d-7798-1ab2-e4aa7e1e5af8";
    dcterms:source "https://en.wikipedia.org/wiki/Oflag_X-B"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
