    <http://schema.org/startDate> "1943-07-11"^^xsd:date;
    dcterms:source "https://www.marhisdata.nl/schip&id=747"@nl;
    skos:relatedMatch <https://data.niod.nl/WO2_Thesaurus/events/6632>;
