    <http://schema.org/endDate> "1945-04-13"^^xsd:date;
    dcterms:source "https://www.4en5mei.nl/herdenken-en-vieren/oorlogsmonumenten/monumenten_zoeken/oorlogsmonument/1716"@de;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2574>;
    dcterms:created "2022-03-17T11:11:54.545Z"^^xsd:dateTime;
    skos:prefLabel "Executies Kruisjesdal"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Het Kruisjesdal is een plek in Hoog Soeren waar op 12 en 13 april 1945 in totaal zestien verzetsstrijders werden omgebracht door de Sicherheitsdienst (SD). Dit als gevolg van een bevel van Karl Eberhard Schöngarth, bevelhebber van Sicherheitspolizei en SD. De twaalf slachtoffers van 12 april werden vanuit de Willem III kazerne te Apeldoorn naar deze plek gebracht en geëxecuteerd en een dag later volgden nog vier mannen, die na hun arrestatie gevangen waren gezet op het hoofdkwartier van de SD aan de Meester van Rhemenslaan 7 in Apeldoorn. "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/18861> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:26:56.094Z"^^xsd:dateTime;
