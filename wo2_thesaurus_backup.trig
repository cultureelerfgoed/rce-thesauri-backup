    dcterms:created "2021-11-09T13:42:33.557Z"^^xsd:dateTime;
    skos:prefLabel "Oproep Joden Limburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Op 24 augustus 1942 kregen veel Limburgse Joden een oproep met het bevel zich te melden voor arbeid. Deze oproep kregen ze uitgereikt door de Nederlandse politiemannen, de gemeentepolitie of veldwachters. Degene die de oproep ontvingen moesten zich de volgende dag melden op een verzamelplaats in een schoolgebouw aan de Prof. Pieter Willemsstraat 39 te Maastricht. Zo'n 600 mensen werden opgeroepen, waarvan minder dan 300 verschenen."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/17052>;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
