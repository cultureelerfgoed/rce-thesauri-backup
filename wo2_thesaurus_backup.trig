    <http://schema.org/startDate> "1945-03-01"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/wiki/Bevrijding_van_Venlo_en_Blerick"@nl;
    skos:relatedMatch <https://data.niod.nl/WO2_Thesaurus/14353>;
    <http://schema.org/name> "Venlo";
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/6983>;
    dcterms:created "2018-10-19T12:30:00.000Z"^^xsd:dateTime;
    skos:prefLabel "Befreiung von Venlo"@de, "Liberation of Venlo"@en, "Bevrijding Venlo"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De bevrijding van Venlo vond plaats op 1 maart 1945. In 1944 hadden Venlo en Blerick het zwaar te verduren. Er vonden dertien bombardementen plaats op de Maasbruggen waarbij veel burgerslachtoffers vielen. Venlo werd tijdens de operatie Grenade bevrijd. Het 784e tankbataljon, onderdeel van het 9e Amerikaanse leger, kwam vanuit het oosten via de Kaldenkerkerweg de stad binnen. De Duitse soldaten gaven zich vrijwel direct over. "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/7014> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
