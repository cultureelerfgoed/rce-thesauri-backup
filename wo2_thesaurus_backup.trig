    dcterms:created "2020-07-28T14:12:15.000Z"^^xsd:dateTime;
    skos:prefLabel "Oprichtingsvergadering NSVO"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De oprichting van de NSVO werd ingeluid met een feestelijke bijeenkomst op 4 november 1938 in Den Haag, gelijktijdig met een aankondiging in Volk en Vaderland. A.M. van Hoey Smith-Van Stolk werd tot leider benoemd. De nieuwe nationaalsocialistische vrouwenorganisatie stelde zich ten doel 'het bevorderen en versterken van de nationaal-socialistische levens- en wereldbeschouwing onder de Nederlandsche vrouwen'. De NSVO presenteerde zich als een organisatie die zich ook richtte op vrouwen buiten de NSB."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
