    dcterms:created "2024-06-25T08:17:20.280Z"^^xsd:dateTime;
    skos:prefLabel "Transport Dossinkazerne - Auschwitz-Birkenau, 19-04-1943"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Het transport XX vertrok op 19 april 1943 vanuit de Dossinkazerne naar Auschwitz-Birkenau met ruim 1600 Joodse gevangenen, waaronder 109 Nederlanders. Drie Belgische verzetsmannen stopten de trein en wisten een wagondeur te openen, waardoor zeventien mensen konden ontsnappen. De rest werd alsnog gedeporteerd naar Auschwitz-Birkenau, 105 mensen overleefden deportatie."@nl;
    skos:altLabel "Transport XX"@nl .
  
