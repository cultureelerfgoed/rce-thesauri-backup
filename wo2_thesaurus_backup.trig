    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/29bccea6-025a-11e7-904b-d89d6717b464/media/5252f0bd-0467-9145-ef90-3e646b7fc255"@nl;
    <http://schema.org/startDate> "1937-10-09"^^xsd:date;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3591>, <https://data.niod.nl/WO2_Thesaurus/2244>;
