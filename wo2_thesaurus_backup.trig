      "https://www.japansekrijgsgevangenkampen.nl/Osaka%204B1.htm"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/b7354d29-49d5-4fe0-922a-3f3b5929fa84>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1699>, <https://data.niod.nl/WO2_Thesaurus/19225>;
    dcterms:created "2024-09-23T09:45:02.867Z"^^xsd:dateTime;
    skos:prefLabel "Osaka 4B1"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Osaka 4B1 was een krijgsgevangenkamp gelegen in de plaats Misaki in de Japanse prefectuur Osaka. Het kamp was opgericht op 22 november 1942 onder de naam Tanagawa waarna het vanaf 19 februari 1943 onder de naam Osaka 4B1 opereerde en in maart 1945 sloot na een bombardement op Osaka. Werkzaamheden waren o.a. afbraak van een berghelling voor de bouw van een droogdok en onderzeebootbasis."@nl;
    skos:altLabel "Tanagawa"@nl .
  
