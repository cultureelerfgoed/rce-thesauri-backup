    dcterms:created "2020-03-20T11:58:07.000Z"^^xsd:dateTime;
    skos:prefLabel "Gundelsdorf"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote """Aussenlager Gundelsdorf was van 12 september 1944 tot 13 april 1945 een buitenkamp van Flossenbürg waar 120 Poolse Joodse vrouwen en mannen tewerkgesteld waren bij het Luftnachrichtengerätelager I van Wehrkreises VIII dat van Płaszów naar Gundelsdorf verplaatst was. De gevangenen moesten barakken bouwen en treinen inladen en uitladen. Twintig vrouwen naaiden Wehrmachtsuniformen voor de Firma Wiedemann in Knellendorf.
"""@nl;
    skos:altLabel "Aussenlager Gundelsdorf"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/8837> a <http://schema.org/Thing>, skos:Concept,
