    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>;
    dcterms:created "2019-11-07T11:37:29.000Z"^^xsd:dateTime;
    skos:prefLabel "De bazuinstoot"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De bazuinstoot was een verzetsblad die in een oplage van 150 stuk vanaf augustus tot september 1944 twee keer per week verscheen in Nieuw Heeten. Nadat de uitgaven werd gecombineerd met De Vrije Stem verscheen deze gecombineerde editie onder de titel De Vrije Bazuin."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8674> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "PPN: 268797013"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    dcterms:modified "2022-04-19T13:42:29.724Z"^^xsd:dateTime;
    dcterms:source "https://upload.wikimedia.org/wikipedia/commons/2/23/PDF_of_De_Ondergrondse_Pers_1940-1945_-_derde_druk_-_1989.pdf"@nl,
      "https://nl.wikipedia.org/w/index.php?title=Wikipedia:Wikiproject/Verzetskranten/Beginnetjes/B.B.C._(verzetsblad,_Bussum)&oldid=46516457"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>;
    dcterms:created "2019-11-07T11:42:20.000Z"^^xsd:dateTime;
    skos:prefLabel "B.B.C."@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "B.B.C. was een verzetsblad uit Bussum, dat juni 1944 tot 11 mei 1945 dagelijks werd uitgegeven. Vanaf 6 januari 1945 werd het blad gecombineerd met verzetsblad Stemmen uit Londen en verscheen in een oplage van 500 tot 1500 stuk tot en met 9 februari 1945 met de titel: B.B.C. en Stemmen uit Londen. Van 10 februari tot 11 mei 1945 werd het blad dat voortkwam uit deze samenwerking onder de titel Neerland's Vrijheidsstrijd (N.V.S.) met een oplage van 1500 tot 2500 uitgegeven."@nl;
    skos:altLabel "Neerland's Vrijheidsstrijd (N.V.S.)"@nl, "B.B.C. en Stemmen uit Londen"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8675> a <http://schema.org/Thing>, skos:Concept;
