    <http://schema.org/startDate> "1940-05-11"^^xsd:date;
    dcterms:source "https://wikimiddenbrabant.nl/Bombardement_Bredaseweg,_11_mei_1940"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2322>, <https://data.niod.nl/WO2_Thesaurus/events/19539>;
    dcterms:created "2025-10-08T07:18:41.668Z"^^xsd:dateTime;
    skos:prefLabel "Bombardement op Bredaseweg Tilburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Het bombardement op de Bredase weg in Tilburg vond plaats op 11 mei 1940. In de namiddag van 11 mei 1940 werpt een vliegtuig oranje lichtkogels uit. Kort daarop verschijnen Duitse bommenwerpers en jachtvliegtuigen. Zij voeren een half uur lang een aanval uit bij het punt waar de spoorlijn Tilburg-Turnhout (Bels lijntje) de Bredaseweg kruist. Ongeveer twintig bommen komen neer in de Schaapstraat (later Vierwindenlaan), de Schout de Roijstraat en op de Bredaseweg, waaronder de kruising Schaapstraat-Bredaseweg. De materiële schade is groot en onder de burgers vallen acht doden."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/21822> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    dcterms:modified "2025-10-08T07:39:42.191Z"^^xsd:dateTime;
