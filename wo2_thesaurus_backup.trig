    dcterms:created "2024-09-13T08:38:27.754Z"^^xsd:dateTime;
    skos:prefLabel "Klandassan"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Klandassan was een krijgsgevangenkamp gelegen in de haven van Balikpapan aan de oostkust van Borneo. Het kamp was ondergebracht in BPM loodsen en was van februari 1942 tot april 1943 operationeel."@nl;
    skos:altLabel "Loodsen BPM"@nl .
  
