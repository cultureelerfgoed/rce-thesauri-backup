    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/09232b0e-025a-11e7-904b-d89d6717b464/media/80096c94-cfe8-8f8d-1def-41f7dc32ee41";
    <http://schema.org/location> "Yogyakarta";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://www.oorlogsbronnen.nl/zoekresultaat?id=http%3A%2F%2Farchievenwo2.nl%2Farchieven%2Farchief-blok%2F-498891953>;
    <http://schema.org/startDate> "1946-01-04"^^xsd:date;
    <http://schema.org/description> "Door de dreiging van een aanval op de hoofdstad Djakarta/Batavia voelen de Republikeinse leiders zich daar eind 1945 minder veilig. Ze besluiten hun regering naar Djokjakarta over te brengen en op 4 januari 1946 de stad uit te roepen tot de hoofdstad van de Republik Indonesia. Soekarno en Hatta vertrekken naar de nieuwe hoofdstad, Sjahrir blijft in Djakarta/Batavia. Hamengko Buwono IX, de sultan van Djokjakarta, is een belangrijke steunpilaar van de Republiek. Hij geniet groot gezag bij de bevolking. ‘Djokja’ (ook wel ‘Djogja’) wordt vanuit Nederlands perspectief symbool voor de Republikeinse tegenstander."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/4402>, <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2019-03-29T15:08:31.000Z"^^xsd:dateTime;
    skos:prefLabel "Vestiging van de Republikeinse regering in Djokjakarta"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Vestiging van de Republikeinse regering in Djokjakarta vindt plaats op 4 januari 1946, en is het gevolg van de toenemende dreiging van een aanval op de hoofdstad Djakarta/Batavia. Republikeinse leiders voelen zich daar steeds minder veilig. De leiders roepen Djokjakarta uit tot de hoofdstad van Republik Indonesia."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
