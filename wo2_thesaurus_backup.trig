  <https://data.niod.nl/WO2_Thesaurus/corporaties/5815> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "Benien van Berkel, Tobie Goedewaagen (1895-1980). Een onverbeterlijke nationaalsocialist (Amsterdam, 2013)"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2024-08-12T12:03:08.902Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1940-11-27"^^xsd:date;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/7984>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/02136d12-abf4-3ce2-070a-b1a61c9fd30f.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/d3d302ee-0259-11e7-904b-d89d6717b464/media/02136d12-abf4-3ce2-070a-b1a61c9fd30f";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/d3c4c8a0-0259-11e7-904b-d89d6717b464/media/4b218625-9072-ec9f-2b92-f19327a89a62>,
      <https://beeldbankwo2.nl/nl/beelden/detail/d3c5ca8e-0259-11e7-904b-d89d6717b464/media/689d22b3-2da4-7fb8-33d0-e7240fe654bf>,
      <https://beeldbankwo2.nl/nl/beelden/detail/f8fc498a-025a-11e7-904b-d89d6717b464/media/3b232831-03b4-057c-f3ce-d411945408bf>;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Departement_van_Volksvoorlichting_en_Kunsten&oldid=63912905"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-06"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Het Departement van Volksvoorlichting en Kunsten (DVK) was een nationaalsocialistisch departement gericht op propaganda en censuur in de pers, radio en culturele sector. Het DVK werd op 27 november 1940 opgericht naar voorbeeld van het Duitse propagandaministerie van Joseph Goebbels. Zeker 200 Nederlanders werkten voor het DVK. Het DVK werd geleid door Tobie Goedewaagen en daarna door Hermannus Reydon en Sebastiaan Mattheus Sigismund de Ranitz."@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1753>;
    dcterms:created "2018-01-18T19:05:33.000Z"^^xsd:dateTime;
    skos:prefLabel "Ministerium für Volksaufklärung und Kunst"@de, "Ministry of Public Information and the Arts"@en,
      "Departement van Volksvoorlichting en Kunsten"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Departement van Volksvoorlichting en Kunsten (DVK) werd op 27 november 1940 door Seyss-Inquart ingesteld naar het voorbeeld van het Reichsministerium für Volksaufklärung und Propaganda van Joseph Goebbels en had als doel de Nederlandse samenleving te nazificeren. Na een conflict met Mussert moest Tobie Goedewaagen in januari 1943 als secretaris-generaal het veld ruimen. Zijn opvolger, de NSB’er Hermannus Reydon, raakte op 7 februari zwaargewond door een aanslag, waarna zijn partijgenoot jhr.mr. S.M.S. de Ranitz als waarnemend secretaris-generaal de leiding van het departement overnam. In september 1944 verhuisde het departement gedeeltelijk naar Groningen."@nl;
    skos:altLabel "DVK"@nl, "D.V.K."@nl, "Departement Volksvoorlichting en Kunsten"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/5816> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "A.A. de Jonge, Het Nationaal-Socialisme in Nederland: voorgeschiedenis, ontstaan en ontwikkeling. 2e verbeterde druk (Den Haag, 1979)"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2024-08-12T12:03:08.742Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/b/bf/BertusSmit.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/w/index.php?title=File:BertusSmit.jpg&oldid=848457012";
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Nationaal-Socialistische_Nederlandsche_Arbeiderspartij&oldid=46795519"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Nationaal-Socialistische Nederlandsche Arbeiderspartij-Smit (NSNAP-Smit) was een nationaalsocialistische politieke partij die in 1932 werd opgericht door Bertus Smit. De NSNAP-Smit ontstond na het uiteenvallen van de Nationaal-Socialistische Nederlandsche Arbeiderspartij (NSNAP). In 1941 werd de partij op Duits bevel opgenomen in de Nationaal-Socialistische Beweging (NSB)."@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4620>;
    dcterms:created "2018-01-18T19:06:01.000Z"^^xsd:dateTime;
    skos:prefLabel "N.S.N.A.P. -Smit"@nl, "'NSNAP Smit'"@de, "'NSNAP Smit'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De NSNAP-Smit was een Nederlandse nationaalsocialistische politieke partij die bestond van 1933 tot 1934. Het was een afsplitsing van de NSNAP van Haigton en Bertus Smit, beter bekend als Adalbert Smit. In 1934 ging de partij ter ziele en vertrok Smit naar België."@nl;
    skos:altLabel "Nationaal-Socialistische Nederlandsche Arbeiderspartij Smit"@nl, "NSNAP- de Binckhorst"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
