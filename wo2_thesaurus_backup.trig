    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Wis%C5%82a-Oderoffensief&oldid=56317586"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/9406>;
    dcterms:created "2020-09-10T15:02:35.000Z"^^xsd:dateTime;
    skos:prefLabel "Warschau-Posenoffensief"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Het Warschau-Posenoffensief was een onderdeel van het succesvolle Wisla-Oderoffensief in 1945. De militaire operatie duurde van 14 januari tot 3 februari en zorgde voor een grote hinderlaag voor de Duitsers."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9410> a <http://schema.org/Thing>, skos:Concept,
