    dcterms:created "2018-03-07T09:02:14.000Z"^^xsd:dateTime;
    skos:prefLabel "Verzetsgroep ‘Ik zal handhaven’"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote """De Leidse verzetsgroep ‘Ik zal handhaven’ bestond vooral uit studenten en was actief in spionage- en sabotageacties. Van herfst 1940-december 1943 gaven zij het illegale blad ‘Ik zal handhaven’ uit (nr. 248 in L. Winkelman, De ondergrondse pers). Het blad bevatte praktische aanwijzingen voor de techniek en de tactiek van het openlijk verzet, vooral bestemd voor personen die direct met de bezettingsautoriteiten te maken hadden, zoals ambtenaren. Betrokkenen waren o.a. J .F. van Walsem (vermoedelijk de oprichter). H. 't Hart, D.A.E. de Loos, F.N.F. van der Schrieck, de officieren C.L. Kist en Sj. Nauta en de cadet-vaandrig A.C.L. de Klerck.
"""@nl;
    skos:altLabel "Verzetsgroep Ik Zal Handhaven"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/6067> a <http://schema.org/Thing>,
