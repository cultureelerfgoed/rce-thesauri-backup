    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De rang van NSKK-Obersturmmann (hogere stormtroeper) in het Nationalsozialistische Kraftfahrkorps (NSKK) is vergelijkbaar met de rang van soldaat der 1e klasse. Het NSKK was een paramilitair onderdeel van de NSDAP dat in de oorlog diende als bevoorradingseenheid aan de verschillende fronten. Met steun van de NSB-leiding begon in januari 1941 de werving van Nederlandse vrijwilligers voor het NSKK."@nl;
    skos:altLabel "NSKK-Obersturmmann"@nl, "Hogere stormtroeper"@nl, "NSKK Obersturmmann"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4619> .
  
