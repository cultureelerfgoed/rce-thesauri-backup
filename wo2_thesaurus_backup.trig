    dcterms:created "2019-03-13T08:58:49.000Z"^^xsd:dateTime;
    skos:prefLabel "Johannahoeve (Arnhem)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Johannahoeve, een boerderij en landgoed te Arnhem, was voorwerp van hevige strijd tijdens Market Garden. Britse troepen moesten het landingsterrein voor de landing van de Poolse zweefvliegtuigen op dinsdag 19 september 1944 verdedigen. Dit landingsterrein bleek echter precies voor de Duitse Sperrlinie te liggen en de Duitsers hadden het terrein goed verdedigd, het lukte de Britten dan ook niet om het terrein te veroveren en zij leden zware verliezen. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/3585>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4642>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/4460> .
  
  <https://data.niod.nl/WO2_Thesaurus/locations/8069> a <http://schema.org/Thing>, skos:Concept,
