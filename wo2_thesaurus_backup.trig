    dcterms:modified "2026-08-03T08:21:19.815Z"^^xsd:dateTime, "2026-08-03T08:21:20.535Z"^^xsd:dateTime,
      "2026-08-03T08:21:20.681Z"^^xsd:dateTime;
    dcterms:source "https://duitsverzet.wordpress.com/duits-verzet-en-nederland/nederlanders-bij-duits-verzet-in-duitsland/"@nl,
      "https://www.tracesofwar.nl/sights/148790/Stolperstein-Emmastraat-1b.htm"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/2669>;
