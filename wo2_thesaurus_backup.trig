    <http://schema.org/startDate> "1940-05-10"^^xsd:date;
    dcterms:source "https://wikimiddenbrabant.nl/Bombardement_Noordstraat,_10_mei_1940"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2322>;
    dcterms:created "2025-10-07T10:54:17.810Z"^^xsd:dateTime;
    skos:prefLabel "Bombardement op Noordstraat Tilburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Het bombardement in de Noordstraat, Tilburg, vond plaats op 10 mei 1940. In de middag, slaan in de buurt van het treinstation bommen in. Er vallen bommen bij Van Gend & Loos en de Rotterdamsche Bankvereniging N.V op de Spoorlaan. Eén bom ontploft in de Noordstraat voor de manufacturenwinkel van Vincent Stalpers N.V. op nummer 24a. Elf personen worden vrijwel direct gedood en twee overlijden later aan hun verwondingen."@nl .
  
