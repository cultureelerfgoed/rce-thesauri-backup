    <http://schema.org/startDate> "1944-10-23"^^xsd:date;
    <http://schema.org/endDate> "1944-10-26"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Slag_in_de_Golf_van_Leyte&oldid=51093663"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3536>, <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2019-03-29T10:56:14.000Z"^^xsd:dateTime;
    skos:prefLabel "Zeeslag bij de Golf van Leyte"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Zeeslag bij de Golf van Leyte, van 23 oktober tot  26 oktober 1944, is de grootste zeeslag uit de Tweede Wereldoorlog. De Japanse marine zette alles op alles om in een beslissende slag de Amerikaanse invasie van de Filippijnen te voorkomen, omdat dan de verbindingen met Nederlands-Indië werden verbroken en Japan werd verstoken van de aanvoer van grondstoffen. De slag in de Golf van Leyte eindigde in een zware nederlaag voor Japan. Drie Nederlandse koopvaardijschepen, de Janssens, de Tabinta en de Sommelsdijk, droegen bij aan deze operatie."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/1870>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8234> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    dcterms:modified "2025-06-03T11:54:41.524Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8143>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/wo2nedindieThema> "Herbezetting Nederlands-Indië";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://service.archief.nl/gaf/api/file/v1/img/20a64c3d-6dcf-457f-8119-055958e592b9?h=1000";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://www.nationaalarchief.nl/onderzoeken/fotocollectie/ad9c1c00-d0b4-102d-bcf8-003048976d84";
    <http://schema.org/location> "Tacloban";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://www.rijksmuseum.nl/nl/collectie/NG-1992-3-3-9>,
      <https://beeldbankwo2.nl/nl/beelden/detail/d7002b2c-0259-11e7-904b-d89d6717b464/media/ebfaae8f-a280-73ab-13bf-33920948e574>,
      <https://beeldbankwo2.nl/nl/beelden/detail/e5ec38b0-0259-11e7-904b-d89d6717b464/media/490fb9b7-14c0-d3c4-795c-5fd2c4affe82>;
    <http://schema.org/startDate> "1944-12-10"^^xsd:date;
    dcterms:source "http://www.afscheidvanindie.nl/archieven-onderwerpen-nica.aspx"@nl;
    <http://schema.org/description> "In maart 1944 staan de geallieerden op het punt een offensief te beginnen tegen Nederlands Nieuw-Guinea. De Nederlands-Indische autoriteiten vragen aan generaal MacArthur om een overeenkomst die het herstel van het Nederlandse gezag in de heroverde gebieden regelt. De Amerikaanse minister van Buitenlandse Zaken Cordell Hull wil dat de Nederlandse autoriteiten zich in de overeenkomst vastleggen op een datum waarop zij hun kolonie onafhankelijkheid of volledige autonomie verlenen. Op 30 november 1944 treedt Cordell Hull en wordt Edward Stettinius jr. minister van Buitenlandse Zaken. Op 10 december 1944 wordt in Tacloban op het Filippijnse eiland Leyte de Van Mook-MacArthur Civil Affairs Agreement ondertekent."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2019-03-29T11:22:37.000Z"^^xsd:dateTime;
    skos:prefLabel "Ondertekening Van Mook-MacArthur Civil Affairs Agreement"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Bij de Ondertekening Van Mook-MacArthur Civil Affairs Agreement wordt het herstel van het Nederlandse gezag in de heroverde Nederlands-Indische gebieden geregeld. Op 10 december 1944 wordt in Tacloban op het Filipijnse eiland Leyte de Van Mook-MacArthur Civil Affairs Agreement ondertekend."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8235> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2021-03-15T15:13:06.238Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8142>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/wo2nedindieThema> "Japans bestuur";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/250x250/5bf178f6-edf9-3e2c-c954-d6fd74ee79f8.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/fb326eba-0259-11e7-904b-d89d6717b464/media/5bf178f6-edf9-3e2c-c954-d6fd74ee79f8";
    <http://schema.org/location> "Tokio";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://www.delpher.nl/nl/kranten/view?coll=ddd&identifier=ddd:011121009:mpeg21:a0003>,
      <https://www.delpher.nl/nl/kranten/view?coll=ddd&identifier=ddd:011184905:mpeg21:a0009>;
    <http://schema.org/startDate> "1945-04-05"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Kantar%C5%8D_Suzuki&oldid=52723963"@nl;
    <http://schema.org/description> "Premier Koiso treedt af. Koiso wordt verantwoordelijk gehouden voor de militaire nederlagen die Japan in 1944 en 1945 lijdt. In oktober 1944 vindt de Amerikaanse landing plaats op het eiland Leyte in de Filippijnen. In de aansluitende zeeslag wordt de Japanse marine vernietigend verslagen. In maart 1945 veroveren Amerikaanse mariniers Iwo Jima en op 1 april landen ze op Okinawa. Hirohito vraagt admiraal Suzuki Kantaro een nieuw kabinet te vormen."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2019-03-29T11:42:22.000Z"^^xsd:dateTime;
    skos:prefLabel "Aantreden kabinet Suzuki Kantaro"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Het Aantreden kabinet Suzuki Kantaro vindt plaats op 7 april 1945, nadat Japan in 1944 en 1945 militaire nederlagen leidt. Premier Koiso werd hiervoor verantwoordelijk gehouden en treedt af."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8236> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
