    dcterms:created "2019-03-07T10:18:01.000Z"^^xsd:dateTime;
    skos:prefLabel "Verhuizing Hoge Raad van Den Haag naar Nijmegen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote """De Verhuizing van de Hoge Raad van Den Haag naar Nijmegen vond plaats in mei 1943 en had alles te maken met een verordening die Arthur Seyss-Inquart eind december 1942 uitvaardigde, waarin hij de verhuizing van het bezettingsbestuur aankondigde. Alle bestuurlijke instanties en departementen dienden zich van Den Haag richting het oosten te verplaatsen, vanwege de angst voor een geallieerde aanval op de kustlinie. In Nijmegen nam de Hoge Raad zijn intrek in de aula van de Radboud Universiteit Nijmegen.
"""@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
