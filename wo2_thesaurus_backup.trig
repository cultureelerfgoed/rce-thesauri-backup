    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/19539>;
    dcterms:created "2025-10-08T07:53:08.486Z"^^xsd:dateTime;
    skos:prefLabel "V-1 inslag Minister Talmastraat Tilburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De inslag van een Duitse V-1 op de Minister Talmastraat in Tilburg vond plaats op 1 februari 1945. Omstreeks het middaguur, stortte een V-1 neer achter de woningen aan de Minister Talmastraat 44 en 46. Er vielen tweeëntwintig doden en tientallen gewonden. Veel huizen werden geheel of gedeeltelijk verwoest."@nl .
  
