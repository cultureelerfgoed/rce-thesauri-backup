    dcterms:created "2025-10-08T14:35:24.143Z"^^xsd:dateTime;
    skos:prefLabel "Overval Afdeling Bevolking Tilburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De overval op de Afdeling Bevolking van de gemeente Tilburg vond plaats op 25 januari 1944. Bij deze overval worden 105.000 Rauterzegels, 700 blanco persoonsbewijzen en een aantal paspoorten buitgemaakt. Leden van de KP (knokploeg) Soest en Tilburgse gemeenteambtenaren hebben samengewerkt aan de overval."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
