    <http://schema.org/startDate> "1944-06-01"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2682>;
    dcterms:created "2021-02-10T14:08:35.211Z"^^xsd:dateTime;
    skos:prefLabel "Aanslag op V. Loo"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Aanslag op V. Loo vond plaats op 1 juni 1944 in Epen door verzetsdeelnemer Wilhelm Jozef Francotte. Loo werd verdacht van verraad en collaboratie. Hij raakte ernstig gewond en overleed drie dagen later."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
