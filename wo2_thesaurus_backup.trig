    <http://schema.org/endDate> "1944-11-19"^^xsd:date;
    dcterms:source "https://www.levenindeliemers.nl/verhalen/57-de-evacuatie-van-duiven-westervoort-en-zevenaar"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1922>;
    dcterms:created "2022-01-06T14:28:03.194Z"^^xsd:dateTime;
    skos:prefLabel "Evacuatie van Duiven en Groessen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Evacuatie van Duiven en Groessen vond plaats op 18 en 19 november 1944. De evacuatie werd afgekondigd omdat de frontlinie steeds dichterbij kwam en de geallieerden regelmatig beschietingen uitvoerden op de Duitse troepen die zich in de Liemers bevonden. Loo was al op 27 september 1944 geëvacueerd. De inwoners van Duiven en een deel van Groessen werden op 18 en 19 november 1944 via Wehl en Doetinchem naar evacuatieadressen in Varsseveld gebracht. In april 1945 keerden de inwoners van Duiven en Groessen terug naar hun dorpen."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/18593> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
