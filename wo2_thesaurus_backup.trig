    skos:prefLabel "Willemskazerne (Arnhem)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Willemskazerne te Arnhem was tijdens de Duitse bezetting een opleidingscentrum voor de SS en stond bij de bezetter te boek als de SS-Unterführerschule. "@nl;
    skos:altLabel "SS-Unterführerschule"@nl;
