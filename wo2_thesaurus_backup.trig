    dcterms:created "2019-01-21T14:56:43.000Z"^^xsd:dateTime;
    skos:prefLabel "Barisan F"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Barisan F was een zelfstandig opererende lokale organisatie van de F-Kikan die in december 1941 ontstond na instructies gegeven door Fujiwara aan Abu Bakar Said. Nog voor de Japanse inname dwong deze groep de KNIL-militaire tot terugtrekking uit Atjeh. Ook was deze organisatie verantwoordelijk voor meerdere moorden op Nederlandse ambtenaren.  "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7724> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "Peter Post - The Encyclopedia of Indonesia in the Pacific War"@en,
      "Peter Post, ed., The Encyclopedia of Indonesia in the Pacific War (Leiden : Brill, 2010)"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:36:51.325Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/mediabank-horizontal/a9caf6db-828d-433e-efb6-55d91e35f7f7.jpg";
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/20702>;
    dcterms:created "2019-01-21T15:08:27.000Z"^^xsd:dateTime;
    skos:prefLabel "Empat Serangkai"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Empat Serangkai werd eind 1942 opgericht door de Indonesische leiders Sukarno, Mohammad Hatta, Ki Hajar Dewantara en Mas Mansur en was actief tijdens de Japanse bezetting. Het werd opgericht omdat Hatta en Soekarno een bredere volksbeweging wilden opzetten en omdat zij niet tevreden waren over de AAA-beweging. Daar de eerste twee leiders volledige medewerking wilden geven aan de bezetter, maar Dewantara en Mansur daar voor hun vakgebied het nut niet van zagen functioneerde de organisatie nooit soepel."@nl;
    skos:altLabel "De Beroemde Vier"@nl, "Famous Foursome"@en;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/4382>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7725> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
