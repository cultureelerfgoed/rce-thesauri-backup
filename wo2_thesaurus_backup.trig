    skos:prefLabel "Transport Theresienstadt - Auschwitz, 04-10-1944 - 06-10-1944"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Treintransport Theresienstadt - Auschwitz van 4-10-1944 - 06-10-1944 was een van de 11 transporten vanuit Theresienstadt naar Auschwitz tussen 28 september en 28 oktober 1944. Dit transport vertrok met 1500 vervolgden van Theresienstadt naar Auschwitz-Birkenau. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/18981> a <http://schema.org/Thing>, skos:Concept,
