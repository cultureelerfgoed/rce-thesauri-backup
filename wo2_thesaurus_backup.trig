    dcterms:created "2016-10-04T13:07:40.000Z"^^xsd:dateTime;
    skos:prefLabel "Luftwaffe"@de, "Luftwaffe"@en, "Luftwaffe"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Luftwaffe was de luchtmacht van nazi-Duitsland. Bij het uitbreken van de Tweede Wereldoorlog was de Luftwaffe de meest moderne en sterkste luchtmacht ter wereld die een prominente rol speelde in Hitlers tactiek van oorlogsvoering (Blitzkrieg). Hieronder vielen ook terreurbombardementen, zoals op Rotterdam op 14 mei 1940. Na de verloren Slag om Engeland in de zomer van 1940 werd de Luftwaffe steeds meer in het defensief gedrongen doordat Groot-Brittannië en de Verenigde Staten sneller en op grotere schaal vliegtuigen produceerden."@nl;
    skos:altLabel "Lw."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/locations/8087>, <https://data.niod.nl/WO2_Thesaurus/locations/8118>,
