  <https://data.niod.nl/WO2_Thesaurus/8614> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:30:56.189Z"^^xsd:dateTime;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Algemeen_Handelsblad&oldid=53948735"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2376>;
    dcterms:created "2019-11-04T09:05:44.000Z"^^xsd:dateTime;
    skos:prefLabel "Algemeen Handelsblad"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "Algemeen Handelsblad, één van de voorlopers van het latere NRC Handelsblad, was een in 1882 opgerichte krant met liberale signatuur. Tijdens de Duitse bezetting van Nederland bleef de krant verschijnen, al viel de SD op 5 juli 1941 wel het hoofdkantoor binnen en werd de top vervangen door pro-Duitse personen. Na de bezetting kreeg de krant, in het kader van de perszuivering, een kort verschijningsverbod tot 1 september 1945. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2958> .
  
  <https://data.niod.nl/WO2_Thesaurus/8615> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:30:56.961Z"^^xsd:dateTime;
    dcterms:source "https://www.nationaalarchief.nl/onderzoeken/archief/2.21.183.37?anchor=descgrp-context-bioghist"@nl,
      "https://nl.wikipedia.org/w/index.php?title=Nieuwe_Rotterdamsche_Courant&oldid=54534112"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2376>;
    dcterms:created "2019-11-04T09:26:28.000Z"^^xsd:dateTime;
    skos:prefLabel "Nieuwe Rotterdamsche Courant"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "Nieuwe Rotterdamsche Courant (NRC), één van de kranten die in 1970 opging in het NRC Handelsblad, was een in 1843 opgerichte krant van liberale signatuur. Tijdens de Duitse bezetting bleef de krant verschijnen en hoewel de krant in het kader van de gelijkschakeling Duitse berichtgeving overnam stond de krant niet bekend als uitgesproken pro-Duits. Na de bezetting mocht de krant, in het kader van de perszuivering, tot 24 juni 1945 niet gedrukt worden en mocht het daarna tot 1 juli 1947 niet onder de eigen naam verschijnen."@nl;
    skos:altLabel "Nieuwe Rotterdamse Courant"@nl, "NRC"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2958> .
  
  <https://data.niod.nl/WO2_Thesaurus/8616> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:30:57.675Z"^^xsd:dateTime;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Het_Vaderland&oldid=53806494"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2376>;
    dcterms:created "2019-11-04T09:49:01.000Z"^^xsd:dateTime;
    skos:prefLabel "Het Vaderland"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "Het Vaderland was een in 1869 opgerichte krant met progressief-liberale signatuur. Tijdens de Duitse bezetting van Nederland werd de krant uitgesproken pro-Duits. In het kader van de perszuivering kreeg de krant na de bezetting een publicatieverbod van anderhalf jaar en mocht de krant pas vanaf 1951 weer de eigen naam voeren. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2958> .
  
  <https://data.niod.nl/WO2_Thesaurus/8617> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:30:58.103Z"^^xsd:dateTime;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Het_Volk_(Nederland)&oldid=54410818"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2376>;
    dcterms:created "2019-11-04T10:02:07.000Z"^^xsd:dateTime;
    skos:prefLabel "Het Volk"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "Het Volk was een in 1900 opgerichte krant van socialistische signatuur. Tijdens de Duitse bezetting van Nederland werd NSB'er Rost van Tonningen leider van de krant en kreeg de krant een uitgesproken pro-Duitse signatuur. Na de bezetting werd de krant voortgezet met als nieuwe naam Het Vrije Volk."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2958> .
  
  <https://data.niod.nl/WO2_Thesaurus/8618> a <http://schema.org/Thing>, skos:Concept;
