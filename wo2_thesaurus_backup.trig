    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2025-07-31T08:46:39.275Z"^^xsd:dateTime;
    dcterms:source "https://nl.wikipedia.org/wiki/Nederlandsche_SS"@nl, "https://nl.wikipedia.org/wiki/Lijst_van_militaire_rangen_van_de_Schutzstaffel"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/19853>;
    dcterms:created "2023-08-30T10:37:04.523Z"^^xsd:dateTime;
    skos:prefLabel "Hauptscharführer"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De rang van SS-Hauptscharführer (afkorting: Hscha.) in de SS en de Waffen-SS is vergelijkbaar met de rang van sergeant-majoor. De Waffen-SS was de militaire tak van de SS. Vanaf juni 1940 werden Nederlanders geworven voor de Waffen-SS. De rang hoofdschaarleider in de Nederlandsche SS was het equivalent van de rang SS-Hauptscharführer in de SS en de Waffen-SS. Deze rang was vergelijkbaar met de rang van sergeant-majoor. Vanaf januari 1944 werden ook in de Nederlandsche SS de Duitse rangaanduidingen gebruikt."@nl;
    skos:altLabel "SS-Hauptscharführer"@nl, "SS Hauptscharführer"@nl, "Hscha."@nl, "Hoofdschaarleider"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4717>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4521>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/4886> .
  
