    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/4382>, <https://data.niod.nl/WO2_Thesaurus/20702>;
    dcterms:created "2019-01-17T15:01:29.000Z"^^xsd:dateTime;
    skos:prefLabel "San'yo Kaigi"@nl, "Dewan Sanyo"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "San'yo Kaigi bestond van 16 juni 1943 tot de capitulatie van Japan in Nederlands-Indië en de oprichting werd bekend gemaakt door de Japanse minister-president Hideki Tojo. Het doel van San'yo Kaigi was om inheemse leiders op verschillende vlakken om advies te vragen bij Japanse vraagstukken. De adviseurs werden door de Japanners aangewezen (bijvoorbeeld Soekarno)."@nl;
    skos:altLabel "Raad van Politieke Adviseurs"@nl, "Council of Political Advisors"@en;
    skos:hiddenLabel "Sanyo Kaigi"@nl .
  
