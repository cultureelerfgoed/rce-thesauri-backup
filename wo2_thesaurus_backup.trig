    <http://schema.org/startDate> "1945-05-08"^^xsd:date;
    dcterms:source "https://www.brandgrens.nl/bevrijding#:~:text=Op%208%20mei%20doet%20de,Canadezen%20leidt%20tot%20uitzinnige%20vreugde."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/6983>;
    dcterms:created "2020-08-27T08:44:46.000Z"^^xsd:dateTime;
    skos:prefLabel "Bevrijding Rotterdam"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De bevrijding van Rotterdam verliep enigszins chaotisch. Al vanaf 5 mei waren de Binnenlandse Strijdkrachten actief in de stad en raakten in gevecht met Duitse troepen. De Duitsers wilden zich alleen officieel overgeven aan de geallieerden. Op 6 mei 1945 hees burgemeester Oud, die in 1941 was ontslagen, de vlag voor zijn huis en op 8 mei trokken de Canadezen Rotterdam binnen."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9313> a <http://schema.org/Thing>, skos:Concept,
