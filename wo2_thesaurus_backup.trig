    dcterms:created "2022-02-24T15:03:00.340Z"^^xsd:dateTime;
    skos:prefLabel "Opheffing Stichting Centraal Israëlitisch Weeshuis in Nederland"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Opheffing van de Stichting Centraal Israëlitisch Weeshuis in Nederland vond plaats op 19 augustus 1942. De Duitse bezetter had een reorganisatie van niet-commerciële verenigingen en stichtingen afgekondigd. Meer dan 35 Joodse instellingen werden vanaf november 1942 samengevoegd in één vereniging: de Joodse Vereniging voor Verpleging en Verzorging (JVvVV). Daarmee verloren de instellingen al hun middelen."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/18681>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
