  <https://data.niod.nl/WO2_Thesaurus/corporaties/4603> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "G. Zondergeld, Ons Socialisme Uw toekomst. Henk Woudenberg en het Nederlands Arbeidsfront (1942-1945) (Apeldoorn/Antwerpen 2010)"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-08-18T15:14:14.560Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1942-04-30"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/e4a26850-47bd-0f73-e6a6-967e1ff00b39.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/58fb6862-025a-11e7-904b-d89d6717b464/media/e4a26850-47bd-0f73-e6a6-967e1ff00b39";
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-06"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Het Nederlandsche Arbeidsfront (NAF) was een nationaalsocialistische overkoepelende vakbondsorganisatie. Het NAF was gebaseerd op het Deutsche Arbeitsfront (DAF). Op 31 april 1942 werden alle Nederlandse vakbonden door de Duitse bezetter opgeheven en vervangen door het NAF. Het NAF was met ruim 100.000 leden de grootste nationaalsocialistische organisatie van Nederland."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/corporaties/4515>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2146>;
    dcterms:created "2016-10-04T13:07:40.000Z"^^xsd:dateTime;
    skos:prefLabel "'Nederlandsche Arbeidsfront'"@de, "Dutch Labour Front"@en, "Nederlandsche Arbeidsfront"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Nederlandsche Arbeidsfront (NAF) was een nationaalsocialistische vakcentrale die op 30 april 1942 per verordening door Seyss-Inquart werd opgericht. De volgende dag werden de andere vakcentrales en vakbonden opgeheven en hun bezittingen en vermogens overgeheveld naar het NAF. Aan het hoofd stond de NSB'er H.J. Woudenberg. Zijn streven naar de nazificering van de vakbeweging liep uit op een faliekante mislukking. Terwijl de opgeheven vakbonden voor de oorlog gezamenlijk ruim 700.000 leden telden, had het NAF honderdduizend leden. Het was daarmee niettemin de grootste nationaalsocialistische organisatie van ons land."@nl;
    skos:altLabel "Front van Nering en Ambacht"@nl, "Nederlands Arbeidsfront"@nl, "Nederlandsch Arbeidsfront"@nl,
      "Nederlandse Arbeidsfront"@nl, "Nederl.Arb.Front"@nl, "Nederl. Arb. Front"@nl, "Nederlandsch Arbeids Front"@nl,
      "Nederlandsche Arbeids Front"@nl, "Nederlands Arbeids Front"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/locations/7974>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4600>,
      <https://data.niod.nl/WO2_Thesaurus/11245>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization>;
    skos:hiddenLabel "NAF"@nl, "N.A.F."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/4604> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "D. Barnouw (red.), Correspondentie van mr. M.M. Rost van Tonningen. Deel 2 mei 1942- mei 1945 (Zutphen 1993 )"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2024-08-12T12:03:08.709Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1942-06-06"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/4cb50b78-45bd-6f9c-5b46-8b0c55af4830.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/5cd9e9fe-025a-11e7-904b-d89d6717b464/media/4cb50b78-45bd-6f9c-5b46-8b0c55af4830";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/2d66c8d6-025a-11e7-904b-d89d6717b464/media/ce47d27d-97e2-fb42-68d1-700d435936f8>,
      <http://resolver.kb.nl/resolve?urn=urn:gvn:EVDO02:NIOD05_4137>, <https://beeldbankwo2.nl/nl/beelden/detail/2d4cc652-025a-11e7-904b-d89d6717b464/media/58080289-f35b-db15-1a12-2ace8d8d8a76>;
    dcterms:source "https://www.archieven.nl/nl/zoeken?mivast=0&mizig=210&miadt=298&miaet=1&micode=176&minr=1242769&miview=inv2"@nl,
      "https://nl.wikipedia.org/w/index.php?title=Nederlandsche_Oost_Compagnie&oldid=64250199"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-06"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Nederlandsche Oost Compagnie N.V. (NOC) was een nationaalsocialistische organisatie die zich bezighield met het koloniseren van door Duitsland bezette gebieden in Oost-Europa. Enkele duizenden Nederlandse boeren, vissers en bouwvakkers vertrokken vrijwillig naar de Baltische staten en Oekraïne. De NOC was vanaf 6 juni 1942 actief, maar in de loop van 1944 keerden de meeste NOC’ers terug naar Nederland wegens het oprukkende Sovjet leger."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/corporaties/4718>, <https://data.niod.nl/WO2_Thesaurus/20691>,
      <https://data.niod.nl/WO2_Thesaurus/20692>, <https://data.niod.nl/WO2_Thesaurus/20693>,
      <https://data.niod.nl/WO2_Thesaurus/20694>, <https://data.niod.nl/WO2_Thesaurus/20695>,
      <https://data.niod.nl/WO2_Thesaurus/20696>, <https://data.niod.nl/WO2_Thesaurus/21685>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/20640>;
    dcterms:created "2016-10-04T13:07:40.000Z"^^xsd:dateTime;
    skos:prefLabel "'Nederlandsche Oost Compagnie'"@de, "Dutch East Company"@en, "Nederlandsche Oost Compagnie"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Nederlandsche Oost Compagnie N.V. (NOC) werd op initiatief van Meinoud Rost van Tonningen op 6 juni 1942 opgericht. Het doel – kolonisatie door Germaanse pioniers uit Nederland – paste in de nazipolitiek van verovering van Lebensraum in het oosten en de germanisering van deze gebieden. Ondanks de belofte van gelijkberechtigdheid verliep de samenwerking met de Duitse autoriteiten zeer moeizaam. Vanwege de geringe medewerking van het Nederlandse bedrijfsleven, richtte het NOC zich voornamelijk op het werven van boeren en vissers. Na het op gang komen van de Russische tegenoffensieven, kwamen de werkzaamheden van de NOC nog verder onder druk te staan."@nl;
    skos:altLabel "Nederlandsche Oostcompagnie"@nl, "Nederlandse Oostcompagnie"@nl, "Nederlandsche Oost Compagnie N.V."@nl,
      "N.O.C."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/4605> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "NIOD"@nl;
