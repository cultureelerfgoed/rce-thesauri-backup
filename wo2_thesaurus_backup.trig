    dcterms:created "2023-08-30T12:23:40.980Z"^^xsd:dateTime;
    skos:prefLabel "Sturmscharführer"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De rang van SS-Sturmscharführer (afkorting: Stuscha.) in de SS en de Waffen-SS is vergelijkbaar met de rang van adjudant. De Waffen-SS was de militaire tak van de SS. Vanaf juni 1940 werden Nederlanders geworven voor de Waffen-SS."@nl;
    skos:altLabel "SS-Sturmscharführer"@nl, "SS Sturmscharführer"@nl, "Stuscha."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4717>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4886> .
  
  <https://data.niod.nl/WO2_Thesaurus/20281> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "NSB, Distinctieven der Beweging. Uitgegeven in opdracht van de Organisatieleider der N.S.B. (z.p. z.j.; oorlogsperiode) p. 20."@nl,
      "N.J.G. Sikkel (red.), Documentatie. Samengesteld ten behoeve van de Bijzondere Rechtspleging, op last van de Procureur-Fiscaal bij het Bijzonder Gerechtshof te Amsterdam (Amsterdam 1947) p. 191."@nl,
      "N.K.C.A. in ’t Veld, De SS en Nederland. Documenten uit SS-archieven 1935-1945. Deel 1 (Den Haag 1976) p. 248. "@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2025-07-31T14:09:48.585Z"^^xsd:dateTime;
    dcterms:source "https://nl.wikipedia.org/wiki/Nederlandsche_SS"@nl, "https://nl.wikipedia.org/wiki/Lijst_van_militaire_rangen_van_de_Schutzstaffel"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/19853>;
    dcterms:created "2023-08-30T12:26:07.197Z"^^xsd:dateTime;
    skos:prefLabel "Untersturmführer"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De rang van SS-Untersturmführer (afkorting: U'Stuf.) in de SS en de Waffen-SS is vergelijkbaar met de rang van tweede luitenant. De Waffen-SS was de militaire tak van de SS. Vanaf juni 1940 werden Nederlanders geworven voor de Waffen-SS. De rang onderstormleider in de Nederlandsche SS was het equivalent van de rang SS-Untersturmführer in de SS en de Waffen-SS. Deze rang was vergelijkbaar met de rang van tweede luitenant. Vanaf januari 1944 werden ook in de Nederlandsche SS de Duitse rangaanduidingen gebruikt. De rang onderstormleider in de Nederlandsche Landwacht was het equivalent van de rang SS-Untersturmführer in de SS en de Waffen-SS en werd ook in de Nederlandsche SS gebruikt. De rang onderstormleider was vergelijkbaar met de rang van tweede luitenant."@nl;
    skos:altLabel "UStuf"@nl, "SS Untersturmführer"@nl, "SS-Untersturmführer"@nl, "Onderstormleider"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2249>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4717>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/4521>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4886> .
  
