    dcterms:created "2016-08-01T19:19:09.000Z"^^xsd:dateTime;
    skos:prefLabel "Verwaltung"@de, "Governance"@en, "Bestuur"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:topConceptOf <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Bestuur is het besturen, het leiden en regelen van zaken en personen. Hier vooral in de context van (gemeentelijk) overheid."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2432>;
    skos:definition "Het Nederlandse bestuur bleef tijdens de bezetting grotendeels intact. De regering was, samen met de koningin, naar Londen gevlucht en vormde daar de regering in ballingschap. De andere bestuurders bleven vrijwel allemaal op hun plek zitten in de hoop de Duitse invloed te minimaliseren. In de loop van de bezetting werd het lokale bestuur in toenemende mate vervangen door NSB'er. Na de bevrijding werden zij afgezet en vond er een zuivering van het bestuur plaats."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/17052> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "H.A.J. van Rens, De vervolging van joden en Sinti tijdens de Tweede Wereldoorlog in de Nederlandse provincie Limburg (Amsterdam 2013)"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2022-02-09T10:25:28.658Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/17722>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/0/0b/2018-Maastricht%2C_Prof_P_Willemsstraat%2C_vm_Stercollege_02.jpg/1920px-2018-Maastricht%2C_Prof_P_Willemsstraat%2C_vm_Stercollege_02.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/w/index.php?title=File:2018-Maastricht,_Prof_P_Willemsstraat,_vm_Stercollege_02.jpg&oldid=465502075";
    <http://schema.org/startDate> "1942-08-25"^^xsd:date;
    dcterms:source "https://pure.uva.nl/ws/files/1726276/119638_07.pdf"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2005>, <https://data.niod.nl/WO2_Thesaurus/2056>;
    dcterms:created "2021-07-07T08:47:52.385Z"^^xsd:dateTime;
    skos:prefLabel "Eerste massale arrestatie van Limburgse Joden"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De eerste massale arrestatie van Limburgse Joden vond plaats op 25 augustus 1942. Joden die jonger waren dan zestig jaar kregen op 24 augustus een oproep om zich te melden voor \"arbeidsverruimende maatregelen\". Zij dienden zich een dag later te verzamelen in een schoolgebouw aan de Prof. Pieter Willemsstraat 39 in Maastricht. De opgeroepen Joden hadden daardoor een dag de tijd om onder te duiken of uitstel te krijgen. Er vertrokken minder dan 300 in plaats van de geplande 600 personen naar Kamp Westerbork. De meeste arrestanten werden op 28 augustus op transport naar het Oosten gezet. Dit was de eerste deportatietrein die stopte in Cosel. Mannen tussen de 16 en 50 jaar werden uit de trein gehaald en naar Joodse werkkampen gebracht. Het grootste deel van de vrouwen, kinderen en de mannen tussen 50 en 60 jaar werden op 31 augustus 1942 in Auschwitz vergast."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/5907>, <https://data.niod.nl/WO2_Thesaurus/17915>,
      <https://data.niod.nl/WO2_Thesaurus/events/17920>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/17053> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "De Ploert en de correcte ambtenaar. De rechtspleging tegen SS-kopstukken Hanns Albin Rauter en Wilhelm Harster, Th. Gerritse, scriptie augustus 2005. "@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:04:33.016Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/10236>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/8ed16644-200b-dbff-00b6-891ba87c3a25.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/d5050536-0259-11e7-904b-d89d6717b464/media/8ed16644-200b-dbff-00b6-891ba87c3a25";
    <http://schema.org/location> "München";
    <http://schema.org/startDate> "1967-01-23"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/wiki/Wilhelm_Harster#cite_note-7"@nl;
    skos:relatedMatch <https://data.niod.nl/WO2_biografieen/Wilhelm-Harster>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2611>;
    dcterms:created "2021-07-07T11:09:24.497Z"^^xsd:dateTime;
    skos:prefLabel "Tweede proces tegen Wilhelm Harster"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het tweede proces tegen Wilhelm Harster vond plaats op 23 januari 1967 in München. Harster was in verband met een gerechtelijk vooronderzoek in 1963 met vervroegd pensioen gegaan, maar werd in januari 1966 gearresteerd. In 1967 werd hij medeverantwoordelijk gesteld voor de moord op 83.000 Nederlandse Joden en veroordeeld tot 15 jaar cel. In augustus 1968 werd Harster vrijgelaten wegens getoond berouw tijdens zijn proces. De universiteit van München ontnam hem wel officieel zijn doctorstitel. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/16971>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/17054> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:24:12.665Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/15067>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/da68741d-f564-b71f-49e5-29249149b8ca.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/e5599956-0259-11e7-904b-d89d6717b464/media/da68741d-f564-b71f-49e5-29249149b8ca";
    <http://schema.org/location> "Neurenberg";
    <http://schema.org/startDate> "1947-11-15"^^xsd:date;
    <http://schema.org/endDate> "1949-04-13"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/wiki/Wilhelmstra%C3%9Fenproces"@nl, "https://en.wikipedia.org/wiki/Ministries_Trial"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/4399>;
    dcterms:created "2021-07-07T12:22:52.546Z"^^xsd:dateTime;
    skos:prefLabel "Wilhelmstrassenproces"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "De officiële benaming van het Wilhelmstrassenproces was The United States of America vs. Ernst von Weizsäcker, et al. Het begon op 15 november 1947 en de vonissen werden op 13 april 1949 uitgesproken. Het was het voorlaatste en omvangrijkste proces van de Neurenberg processen. De 21 gedaagden waren voormalige medewerkers van het ministerie van Buitenlandse Zaken, gevestigd aan de Wilhelmstrasse in Berlijn, en enkele andere ministeries. President van het hof was William C. Christianson. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/17055> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:04:45.646Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/16496>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/bb045ef5-37c9-cb64-4f15-ac988fa2f278.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/9fbb99de-025a-11e7-904b-d89d6717b464/media/bb045ef5-37c9-cb64-4f15-ac988fa2f278";
    <http://schema.org/location> "Benschop";
    <http://schema.org/startDate> "1945-02-13"^^xsd:date;
    dcterms:source "https://www.historischnieuwsblad.nl/boeken-het-verraad-van-benschop-bram-de-graaff/"@nl,
      "https://www.anderetijden.nl/aflevering/70/Verraad-in-Benschop"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2666>;
    dcterms:created "2021-07-07T13:38:34.238Z"^^xsd:dateTime;
    skos:prefLabel "Verraad van Benschop"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Na verraad werden op 13 februari 1945 in Benschop meer dan vijftig personen door de Duitsers gearresteerd. Op 4 september 1944 waren alle verzetsmensen en onderduikers met elkaar op de foto gegaan omdat de bevrijding aanstaande leek. Afdrukken waren verspreid. Tijdens de razzia van de Duitsers ontstond er een vuurgevecht bij twee onderduikers, Theo Klever en Herman Struik. Hierbij werden drie Duitse soldaten gedood. Uit wraak executeerden de Duitsers vier dagen later zeven gearresteerde verzetsstrijders langs de openbare weg. Passerende dorpelingen werden gedwongen naar de lijken te kijken."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/17057> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-06-03T13:01:41.774Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8020>;
