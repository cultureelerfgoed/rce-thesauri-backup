    dcterms:created "2023-08-10T12:10:27.984Z"^^xsd:dateTime;
    skos:prefLabel "Bombardement op Keulen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Het Bombardement op Keulen vond plaats in de nacht van 28 op 29 juni 1943 door de Britse RAF. Er deden ruim 600 vliegtuigen mee aan deze aanval, het was het meest verwoestende en dodelijke bombardement tot dan toe. Er gingen 25 vliegtuigen verloren, waarvan een aantal in bezet Nederland neerstorten."@nl .
  
