    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/259cf51c-025a-11e7-904b-d89d6717b464/media/0af26c96-d37f-08a2-3cd5-2dddf13a42a8";
    <http://schema.org/location> "Terneuzen";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/25992b62-025a-11e7-904b-d89d6717b464/media/39eed74a-b8ad-1483-3eec-d5d3922c245d>,
