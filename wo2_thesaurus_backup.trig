    skos:prefLabel "Secretaris-Generaal"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De rang van secretaris-generaal werd in de zomer van 1940 ingevoerd in de NSB. Met zijn benoeming tot secretaris-generaal nam Carolus Huygen veel van de bevoegdheden van Kees van Geelkerken als plaatsvervangend leider over. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2244> .
  
  <https://data.niod.nl/WO2_Thesaurus/20059> a <http://schema.org/Thing>, skos:Concept;
