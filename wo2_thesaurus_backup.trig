  <https://data.niod.nl/WO2_Thesaurus/corporaties/6056> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "L.E. Winkel, De ondergrondse pers, 1940-1945. 3e dr., geheel herz. / door Hans de Vries (Utrecht: Veen, 1989) (nr. 270)"@nl;
