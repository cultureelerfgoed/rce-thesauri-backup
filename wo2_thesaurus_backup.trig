    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/19853>;
    dcterms:created "2023-08-31T07:56:40.823Z"^^xsd:dateTime;
    skos:prefLabel "Inspecteur-Generaal"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De rang inspecteur-generaal was de hoogste rang in de Nederlandsche Landwacht. Hij stond aan het hoofd van deze organisatie. De rang van de inspecteur-generaal werd bekleed door de tweede man van de NSB Kees van Geelkerken. De inspecteur-generaal stond onder direct bevel van Rauter als Höhere SS- und Polizeiführer."@nl;
    skos:altLabel "Inspecteur-Generaal Nederlandsche Landwacht"@nl, "Inspecteur-Generaal van de Nederlandsche Landwacht"@nl,
      "Inspecteur-Generaal der Nederlandsche Landwacht"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2249> .
  
  <https://data.niod.nl/WO2_Thesaurus/20298> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "N.K.C.A. in ’t Veld, De SS en Nederland. Documenten uit SS-archieven 1935-1945. Deel 2 (Den Haag 1976) p. 1461-1463."@nl,
