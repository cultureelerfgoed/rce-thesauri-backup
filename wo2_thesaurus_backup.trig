    <http://schema.org/startDate> "1944-09-22"^^xsd:date;
    <http://schema.org/endDate> "1945-01-14"^^xsd:date;
    dcterms:source "https://mijngelderland.nl/inhoud/verhalen/frontstad-tiel"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1922>, <https://data.niod.nl/WO2_Thesaurus/events/4391>;
    dcterms:created "2019-02-26T09:38:28.000Z"^^xsd:dateTime;
    skos:prefLabel "Evacuatie van Tiel 1944-1945"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Evacuatie van Tiel van 1944-1945 vond plaats tussen 22 september 1944 en 14 januari 1945. Na het mislukken van operatie Market-Garden in september 1944 ontstond er tussen de Duitse troepen en de geallieerden een patstelling en liep het front liep dwars door de Betuwe. De eerste Tielenaren moesten op 22 september 1944 evacueren. Er volgenden nog een evacuatie op 17 november 1944 en op 8 januari 1945 werden de laatste inwoners gedwongen naar Friesland te vertrekken. Inwoners van Tiel keerden vanaf juni 1945 terug naar huis. Het centrum van Tiel werd grotendeels verwoest door de geallieerden."@nl;
    skos:altLabel "Evacuatie van Echteld"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/7888> a <http://schema.org/Thing>, skos:Concept,
