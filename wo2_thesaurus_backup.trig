    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/022c04f0-025b-11e7-904b-d89d6717b464/media/0241b7c7-7c85-0c66-3ee4-ff0fdc2c4479";
    <http://schema.org/startDate> "1940-09-26"^^xsd:date;
    <http://schema.org/endDate> "1946-07-26"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1870>;
    dcterms:created "2021-09-29T09:10:25.433Z"^^xsd:dateTime;
    skos:prefLabel "Instelling Commissie Onderscheidingen Koopvaardij"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Op 26 september 1940 werd door de Nederlandse regering de 'Commissie tot het beoordeelen van daden van heldhaftigheid betoond door personeel der koopvaardij', later de Commissie Onderscheidingen Koopvaardij (COK) ingesteld. Door de voordrachten van de commissie werden in de periode tussen 1940-1946, 645 dapperheidsonderscheidingen uitgereikt aan bemanningsleden. Dit waren o.a. de Militaire Willemsorde, de Bronzen Leeuw, het Bronzen kruis en het Kruis van Verdienste. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/1883>, <https://data.niod.nl/WO2_Thesaurus/18416>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
