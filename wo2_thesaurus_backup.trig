    <https://data.niod.nl/organizationsWO2/startDate> "1942-03-13"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/5a0e7488-025a-11e7-904b-d89d6717b464/media/7d704266-5a48-1836-85fb-3d5374f5b8bc>;
