    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/6411>;
    dcterms:created "2018-07-13T10:58:27.000Z"^^xsd:dateTime;
    skos:prefLabel "Stalag VI-C"@nl, "Stalag VI-C"@de, "Stalag VI-C"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Stalag VI-C Bathorn was een krijgsgevangenkamp dat in juni 1938 als strafkamp Bathorn werd gebouwd. Het lag halverwege Hardenberg en Lingen. In 1939 nam de Wehrmacht het over voor de huisvesting van krijgsgevangenen en werd het Stalag VI-C Bathorn. Stalag VI-C kreeg meerdere kampen als dependances. In het kader van de Emslandlager stond het kamp bekend als Lager XIV Bathorn. De onder Stalag VI-C vallende kampen hadden gezamenlijk 27.313 gevangenen. Kamp Bathorn werd in april 1945 door de Canadezen bevrijd."@nl;
    skos:altLabel "Stalag VI C"@nl, "Stalag VI-C Bathorn"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/6446> a <http://schema.org/Thing>, skos:Concept,
