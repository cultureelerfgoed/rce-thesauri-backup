    <http://schema.org/startDate> "1945-05-07"^^xsd:date;
    dcterms:source "https://www.geheugenvanzeist.nl/articles/bevrijding-van-zeist/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/6983>;
    dcterms:created "2021-06-16T14:01:53.334Z"^^xsd:dateTime;
    skos:prefLabel "Bevrijding Zeist"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De bevrijding van Zeist vond plaats op 7 mei 1945. De Polar Bears, de 49e Britse Infanterie Divisie van het 1e Canadese Legerkorps, trokken via de Driebergseweg en de Dorpsstraat Zeist binnen. De bevrijders werden op 2 juni met een defilé en volksspelen bedankt."@nl .
  
