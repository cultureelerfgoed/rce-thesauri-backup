    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/5008>, <https://data.niod.nl/WO2_Thesaurus/events/events/7595>;
    dcterms:created "2022-05-20T08:06:40.164Z"^^xsd:dateTime;
    skos:prefLabel "Transport Westerbork - Bergen-Belsen - Theresienstadt, 14-09-1943"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:exactMatch <https://digitaalerfgoed.poolparty.biz/westerbork/2711>;
    skos:scopeNote "Dit transport omvatte 305 mensen. Er zaten veel Duitse emigranten op dit transport dat bestemd was voor Theresienstadt, maar omdat dat kamp overvol was werden zij eerst naar Bergen-Belsen gebracht. Op 25 januari 1944 werden 283 van hen alsnog naar Theresienstadt overgebracht."@nl .
  
