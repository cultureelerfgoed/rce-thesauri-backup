    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/9582>;
    <http://schema.org/location> "Den Haag";
    <http://schema.org/startDate> "1942-05-01"^^xsd:date;
    <http://schema.org/endDate> "1943-12-31"^^xsd:date;
    dcterms:source "https://atlantikwalldenhaag.nl/nl/story/vesting-scheveningen"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/7298>, <https://data.niod.nl/WO2_Thesaurus/1922>;
    dcterms:created "2022-01-05T14:27:02.513Z"^^xsd:dateTime;
    skos:prefLabel "Evacuaties van Den Haag"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Evacuaties van Den Haag vonden plaats tussen mei 1942 en januari 1944. Om ruimte te maken voor de Duitse verdedigingswerken van de Atlantik Wall - waaronder een 6 kilometer lange verdedigingslinie met tankgracht die dwars door Den Haag liep - werden ongeveer 143.000 mensen geëvacueerd en 2.400 woningen gesloopt. Werkenden werden elders in Den Haag ingekwartierd. Niet-werkenden moesten vertrekken naar diverse evacuatieoorden in het noorden en oosten van het land, zoals Doetinchem en Lochem. Vanaf de zomer van 1943 keerden steeds meer inwoners van Duindorp en Scheveningen terug naar hun woningen. Een deel van hen werd in het najaar van 1943 opnieuw geëvacueerd."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/4330> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/18565> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Geert-Jan Mellink, Verdreven voor de Atlantikwall. Ontruiming en afbraak van de Nederlandse kuststreek, 1942-1945 (Wbooks: Zwolle, 2016)"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    dcterms:modified "2022-02-01T12:57:15.341Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/11233>;
    <http://schema.org/location> "Katwijk aan Zee";
    <http://schema.org/startDate> "1942-06-01"^^xsd:date;
    <http://schema.org/endDate> "1944-07-31"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/7298>, <https://data.niod.nl/WO2_Thesaurus/1922>;
    dcterms:created "2022-01-05T14:33:03.060Z"^^xsd:dateTime;
    skos:prefLabel "Evacuaties van Katwijk"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Evacuaties van Katwijk waren 4 grootschalige evacuaties tussen 1 juni 1942 en juli 1944. In totaal werden ongeveer 6.200 inwoners van de kuststrook - de boulevard en omliggende straten - geëvacueerd. Ongeveer 2.200 inwoners vonden onderdak binnen Katwijk. De rest werd ondergebracht in Drenthe, Gelderland, Overijssel en Groningen. Tussen augustus 1943 en augustus 1944 werden 563 woningen gesloopt om ruimte te maken voor Duitse verdedigingswerken. Op de boulevard werden alleen de kerk en de vuurtoren gespaard."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/4330> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/18566> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
