      <https://data.niod.nl/WO2_Thesaurus/9234>, <https://data.niod.nl/WO2_Thesaurus/corporaties/6189>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2552>, <https://data.niod.nl/WO2_Thesaurus/2789>;
    dcterms:created "2016-08-01T19:21:14.000Z"^^xsd:dateTime;
    skos:prefLabel "Juden"@de, "Jews"@en, "Joden"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Joden zijn mensen die behoren tot het joodse volk en/of het joodse geloof aanhangen. De joden leefden volgens de Bijbelse overlevering gedurende ten minste drieduizend jaar in de regio Palestina, waar het een monotheïstische religie (het Jodendom) ontwikkelde en meerdere malen zelfbeschikking genoot. De Joden werden na een opstand door de Romeinen vrijwel geheel uit Palestina verbannen en raakten verspreid over de wereld."@nl;
    skos:altLabel "Israëlieten"@nl, "Joodse volk"@nl, "Volk Israël"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2017>, <https://data.niod.nl/WO2_Thesaurus/2028>,
      <https://data.niod.nl/WO2_Thesaurus/5129>, <https://data.niod.nl/WO2_Thesaurus/5326>,
      <https://data.niod.nl/WO2_Thesaurus/1670> .
  
  <https://data.niod.nl/WO2_Thesaurus/2806> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "Carolus Reijnders, Van 'Joodsche natiën' tot Joodse Nederlanders: een onderzoek naar getto- en assimilatieverschijnselen tussen 1600 en 1942 (z.p. 1970)"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:17:35.580Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/nda/thumb/640x480/ea85e215-9549-8816-ea95-985684e67f77.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://nimh-beeldbank.defensie.nl/memorix/4b945b6c-eb18-11df-a391-13966e870614";
    dcterms:source "http://www.cultureelwoordenboek.nl/psychologie-en-sociologie/assimilatie"@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/demoadmin>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2805>;
    dcterms:created "2016-08-01T19:21:14.000Z"^^xsd:dateTime;
    skos:prefLabel "Assimilation"@de, "Assimilation"@en, "Assimilatie"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Assimilatie is een proces van aanpassing aan een dominante cultuur waarbij de oorspronkelijke culturele identiteit van individuen of groepen naar de achtergrond gedrongen wordt. In het geval van de Joodse bevolkingsgroep betekent assimilatie het verliezen van de binding met het jodendom door bijvoorbeeld met een niet-jood te trouwen, de eigen omgangstaal op te geven of een andere religie te kiezen."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/2818> a <http://schema.org/Thing>, skos:Concept;
