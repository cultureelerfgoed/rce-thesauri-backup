    dcterms:created "2020-03-20T12:34:16.000Z"^^xsd:dateTime;
    skos:prefLabel "Hradischko"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote """Aussenlager Hradischko (Hradištko) was van 17 november 1943 tot 26 april 1945 een buitenkamp van Flossenbürg, waar aanvankelijk Duitse gevangenen en vanaf maart 1944 ook Fransen, Spanjaarden, Italianen, Russen en Polen tewerkgesteld waren aan de bouw van de SS-Truppenübungsplatz Böhmen. De gevangen werden ondergebracht in de barakken van een voormalig Arbeitserziehungslager.
"""@nl;
    skos:altLabel "Aussenlager Hradischko"@nl, "Hradištko"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/8842> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "49.666943"^^xsd:float;
