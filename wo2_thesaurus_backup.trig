    <http://schema.org/location> "Nieuwegein";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://hetutrechtsarchief.nl/collectie/DBDA76DD4F8E5BBF9ED83E744057B425>;
    <http://schema.org/startDate> "1945-05-07"^^xsd:date;
    dcterms:source "https://www.pen.nl/artikel/slachtoffers-mogen-niet-vergeten-worden"@nl,
      "https://www.ad.nl/utrecht/ad-van-liempt-vertelt-hoe-een-aangeschoten-duitse-militair-twee-dagen-na-de-bevrijding-een-drama-veroorzaakte-in-nieuwegein~ab3f63c2/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/6983>;
    dcterms:created "2021-06-16T14:16:57.443Z"^^xsd:dateTime;
    skos:prefLabel "Bevrijding Nieuwegein"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De bevrijding van Nieuwegein vond plaats op 7 mei 1945. Inwoners stonden langs de Herenstraat te wachten op de komst van de Canadezen toen een aangeschoten Duitse militair op een motor met een automatisch pilstool op het publiek dreigde in te rijden. De Binnenlandse Strijdkrachten (BS) grepen in en doodden de Duitser. De Duitsers die nog in kasteel Rijnhuizen zaten reageerden hierop en dit kostte drie burgers en twee verzetslieden het leven."@nl .
  
