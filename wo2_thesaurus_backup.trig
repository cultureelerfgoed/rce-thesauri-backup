    dcterms:source "https://en.wikipedia.org/w/index.php?title=Argelers_concentration_camp&oldid=1256866194"@nl,
      "https://www.museuexili.cat/en/museum/argeles-1939"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
