    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/6609>, <https://data.niod.nl/WO2_Thesaurus/events/6983>;
