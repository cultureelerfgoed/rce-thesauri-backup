    <http://schema.org/endDate> "1943-01-15"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1922>, <https://data.niod.nl/WO2_Thesaurus/events/4330>;
    dcterms:created "2022-01-05T15:21:52.687Z"^^xsd:dateTime;
    skos:prefLabel "Evacuatie van gezondheidsinstellingen kuststreek"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Evacuatie van gezondheidsinstellingen in de kuststreek vond plaats tussen juni 1942 en 15 januari 1943. Sanatoria, tehuizen en instellingen voor geestelijk en lichamelijk gehandicapten moesten worden ontruimd vóór 15 januari 1943. Ongeveer 6.000 patiënten werden geëvacueerd naar instellingen in het zuiden, noorden en oosten van Nederland. De evacuatie leidde tot overbevolking van instellingen, tekorten aan personeel, voedsel en andere voorzieningen en in sommige gevallen hogere sterftecijfers."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/18573> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Geert-Jan Mellink, Verdreven voor de Atlantikwall. Ontruiming en afbraak van de Nederlandse kuststreek, 1942-1945 (Wbooks: Zwolle, 2016)"@nl;
