      <https://data.niod.nl/WO2_Thesaurus/locations/10155>, <https://data.niod.nl/WO2_Thesaurus/6141>;
    dcterms:created "2019-03-11T13:22:58.000Z"^^xsd:dateTime;
    skos:prefLabel "Fort Asperen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Bij Fort Asperen (onderdeel Nieuwe Hollandse Waterlinie) werden op 12 april 1940 voor de laatste keer de inundaties gesteld en werd het fort oorlogsgereed gemaakt. De Nieuwe Hollandse Waterline bleek niet bestand tegen de moderne oorlogsvoering en de Duitse Luftwaffe passeerde de 19e- eeuwse defensiewerken zonder problemen en dropten hun parachutisten ver achter de Linie. Hoewel het militaire nut van de Waterlinie en ook Fort Asperen hiermee voorbij was werd het fort wel nog gebruikt als doorgangsplaats voor onderduikers."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/locations/8033> a <http://schema.org/Thing>, skos:Concept,
