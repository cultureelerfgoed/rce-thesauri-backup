    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/2/28/Tuskegee_Airmen_-_Circa_May_1942_to_Aug_1943.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/w/index.php?title=File:Tuskegee_Airmen_-_Circa_May_1942_to_Aug_1943.jpg&oldid=323501435";
    dcterms:source "https://en.wikipedia.org/w/index.php?title=Tuskegee_Airmen&oldid=1109021846"@en;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4698>;
    dcterms:created "2022-09-22T07:56:23.592Z"^^xsd:dateTime;
    skos:prefLabel "Tuskegee Airmen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Tuskegee Airmen was een gesegregeerd onderdeel van de USAAF. De groep bestond uit de 332nd Fighter Group, de reserve 477th Bombardment Group en de 99th Flying Training Squadron en waren de eerste gevechtseenheden van de Amerikaanse luchtmacht waarin Afro-Amerikaanse piloten en bemanningsleden mochten dienen. Het Amerikaanse leger was gesegregeerd en vaak werden zwarte militairen racistisch bejegend en in niet-gevechtseenheden ingedeeld. De Tuskegee Airmen waren betrokken bij diverse missies in Zuid- en Centraal-Europa."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
