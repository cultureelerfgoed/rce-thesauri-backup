    skos:prefLabel "De duikbode; vrije wereld nieuws"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het illegale blad De Duikbode: Vrije Wereld Nieuws werd van 7 juni 1944 tot en met 3 oktober 1944 uitgegeven in Amsterdam door A.J. Sarluy, H. Drukker en J. Zillisen."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8749> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "PPN: 269244980"@nl;
