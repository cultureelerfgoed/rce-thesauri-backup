    dcterms:created "2020-10-16T12:11:32.516Z"^^xsd:dateTime;
    skos:prefLabel "Luchtlandingen Ginkelse Heide"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Ginkelse Heide bij Ede was een belangrijke plek voor de geallieerde luchtlandingen tijdens operatie Market Garden. Hier stonden de geallieerden tegenover Nederlandse Waffen-SS'ers. Geallieerde parachutisten werden gedropt vanuit talloze vliegtuigen op deze open vlakte tussen Ede en Wolfheze, waarna ze moesten oprukken naar Arnhem om de Rijnbrug te veroveren. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
