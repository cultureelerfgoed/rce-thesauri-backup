    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://en.wikipedia.org/wiki/SS_Blitar#/media/File:HMS_Eclipse_WWII_IWM_FL_11548.jpg";
    <http://schema.org/location> "Atlantische Oceaan";
    <http://schema.org/startDate> "1943-04-05"^^xsd:date;
    dcterms:source "https://en.wikipedia.org/wiki/SS_Blitar"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3511>;
    dcterms:created "2021-11-08T14:25:26.619Z"^^xsd:dateTime;
    skos:prefLabel "Scheepsramp Blitar"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Scheepsramp met de Blitar vond plaats op 5 april 1943. De Blitar was een Nederlands schip van de Rotterdamsche Lloyd dat in konvooi HX 231 op 25 maart uit New York vertrok naar Engeland. Vanaf 4 april werd het konvooi aangevallen door het Duitse wolfpack 'Löwenherz', bestaande uit 21 U-boten. Hierop besloot de onervaren kapitein W.E. Knip om het konvooi te verlaten. De Blitar werd door drie U-boten achtervolgd. Op 5 april werd het getorpedeerd en tot zinken gebracht. Kapitein Krüger van de U 631 gebood de kapitein van de Blitar aan boord te komen. Na zijn vrijlaten kon Knip niet bereikt worden door de sloepen en verdronk hij in zee. 26 bemanningsleden overleefden de ramp niet."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/1870> .
  
