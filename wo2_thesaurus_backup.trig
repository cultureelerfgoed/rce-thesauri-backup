    skos:narrower <https://data.niod.nl/WO2_Thesaurus/events/7836>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4717>, <https://data.niod.nl/WO2_Thesaurus/1613>,
      <https://data.niod.nl/WO2_Thesaurus/20640>;
    dcterms:created "2019-02-13T10:58:35.000Z"^^xsd:dateTime;
    skos:prefLabel "Divisie Germania"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Divisie Germania werd op 9 november 1940 gevormd door SS-Brigadeführer Felix Steiner. Het was samengesteld uit de SS-Standarte Nordland (hoofdzakelijk Denen en Noren), SS-Standarte Germania (hoofdzakelijk Duitsers) en SS-Standarte Westland (hoofdzakelijk Nederlanders). Op 21 december 1940 veranderde Hitler de naam van de divisie in Wiking."@nl;
    skos:altLabel "SS-Division Germania"@nl, "SS-Panzer-Division Germania"@de, "Regiment Germania"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/7830>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7838> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "N.K.C.A. in 't Veld, De SS en Nederland. Documenten uit SS-archieven 1935-1945. Deel 1 (Den Haag 1976) 332-333."@nl;
