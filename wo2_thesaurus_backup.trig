    dcterms:created "2020-03-20T12:24:00.000Z"^^xsd:dateTime;
    skos:prefLabel "Hainichen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote """Aussenlager Hainichen was van 8 september 1944 tot midden april 1945 een buitenkamp van Flossenbürg gevestigd in een voormalige naaldenfabriek. De ongeveer 500 vooral Poolse en Hongaarse Joodse vrouwen werden in de Framo-Werke GmbH (elders in Hainichen) tewerkgesteld bij de metaalarbeid aan machineweren en mortieren.

"""@nl;
    skos:altLabel "Aussenlager Hainichen"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/8838> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2020-10-02T08:46:11.000Z"^^xsd:dateTime;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/3665>, <https://data.niod.nl/WO2_Thesaurus/1670>,
      <https://data.niod.nl/WO2_Thesaurus/8176>;
    dcterms:created "2020-03-20T12:24:09.000Z"^^xsd:dateTime;
    skos:prefLabel "Helmbrechts"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Aussenlager Helmbrechts was van 14 juli 1944 tot 13 april 1945 een buitenkamp van Flossenbürg. Ongeveer 680 vrouwen uit concentratiekamp Ravensbrück werden in een stilgelegde textielfabriek tewerkgesteld bij de fabricage van kabels en munitie voor de wapenfabriek Kabel- und Metallwerke Neumeyer in Neurenberg. De vrouwen waren eerst in de fabriek ondergebracht en later een kilometer daarvandaan in een barakkenkamp. Op 6 maart 1945 arriveerde een dodenmars van 621 Joodse, hoofdzakelijk Hongaarse, vrouwen uit het Aussenlager Grünberg (buitenkamp van Gross-Rosen)."@nl;
    skos:altLabel "Aussenlager Helmbrechts"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/8839> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "50.603056"^^xsd:float;
    <http://www.w3.org/2003/01/geo/wgs84_pos#long> "13.906667"^^xsd:float;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2020-10-02T08:50:09.000Z"^^xsd:dateTime;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/3665>, <https://data.niod.nl/WO2_Thesaurus/1670>,
      <https://data.niod.nl/WO2_Thesaurus/8176>;
    dcterms:created "2020-03-20T12:24:29.000Z"^^xsd:dateTime;
    skos:prefLabel "Hertine"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Aussenlager Hertine (nu Rtyně nad Bílinou,Tsjechië) was van 10 oktober 1944 tot midden april 1945 een buitenkamp van Flossenbürg gevestigd in een barakkenkamp in het bos. 600 Joodse Hongaarse vrouwen uit concentratiekamp Auschwitz-Birkenau werden tewerkgesteld bij het vullen van hulzen met buskruit en fosfor voor de Gesellschaft zur Verwertung Chemischer Erzeugnisse Hertine GmbH, een dochteronderneming van Dynamit Nobel AG. Een kleine groep verricht landarbeid. Die Frauen sind in einem umzäunten Barackenlager im Wald untergebracht."@nl;
    skos:altLabel "Rtyně nad Bílinou"@nl, "Aussenlager Hertine"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/8840> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "50.289152"^^xsd:float;
    <http://www.w3.org/2003/01/geo/wgs84_pos#long> "11.929480"^^xsd:float;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2020-10-02T08:50:38.000Z"^^xsd:dateTime;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/3665>, <https://data.niod.nl/WO2_Thesaurus/1670>,
      <https://data.niod.nl/WO2_Thesaurus/8176>;
    dcterms:created "2020-03-20T12:31:51.000Z"^^xsd:dateTime;
    skos:prefLabel "Hof-Moschendorf"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote """Aussenlager Hof-Moschendorf was van 3 september 1944 tot 14 april 1945 een buitenkamp van Flossenbürg. Ruim honderd gevangenen, vooral uit Duitsland, Polen en Rusland, waren in een stilgelegde porceleinfabriek tewerkgesteld bij het repareren van wapens voor het SS-Hauptzeugamt.

"""@nl;
    skos:altLabel "Aussenlager Hof-Moschendorf"@nl, "Aussenlager Moschendorf"@nl, "Moschendorf"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/8841> a <http://schema.org/Thing>, skos:Concept,
