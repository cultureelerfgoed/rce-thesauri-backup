    <http://schema.org/startDate> "1945-02-02"^^xsd:date;
    dcterms:source "https://wikimiddenbrabant.nl/Explosie_V1_Mari%C3%ABngaarde,_Burgemeester_Damsstraat,_2_februari_1945"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/19539>;
    dcterms:created "2025-10-08T08:08:18.577Z"^^xsd:dateTime;
    skos:prefLabel "V-1 inslag Mariëngaarde Tilburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De inslag van een Duitse V-1 op Mariëngaarde in Tilburg vond plaats op 2 februari 1945. Rond 9.00 uur stort een V-1 neer achter de woning aan de Burgemeester van Meursstraat 4. De nabijgelegen keuken en kapel van pension Mariëngaarde worden hierbij verwoest. Er vallen tweeëntwintig doden en tientallen gewonden. De materiële schade is enorm."@nl .
  
