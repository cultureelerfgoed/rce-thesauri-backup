    <http://schema.org/location> "Rhenen";
    <http://schema.org/startDate> "1940-05-10"^^xsd:date;
    <http://schema.org/endDate> "1940-05-15"^^xsd:date;
    dcterms:source "https://www.canonvannederland.nl/nl/utrecht/zuidoost/slag-om-de-grebbeberg/verdieping/de-evacuatie-van-rhenen"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1922>, <https://data.niod.nl/WO2_Thesaurus/2322>;
    dcterms:created "2022-01-06T11:13:02.196Z"^^xsd:dateTime;
    skos:prefLabel "Evacuatie van Rhenen 1940"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Evacuatie van Rhenen van 1940 vond plaats op 10 mei 1940. De evacuatie van 6.500 inwoners was goed voorbereid. Ongeveer 500 inwoners bleven achter voor noodzakelijke diensten. Per boot moesten de evacués naar Goeree en Overflakkee worden vervoerd. Door gevechten rond Rotterdam was dit niet mogelijk en de evacués werden uiteindelijk rond Krimpen aan de Lek ondergebracht."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/18582> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:01:27.858Z"^^xsd:dateTime;
