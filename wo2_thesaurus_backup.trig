    <http://schema.org/startDate> "1940-09-24"^^xsd:date;
    dcterms:source "https://hetutrechtsarchief.nl/onderzoek/resultaten/archieven?mivast=39&mizig=210&miadt=39&miaet=1&micode=1312&minr=5264883&miview=inv2"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/11463>;
    dcterms:created "2021-04-13T09:27:50.628Z"^^xsd:dateTime;
    skos:prefLabel "Oprichting Rijksarbeidsbureau"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Bij Besluit d.d. 24 september 1940 werd door R.A. Verwey, waarnemend secretaris-generaal van het Ministerie van Sociale Zaken met steun van de Duitsers, het Rijksarbeidsbureau (RAB) opgericht. De Duitse bezetter wilde het vooroorlogse systeem met gemeentelijke arbeidsbeurzen vervangen door een Rijksarbeidsbemiddelingssysteem. Het hoofdbureau was eerst in Den Haag gevestigd, later in Amsterdam."@nl;
    skos:altLabel "RAB"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/11465> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:25:24.413Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/4e454c8d-ba50-454b-e891-b40325235fe5.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/e12b2cbe-0259-11e7-904b-d89d6717b464/media/4e454c8d-ba50-454b-e891-b40325235fe5";
    dcterms:source "https://hetutrechtsarchief.nl/onderzoek/resultaten/archieven?mivast=39&mizig=210&miadt=39&miaet=1&micode=1312&minr=5264883&miview=inv2"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2360>;
    dcterms:created "2021-04-13T10:04:53.322Z"^^xsd:dateTime;
    skos:prefLabel "De Sauckelacties"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "Eind maart 1942 benoemde Hitler Fritz Sauckel tot Generalbevollmächtiger für den Arbeitseinsatz. De Duitse oorlogseconomie had een toenemende behoefte aan arbeidskrachten. F. Schmidt werd de vertegenwoordiger voor Sauckel in Nederland. Na de benoeming van Sauckel volgden er kort op elkaar een aantal Duitse acties, de zogenaamde Sauckelacties. De eerste actie werd op 14 april 1942 genomen: er moesten vóór 15 mei 1942 30.000 metaalarbeiders worden geleverd. De tweede actie volgde in augustus 1942: 38.000 arbeiders voor de Duitse bewapeningsindustrie. De derde actie was in november 1942: levering van 35.000 arbeiders en 25.000 personen door de overheid en uit studentenkringen. In januari 1943 kwam de vierde actie: vóór 10 maart 1943 levering van 100.000 arbeiders waarvan 22.000 metaalarbeiders. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/8186> .
  
  <https://data.niod.nl/WO2_Thesaurus/11466> a <http://schema.org/Thing>, skos:Concept,
