    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Razzia_van_Amsterdam&oldid=52599779"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2005>, <https://data.niod.nl/WO2_Thesaurus/5110>,
      <https://data.niod.nl/WO2_Thesaurus/2056>;
    dcterms:created "2018-11-14T07:50:14.000Z"^^xsd:dateTime;
    skos:prefLabel "Razzia van Amsterdam"@nl, "Erste Razzia in Amsterdam"@de, "First Raid in Amsterdam"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Razzia van Amsterdam vond plaats op 22 en 23 februari 1941. Het was de eerste grootschalige razzia in bezet Nederland. 390 Joodse mannen werden opgepakt in de Jodenbuurt en op het Jonas Daniel Meijerplein en het Waterlooplein verzameld. Vanaf daar werden ze via Kamp Schoorl naar Buchenwald en Mauthausen gedeporteerd. Slechts twee mannen overleefden. De razzia vormde de aanleiding voor de Februaristaking."@nl;
    skos:altLabel "1e Razzia in Amsterdam"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/8446>, <https://data.niod.nl/WO2_Thesaurus/events/2662>,
      <https://data.niod.nl/WO2_Thesaurus/events/7690>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/7452> a <http://schema.org/Thing>, skos:Concept,
