    skos:prefLabel "Wachtmeester der Rijkspolitie"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560> .
  
  <https://data.niod.nl/WO2_Thesaurus/20963> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "M.H. Severein, Alles is gedaan om het recht te vinden. Bijzondere rechtspleging in Leeuwarden 1945-1949 (Hilversum: Uitgeverij Verloren, 2017), 223, 263-264."@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2025-05-13T13:24:24.070Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Een Rijkswerkinrichting was een overheidsinstelling waar veroordeelden dwangarbeid verrichtten. Rijkswerkinrichtingen bestonden al lang voor de Tweede Wereldoorlog. Binnen de bijzondere rechtspleging kon een rechter bepalen dat een veroordeelde de gevangenisstraf (deels) in een rijkswerkinrichting moest uitzitten."@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2354>;
    dcterms:created "2024-05-24T09:34:33.257Z"^^xsd:dateTime;
    skos:prefLabel "Rijkswerkinrichting"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560> .
  
