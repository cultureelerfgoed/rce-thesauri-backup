    <http://schema.org/endDate> "1943-02-28"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/6086>, <https://data.niod.nl/WO2_Thesaurus/events/9118>;
    dcterms:created "2022-03-09T14:03:36.180Z"^^xsd:dateTime;
    skos:prefLabel "Eerste razzia Berg-Stichting"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Eerste razzia van de Berg-Stichting vond plaats in februari 1943. Nadat 53 bewoners in Laren werden uitgeschreven en er in korte tijd veel bewoners werden ingeschreven op het adres op het Rapenburg, deden de Duitsers een inval. Directeur Jan Reitsema probeerde de razzia te stoppen door aan te geven dat de kinderen Mischling (niet volledig Joods) waren. Uiteindelijk werden er 14 kinderen afgevoerd en gedeporteerd."@nl .
  
