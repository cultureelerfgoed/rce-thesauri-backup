    skos:prefLabel "Vrouwenkamp Darmo-wijkkamp"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Vrouwenkamp Darmo-wijkkamp functioneerde van juni 1942 tot 27 april 1944 en hier zaten 6600 vrouwen in kinderen gevangen in een afgezet deel van de wijk Darmo. 40 gevangen hebben het kamp niet overleefd.   "@nl;
    skos:altLabel "De Wijk"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/7222> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
