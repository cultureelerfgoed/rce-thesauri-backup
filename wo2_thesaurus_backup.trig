      <https://data.niod.nl/WO2_Thesaurus/8176>;
    dcterms:created "2020-03-19T15:00:26.000Z"^^xsd:dateTime;
    skos:prefLabel "Dresden (Reick)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote """Aussenlager Dresden (Reick) was van 22 oktober 1944 tot eind april 1945 een buitenkamp van Flossenbürg gevestigd in de Ica-Werk fabriek van Zeiss-Ikon AG (Mügelner Strasse 40 in de wijk Dresden-Reick). De eerste 200 gevangenen zijn vrouwen uit concentratiekamp Auschwitz en vanaf eind februari zijn er ook 200 Joodse vrouwen uit Bergen-Belsen en Russische dwangarbeidsters, die tewerkgesteld worden bij de fabricage van munitie.
"""@nl;
