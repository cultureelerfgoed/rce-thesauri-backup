    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/11271>;
    dcterms:source "http://www.antillesatwar.com/vrijwilligers-korps/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/8784>;
    dcterms:created "2020-08-11T14:56:25.000Z"^^xsd:dateTime;
    skos:prefLabel "Vrijwilligers Korps Aruba"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Vrijwilligers Korps Aruba werd in 1929 opgericht na een aanval op Curaçao door de Venezolaanse rebellenleider Rafael Simón Urbina. De Arubaanse vrijwilligers versterkten tijdens de Tweede Wereldoorlog de marine, land-, en luchtmacht van het Antilliaanse leger. Een deel van de leden van het korps werd gerekruteerd om in 1944 mee te vechten aan de fronten in Europa en Nederland-Indië."@nl;
    skos:altLabel "VKA"@nl, "Burgerwacht Aruba"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/9223> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "40.758889"^^xsd:float;
    <http://www.w3.org/2003/01/geo/wgs84_pos#long> "-73.979167"^^xsd:float;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:30:50.854Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/1/15/Hendrik_Willem_van_Loon%2C_Bestanddeelnr_935-1075.jpg/500px-Hendrik_Willem_van_Loon%2C_Bestanddeelnr_935-1075.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/w/index.php?title=The_Knickerbocker_Weekly&oldid=56456593#/media/Bestand:Hendrik_Willem_van_Loon,_Bestanddeelnr_935-1075.jpg"@nl;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=The_Knickerbocker_Weekly&oldid=56456593"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2376>;
    dcterms:created "2020-08-11T15:18:13.000Z"^^xsd:dateTime;
    skos:prefLabel "The Knickerbocker Weekly"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "The Knickerbocker Weekly was een Nederlands- en Engelstalig tijdschrift, dat zich specifiek richtte op Nederlanders die voor en tijdens de Tweede Wereldoorlog naar de Verenigde Staten waren geëmigreerd. Van 1941 tot 1947 werd het blad wekelijks uitgegeven door de 'Netherlands Publishing Corporation Inc.', dat gevestigd was in New York. The Knickerbocker Weekly fungeerde, naast informatiebron voor Nederlanders in het buitenland, ook als propagandainstrument. "@nl;
    skos:altLabel "The Knickerbocker, the Netherlands magazine"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/9224> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "Liesbert van der Horst, Wereldoorlog in de West. Suriname, de Nederlandse Antillen en Aruba 1940-1945 (Hilversum: Uitgeverij Verloren, 2004)"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:35:50.383Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/9538>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/03169e26-025a-11e7-904b-d89d6717b464/media/dc584c6d-c21d-c93c-7f28-fe5b18ecbf95>;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Surinaamse_Schutterij&oldid=56843769"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/9225>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/8786>;
    dcterms:created "2020-08-11T15:45:58.000Z"^^xsd:dateTime;
    skos:prefLabel "Korps Stads- en Landwachten"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Korps Stads- en Landwachten was een vrijwillige hulpdienst, dat behoorde tot de Surinaamse Schutterij. Dit korps patrouilleerde in afgelegen gebieden, en meldde iedere witte, onbekende persoon aan als 'potentiële spion'. Daarbij hielden de vrijwilligers de grens met het Duitsgezinde Frans-Guyana in de gaten. Later in 1944 werd een deel van de leden gerekruteerd om mee te helpen aan de fronten in Europa en Nederlands-Indië."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/9225> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:references "Liesbert van der Horst, Wereldoorlog in de West. Suriname, de Nederlandse Antillen en Aruba 1940-1945 (Hilversum: Uitgeverij Verloren, 2004)"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:33:26.965Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/9538>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/640x480/54b43185-f48a-3f1d-227f-ddd7f563a53e.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/47458fc6-025a-11e7-904b-d89d6717b464/media/54b43185-f48a-3f1d-227f-ddd7f563a53e"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/03169e26-025a-11e7-904b-d89d6717b464/media/dc584c6d-c21d-c93c-7f28-fe5b18ecbf95>;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Surinaamse_Schutterij&oldid=56843769"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/9224>, <https://data.niod.nl/WO2_Thesaurus/2794>;
    dcterms:created "2020-08-11T15:52:06.000Z"^^xsd:dateTime;
    skos:prefLabel "Vrouwelijk Vrijwilligers Korps Suriname"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Vrouwelijk Vrijwilligers Hulpkorps was de vrouwenafdeling van het Korps Stads- en Landwachten. Het Hulpkorps had driehonderd leden die troepen vervoerden en kantoordiensten hadden. Daarnaast leerden de vrouwen ook schieten en exerceren, omdat zij onderdeel waren van de Schutterij van Suriname. Vanuit dit hulpkorps werd een deel gerekruteerd om in 1944 aan de fronten in Europa en Nederlands-Indië ondersteunende taken te verrichten."@nl;
    skos:altLabel "Vrouwelijk Vrijwilligers Hulpkorps"@nl, "Vrouwenkorps Suriname"@nl,
      "Vrouwen hulpkorps Suriname"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/9234> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
