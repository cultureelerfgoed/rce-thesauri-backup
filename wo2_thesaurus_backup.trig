    <http://schema.org/startDate> "1945-02-11"^^xsd:date;
    dcterms:source "https://sneekernieuwsblad.nl/artikel/585501/oud-verzetsman-johannes-kingma-overleden.html?harvest_referrer=https%3A%2F%2Fwww.google.nl%2F"@de;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2684>;
    dcterms:created "2020-06-08T11:54:39.000Z"^^xsd:dateTime;
    skos:prefLabel "Overval op politiebureau Sneek, 11 februari 1945"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 11 februari 1945 bevrijdde de KP-Sneek 20 personen uit het lokale politiebureau."@nl,
      "De Eerste overval op politiebureau Sneek vond plaats op 11 februari 1945. Tijdens de geweldloze overval kon een Friese knokploeg twintig verzetsmensen bevrijden. Dit was mede mogelijk door politieman Dirk Brouwer, hij speelde een dubbelrol binnen het politiebureau van Sneek."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9011> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Y.N. Ypma, Kroniek van het Friese Verzet 1940-1945 (Dokkum 1953)"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2020-12-17T12:21:33.874Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/10924>;
    <http://schema.org/startDate> "1945-03-07"^^xsd:date;
    dcterms:source "https://sneekernieuwsblad.nl/artikel/585501/oud-verzetsman-johannes-kingma-overleden.html?harvest_referrer=https%3A%2F%2Fwww.google.nl%2F"@de;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2684>;
    dcterms:created "2020-06-08T11:54:59.000Z"^^xsd:dateTime;
    skos:prefLabel "Overval op politiebureau Sneek, 7 maart 1945"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 7 maart 1945 werd het politiekantoor te Sneek voor de tweede maal overvallen. Zeven mannen en een vrouw worden bevrijd."@nl,
      "De Tweede overval op politiebureau Sneek vond plaats op 7 maart 1945. Tijdens de geweldloze overval kon een Friese knokploeg acht verzetsmensen bevrijden. Dit was mede mogelijk door politieman Dirk Brouwer, hij speelde een dubbelrol binnen het politiebureau van Sneek."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9012> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    dcterms:modified "2021-12-06T15:09:59.194Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/8565>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/e/e6/Aanzicht_-_Assen_-_20026104_-_RCE.jpg/500px-Aanzicht_-_Assen_-_20026104_-_RCE.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/wiki/File:Aanzicht_-_Assen_-_20026104_-_RCE.jpg";
    <http://schema.org/startDate> "1944-12-11"^^xsd:date;
    dcterms:source "http://www.drentheindeoorlog.nl/?aid=399"@de;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2684>;
    dcterms:created "2020-06-08T12:21:44.000Z"^^xsd:dateTime;
    skos:prefLabel "Overval op Huis van Bewaring te Assen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Overval op het Huis van Bewaring in Assen vond plaats op 11 december 1944. Londen had de overval verboden bij monde van een verbindingsofficier, maar de knokploeg voerde de overval toch uit. Twaalf leden van de knokploeg Noord-Drenthe bevrijdden 31 verzetsmensen. Zes van hen bevrijdden de gevangenen, terwijl de zes andere knokploegleden als transportploeg verantwoordelijk waren voor de bevrijde gevangenen. Die werden naar Friesland en Drenthe gebracht in twee Duits uitziende voertuigen. Er volgden geen represailles."@en;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9013> a <http://schema.org/Thing>, skos:Concept,
