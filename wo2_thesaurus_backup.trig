      "L. de Jong, Het Koninkrijk der Nederlanden in de Tweede Wereldoorlog. Deel 5. Maart ’41-Juli ’42. Eerste helft (’s-Gravenhage 1974)"@nl,
      "Nationaal Archief, Inventaris van het archief van de Centrale Dienst voor Sibbekunde, 1941-1944"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2024-08-12T12:03:08.690Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1940-10-30"^^xsd:date;
