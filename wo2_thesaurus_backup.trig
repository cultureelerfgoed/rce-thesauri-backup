    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/e84f21ca-025a-11e7-904b-d89d6717b464/media/6c172165-74f1-499c-1290-8b016fd51f36";
    <http://schema.org/location> "Weert";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/e883b4e4-025a-11e7-904b-d89d6717b464/media/359cfbd1-b908-27c6-5f64-d76a9ac161da>,
      <https://beeldbankwo2.nl/nl/beelden/detail/e86fbc14-025a-11e7-904b-d89d6717b464/media/41621747-ce6a-6770-45a3-0683c635c945>,
