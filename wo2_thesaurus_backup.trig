    dcterms:created "2021-10-11T09:28:13.525Z"^^xsd:dateTime;
    skos:prefLabel "Gezamenlijke demonstratie Hitlerjugend, Deutsches Jungvolk en Nationale Jeugdstorm in Roermond"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Op 12 juli 1942 hielden de Hitlerjugend, het Deutsches Jungvolk en de Nationale Jeugdstorm op de Markt in Roermond een gezamenlijke demonstratie. Aanwezig hierbij waren onder meer de Beauftragte voor Limburg Schmidt, hoofdstormer Van Geelkerken en de gemachtigde van den Leider D'Ansembourg. \"Wij marcheeren met de Duitschers samen op naar 'n betere toekomst en zij kunnen naar Amerika marcheeren\", sprak Van Geelkerken."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/6167>;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
