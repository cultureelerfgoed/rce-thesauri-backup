    skos:prefLabel "'Verzetsgroep 'De Groene''"@de, "'Verzetsgroep 'De Groene''"@en, "Verzetsgroep 'De Groene'"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Verzetsgroep ‘De Groene’ was een verzetsgroep te Zwolle rond Hendrikus Dirk Jan Beernink, schuilnaam De Groene, die vanaf 1942 tot september 1944 (toen hij bij zijn arrestatie werd doodgeschoten door de SD) actief was met diverse verzetshandelingen. Beernink en diverse van zijn medewerkers werkten bij de Nederlandse Spoorwegen."@nl;
    skos:altLabel "Groep De Groene"@nl, "verzetsgroep De Groene"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
