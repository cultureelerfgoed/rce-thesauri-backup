    <https://data.niod.nl/organizationsWO2/startDate> "1941-12-06"^^xsd:date;
    dcterms:source "https://www.historischnieuwsblad.nl/nl/artikel/24891/crimineel-vastgoedcircuit-verdiende-grof-geld-aan-jodenvervolging.html"@nl,
