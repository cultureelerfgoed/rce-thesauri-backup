    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Aanstelling van Rudolf Höss als kampcommandant van Auschwitz vond plaats op 5 mei 1940, voor de eerste gevangenen in het kamp arriveerden."@nl;
