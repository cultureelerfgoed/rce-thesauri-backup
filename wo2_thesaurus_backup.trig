    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/wiki/File:Op_last_van_de_Haarlemse_rechtbank_ontruiming_van_het_voormalige_Joles_Ziekenhuis_aan_het_Groot_Heiligland._De_inboedel_van_de_krakers_wordt_door_gemeenteambtenaren_weggevoerd._NL-HlmNHA_54010047.jpg";
    dcterms:source "https://www.joodsmonument.nl/nl/page/687/joles-hospital"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2845>;
    dcterms:created "2022-02-21T10:43:27.472Z"^^xsd:dateTime;
    skos:prefLabel "Nederlands Israëlitisch Joles-ziekenhuis"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het Nederlands Israëlitisch Joles-ziekenhuis was een Joods ziekenhuis in Haarlem. Het ziekenhuis werd in 1930 geopend en had een samenwerkingsverband met het naastgelegen Sint Elisabeths Gasthuis. Gemiddeld werden er 5 Joodse patiënten opgenomen. Tijdens de bezetting werden de patiënten gedeporteerd en werd het gebouw van het Joles-ziekenhuis bij het Sint Elisabeths Gasthuis gevoegd."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/18713> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
