    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1716>, <https://data.niod.nl/WO2_Thesaurus/1758>;
    dcterms:created "2021-04-07T14:42:43.557Z"^^xsd:dateTime;
    skos:prefLabel "Rijksidentificatiedienst"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Rijksidentificatiedienst (RID) was onderdeel van de rijksrecherchecentrale. Begin 1941 werd in overeenstemming met het algemeen beleid ook bij de Rijksidentificatiedienst begonnen met de registratie van alle zich in Nederland bevindende woonwagen- en woonschipbewoners van Nederlandse nationaliteit. Wijzigingen dienden door de plaatselijke politie onmiddellijk aan de RID te worden doorgegeven. Het ging om de volgende gegevens: naam, geboortedatum en -plaats, beroep, godsdienst en ras (arisch of niet-arisch), stand- of ligplaats, provinciaal kenteken van wagen of schip en datum van aankomst of vertrek uit een bepaalde gemeente."@nl;
    skos:altLabel "RID"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2788>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
