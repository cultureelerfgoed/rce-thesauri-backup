    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/bdaf98a6-0259-11e7-904b-d89d6717b464/media/c6f5f9dc-5cdd-bf88-5438-8e3585c5b0e1"@nl;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=AA-lijn&oldid=52632890"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3558>;
    dcterms:created "2020-09-11T13:27:47.000Z"^^xsd:dateTime;
    skos:prefLabel "AA-lijn"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De AA-lijn, ofwel de Archangelsk-Astrachan-lijn, was de door Nazi-Duitsland beoogde oostelijke grens van het Derde Rijk. In de praktijk betekende dit een uitbreiding waarbij het Europese deel van de Sovjet-Unie geannexeerd moest worden. Tijdens de Duitse invasie werden beide Sovjet-steden uiteindelijk niet door de Duitse legers bereikt."@nl .
  
