    <http://schema.org/location> "Austerlitz";
    <http://schema.org/startDate> "1945-05-04"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2574>;
    dcterms:created "2020-12-01T09:00:04.883Z"^^xsd:dateTime;
    skos:prefLabel "Executie bij Austerlitz"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 4 mei 1945, één dag voor de bevrijding, werden Klaas en Arie Schaafsma en Hendrik Rijnders in de bossen bij Austerlitz geëxecuteerd. De gebroeders Schaafsma werkten voor het verzet en werden opgepakt omdat ze in het bezit waren van een vals identiteitsbewijs. Hendrik Rijnders was burgemeester en hielp mensen onderduiken. Hij werd vervangen door een Duitse burgemeester en gevangengezet. "@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
