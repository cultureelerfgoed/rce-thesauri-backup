    <http://schema.org/endDate> "1943-08-23"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Slag_om_Koersk&oldid=57064523"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/events/9403>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3558>;
    dcterms:created "2020-09-10T10:41:36.000Z"^^xsd:dateTime;
    skos:prefLabel "Slag om Koersk"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Slag om Koersk was een veldslag aan het Oostfront, die plaatsvond in juli en augustus 1943. De inzet van beide partijen was groot: aan Duitse zijde 900.000 man infanterie, 2.700 tanks en 2.000 vliegtuigen ingezet. Aan de Sovjetzijde waren dat 1.300.000 man infanterie, 3.600 tanks en 2.400 vliegtuigen. Het Sovjetleger won uiteindelijk het gevecht."@nl;
    skos:altLabel "Operatie Citadel"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9400> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
