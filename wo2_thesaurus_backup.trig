    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/mediabank-horizontal/b322c45f-0f75-cbad-e84d-3fd697ab2f7e.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/3240e03a-025a-11e7-904b-d89d6717b464/media/b322c45f-0f75-cbad-e84d-3fd697ab2f7e?mode=detail&view=horizontal&q=broersen&rows=1&page=9";
    dcterms:source "https://historiek.net/de-nederlandse-politie-in-de-tweede-wereldoorlog/78481/"@nl,
      "http://www.archivesportaleurope.net/ead-display/-/ead/pl/aicode/NL-HaNA/type/fa/id/2.09.53"@nl,
      "https://data.niod.nl/WO2_Thesaurus/corporaties/7968"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Tijdens de bezetting werd de Nederlandse politie gecentraliseerd in het Directoraat-Generaal van Politie. De politie werkte samen met de Duitse bezetter en stond onder leiding van SS-generaal Hanns Rauter."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/locations/7985>, <https://data.niod.nl/WO2_Thesaurus/events/7969>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/7992>, <https://data.niod.nl/WO2_Thesaurus/corporaties/6638>,
      <https://data.niod.nl/WO2_Thesaurus/21803>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2715>, <https://data.niod.nl/WO2_Thesaurus/corporaties/5809>;
    dcterms:created "2019-03-05T14:22:08.000Z"^^xsd:dateTime;
    skos:prefLabel "Directoraat-generaal van Politie"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Directoraat-generaal van Politie ressorteerde onder het Departement van Justitie tijdens de Duitse bezetting van Nederland. De bezetter wilde het Nederlandse politieapparaat volledig nazificeren en een grote reorganisatie en militarisering was het gevolg. De nationaalsocialistische politie opleiding in Schalkhaar en de politieofficiersopleiding in Apeldoorn waren hier onder meer uitingen van en de politie kwam rechtstreeks onder Duits bevel te staan, waarmee het directoraat-generaal feitelijk als doorgeefluik van Rauters bevelen functioneerde."@nl;
    skos:altLabel "Directoraat Generaal van Politie"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7992> a <http://schema.org/Thing>,
      skos:Concept;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-01-23T15:26:02.997Z"^^xsd:dateTime;
