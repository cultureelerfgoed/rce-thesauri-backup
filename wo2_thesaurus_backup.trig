    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/9576>;
    <http://schema.org/startDate> "1945-04-07"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2682>;
    dcterms:created "2021-02-15T10:50:59.513Z"^^xsd:dateTime;
    skos:prefLabel "Liquidatie van Hendrik Antonie Quartel"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De liquidatie van Hendrik Antonie Quartel vond plaats op 7 april 1945 in Rotterdam. Quartel was lid van de NSB. Op de liquidatielijst van de LKP Rotterdam stond als reden vermeld: pleegt overvallen in samenwerking met Duitsers. Twee mannen van de KP drongen de woning van Quartel binnen en schoten hem tijdens zijn vlucht op het dak dood."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/11088> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Recht op wraak. Liquidaties in Nederland 1940-1945, Jack Kooistra en Albert Oosthoek, Leeuwarden 2009"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:26:12.781Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/11091>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/5d50f0da-025a-11e7-904b-d89d6717b464/media/663ff033-9415-143d-f062-ba57ad0a1ffc>;
    <http://schema.org/startDate> "1943-07-30"^^xsd:date;
    <https://data.niod.nl/organizationsWO2/caused> <https://data.niod.nl/WO2_Thesaurus/events/8807>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2682>;
    dcterms:created "2021-02-15T11:00:21.144Z"^^xsd:dateTime;
    skos:prefLabel "Liquidatie van Willem Reilingh"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De liquidatie van Willem Reilingh vond plaats op 30 juli 1943 bij Midlaren. Reilingh was steenfabrikant, eigenaar van vier engrosbedrijven en enige tijd zaakwaarnemer voor een Joods bedrijf in Winschoten. Hij was een fanatiek aanhanger van de NSB en werd op het fietspad tussen Zuidlaren en Midlaren door twee mannen geliquideerd. Als represaille werden 7 inwoners van Zuidlaren en Schipborg anderhalve week in gijzeling genomen. Vlak voor de begrafenis zijn de verzetsmannen Jan ten Cate en Carl Friedrich Kwant alsnog uit wraak in Zuidlaren doodgeschoten. Op de begrafenis op 3 augustus waren veel Duitse prominenten aanwezig."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/11092> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Recht op wraak. Liquidaties in Nederland 1940-1945, Jack Kooistra en Albert Oosthoek, Leeuwarden 2009"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:26:13.173Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/11093>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/ranh/thumb/1000x1000/959be1e0-5d22-303f-f09e-ab0e674a0626.jpg";
