    <http://schema.org/startDate> "1944-09-20"^^xsd:date;
    <http://schema.org/endDate> "1944-09-26"^^xsd:date;
    dcterms:source "https://www.saak.nl/battlefield%20tour/2014%20slag%20om%20arnhem/slag%20om%20arnhem%20nl.htm"@nl,
      "https://nl.wikipedia.org/w/index.php?title=Westerbouwing&oldid=53503990"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/4411>;
    dcterms:created "2019-04-25T11:16:51.000Z"^^xsd:dateTime;
    skos:prefLabel "Restaurant Westerbouwing"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Restaurant Westerbouwing te Oosterbeek lag op een strategische punt tijdens de Slag om Arnhem, omdat men vanaf hier goed zicht had over wat er zich afspeelde op de Rijn, in de Betuwe en de lucht daarboven. Britse troepen van de B compagnie van het 1e bataljon, 'The Border Regiment', wisten op 20 september stellingen op en bij de Westerbouwing te bezetten. Dit werd (tot de terugtrekking van de troepen in de nacht van 25 op 26 september)  een belangrijke locatie in de Perimeter, de verdedigingslinie die de Britten aanlegden rondom Oosterbeek om de Duitsers tegen te houden."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
