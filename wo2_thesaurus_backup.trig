    dcterms:source "https://renkum.nieuws.nl/veluwezoom-in-beeld/70422/onthulling-plaquette-ter-herinnering-evacuatie-1944-1945/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
