    dcterms:source "https://www.joodsmonumentarnhem.nl/p/p/f.php?flexpag_id=90&rubriek_id=1#:~:text=de%20aangrenzende%20Hofstraat.-,Met%20de%20razzia%20van%2010%20december%201942%20worden%20de%2060,de%20gedeporteerde%20bewoners%20klik%20hier.&text=5%20in%202020)-,In%201969%20wordt%20het%20nieuwe%20Joodse%20bejaardenhuis%20Beth%20Zikna%20aan,huis%20zijn%201oo%20jarig%20bestaan."@nl;
