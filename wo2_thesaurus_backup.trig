    dcterms:modified "2025-08-29T07:16:05.497Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/75343549-b454-0c97-dba0-a0baa28fa92d.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/ff9c79a0-0259-11e7-904b-d89d6717b464/media/75343549-b454-0c97-dba0-a0baa28fa92d";
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1617>, <https://data.niod.nl/WO2_Thesaurus/19088>;
    dcterms:created "2024-11-11T11:07:46.528Z"^^xsd:dateTime;
    skos:prefLabel "Camp Columbia"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Camp Columbia was een legerbasis en opvangkamp in Wacol, nabij Brisbane (Australië). Van oktober 1942 tot juni 1944 fungeerde het als legerkamp van de Amerikaanse strijdkrachten. Vanaf juni 1944 tot oktober 1945 was het Nederlandse koloniale bestuur van Nederlands-Indië onder leiding van luitenant-Gouverneur-Generaal Van Mook in Camp Columbia gevestigd. Van oktober 1945 tot mei 1946 fungeerde het als opvangkamp voor Nederlandse vluchtelingen uit Indonesië."@nl .
  
