    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/323eaa72-025a-11e7-904b-d89d6717b464/media/08b73d9f-7cd9-af05-9b9d-666b6973d1a3?mode=detail&view=horizontal&q=politieofficiersschool&rows=1&page=22";
    dcterms:source "http://opac-gonext.oclc.org:8180/xslt/DB=8/XMLPRS=Y/PPN?PPN=300599463"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
