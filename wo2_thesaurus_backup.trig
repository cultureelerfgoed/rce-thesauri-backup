  <https://data.niod.nl/WO2_Thesaurus/corporaties/4578> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "NIOD"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    dcterms:modified "2026-02-25T09:56:33.117Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1859-03-01"^^xsd:date;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/21991>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/3/35/Exterieur_van_het_gebouw_van_de_bank_Lippmann_Rosenthal_Sarphatistraat.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/wiki/File:Exterieur_van_het_gebouw_van_de_bank_Lippmann_Rosenthal_Sarphatistraat.jpg";
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Lippmann,_Rosenthal_%26_Co._(Sarphatistraat)&oldid=64233768"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Lippmann, Rosenthal & Co. (Liro) was een Duitse roofbank in Amsterdam en werd in 1941 opgericht. Liro kreeg de naam van een gerenommeerde Joodse bank, maar was opgericht om Joods bezit te registreren en in beslag te nemen. Na de bevrijding werd Liro hernoemd tot Liquidatie van Verwaltung Sarphatistraat (LVVS) en aangewezen om de geroofde bezittingen aan de rechtmatige eigenaren terug te geven."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/events/6715>, <https://data.niod.nl/WO2_Thesaurus/events/7180>,
      <https://data.niod.nl/WO2_Thesaurus/21947>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/20703>, <https://data.niod.nl/WO2_Thesaurus/20712>;
    dcterms:created "2016-10-04T13:07:40.000Z"^^xsd:dateTime;
    skos:prefLabel "Lippmann, Rosenthal & Co."@de, "Lippmann, Rosenthal & Co."@en, "Lippmann, Rosenthal & Co."@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Lippmann, Rosenthal & Co. (LIRO) was een roofbank aan de Sarphatistraat in Amsterdam, die in 1941 speciaal werd opgericht om Joods bezit te registreren en in beslag te nemen. Door de naam van een gerenommeerde Joodse bank te gebruiken en verschillende andere maatregelen verhulden de Duitse autoriteiten het doel van de operatie en gaven zij daaraan een pseudo-legaal karakter. Hiermee voorkwamen zij dat toekomstige slachtoffers ongerust werden en hun waardevolle eigendommen en financiële bezit zouden verbergen. Ten behoeve van de restitutie (die zeer moeizaam verliep) werd de Liro-bank na de oorlog hernoemd tot Liquidatie van Verwaltung Sarphatistraat (LVVS)."@nl;
    skos:altLabel "LIRO"@nl, "LVVS"@nl, "Liquidatie van Verwaltung Sarphatistraat"@nl,
      "Lippmann en Rosenthal"@nl, "L.I.R.O."@nl, "Lippmann, Rosenthal"@nl, "L.V.V.S."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization>;
    skos:definition " Lippmann, Rosenthal & Co. of kortweg Liro, ook bekend als de 'Duitse roofbank' was een bank aan de Sarphatistraat in Amsterdam. De bank werd tijdens de Duitse bezetting in de Tweede Wereldoorlog opgericht om Joods bezit (geld, waardepapieren en waardevolle bezittingen) systematisch te registreren en vervolgens te roven. Via deze bank werden de Nederlandse Joden voorafgaand aan deportatie systematisch beroofd. Na de bevrijding werd de bank hernoemd naar LVVS - Liquidatie van Verwaltung Sarphatistraat - om verwarring met de bonafide joodse bank Lippman-Rosenthal & Co te voorkomen. De afwikkeling van de zaken en de teruggave van de geroofde gelden aan rechthebbenden duurde tot 1956."@nl .
  
