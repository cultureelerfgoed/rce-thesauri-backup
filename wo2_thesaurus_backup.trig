    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/19532>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/0/03/Cap_Arcona_burning.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/w/index.php?title=File:Cap_Arcona_burning.jpg&oldid=508643482";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <http://beeldbankwo2.nl/nl/beelden/detail/83938d34-025a-11e7-904b-d89d6717b464/media/78c9aa24-996c-4764-9d7a-1d638890639e>;
    <http://schema.org/startDate> "1945-05-03"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Speciaal:Citeren&page=Cap_Arcona_%28schip%2C_1927%29&id=48590734"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/3688>, <https://data.niod.nl/WO2_Thesaurus/3511>,
      <https://data.niod.nl/WO2_Thesaurus/5140>;
    dcterms:created "2016-10-04T13:07:39.000Z"^^xsd:dateTime;
    skos:prefLabel "Scheepsramp Cap Arcona"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "De Scheepsramp met de Cap Arcona vond plaats op 3 mei 1945 in de Lübecker Bocht. De Cap Arcona was een Duits passagiersschip uit 1927 waarmee 5.000 gevangenen uit het concentratiekamp Neuengamme werden getransporteerd. Er lagen in de buurt ook vele Duitse oorlogsschepen en enkele andere schepen die ook gevangenen uit Neuengamme transporteerden zoals de Thielbek met 2.800 gevangenen en de Athen met 2.000 gevangenen. De groep schepen werd op 3 mei 1945 gebombardeerd door het 198 Squadron van de Royal Air Force. De Cap Arcona en vele andere schepen zonken. Gevangenen die na het bombardement van de zinkende schepen wisten te ontsnappen werden veelal doodgeschoten vanaf rondvarende schepen of door patrouilles van de SS. In totaal zijn er ruim 7000 gevangenen om het leven gekomen en zo'n 350 mensen overleefden de ramp."@nl;
    skos:altLabel "Cap Arcona"@nl, "Ramp in de Lübeckerbocht"@nl, "Bombardement in de Lübeckerbocht"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/11206> .
  
