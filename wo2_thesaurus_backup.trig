      <https://data.niod.nl/WO2_Thesaurus/17586>, <https://data.niod.nl/WO2_Thesaurus/17599>,
      <https://data.niod.nl/WO2_Thesaurus/17600>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1977>, <https://data.niod.nl/WO2_Thesaurus/2538>;
    dcterms:created "2016-08-01T19:20:38.000Z"^^xsd:dateTime;
    skos:prefLabel "Zeugen Jehovas"@de, "Jehovah's Witnesses"@en, "Jehova's Getuigen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Jehova's Getuigen zijn de aanhangers van een Christelijke door het adventisme beïnvloede beweging. Ze gehoorzamen de overheid zolang wetgeving niet in strijd is met hun interpretatie van Gods wetten. In april 1933 werden de Jehova's (Bibelforscher) door de nazi's verboden. Ze waren samen met de Joden de eerste vervolgden van Nazi Duitsland. In de concentratiekampen waren Jehova's getuigen aan een paarse driehoek te herkennen. In Nederland werden de Jehova's ook vervolgd, desondanks groeide hun aantal tijdens de bezetting van ongeveer 500 naar zo'n 3100. Er werden in Nederland ongeveer 500 Jehova's getuigen gearresteerd van wie ruim 300 naar concentratiekampen zijn gedeporteerd."@nl;
    skos:altLabel "Wachttoren-, Bijbel en Traktaatgenootschap"@nl, "Wachttorengenootschap"@nl .
  
