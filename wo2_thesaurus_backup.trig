"""@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:25:15.120Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/34b09094-f5c6-8df8-aa9d-df30f6501ef7.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/c4012b7e-025a-11e7-904b-d89d6717b464/media/34b09094-f5c6-8df8-aa9d-df30f6501ef7";
    <http://schema.org/startDate> "1943-05-01"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2360>;
    dcterms:created "2021-04-13T11:00:33.350Z"^^xsd:dateTime;
    skos:prefLabel "De jaarklassenactie"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "In mei 1943 startten de Duitsers de jaarklassenactie. Zeventien jaarklassen zouden zich moeten melden. Elke jaarklasse zou volgens de verwachting van de Duitsers 10.000 man voor Duitsland opleveren. De gehele actie zou ongeveer een half jaar in beslag nemen en 170.000 man opleveren. Al spoedig bleek dat de jaarklassenactie geen succes zou worden omdat er te veel vrijstellingen werden uitgereikt en velen van de meldingsplichtige leeftijd al in Duitsland werkten. Daarom werd er in de zomer van 1943 een nieuw systeem bedacht, het Zurückstellungsverfahren."@nl;
    skos:altLabel "Jaarklassensysteem"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/6650>;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/11468> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:32:41.800Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/3/3a/Wolvenburg.JPG/1280px-Wolvenburg.JPG";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Penitentiaire_Inrichting_Wolvenplein#/media/Bestand:Wolvenburg.JPG";
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/6213>;
    dcterms:created "2021-04-15T07:56:22.238Z"^^xsd:dateTime;
    skos:prefLabel "Ingebruikname gevangenis Wolvenplein"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Met het uitbreken van de Tweede Wereldoorlog annexeerde de Duitse bezetter het complex van gevangenis Wolvenplein. Sinds 1929 was de gevangenis enige tijd gesloten wegens cellenoverschot. Rond 1939 werd het complex na modernisering weer in gebruik genomen. Vanaf 1942 was het de Deutsche Untersuchungs- und Strafgefägnis waar o.a. door de politie opgepakte zwarthandelaren en politieke gevangenen werden opgesloten. Op 6 mei 1945 werden meer van 170 gevangenen bevrijd. Die plaatsen werden opgevuld met leden van de NSB."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
