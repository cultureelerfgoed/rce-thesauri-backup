    skos:prefLabel "Parlament"@de, "Parliament"@en, "Parlement"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Een parlement is een lichaam dat het volk vertegenwoordigt, op landelijk niveau bestaande uit de Eerste en Tweede Kamer (de Staten-Generaal), met rechtgevende of rechtsprekende bevoegdheden."@nl;
