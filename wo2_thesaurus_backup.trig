    skos:prefLabel "Inspecteur"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De rang van inspecteur was de op een na hoogste rang in de Nederlandsche Landwacht. Er waren twee inspecteurs. Als compromis tussen de NSB en de Nederlandsche SS waren de commandant van de WA Arie Zondervan en de voorman van de Nederlandsche SS Henk Feldmeijer beiden door rijkscommissaris Seyss-Inquart benoemd tot inspecteur."@nl;
    skos:altLabel "Inspecteur Nederlandsche Landwacht"@nl, "Inspecteur van de Nederlandsche Landwacht"@nl,
      "Inspecteur der Nederlandsche Landwacht"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2249> .
  
  <https://data.niod.nl/WO2_Thesaurus/20297> a <http://schema.org/Thing>, skos:Concept;
