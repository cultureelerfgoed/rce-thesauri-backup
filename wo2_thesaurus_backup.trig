    dcterms:created "2022-02-10T13:20:01.993Z"^^xsd:dateTime;
    skos:prefLabel "Portugees-Israëlitisch Meisjesweeshuis Amsterdam"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Portugees-Israëlitisch Meisjesweeshuis 'Mazon Habanoth' in Amsterdam was een kleinschalig weeshuis voor Joodse meisjes vanaf 5 jaar. Het weeshuis werd opgericht in 1734. Op 10 februari 1943 werd het weeshuis tijdens een razzia ontruimd. De kinderen en hun verzorgers werden opgepakt en gedeporteerd."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
