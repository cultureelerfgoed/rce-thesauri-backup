    dcterms:created "2017-06-02T13:36:52.000Z"^^xsd:dateTime;
    skos:prefLabel "H.A.R.K."@nl, "'HARK'"@de, "'HARK'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "HARK, de afkorting van Hulpactie Roode Kruis, werd opgericht in het najaar van 1944 in het toen reeds bevrijde zuiden van Nederland als hulporganisatie voor Nederlanders die door oorlogshandelingen, evacuaties en schaarste dringend hulp behoefden. Prinses Juliana was beschermvrouwe van HARK."@nl;
    skos:altLabel "Hulpactie Rode Kruis"@nl, "Hulpactie Roode Kruis"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/5411> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/schorsijm>;
    dcterms:modified "2026-01-14T10:16:13.476Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/9ce13388-cd97-0971-fda8-aedb282405d7.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/f71b969e-0259-11e7-904b-d89d6717b464/media/9ce13388-cd97-0971-fda8-aedb282405d7";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://nimh-beeldbank.defensie.nl/foto-s/5286b515-c1e3-5e3c-8768-86f86b1c0bbc>,
      <https://nimh-beeldbank.defensie.nl/foto-s/ff91311b-1f70-5be7-2977-76954ad11c9e>,
      <https://www.delpher.nl/nl/kranten/view?coll=ddd&identifier=ddd:010452560:mpeg21:a0001>,
      <https://www.nationaalarchief.nl/onderzoeken/fotocollectie/ad9736d6-d0b4-102d-bcf8-003048976d84>;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Vrijwillig_Vrouwen_Hulpkorps&oldid=42707501"@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4609>, <https://data.niod.nl/WO2_Thesaurus/2794>;
    dcterms:created "2017-07-11T10:19:13.000Z"^^xsd:dateTime;
    skos:prefLabel "Vrouwen Hulpkorps"@nl, "'Vrouwen Hulpkorps'"@en, "'Vrijwillig Vrouwen Hulpcorps'"@de;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het (Vrijwillig) Vrouwen Hulpkorps (VVHK of VHK) was de vrouwenafdeling van de Nederlandsche Landmacht. Het VVHK werd op 20 december 1943 door het Londense Comité van het Nederlandse Rode Kruis opgericht op voorstel van het Nederlandse Ministerie van Oorlog in Londen. Het doel van de VVHK was humanitaire en medische zorg verlenen, zoals kindertransporten, en ondersteuning bieden in communicatie en administratieve functies. Op 25 april 1944 werd de afdeling het Vrouwen Hulpkorps (VHK) genoemd en onderdeel van de landmacht zodat zij achter de troepen in België, Brabant en Zeeland aan konden optrekken. Hier waren zij betrokken met voedselvoorziening en evacuaties. Na de Tweede Wereldoorlog werd het VHK ingezet in Indonesië en Korea."@nl;
    skos:altLabel "Vrouwen Hulpcorps"@nl, "Dutch Women's Army Corps"@nl, "VVHK"@nl, "Vrijwillig Vrouwen Hulp Corps"@nl,
      "VHK"@nl, "V.H.K."@nl, "Vrijwillig Vrouwen Hulpkorps"@nl, "Vrijwillig Vrouwen Hulp Korps"@nl,
      "V.V.H.K."@nl, "Vrouwenhulpkorps"@nl, "Vrouwenhulpcorps"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
