    dcterms:created "2024-09-12T08:56:24.909Z"^^xsd:dateTime;
    skos:prefLabel "Sandakan"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Sandakan was een krijgsgevangenkamp bij de plaats Sandakan in Maleisië, gelegen aan de noordoostkust van Borneo. Sandakan bestond uit drie kampen: Kamp 1, Kamp 2 en kamp Berhala. De werkzaamheden waren o.a. de aanleg van een vliegveld en toegangswegen hier naartoe. Begin 1945 vonden dodenmarsen plaats. Bijna alle krijgsgevangenen, ongeveer 2000 Britten en Australiërs, kwamen hierbij om."@nl;
    skos:altLabel "Borneo 1B"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/21326> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
