    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/8/85/Th%C3%A9%C3%A2tre_du_Lazarett_du_stalag_de_G%C3%B6rlitz_3.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/wiki/File:Th%C3%A9%C3%A2tre_du_Lazarett_du_stalag_de_G%C3%B6rlitz_3.jpg";
    dcterms:source "https://en.wikipedia.org/wiki/Stalag_VIII-A"@nl, "https://www.tracesofwar.nl/sights/6721/Monument-Stalag-VIII-A.htm"@nl,
