    dcterms:source "https://en.wikipedia.org/wiki/HIAG"@nl, "https://duitslandinstituut.nl/artikel/137/bittere-mars-door-de-naoorlogse-geschiedenis"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/17058>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1561>, <https://data.niod.nl/WO2_Thesaurus/20707>;
    dcterms:created "2021-07-07T14:20:02.585Z"^^xsd:dateTime;
    skos:prefLabel "H.I.A.G."@nl, "HIAG"@de, "HIAG"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het H.I.A.G. was een lobbygroep en ontkenningsveteranenorganisatie in West-Duitsland opgericht door voormalig hooggeplaatst Waffen-SS personeel. Doel was om juridische, economische en historische rehabilitatie van de Waffen-SS te bewerkstelligen. Het lidmaatschap stond open voor veroordeelde oorlogsmisdadigers. Er werd gebruik gemaakt van contacten met politieke partijen en propaganda. Het H.I.A.G. had een eigen uitgeverij, Munin Verlag. Waffen-SS generaal Paul Hausser was de eerste woordvoerder van HIAG."@nl;
    skos:altLabel "Hilfsgemeinschaft auf Gegenseitigkeit der Angehörigen der ehemaligen Waffen-SS"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4717>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/17058> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:00:43.708Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8020>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/f6faed56-9398-373a-2566-a79006952c36.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/13285ce6-025a-11e7-904b-d89d6717b464/media/f6faed56-9398-373a-2566-a79006952c36";
    dcterms:source "https://en.wikipedia.org/wiki/HIAG"@nl, "https://duitslandinstituut.nl/artikel/137/bittere-mars-door-de-naoorlogse-geschiedenis"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/17057>;
    dcterms:created "2021-07-08T09:12:13.633Z"^^xsd:dateTime;
    skos:prefLabel "Oprichting HIAG"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Zodra het oprichten van veteranenverbanden in Duitsland werd toegestaan richtten soldaten van de voormalige Waffen-SS in 1951 de HIAG op. Doel was het lenigen van de sociale en financiële nood waarin veel kameraden verkeerden en bijstelling van het beeld over de Waffen-SS. Prominente Waffen-SS'ers zoals Paul Hausser, Kurt Meyer en Sepp Dietrich leidden de organisatie. Het rechtzetten van het beeld over de Waffen-SS is de HIAG niet gelukt. In 1992 hief zij zichzelf op."@nl;
    skos:altLabel "Hilfsgemeinschaft auf Gegenseitigkeit der Angehörigen der ehemaligen Waffen-SS"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/17059> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-04-12T13:10:10.365Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/0d2e6d42-af07-a4ff-ca4a-1d83c8a2649a.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/797edeac-025a-11e7-904b-d89d6717b464/media/0d2e6d42-af07-a4ff-ca4a-1d83c8a2649a";
    dcterms:source "https://nl.wikipedia.org/wiki/ODESSA"@nl, "https://historiek.net/otto-skorzeny-ss-mossad/81287/"@nl;
    skos:relatedMatch <https://data.niod.nl/WO2_Thesaurus/corporaties/6101>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1561>, <https://data.niod.nl/WO2_Thesaurus/corporaties/6101>;
    dcterms:created "2021-07-08T09:37:28.143Z"^^xsd:dateTime;
    skos:prefLabel "ODESSA"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "ODESSA was een verondersteld netwerk van SS-officieren en -sympathisanten dat hoge nazi's hielp met vluchten uit het door de geallieerden bevrijde Europa. Het kwam voort uit de operatie Weerwolf die een organisatie wilde opbouwen om de strijd na de verwachte capitulatie ondergronds voort te zetten. Otto Skorzeny was hierbij betrokken en onder zijn leiding werd ODESSA opgezet. Volgens Simon Wiesenthal werd ODESSA in 1946 opgezet en de financiële middelen waren geroofd van de Joden in de bezette gebieden en verdiend door bedrijven die met tewerkgestelden goedkoop fabriceerden. Er is veel mythevorming rond ODESSA en het is onduidelijk wat de exacte geschiedenis van deze organisatie is. "@nl;
    skos:altLabel "OdeSSA"@nl, "Organisation der ehemaligen SS-Angehörigen"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
