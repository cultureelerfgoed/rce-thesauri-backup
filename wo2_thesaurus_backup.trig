    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2019-04-02T12:41:01.000Z"^^xsd:dateTime;
    skos:prefLabel "Oprichting stichting C.C.K.P."@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Oprichting stichting C.C.K.P. (Centraal Comité van Kerkelijk en Particulier Initiatief voor Sociale Zorg ten behoeve van gerepatrieerden) was op 2 mei 1950. De stichting werd opgericht om het maatschappelijk werk onder Indische Nederlanders te organiseren. De CCKP ontplooit zich als een belangenorganisatie voor Indische Nederlanders."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8264> a <http://schema.org/Thing>, skos:Concept,
