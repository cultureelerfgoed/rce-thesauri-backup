    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/wiki/File:Stalag_VIII-B.jpg";
    dcterms:source "https://stadtarchiv.memmingen.de/publikationen/kriegsgefangenenlager-stalag-vii-b-memmingen-1940-1945.html"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
