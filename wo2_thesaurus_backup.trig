    dcterms:created "2020-08-10T14:49:28.000Z"^^xsd:dateTime;
    skos:prefLabel "Verduisteringsmaatregelen in de West"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Verduisteringsmaatregelen in de West gingen na Operatie Paukenschlag van start. In Suriname gold een verduisteringsplicht tot 35 kilometerlandinwaarts, in de Antillen gold dat voor de eilanden Aruba, Curaçao en Bonaire. De maatregelen waren ingevoerd om Duitse luchtaanvallen te voorkomen. "@nl;
    skos:altLabel "Verduisteringsplicht Suriname"@nl, "Verduisteringsmaatregelen Suriname"@nl,
      "Verduisteringsmaatregelen Antillen"@nl, "Verduisteringsplicht Antillen"@nl .
  
