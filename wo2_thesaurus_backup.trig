    <http://schema.org/location> "Nijmegen";
    <http://schema.org/startDate> "1942-11-17"^^xsd:date;
    <http://schema.org/endDate> "1942-11-18"^^xsd:date;
    dcterms:source "https://www.oorlogsdodennijmegen.nl/gebeurtenis/b6fea341-073e-4d83-97e8-aa1f5f2674d3"@nl,
      "https://www.omroepgelderland.nl/nieuws/2148359/Jodenjacht-in-Gelderland-de-nacht-dat-honderden-Joden-worden-afgevoerd-naar-Westerbork"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/7909>;
