    skos:prefLabel "Horrocks-boom (Groesbeek)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "De Horrocks-boom is te vinden in Groesbeek. Vanuit een uitkijkpost in deze boom instrueerde de Britse Luitenant-Generaal Brian Horrocks een enorme troepenmacht aan het begin van operatie Veritable."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4466>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4460> .
  
