    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Kanonneerboten zijn kleine oorlogsschepen van geringe diepte met één of meer stukken geschut, voor de verdediging/aanval van kusten en rivieren."@nl .
  
