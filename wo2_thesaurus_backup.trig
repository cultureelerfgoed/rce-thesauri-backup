    skos:prefLabel "Kirchham"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Aussenlager Kirchham was van 6 maart 1945 tot 2 mei 1945 een buitenkamp van Flossenbürg waar 400 mannen tewerkgesteld waren aan de bouw van een landingsbaan voor het Fliegerhorst en barakken voor het treinstation. Door de erbarmelijke omstandigheden overleden in twee maanden tijd 96 gevangenen."@nl;
    skos:altLabel "Aussenlager Kirchham"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
