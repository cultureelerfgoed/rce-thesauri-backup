    <http://schema.org/startDate> "1942-11-27"^^xsd:date;
    <http://schema.org/endDate> "1942-11-28"^^xsd:date;
    dcterms:source "https://www.wikiwand.com/nl/Leek_(Groningen)"@nl, "https://www.museumjoodseschooltje.nl/archief/herdenking-27-november-1942/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2056>;
    dcterms:created "2022-08-04T08:56:16.647Z"^^xsd:dateTime;
    skos:prefLabel "Razzia in Leek, 27 november 1942"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 27 november 1942 vond er een razzia in Leek plaats. Tijdens de sjabbat-avond werden 62 Joden opgepakt en naar het gemeentehuis van Leek gebracht. Op 28 november gingen ze via Groningen naar Kamp Westerbork. Alleen Ruth Stein-Issen kwam uit de kampen terug. In totaal werden 72 Joden weggevoerd uit Leek."@nl .
  
