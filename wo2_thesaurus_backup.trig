    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://de.wikipedia.org/wiki/KZ_Kochendorf#/media/File:Bad_Friedrichshall-Kochendorf_KZ_Eisbaer_19450314.jpg";
    dcterms:source "https://www.tracesofwar.com/sights/5039/Concentration-Camp-Kochendorf.htm"@en,
      "https://www.friedrichshall.de/de/familie-soziales/stiftungen/kz-kochendorf/lager"@de;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
