    dcterms:created "2021-02-18T13:31:40.663Z"^^xsd:dateTime;
    skos:prefLabel "Todeskandidaten"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Todeskandidaten zijn gevangenen onder het nazi-regime die op een lijst stonden om als represaille voor een aanslag van het verzet gefusilleerd te worden. De eerste van dit soort represailles vond plaats op 15 augustus 1942. Het grootste deel van de fusillades vond plaats vlakbij de plek van de aanslag."@nl;
    skos:altLabel "Todeskandidate"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/9271> .
  
  <https://data.niod.nl/WO2_Thesaurus/11140> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2021-06-28T18:19:08.752Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/11053>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/rce/thumb/fullsize/53480592-86a2-bea5-21de-69a6c02f87d5.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://beeldbank.cultureelerfgoed.nl/alle-afbeeldingen/detail/8ef4205e-ac01-3236-e72d-564187027b34/media/53480592-86a2-bea5-21de-69a6c02f87d5";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/66464244-025a-11e7-904b-d89d6717b464/media/5ed1e883-e173-54d0-2285-7ce3a2dd1e74>;
    <http://schema.org/startDate> "1944-06-06"^^xsd:date;
    dcterms:source "http://www.hantjedejong.nl/verzet/kp-rotterdam-zuid/"@nl, "http://oud.rotterdam010.nl/508-Oorlog/Bezetting-Bevrijding-Noord/35-Huis-van-Bewaring.html"@nl;
    skos:relatedMatch <https://data.niod.nl/WO2_biografieen/Samuel-Esmeijer>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2684>;
    dcterms:created "2021-02-18T13:55:25.718Z"^^xsd:dateTime;
    skos:prefLabel "Overval Huis van Bewaring Rotterdam"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 6 juni 1944 vond een overval op het Huis van Bewaring in Rotterdam-Noord plaats. Een aantal leden van de KP-groep Rotterdam-Zuid onder leiding van Samuel Esmeijer ('Paultje') bevrijdde 17 illegale werkers. Dit waren verzetsmensen van de groep 'Je Maintiendrai' die ter dood veroordeeld waren. Ze zouden op 7 of 8 juni naar een kamp worden overgebracht. "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/11142> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2021-03-03T13:05:37.912Z"^^xsd:dateTime;
