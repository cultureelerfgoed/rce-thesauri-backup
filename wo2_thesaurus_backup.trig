    <http://schema.org/location> "Sint-Niklaas";
    <http://schema.org/startDate> "1940-05-17"^^xsd:date;
    dcterms:source "https://anderetijden.nl/aflevering/316/De-vlucht-uit-Breda"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/19539>;
    dcterms:created "2021-09-21T12:36:19.998Z"^^xsd:dateTime;
    skos:prefLabel "Bombardement op Sint-Niklaas"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 17 mei 1940 werd de meisjesschool in het Belgische Sint-Niklaas door de Duitsers gebombardeerd. Er bevond zich daar een grote groep vluchtelingen uit Breda die op weg was naar Antwerpen. Bij het bombardement kwamen 51 vluchtelingen om en tientallen Belgen. Toen Sint-Niklaas door de Duitsers bezet was keerden de overgebleven vluchtelingen terug naar Breda. Achteraf gezien was de evacuatie uit Breda niet nodig geweest want er is niet gevochten."@nl .
  
