    <http://schema.org/startDate> "1944-09-01"^^xsd:date;
    dcterms:source "https://www.wo2slachtoffers.nl/bio/56934/Zeijlstra-Hendrik-Jakob.htm"@de;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2574>;
    dcterms:created "2022-03-17T11:14:27.799Z"^^xsd:dateTime;
    skos:prefLabel "Executie van Hendrik Jakob Zeijlstra"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De executie van Hendrik Jakob Zeijlstra vond plaats op 1 september 1944 in Ellecom. Zeijlstra was lid van de NSB, de Nederlandse SS en fungeerde als tolk/vertaler bij de Sicherheitsdienst (SD) in Arnhem. Op verdenking van het spelen van een dubbelrol werd hij door de SD op het terrein van Kamp Avegoor in Ellecom gefusilleerd. Het stoffelijk overschot van Zeijlstra werd op 14 juni 1945 in een enkelvoudig graf ontdekt."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/18862> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
