    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/d5f883a3-b83c-6b55-668b-07724c1de658.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/5e216e54-025a-11e7-904b-d89d6717b464/media/d5f883a3-b83c-6b55-668b-07724c1de658";
    <http://schema.org/startDate> "1942-12-01"^^xsd:date;
    <http://schema.org/endDate> "1942-12-02"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/6086>;
    dcterms:created "2022-03-09T13:36:32.174Z"^^xsd:dateTime;
    skos:prefLabel "Verhuizing Berg-Stichting naar Amsterdam"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Verhuizing van de Berg-Stichting naar Amsterdam vond plaats eind 1942. De gedwongen ontruiming van het tehuis in Laren werd in de zomer van 1942 aangekondigd. Op 5 december 1942 moest het gebouw leeg zijn, zodat er kinderen van soldatenvrouwen ondergebracht konden worden. Om te voorkomen dat de kinderen en stafleden gedeporteerd werden, huurde directeur Jan Reitsema in het geheim 3 panden op het Rapenburg in Amsterdam en regelde hij valse verhuisvergunningen. De kinderen zouden ingeschreven blijven in Laren, zodat zij moeilijker te vinden zouden zijn. Tijdens de verhuizing belandde een groep midden in een razzia bij het Muiderpoortstation. Jan Reitsema deed alsof de groep opgepakt was en op weg was naar de Hollandsche Schouwburg en wist zo alsnog veilig in de gehuurde panden op het Rapenburg aan te komen."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/18798> a <http://schema.org/Thing>, skos:Concept,
