    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Het Besluit Zuivering Bedrijfsleven maakte het mogelijk om leidinggevenden in een bedrijf vanwege collaboratie voor maximaal 10 jaar te verbieden een leidinggevende functie uit te oefenen."@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
