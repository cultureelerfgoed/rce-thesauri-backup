    skos:prefLabel "Nederlandsche Volksbeweging"@nl, "'Nederlandsche Volksbeweging'"@de,
      "'Nederlandsche Volksbeweging'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Nederlandsche Volksbeweging was een politieke organisatie die, reeds tijdens de bezetting illegaal voorbereid, onmiddellijk na de bevrijding in mei 1945 officieel werd opgericht onder leiding van W. Schermerhorn en W. Banning. Het doel was te komen tot een radicale vernieuwing van het politieke en maatschappelijke leven in Nederland."@nl;
    skos:altLabel "NVB"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/4608> a <http://schema.org/Thing>,
