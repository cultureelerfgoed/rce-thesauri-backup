    dcterms:created "2026-05-20T13:20:24.066Z"^^xsd:dateTime;
    skos:prefLabel "Vierduitenfonds"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Vierduitenfonds was een fonds van de Nationaal-Socialistische Beweging (NSB) bedoeld om geld in te zamelen voor partijleden die in de jaren 30 ontslagen waren wegens hun NSB-lidmaatschap. Het geld werd voornamelijk door leden van de Nationaal-Socialistische Vrouwenorganisatie (NSVO) gecollecteerd."@nl;
    skos:altLabel "Vier Duiten Fonds"@nl, "Vierduiten fonds"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/22028> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
