    <http://schema.org/startDate> "1941-11-23"^^xsd:date;
    <http://schema.org/endDate> "1942-04-01"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/wiki/Contact_Holland"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2676>;
    dcterms:created "2020-12-11T10:42:40.453Z"^^xsd:dateTime;
    skos:prefLabel "Contact Holland "@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Contact Holland, voluit Landing Operations Contact, was bedacht en uitgevoerd door de Engelandvaarders Bob van der Stok en Erik Hazelhoff Roelfzema en Peter Tazelaar, waarbij een geheim agent  in bezet Nederland aan land zou worden gezet om een opdracht uitvoeren en daarna per boot weer te worden opgepikt. Peter Tazelaar kwam op op 23 november 1941 aan in Nederland, en vertrok eind januari 1942 via Zwitserland Frankrijk, Spanje en Portugal en kwam in april 1942 weer in Engeland aan."@nl;
    skos:altLabel "Landing Operations Contact"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
