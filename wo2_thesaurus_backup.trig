      <https://data.niod.nl/WO2_Thesaurus/8176>;
    dcterms:created "2020-03-20T12:34:25.000Z"^^xsd:dateTime;
    skos:prefLabel "Janowitz"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote """Aussenlager Janowitz (Vrchotovy Janovice) was van 24 juli 1944 tot eind maart 1945 een buitenkamp van Flossenbürg, waar ongeveer 200 mannen, voor de helft Russen tewerkgesteld waren aan de bouw van en graafwerkzaamheden voor een gebouw voor de SS-Sturmgeschützschule, stratenmaken en werk aan de spoorbaan. De gevangenen waren ondergebracht in een barakkenkamp in de buurt van Janowitz en na een tyfusepidemie in een boerderij Kschepenitz (Křepenice) bij Chlum.

"""@nl;
    skos:altLabel "Aussenlager Janowitz"@nl, "Vrchotovy Janovice"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/8843> a <http://schema.org/Thing>, skos:Concept,
