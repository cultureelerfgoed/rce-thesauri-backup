    skos:prefLabel "Voedseluitdeling NS"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Met de Voedseluitdeling van de NS probeerde het Nederlandse spoorwegbedrijf zijn werknemers, voornamelijk die op het hoofdkantoor werkten, te beschermen tegen ondervoeding. Dit gebeurde in het 'Hoofdadministratiegebouw III' aan het Moreelsepark in Utrecht. Niet alleen de NS, maar ook andere Nederlandse bedrijven organiseerden soortgelijke voedseluitdelingen."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
