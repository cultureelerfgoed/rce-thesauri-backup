    <http://schema.org/location> "Stoutenburg";
    <http://schema.org/startDate> "1940-05-12"^^xsd:date;
    <http://schema.org/endDate> "1940-05-13"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2322>, <https://data.niod.nl/WO2_Thesaurus/events/4374>;
    dcterms:created "2020-11-24T13:30:13.746Z"^^xsd:dateTime;
    skos:prefLabel "Weerstand voorposten Stoutenburg en Asschat"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De voorposten Stoutenburg (honderdvijftig manschappen) en Asschat (tweehonderd manschappen) leverden op 12 en 13 mei 1940 felle strijd met de Duitsers. Ze hadden zevenhonderd man tegenover zich. De kanonnen van Stoutenburg hebben aan Duitse zijde de grootste verliezen toegebracht. In totaal zijn er op 12 en 13 mei 1940 in het terrein voor beide voorposten tweehonderd Duitsers gesneuveld."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/10434> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references """José Huurdeman, Ondergronds in de Tweede Wereldoorlog, Verhalen uit de
Gelderse Vallei, Veluwe en Krimpenerwaard, Leusden, 2019."""@nl,
      "Hans Buiter, Ignace de Haas, Het geruisloze verzet, De geschiedenis van de TD-verzetsgroep tijdens de Duitse bezetting, Amersfoort, 1988."@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
