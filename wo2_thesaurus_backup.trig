    skos:prefLabel "Dutchbat"@de, "Dutchbat"@en, "Dutchbat"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Dutchbat (afkorting van de term Dutch Batallion - (Nederlands bataljon, officieel: 1(NL)VN Infanteriebataljon) was een Nederlands infanteriebataljon, dat onder commando van de Verenigde Naties deel uitmaakte van de UNPROFOR vredesmacht van de Verenigde Naties in onder meer Bosnië."@nl;
    skos:altLabel "Dutch Batallion"@nl;
