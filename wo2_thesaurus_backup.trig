    skos:prefLabel "Reichsdeutsche"@de, "Imperial Germans"@en, "Rijksduitsers"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Rijksduitsers is de benaming voor alle staatsburgers van het Duitse Rijk van 1871 tot 1945."@nl;
    skos:altLabel "Rijksduitschers"@nl, "Reichsdeutsche"@nl, "Reichsdeutscher"@nl;
    skos:definition "Rijksduitsers is de benaming voor alle staatsburgers van het Duitse Rijk van 1871 tot 1945. Zij waren juridisch te onderscheiden van de Volksduitsers. Voor 1945 werden buiten Duitsland wonende Duitsers, dan wel Duitstaligen, Volksduitsers genoemd."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/2788> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/6e4ee238-8a05-4c4e-9c4b-6f61566cdfef>;
