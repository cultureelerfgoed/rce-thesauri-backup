    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Inundatie_van_Walcheren&oldid=53595594"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1922>;
    dcterms:created "2020-09-03T14:46:58.000Z"^^xsd:dateTime;
    skos:prefLabel "Evacuatie van Walcheren 1944"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Evacuatie van Walcheren vond in 1944 plaats na de inundatie van het gebied. De evacuatieplannen kwamen eerst niet van de grond, omdat de inwoners wilden blijven. Meer dan 30.000 mensen zaten in kleine gebieden bij Domburg en Middelburg. Pas na de bevrijding zijn een kleine tienduizend mensen naar Zuid-Beveland geëvacueerd."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/6676> .
  
