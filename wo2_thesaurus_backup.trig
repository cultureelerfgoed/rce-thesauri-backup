    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Troostmeisje&oldid=46859686"@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/demoadmin>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/events/8578>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2334>, <https://data.niod.nl/WO2_Thesaurus/1926>;
    dcterms:created "2016-08-01T19:19:31.000Z"^^xsd:dateTime;
    skos:prefLabel "Trostfrauen"@de, "Comfort women"@en, "Troostmeisjes"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "'Troostmeisjes' is de eufemistische term voor tienduizenden vrouwen die slachtoffer werden van Japanse dwangprostitutie tussen 1932 en 1945."@nl;
    skos:definition "Troostmeisjes zijn vrouwen en meisjes die voor en tijdens de Tweede Wereldoorlog door particulieren en de Japanse officiële instanties ter beschikking werden gesteld aan de Japanse militairen. Officieel luidt het dat deze meisjes en vrouwen zich vrijwillig aandienden om troost te bieden aan militairen. In werkelijkheid waren deze vrouwen seksslavinnen die tegen hun wil werden vastgehouden en gedwongen werden zich te prostitueren en was het een vorm van oorlogsverkrachting."@nl .
  
