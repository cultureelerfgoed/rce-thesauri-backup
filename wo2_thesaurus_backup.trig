    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/10208>;
    <http://schema.org/startDate> "1944-12-13"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Speciaal:Citeren&page=Drie_%28Gelderland%29&id=51785776&wpFormIdentifier=titleform"@nl,
      "https://oorlogsgravenstichting.nl/persoon/17815/jannes-born"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/locations/9638>;
    dcterms:created "2019-03-14T09:13:31.000Z"^^xsd:dateTime;
    skos:prefLabel "Verzet in de bossen bij Drie (Ermelo)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "In de Bossen bij Drie, nabij Ermelo, vonden tal van verzetsactiviteiten plaats. Toen drie leden van het verzet op 13 december 1944 naar een schuilplaats in het bos gingen, werden ze overvallen door de Duitse Sicherheitsdienst (SD). Twee van hen, Jannes Born en Corneille du Corbier, werden meteen neergeschoten en de laatste, Herman Leus, gaf zich over, werd gearresteerd en uiteindelijk op 8 maart 1945 gefusilleerd bij de Woeste Hoeve. "@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/locations/8091> a skos:Concept, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
