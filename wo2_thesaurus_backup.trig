    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/c939e84c-025a-11e7-904b-d89d6717b464/media/b78c6b1f-3295-5ff9-b197-fb05624a0b03"@nl;
    dcterms:source "https://www.japansekrijgsgevangenkampen.nl/JCJL-kamp.htm"@nl, "https://www.indischekamparchieven.nl/nl/zoeken?mivast=963&miadt=963&miahd=1258884857&miaet=14&micode=kampen&miview=ika2"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/b7354d29-49d5-4fe0-922a-3f3b5929fa84>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1699>, <https://data.niod.nl/WO2_Thesaurus/19098>;
    dcterms:created "2024-11-04T10:10:21.638Z"^^xsd:dateTime;
    skos:prefLabel "JCJL-kamp"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "JCJL-kamp was een krijgsgevangenkamp gelegen in de haven van Surabaya, Java. Het kamp was ondergebracht in kantoren, loodsen en bijgebouwen van de Java-China-Japan-Lijn, aan de Amsterdam-kade (nu Jl. Jamrud Selatan) aan de westzijde van de Kali Mas. Het kamp was van maart 1942 tot december 1944 operationeel. 1400 geïnterneerden werden hier ondergebracht, zowel krijgsgevangenen als burgermannen. Werkzaamheden waren o.a. opruim- en herstelwerkzaamheden in de haven. Vanaf half september 1942 fungeerde het complex als doorgangskamp voor gevangenentransporten naar werkkampen gelegen in het oosten van de Indonesische archipel."@nl;
    skos:altLabel "Soerabaja JCJL-kamp"@nl, "Surabaya JCJL-kamp"@nl, "Soerabaja Loods J.C.J.L"@nl,
      "JCJL-kamp Tandjoeng Perak"@nl .
  
