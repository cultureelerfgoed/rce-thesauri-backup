    dcterms:source "https://www.4en5mei.nl/oorlogsmonumenten/zoeken/400/warmenhuizen-oorlogsmonument"@nl,
      "https://in100fotos.nl/noord-holland/foto/nh-2-06/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2056>;
    dcterms:created "2021-10-06T12:57:02.866Z"^^xsd:dateTime;
    skos:prefLabel "Razzia Warmenhuizen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "In de nacht van 16 op 17 mei 1944 vond in Warmenhuizen een razzia plaats. Van de ongeveer 50 onderduikers die er zaten konden velen zich nog verbergen. Aanleiding voor de razzia was de ontvreemding van het bevolkingsregister door het verzet. In januari 1944 werden in het kader van de Arbeitseinsatz mannen opgeroepen voor werkzaamheden aan de Atlantikwal. Piet Kleibroek en zijn onderduikers de familie Drukker werden afgevoerd en kwamen in kampen om het leven."@nl .
  
