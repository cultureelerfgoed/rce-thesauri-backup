    dcterms:references "Esther Zwinkels, Het Overakker-complot: Indisch verzet tegen de Japanse bezetter op Sumatra 1942-1945. Houten : Spectrum, 2011"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-03-04T11:19:27.927Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8028>;
    <http://schema.org/startDate> "1943-01-01"^^xsd:date;
    <http://schema.org/endDate> "1945-01-09"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Overakker-complot&oldid=51553649"@nl;
    <https://data.niod.nl/EventsWO2/dateDescription> "januari 1943 - januari 1945"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2657>, <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2018-10-05T09:19:38.000Z"^^xsd:dateTime;
    skos:prefLabel "Overakker-complot"@nl, "Overakker Verschwörung"@de, "Overakker Conspiracy"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Het Overakker-complot was de naam van een vermeend complot in 1943-1944 door het Nederlands-Indisch verzet tegen de Japanners op Sumatra, vernoemd naar generaal-majoor Roelof Overakker. Samen met Vic Gosenson werd hij door de Japanners beschouwd werden als de leider achter het complot en op 9 januari 1945 na een rechtszaak werden gefusilleerd."@nl;
    skos:altLabel "Overakker Complot"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/6690> a <http://schema.org/Thing>, skos:Concept;
