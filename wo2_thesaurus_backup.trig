    dcterms:references "https://dutchculture.nl/en/news/camp-columbia-project-connecting-wwii-and-colonial-histories-australia-us-and-netherlands"@en,
      "https://paulbuddehistory.com/table-of-content/camp-columbia-preparing-for-re-colonialisation/"@en,
      "https://campcolumbia.com.au/the-big-timeline-of-the-dutch-occupation-of-camp-columbia/"@en,
      "https://en.wikipedia.org/w/index.php?title=Camp_Columbia_(Wacol)&oldid=1249841559"@en;
