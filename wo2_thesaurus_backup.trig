  <https://data.niod.nl/WO2_Thesaurus/locations/11329> a skos:Concept, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2024-08-15T12:34:14.077Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/isPointofInterest> true;
