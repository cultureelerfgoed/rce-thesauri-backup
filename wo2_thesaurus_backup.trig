    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/6411>;
    dcterms:created "2018-07-13T11:02:59.000Z"^^xsd:dateTime;
    skos:prefLabel "Stalag VIII-A"@nl, "Stalag VIII-A"@de, "Stalag VIII-A"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Stalag VIII-A was een Duits krijgsgevangenkamp ten zuiden van Görlitz in Neder-Silezië. Het oorspronkelijke Hitler Jeugdkamp werd in augustus 1939 omgebouwd om 15.000 Poolse gevangenen te huisvesten. Het was in eerste instantie een doorgangskamp maar op 23 september 1939 omgedoopt tot Stalag VIII-A. Later kwamen er zo'n  30.000 geallieerde krijgsgevangenen bij. De Franse componist Olivier Messiaen zat hier ook gevangen en componeerde er het stuk Quartet for the end of time. In 1943 waren er 976 dwangarbeidskampen ondergeschikt aan Stalag VIII-A. De evacuatie van het kamp begon op 14 februari 1945 en duurde tot mei. Op 7 mei 1945 werd het kamp door de Russen bevrijd."@nl;
    skos:altLabel "Stalag VIII A"@nl, "Stalag VIII-A Goerlitz"@nl, "Stalag VIII-A Görlitz"@nl .
  
