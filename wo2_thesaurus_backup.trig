    dcterms:source "https://wikimiddenbrabant.nl/Vliegtuigcrash_Haansche_Hoef,_21_juli_1944"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2329>;
    dcterms:created "2025-10-09T09:06:18.188Z"^^xsd:dateTime;
    skos:prefLabel "Vliegtuigcrash Haansche Hoef Tilburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De crash van een Britse bommenwerper in Haansche Hoef in Tilburg vond plaats op 21 juli 1944. Het toestel was op de terugweg van een bombardement op installaties in het Ruhrgebied. Het toestel stort brandend neer in het uiterste noordwesten van Tilburg, tegen de grens met Dongen. Alle zeven bemanningsleden komen hierbij om het leven."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/21854> a <http://schema.org/Thing>, skos:Concept,
