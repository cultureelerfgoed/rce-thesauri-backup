    <http://schema.org/startDate> "1944-12-29"^^xsd:date;
    <http://schema.org/endDate> "1945-02-13"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Slag_om_Boedapest&oldid=55864033"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3558>;
    dcterms:created "2020-09-11T07:50:34.000Z"^^xsd:dateTime;
    skos:prefLabel "Slag om Boedapest"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Slag om Boedapest was een gevecht aan het Oostfront. De slag begon op 29 december 1944 toen de Sovjettroepen de Hongaarse hoofdstad insloten. Boedapest werd verdedigd door het Hongaarse en Duitse leger, maar tevergeefs: op 13 februari 1945 eindigde het gevecht toen de stad helemaal was omsingeld door Sovjettroepen."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9411> a <http://schema.org/Thing>, skos:Concept,
