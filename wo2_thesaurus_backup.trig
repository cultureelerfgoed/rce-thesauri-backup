    skos:prefLabel "Korps Vrouwelijke Vrijwilligers"@nl, "'Korps Vrouwelijke Vrijwilligers'"@de,
      "'Korps Vrouwelijke Vrijwilligers'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Korps Vrouwelijke Vrijwilligers (KVV) was een maatschappelijke hulporganisatie en werd in 1938 in Amsterdam opgericht door Jane de Iongh. Het KVV had als doel door middel van vrijwilligerswerk de actieve maatschappelijke betrokkenheid van vrouwen vorm te geven. Tijdens de Duitse bezetting groeide de organisatie uit tot een landelijke hulporganisatie met 2.000 afdelingen. In die tijd werd besloten de naam te veranderen in ‘Unie van Vrouwelijke Vrijwilligers', die al op 7 mei 1945 officieel van start kon gaan."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization>;
    skos:hiddenLabel "Unie van Vrouwelijke Vrijwilligers"@nl, "Unie van Vrijwilligers"@nl,
      "U.V.V."@nl, "UVV"@nl, "U.V.V.V."@nl, "UVVV"@nl .
  
