    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://de.wikipedia.org/wiki/Stammlager_IX_A#/media/Datei:Eingangstor_Friedhof_Trutzhain_bzw._Stalag_IX_A_Ziegenhain_2.jpg";
    dcterms:source "https://krijgsgevangen.nl/stalag-ix-a-ziegenhain/"@nl, "https://de.wikipedia.org/wiki/Stammlager_IX_A"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
