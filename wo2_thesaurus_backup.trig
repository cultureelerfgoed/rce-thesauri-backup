    skos:prefLabel "Oflag VIII-B"@nl, "Oflag VIII-B"@de, "Oflag VIII-B"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Oflag VIII-B was een Duits krijgsgevangenkamp in fort Srebrnogórska in Zilverberg, Polen. Het kamp was tussen 15 december 1939 en 1 september 1941 in gebruik voor Poolse officieren. Fort Srebrnogórska is tegenwoordig een militair museum. "@nl;
    skos:altLabel "Oflag Silberberg"@nl, "Oflag VIII B"@nl, "Oflag VIII-B Silberberg"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/6467> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
