    skos:broader <https://data.niod.nl/WO2_Thesaurus/8786>;
    dcterms:created "2020-08-11T10:51:36.000Z"^^xsd:dateTime;
    skos:prefLabel "Gunners"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "'Gunners' was een benaming door de 200 vrijwillige Surinaamse schutters die de afweergeschut op marineschepen of koopvaardijschepen bedienden. Deze schepen vervoerden olie, bauxiet, voedsel en wapens van de Verenigde Staten naar Europa. "@nl;
    skos:altLabel "Gunner"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/9222> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:references "Liesbert van der Horst, Wereldoorlog in de West. Suriname, de Nederlandse Antillen en Aruba 1940-1945 (Hilversum: Uitgeverij Verloren, 2004)"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
