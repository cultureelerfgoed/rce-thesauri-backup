    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4485>;
    dcterms:created "2024-06-12T12:34:45.527Z"^^xsd:dateTime;
    skos:prefLabel "Fascistenbond De Bezem"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Fascistenbond De Bezem was een Nederlandse fascistische partij, opgericht in de eerste weken van 1931. De oprichters waren Alfred en Willem Haighton, samen met Jan Baars. De marginale partij viel in 1932 uiteen wegens onenigheid in eigen gelederen."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/20995> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "R. te Slaa en E. Klijn, De NSB. Deel 1 (Amsterdam ; derde druk 2011)."@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-06-12T14:55:52.916Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4620>;
    dcterms:created "2024-06-12T14:51:04.829Z"^^xsd:dateTime;
    skos:prefLabel "N.S.N.A.P.-Schouten"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De NSNAP-Schouten was een fascistische splinterpartij die ontstond op 27 oktober 1933 als afsplitsing van de NSNAP die onder leiding stond van Haighton en Smit. Ook deze NSNAP-partij was geen lang leven beschoren: in april 1934 werd zij officieel ontbonden."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/20996> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "R. te Slaa en E. Klijn, De NSB. Deel 1 (Amsterdam ; derde druk 2011)."@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-06-13T06:46:08.360Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4620>;
    dcterms:created "2024-06-12T14:57:41.917Z"^^xsd:dateTime;
    skos:prefLabel "N.S.N.A.P.- Van Waterland"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De NSNAP- Van Waterland, ook wel Nationaal-Socialistisch Partij (NSP), was een fascistische splinterpartij die bestond tussen 1932 en 1941. Albert van Waterland was een pseudoniem voor Albert de Joode, een matig wervende achternaam binnen het fascistische milieu. Vanaf 1935 werd de partij voortgezet onder de naam Natíonaal-Socialistische Partij"@nl;
    skos:altLabel "N.S.N.A.P. - de Joode"@nl, "NSNAP De Nederlandsche Hakenkruisers"@nl,
      "De Hakenkruisers"@nl .
  
