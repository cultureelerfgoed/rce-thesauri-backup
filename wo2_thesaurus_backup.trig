    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Ternopil&oldid=56691291"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/4396>;
    dcterms:created "2020-09-14T07:34:19.000Z"^^xsd:dateTime;
    skos:prefLabel "Aanval op Ternopil"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Aanval op Tarnopol vond plaats op 29 juni 1941. De stad, die na de aanval op Polen in 1940 werd ingenomen door de Sovjet-Unie, veranderde na de komst van de nazi's. Zo richtte de SS de Tarnopol-ghetto op, waar alle Joodse burgers terechtkwamen. Later werden zij getransporteerd naar kampen in Nazi-Duitsland. In 1944 heroverde de Sovjet-Unie Tarnopol. Tijdens het bewind van de Sovjet-Unie in 1940 was de stad ook niet veilig voor alle inwoners: met hulp van de voormalige Poolse autoriteiten bestreden de Sovjets de Oekraïense nationalisten. Daarnaast deporteerden de Sovjets op grote schaal het Poolse deel van de bevolking naar Kazachstan."@nl;
    skos:altLabel "Aanval op Tarnopol"@nl .
  
