      "https://www.parlement.com/id/vhm0l02igvut/soevereiniteitsoverdracht_aan_indonesie"@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1584>, <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2016-10-04T11:45:13.000Z"^^xsd:dateTime;
    skos:prefLabel "'Indonesisch vraagstuk'"@de, "'Indonesisch vraagstuk'"@en, "Indonesisch vraagstuk"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Het Indonesisch vraagstuk betreft de omgang van Nederland met de op 17 augustus 1945 uitgeroepen Indonesische onafhankelijkheid. De Nederlandse regering weigerde deze te erkennen omdat ze de onafhankelijkheid zag als een direct gevolg van de Japanse bezetting tijdens de Tweede Wereldoorlog maar zag zich onder internationale druk toch gedwongen tot een soevereiniteitsoverdracht."@nl;
    skos:altLabel "Indonesische kwestie"@nl .
  
