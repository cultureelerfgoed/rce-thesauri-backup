    <http://schema.org/startDate> "1945-09-01"^^xsd:date;
    <http://schema.org/endDate> "1963-12-30"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1561>;
