    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2682>;
    dcterms:created "2021-02-04T10:12:19.339Z"^^xsd:dateTime;
    skos:prefLabel "Liquidatie van Dirk Bouma"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De liquidatie van Dirk Bouma vond plaats op 20 februari 1945 in Bergen (NH). Bouma was lid van de NSB en SD-handlanger. Op 20 februari 1945 moest hij zich op last van de Duitse overheid melden op het politiebureau in Bergen. Diezelfde dag is hij door het verzet geliquideerd."@nl .
  
