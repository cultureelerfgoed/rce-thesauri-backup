    skos:broader <https://data.niod.nl/WO2_Thesaurus/2506>;
    dcterms:created "2019-01-22T10:10:31.000Z"^^xsd:dateTime;
    skos:prefLabel "GERINDO"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "GERINDO (Gerakan Rakyat Indonesia, 'Volksbeweging van Indonesië' bestond van 24 mei 1937 tot aan de Japanse bezetting van Nederlands-Indië en was de directe opvolger van de verboden PARTINDO (PNI). Het doel van de GERINDO was, in tegenstelling to de PARTINDO, door samenwerking met de Nederlanders een onafhankelijk Indonesië te creëren. Het was in eerste instantie opgezet door linkse politieke partijen, maar later sloten zich toch ook leden van verboden partijen zich aan bij de GERINDO. "@nl;
    skos:altLabel "Gerakan Rakyat Indonesia"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/1717>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7732> a <http://schema.org/Thing>,
