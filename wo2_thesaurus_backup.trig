    dcterms:source "https://www.omroepbrabant.nl/nieuws/2491978/op-4-mei-denkt-ook-roosendaal-weer-terug-aan-zijn-oorlogsverleden"@nl,
      "https://www.bndestem.nl/roosendaal/strepenpakskes-aan-wouwseweg~a273ff5f/?referrer=https%3A%2F%2Fwww.google.com%2F&cb=47cd56f8871a459fea76e2d100c89f1f&auth_rd=1"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/4884>;
    dcterms:created "2023-06-19T14:38:06.161Z"^^xsd:dateTime;
    skos:prefLabel "Buitencommando Roosendaal"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Buitenkommando Roosendaal was een Aussenlager of buitenkamp van Kamp Vught waar gevangenen in het voorjaar van 1944 te werk werden gesteld. De gevangenen moesten in de omgeving van Roosendaal tankgrachten graven en werden ondergebracht in de voormalig Landbouwwinterschool aan de Wouwseweg. "@nl;
    skos:altLabel "Buitenkommando Roosendaal"@nl, "Aussenlager Roosendaal"@nl, "Werkkamp Roosendaal"@nl .
  
