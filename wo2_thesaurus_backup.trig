    <https://data.niod.nl/organizationsWO2/startDate> "1941-06-05"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/2be07516-025a-11e7-904b-d89d6717b464/media/586b9259-d2e6-0787-227c-6a5416dca130>,
      <https://beeldbankwo2.nl/nl/beelden/detail/9cd62892-025a-11e7-904b-d89d6717b464/media/6c168d90-2b9f-ee68-2b57-3b731bd74a76>;
    <https://data.niod.nl/organizationsWO2/endDate> "1944-08-01"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    skos:relatedMatch <https://data.niod.nl/WO2_biografieen/Paulus-Gerardus-de-Jager-Meezenbroek>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Het Algemeen Toezicht Leden (ATL) was de interne inlichtingendienst van de Nationaal-Socialistische Beweging (NSB). De organisatie werd in juni 1941 opgericht. De taken van het ATL waren het beoordelen van aspirant-NSB-leden, het onderzoeken van conflicten binnen de NSB en het opstellen van rapporten over individuele NSB-leden. Dit leverde veel spanningen op binnen de NSB, waardoor partijleider Anton Mussert het ATL ophief op 1 augustus 1944."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3554>, <https://data.niod.nl/WO2_Thesaurus/2244>;
    dcterms:created "2023-05-15T11:18:45.237Z"^^xsd:dateTime;
    skos:prefLabel "Algemeen Toezicht Leden"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Algemeen Toezicht Leden (ATL) werd 5 juni 1941 door NSB-leider Mussert ingesteld als interne inlichtingendienst van de NSB nadat de Centrale Inlichtingen Dienst (CID) op bevel van Höherer SS- und Polizeiführer Hanns Albin Rauter werd opgeheven. Het ATL werd geleid door Paulus Gerardus de Jager Meezenbroek en viel direct onder plaatsvervangend leider Kees van Geelkerken. De taken van de ATL was het evalueren van aspirant-leden, het onderzoeken van geschillen binnen de NSB en het opstellen van rapporten over de NSB-leden. In de praktijk hield het ATL zich steeds meer bezig met het bespioneren van partijfunctionarissen wat bij NSB-kopstukken steeds meer weerstand opriep. Na een vernietigend rapport hief Mussert het ATL per 1 augustus 1944 op."@nl;
    skos:altLabel "A.T.L."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/19577>, <https://data.niod.nl/WO2_Thesaurus/19922>,
      <https://data.niod.nl/WO2_Thesaurus/19923>, <https://data.niod.nl/WO2_Thesaurus/19924>,
      <https://data.niod.nl/WO2_Thesaurus/19925>;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Organization> .
  
