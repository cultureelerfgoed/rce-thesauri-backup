    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/11363>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/f/f6/Auschwitz_Birkenau_map.png/1280px-Auschwitz_Birkenau_map.png";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Auschwitz-Birkenau#/media/Bestand:Auschwitz_Birkenau_map.png";
