    <http://schema.org/startDate> "1943-04-01"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Netherlands_Forces_Intelligence_Service&oldid=53040579"@nl;
    <http://schema.org/description> "In Melbourne wordt NEFIS (Netherlands Forces Intelligence Service) opgericht. De inlichtingendienst wordt geleid door kapitein-luitenant-ter-zee G.B. Salm en heeft de taak inlichtingen te verzamelen over bezet Nederlands-Indië en de activiteiten de Japanners. Onder leiding van luitenant-ter-zee J.J. Quéré houdt Sectie III (Speciale inlichtingen en Bijzondere operaties) zich bezig met het opleiden en uitzenden van inlichtingen ‘parties’ naar bezet Nederlands-Indië. NEFIS zendt in de oorlogsjaren 37 inlichtingengroepen (‘parties’) uit."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/8185>, <https://data.niod.nl/WO2_Thesaurus/corporaties/7710>;
    dcterms:created "2019-04-03T12:24:07.000Z"^^xsd:dateTime;
    skos:prefLabel "Oprichting NEFIS"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Oprichting NEFIS (Netherlands Forces Intelligence Service) vindt plaats in Melbourne op 1 april 1943. De inlichtingendienst wordt geleid door kapitein-luitenant-ter-zee G.B. Salm en heeft de taak inlichtingen te verzamelen over bezet Nederlands-Indië en de activiteiten de Japanners."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8272> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
