    dcterms:source "https://www.overijsselviertvrijheid.nl/oorlogsfotos/125"@nl, "https://nl.wikipedia.org/wiki/Twentol-drama"@nl;
    skos:relatedMatch <https://data.niod.nl/WO2_Thesaurus/events/7233>;
    <http://schema.org/name> "Deventer";
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/events/7233>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/6983>;
    dcterms:created "2018-10-31T10:45:53.000Z"^^xsd:dateTime;
    skos:prefLabel "Befreiung von Deventer"@de, "Liberation of Deventer"@en, "Bevrijding Deventer"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De bevrijding van Deventer vond plaats op 10 april 1945. Terwijl de Canadezen nog in gevecht waren met de Duitsers werd er al feest gevierd. Door Duits granaatvuur kwamen twaalf feestvierders om het leven. Twee verzetsdeelnemers die de bruggen over de IJssel en de havens voor de bevrijders veilig wilden stellen kwamen om in hun schuilplaats, het gebouw Twentol. Vijf anderen werden opgepakt en gefusilleerd. "@nl .
  
