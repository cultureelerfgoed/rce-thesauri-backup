      <https://data.niod.nl/WO2_Thesaurus/18822>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/20699>;
    dcterms:created "2022-02-21T10:54:37.076Z"^^xsd:dateTime;
    skos:prefLabel "Beth Refoeah"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Beth Refoeah was een Joods rusthuis in Hilversum. Joodse patiënten die een rustkuur kregen voorgeschreven, konden hier terecht. Het rusthuis bestond van 1928 tot 1943, toen de bewoners werden gedeporteerd."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/18715> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-04-09T10:35:12.351Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/18716>;
    dcterms:source "https://www.joodsmonument.nl/nl/page/587453/huize-beth-dina-te-santpoort"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/6171>, <https://data.niod.nl/WO2_Thesaurus/2887>;
    dcterms:created "2022-02-21T11:24:31.401Z"^^xsd:dateTime;
    skos:prefLabel "Huize Dina"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Huize Dina werd in januari 1930 opgericht door de Vereeniging tot Bescherming van Joodsche Meisjes. Huize Dina bood onderdak aan Joodse meisjes die door armoede, sociale problemen of de dood van hun ouder(s) niet meer thuis konden wonen. De 15 meisjes die er in 1942 woonden werden gedeporteerd en vermoord in Sobibor en Auschwitz."@nl .
  
