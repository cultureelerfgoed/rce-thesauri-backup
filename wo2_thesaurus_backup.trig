      <https://beeldbankwo2.nl/nl/beelden/detail/16a53998-025a-11e7-904b-d89d6717b464/media/37237336-a154-d4ba-750e-39345cf97b9f>,
      <https://www.openbeelden.nl/media/958778>, <https://beeldbankwo2.nl/nl/beelden/detail/d28cb410-025a-11e7-904b-d89d6717b464/media/51f1a0d0-f10a-fe78-a30d-837451fe9f3b>;
    <http://schema.org/startDate> "1942-07-01"^^xsd:date;
    <http://schema.org/endDate> "1944-09-13"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Kamp_Westerbork&oldid=56933404"@de;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/4869>;
    dcterms:created "2020-09-09T08:48:03.000Z"^^xsd:dateTime;
    skos:prefLabel "Doorgangskamp Westerbork"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Doorgangskamp Westerbork bestond vanaf 1 juli 1942, nadat het kamp onder direct Duits bestuur kwam te staan. De eerste commandant was Erich Deppner. Vanaf 12 oktober 1942 tot de bevrijding was Albert Konrad Gemmeker de kampcommandant. Veel belangrijke posities in de kamporganisatie werden bekleed door Duitse Joden, die als vluchteling het kamp binnen waren gekomen voor de bezetting. Vanuit Doorgangskamp Westerbork vertrokken wekelijks, of twee wekelijks, transporten naar vooral Auschwitz en Sobibor. Op 13 september 1944 vertrok het laatste transport vanuit Westerbork."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/9392> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "Evertjan van Roekel, Veldgrauw. Nederlanders in de Waffen-SS (Amsterdam: Het Spectrum bv, 2019)"@de;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2020-09-15T07:34:32.000Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/640x480/56328ce2-fd57-d1a9-1aa3-bd7fbe6d7b00.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/f76d9a88-025a-11e7-904b-d89d6717b464/media/56328ce2-fd57-d1a9-1aa3-bd7fbe6d7b00"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3492>;
    dcterms:created "2020-09-10T07:22:56.000Z"^^xsd:dateTime;
    skos:prefLabel "Veldgrauw"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Veldgrauw was een benaming voor een grijsgroene kleur van de uniformen waar Nederlandse vrijwilligers bij de Waffen-SS in vochten. De term was een compromis tussen het Duitse 'Feldgrau' en Nederlandse 'veldgrijs'. Door het kenmerkende kleurverschil in de uniformen, was veldgrauw het symbool voor de positie van deze Nederlanders.  "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/9409> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2021-06-22T12:43:05.553Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/f/f2/Joseph_Stalin%2C_Franklin_D_Roosevelt_and_Winston_Churchill%2C_in_Teheran%2C_1943%2C_edit.jpg/500px-Joseph_Stalin%2C_Franklin_D_Roosevelt_and_Winston_Churchill%2C_in_Teheran%2C_1943%2C_edit.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/w/index.php?title=Conferentie_van_Teheran&oldid=54794551#/media/Bestand:Joseph_Stalin,_Franklin_D_Roosevelt_and_Winston_Churchill,_in_Teheran,_1943,_edit.jpg"@nl;
    <http://schema.org/startDate> "1943-11-28"^^xsd:date;
    <http://schema.org/endDate> "1943-12-01"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Conferentie_van_Teheran&oldid=54794551"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2629>;
    dcterms:created "2020-09-11T06:17:32.000Z"^^xsd:dateTime;
    skos:prefLabel "Conferentie van Teheran"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De conferentie van Teheran was een bijeenkomst in de Sovjet-ambassade in Teheran, waar Jozef Stalin, Franklin Roosevelt en Winston Churchill aanwezig waren. De conferentie vond plaats op 28 november tot 1 december 1943 onder de codenaam 'Eureka'. Tijdens het overleg werd de strategie tegen Nazi-Duitsland besproken. Hierbij stond de discussie om een tweede front in West-Europa te openen centraal."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/9439> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2021-06-29T10:37:10.367Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/16926>,
      <https://data.niod.nl/WO2_Thesaurus/locations/16934>, <https://data.niod.nl/WO2_Thesaurus/locations/16936>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/2/2e/Bundesarchiv_Bild_101III-Toelz-5228-08%2C_Bad_T%C3%B6lz%2C_SS-Junkerschule.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/SS-Junkerschule#/media/Bestand:Bundesarchiv_Bild_101III-Toelz-5228-08,_Bad_T%C3%B6lz,_SS-Junkerschule.jpg"@nl;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=SS-Junkerschule&oldid=55332586"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2420>;
    dcterms:created "2020-09-15T08:53:54.000Z"^^xsd:dateTime;
    skos:prefLabel "SS-Junkerschule"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De SS-Junkerschule was een opleidingsinstituut voor de Waffen-SS. De school zat gevestigd op vier verschillende locaties: Bad Tölz, Braunschweig, Klagenfurt en Praag-Dejvice. Naast de militaire training kregen de studenten ook lessen in levensbeschouwing- en ethiek, geheel volgens de normen en waarden van de SS. In ongeveer 22 lichtingen studeerden 15.000 SS-leiders aan deze opleiding af, die terechtkwamen bij de Sicherheitsdienst, Verfügungstruppe, Ordnungspolizei en Totenkopfverbände."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
