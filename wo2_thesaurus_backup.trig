      "https://nl.wikipedia.org/w/index.php?title=Wikipedia:Wikiproject/Verzetskranten/Beginnetjes/B.B.C.-nieuws;_uitgave_van_bet_bijkantoor_der_British_Broadcasting_Corporation_(verzetsblad,_Sneek-Workum)&oldid=46516528"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>;
    dcterms:created "2019-11-06T09:54:26.000Z"^^xsd:dateTime;
    skos:prefLabel "B.B.C.-nieuws; uitgave van bet bijkantoor der British Broadcasting Corporation"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "B.B.C.-nieuws; uitgave van bet bijkantoor der British Broadcasting Corporation was een Nederlands verzetsblad, dat van 15 jun 1943 tot 25 mei 1945 in een oplage van 300 tot 5500 stuk verscheen in Workum en Sneek. Tot juli 1944 verscheen het twee maal per week om vanaf dan drie maal per week te verschijnen. Het blad bestond voornamelijk uit nieuwsberichten."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8632> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "PPN: 268797943"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2019-11-07T16:12:59.000Z"^^xsd:dateTime;
    dcterms:source "https://upload.wikimedia.org/wikipedia/commons/2/23/PDF_of_De_Ondergrondse_Pers_1940-1945_-_derde_druk_-_1989.pdf"@nl,
      "https://nl.wikipedia.org/w/index.php?title=Je_Maintiendrai_(krant)&oldid=54245062"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>;
    dcterms:created "2019-11-06T10:07:03.000Z"^^xsd:dateTime;
    skos:prefLabel "B.C. Nieuws"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "B.C. Nieuws was een Nederlands verzetsblad dat gedrukt werd in Santpoort en met een oplage van 500 tot 5000 stuks maandelijks verscheen. Het blad werd ook in onder andere in Amsterdam, Zwolle en Den Haag vermenigvuldigd en verspreid en het Vredespaleis in Den Haag werd vanaf september 1942 de verschijningsplaats. In 1943 werd de titel gewijzigd in Je Maintiendrai en werd een samenwerking aangegaan met Bulletin."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8633> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "PPN: 268961948"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2019-11-07T16:16:31.000Z"^^xsd:dateTime;
    dcterms:source "https://upload.wikimedia.org/wikipedia/commons/2/23/PDF_of_De_Ondergrondse_Pers_1940-1945_-_derde_druk_-_1989.pdf"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>;
    dcterms:created "2019-11-06T10:30:28.000Z"^^xsd:dateTime;
    skos:prefLabel "Berichten Voorziening Oorlogstijd"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Berichten Voorziening Oorlogstijd (BVO) was een Nederlands verzetsblad dat in een oplage van 200 tot 2000 stuks van 25 mei 1944 tot 29 december 1944 dagelijks werd uitgegeven in Roermond, met medewerking van de plaatselijke Landelijke Organisatie voor Hulp aan Onderduikers (LO). Toen in december 1944 de bezetter hard optrad tegen verzet en executie en represaillemaatregel werd geïntensiveerd besloot de LO de berichtgeving te stoppen. Heythuysen had van 20 september 1944 tot de 22 november 1944 en lokale BVO dat met een oplage van 500 stuks dagelijks verscheen."@nl;
    skos:altLabel "BVO"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8634> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "PPN: 832242594"@nl;
