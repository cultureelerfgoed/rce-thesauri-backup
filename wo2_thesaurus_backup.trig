    <http://schema.org/location> "Leusden";
    <http://schema.org/startDate> "1943-02-03"^^xsd:date;
    dcterms:source "https://www.tracesofwar.nl/news/5973/Fotoverslag-onthulling-monument-Short-Stirling-Mark-I-R9197-BU-V.htm"@nl,
      "https://www.historieleusden.nl/vliegtuigcrash1943.html"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2316>;
    dcterms:created "2020-11-24T15:33:06.508Z"^^xsd:dateTime;
    skos:prefLabel "Bommenwerper crasht in Leusden"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Op 3 februari 1943 om 20.04 uur stortte een Stirling bommenwerper nabij de spoordijk in Leusden neer na een luchtgevecht met een Duitse nachtjager Messerschmitt. Alle acht bemanningsleden uit het Verenigd Koninkrijk en Canada kwamen om het leven. Zij zijn begraven op het Gemenebest Ereveld van begraafplaats Rusthof in Leusden."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/10545> a <http://schema.org/Thing>, skos:Concept,
