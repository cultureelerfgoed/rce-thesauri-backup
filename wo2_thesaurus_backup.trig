    <http://schema.org/endDate> "1942-07-07"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Slag_bij_Midway&oldid=49453060"@nl;
    <http://schema.org/description> "Bij De slag om Midway probeert de Japanse marine de Amerikaanse marine tot een beslissende zeeslag te forceren door het eiland Midway aan te vallen, maar wordt verrast door de aanwezigheid van drie Amerikaanse vliegdekschepen. De Amerikanen zijn op de hoogte van de plannen omdat zij het gecodeerde berichtenverkeer van de Japanse marine kunnen ontcijferen. Hierdoor lijdt de Japanse marine een zware nederlaag tijdens deze meerdaagse zeeslag bij het eiland Midway. "@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2350>, <https://data.niod.nl/WO2_Thesaurus/3536>,
      <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2017-12-20T07:33:29.000Z"^^xsd:dateTime;
    skos:prefLabel "Slag om Midway"@nl, "Schlacht um Midway"@de, "Battle of Midway"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Slag om Midway was een zeeslag op 4 juni 1942 tussen de Amerikaanse en Japanse vloot. De slag luidde een keerpunt in, waarna de Japanse Marine in het defensief terecht kwam."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
