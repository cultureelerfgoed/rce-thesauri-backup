    <http://schema.org/location> "Milnebaai";
    <http://schema.org/startDate> "1943-04-14"^^xsd:date;
    dcterms:source "https://en.wikipedia.org/wiki/SS_Van_Heemskerk_(1909)"@nl;
    skos:relatedMatch <https://data.niod.nl/WO2_Thesaurus/17769>;
