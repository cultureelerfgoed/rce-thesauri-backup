    skos:prefLabel "Voedselprotesten"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Voedselprotesten vonden plaats in veel steden tijdens de Hongerwinter. Begin 1945 verenigden vrouwen in de meest getroffen steden zich om beter en meer voedsel te eisen van de plaatselijke autoriteiten. Het eerste protest vond plaats in Schiedam vanaf begin januari 1945."@nl .
  
