    dcterms:created "2022-01-06T15:02:47.258Z"^^xsd:dateTime;
    skos:prefLabel "Evacuatie van Bunschoten-Spakenburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Evacuatie van Bunschoten-Spakenburg vond plaats op 10 mei 1940. Bunschoten-Spakenburg lag binnen de Grebbelinie en werd na de Duitse inval mogelijk gevechtsterrein. 5.500 inwoners van Bunschoten-Spakenburg vertrokken per schip naar Enkhuizen. Twee weken later konden zij terugkeren."@nl .
  
