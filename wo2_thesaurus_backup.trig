    dcterms:source "https://www.archieven.nl/nl/search-modonly?mivast=298&mizig=210&miadt=298&micode=182&miview=inv2#inv3t3"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
