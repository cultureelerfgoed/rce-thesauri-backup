    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/9577>;
    <http://schema.org/startDate> "1943-05-01"^^xsd:date;
    dcterms:source "P. J. Bouman, De April-Mei-Stakingen van 1943 (’s-Gravenhage: Martinus Nijhoff, 1950)"@nl;
    <https://data.niod.nl/organizationsWO2/isCausedBy> <https://data.niod.nl/WO2_Thesaurus/events/2661>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/9271>;
    dcterms:created "2020-11-17T10:43:59.596Z"^^xsd:dateTime;
    skos:prefLabel "Fusillade in Amsterdam, 1 mei 1943"@nl, "Hinrichtung in Amsterdam,  1. Mai 1943"@de,
      "Execution in Amsterdam, May 1, 1943"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Fusillade in Amsterdam van 1 en 2 mei 1943 was een reactie op de April-Meistakingen in Noord-Holland en de rest van Nederland. Op 30 april was het politiestandrecht afgekondigd en werden er onmiddellijk honderden stakers gearresteerd. Enkelen werden op 1 en 2 mei 1944 op een onbekende locatie in de buurt van Amsterdam geëxecuteerd. Van de 700 stakende arbeiders van de N.V. Verenigde Blikfabrieken in Krommenie werden Johannes Antonius van Lemmeren, Gerard Wiersma, Theodorus Rijkhoff, Hendrik Blank geëxecuteerd. Van de circa 4000 stakende arbeiders van de hoogovens en walsfabrieken in Velsen-IJmuiden werden Theodorus Sander Hendrikse, Nicolaas van Nieuwkoop en Jacob Wijker geëxecuteerd. Van de 500 stakende arbeiders van de N.V. Koninklijke Papierfabriek van Gelder & Zonen werden Hendrik Marinus Strating en Pieter Houtkooper geëxecuteerd. Ook stationchef van station Velsen-IJmuiden, Herman Pieter de Noo werd geëxecuteerd."@nl .
  
