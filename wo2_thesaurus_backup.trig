    dcterms:source "https://books.google.nl/books?id=rsRLEAAAQBAJ&pg=PA477&lpg=PA477&dq=stalag+XII-F+Bolchen&source=bl&ots=B7eXndl74I&sig=ACfU3U2f_a6N0WJFE_Elnsji9wJ8q6sS-A&hl=nl&sa=X&ved=2ahUKEwjvhNr8zr31AhWQGewKHSgYBJ0Q6AF6BAgSEAM#v=onepage&q=stalag%20XII-F%20Bolchen&f=false"@nl;
