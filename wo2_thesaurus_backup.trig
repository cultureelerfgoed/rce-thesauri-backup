    skos:prefLabel "Bevrijding Neuengamme"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "De Bevrijding van Kamp Neuengamme vond plaats op 4 mei 1945. De geallieerden troffen een leeg kamp aan, de gevangenen waren eerder geëvacueerd. De administratie was verbrand en het kamp was opgeruimd en schoongemaakt voordat de SS'ers vertrokken op 2 mei."@nl;
    skos:altLabel "Bevrijding Kamp Neuengamme"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
