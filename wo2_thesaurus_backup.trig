  <https://data.niod.nl/WO2_Thesaurus/2122> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "Handboek van de Tweede Wereldoorlog (Utrecht/Antwerpen,1980)"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2020-09-15T12:37:37.000Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> <https://images.memorix.nl/ams/thumb/250x250/6b70520f-3e59-5a41-9c19-0cb77f9262dd.jpg>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://beeldbank.amsterdam.nl/afbeelding/HOFM0100070000001";
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/demoadmin>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/corporaties/4471>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2057>, <https://data.niod.nl/WO2_Thesaurus/2751>;
    dcterms:created "2016-08-01T19:19:49.000Z"^^xsd:dateTime;
    skos:prefLabel "Schleichhandel"@de, "Black trade"@en, "Zwarthandel"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Zwarthandel is illegale handel in goederen. Tijdens de Tweede Wereldoorlog waren die goederen vooral voedsel en genotsmiddelen die onder de distributie en de daarmee samenhangende prijsbeheersing vielen. Betaling geschiedde in geld, zilver, goud en natura. Tijdens de Hongerwinter liepen de prijzen zeer hoog op."@nl .
  
