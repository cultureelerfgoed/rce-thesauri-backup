    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/b7354d29-49d5-4fe0-922a-3f3b5929fa84>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1690>, <https://data.niod.nl/WO2_Thesaurus/1631>,
      <https://data.niod.nl/WO2_Thesaurus/8204>, <https://data.niod.nl/WO2_Thesaurus/19098>;
    dcterms:created "2025-01-06T20:05:50.710Z"^^xsd:dateTime;
    skos:prefLabel "Gevangenis Djokjakarta"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Gevangenis Djokjakarta was een mannenkamp en republikeins kamp aan de Gevangenislaan (nu Jl. Taman Siswa) in het zuidoosten van Yogyakarta, Midden-Java. In de periode van 23 april 1942 tot 21 juni 1942 waren hier 80 mannen geïnterneerd, o.a. hogere ambtenaren van het Binnenlands Bestuur, sultanaatsambtenaren en politiefunctionarissen. Juni 1942 werden zij naar Fort Vredeburg overgebracht. In 1945 en 1946 functioneerde dit kamp als republikeins kamp voor Indonesische, Japanse en Nederlandse mannen."@nl;
    skos:altLabel "Gevangenis Yogyakarta"@nl .
  
