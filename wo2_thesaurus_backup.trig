    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/boumani>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/19539>;
    dcterms:created "2023-10-23T12:47:41.168Z"^^xsd:dateTime;
    skos:prefLabel "Bombardement op Deest op 8 februari 1945"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote """Het bombardement op Deest vond plaats op 8 februari 1945. De bom viel recht op het huis direct grenzend aan het rampgebied, de beeldbepalende boerderij van de familie Litjens in de Grotestraaten. Hierbij vielen tien doden, waaronder leden van de familie Litjens en Engelse militairen.
"""@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/20558> a <http://schema.org/Thing>, skos:Concept,
