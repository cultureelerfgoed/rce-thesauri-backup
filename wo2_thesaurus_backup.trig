    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://pl.wikipedia.org/wiki/Stalag_369#/media/File:Stalag_369_Kobierzyn_(Poland)_logo.jpg";
    dcterms:source "https://krijgsgevangen.nl/stalag-369-kobierzyn/"@nl, "https://de.wikipedia.org/w/index.php?title=Liste_der_Kriegsgefangenenlager_der_Wehrmacht&oldid=1744252"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/6411>;
    dcterms:created "2018-04-26T08:10:34.000Z"^^xsd:dateTime;
    skos:prefLabel "Stalag 369 Kobierzyn"@nl, "Stalag 369 Kobierzyn"@de, "Stalag 369 Kobierzyn"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote """Stalag 369 Kobierzyn ofwel Stalag Koberczyn was een Duits krijgsgevangenenkamp in Kobierzyn in Polen. Het werd op 3 mei 1942 in gebruik genomen en was bedoeld als strafkamp voor werkweigerende Franse en Belgische onderofficieren. Vanaf oktober 1943 werden hier ook Nederlandse krijgsgevangenen ondergebracht. Toen het Rode Leger oprukte werd het kamp vanaf eind juli 1944 ontruimd. De krijgsgevangenen vertrokken naar Stalag IV-b Mühlberg en op 15 september 1944 werd het kamp opgeheven. 

"""@nl;
    skos:altLabel "Stalag Koberczyn"@nl .
  
