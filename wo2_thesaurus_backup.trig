  <https://data.niod.nl/WO2_Thesaurus/events/8161> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:34:08.004Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8142>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/wo2nedindieThema> "Internationale betrekkingen";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/640x480/ea1cf5a3-047e-453d-a20a-a8b3c85dd2a0.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/fb6a7d32-0259-11e7-904b-d89d6717b464/media/ea1cf5a3-047e-453d-a20a-a8b3c85dd2a0";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://www.delpher.nl/nl/kranten/view?coll=ddd&identifier=ddd:110528214:mpeg21:a0115>,
      <https://www.delpher.nl/nl/kranten/view?coll=ddd&identifier=ddd:010905284:mpeg21:a0083>;
    <http://schema.org/startDate> "1941-07-26"^^xsd:date;
    <http://schema.org/description> "De Amerikaanse regering reageert op de Japanse bezetting van zuidelijk Indo-China door een algemeen handelsembargo af te kondigen en de Japanse tegoeden bij Amerikaanse banken te bevriezen. Vanaf 1 augustus 1941 krijgt Japan te maken met een totaal embargo op de export van ruwe olie en benzine vanuit de Verenigde Staten. De Engelse regering volgt het Amerikaanse voorbeeld en op 28 juli sluit ook de Nederlands-Indische regering zich bij het embargo aan."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/4382>;
    dcterms:created "2019-03-19T11:01:31.000Z"^^xsd:dateTime;
    skos:prefLabel "Afkondiging algemeen handelsembargo tegen Japan"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Afkondiging van een algemeen handelsembargo tegen Japan vindt plaats als reactie op de Japanse bezetting van zuidelijk Indo-China en wordt gedaan door de Amerikaanse regering. Vanaf 1 augustus 1941 krijgt Japan te maken met een totaal embargo op de export van ruwe olie en benzine vanuit de Verenigde Staten. De Engelse regering volgt het Amerikaanse voorbeeld en op 28 juli sluit ook de Nederlands-Indische regering zich bij het embargo aan."@nl .
  
