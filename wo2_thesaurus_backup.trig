    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://images.memorix.nl/lei/thumb/1000x1000/4979e232-bbd6-d902-5e7e-c045028a0c3b.jpg>;
    dcterms:source "https://nl.wikipedia.org/wiki/Jehova%27s_getuigen"@nl, "https://kunst-en-cultuur.infonu.nl/oorlog/35348-jehovahs-getuigen-in-de-tweede-wereldoorlog.html"@nl;
