    dcterms:created "2019-11-08T15:15:08.000Z"^^xsd:dateTime;
    skos:prefLabel "De duikelaar; weekblad voor onderduikers"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het illegale blad De Duikelaar werd van november 1943 tot en met juni 1944 uitgegeven in Nieuwlande (Drenthe) door de Joodse onderduikers I.J. Davids en L. Gans."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8750> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "PPN: 269245790"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2020-09-01T12:37:18.000Z"^^xsd:dateTime;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>;
    dcterms:created "2019-11-08T15:16:37.000Z"^^xsd:dateTime;
    skos:prefLabel "Duikelaartje"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het illegale blad Duikelaartje werd van juni 1943 tot en met eind april 1945 uitgegeven in Zwolle en Heerde (Overijssel). Het blad verscheen wekelijks. Het blad werd op het politiebureau van Zwolle gestencild en tegelijk met Trouw en Je Maintiendrai voornamelijk bij boeren verspreid. Bij een controle door het Kontroll-Kommando in de trein Zwolle-Heerde werd eens een pak kranten naar buiten gegooid dat toch zijn bestemming bereikte."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8751> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "PPN: 269126511"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2020-09-01T11:31:15.000Z"^^xsd:dateTime;
