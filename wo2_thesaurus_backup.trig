    skos:broader <https://data.niod.nl/WO2_Thesaurus/locations/9623>;
    dcterms:created "2018-11-01T14:02:08.000Z"^^xsd:dateTime;
    skos:prefLabel "Nationaal Tehuis, Lunteren"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "Het Nationaal Tehuis was tussen 1936 en 1945 een nationaalsocialistisch complex van gebouwen en terreinen op de Goudsberg te Lunteren. Het geheel moest doen denken aan de Reichsparteitagsgelände in Neurenberg waar de NSDAP van Adolf Hitler zijn grote partijbijeenkomsten hield. Uiteindelijk bestond het Nationaal Tehuis uit een stuk grond van circa 16 hectare, waarop enige gebouwen (vergaderruimten, facilitaire voorzieningen) waren geplaatst, naast een parkeerplaats. Kern van het gebied was de grote komvormige plek boven op de heuvel. Dat was deze plek waar van 1936 tot 1940 de jaarlijkse Hagespraak werd gehouden. Deze komvormige ruimte werd begrensd door een grote, gebogen gemetselde muur met een spreekgestoelte. De laatste Hagespraak was op 22 juni 1940."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/3591>, <https://data.niod.nl/WO2_Thesaurus/2244>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/locations/7942> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "51.989896"^^xsd:float;
    <http://www.w3.org/2003/01/geo/wgs84_pos#long> "5.937267"^^xsd:float;
    dcterms:references "Theo Gerritse - De ploert Hanns Albin Rauter en de correcte ambtenaar Wilhelm Harster: de opmerkelijke rechtspleging tegen twee SS-kopstukken."@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2025-12-17T14:38:36.099Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1944-06-15"^^xsd:date;
    dcterms:source "http://resolver.kb.nl/resolve?urn=ddd:010443476:mpeg21:p008"@nl, "https://nl.wikipedia.org/w/index.php?title=Hanns_Albin_Rauter&oldid=53295194"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-03-07"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/isPointofInterest> true;
    <https://data.niod.nl/EventsWO2/location> "Exact";
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2870>, <https://data.niod.nl/WO2_Thesaurus/locations/9601>;
    dcterms:created "2019-03-01T10:02:29.000Z"^^xsd:dateTime;
    skos:prefLabel "Woonhuis Rauter (Arnhem)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "Het Woonhuis van Rauter te Arnhem werd als zodanig door de Höherer SS- und Polizeiführer en zijn gezin gebruikt na D-Day. Trouw maakte melding van de verhuizing, om aan te geven dat de bezetter aan het terugtrekken was. Naar aanleiding van de berichtgeving werden 23 medewerkers van Trouw, die reeds vastzaten in Kamp Vught, voor het Polizeistandgericht gebracht en ter dood veroordeeld."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/1719>, <https://data.niod.nl/WO2_Thesaurus/corporaties/5166>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/4827>;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
