    dcterms:modified "2025-10-30T08:35:03.243Z"^^xsd:dateTime;
    dcterms:source "https://resolver.kb.nl/resolve?urn=MMKB08:000109155:mpeg21:a0087"@nl,
      "https://nl.wikipedia.org/w/index.php?title=Corporatieve_Concentratie&oldid=35653580"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/corporaties/4593>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4745>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2506>;
    dcterms:created "2018-03-20T06:52:57.000Z"^^xsd:dateTime;
    skos:prefLabel "Corporatieve Concentratie"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Corporatieve Concentratie (CC) was een in september 1933 opgerichte fascistische politieke organisatie. De fascistische politici Jan Baars, F.C. Gerretson, Wouter Lutkie en Jos Mineur gingen samenwerken om de vele in Nederland aanwezige fascistische partijen en bewegingen te bundelen in het zogenaamde Charter van het Nederlandsch Fascisme. De Corporatieve Concentratie omvatte partijen als de Algemeene Nederlandsche Fascisten Bond (ANFB), de Fascistische Jongeren Bond en de Nationale Unie. Na slechts zes maanden, in maart 1934, staakte de Corporatieve Concentratie haar activiteiten."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/6110> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references """J.C.H. Blom, De Algemene Rekenkamer tijdens de Duitse bezetting, in: Van Camere vander Rekeninghen tot Algemene Rekenkamer. Zes eeuwen Rekenkamer. Gedenkboek bij het 175-jarig bestaan van de Algemene Rekenkamer (Den Haag 1989)
"""@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-06-03T13:04:10.709Z"^^xsd:dateTime;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Algemene_Rekenkamer&oldid=50636697"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/corporaties/6090>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2139>, <https://data.niod.nl/WO2_Thesaurus/1711>;
    dcterms:created "2018-03-20T06:53:08.000Z"^^xsd:dateTime;
    skos:prefLabel "Algemene Rekenkamer"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Algemene Rekenkamer is een onafhankelijk orgaan dat controleert of de uitgaven van de Nederlandse rijksoverheid rechtmatig en doelmatig zijn."@nl;
    skos:altLabel "Algemeene Rekenkamer"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Organization>;
    skos:definition "De Algemene Rekenkamer is een onafhankelijk orgaan dat controleert of de uitgaven van de Nederlandse rijksoverheid rechtmatig en doelmatig zijn. Tijdens de Duitse bezetting vonden controles op inkomsten en uitgaven van het rijk door de Algemene Rekenkamer op de gewone wijze plaats, maar de ontbinding van de Staten-Generaal door de bezetter leidde echter tot een aantal ingrijpende wijzigingen in het functioneren van de Rekenkamer : er kwamen geen door het parlement goedgekeurde begrotingen tot stand en de functie van publieke verslaglegging van de Algemene Rekenkamer aan de Tweede Kamer verviel."@nl .
  
