  <https://data.niod.nl/WO2_Thesaurus/corporaties/6197> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2024-02-16T13:26:37.169Z"^^xsd:dateTime;
    dcterms:source "http://www.oorlogsgetroffenen.nl/archiefvormer/Informatiebureau"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1926>, <https://data.niod.nl/WO2_Thesaurus/corporaties/8573>;
    dcterms:created "2018-06-08T11:33:13.000Z"^^xsd:dateTime;
    skos:prefLabel "'Informatiebureau van het Nederlandse Rode Kruis'"@de, "'Informatiebureau van het Nederlandse Rode Kruis'"@en,
      "Informatiebureau van het Nederlandse Rode Kruis"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Informatiebureau van het Nederlandsche Rode Kruis ontstond nadat bij Koninklijk Besluit van 2 april 1909 aan het Nederlandse Rode Kruis werd opgedragen om voorbereidingen te treffen om een informatiebureau voor zieken en gewonden op te richten. Bij het uitbreken van de Eerste Wereldoorlog werd in 1914 daadwerkelijk een informatiebureau opgezet die gedurende de oorlogsjaren werkzaam was. In de meidagen van 1940 speelde het een rol bij de informatieverstrekking aan familieleden over gewonde en gesneuvelde militairen. Na de Tweede Wereldoorlog speelde het Informatiebureau een rol in het opsporen van vermiste personen tijdens de Tweede Wereldoorlog."@nl;
    skos:altLabel "Informatiebureau van het Nederlandsche Roode Kruis"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
