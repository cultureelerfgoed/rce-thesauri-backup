    dcterms:created "2022-02-01T15:07:49.348Z"^^xsd:dateTime;
    skos:prefLabel "Luther-Werke in Braunschweig"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Luther-Werke in Braunschweig werd in 1875 opgericht en maakte industriële machines en molens. Tijdens de Tweede Wereldoorlog werden er vliegtuigen van het type Messerschmitt gebouwd. De benodigde (dwang)arbeiders werden ondergebracht in nabij gelegen kampen. Hier waren ook een paar Merwedegijzelaars tewerkgesteld."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
