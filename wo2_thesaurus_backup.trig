    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/1/14/Fh_rundbogenhalle.jpg/1280px-Fh_rundbogenhalle.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/w/index.php?title=File:Fh_rundbogenhalle.jpg&oldid=485327080";
    <http://schema.org/description> "Vliegveld Venlo was de voormalige vliegbasis Venlo-Herongen dat tussen oktober 1940 en maart 1941 werd aangelegd als Duitse Fliegerhorst op de Groote Heide bij Venlo. Het complex met twee startbanen van 1450 meter en één van 1200 meter was uitgerust met de modernste veiligheidsinstallaties, radioapparatuur en nachtverlichting met 2000 lampen. Door de Fliegerhorst liep een netwerk van wegen met een totale lengte van 48 kilometer tussen hangars, onderkomens, werkplaatsen, casino's, voetbalvelden en tennisvelden. Tussen januari 1943 en augustus 1944 werden 75 tot 100 luchtaanvallen uitgevoerd, waarbij een groot deel buiten de vliegbasis terechtkwam. Op 3 september 1944 werd Vliegveld Venlo volledig verwoest tijdens een gecoördineerde actie van honderden vliegtuigen van de RAF."@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/isPointofInterest> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2110>, <https://data.niod.nl/WO2_Thesaurus/locations/9663>;
    dcterms:created "2019-05-15T05:16:06.000Z"^^xsd:dateTime;
    skos:prefLabel "Vliegveld Venlo"@nl, "'Vliegveld Venlo'"@en, "Fliegerhorst Venlo"@de;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:exactMatch <http://www.wikidata.org/entity/Q1428529>;
    skos:scopeNote "Vliegveld Venlo was de voormalige vliegbasis Venlo-Herongen dat tussen oktober 1940 en maart 1941 werd aangelegd als Fliegerhorst Venlo op de Groote Heide bij Venlo (Limburg). In 1943 en 1944 werden 75 tot 100 luchtaanvallen uitgevoerd, waarbij een groot deel buiten de vliegbasis terechtkwam. "@nl;
    skos:altLabel "Fliegerhorst Venlo"@nl, "Vliegbasis Venlo-Herongen"@nl, "Vliegbasis Venlo"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/8500> a <http://schema.org/Thing>,
