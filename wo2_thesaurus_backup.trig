    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Speciaal:Citeren&page=Rijksbanier_Zwart-Rood-Goud&id=46714427"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/20707>;
    dcterms:created "2016-10-04T13:07:41.000Z"^^xsd:dateTime;
    skos:prefLabel "Reichsbanner"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Reichsbanner Schwarz-Rot-Gold, Bund deutscher Kriegsteilnehmer und Republikaner, kortweg Reichsbanner (Rijksbanier Zwart-Rood-Goud, Bond van Duitse Oorlogsveteranen en Republikeinen), was een Duitse organisatie ten tijde van de Weimar Republiek ter verdediging van de republiek tegen haar vijanden. Hoewel het lidmaatschap van de Reichsbanner openstond voor alle Duitsers, werd de organisatie gedomineerd door leden van de Sociaaldemocratische Partij van Duitsland (Sozialdemokratische Partei Deutschlands)."@nl;
    skos:altLabel "Reichsbanner Schwarz-Rot-Gold"@nl, "Rijksbanier Zwart-Rood-Goud"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/4424>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
