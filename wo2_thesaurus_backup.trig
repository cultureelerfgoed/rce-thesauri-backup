    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/6c7d48e1-bfb8-5938-0170-2cd25366ece0.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/1783ef30-025a-11e7-904b-d89d6717b464/media/6c7d48e1-bfb8-5938-0170-2cd25366ece0";
