  <https://data.niod.nl/WO2_Thesaurus/19680> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/ravend>;
    dcterms:modified "2024-02-19T13:21:50.926Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/0aec9a48-6b26-6f11-6e2a-3ab367de188e.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/210dcd14-025a-11e7-904b-d89d6717b464/media/0aec9a48-6b26-6f11-6e2a-3ab367de188e";
    <http://schema.org/startDate> "1944-09-12"^^xsd:date;
    <http://schema.org/endDate> "1945-06-11"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3545>;
    dcterms:created "2023-06-22T07:22:21.451Z"^^xsd:dateTime;
    skos:prefLabel "Strijd in Nederland"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De strijd in Nederland begon met de Amerikaanse opmars in Limburg op 12 september 1944 en werd gevolgd door Operatie Market Garden op 17 september 1944, hierbij speelden luchtlandingen een grote rol. Terwijl Market Garden mislukte werd wel een deel van Limburg, Noord-Brabant en Gelderland bevrijd. Het noorden van Nederland werd pas in het voorjaar van 1945 bevrijd. Hierbij hadden de geallieerden het luchtoverwicht, ze bombardeerden en beschoten bezet Nederland waarbij veel burgerslachtoffers vielen. Vanuit bezet Nederland wist de Duitse bezetter wel veel V-1 en V-2 raketten af te schieten, richting Londen of Antwerpen. Bij mislukte lanceringen vielen regelmatig burgerslachtoffers."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
