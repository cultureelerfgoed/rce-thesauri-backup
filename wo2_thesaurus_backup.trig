    <http://schema.org/startDate> "1945-02-19"^^xsd:date;
    dcterms:source "https://www.4en5mei.nl/oorlogsmonumenten/monumenten_zoeken/oorlogsmonument/1651/zwanenburg%2C-monument-wilgenlaan"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/havingap>;
