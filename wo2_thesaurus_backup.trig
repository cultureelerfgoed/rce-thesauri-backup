    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://www.4en5mei.nl/app/uploads/2017/03/332891_achterveld_voedselmonument.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://www.4en5mei.nl/herdenken-en-vieren/oorlogsmonumenten/monumenten_zoeken/oorlogsmonument/3407"@nl;
    <http://schema.org/location> "Achterveld";
