    <http://schema.org/startDate> "1944-05-25"^^xsd:date;
    dcterms:source "https://wikimiddenbrabant.nl/Vliegtuigcrash_Moleneind,_25_mei_1944"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2329>;
    dcterms:created "2025-10-09T09:17:13.187Z"^^xsd:dateTime;
    skos:prefLabel "Vliegtuigcrash Moleneind Tilburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De crash van een Lancaster bommenwerper met Brits-Canadese bemanning in Moleneind in Tilburg vond plaats op 25 mei 1944. Het toestel explodeert in de lucht en stort in delen brandend neer nabij het Moleneind in Tilburg. Alle zeven inzittenden komen hierbij om het leven."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/21855> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
