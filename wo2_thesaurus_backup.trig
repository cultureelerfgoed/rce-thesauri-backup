    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het illegale blad Communiqué van de Dag werd uitgegeven in Harderwijk (Gelderland)."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8734> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "PPN: 269061746"@nl;
