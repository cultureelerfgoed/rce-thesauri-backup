    skos:prefLabel "Nederlandsche Heidemaatschappij"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Nederlandsche Heidemaatschappij hield samen met de Rijksdienst voor de Werkverruiming toezicht op het werk in de werkkampen. Mannen in de kampen voerden werkzaamheden uit als ontginning en aardappelrooien. De Nederlandse Heidemaatschappij hield toezicht voor de oorlog, maar ook tijdens de oorlog, toen Joodse mannen in werkkampen te werk werden gesteld."@nl;
    skos:altLabel "Heidemij"@nl, "Heide Maatschappij"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/kampen/6010>, <https://data.niod.nl/WO2_Thesaurus/kampen/7389>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/8610>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
