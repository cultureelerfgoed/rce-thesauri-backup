    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "51.64162"^^xsd:float;
    <http://www.w3.org/2003/01/geo/wgs84_pos#long> "5.11057"^^xsd:float;
    dcterms:references "Oorlogsmonumenten in nationaal Park de Loonse- en Drunense duinen, Henk Peters, 2020."@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:27:29.459Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/99b2e4c1-78ca-ef1a-feb7-e744f3c892b5.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/7973d520-025a-11e7-904b-d89d6717b464/media/99b2e4c1-78ca-ef1a-feb7-e744f3c892b5";
    <http://schema.org/startDate> "1944-05-26"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/9271>;
    dcterms:created "2020-12-07T13:13:23.725Z"^^xsd:dateTime;
    skos:prefLabel "Fusillade in Loonse en Drunense Duinen, 26 mei 1944"@nl, "Hinrichtung am Loonse und Drunense Dünen, 26. Mai 1944"@de,
      "Execution at the Loonse and Drunense Dunes, May 26, 1944"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 24 mei 1944 werden in de politiegevangenis van Haaren (NB) veertien verzetsstrijders na een kort proces ter dood veroordeeld. Vijf van hen waren betrokken bij de mislukte aanslag op Piet Gerrits, een NSB-er en verlengstuk van de Sicherheitsdienst bij het Tilburgse politiecorps. Op de vroege morgen van 26 mei 1944 werden zij in de Loonse en Drunense Duinen gefusilleerd. Ondanks diverse zoekpogingen (de laatste in 2012) zijn hun lichamen nooit meer gevonden. De veertien mannen hoorden tot drie verschillende verzetsgroepen: de Tilburgse (6 mannen), de Groningse (3 mannen) en de groep uit Bergen op Zoom/Tholen (5 mannen)."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/10735> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Over d'n oorlog Udenhout en Biezenmortel (1994) "@nl, "Verhalen over de Tweede Wereldoorlog en de Bevrijding, heemcentrum Udenhout en Biezenmortel (2019)"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2021-06-04T08:47:13.068Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/10740>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/6/6c/Het_Dorp_Udenhout.jpg/1280px-Het_Dorp_Udenhout.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Udenhout#/media/Bestand:Het_Dorp_Udenhout.jpg";
    <http://schema.org/location> "Udenhout";
    <http://schema.org/startDate> "1944-10-26"^^xsd:date;
    dcterms:source "https://wikimiddenbrabant.nl/Bevrijding_Udenhout"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/6983>;
    dcterms:created "2020-12-07T13:44:07.564Z"^^xsd:dateTime;
    skos:prefLabel "Bevrijding Udenhout"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Op 26 oktober 1944 werd Udenhout bevrijd. De geallieerden schoten met vuurpijlen die op rieten daken terecht kwamen. In totaal zijn 17 boerderijen afgebrand. De bevrijding op 26 oktober 1944 van eerst Biezenmortel en daarna Udenhout was onderdeel van de operatie van de geallieerden, die de naam \"Pheasant\" (fazant) meekreeg. "@nl .
  
