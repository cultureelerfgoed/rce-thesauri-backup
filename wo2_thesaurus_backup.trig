    <http://schema.org/location> "Heemstede";
    <http://schema.org/startDate> "1943-02-09"^^xsd:date;
    dcterms:source "https://www.trouw.nl/nieuws/data-van-zaterdag-6-tot-en-met-vrijdag-12-februari-1943-derde-jaar-week-40-seyffardt-doodgeschoten~bd2232ed/?referrer=https%3A%2F%2Fwww.google.com%2F"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2023>, <https://data.niod.nl/WO2_Thesaurus/locations/10669>;
    dcterms:created "2020-12-01T13:27:41.682Z"^^xsd:dateTime;
    skos:prefLabel "Seyffardt-gijzelaars opgepakt in Heemstede"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 9 februari 1943 werden Robert Oscar (Bob) en Bert Calisch wonende aan de Bronsteeweg in Heemstede, samen met tien andere jonge mannen als Seyffardt-gijzelaars opgepakt en via het politiebureau naar Kamp Vught gebracht. Bob Calisch werd in Duitsland tewerkgesteld en kwam pas op 7 juni 1945 terug in Heemstede. Dit was een represaille voor de aanslag op luitenant-generaal Seyffardt en de vrouw van mr. H. Reydon."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/7526>, <https://data.niod.nl/WO2_Thesaurus/kampen/4884>,
      <https://data.niod.nl/WO2_Thesaurus/2354>;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
