    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4557>;
    dcterms:created "2021-12-29T12:12:50.424Z"^^xsd:dateTime;
    skos:prefLabel "Medische Commissie Joodsche Raad"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Medische Commissie van de Joodsche Raad had als taak het geven van adviezen over geneeskundige, farmaceutische, tandheelkundige en hygiënische vraagstukken ter bevordering van de volksgezondheid van de Joden. Dr. A. Roozendaal was arts en voorzitter van de commissie. Het secretariaat was gevestigd aan de Lijnbaansgracht 366 in Amsterdam. De commissie had subcommissies voor Apothekers, Medisch onderwijs en tandartsen. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/18541> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    dcterms:modified "2025-02-12T11:19:11.829Z"^^xsd:dateTime;
