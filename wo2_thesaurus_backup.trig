    dcterms:source "https://www.tweedewereldoorlog.nl/kennis/themas/alomvattend-karakter-conflict/verzet/verzetsorganisaties/communistisch-verzet/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
