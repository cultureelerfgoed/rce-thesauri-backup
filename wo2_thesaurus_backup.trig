    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/c125dce2-025a-11e7-904b-d89d6717b464/media/3a3b17df-9527-2bd1-f7bf-89f6eeab484c?mode=detail&view=horizontal&q=freya&rows=1&page=2";
    dcterms:source "http://www.fietsenindeachterhoek.nl/freya.html"@nl, "https://nl.wikipedia.org/w/index.php?title=Freya_(radar)&oldid=35732008"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/isPointofInterest> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
