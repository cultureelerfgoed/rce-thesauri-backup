    <http://schema.org/location> "Okinawa";
    <http://schema.org/startDate> "1945-04-01"^^xsd:date;
    <http://schema.org/endDate> "1945-06-22"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/wiki/Slag_om_Okinawa"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2350>;
    dcterms:created "2021-10-21T12:40:02.908Z"^^xsd:dateTime;
    skos:prefLabel "Slag om Okinawa"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Slag om Okinawa (Operatie Iceberg) vond plaats van 1 april tot 22 juni 1945 op het Japanse eiland Okinawa tussen Amerikaanse en Japanse strijdkrachten. Het werd een verbeten strijd om het strategisch gelegen eiland, waarbij de Japanners op grote schaal van kamikaze gebruik maakten. De strijd eindigde in een Amerikaanse overwinning, maar door de grote verliezen werd van een grootschalige invasie van Japan afgezien en in plaats daarvan gekozen voor atoombommen om de vijand te laten capituleren. Twee Nederlandse koopvaardijschepen, de Tjisadane en de Kota Inten, maakten deel uit van de operatie."@nl;
    skos:altLabel "Operatie Iceberg"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/1870> .
  
  <https://data.niod.nl/WO2_Thesaurus/17793> a <http://schema.org/Thing>, skos:Concept,
