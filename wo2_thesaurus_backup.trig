    dcterms:created "2018-07-16T06:31:30.000Z"^^xsd:dateTime;
    skos:prefLabel "Stalag X-C"@nl, "Stalag X-C"@de, "Stalag X-C"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Stalag X-C was een Duits krijgsgevangenkamp in Nienburg, Nedersaksen en lag naast Oflag X-B. Het werd in 1940 geopend voor onderofficieren en manschappen. Het was een stuk kleiner met slechts zes blokken voor 160-200 gevangenen per blok. Het was bedoeld voor Franse soldaten maar later kwamen er ook Polen, Belgen, Roemenen, Serviërs, Italianen en Russen. In het kamp zaten zo'n 1000 gevangenen maar in de Arbeitskommando's zo'n 45.000. Op 5 april 1945 moesten alle gezonde gevangenen naar Oflag 83 Wietzendorf marcheren en op 9 april werd het kamp door het Britse leger bevrijd. "@nl;
    skos:altLabel "Stalag Nienburg"@nl, "Stalag Nienburg Weser"@nl, "Stalag Nienburg/Weser"@nl,
      "Stalag X C"@nl, "Stalag X-C Nienburg"@nl, "Stalag X-C Nienburg Weser"@nl, "Stalag X-C Nienburg/Weser"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/6477> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
