    <http://schema.org/startDate> "1945-04-15"^^xsd:date;
    dcterms:source "https://onh.nl/verhaal/oorlogsherinneringen-van-een-kind"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/havingap>;
