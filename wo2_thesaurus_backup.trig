    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/9184>, <https://data.niod.nl/WO2_Thesaurus/2077>,
      <https://data.niod.nl/WO2_Thesaurus/9537>;
    dcterms:created "2020-08-10T13:27:24.000Z"^^xsd:dateTime;
    skos:prefLabel "Invoer Distributiesysteem Antillen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Invoer van de Distributiebonnen in de Antillen vond plaats in oktober 1942. Hoewel de oorlog eerste instantie in de West zorgde voor economische welvaart, leidde het ook tot voedselschaarste. Producten als graan, maïs, aardappelen, suiker en olie gingen vanaf 1942 op de bon."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/9213> a <http://schema.org/Thing>, skos:Concept,
