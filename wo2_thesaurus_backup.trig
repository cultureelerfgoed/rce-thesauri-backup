    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/d/d0/Expeditionaire_macht.jpg/500px-Expeditionaire_macht.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Eerste_Divisie_7_December#/media/Bestand:Expeditionaire_macht.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://commons.wikimedia.org/w/index.php?search=herdenking+7+december&title=Special:Search&profile=advanced&fulltext=1&advancedSearch-current=%7B%7D&ns0=1&ns6=1&ns12=1&ns14=1&ns100=1&ns106=1#/media/File:Herdenking_7_december_Divisie_op_Dam,_Bestanddeelnr_904-3322.jpg>;
    dcterms:source "https://nl.wikipedia.org/wiki/Eerste_Divisie_7_December"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1561>, <https://data.niod.nl/WO2_Thesaurus/10679>,
      <https://data.niod.nl/WO2_Thesaurus/20711>;
    dcterms:created "2021-01-25T14:58:09.179Z"^^xsd:dateTime;
    skos:prefLabel "Eerste Divisie 7 December"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Eerste Divisie \"7 December\" was vernoemd naar de rede van Koningin Wilhelmina in Londen op 7 december 1942, waarin zij de contouren schetste van de naoorlogse relatie tussen Nederland en de overzeese gebiedsdelen. Het was een expeditionaire Nederlandse legermacht die in 1946 werd opgericht om in Indonesië koloniaal gezag te herstellen. Volgens gegevens van het Ministerie van Defensie sneuvelden 683 militairen van de Eerste Divisie \"7 December\". De meesten liggen begraven op het ereveld Menteng Pulo in Jakarta."@nl;
    skos:altLabel "7 December-divisie"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/10963> a <http://schema.org/Thing>, skos:Concept,
