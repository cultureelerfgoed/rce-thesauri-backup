    <http://schema.org/startDate> "1944-09-01"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Theresienstadt:_Ein_Dokumentarfilm_aus_dem_jüdischen_Siedlungsgebiet&oldid=51764542"@de;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/5008>;
    dcterms:created "2020-09-14T14:40:06.000Z"^^xsd:dateTime;
    skos:prefLabel "Opnames voor Duitse propagandafilm Theresienstadt"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Op 1 september 1944 startten de opnames voor een Duitse propagandafilm over het leven in het 'modelkamp' Theresienstadt. De film onder regie van Kurt Gerron zou in 1945 uitkomen onder de titel Theresienstadt: Ein Dokumentarfilm aus dem jüdischen Siedlungsgebiet, met als misleidende ondertitel: Der Führer schenkt den Juden eine Stadt. De film was bedoeld om de geallieerden de indruk te geven dat de omstandigheden in de Duitse concentratiekampen veel gunstiger waren dan tegenstanders deden geloven. Gevangenen werden ingezet als acteurs, waaronder de Joodse tekenaar Jo Spier. Na de opnames werden velen van hen afgevoerd naar Auschwitz-Birkenau en hier om het leven gebracht."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9434> a <http://schema.org/Thing>, skos:Concept,
