    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/18994>;
    <http://schema.org/startDate> "1941-05-01"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/wiki/Hr.Ms._Jean_Frederic_(1919)"@nl, "https://www.75jaarliberation.nl/data/downloadables/5/7/8/4/het-verhaal-van-matthieu-vleugels.pdf"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3511>;
    dcterms:created "2022-05-30T14:24:49.167Z"^^xsd:dateTime;
    skos:prefLabel "Scheepsramp Hr.Ms. Jean Frederic"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De scheepsramp met de Hr.MS Jean Frederic vond plaats op 1 mei 1941. Het was een anti-onderzeeboottrawler uit de Eerste Wereldoorlog die door de Franse marine werd gebruikt. Na de Franse capitulatie in 1940 namen de Britten haar in beslag en leenden haar uit aan de Nederlandse marine. Jean Frederic ging konvooien en schepen tussen Falmouth en Dartmouth escorteren. Op 1 mei 1941 werd het schip tijdens een konvooi van Falmouth naar Dartmouth aangevallen door een Duits gevechtsvliegtuig en zonk. Er waren dertien overlevenden en 25 slachtoffers waarvan slechts 5 lichamen konden worden geborgen. "@nl;
    skos:altLabel "Scheepsramp Hr.Ms. Jean Frédérique"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/18999> a <http://schema.org/Thing>, skos:Concept;
