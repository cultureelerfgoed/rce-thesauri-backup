    dcterms:source "https://en.wikipedia.org/w/index.php?title=Kian_Gwan&oldid=835505705"@en;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2210>;
    dcterms:created "2019-01-22T13:45:13.000Z"^^xsd:dateTime;
    skos:prefLabel "Kian Gwan"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Kian Gwan werd opgericht in 1863 in Nederlands-Indië, heeft verschillende bedrijfstaken en -namen gehad en bestaat nu nog altijd, zij het buiten Indonesië. Opgericht door de Chinees Oei Tjie Sien groeide het onder leiding van zijn zoon Oei Tiong Ham uit tot de grootste multinational in Zuidoost-Azië begin 20ste eeuw. Dankzij de pro-Japanse houding van het bedrijf mocht het ook tijdens de bezetting blijven handelen, maar werd na de onafhankelijkheidsoorlog uit Indonesië verdreven, vanwege de vermeende pro-Nederlandse houding. "@nl;
    skos:altLabel "Handel Maatschappij Kian Gwan"@nl, "Oei Tiong Ham Concern (OTHC)"@en,
      "OTHC"@nl, "Oei Tiong Ham Concern"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/4382>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
