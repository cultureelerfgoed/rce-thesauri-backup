    dcterms:created "2021-11-09T14:26:56.731Z"^^xsd:dateTime;
    skos:prefLabel "Scheepsramp Leto"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Scheepsramp met de Leto vond plaats op 12 mei 1942. De Leto was een Nederlands schip van de Maatschappij 'Zeeland' dat op 10 mei uit Montreal vertrok richting Engeland. Op 12 mei werd het getorpedeerd door een Duitse U-Boot (U 553) en tot zinken gebracht. Tien bemanningsleden en twee passagiers (beide overlevenden van de Scheepsramp Oscilla) overleefden de ramp niet. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/1870> .
  
