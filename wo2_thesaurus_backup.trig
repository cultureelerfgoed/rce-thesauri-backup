    <http://schema.org/startDate> "1943-03-01"^^xsd:date;
    <http://schema.org/endDate> "1945-08-15"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2019-09-20T13:12:01.000Z"^^xsd:dateTime;
    skos:prefLabel "Aanleg Pakan Baroe-spoorweg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De aanleg van de Pakan Baroe-spoorweg (ook: Pakan Baru-spoorweg of Sumatra-spoorweg) vond plaats tussen maart 1943 en augustus 1945. De spoorweg liep van Pakan Baroe (nu Pekanbaru) naar Moeara (nu Muaro Sijunjung) op midden-Sumatra en werd onder zeer slechte omstandigheden aangelegd door ongeveer 50.000 dwangarbeiders, waarvan er 26.000 omkwamen. Onder de dwangarbeiders bevonden zich krijgsgevangenen en, in grotere aantallen, Indonesische dwangarbeiders, de zogeheten romusha’s. Het eerste contingent romusha’s begon in maart 1943 met het grondwerk. De daadwerkelijke aanleg van de spoorweg begon op 24 mei 1944."@nl;
    skos:altLabel "Aanleg Pakanbaroe-spoorweg"@nl, "Aanleg Pakan Baru-spoorweg"@nl, "Aanleg Sumatra-spoorweg"@nl .
  
