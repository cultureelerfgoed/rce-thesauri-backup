    skos:prefLabel "Zweedse Rode Kruis"@nl, "Schwedisches Rotes Kreuz"@de, "Swedish Red Cross"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Zweedse Rode Kruis verleende tijdens de Tweede Wereldoorlog hulp aan concentratiekamp-gevangenen, onder meer bij de evacuatie uit bevrijde kampen (het 'witte bussen-plan') en verzorgde aan het eind van de Hongerwinter voedselhulp aan Nederland (het 'Zweedse wittebrood')."@nl;
    skos:altLabel "Svenska Röda Korset"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/8582> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "Ingrid de Zwarte, De Hongerwinter. Amsterdam : Prometheus, 2019"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-06-12T11:33:12.001Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2751>, <https://data.niod.nl/WO2_Thesaurus/1758>;
    dcterms:created "2019-09-18T08:39:50.000Z"^^xsd:dateTime;
    skos:prefLabel "Centrale Reederij voor de Voedselvoorziening"@nl, "'Centrale Reederij voor de Voedselvoorziening'"@de,
      "'Centrale Reederij voor de Voedselvoorziening'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Centrale Reederij voor de Voedselvoorziening (CRV) werd opgericht op 5 december 1944 en was tijdens de Hongerwinter het centrale transportorgaan dat alle binnenvaart binnen Nederland moest overzien en bijna 170.000 ton voedsel vervoerde vanuit het noordoosten naar het westen van het land. Het bestuur bestond uit Voute en Müller, de burgemeesters van Amsterdam en Rotterdam, secretaris-generaal Hirschfeld en Louwes, de directeur-generaal van het Rijksbureau voor de Voedselvoorziening in Oorlogstijd."@nl;
    skos:altLabel "Centrale Reederij"@nl, "Centrale Rederij"@nl, "CRV"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/8585> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "N.J.G. Sikkel (red.), Documentatie. Samengesteld ten behoeve van de Bijzondere Rechtspleging, op last van de Procureur-Fiscaal bij het Bijzonder Gerechtshof te Amsterdam (Amsterdam 1947)"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2024-08-12T12:03:08.648Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1940-08-24"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://resolver.kb.nl/resolve?urn=urn:gvn:EVDO02:NIOD05_1121&size=large"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://resolver.kb.nl/resolve?urn=urn:gvn:EVDO02:NIOD05_1121"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://www.openbeelden.nl/media/1127785>,
      <https://beeldbankwo2.nl/nl/beelden/detail/e0783492-0259-11e7-904b-d89d6717b464/media/262813b7-0e10-7279-50f0-f637053ea4d0>;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-06"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Het Economisch Front was een ondernemersorganisatie van de Nationaal-Socialistische Beweging (NSB). De organisatie had als doel nationaalsocialistisch gedachtegoed in het Nederlandse bedrijfsleven te verspreiden. Het Economisch Front bestond uit de afdelingen Industrie, Groothandel, Tussenpersonen, Detailhandel, Ambacht, Bankwezen, Verzekeringswezen, Verkeer en Kamers van Koophandel."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2244>;
    dcterms:created "2019-09-18T12:09:47.000Z"^^xsd:dateTime;
    skos:prefLabel "Economisch Front"@nl, "'Economisch Front'"@de, "'Economisch Front'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Economisch Front werd opgericht op 24 augustus 1940 op initiatief van de Raad van Volkshuishouding van de N.S.B. Het doel was ‘het uitdragen van de nationaal-socialistische gedachte in ondernemerskringen en het medewerken aan de opbouw van het bedrijfsleven in Nederland in nationaal-socialistische zin’. Het Economisch Front bestond uit de volgende hoofdsecties: Industrie, Groothandel, Tussenpersonen, Detailhandel, Ambacht, Bankwezen, Verzekeringswezen, Verkeer, Kamers van Koophandel. Bij de arisering van Joodse bedrijven door Duitse autoriteiten speelde het Economisch Front een veel minder grote rol dan de leiding wenste. Vanaf 1941 tot de bevrijding was Rost van Tonningen leider van het Economisch Front. "@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/8586> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references """Documentatie : status en werkzaamheden van organisaties en instellingen uit de tijd der Duitse bezetting van Nederland, samengesteld ten behoeve van de Bijzondere Rechtspleging, op last van de Procureur-Fiscaal bij het Bijzonder Gerechtshof te Amsterdam. Amsterdam, 1947
"""@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
