    <http://schema.org/startDate> "1942-01-17"^^xsd:date;
    dcterms:source "https://wikimiddenbrabant.nl/Vliegtuigcrash_Oude_Kievitsebaan,_17_januari_1942"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2329>;
    dcterms:created "2025-10-09T09:26:54.156Z"^^xsd:dateTime;
    skos:prefLabel "Vliegtuigcrash Oude Kievitsebaan Tilburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De crash van een Britse bommenwerper met Tsjechische bemanning in Oude Kievitsebaan in Tilburg vond plaats op 17 januari 1942. Het toestel stort neer in een bosperceel ten noordoosten van het Wandelbos. Drie bemanningsleden komen om bij de crash, één raakt zwaargewond, twee anderen zijn slechts lichtgewond. Ze zijn later alle drie krijgsgevangen gemaakt."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/21857> a <http://schema.org/Thing>, skos:Concept,
