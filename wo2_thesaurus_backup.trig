    <http://schema.org/startDate> "1945-02-18"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2682>;
    dcterms:created "2021-03-03T09:24:07.964Z"^^xsd:dateTime;
    skos:prefLabel "Liquidatie van Dirk Booij"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De liquidatie van Dirk Booij vond plaats op 18 februari 1945 in Beverwijk. Booij was op weg naar huis toen hij op de Heemskerkerweg werd beschoten door twee wielrijders. Hij raakte ernstig gewond en overleed de volgende dag in het Rode Kruis ziekenhuis in Beverwijk. Booij stond bekend als zwarthandelaar en het verzet verdacht hem van collaboratie met de Duitse bezetter."@nl .
  
