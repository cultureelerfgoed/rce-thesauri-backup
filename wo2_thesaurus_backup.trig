    <http://schema.org/startDate> "1943-10-12"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2682>;
    dcterms:created "2021-02-11T11:48:21.864Z"^^xsd:dateTime;
    skos:prefLabel "Liquidatie van Hendrik Willem Muller"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De liquidatie van Hendrik Willem Muller vond plaats op 12 oktober 1943 in Baarn. Muller was ambtenaar bij de Crisis Controle Dienst (CCD) en een fanatieke opsporingsambtenaar. Hij werd door drie mannen op de Eemweg neergeschoten. "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/11081> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
