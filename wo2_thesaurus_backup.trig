    dcterms:created "2019-03-11T14:14:39.000Z"^^xsd:dateTime;
    skos:prefLabel "Synagoge Apeldoorn"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "De Synagoge in Apeldoorn aan de Paslaan werd In de nacht van 1 op 2 augustus 1941 in brand gestoken door NSB’ers. Hierbij werd het gebouw grotendeels verwoest, maar de meeste wetsrollen, veel kerksieraden en enkele glas-in-loodramen konden worden gered. De brand bleek het startsein voor de gewelddadige vervolging van de Joden in Apeldoorn, waar van de circa 1600 joden er slecht 150 de oorlog hebben overleefd."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/locations/8035> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
