    dcterms:source "https://wikimiddenbrabant.nl/Granaatinslag_Molenstraat,_27_oktober_1944"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/8508>;
    dcterms:created "2025-10-08T12:07:01.983Z"^^xsd:dateTime;
    skos:prefLabel "Granaatinslag Molenstraat Tilburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De granaatinslag op de Molenstraat in Tilburg vond plaats op 29 oktober 1944. De Luchtbeschermingsdienst verneemt dat in een slagerij in de Molenstraat doden en gewonden zijn gevallen door een granaatinslag. Vrijwel zeker gaat het om de rund- en varkensslagerij van De Beer op Molenstraat 20. In de slagerij komen vier mensen om. Later die dag wordt Tilburg bevrijd."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
