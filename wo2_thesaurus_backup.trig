    skos:narrower <https://data.niod.nl/WO2_Thesaurus/events/8274>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2560>, <https://data.niod.nl/WO2_Thesaurus/2506>,
      <https://data.niod.nl/WO2_Thesaurus/20702>;
    dcterms:created "2019-01-24T09:21:51.000Z"^^xsd:dateTime;
    skos:prefLabel "PUTERA"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De PUTERA bestond van 16 april 1943 tot maart 1944 en werd opgericht door de Japanse bezetter in Nederlands-Indië. Het was de opvolger van de Tiga A-beweging en had als doel de inheemse bevolking het idee te geven dat de bezetter de weg wilde effenen voor een onafhankelijk Indonesië en plaatste bekende Indonesische politieke figuren, zoals Soekarno en Hatta, aan het hoofd. In werkelijkheid was het doel van de organisatie de inheemse bevolking rustig te houden en te winnen voor de Japanse zaak."@nl;
    skos:altLabel "Poetera"@nl, "Pusat Tenaga Rakyat"@nl, "Center of the People's Power"@en;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/4382>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7762> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
