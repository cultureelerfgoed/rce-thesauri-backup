    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/6411>;
    dcterms:created "2018-02-20T09:12:06.000Z"^^xsd:dateTime;
    skos:prefLabel "Stalag VIII-C"@nl, "Stalag VIII-C"@de, "Stalag VIII-C"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Stalag VIII-C was een Duits krijgsgevangenkamp bij Sagan in Neder-Silezië. Het werd in september 1939 in gebruik genomen voor Poolse gevangenen en grensde aan Stalag Luft III. In de tweede helft van 1941 zaten er ruim 50.000 krijgsgevangenen van allerlei nationaliteiten. Op 26 januari 1945 kwamen er vanuit Oflag XXI-c/z Grüne bei Lissa zo'n 450 Nederlandse reserveofficieren naar het kamp die op 1 februari 1945 per trein doorreisden naar Stalag IV-B Mühlberg. Begin februari 1945 werd door de komst van het Rode Leger het kamp door de Duitsers ontruimd. De bevrijding vond plaats op 14 februari 1945."@nl;
    skos:altLabel "Stalag VIII C"@nl, "Stalag VIII-C Sagan"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/5986> a <http://schema.org/Thing>, skos:Concept,
