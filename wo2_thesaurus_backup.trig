    dcterms:modified "2025-08-29T07:26:48.018Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/10967>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/ams/thumb/350x350/02d94e3f-339b-c6db-c221-293fbf17bbfd.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://archief.amsterdam/beeldbank/detail/c6172c69-89e3-4e49-e94c-c8525e1c178a";
    <http://schema.org/location> "Amsterdam";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://commons.wikimedia.org/w/index.php?search=monument+haarlemmerweg+amsterdam&title=Special:Search&profile=advanced&fulltext=1&advancedSearch-current=%7B%7D&ns0=1&ns6=1&ns12=1&ns14=1&ns100=1&ns106=1#/media/File:2020_Monument_aan_de_Haarlemmerweg_(2).jpg>;
    <http://schema.org/startDate> "1944-12-15"^^xsd:date;
    dcterms:source "https://www.tracesofwar.nl/sights/23243/Monument-Executies-15-December-1944.htm"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2574>;
    dcterms:created "2021-01-27T13:36:09.484Z"^^xsd:dateTime;
    skos:prefLabel "Executie Haarlemmerweg Amsterdam"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 15 december 1944 werden op de trambaan van de Haarlemmerweg in Amsterdam, voor boerderij Vredelust, drie verzetsmensen gefusilleerd: de Amsterdamse politierechercheur Pieter Elias en Matthijs en Henk Verkuijl uit Badhoevedorp. De executie was een wraakactie voor een aanslag van het verzet op de spoorlijn bij Sloterdijk. De lichamen van de drie geëxecuteerde verzetsmannen moesten twee dagen blijven liggen ter afschrikking. Agenten van politiebureau Admiraal de Ruijterweg werden gedwongen de lijken van de ‘terroristen’ te bewaken."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/10973> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Nederlanders in Buchenwald 1940-1945, Kirsten Snijders, Göttingen 2001"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2021-06-29T14:15:45.596Z"^^xsd:dateTime;
    <https://data.niod.nl/eventsWO2/fromLocation> <https://data.niod.nl/WO2_Thesaurus/kampen/3652>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/2718e9c3-6694-7762-e0bb-dabe94915d99.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/0fda23d0-025a-11e7-904b-d89d6717b464/media/2718e9c3-6694-7762-e0bb-dabe94915d99";
    <http://schema.org/startDate> "1944-04-18"^^xsd:date;
    dcterms:source "https://collections.arolsen-archives.org/en/archive/1-1-5-1_8023500/?p=1&doc_id=5292660"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2354>;
    dcterms:created "2021-01-28T12:55:54.665Z"^^xsd:dateTime;
    skos:prefLabel "Aktion Rückfluter"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Aktion Rückfluter was bedoeld om Nederlandse jongens en mannen alsnog in Duitse fabrieken tewerk te stellen. Vanaf oktober 1943 werden gevangenen uit Kamp Amersfoort naar Duitsland gestuurd. Kamp Amersfoort was in 1943 veranderd in een doorgangs- en gijzelkamp voor werkweigeraars en contractbrekers. Het eerste grote transport vertrok op 18 april 1944 naar Kamp Buchenwald (537 Nederlanders en 1 Fransman). In Buchenwald kregen alle Nederlanders een nummer in de serie 47.000 en een rode driehoek. Ze werden als politieke gevangenen gecategoriseerd. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
