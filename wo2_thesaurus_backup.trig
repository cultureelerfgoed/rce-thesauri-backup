    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2024-08-12T12:03:08.654Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1940-10-12"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://service.archief.nl/gaf/api/file/v1/render/702d5ba3-66dc-470d-8e39-a4f1cb950b9d";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://hdl.handle.net/10648/499bfece-4ad2-9418-3815-b66fc2666cf8";
    dcterms:source "https://www.medischcontact.nl/actueel/laatste-nieuws/artikel/een-completer-beeld"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-06"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Het Medisch Front was de gezondheidszorgorganisatie van de Nationaal-Socialistische Beweging (NSB). De organisatie werd opgericht op 12 oktober 1940 en had als doel de zorgsector in te richten op basis van het nationaalsocialistisch gedachtegoed, zoals de rassenleer. Vanaf 1942 was de organisatie ingedeeld in de afdelingen artsen, tandartsen, dierenartsen, apothekers, verpleegkundigen, vroedvrouwen en paramedische beroepen. Zeker 250 artsen werden vrijwillig lid van het Medisch Front."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2842>, <https://data.niod.nl/WO2_Thesaurus/2853>,
      <https://data.niod.nl/WO2_Thesaurus/2244>, <https://data.niod.nl/WO2_Thesaurus/2852>;
    dcterms:created "2018-10-03T18:45:47.000Z"^^xsd:dateTime;
    skos:prefLabel "Medisch Front"@nl, "'Medisch Front'"@de, "'Medisch Front'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Medisch Front werd op initiatief van de NSB opgericht op 12 oktober 1940 en had als taak ‘de bevordering van de gezondheid van het Nederlandsche Volk in kader van de nieuwe orde in Europa’ en het organiseren van alle beroepskrachten die daarvoor moesten werken. Vanaf begin 1942 bestond de organisatie uit zes secties: artsen, tandartsen, dierenartsen, apothekers, verplegenden, vroedvrouwen en paramedische beroepen. Het Medisch Front propageerde de nazistische ideologie met betrekking tot rassenleer, rassenhygiëne en eugenetica."@nl;
    skos:altLabel "Medisch Front der NSB"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Organization> .
  
