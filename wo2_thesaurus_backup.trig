    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/7855>;
    dcterms:created "2020-09-09T09:59:12.000Z"^^xsd:dateTime;
    skos:prefLabel "Eerste Slag om Charkov"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Eerste Slag om Charkov was een veldslag in Oekraïne tussen Nazi-Duitsland en de Sovjet-Unie. In oktober 1941, rond het einde van Operatie Barbarossa, kreeg het Sovjetleger het bevel om Charkov te verdedigen en de fabrieken in de stad te ontmantelen. Toen de Duitsers de stad veroverden, had het Rode leger de fabrieken al verplaatst naar het Sovjetgebied. "@nl .
  
