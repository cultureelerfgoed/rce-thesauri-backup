    skos:prefLabel "Landelijk leidster"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De rang landelijk leidster was de hoogste rang binnen de Nationaal-Socialistische Vrouwenorganisatie (NSVO). De landelijk leidster werd door NSB-leider Mussert benoemd en was aan hem persoonlijk verantwoording schuldig."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4621> .
  
