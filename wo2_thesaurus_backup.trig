      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "Ad van Rijswijk, Esbeek, een schakel in de pilotenlijn : groep Smit/Van der Heijden (Esbeek : Werkgroep Heemkunde Esbeek, 2009)"@nl,
      "Megan Koreman, Gewone helden : de Dutch-Paris ontsnappingslijn, 1942-1945 (Amsterdam : Boom, 2016)"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
