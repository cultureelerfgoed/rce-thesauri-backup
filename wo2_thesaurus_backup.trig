      "https://nl.wikipedia.org/w/index.php?title=Zigeunervervolging&oldid=56498080"@nl;
    skos:relatedMatch <https://data.niod.nl/WO2_biografieen/Settela-Steinbach>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/11457>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2788>, <https://data.niod.nl/WO2_Thesaurus/2056>;
    dcterms:created "2020-07-20T14:21:04.000Z"^^xsd:dateTime;
    skos:prefLabel "Zigeunerrazzia"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Zigeunerrazia vond plaats op 16 mei 1944 en was gericht op het oppakken van alle Roma en Sinti die woonachtig waren in Nederland. 578 mensen werden die dag opgepakt door de marechaussee, landwacht en de Nederlandse staatspolitie en vervolgens naar Kamp Westerbork gebracht. Drie dagen later werden 245 Roma en Sinti nogmaals op transport gesteld, maar nu met Auschwitz als eindstation. De rest werd vrijgelaten uit Kamp Westerbork omdat zij niet voldeden aan de kenmerken van een zigeuner of omdat zij een Italiaans, Zwitsers of Guatemalaans paspoort hadden."@nl;
    skos:altLabel "razzia van 16 mei 1944"@nl, "Roma-Sinti-razzia"@nl, "Sinti-Romarazzia"@nl,
      "National raid on Sinti and Roma"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/5973>, <https://data.niod.nl/WO2_Thesaurus/events/9250>;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
