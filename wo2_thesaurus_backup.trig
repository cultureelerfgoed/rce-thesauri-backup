  <https://data.niod.nl/WO2_Thesaurus/1901> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "Van Dale Groot Woordenboek der Nederlandse Taal (12de druk, 1992) "@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2017-12-18T14:07:55.000Z"^^xsd:dateTime;
