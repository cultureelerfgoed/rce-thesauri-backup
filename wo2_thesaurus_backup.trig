      "https://nl.wikipedia.org/w/index.php?title=Duitse_militaire_begraafplaats_in_Ysselsteyn&oldid=54334334"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/isPointofInterest> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1635>;
    dcterms:created "2019-08-30T13:09:54.000Z"^^xsd:dateTime;
    skos:prefLabel "Duitse militaire begraafplaats Ysselsteyn"@nl, "Deutscher Soldatenfriedhof Ysselsteyn"@de,
      "German Military Cemetery Ysselsteyn"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Duitse militaire begraafplaats Ysselsteyn, gecreëerd in 1946, is een begraafplaats in Limburg waar voornamelijk Duitse militairen die gesneuveld zijn tijdens de Tweede Wereldoorlog in Nederland liggen. Tevens liggen er een aantal Duitse militairen uit de Eerste Wereldoorlog en zijn er Nederlandse SS'ers begraven. Door heel Nederland lagen Duitse militairen begraven, maar na de Duitse bezetting van Nederland zijn de meeste militairen herbegraven op de Duitse militaire begraafplaats Ysselsteyn. "@nl;
    skos:altLabel "Ysselsteyn German war cemetery"@en, "German war cemetery Ysselsteyn"@en,
      "Deutsche Kriegsgräberstätte Ysselsteyn"@de;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
