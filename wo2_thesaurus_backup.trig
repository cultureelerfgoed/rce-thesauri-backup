    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/17751>, <https://data.niod.nl/WO2_Thesaurus/17944>,
      <https://data.niod.nl/WO2_Thesaurus/17945>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/5566>;
    dcterms:created "2021-10-20T12:32:31.600Z"^^xsd:dateTime;
    skos:prefLabel "Bospartizanen uit Baarlo"@nl, "Bospartizanen aus Baarlo"@de, "Bospartizanen from Baarlo"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Bospartizanen is een naoorlogse benaming voor de KP'ers die ter voorbereiding van de bevrijding Duitse soldaten gevangen namen en hen verborgen in de bossen, tot de komst van de geallieerden. De KP Maas en Waal en de KP Limburg gingen samenwerken en arresteerden Duitse soldaten in Limburg. Ze werden bekend als de partizanen van Baarlo. Hun basis was de Boekenderhof ten zuiden van Baarlo gelegen aan de rand van de Heldense bossen. Het verzet heeft ruim twee maanden 25 Duitse militairen in de bossen vastgehouden."@nl .
  
