    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    dcterms:modified "2023-06-13T09:46:50.276Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/6210>;
    <http://schema.org/startDate> "1944-04-11"^^xsd:date;
    dcterms:source "https://www.denhaag4045.nl/2020/04/10/de-slachtoffers-van-het-bombardement-op-kleykamp-in-den-haag-11-april-1944/#monumentbzk"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/19538>;
    dcterms:created "2021-03-09T15:16:39.979Z"^^xsd:dateTime;
    skos:prefLabel "Bombardement op Huize Kleykamp"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 11 april 1944 werd Huize Kleykamp in Den Haag, waar het landelijk bevollkingsregister gevestigd was, door de RAF gebombardeerd. Hierbij kwamen 64 medewerkers om het leven en een deel van de persoonsbewijzen-duplicaten werd vernietigd. Het vervalsen van persoonsbewijzen werd daardoor eenvoudiger."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/11161> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    dcterms:modified "2023-06-13T09:50:34.780Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/11162>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/51735baa-6164-0387-22ba-12513455dbdb.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/820f8198-025a-11e7-904b-d89d6717b464/media/51735baa-6164-0387-22ba-12513455dbdb";
    <http://schema.org/startDate> "1945-04-25"^^xsd:date;
    dcterms:source "https://www.tracesofwar.nl/articles/4373/Luchtaanval-op-Wangerooge.htm#:~:text=Zeventig%20jaar%20geleden%2C%20op%2025,grondgebied%20tijdens%20de%20Tweede%20Wereldoorlog"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/19538>;
    dcterms:created "2021-03-10T11:45:27.662Z"^^xsd:dateTime;
    skos:prefLabel "Bombardement op Wangerooge"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 25 april 1945 werd het Oost-Friese eiland Wangerooge in de Duitse Waddenzee door 480 bommenwerpers van de Royal Air Force (RAF) gebombardeerd. Op het eiland bevonden zich militairen, Kriegsmarinesoldaten en dwangarbeiders. De Duitsers vreesden voor een invasie van Noord-Duitsland en vanaf 1943 werden de verdedigingsmiddelen op Wangerooge opgevoerd. De luchtaanval kostte 131 militairen, 6 Marinehelferinnen, 21 dorpelingen en 121 dwangarbeiders, waaronder 48 Nederlanders, het leven. Op 12 mei 1945 zetten de Canadezen voet aan wal op Wangerooge."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/18756> .
  
