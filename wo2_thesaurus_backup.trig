    dcterms:created "2019-04-25T08:51:49.000Z"^^xsd:dateTime;
    skos:prefLabel "Verzamelpunt razzia Oldebroek"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>,
      <https://data.niod.nl/WO2_Thesaurus/11183>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Verzamelpunt razzia Oldebroek van 10 oktober 1944 was op een bosperceel aan de Bovendwarsweg. De mannen uit Oldenbroek werden opgepakt om te worden ingezet voor dwangarbeid, waarbij zij langs de IJssel in de buurt van Hattem loopgraven te moeten spitten. De werkzaamheden waren van korte duur en alle mannen mochten naar afloop weer naar huis."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
