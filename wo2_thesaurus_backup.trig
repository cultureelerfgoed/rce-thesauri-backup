    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Reclassering is de terugkeer in de samenleving. Personen die een straf of maatregel opgelegd kregen binnen de bijzondere rechtspleging konden onder toezicht staan van de Stichting Toezicht Politieke Delinquenten (STPD). De Stichting begeleidde vrijgelaten personen met hun terugkeer in de samenleving."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/demoadmin>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/21229>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2568>, <https://data.niod.nl/WO2_Thesaurus/20633>;
    dcterms:created "2016-08-01T19:20:49.000Z"^^xsd:dateTime;
    skos:prefLabel "Resozialisierung"@de, "Rehabilitation"@en, "Reclassering"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "Reclassering is 1) een vorm van maatschappelijk werk die de sociale aanpassing of heraanpassing beoogt van delictplegers zodat deze weer in de maatschappij kunnen functioneren, en 2) de gezamenlijke lichamen die op dit gebied werkzaam zijn."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <https://data.niod.nl/thesaurus_wo2/ImagesWW2/Legislation> .
  
