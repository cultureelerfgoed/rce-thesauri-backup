    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Bloedbad_van_Babi_Jar#/media/Bestand:%D0%AD%D1%81%D1%8D%D1%81%D0%BE%D0%B2%D0%B5%D1%86_%D1%80%D0%BE%D0%B5%D1%82%D1%81%D1%8F_%D0%B2_%D0%B2%D0%B5%D1%89%D0%B0%D1%85_%D1%80%D0%B0%D1%81%D1%81%D1%82%D1%80%D0%B5%D0%BB%D1%8F%D0%BD%D0%BD%D1%8B%D1%85_%D0%B2_%D1%83%D1%80%D0%BE%D1%87%D0%B8%D1%89%D0%B5_%D0%91%D0%B0%D0%B1%D0%B8%D0%B9_%D0%AF%D1%80_%D0%B2_%D0%BE%D0%BA%D0%BA%D1%83%D0%BF%D0%B8%D1%80%D0%BE%D0%B2%D0%B0%D0%BD%D0%BD%D0%BE%D0%BC_%D0%9A%D0%B8%D0%B5%D0%B2%D0%B5.jpg"@nl;
    <http://schema.org/startDate> "1941-09-29"^^xsd:date;
    <http://schema.org/endDate> "1941-09-30"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2012>;
    dcterms:created "2020-09-17T12:47:45.000Z"^^xsd:dateTime;
    skos:prefLabel "Massamoord van Babi Jar"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Massamoord van Babi Jar was een bloedbad aangericht door het Duitse leger nabij Kiev. De massamoord is vernoemd naar het ravijn 'Babi Jar', dat vlak buiten de stad naast een Joodse begraafplaats lag. De moord vond plaats tussen 29 en 30 september 1941, vlak na de annexatie van de stad op 19 september. Leden van leden van Einsatzgruppe C, de Waffen-SS en Oekraïense collaborateurs brachten meer dan 100.000 mensen -voornamelijk Joden- naar het ravijn, waar zij werden doodgeschoten. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9458> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    dcterms:references "Bart Nauta, In het Centrum van de Vernietiging. Een kleine geschiedenis van de Nederlanders in het Joodse Sonderkommando en de SS-Totenkopfverbände bij de gaskamers van Auschwitz-Birkenau, Bachelorscriptie Geschiedenis, 1 juli 2015, UvA Amsterdam"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:04:22.692Z"^^xsd:dateTime;
