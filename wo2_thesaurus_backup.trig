    <http://schema.org/startDate> "1944-09-30"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2682>;
    dcterms:created "2021-02-17T12:44:20.285Z"^^xsd:dateTime;
    skos:prefLabel "Liquidatie van Wouter Marinus Vaandrager"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De liquidatie van Wouter Marinus Vaandrager vond plaats op 30 september 1944 in Rotterdam. Vaandrager was timmerman en uitvoerder bij aannemersbedrijf A. Knijff. De Duitsers hadden opdracht gegeven om in Rotterdam ruim 13 kilometer kademuur te verwoesten en Knijff had dit werk aangenomen. De KP'er Jos de Groot ('Jos de Killer') had van de LKP Rotterdam opdracht gekregen een strafexpeditie bij aannemersbedrijf Knijff uit te voeren. Op het kantoor aan de Heemraadssingel kreeg uitvoerder Vaandrager een cyaankali injectie en werd vervolgens doodgeschoten."@nl .
  
