    <http://schema.org/startDate> "1944-09-20"^^xsd:date;
    dcterms:source "https://www.oorlogzeeland.nl/index.php/slag-om-de-schelde/scheldeslag-oostzvl"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/6983>;
    dcterms:created "2018-10-31T10:35:21.000Z"^^xsd:dateTime;
    skos:prefLabel "Befreiung von Terneuzen"@de, "Liberation of Terneuzen"@en, "Bevrijding Terneuzen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De bevrijding van Terneuzen op Zeeuws-Vlaanderen vond plaats op 20 september 1944 door Poolse strijdkrachten. De Poolse doorbraak bij buurtschap Kijkuit verbrak de Duitse weerstandslijn tussen Axel en de oostrand van Terneuzen. In de nacht van 19 op 20 september lag Terneuzen nog onder zwaar geallieerd granaatvuur. De volgende ochtend waren de meeste Duitsers vertrokken en 's middags reed een colonne met tanks en jeeps de stad binnen."@nl .
  
