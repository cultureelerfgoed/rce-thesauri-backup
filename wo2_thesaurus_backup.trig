      "https://www.ad.nl/utrecht/sporen-nsb-leus-nog-zichtbaar-op-muur-van-voormalig-israelitisch-weeshuis-aan-de-nieuwegracht~a9ab6ddd/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/9118>;
    dcterms:created "2020-07-29T15:41:17.000Z"^^xsd:dateTime;
    skos:prefLabel "Razzia Centraal Israëlitisch Weeshuis Utrecht"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Razzia van het Centraal Israëlitisch Weeshuis in Utrecht vond plaats in oktober 1942. Alle kinderen en het personeel werden eerst overgeplaatst naar een weeshuis in Amsterdam en in 1943 op transport gesteld naar Westerbork.  Op een enkeling na werden ze allemaal vermoord in verschillende concentratiekampen in Oost-Europa. "@nl;
    skos:altLabel "Ontruiming Centraal Israëlitisch Weeshuis Utrecht"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
