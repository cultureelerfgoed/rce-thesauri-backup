    skos:prefLabel "MIAI"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "MIAI (Majelis Islam A'la Indonesia) bestond van september 1937 tot oktober 1943 en was een samenwerkingsverband tussen inheemse islamitische partijen en organisaties en streed voor onafhankelijkheid en de islamitische zaak. Tijdens de bezetting was de MIAI, tot zij in oktober 1943 door de Japanners werd vervangen door de Masyumi, de enige partij die de belangen van de Moslims mocht behartigen.  "@nl;
    skos:altLabel "Majelis Islam A'la Indonesia"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/4382>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
