    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Twentsche_Bank&oldid=66195338"@nl,
      "https://historiek.net/geschiedenis-van-de-twentsche-bank/45902/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
