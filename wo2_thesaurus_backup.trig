    dcterms:references "Kibboets Beverwijk. Palestina-pioniers in Velsen-Noord en Beverwijk, Saskia Sluiter, De Vrijstaat Roetz 2019"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2022-03-29T06:52:50.799Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/18513>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/ranh/thumb/1000x1000/901dfe0d-fb0c-fabb-6be8-bf7d475f094e.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://www.beeldbank.noord-hollandsarchief.nl/memorix/50f54ada-fb8f-11df-9e4d-523bc2e286e2";
    <http://schema.org/startDate> "1939-02-19"^^xsd:date;
    <http://schema.org/endDate> "1942-03-17"^^xsd:date;
    dcterms:source "https://oorlogsslachtoffersijmond.nl/categorie/57/beverwijk-kibboets-1939-42"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/18502>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1892>;
    dcterms:created "2021-12-20T10:34:48.322Z"^^xsd:dateTime;
    skos:prefLabel "Kibboets Beverwijk, 1939-1942"@nl, "Kibbuz Beverwijk, 1939-1942"@de,
      "Kibbutz Beverwijk, 1939-1942"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Op 19 februari 1939 werd kibboets Beverwijk opnieuw geopend aan Gildenlaan 1 in Velsen-Noord. Deze doorstart was nodig om de nieuwe stroom zionistische vluchtelingen uit Duitsland, Oostenrijk en Italië onderdak te bieden. Het aantal was groot zodat er extra ruimte nodig was. Die werd gehuurd aan de Schulpenweg 109 in Velsen-Noord en op 21 november 1940 vertrokken 20 pioniers naar De Kleine Haar in Gorssel, een tijdelijk opvangkamp voor kinderen. De kibboetsbewoners werden opgeleid door boeren, tuinders en ambachtsleiden uit de omgeving en volgden cursussen aan de Lagere Landbouwschool in Assendelft. Vanaf maart 1942 verlieten de laatste pioniers de kibboets. Sommigen doken onder maar de meeste vertrokken naar de kibboets in Laag-Keppel."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/18501> a <http://schema.org/Thing>, skos:Concept,
