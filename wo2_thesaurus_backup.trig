    skos:prefLabel "Eerste Auschwitzproces"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het eerste Auschwitzproces duurde van 24 november tot 22 december 1947 en vond grotendeels plaats in de rechtbank van Krakau. Veertig oorlogsmisdadigers die ten tijde van de Tweede Wereldoorlog werkten in Auschwitz, werden hier berecht. 23 van hen kregen hun doodsvonnis."@nl;
    skos:altLabel "Krakauer Auschwitzprozess"@nl, "Auschwitz trial"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9093> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:04:52.093Z"^^xsd:dateTime;
