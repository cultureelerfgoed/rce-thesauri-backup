  <https://data.niod.nl/WO2_Thesaurus/8687> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "PPN: 268961794"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
