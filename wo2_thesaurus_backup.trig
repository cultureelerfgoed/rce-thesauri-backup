    dcterms:created "2019-02-26T13:40:18.000Z"^^xsd:dateTime;
    skos:prefLabel "In brand steken van Niftrik"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Het Nederlandse leger stak op 10 mei 1940 alle boven de dijk gelegen huizen van het dorp Niftrik in brand, om zo te voorkomen dat de oprukkende Duitse troepen vanaf deze huizen de Nederlandse linies bij Ravenstein zouden beschieten. Een derde van het dorp is hierbij in vlammen opgegaan. Tachtig mensen verloren huis en haard. "@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
