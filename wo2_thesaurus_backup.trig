    dcterms:source "https://www.tracesofwar.nl/sights/3127/Monument-Parallelweg.htm"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/9271>;
    dcterms:created "2020-09-22T11:50:35.000Z"^^xsd:dateTime;
    skos:prefLabel "Fusillade in Den Haag, 31 maart 1945"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 31 maart 1945 werden aan de Parallelweg in Den Haag twaalf Nederlanders uit de Scheveningse gevangenis gefusilleerd door de bezetter. Op 29 maart 1945 werden tijdens een overval van het verzet twee Duitse soldaten gemolesteerd en ontwapend aan de Parallelweg. Een dag later werd een colonne vrachtwagens van de Ordnungspolizei door verzetstrijders tegengehouden en in verwarring gebracht."@nl .
  
