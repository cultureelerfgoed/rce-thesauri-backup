    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://www.nationaalarchief.nl/onderzoeken/fotocollectie/aefa143a-d0b4-102d-bcf8-003048976d84";
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Speciaal:Citeren&page=United_Nations_Relief_and_Rehabilitation_Administration&id=35848264"@nl;
    <http://schema.org/description> "De UNRRA was de United Nations Relief and Rehabilitation Administration, een internationale organisatie die in 1943, tijdens de Tweede Wereldoorlog, werd opgezet om hulp te verlenen aan landen die bevrijd waren van de As-mogendheden. Hoewel in de naam de term 'Verenigde Naties' werd gebruikt, werd deze organisatie twee jaar voor de eigenlijke Verenigde Naties opgericht. De term Verenigde Naties werd oorspronkelijk gebruikt voor de geallieerden. De organisatie viel onder het Supreme Headquarters Allied Expeditionary Force, het opperbevel van de geallieerde strijdkrachten. UNRRA was actief tot 1947 in Europa, en tot 1949 in Azië. In de praktijk hield de UNRRA zich veelal bezig met de ondersteuning en repatriëring van Displaced persons."@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2878>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4706>;
    dcterms:created "2016-10-04T13:07:42.000Z"^^xsd:dateTime;
    skos:prefLabel "U.N.R.R.A."@nl, "UNRRA "@de, "UNRRA"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De UNRRA was de United Nations Relief and Rehabilitation Administration, een internationale organisatie die in 1943 werd opgezet om hulp te verlenen aan landen die bevrijd werden van de As-mogendheden. De organisatie viel onder het Supreme Headquarters Allied Expeditionary Force, het opperbevel van de geallieerde strijdkrachten. UNRRA was actief tot 1947 in Europa, en tot 1949 in Azië en hield zich vooral bezig met de ondersteuning en repatriëring van Displaced persons."@nl;
    skos:altLabel "United Nations Relief and Rehabilitation Administration"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
