    dcterms:created "2016-08-01T19:20:35.000Z"^^xsd:dateTime;
    skos:prefLabel "Befreiung"@de, "Liberation"@en, "Bevrijding"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:topConceptOf <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Bevrijding is de bevrijding van de Duitse resp. Japanse bezetting/overheersing. In stricte zin vond dat op Nederlands grondgebied plaats op 5 mei resp. 15 augustus 1945. Zuidelijk Nederland werd echter al in het najaar van 1944 (12 september- 3 december) bevrijd. Hier niet alleen gebruikt voor de bevrijdingsdag  maar ook voor de dagen/weken direct daarna. "@nl;
    skos:definition "Op 14 september 1944 werd de eerste belangrijke Nederlandse stad bevrijd, namelijk Maastricht. Met de mislukking van Operatie Market Garden liet de bevrijding van de rest van Nederland langer op zich wachten en volgde de Hongerwinter. Vanaf de lente van 1945 werd ook noord en oost Nederland geleidelijk bevrijd. "@nl;
    skos:hiddenLabel "BevrijdingAlgemeen"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/2529> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "NIOD"@nl, "https://www.verzetsmuseum.org/museum/nl/kinderen/voorkant/bevrijding/bevrijding,bijltjesdag (2 september 2016)"@nl;
