    <http://schema.org/location> "Ingen";
    <http://schema.org/startDate> "1944-10-19"^^xsd:date;
    <http://schema.org/endDate> "1944-12-01"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1922>;
    dcterms:created "2022-01-06T12:06:04.610Z"^^xsd:dateTime;
    skos:prefLabel "Evacuatie van Ingen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Evacuatie van Ingen vond plaats op 19 oktober 1944 op last van de bezetter. Begin december 1944 mochten de inwoners terugkeren, maar veel van hen moesten vanwege de Inundatie van de Betuwe hun huis al snel weer verlaten."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/18584> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "G.B. Jansen, Oorlog over het Gelders Eiland (Copera Historia: Zevenaar, 1995)"@nl;
