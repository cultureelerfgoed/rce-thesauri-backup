      <https://data.niod.nl/WO2_biografieen/Wilhelm-Karl-Ernst-Munzer>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/17710>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4656>, <https://data.niod.nl/WO2_Thesaurus/20646>;
    dcterms:created "2021-10-08T07:21:11.900Z"^^xsd:dateTime;
    skos:prefLabel "Beauftragte des Reichskommissars"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Beauftragte des Reichskommissars was een bestuursfunctionaris, direct geplaatst onder de Rijkscommissaris, die optrad als gedelegeerde in de provincies en in de steden Amsterdam en Rotterdam. In het bijzonder hielden de Beauftragten toezicht op het openbaar bestuur, Duitse propagandavoering en het economisch leven. Besturen van de provincie en gemeenten moesten hun belangrijkste besluiten altijd mededelen aan de Beauftragten. De Beauftragte onderhield vaak intensief contact met de Commissarissen der provincie."@nl;
    skos:altLabel "Beauftragte van de Rijkscommissaris"@nl .
  
