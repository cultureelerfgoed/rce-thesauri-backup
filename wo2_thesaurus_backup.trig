    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/55fdd4b0-025a-11e7-904b-d89d6717b464/media/f18fbb23-bbf8-fd21-6fa8-2cd8bb3e445a";
    <http://schema.org/location> "Heerlen";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/93dda0d0-025a-11e7-904b-d89d6717b464/media/8652ac23-b481-ae15-512b-5c863a4f0f68>,
