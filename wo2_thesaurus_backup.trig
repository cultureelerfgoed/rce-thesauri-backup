    dcterms:modified "2026-08-18T08:57:20.601Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Bij een onvoorwaardelijke buitenvervolgingstelling besloot een procureur-fiscaal (een speciale openbaar aanklager) om een verdachte niet te vervolgen. Een verdachte kon onvoorwaardelijk buiten vervolging gesteld worden als de verdenking niet bleek te kloppen, als er te weinig bewijs was, of als de schuld te klein was om maatregelen op te leggen. De zaak werd dan schriftelijk afgehandeld door een procureur-fiscaal."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/baltussenl_2>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/19586>, <https://data.niod.nl/WO2_Thesaurus/19593>;
    dcterms:created "2024-07-29T14:19:43.113Z"^^xsd:dateTime;
    skos:prefLabel "Onvoorwaardelijke buitenvervolgingstelling"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "Bij een onvoorwaardelijke buitenvervolgingstelling besloot een procureur-fiscaal (een speciale openbaar aanklager) om een verdachte niet te vervolgen. Een verdachte kon onvoorwaardelijk buiten vervolging gesteld worden als de verdenking niet bleek te kloppen, als er te weinig bewijs was, of als de schuld te klein was om maatregelen op te leggen. De zaak werd dan schriftelijk afgehandeld door een procureur-fiscaal."@nl;
    skos:altLabel "Onvoorw. buitenverv."@nl, "onvoorw. buitenverv.stelling"@nl, "onvoorwaardelijke buitenvervolgstelling"@nl .
  
