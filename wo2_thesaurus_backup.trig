    skos:prefLabel "Buitencommando Eindhoven"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Van 2 september 1943 tot 9 juni 1944 was er een Buitencommando van Kamp Vught bij het vliegveld van Eindhoven gevestigd. Mannelijke gevangenen uit Kamp Vught werden door Philips en de Bauleitung van de Luftwaffe ingezet voor bouwwerkzaamheden op het vliegveld."@nl;
    skos:altLabel "Aussenkommando Eindhoven"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Place> .
  
  <https://data.niod.nl/WO2_Thesaurus/19069> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
