    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Kamp_Schoorl&oldid=56705250"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
