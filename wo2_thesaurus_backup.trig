    dcterms:source "http://www.japanseburgerkampen.nl/Rawaseneng.htm"@nl, "https://www.indischekamparchieven.nl/nl/zoeken?mivast=963&mizig=247&miadt=963&miview=ika2&milang=nl&misort=score%7C%7Casc&mizk_alle=Temanggoeng&micode=kampen&minr=1396852&miaet=14"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/b7354d29-49d5-4fe0-922a-3f3b5929fa84>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1617>, <https://data.niod.nl/WO2_Thesaurus/2020>,
      <https://data.niod.nl/WO2_Thesaurus/1690>, <https://data.niod.nl/WO2_Thesaurus/8204>,
      <https://data.niod.nl/WO2_Thesaurus/19098>;
    dcterms:created "2025-01-06T13:14:31.235Z"^^xsd:dateTime;
    skos:prefLabel "Rawaseneng"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Rawaseneng was een opvang- en werkkamp en burgerkamp 10 kilometer ten noorden van Temanggoeng, een plaats 20 kilometer ten noorden van Magelang, Midden-Java. Het kamp was gevestigd in een Rooms-Katholieke Landbouwschool bij de koffieonderneming Rawaseneng. In de periode van 1942 tot juli 1945 verbleven hier 300 dakloze Indo-Europese (en enkele Javaanse) vrouwen en kinderen en enkele mannen uit de omgeving (Ambarawa, Salatiga, Purworejo). In juli 1945 werden zij gedwongen het kamp te verlaten. In de maanden juli en augustus functioneerde het kamp als burgerkamp waar de overgebleven mannen en oudere jongens geïnterneerd waren tot de Japanse capitulatie."@nl;
    skos:altLabel "Rowoseneng"@nl, "Rawa Seneng"@nl, "Rowo Seneng"@nl .
  
