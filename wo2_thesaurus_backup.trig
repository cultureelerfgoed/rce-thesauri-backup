    skos:scopeNote "De Amsterdamsche Bank was een Nederlandse bank met vestigingen in diverse steden. Tijdens de bezetting werd met de Duitsers meegewerkt, maar tegelijkertijd werd geprobeerd personeel en klanten te beschermen. Joodse werknemers werden ontslagen, maar kregen een ontslagvergoeding. Ook werd Joods bezit in veiligheid gebracht. Hierdoor kreeg de bank de reputatie om ‘deutschfeindlich und judenfreundlich’ te zijn."@nl;
    skos:altLabel "Amsterdamse Bank"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/22024> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-05-20T10:48:23.360Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/01ed0d45-2b41-0d68-1824-c40bbf219d4c.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/98347bd6-025a-11e7-904b-d89d6717b464/media/01ed0d45-2b41-0d68-1824-c40bbf219d4c";
