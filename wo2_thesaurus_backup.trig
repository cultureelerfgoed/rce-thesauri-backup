    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2574>;
    dcterms:created "2022-03-17T10:33:34.691Z"^^xsd:dateTime;
    skos:prefLabel "Executie in Leusden, 20 juli 1943"@nl, "Hinrichtung in Leusden, 20. Juli 1943"@de,
      "Execution in Leusden, July 20, 1943"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 20 juli 1943 werden in Leusden in het Jannetjesdal twintig leden van de verzetsorganisatie onder leiding van ir. J. van Hattem door de Duitsers geëxecuteerd. De verzetsorganisatie verzamelde inlichtingen voor de Engelse geheime dienst. Op 6 maart 1942 werd Van Hattem gearresteerd en daarna volgden de andere leden. Ze kregen allemaal in 1943 de doodstraf opgelegd."@nl .
  
