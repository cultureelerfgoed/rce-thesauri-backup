    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Zendgroep Barbara was een zendgroep die was samengesteld door het Bureau Inlichtingen, bestaande uit de boven Nederland geparachuteerde agenten. De Zendgroep waar zowel OD als NSF gebruik van maakte was operationeel van 23 juni 1943 tot 12 juli 1944. Betrokken personen waren onder meer Gerard van Borssum Buisman, Henk Letteboer, Piet Hoekman en Bram Grisnigt."@nl;
    skos:altLabel "Groep Barbara"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4465>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
