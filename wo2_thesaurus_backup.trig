    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/8/84/Bordje_typhusepidemie_Spijkenisse_1945.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Spijkenisse_in_de_Tweede_Wereldoorlog#/media/Bestand:Bordje_typhusepidemie_Spijkenisse_1945.jpg";
    <http://schema.org/location> "Spijkenisse";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <http://nimh-beeldbank.defensie.nl/memorix/20c654f9-194a-4b66-76f0-f4d60f23d09d>;
    <http://schema.org/startDate> "1945-05-07"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/wiki/Spijkenisse_in_de_Tweede_Wereldoorlog"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/6983>;
    dcterms:created "2021-06-14T12:36:52.112Z"^^xsd:dateTime;
    skos:prefLabel "Bevrijding Spijkenisse"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De bevrijding van Spijkenisse vond plaats op 7 mei 1945 maar kon pas op 7 juli worden gevierd. Het ontbreken van waterleiding en riolering leidde aan het eind van de oorlog tot een ware ramp. Het haven- en Spuiwater bleken besmet waardoor er een tyfusepidemie uitbrak. Op 3 mei werd de hele bevolking voor het eerst ingeënt. Op 7 mei namen de Binnenlandse Strijdkrachten het bewind over van de Duitsers en sloten direct alle toegangswegen af om verdere uitbreiding van de epidemie te voorkomen. Begin juli hadden alle Spijkenissers drie inentingen gehad en kon het bevrijdingsfeest plaatsvinden."@nl .
  
