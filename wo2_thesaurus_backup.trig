    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://en.wikipedia.org/wiki/Sonnenstein_Castle#/media/File:Pirna_Schloss_Sonnenstein_Panorama_2011_(01-2).jpg";
    dcterms:source "https://www.anderetijden.nl/programma/1/Andere-Tijden/aflevering/668/Kasteel-Sonnenstein"@nl,
      "https://www.pudv.nl/aktion-t4/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/4340>;
    dcterms:created "2020-07-15T10:23:56.000Z"^^xsd:dateTime;
    skos:prefLabel "Kasteel Sonnenstein"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Kasteel Sonnenstein was een van de zes Duitse euthanasiecentra. In deze instelling werden in 1940 en 1941 bijna 14.000 geestelijk gehandicapten en zwakzinnigen vergast door de nazi-artsen. In het tweede jaar trokken ongeveer 1000 gevangenen uit overvolle concentratiekampen in bij de patiënten in Kasteel Sonnenstein. Ook zij vonden de dood, wat het uiteindelijke dodental liet stijgen tot 15.000. "@nl;
    skos:altLabel "Sonnenstein"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
