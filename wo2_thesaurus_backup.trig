    dcterms:source "https://nl.wikipedia.org/wiki/Terkoelei_(schip,_1923)"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3511>;
    dcterms:created "2021-09-29T14:03:26.957Z"^^xsd:dateTime;
    skos:prefLabel "Scheepsramp Terkoelei"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Scheepsramp met de Terkoelei vond plaats op 17 maart 1943. De Terkoelei was een van oorsprong Duits schip (s.s. Essen) dat op 10 mei 1940 in Soerabaja in beslag werd genomen en in beheer van de Rotterdamse Lloyd werd geplaatst. Eenmaal onderdeel van de Nederlandse koopvaardij raakte het betrokken bij de Konvooislag HX 229 en SC 122. De Terkoelei maakte onderdeel uit van konvooi HX 229 en werd op 17 maart 1943 door een Duitse U-boot getorpedeerd en tot zinken gebracht. Van de bemanning overleefde 38 zeelieden de ramp niet."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/1870>, <https://data.niod.nl/WO2_Thesaurus/17672>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
