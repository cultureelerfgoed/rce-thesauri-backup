    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/ravend>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1816>, <https://data.niod.nl/WO2_Thesaurus/locations/11388>;
    dcterms:created "2026-02-18T11:26:36.312Z"^^xsd:dateTime;
    skos:prefLabel "Altaussee"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "Altaussee was een voormalige zoutmijn in Oostenrijk waar tijdens de oorlog een grote hoeveelheid kunst werd opgeslagen. Het merendeel was verworven voor de Sonderauftrag Linz. Dit omvatte het plan van Hitler om in Linz een groot museum op te richten, het zogenaamde Führermuseum, waarvoor duizenden objecten werden verzameld."@nl;
    skos:altLabel "Zoutmijn Altaussee"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
