    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://nimh-beeldbank.defensie.nl/memorix/99941080-91e7-f1f7-5804-8ebec641591d";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <http://nimh-beeldbank.defensie.nl/memorix/016db158-5222-322b-d5fe-d6eeb0ba16bb>,
