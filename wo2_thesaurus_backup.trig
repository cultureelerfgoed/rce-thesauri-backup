      "https://nl.wikipedia.org/w/index.php?title=Wikipedia:Wikiproject/Verzetskranten/Beginnetjes/Berichten_uit_Denemarken_(verzetsblad,_Rijswijk)&oldid=46677517"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>;
    dcterms:created "2019-11-07T14:07:49.000Z"^^xsd:dateTime;
    skos:prefLabel "Berichten uit Denemarken; Aldrig mere Krig"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote """Berichten uit Denemarken; Aldrig mere Krig was een verzetsblad dat in een oplage van circa 125 stuks tussen 1941 en 1944 vijfmaal is verschenen. Het blad bestond uit een vertaling van het Deense pacifistische maandblad Aldrig mere Krig (nooit meer oorlog) met enkele aanvullende artikelen. 
"""@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8682> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "PPN: 26895996X"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
