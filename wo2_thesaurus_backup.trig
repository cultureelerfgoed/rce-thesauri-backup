    <http://schema.org/location> "Eibergen";
    <http://schema.org/startDate> "1945-04-01"^^xsd:date;
    dcterms:source "https://www.75jaarvrijheid.nl/artikel/2431018/de-bevrijding-flitst-eibergen-voorbij"@nl;
    <http://schema.org/name> "Eibergen";
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/6983>;
    dcterms:created "2018-10-31T10:43:25.000Z"^^xsd:dateTime;
    skos:prefLabel "Befreiung von Eibergen"@de, "Liberation of Eibergen"@en, "Bevrijding Eibergen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Op 1 april 1945 werd Eibergen, een dorp in de huidige gemeente Berkelland (Gelderland), bevrijd. Het bataljon van de Grenadier Guards dat vanuit Groenlo noordwaarts trok, werd door Duitse militairen bestookt. Ook vliegtuigen deden mee aan dat gevecht. Toen de Berkelbrug werd opgeblazen besloten de Engelsen zich terug te trekken in Hupsel. De volgende morgen, Paaszondag, waren de Duitsers verdwenen. Er werd een nieuwe brug gelegd en de Britten trokken zonder enige tegenstand Eibergen binnen. "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/7119> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
