    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Tilburgse_zegeltjeskraak&oldid=43775709"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2684>;
    dcterms:created "2018-10-04T12:11:43.000Z"^^xsd:dateTime;
    skos:prefLabel "Tilburgse zegeltjeskraak"@nl, "Raubüberfall auf das Rathaus Tilburg"@de,
      "Robbery of the Tilburg town hall"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Tilburgse zegeltjeskraak is de benaming voor de geslaagde overval op 25 januari 1944 op het stadhuis van Tilburg door de verzetsgroep KP-Soest onder leiding van Johannes van Zanten, waarbij 105.000 nieuw ingevoerde plakzegels (zogenaamde Rauterzegels) en 700 blanco persoonsbewijzen werden buitgemaakt. Hiermee was de voedselvoorziening van onderduikers en verzetsmensen voor langere tijd verzekerd."@nl;
    skos:altLabel "Overval op het stadhuis van Tilburg"@nl, "Overval op het Tilburgse stadhuis"@nl,
      "Zegeltjeskraak van Tilburg"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
