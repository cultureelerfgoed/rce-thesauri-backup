    skos:prefLabel "Fort Ngawi"@nl, "'Fort Ngawi'"@de, "'Fort Ngawi'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Het Fort Generaal Van den Bosch in Ngawi (Oost-Java) was van 1940-1942 in gebruik als interneringskamp (vijandelijke burgers) waar NSB'ers en Duitsers preventief werden geïnterneerd. Vanaf februari 1943 was het een interneringskamp (Japanse bezetting) waar Europese burgers werden geïnterneerd."@nl;
    skos:altLabel "Fort Generaal Van den Bosch"@nl, "Kamp Ngawi"@nl, "Fort Van den Bosch"@nl;
