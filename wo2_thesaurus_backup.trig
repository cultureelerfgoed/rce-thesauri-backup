    dcterms:created "2021-02-04T10:36:23.168Z"^^xsd:dateTime;
    skos:prefLabel "Liquidatie van Hendrikus Matthijs Brijs"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De liquidatie van Hendrikus Matthijs Brijs vond plaats op 28 februari 1945 in Rotterdam. Op de liquidatielijst van de LKP Rotterdam stond als reden: verrader. Brijs werd in de Woelwijkstraat door een KP'er doodgeschoten."@nl .
  
