    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Lijst_van_slachtoffers_van_de_Aktion_Silbertanne&oldid=56178047"@de;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/4409>;
    dcterms:created "2020-06-09T08:14:43.000Z"^^xsd:dateTime;
    skos:prefLabel "Silbertanne-moord op Jan Dijkstra"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote """De Silbertanne-moord op Jan Dijkstra vond plaats op 29 september 1943 in Meppel. Dijkstra was garagehouder en zijn zoon was onderdeel van de Meppeler knokploeg. Hij werd doodgeschoten door SD'ers Grimm en Ernst Makowski. De moord was wraak voor de liquidatie van drie NSB'ers.
"""@en .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9014> a <http://schema.org/Thing>, skos:Concept,
