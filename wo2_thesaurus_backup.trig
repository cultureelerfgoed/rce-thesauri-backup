    skos:prefLabel "Boerderij De Gelkenhorst (Barneveld)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "Boerderij De Gelkenhorst in Barneveld kwam op 16 april 1945 een strijd tussen Canadezen en Duitsers te liggen. Rondom de boerderij hadden zich namelijk enkele Duitse soldaten verschanst, wat resulteerde in beschietingen tussen Duitse en Canadese tanks en anti-tankgeschut van de Duitsers. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
