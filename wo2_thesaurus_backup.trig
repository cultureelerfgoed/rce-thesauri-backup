    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1854>, <https://data.niod.nl/WO2_Thesaurus/2506>;
    dcterms:created "2016-10-04T13:07:40.000Z"^^xsd:dateTime;
    skos:prefLabel "Kwomintang"@de, "Kwomintang"@en, "Kwomintang"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Chinese Kwomintang of Guomindang, wat Chinese Nationale Partij of Chinese Nationalistische Partij betekent, is een Chinese politieke partij die in de periode 1927-1948 China regeerde en daarna naar Taiwan uitweek. De leider van de Kwomintang was Chiang Kai-shek. Tijdens de Tweede Chinees-Japanse Oorlog (1937-1945) vocht de Kwomintang net als de Chinese Communistische Partij tegen Japan."@nl;
    skos:altLabel "Guomindang"@nl, "Kuomintang"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/4575> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "N.J.G. Sikkel (red.), Documentatie. Samengesteld ten behoeve van de Bijzondere Rechtspleging, op last van de Procureur-Fiscaal bij het Bijzonder Gerechtshof te Amsterdam (Amsterdam 1947) "@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-05-19T14:23:16.569Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1943-03-12"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> <https://weert.hosting.deventit.net/HttpHandler/icoon.ico?file=223563884>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://studiezaal.erfgoedhuisweert.nl/detail.php?nav_id=2-1&id=223563879";
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=34._SS-Freiwilligen-Grenadier-Division_Landstorm_Nederland&oldid=45840720"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-06"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    skos:relatedMatch <https://data.niod.nl/WO2_biografieen/Jan-Rudolf-Hommes>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Landstorm Nederland, opgericht in 1943, was een militaire eenheid. De Landstorm richtte zich op het bestrijden van vijanden van de Duitse bezetter binnen Nederland, maar was ook actief aan het Westfront. De eenheid bestond uit circa 3.400 Nederlandse vrijwilligers. Door bij de Landstorm Nederland in krijgsdienst te gaan, ontkwamen de vrijwilligers aan de Arbeitseinsatz of dienst aan het Oostfront. Bij oprichting heette de eenheid Landwacht Nederland. In oktober 1943 ging de eenheid op in de Waffen-SS, het legeronderdeel van de Schutzstaffel (SS), en veranderde de naam in Landstorm Nederland. Nederlanders die bij de Landstorm Nederland gingen, verloren na de oorlog hun Nederlandse nationaliteit."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4717>, <https://data.niod.nl/WO2_Thesaurus/1854>,
      <https://data.niod.nl/WO2_Thesaurus/20640>;
    dcterms:created "2016-10-04T13:07:40.000Z"^^xsd:dateTime;
    skos:prefLabel " Landstorm Nederland"@nl, "Landstorm"@de, "Militia"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Landstorm Nederland werd op 12 maart 1943 opgericht en stond onder bevel van Rauter als Höherer SS- und Polizeiführer. De oorspronkelijke naam van deze militaire formatie was Landwacht Nederland. Om verwarring met de Nederlandsche Landwacht (een politionele formatie) te vermijden werd de naam op 16 oktober van dat jaar veranderd in Landstorm Nederland. De Landstorm was een territoriale organisatie bestemd ‘voor de afweer van buitenlandsche of binnenlandsche vijanden binnen Nederland’, zodat de vrijwilligers geen gedwongen tewerkstelling of overplaatsing naar het Oostfront hadden te vrezen. Vanaf september 1944 werd de Landstorm ook ingezet aan het westfront in België en daarna in Nederland. Vanaf november 1944 werd de naam aangepast naar SS-Freiwilligen-Grenadier-Brigade Landstorm Nederland, en vanaf 10 februari 1945 naar 34. SS-Freiwilligen-Grenadier-Division Landstorm Nederland."@nl;
    skos:altLabel "Landstorm"@nl, "34. SS-Freiwilligen-Grenadier-Division Landstorm Nederland"@nl,
      "Landwacht Nederland"@nl, "SS-Freiwilligen-Grenadier-Brigade Landstorm Nederland"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization>;
    skos:definition "De 34. SS-Freiwilligen-Grenadier-Division Landstorm Nederland was een divisie van de Waffen-SS. De eenheid bestond voornamelijk uit Nederlandse vrijwilligers en was uitsluitend actief aan het westfront. De militaire formatie werd in maart 1943 opgericht als 'Landwacht Nederland', niet te verwarren met de later opgerichte Nederlandse Landwacht. Op 16 oktober 1943 verscheen een verordening waarin werd bepaald dat 'Landwacht Nederland' met onmiddellijke ingang de naam 'Landstorm Nederland' ging dragen als SS-Grenadier-Regiment. Vanaf november 1944 werd de naam aangepast naar SS-Freiwilligen-Grenadier-Brigade Landstorm Nederland, en vanaf 10 februari 1945 naar 34. SS-Freiwilligen-Grenadier-Division Landstorm Nederland. "@nl .
  
