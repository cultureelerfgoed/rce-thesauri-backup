    skos:prefLabel "Jungenlager"@de, "Boys camps"@en, "Jongenskampen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Jongenskampen zijn de kampen speciaal bedoeld voor jongens. In Indonesië waren de interneringskampen onderverdeeld in Burgermannenkampen, jongenskampen en vrouwenkampen. Vanaf hun 10e jaar werden jongens niet meer bij hun moeders in de vrouwenkampen ondergebracht, maar in burgermannenkampen of in aparte jongenskampen"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/21452> .
  
  <https://data.niod.nl/WO2_Thesaurus/16933> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-03-12T08:09:07.275Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/7cf3c2bb-0a58-2eb7-06e0-089bd8900dac.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/4e3b40f0-025a-11e7-904b-d89d6717b464/media/7cf3c2bb-0a58-2eb7-06e0-089bd8900dac";
    dcterms:source "https://www.joodserfgoeddenhaag.nl/75-jaar-geleden-augustus-1942-razzias-en-deportaties-in-den-haag/"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4658>, <https://data.niod.nl/WO2_Thesaurus/2005>,
      <https://data.niod.nl/WO2_Thesaurus/20645>;
    dcterms:created "2021-06-29T10:13:54.013Z"^^xsd:dateTime;
    skos:prefLabel "Judenreferat IV B4"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Judenreferat IV B4 was een organisatie in Den Haag die deportatieschema's voor de in Nederland verblijvende Joden opstelde. Het Sonderreferat J werd in maart 1942 omgedoopt tot Judenreferat IV B4 dat onder het Reichssicherheitshauptamt in Berlijn viel. Hanns Albin Rauter zorgde ervoor dat dit Judenreferat de organiserende en uitvoerende instantie van de deportaties werd met eigen personeel en nauw samenwerkte met politiekorpsen in de provincie. De Duitser Willy Zöpf was hoofd van het Judenreferat en Sturmscharführer Franz Fischer de uitvoerder. Tussen augustus 1942 en april 1943 werd het merendeel van de Haagse Joden naar doorgangskamp Westerbork gedeporteerd."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/16943> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    dcterms:modified "2021-06-29T12:30:55.852Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/kampen/3707>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/8/84/Treblinka2.JPG/1280px-Treblinka2.JPG";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Treblinka_(concentratiekamp)#/media/Bestand:Treblinka2.JPG";
    <http://schema.org/location> "Kamp Treblinka";
    <http://schema.org/startDate> "1943-08-02"^^xsd:date;
    dcterms:source "https://historiek.net/opstand-treblinka-1943/136280/"@nl, "https://nl.wikipedia.org/wiki/Treblinka_(concentratiekamp)"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2713>;
    dcterms:created "2021-06-29T12:02:17.454Z"^^xsd:dateTime;
    skos:prefLabel "Opstand in Kamp Treblinka"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Op 2 augustus 1943 kwamen honderden Poolse en Tsjechische Joden in concentratiekamp Treblinka in opstand. Deze verzetsgroep slaagde erin de wapenkamer te openen en nam de kampbewakers onder vuur. Slechts zestig van de opstandelingen overleefden de oorlog. Het Poolse verzetsleger, Armania Krajowa (AK), was bij de opstand betrokken. Eind augustus waren de laatste slachtoffers vergast en werd het kamp ontmanteld."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/16944> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:04:47.174Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/11386>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/6/60/Landgericht-d.jpg/1280px-Landgericht-d.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://en.wikipedia.org/wiki/Treblinka_trials#/media/File:Landgericht-d.jpg";
    <http://schema.org/location> "Düsseldorf";
    <http://schema.org/startDate> "1964-10-12"^^xsd:date;
    <http://schema.org/endDate> "1965-09-03"^^xsd:date;
    dcterms:source "https://en.wikipedia.org/wiki/Treblinka_trials"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3498>;
    dcterms:created "2021-06-29T12:35:47.738Z"^^xsd:dateTime;
    skos:prefLabel "Treblinka trials I"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Treblinka trials waren twee processen tegen het personeel van vernietingskamp Treblinka die in Düsseldorf plaatsvonden. Het eerste proces begon op 12 oktober 1964. Elf leden van het SS kamppersoneel stonden terecht. De getuigenis van Franciszek Zabecki, coördinator bij de Reichsbahn voor bezet Polen tijdens de Holocaust, leverde zeer belastend bewijsmateriaal op. Op 3 september 1965 werden de veroordelingen uitgesproken."@nl;
    skos:altLabel "Treblinka proces"@nl, "Eerste Treblinka proces"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/kampen/3707>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/16945> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:04:39.664Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/11386>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/c88d5a3a-a43b-b7f7-e056-57282ced6bd5.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/e332a500-0259-11e7-904b-d89d6717b464/media/c88d5a3a-a43b-b7f7-e056-57282ced6bd5";
    <http://schema.org/startDate> "1970-05-13"^^xsd:date;
    <http://schema.org/endDate> "1970-12-22"^^xsd:date;
    dcterms:source "https://en.wikipedia.org/wiki/Treblinka_trials"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3498>;
    dcterms:created "2021-06-29T12:53:02.491Z"^^xsd:dateTime;
    skos:prefLabel "Treblinka trials II"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Treblinka trials waren twee processen tegen het personeel van vernietingskamp Treblinka die in Düsseldorf plaatsvonden. Het tweede proces, ook wel de Stangl trial genoemd, vond plaats van 13 mei tot 22 december 1970. Kampcommandant Franz Stangl stond terecht en werd tot levenslange gevangenisstraf veroordeeld. Hij overleed in gevangenschap op 28 juni 1971."@nl;
    skos:altLabel "Treblinka proces"@nl, "Tweede Treblinka prcoes"@nl, "Stangl trial"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/kampen/3707>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/16946> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2025-05-27T11:05:47.035Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/d/d3/Prozess_WVHA_der_SS_%281947-1948%29_Pohl-Frank-Fanslau-Loerner-Eirenschmalz-Sommer-Pook.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://en.wikipedia.org/wiki/SS_Main_Economic_and_Administrative_Office#/media/File:Prozess_WVHA_der_SS_(1947-1948)_Pohl-Frank-Fanslau-Loerner-Eirenschmalz-Sommer-Pook.jpg";
    dcterms:source "https://en.wikipedia.org/wiki/SS_Main_Economic_and_Administrative_Office"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/21685>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4886>;
    dcterms:created "2021-06-29T13:14:53.496Z"^^xsd:dateTime;
    skos:prefLabel "SS-WVHA"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De SS-Wirtschafts- und Verwaltungshauptamt (SS-WVHA) was het economisch en administratief hoofdkantoor van de SS. De SS-WVHA was verantwoordelijk voor het beheer van de financiën, bevoorradingssystemen en zakelijke projecten voor de Allgemeine-SS. Het bestuurde ook de concentratiekampen en speelde een belangrijke rol bij de uitvoering van de vernietiging van de Joden via kantoren zoals de Inspectie van de Concentratiekampen en SS-kampbewakers. In juni 1939 werd SS- Obergruppenführer Oswald Pohl hoofd van zowel de Verwaltung und Wirtschaft Hauptamt (VuWHA) als het Hauptamt Haushalt und Bauten (hoofdbureau voor begroting en bouw)."@nl;
    skos:altLabel "SS-Wirtschafts- und Verwaltungshauptamt"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/16948> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2024-12-05T09:12:57.791Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/96726177-695d-ee7e-5f2b-c36d10e335bf.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/c56d233c-025a-11e7-904b-d89d6717b464/media/96726177-695d-ee7e-5f2b-c36d10e335bf";
    dcterms:source "https://nl.wikipedia.org/wiki/1e_Onafhankelijke_Parachutistenbrigade"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    skos:relatedMatch <https://data.niod.nl/WO2_Thesaurus/events/4391>, <https://data.niod.nl/Organizations/830>,
      <https://data.niod.nl/WO2_biografieen/Stanislaw-Sosabowski>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4642>, <https://data.niod.nl/WO2_Thesaurus/20711>;
    dcterms:created "2021-06-29T14:21:37.384Z"^^xsd:dateTime;
    skos:prefLabel "1e Onafhankelijke Parachutistenbrigade"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Poolse 1e Onafhankelijke Parachustistenbrigade werd op 23 september 1941 in Engeland opgericht. De eenheid bestond voornamelijk uit Poolse militairen die na de inval van Duitsland in Polen en Frankrijk naar Engeland waren gevlucht. De brigade stond onder leiding van Generaal-Majoor Stanislaw Sosabowski en moest ondersteuning gaan bieden bij de geplande opstand tegen de Duitse bezetter in Polen. De brigade werd vanaf 17 september 1944 ingezet voor de bevrijding van Nederland."@nl;
    skos:altLabel "1 Samodzielna Brygada Spadochronowa"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
