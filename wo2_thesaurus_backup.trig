    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/w/index.php?title=File:514th_Fighter_Squadron_P-47_Thunderbolt_1945.jpg&oldid=768872264";
    dcterms:source "https://en.wikipedia.org/w/index.php?title=M%C3%BCnster-Handorf_Airfield&oldid=1075496898"@en;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2110>;
    dcterms:created "2023-06-22T15:14:04.785Z"^^xsd:dateTime;
    skos:prefLabel "Fliegerhorst Münster-Handorf"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Fliegerhorst Münster-Handorf was een vliegveld ten noordoosten van Münster. Het vliegveld was in 1935 aangelegd als een van de eerste vliegvelden van de Luftwaffe. Tijdens de Tweede Wereldoorlog werden er vanuit het vliegveld vele missies met jachtvliegtuigen en bommenwerpers gevlogen en V1’s gelanceerd, maar het vliegveld werd ook regelmatig door de geallieerden gebombardeerd. Vanaf eind maart 1945 werd het vliegveld door de USAAF in gebruik genomen en in december 1945 aan de RAF overgedragen. Na de Tweede Wereldoorlog werd er echter nauwelijks gebruik gemaakt van het vliegveld waardoor het uiteindelijk in 1961 werd gesloten. "@nl;
    skos:altLabel "Münster-Handorf Airfield"@en, "Vliegveld Münster-Handorf"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
