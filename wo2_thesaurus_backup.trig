    dcterms:created "2023-08-31T12:21:50.834Z"^^xsd:dateTime;
    skos:prefLabel "Schütze"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De rang van SS-Schütze of SS-Mann in de SS en de Waffen-SS is vergelijkbaar met de rang van soldaat. De Waffen-SS was de militaire tak van de SS. Vanaf juni 1940 werden Nederlanders geworven voor de Waffen-SS. De rang SS-maat in de Nederlandsche SS was het equivalent van de rang SS-Schütze of SS-Mann in de SS en de Waffen-SS. Deze rang was vergelijkbaar met de rang van soldaat. Vanaf januari 1944 werden ook in de Nederlandsche SS de Duitse rangaanduidingen gebruikt."@nl;
    skos:altLabel "SS-Maat"@nl, "SS-Schütze"@nl, "SS Schütze"@nl, "SS-Mann"@nl, "SS Mann"@nl,
      "Mann"@nl, "SS Maat"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4717>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4521>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/4886> .
  
