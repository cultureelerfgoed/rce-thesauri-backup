    skos:prefLabel "Woonwagenkamp"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Op een Woonwagenkamp leven woonwagenbewoners in mobiele woningen of op een permanente plek met riolering en andere nutsvoorzieningen. De van oorsprong rondtrekkende Sinti, Roma en woonwagenbewoners werden door de overheid gedwongen om zich op een plek te vestigen op aangewezen locaties, de woonwagenkampen."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/11439> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:references """Vervolging van zigeuners in Nederland 1940-1945, Dr. B. A. Sijes in samenwerking met Th.M. de Graaf, A. Kloosterman, J.F.A. van Loenen , G.J. van Setten, A.L. Visser. 
Uitgave Ministerie van Onderwijs en Wetenschappen RIOD Monografieën, nr. 13, Vervolging van zigeuners in Nederland 1940-1945, Den Haag, 1979"""@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-04-12T10:47:51.664Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/11390>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/860ad42a-8add-7b90-cdc4-1e89c544e6dc.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/f773f9dc-025a-11e7-904b-d89d6717b464/media/860ad42a-8add-7b90-cdc4-1e89c544e6dc";
    <http://schema.org/location> "Wenen";
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/11450>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2788>, <https://data.niod.nl/WO2_Thesaurus/20716>;
    dcterms:created "2021-04-07T10:33:06.460Z"^^xsd:dateTime;
    skos:prefLabel "Internationale Zigeunercentrale"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Op 9 maart 1936 werd de internationale Zigeunercentrale officieel geactiveerd. Het initiatief tot de oprichting van een internationale Zigeunercentrale werd genoemd in een brief van 30 juli 1931 van de Oostenrijkse bondskanselier aan de leden van de Internationale Kriminalpoliteiliche Kommission (IKPK). Deze organisatie beoogde de internationale bestrijding van de misdaad. Begin 1938 hadden acht Europese landen hun 'zigeunercorrespondentieadres' aan het internationale bureau in Wenen verstrekt: België, Letland, Portugal, Duitsland, Frankrijk, Finland, Polen en Nederland. Daar kwamen nog bij Joegoslavië, Tsjechoslowakije en Oostenrijk. Na de machtsovername in Oostenrijk in maart 1938 werd de IKPK onder Duits beheer gesteld. Eind 1938 verscheen een verordening van Himmler met als opschrift 'Bekämpfung der Zigeunerplage'. In mei 1940 vonden de eerste deportaties van rond 2.500 Sinti en Roma plaats vanuit west- en noordwest Duitsland."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/11440> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:18:07.771Z"^^xsd:dateTime;
