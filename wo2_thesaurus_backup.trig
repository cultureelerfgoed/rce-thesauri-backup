    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://images.memorix.nl/niod/thumb/640x480/f16e7a13-914f-69c3-a626-8d1de4b8045d.jpg>,
      <https://upload.wikimedia.org/wikipedia/commons/b/b7/Karl_Morgenschweis_prays_for_condemned_prisoner.jpg?1595237183789>;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Gevangenis_van_Landsberg&oldid=56697861"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1686>;
    dcterms:created "2020-07-20T09:20:13.000Z"^^xsd:dateTime;
    skos:prefLabel "Gevangenis van Landsberg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Gevangenis van Landsberg werd vanaf 1910 in gebruik genomen als plek waar gedetineerden hun straf uitzaten of geëxecuteerd werden. De bekendste gevangene is Adolf Hitler, die in 1924 een jaar in de gevangenis werd opgesloten vanwege de Bierkellerputsch. Na de oorlog zaten hier de  nazi-artsen die in het Artsenproces veroordeeld waren. Zeven van hen werden op 2 juni 1948 opgehangen. De gevangenis van Landsberg wordt vandaag de dag nog gebruikt."@nl;
    skos:altLabel "Landsberg gevangenis"@nl, "Justizvollzugsanstalt Landsberg"@nl, "Landsberg prison"@nl,
      "Gevangenis Landsberg am Lech"@nl, "War Criminals Prison No. 1"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/9079> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:17:25.748Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/4/49/Bundesarchiv_R_165_Bild-244-70%2C_Dr._Robert_Ritter_bei_Blutabnahme.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/w/index.php?title=Zigeunervervolging&oldid=56498080"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://www.delpher.nl/nl/kranten/view?coll=ddd&identifier=ddd:010310036:mpeg21:a0013>,
      <https://upload.wikimedia.org/wikipedia/commons/8/83/Bundesarchiv_R_165_Bild-244-66%2C_Gesichtsabformung_bei_einem_Mann.jpg>,
      <https://upload.wikimedia.org/wikipedia/commons/8/8d/Bundesarchiv_R_165_Bild-244-64%2C_Bestimmung_der_Augenfarbe.jpg>;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Zigeunervervolging&oldid=56498080"@nl,
      "https://westerborkportretten.nl/bronnen/robert-ritter-en-de-zigeunerforschung"@nl;
    <http://schema.org/description> "Zigeuneronderzoek werd van 1936 tot 1939 in nazi-Duitsland uitgevoerd om de Sinti- en Romagemeenschap te bestuderen en beoordelen. Het onderzoek startte naar aanleiding van de oprichting van het Rassenhygienische Forschungsstelle: een pseudowetenschappelijk instituut gericht op rassenonderzoek. Psychiater en psycholoog Robert Ritter had de leiding en onderzocht het verband tussen 'zigeuners' en criminaliteit en asociaal gedrag. Na afloop van het onderzoek in 1939 concludeerde Ritter dat 90% van de Duitse Sinti en Roma 'Zigeunermischlinge' zijn: mensen die decennialang relaties hebben aangeknoopt met ‘Duitse criminelen’ en ‘asocialen’, waardoor ze zijn afgegleden tot een minderwaardig ras. Om dit ‘probleem’ te verhelpen stelde Ritter voor de mensen in ‘gesloten koloniën’ onder te brengen en te steriliseren. Het werk leidde de raciale vervolging van Sinti en Roma in."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2788>, <https://data.niod.nl/WO2_Thesaurus/3468>;
    dcterms:created "2020-07-20T15:33:03.000Z"^^xsd:dateTime;
    skos:prefLabel "Zigeuneronderzoek"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Zigeuneronderzoek werd van 1936 tot 1939 in nazi-Duitsland uitgevoerd om de Sinti- en Romagemeenschap te bestuderen en beoordelen. Het onderzoek startte naar aanleiding van de oprichting van het Rassenhygienische Forschungsstelle: een pseudowetenschappelijk instituut gericht op rassenonderzoek. Psychiater en psycholoog Robert Ritter had de leiding en onderzocht het verband tussen 'zigeuners' en criminaliteit en asociaal gedrag."@nl;
    skos:altLabel "zigeunerforschung"@nl, "Zigeuner Forschung"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
