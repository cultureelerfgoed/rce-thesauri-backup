    <http://schema.org/startDate> "1945-02-05"^^xsd:date;
    dcterms:source "https://ogs.nl/monumenten/amersfoort-monument-aan-de-barchman-wuytierslaan"@nl,
      "https://www.4en5mei.nl/oorlogsmonumenten/zoeken/1681/amersfoort-monument-aan-de-barchman-wuytierslaan"@nl,
      "https://www.75jaarvrijheid.nl/artikel/2429117/amersfoort-past-oorlogsmonument-met-naam-foute-rotterdammer-aan"@nl,
      "https://nos.nl/artikel/2230190-de-commandant-zei-nach-schule-oder-nach-hause-en-jan-overleefde-de-oorlog"@nl;
    <https://data.niod.nl/organizationsWO2/isCausedBy> <https://data.niod.nl/WO2_Thesaurus/19078>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/9271>;
    dcterms:created "2022-10-12T11:32:31.534Z"^^xsd:dateTime;
    skos:prefLabel "Fusillade bij de Barchman Wuytierslaan in Amersfoort"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 5 februari 1945 vond de Fusillade bij de Barchman Wuytierslaan in Amersfoort plaats. Als represaille voor de aanslag op het Hoofdseinhuis in Amersfoort werden 20 mannen uit Kamp Amersfoort en de gevangenis aan het Wolvenplein in Utrecht gehaald en in de voortuin van Barchman Wuytierslaan 40-42 geëxecuteerd. Bij de slachtoffers werd een bord met ‘Terroristen en saboteurs’ geplaatst en de slachtoffers bleven vervolgens 24 uur lang in de voortuin liggen. Onder de slachtoffers bevonden zich een aantal verzetsdeelnemers, maar ook een collaborateur die vastzat vanwege inbraak en een Nederlander die uit de SS was gedeserteerd."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/19186> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Recht op wraak. Liquidaties in Nederland 1940-1945, Jack Kooistra en Albert Oosthoek, Leeuwarden 2009"@nl,
      "Albert Oosthoek, Nieuw licht op liquidaties. Knokploegen in Rotteerdam 1944-1945 (Soesterberg: Uitgeverij Aspekt, 2015) "@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2022-11-24T08:46:39.402Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/19185>;
    <http://schema.org/startDate> "1944-12-21"^^xsd:date;
    dcterms:source "https://www.joodserfgoedrotterdam.nl/heemraadssingel/"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2684>;
    dcterms:created "2022-11-23T11:46:07.192Z"^^xsd:dateTime;
    skos:prefLabel "Overval Heemraadssingel 219 Rotterdam"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 21 december 1944 vond de Overval op Heemraadssingel 219 Rotterdam plaats. Het Sicherheitsdienst-kantoor en de SD-archieven waren op 15 december 1944 naar de Heemraadssingel 219 verplaatst nadat de vorige locatie op Heemraadssingel 226 was gebombardeerd. De LKP Rotterdam trachtte de archieven alsnog te vernietigen en gevangenen te bevrijden. 75 verzetsdeelnemers deden aan de overval mee, waarvan 15 man het kantoor zou binnendringen en de overige 60 als dekkingsploeg diende. Er volgde een schotenwisseling waarbij de Nederlandse SD’er en SS-Unterscharführer Paul Cramer (Paulus Jacobus Johannes Kramer) en een onschuldige voorbijganger omkwamen. De overval mislukte en er werden geen archieven vernietigd of gevangenen bevrijd. Als represaille voor de overval zijn zeker 4 mannen gefusilleerd. "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/19249> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references """Inger Schaap, Sluipmoordenaars. De Silbertanne-moorden in Nederland 1943-1944 (Meppel: Just Publishers, 2010)
"""@nl;
