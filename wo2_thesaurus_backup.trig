    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/e1031796-025a-11e7-904b-d89d6717b464/media/c89f4d44-97cc-a6a3-bc9b-5f02fe4a04e3";
    <http://schema.org/location> "Den Haag";
    <http://schema.org/startDate> "1944-12-29"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
