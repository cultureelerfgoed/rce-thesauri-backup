    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Slag_in_de_Straat_van_Soenda&oldid=52707189"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2350>, <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2019-03-27T13:21:33.000Z"^^xsd:dateTime;
    skos:prefLabel "Slag in de Straat Soenda"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Bij de Slag in de Straat Soenda stuiten twee kruisers, de Australische HMAS Perth en de Amerikaanse USS Housten en de torpedobootjager Hr.Ms. Evertsen, die op weg waren van Tandjong Priok naar Tjilatjap bij de Baai van Bantam in de nacht van 28 februari op 1 maart 1942 onverwacht op de Japanse invasievloot voor West-Java. Beide schepen worden na een hevig gevecht tot zinken gebracht en de torpedojager in brand geschoten."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
