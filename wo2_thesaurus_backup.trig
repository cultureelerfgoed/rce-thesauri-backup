    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2858>, <https://data.niod.nl/WO2_Thesaurus/locations/9869>;
    dcterms:created "2021-02-01T13:40:17.125Z"^^xsd:dateTime;
    skos:prefLabel "Rijks Krankzinnigen Gesticht in Grave"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "In 1898 opende een Rijks Krankzinnigen Gesticht zijn poorten in Grave. Het was de tweede instelling van die aard in Nederland. De eerste stond in Medemblik en in 1913 zou er nog een derde bijkomen, in Woensel. De Graafse instelling vond huisvesting in het oude Arsenaal. Als RPI (Rijks Psychiatrische Inrichting) is de instelling tot 1973 in Grave gevestigd gebleven."@nl .
  
