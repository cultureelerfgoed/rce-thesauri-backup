  <https://data.niod.nl/WO2_Thesaurus/19535> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:references "N.J.G. Sikkel (red.), Documentatie. Samengesteld ten behoeve van de Bijzondere Rechtspleging, op last van de Procureur-Fiscaal bij het Bijzonder Gerechtshof te Amsterdam (Amsterdam 1947)"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2024-08-12T12:03:08.804Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Het Korps Nationaal-Socialistische Ambtenaren (KNSA) was een nationaalsocialistische ambtenarenbond. Het KNSA ontstond uit de vooroorlogse Nationale Ambtenarenbond. Het KNSA had als doel de ambtenarij op nationaalsocialistische wijze te hervormen. Het KNSA heeft geen rol van betekenis gespeeld, omdat het geen overeenstemming bereikte met de Duitse bezetter over de invulling van de organisatie."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1746>, <https://data.niod.nl/WO2_Thesaurus/2146>,
      <https://data.niod.nl/WO2_Thesaurus/20640>;
    dcterms:created "2023-05-04T11:48:50.235Z"^^xsd:dateTime;
    skos:prefLabel "Korps Nationaal-Socialistische Ambtenaren"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Korps Nationaal-Socialistische Ambtenaren (KNSA) ontstond door een naamsverandering van de Nationale Ambtenarenbond die al voor de oorlog was opgericht. Het KNSA heeft nauwelijks betekenis gehad omdat het niet met de Duitse autoriteiten en niet met het NVV onder gezag van NSB’er Henk Woudenberg (16 juli 1940 tot 1 mei 1942) tot overeenstemming wist te komen over de principiële positie van ambtenaren en manier waarop zij georganiseerd zouden worden."@nl;
    skos:altLabel "K.N.S.A."@nl, "Korps Nationaal Socialistische Ambtenaren"@nl, "Korps Nationaalsocialistische Ambtenaren"@nl,
      "Nationaal Socialistische Ambtenaren Korps"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
