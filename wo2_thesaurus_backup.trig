    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/19060>;
    <http://schema.org/startDate> "1944-10-24"^^xsd:date;
    dcterms:source "https://stadsarchief.rotterdam.nl/zoek-en-ontdek/beeld-en-geluid/zoekresultaat-beeldgeluid/?mistart=24&mivast=184&mizig=299&miadt=184&milang=nl&misort=last_mod%7Cdesc&miview=ldt&mizk_alle=trefwoord%3AGevangenen"@nl,
      "https://oorlogsgravenstichting.nl/personen/175912/leendert-wijnolst#images-gallery-1"@nl;
    <https://data.niod.nl/organizationsWO2/caused> <https://data.niod.nl/WO2_Thesaurus/events/19058>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2574>;
    dcterms:created "2022-08-31T10:25:50.699Z"^^xsd:dateTime;
    skos:prefLabel "Schietpartij rond de Statentunnel in Rotterdam, 24 oktober 1944"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Schietpartij rond de Statentunnel in Rotterdam vond op 24 oktober 1944 plaats tussen de Sicherheitsdienst (SD) en de KP-Harro onder leiding van Harro Schouten. Het ging mogelijk om een uitwisseling van documenten tussen twee overgelopen SD’ers en de KP-Harro. Het bleek echter een val te zijn. De ondergedoken SS’er Andre Van Welsum, de NSB’er Frederik Christiaan Wicart die voor het verzet werkte en illegale werker Leendert Wijnolst werden hierbij in de buurt van het Middellandplein doodgeschoten. Enige momenten later volgt een schietpartij tussen zes leden van KP-Harro en de SD, Ordnungspolizei en Landwacht, waarbij verzetsdeelnemer Johannes Pieter van der Puijl ergens tussen de Statentunnel en Heemraadssingel wordt doodgeschoten."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/19065> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
