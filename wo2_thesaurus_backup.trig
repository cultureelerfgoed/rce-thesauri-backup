    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3557>;
    dcterms:created "2018-11-02T15:35:34.000Z"^^xsd:dateTime;
    skos:prefLabel "Slag om Otterlo"@nl, "Schlacht um Otterlo"@de, "Battle of Otterlo"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Slag om Otterlo was een veldslag tussen de 1e Canadese Infanterie Divisie en de 5e Canadese Tank Divisie van de Canadese strijdkrachten en Duitse strijdkrachten in de nacht van 16 op 17 april 1945 in en rond Otterlo (Gelderland). Er vielen 300 doden en gewonden aan Duitse zijde, en er sneuvelden 50 Canadezen en 4 inwoners van Otterlo."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/7143> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/7236> a <http://schema.org/Thing>, skos:Concept,
