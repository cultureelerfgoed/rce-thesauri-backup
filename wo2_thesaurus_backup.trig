    dcterms:source "https://mijngelderland.nl/inhoud/canons/groesbeek/evacuatie"@nl, "https://www.4en5mei.nl/oorlogsmonumenten/monumenten_zoeken/oorlogsmonument/1107/groesbeek%2C-%27evacuatie%27"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1922>, <https://data.niod.nl/WO2_Thesaurus/events/4391>;
    dcterms:created "2019-03-14T11:58:44.000Z"^^xsd:dateTime;
    skos:prefLabel "Evacuatie van Groesbeek"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Bij de Evacuatie van Groesbeek werden de inwoners van Groesbeek vanaf de Muntberg, Hooge Hoenderberg en de Maldensebaan naar bevrijd gebied geëvacueerd. Na de luchtlandingen op 17 september kwam Groesbeek midden in de vuurlinie tussen geallieerde en Duitse troepen te liggen. Eind september werd de toestand onhoudbaar, waardoor de burgemeester op 2 oktober 1944 iedereen verplichtte het dorp te verlaten en op afgesproken momenten en plekken werd iedereen verzameld om zich in veiligheid te stellen."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8107> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
