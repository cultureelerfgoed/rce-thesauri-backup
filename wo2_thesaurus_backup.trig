    dcterms:created "2022-04-29T09:46:11.241Z"^^xsd:dateTime;
    skos:prefLabel "Kamp Vaihingen bevrijd "@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Op 7 april 1945 werd kamp Vaihingen door Franse troepen bevrijd. Er waren nog ongeveer 650 gevangenen aanwezig. Velen waren zo verzwakt dat zij in het lokale ziekenhuis moesten worden opgenomen. Op 16 april was het kamp ontruimd en werden de restanten van het kamp in de brand gestoken."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
