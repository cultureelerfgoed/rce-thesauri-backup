    skos:prefLabel "'Groot-Nederlandse gedachte'"@de, "Greater Netherlands"@en, "Groot-Nederlandse gedachte"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Groot-Nederlandse gedachte is het staatkundige streven om Vlaanderen en Nederland te verenigen in één Nederlandstalige staat. Ontstaan aan het eind van de 19e eeuw beleefde het streven een opleving tijdens het Interbellum maar na de Tweede Wereldoorlog werd het met collaboratie vereenzelvigd."@nl;
    skos:altLabel "Dietsche Gedachte"@nl, "Grootneerlandisme"@nl, "Groot Nederland"@nl,
      "Groot-Nederland"@nl, "Dietsland"@nl, "Grootnederland"@nl, "Groot-Dietsland"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4704> .
  
