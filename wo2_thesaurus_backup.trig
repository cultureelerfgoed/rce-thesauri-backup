    skos:prefLabel "Mossad Le'Aliyah Bet"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Mossad Le'Aliyah Bet was een tak van de paramilitaire organisatie Hagana in Brits Mandaat Palestina. Tijdens de mandaatperiode faciliteerde deze organisatie de illegale immigratie van Joodse vluchtelingen naar Palestina. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/18602>, <https://data.niod.nl/WO2_Thesaurus/18616>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/18604> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:00:39.949Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/d/dc/AraziAvigurMagenta.jpg/1920px-AraziAvigurMagenta.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Mossad_Le%27Aliyah_Bet#/media/Bestand:AraziAvigurMagenta.jpg";
    <http://schema.org/startDate> "1939-04-29"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/wiki/Mossad_Le%27Aliyah_Bet"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/18603>;
    dcterms:created "2022-01-12T10:58:29.213Z"^^xsd:dateTime;
    skos:prefLabel "Oprichting Mossad Le'Alyiah Bet"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Op 29 april 1939 werd de Mossad Le'Alyiah Bet opgericht door de zionistisch-Joodse paramilitaire organisatie Hagana. Het doel was om illegale immigratie van Joodse vluchtelingen naar Palestina beter te organiseren. De werkzaamheden werden gefinancierd door de American Jewish Joint Distribution Committee (JDC). Shaul Avigur werd het hoofd van de organisatie. In 1953 werd het een agentschap."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/18605> a <http://schema.org/Thing>, skos:Concept,
