    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Het Nederlanderschap is de Nederlandse nationaliteit. Iemand kon de Nederlandse nationaliteit kwijtraken door vrijwillig in dienst te treden bij een buitenlands leger of een vijandelijke staat. De persoon werd dan staatloos. Na de Tweede Wereldoorlog verloren Nederlanders die zich bij de Duitse staat of het Duitse leger hadden aangesloten de Nederlandse nationaliteit."@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/19586>;
    dcterms:created "2024-05-23T08:06:27.124Z"^^xsd:dateTime;
    skos:prefLabel "Nederlanderschap"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "Het Nederlanderschap is de Nederlandse nationaliteit. Iemand kon de Nederlandse nationaliteit kwijtraken door vrijwillig in dienst te treden bij een buitenlands leger of een vijandelijke staat. De persoon werd dan staatloos. Na de Tweede Wereldoorlog verloren Nederlanders die zich bij de Duitse staat of het Duitse leger hadden aangesloten de Nederlandse nationaliteit."@nl;
    skos:altLabel "Staatloos"@nl;
