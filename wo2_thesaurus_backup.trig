    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/brd/thumb/1000x1000/7ab7fb6d-f95b-d3ac-b28d-5120c3a3ea2b.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://stadsarchief.breda.nl/collectie/beeld/films-en-foto-s/detail/b08c0bd0-50e8-0747-4636-23af2007c60e";
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/5095>;
    dcterms:created "2019-04-04T12:36:02.000Z"^^xsd:dateTime;
    skos:prefLabel "Struikelstenen"@nl, "Stolpersteine"@de;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Struikelstenen (Duits: Stolpersteine) is een project van de Duitse kunstenaar Gunter Demnig. Het is een over geheel Europa verspreid monument voor de slachtoffers van het nationaalsocialisme. Deze gedenktekens worden aangebracht in het trottoir voor de vroegere woonhuizen van mensen die door de nazi's verdreven, gedeporteerd, vermoord of tot zelfmoord gedreven zijn."@nl;
    skos:altLabel "Stroffelstiennen"@nl, "Stolpersteinen"@nl, "Herdenkingsstenen"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8282> a <http://schema.org/Thing>, skos:Concept;
