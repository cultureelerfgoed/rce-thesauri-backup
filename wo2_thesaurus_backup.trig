    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:33:44.951Z"^^xsd:dateTime;
    <https://data.niod.nl/eventsWO2/fromLocation> <https://data.niod.nl/WO2_Thesaurus/locations/10976>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/8/87/Overzicht_voorgevel_hoofdgebouw_-_Eindhoven_-_20380617_-_RCE.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Grote_Beek_(psychiatrisch_ziekenhuis)#/media/Bestand:Overzicht_voorgevel_hoofdgebouw_-_Eindhoven_-_20380617_-_RCE.jpg";
    <http://schema.org/startDate> "1944-03-14"^^xsd:date;
    dcterms:source "https://www.joodsmonument.nl/nl/page/611094/de-joodse-slachtoffers-van-het-rijks-krankzinnigen-gesticht-te"@nl;
    <https://data.niod.nl/eventsWO2/toLocation> <https://data.niod.nl/WO2_Thesaurus/kampen/4869>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/8315>;
    dcterms:created "2021-01-28T13:44:47.368Z"^^xsd:dateTime;
    skos:prefLabel "Transport Rijks Krankzinnigen Gesticht Woensel"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 14 maart 1944 werden 24 patiënten van het Rijks Krankzinnigen Gesticht in Woensel door de Sicherheitsdienst uit de instelling opgehaald en naar Kamp Westerbork gestuurd. Kort na hun aankomst in Westerbork ging de groep op transport met eindbestemming Auschwitz. Slechts een van hen overleefde de oorlog. Sinds 10 mei 2009 liggen er op het landgoed ‘De Grote Beek’ in Eindhoven, waar het gesticht gevestigd was, 24 struikelsteentjes."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/10981> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    dcterms:references "Nederlanders in Buchenwald 1940-1945, Kirsten Snijders, Göttingen 2001"@nl,
      "Het drama van Buchenwald, Thijs Rinsema, Meppel 2008"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-06-19T11:52:05.937Z"^^xsd:dateTime;
    <https://data.niod.nl/eventsWO2/fromLocation> <https://data.niod.nl/WO2_Thesaurus/kampen/3652>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/7/75/Buchenwald_entrance.jpg";
