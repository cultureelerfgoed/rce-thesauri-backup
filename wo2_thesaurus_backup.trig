    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/7d33ff52-a062-2b47-f342-84e9a4072058.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/19ced93a-025a-11e7-904b-d89d6717b464/media/7d33ff52-a062-2b47-f342-84e9a4072058";
    <http://schema.org/location> "Veenendaal";
    <http://schema.org/startDate> "1940-05-10"^^xsd:date;
    <http://schema.org/endDate> "1940-05-18"^^xsd:date;
    dcterms:source "https://gemeentearchief.veenendaal.nl/tour-wo-ii/begin-oorlog-en-evacuatie https://www.veenendaalopdekaart.nl/tweede-wereldoorlog/evacuatie/meidagen-40/pointofinterest/detail"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1922>, <https://data.niod.nl/WO2_Thesaurus/2322>;
    dcterms:created "2022-01-06T10:31:54.397Z"^^xsd:dateTime;
    skos:prefLabel "Evacuatie van Veenendaal"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Evacuatie van Veenendaal vond plaats op 10 mei 1940 vanwege de Duitse inval in Gelderland en de gevechten in de Grebbelinie. De evacués vertrokken per trein naar Alkmaar en Ede, en te voet naar Elst (Utrecht). Vanuit Elst vertrokken ze per schip en trein richting Zuid-Holland. Vanaf 18 mei 1940 keerden de inwoners van Veenendaal terug naar huis. Er was in Veenendaal niet gevochten, wel waren er circa 130 woningen in brand gestoken door Nederlandse troepen om het schootsveld vrij te maken."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/18580> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
