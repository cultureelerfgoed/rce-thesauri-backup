    <http://schema.org/location> "Borneo";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://www.delpher.nl/nl/kranten/view?coll=ddd&identifier=ddd:011176670:mpeg21:a0043>,
