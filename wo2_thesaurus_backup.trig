    skos:prefLabel "Verplichtingstelling van Nederlandse Arbeidsdienst"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Verplichtingstelling van de Nederlandse Arbeidsdienst werd ingevoerd op 1 april 1942. Dit gebeurde nadat vrijwillige oproepen weinig werden beantwoord. Naar aanleiding van de verplichtstelling doken veel mannen onder."@de;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/10173> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Bies van Ede en Paul Post, De Diamantroof. Hoe hoge nazi’s met geroofde diamanten uit Nederland en België een nieuw leven opbouwden (Utrecht: Uitgeverij Omniboek. 2016)"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2023-07-17T12:54:04.416Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/ams/thumb/350x350/775d8f89-62c8-b818-3e3d-338781a9c7b5.jpg";
