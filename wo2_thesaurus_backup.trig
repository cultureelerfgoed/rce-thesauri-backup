  <https://data.niod.nl/WO2_Thesaurus/events/8192> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2021-03-15T16:42:35.434Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8028>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/wo2nedindieThema> "Inval Japan";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> <https://93.191.128.243/webapi/wwwopac.ashx?command=getcontent&server=images&value=MHM02_F966554.jpg>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://93.191.128.243/MHM/Details/collect/11913";
    <http://schema.org/location> "Ambon";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://easy.dans.knaw.nl/ui/datasets/id/easy-dataset:41161>,
      <https://www.delpher.nl/nl/kranten/view?coll=ddd&identifier=ddd:010733968:mpeg21:a0008>,
      <https://beeldbankwo2.nl/nl/beelden/detail/d906bdf4-025a-11e7-904b-d89d6717b464/media/c372eca4-e04d-a117-69dc-9fbc624a4cb7>;
    <http://schema.org/startDate> "1942-01-31"^^xsd:date;
    <http://schema.org/endDate> "1942-02-07"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Slag_om_Ambon&oldid=49208807"@nl;
    <http://schema.org/description> "Voor de verdediging van Ambon neemt de legerleiding extra maatregelen. Ambon beschikt over een vliegveld en heeft een natuurlijke haven die strategisch van belang is als hulpbasis voor de marinehavens Soerabaja en Darwin. Naast 1.500 Nederlandse militairen is er daarom ook een Australisch infanteriebataljon van 1.200 man op Ambon gestationeerd. Op 31 januari landen 5.750 Japanse soldaten en mariniers op de noordkust van Hitoe en de zuidkust van Leitimor. Luitenant-kolonel J.L.R. Kapitz, de territoriaal commandant van Ambon, wordt met zijn staf op 1 januari gevangen genomen. Op 2 februari staken de Australische troepen de strijd. Vijf dagen later, op 7 februari, geven ook de laatste KNIL-eenheden zich over."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2350>, <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2019-03-27T09:10:06.000Z"^^xsd:dateTime;
    skos:prefLabel "Slag om Ambon"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Bij de Slag om Ambon landen op 31 januari 1942 5.750 Japanse soldaten en mariniers op de noordkust van Hitoe en de zuidkust van Leitimor. Vanwege het strategisch belang van Ambon, luchtaanvallen op Australië waren mogelijk vanaf hier, waren er al voor de Japanse aanval extra maatregelen genomen en was er een 3900 sterke troepenmacht van KNIL- en Australische militairen aanwezig op Ambon. Op 2 februari 1942 staken de Australische troepen de strijd en vijf dagen later, op 7 februari, geven ook de laatste KNIL-eenheden zich over."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8193> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
