    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nimh-beeldbank.defensie.nl/memorix/5a97e802-e758-6a17-3766-9593ad686de9";
    <http://schema.org/location> "Koraalzee";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://nimh-beeldbank.defensie.nl/foto-s/3313af4e-fd88-18c2-6e0e-8ee498b2ef31>,
