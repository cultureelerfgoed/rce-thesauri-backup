    dcterms:modified "2026-02-23T12:23:55.330Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/21975>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/ravend>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2163>, <https://data.niod.nl/WO2_Thesaurus/2210>;
    dcterms:created "2026-02-18T11:16:49.116Z"^^xsd:dateTime;
    skos:prefLabel "Kunsthandel Pictura"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Kunsthandel Pictura was een kunsthandel op Michelangelostraat 24, Amsterdam, geopend door Victor Modrzejewski en Josef Rosenthal in 1935. Pictura handelde tijdens de bezetting met Duitsers, zoals Bruno Lohse, Walter Andreas Hofer en Erhard Göpel. Ook werd samengewerkt met Jan Dik Jr. en Gustav Cramer. Tegelijk was Modrzejewski actief bij het helpen van Joden in Nederland en had hij meerdere onderduikers in zijn huis. De kunsthandel sloot in 1958."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/21932> a <http://schema.org/Thing>, skos:Concept,
