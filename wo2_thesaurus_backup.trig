    <http://schema.org/startDate> "1942-02-08"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Jacobus_Overduin&oldid=46547238"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/5424>;
    dcterms:created "2019-02-26T15:18:48.000Z"^^xsd:dateTime;
    skos:prefLabel "Preek van dominee Overduin"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Dominee Overduin raakte in 1942 betrokken bij de Arnhemse schoolstrijd. Hij preekte tegen het dreigende toezicht op het christelijk onderwijs door de Duitse bezetters. De preek van dominee Overduin vond plaats op 8 februari 1942, naar aanleiding van de sluiting van de Van Löben Selsschool in Arnhem. Het verzet van ds. J. Overduin tegen de maatregelen van de Duitsers ten aanzien van het onderwijs zorgde ervoor dat hij tijdens de bezetting driemaal gearresteerd werd (de eerste keer was al direct op zondag 8 februari 1942). "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/7903> a <http://schema.org/Thing>, skos:Concept;
