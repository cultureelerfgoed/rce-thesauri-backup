      "https://nl.wikipedia.org/w/index.php?title=Euthanasiecentrum_Hadamar&oldid=56014129#/media/Bestand:Hadamar,_Euthanasiecentrum_Hadamar.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Euthanasiecentrum_Hadamar#/media/Bestand:Hadamar,_Euthanasiecentrum_Hadamar.jpg";
