    dcterms:modified "2024-08-12T12:03:08.899Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1941-04-22"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/download/default/262813b7-0e10-7279-50f0-f637053ea4d0.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/e0783492-0259-11e7-904b-d89d6717b464/media/262813b7-0e10-7279-50f0-f637053ea4d0";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/86ef4504-025a-11e7-904b-d89d6717b464/media/d09e7a91-ebfd-48d9-bcb8-8b05db61e277>;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-06"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Het Departement voor Bijzondere Economische Zaken had als doel het nationaalsocialisme verspreiden in het bedrijfsleven, het herstellen van oorlogsschade en de Nederlandse economie in te zetten voor van Duitsland. Het departement werd op 22 april 1941 opgericht en werd geleid door Meinoud M. Rost van Tonningen."@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1753>;
    dcterms:created "2018-01-18T08:00:49.000Z"^^xsd:dateTime;
    skos:prefLabel "Ministerium für besondere Wirtschaftliche Angelegenheiten"@de, "Ministry for Special Economic Affairs"@en,
      "Departement van Bijzondere Economische Zaken"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Departement van Bijzondere Economische Zaken werd op 22 april 1941 opgericht door Rijkscommissaris Seyss-Inquart en stond onder leiding van NSB’er Rost van Tonningen als secretaris-generaal en F.L. Rambonnet als plaatsvervangend secretaris-generaal. Ondanks de hardnekkige pogingen van Rost om zijn bureau erkend te krijgen als departement, duurde het tot 23 juli 1942 voordat Seyss-Inquart hieraan de status van een ministerie verleende. Het Departement voor Bijzondere Economische Zaken en het Departement van Volksvoorlichting en Kunsten zijn de enige twee ministeries die door de Duitse bezetter zijn ingesteld. In 1943 werd het departement naar Deventer geëvacueerd."@nl;
    skos:altLabel "BEZ"@nl, "B.E.Z."@nl, "Departement voor Bijzondere Economische Zaken"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
