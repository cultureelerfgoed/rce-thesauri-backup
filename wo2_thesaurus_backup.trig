    <http://schema.org/endDate> "1943-03-18"^^xsd:date;
    dcterms:source "https://www.omroepwest.nl/nieuws/3747903/Stukken-razzia-Joods-kinderweeshuis-in-Leiden-openbaar-Nu-dringt-door-wat-er-echt-is-gebeurd"@nl,
      "https://nl.wikipedia.org/w/index.php?title=Centraal_Isra%C3%ABlitisch_Wees-_en_Doorgangshuis_(Leiden)&oldid=54256678"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/9118>, <https://data.niod.nl/WO2_Thesaurus/18619>;
    dcterms:created "2020-07-29T15:19:05.000Z"^^xsd:dateTime;
    skos:prefLabel "Razzia Centraal Israëlitisch Wees- en Doorgangshuis Leiden"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Razzia van het Centraal-Israëlitisch Wees- en Doorgangshuis 'Machseh Lajesoumim' in Leiden vond plaats op 17 maart 1943. 50 kinderen en 9 werknemers werden gearresteerd door de Leidse politie en naar Kamp Westerbork overgebracht. Vijf dagen later werden de negen werknemers en 25 kinderen naar Sobibor gedeporteerd, waar ze op 26 maart 1943 werden vermoord. Later werden nog 23 kinderen van het weeshuis naar onder andere Sobibor en Auschwitz gedeporteerd. Slechts drie kinderen uit Machseh Lajesoumim, waarvan er twee niet gedeporteerd waren, overleefden de Holocaust."@nl;
    skos:altLabel "Ontruiming Centraal Israëlitisch Wees- en Doorgangshuis Leiden"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9121> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
