    <http://schema.org/startDate> "1911-07-01"^^xsd:date;
    <http://schema.org/endDate> "1911-07-31"^^xsd:date;
    dcterms:source "https://www.delpher.nl/nl/tijdschriften/view?identifier=MMUBA15:005419080:00001&query=berg-stichting&page=1&sortfield=date&coll=dts&rowid=5"@nl;
