    <http://schema.org/startDate> "1940-06-27"^^xsd:date;
    dcterms:source "https://kranten.archiefalkmaar.nl/issue/WC/1940-06-29/edition/0/page/3?query="@nl,
      "https://tijdschriften.archiefalkmaar.nl/periodicals/KGW"@nl, "https://www.geschiedenislokaalregionaalarchiefalkmaar.nl/bronnen/bommen-op-wieringerwerf/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/19538>;
    dcterms:created "2020-10-07T08:42:41.000Z"^^xsd:dateTime;
    skos:prefLabel "Bombardement op Wieringerwerf"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 27 juni 1940, midden in de nacht, vielen op het dorp Wieringerwerf gelijktijdig 5 vliegtuigbommen, waarschijnlijk afkomstig van Engelse bommenwerpers. De materiële schade was groot maar er vielen geen doden of gewonden. Kort daarna werden twee schilderijen van Rembrandt, in 1939 uit voorzorg opgeslagen in het ‘depot’ gymnastieklokaal Wieringerwerf, overgebracht naar Medemblik. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9586> a <http://schema.org/Thing>, skos:Concept;
