    skos:prefLabel "Sabotage spoorrails Ede"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Sabotage op de spoorrails bij Ede vond plaats in de nacht van 5 op 6 september 1944 door het Edese verzet en in de vroege ochtend van 6 september 1944 ontspoorde er een Duitse troepentrein ter hoogte van de Dwarsweg bij Ede. In de wagons bevond zich onder meer Duits luchtmachtpersoneel dat uit Frankrijk (Dieppe) afkomstig was. Er vielen 12 doden en circa 25 gewonden, maar een vergeldingsactie bleef uit."@nl;
    skos:altLabel "Sabotage spoorrails De Klomp"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8081> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    dcterms:modified "2023-06-13T09:40:45.197Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/9624>;
