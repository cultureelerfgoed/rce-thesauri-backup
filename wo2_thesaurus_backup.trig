    <http://schema.org/startDate> "1942-03-21"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/8152>;
    dcterms:created "2020-12-01T08:24:42.270Z"^^xsd:dateTime;
    skos:prefLabel "Aankomst van geïnterneerden in Paramaribo"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De aankomst van geïnterneerden in Paramaribo vond plaats op 21 maart 1942. De geïnterneerden waren vooral NSB'ers, die in Nederlands-Indie waren gevangengezet na de Duitse inval in Nederland. Hier werden ze opgesloten in oude slavenverblijven in Fort Nieuw-Amsterdam. In september 1942 werd de groep verplaatst naar Kamp Jodensavanne."@nl .
  
