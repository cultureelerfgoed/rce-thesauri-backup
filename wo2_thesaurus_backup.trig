    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/44f4d43e-025a-11e7-904b-d89d6717b464/media/59e26e57-339f-4921-6a48-dedf77db43cd";
    <http://schema.org/location> "Baarlo";
    <http://schema.org/startDate> "1944-09-27"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/6923>, <https://data.niod.nl/WO2_Thesaurus/17750>;
    dcterms:created "2021-10-20T12:41:02.655Z"^^xsd:dateTime;
    skos:prefLabel "KP-leden uit Baarlo in gevecht met Duitse militairen "@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Op 27 september 1944 raakten KP'ers uit Baarlo in een vuurgevecht met Duitse militairen die de Boekenderhof wilden onderzoeken. Drie militairen werden neergeschoten maar de vierde ontsnapte. De boerderij werd meteen ontruimd en het verzet verstopte zich in de bossen. Kort daarna brandde een groep SS'ers de boerderij plat."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
