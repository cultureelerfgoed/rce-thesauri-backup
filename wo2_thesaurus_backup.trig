    skos:prefLabel "Gedenkstenen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Gedenkstenen zijn stenen met inscriptie of opschrift die tot teken dienen dat men van een persoon of zaak de gedachtenis bewaard wil houden."@nl .
  
