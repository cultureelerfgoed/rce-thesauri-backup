      "https://nl.wikipedia.org/wiki/Lijst_van_militaire_rangen_van_de_Schutzstaffel"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/19853>;
    dcterms:created "2023-08-30T08:21:15.843Z"^^xsd:dateTime;
    skos:prefLabel "Oberführer"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De rang van SS-Oberführer (afkorting: Oberf.) in de SS en de Waffen-SS was vergelijkbaar met de rang van brigadegeneraal. De Waffen-SS was de militaire tak van de SS. Vanaf juni 1940 werden Nederlanders geworven voor de Waffen-SS. De rang opperleider in de Nederlandsche SS was het equivalent van de rang SS-Oberführer in de SS en de Waffen-SS. Deze rang was vergelijkbaar met de rang van brigadegeneraal. Vanaf januari 1944 werden ook in de Nederlandsche SS de Duitse rangaanduidingen gebruikt. De rang van Oberführer in het Nationalsozialistisches Kraftfahrkorps (NSKK) was een rang hoger dan Standartenführer (vergelijkbaar met de rang van kolonel) en een rang lager dan de rang van Brigadeführer (vergelijkbaar met de rang van brigadegeneraal). Het NSKK was een paramilitair onderdeel van de NSDAP dat in de oorlog diende als bevoorradingseenheid aan de verschillende fronten. Met steun van de NSB-leiding begon in januari 1941 de werving van Nederlandse vrijwilligers voor het NSKK. De rang Landwacht-Oberführer was de hoogste rang in de Nederlandsche Landwacht. Op voorstel van Rauter wijzigde Himmler begin 1945 eerst de titel van inspecteur-generaal in kommandeur en kende hij vervolgens aan Kees van Geelkerken de rang van Landwacht-Oberführer toe."@nl;
    skos:altLabel "NSKK Oberführer"@nl, "NSKK-Oberführer"@nl, "SS-Oberführer"@nl, "SS Oberführer"@nl,
      "Oberf."@nl, "Opperleider"@nl, "Landwacht-Oberführer"@nl, "Landwacht Oberführer"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4619>, <https://data.niod.nl/WO2_Thesaurus/2249>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/4717>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4521>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/4886> .
  
