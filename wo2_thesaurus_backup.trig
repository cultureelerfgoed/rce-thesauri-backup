    skos:prefLabel "'Mr. Prikkeldraad'"@de, "'Mr. Prikkeldraad'"@en, "Mr. Prikkeldraad"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Mr. Prikkeldraad was een stripfiguur gemaakt voor Duitse propaganda in Nederland. In 1944 gaf het Departement van Volksvoorlichting en Kunsten (DVK) de Mr. Prikkeldraad-serie uit. Mr. Prikkeldraad werd voorgesteld als een typisch kleinburgerlijke Nederlander die vasthield aan het verleden en weigerde in te zien dat de komende invasie talloze landgenoten het leven zou kosten."@nl;
    skos:altLabel "Meester Prikkeldraad"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/4588> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "H. Schippers, Zwart en Nationaal Front. Latijns georiënteerd rechts-radicalisme in Nederland (1922-1946) (Amsterdan 1986)"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2025-01-09T09:44:30.498Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1940-04-20"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/6f7fec3c-ff57-0af6-f9eb-e25a055e179c.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/def4d818-025a-11e7-904b-d89d6717b464/media/6f7fec3c-ff57-0af6-f9eb-e25a055e179c";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/dae10b8a-0259-11e7-904b-d89d6717b464/media/3ae90baf-6fb1-5a3e-1c58-ed53ed8d8805>,
      <https://hdl.handle.net/21.12103/91a02f08-766c-466c-95f0-a981d74feee2>, <https://beeldbankwo2.nl/nl/beelden/detail/5bf73d84-025a-11e7-904b-d89d6717b464/media/f4575167-fc02-2599-3d52-bcc2fd3566c4>;
    <https://data.niod.nl/organizationsWO2/endDate> "1941-12-13"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Het Nationaal Front was een fascistische politieke partij onder leiding van Arnold Meijer. Het Nationaal Front werd op 20 april 1939 opgericht als een voortzetting van de fascistische politieke partij Zwart Front. In 1941 telde de partij ongeveer 10.000 leden. In december 1941 ging het Nationaal Front op Duits bevel op in de Nationaal-Socialistische Beweging (NSB)."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1899>, <https://data.niod.nl/WO2_Thesaurus/20640>;
    dcterms:created "2016-10-04T13:07:40.000Z"^^xsd:dateTime;
    skos:prefLabel "Nationale Front"@de, "National Front"@en, "Nationaal Front"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Nationaal Front, dat op 20 april 1940 werd opgericht, was feitelijk een voorzetting van Zwart Front. Begin 1941 telde deze fascistische partij onder leiding van Arnold Meijer ongeveer 10.000 leden. Doordat Meijer weigerde zich in het openbaar ondubbelzinnig uit te spreken voor nauwe samenwerking met nazi-Duitsland, legde de Duitse autoriteiten hem steeds meer beperkingen op. Toen zij in december 1941 alleen nog de NSB als politieke partij toestonden, betekende dat het einde van Nationaal Front."@nl;
    skos:altLabel "N.F."@nl, "NF"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4725>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
