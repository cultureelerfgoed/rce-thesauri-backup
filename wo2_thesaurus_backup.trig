    skos:prefLabel "De Zwarte Soldaat"@nl, "'De Zwarte Soldaat'"@de, "'De Zwarte Soldaat'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "De Zwarte Soldaat was het lijfblad van de WA van de NSB, dat tussen 1940 en 1945 wekelijks verscheen en zich sterk maakte voor een zelfstandig 'Dietschland'. De artikelen hadden een sterk nationaalsocialistische strekking en was bedoeld voor een algemeen, laaggeschoold publiek."@nl;
    skos:altLabel "Tijdschrift De Zwarte Soldaat"@nl .
  
