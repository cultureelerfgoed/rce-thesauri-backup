    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Korps_Speciale_Troepen&oldid=68766573"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4562>;
    dcterms:created "2025-01-23T10:42:59.943Z"^^xsd:dateTime;
    skos:prefLabel "Depot Speciale Troepen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Depot Speciale Troepen (DST) was een commando-eenheid van het Koninklijk Nederlandsch-Indisch Leger (KNIL). Het DST werd op 15 juni 1946 opgericht tijdens de Indonesische Onafhankelijkheidsoorlog. Per 5 januari 1948 heette het commando het Korps Speciale Troepen (KST) en vanaf juli 1949 het Regiment Speciale Troepen (RST). De eenheid bestond voornamelijk uit Nederlandse oorlogsvrijwilligers, Indo-Europese en Molukse soldaten en werd geleid door kapitein Wim Scheepens en later door kapitein Raymond Westerling. De eenheid was actief op Sulawesi en Java waar ze standrechtelijke executies uitvoerden en duizenden slachtoffers maakten."@nl;
    skos:altLabel "D.S.T."@nl, "Korps Speciale Troepen"@nl, "K.S.T."@nl, "Regiment Speciale Troepen"@nl,
      "R.S.T."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization>;
    skos:hiddenLabel "KST"@nl, "DST"@nl, "RST"@nl .
  
