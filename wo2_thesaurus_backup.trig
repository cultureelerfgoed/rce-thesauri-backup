    dcterms:source "https://www.archieven.nl/nl/search-modonly?mivast=298&mizig=210&miadt=298&miaet=1&micode=615&minr=1592239&miview=inv2"@nl,
      "https://www.delpher.nl/nl/kranten/view?coll=ddd&identifier=KBNRC01:000042960:mpeg21:a0020"@nl;
