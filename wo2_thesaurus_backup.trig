    dcterms:modified "2026-09-15T14:13:05.857Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1920-02-24"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/download/default/0dedc4fb-3650-a33d-20c0-bab855cb9b0a.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/df42e4fe-025a-11e7-904b-d89d6717b464/media/0dedc4fb-3650-a33d-20c0-bab855cb9b0a";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/a7597f0e-0259-11e7-904b-d89d6717b464/media/70a2e572-6415-261c-1355-9bb15a2d0aed>,
