    <http://schema.org/startDate> "1945-04-01"^^xsd:date;
    <http://schema.org/endDate> "1945-04-02"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/wiki/Doetinchem_in_de_Tweede_Wereldoorlog"@nl;
    <http://schema.org/name> "Doetinchem";
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/locations/8073>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/6983>;
    dcterms:created "2018-10-31T10:43:46.000Z"^^xsd:dateTime;
    skos:prefLabel "Befreiung von Doetinchem"@de, "Liberation of Doetinchem"@en, "Bevrijding Doetinchem"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De bevrijding van Doetinchem vond plaats op 1 en 2 april 1945. Aan het eind van de oorlog kreeg de stad het nog zwaar te verduren. Britse vliegtuigen bombardeerden het centrum van de stad. De nog aanwezige Duitse troepen bleven zich tot het laatste moment verdedigen. Tijdens de bombardementen kwamen 180 mensen om en werd de historische binnenstad verwoest. Op 1 april bereikte het Canadese leger vanuit Gaanderen de oostzijde van Doetinchem en op 2 april werd de stad bevrijd."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
