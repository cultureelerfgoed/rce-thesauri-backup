    dcterms:created "2019-11-08T15:00:57.000Z"^^xsd:dateTime;
    skos:prefLabel "D.N.B."@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het illegale blad D.N.B. werd uitgegeven in Haarlem. De titel was vermoedelijk een imitatie van de afkorting van Deutsches Nachrichten Büro."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8747> a <http://schema.org/Thing>, skos:Concept;
