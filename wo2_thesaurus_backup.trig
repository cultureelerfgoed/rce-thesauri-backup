    <http://schema.org/location> "Rhenen"@nl;
    <http://schema.org/startDate> "1944-11-20"^^xsd:date;
    dcterms:source "https://www.tracesofwar.nl/sights/57583/Herdenkingskruis-Rhenen.htm"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/9271>;
    dcterms:created "2020-09-30T12:36:02.000Z"^^xsd:dateTime;
    skos:prefLabel "Fusillade in Rhenen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Fusillade in Rhenen vond plaats op 20 november 1944. Aan de Veenendaalsestraatweg in Rhenen werden zes verzetsmensen gefusilleerd door een vuurpeloton van het Marine Artillerie Zeugamt. Twee dagen eerder had er tussen Rhenen en Veenendaal een vuurgevecht plaatsgevonden, waarbij een Duitse onderofficier zwaar gewond was geraakt. De fusillade van zes verzetsmensen uit de strafgevangenissen van Amsterdam en Utrecht was bedoeld als een represaille-actie."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9550> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:27:53.400Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/10450>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/3/37/Monument_Groeperkade_Renswoude.JPG/1280px-Monument_Groeperkade_Renswoude.JPG";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/w/index.php?title=File:Monument_Groeperkade_Renswoude.JPG&oldid=642505687"@nl;
    <http://schema.org/location> "Renswoude"@nl;
    <http://schema.org/startDate> "1944-11-14"^^xsd:date;
    dcterms:source "https://www.tracesofwar.nl/sights/546/Verzetskruis-Monument.htm"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/9271>;
    dcterms:created "2020-09-30T12:41:30.000Z"^^xsd:dateTime;
    skos:prefLabel "Fusillade in Renswoude"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Fusillade in Renswoude vond plaats op 14 november 1944. Vijf verzetsmensen werden op de Groeperkade door de bezetter gefusilleerd. De fusillade was een represaille voor een overval op een Duitse soldaat op de Groeperkade drie dagen eerder. De Duitse soldaat raakte gewond maar overleefde de aanslag. De vijf verzetsmensen werden uit de gevangenis in Utrecht gehaald."@nl .
  
