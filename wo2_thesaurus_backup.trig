      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    dcterms:references "Witsen, E. van - Krijgsgevangenen in de Pacific-oorlog, 1971, pg 83, 247"@nl,
      "Veen, Arie J. - Militaire politie in Nederlands-Indië, 1997, pg 31"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/b7354d29-49d5-4fe0-922a-3f3b5929fa84>;
