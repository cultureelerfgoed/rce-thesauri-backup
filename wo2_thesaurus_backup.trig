    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-05-20T13:19:27.286Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1938-09-01"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/download/default/31bdfa5e-0f28-d99d-d1d0-dccfc38bfd53.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/e0a3604a-0259-11e7-904b-d89d6717b464/media/31bdfa5e-0f28-d99d-d1d0-dccfc38bfd53";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <http://hdl.handle.net/10934/RM0001.COLLECT.447776>,
      <https://beeldbankwo2.nl/nl/beelden/detail/b782549a-025a-11e7-904b-d89d6717b464/media/5e2452be-da61-cfcb-d085-9d9c8e08fc44>,
      <https://beeldbankwo2.nl/nl/beelden/detail/2d0951c4-025a-11e7-904b-d89d6717b464/media/e2bbb806-c916-f2e8-5752-9056b462cf66>,
      <https://beeldbankwo2.nl/nl/beelden/detail/aed9f302-025a-11e7-904b-d89d6717b464/media/4bfa35ed-c9b4-97da-7526-63231cacd41e>,
      <https://beeldbankwo2.nl/nl/beelden/detail/b919a174-0259-11e7-904b-d89d6717b464/media/bf517f15-9208-14bb-19c5-030eed29b122>,
      <https://geheugen.delpher.nl/nl/geheugen/view?coll=ngvn&identifier=EVDO02:NIOD05_3967>,
      <https://geheugen.delpher.nl/nl/geheugen/view?coll=ngvn&identifier=EVDO02:NIOD05_6868>;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-06"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Nationaal-Socialistische Vrouwenorganisatie (NSVO) was de vrouwenorganisatie van de Nationaal-Socialistische Beweging (NSB). Het doel van de NSVO was het door voorlichting bevorderen van nationaalsocialistisch gedachtegoed onder vrouwen. Moederschap en gezinsverzorging kregen hierbij veel aandacht, net als de nazistische rassenleer. De NSVO was ook betrokken bij fondsenwerving en zamelde spullen in voor NSB’ers die aan het front vochten. Ongeveer 20.000 vrouwen waren lid van de NSVO."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/events/9106>, <https://data.niod.nl/WO2_Thesaurus/events/9112>,
      <https://data.niod.nl/WO2_Thesaurus/events/9113>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2244>, <https://data.niod.nl/WO2_Thesaurus/2794>;
    dcterms:created "2016-10-04T13:07:40.000Z"^^xsd:dateTime;
    skos:prefLabel "Nationaal-Socialistische Vrouwen Organisatie"@nl, "'NSVO'"@de, "'NSVO'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Nationaal-Socialistische Vrouwenorganisatie (NSVO) werd opgericht op 1 september 1938 en was een nevenorganisatie van de NSB. Het doel van de NSVO was het bevorderen van de nationaalsocialistische wereldbeschouwing onder vrouwen en het ondersteunen van de leden. De NSVO richtte zich vooral op zaken als vorming en voorlichting. Behalve voorbereiding op het moederschap en gezinsverzorging, behoorde daartoe in de oorlog ook rassenleer en rassenhygiëne. Hiernaast verrichtte de NSVO taken op het gebied van frontzorg. "@nl;
    skos:altLabel "N.S.V.O."@nl, "Nationaal Socialistische Vrouwen Organisatie"@nl, "NSVO"@nl,
      "Nationaal-Socialistische Vrouwenorganisatie"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/locations/8002>, <https://data.niod.nl/WO2_Thesaurus/19900>,
      <https://data.niod.nl/WO2_Thesaurus/19910>, <https://data.niod.nl/WO2_Thesaurus/19911>,
      <https://data.niod.nl/WO2_Thesaurus/19912>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
