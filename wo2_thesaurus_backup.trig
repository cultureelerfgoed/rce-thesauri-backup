    skos:prefLabel "Internierungslager (Japanische Besatzung)"@de, "Internment camps (Japanese occupation)"@en,
      "Interneringskampen (Japanse bezetting)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Interneringskampen (Japanse bezetting) zijn kampen in Zuidoost-Azië waar Europese en Indo-Europese burgers tijdens de Tweede Wereldoorlog door Japan werden opgesloten. Mannen, jongens en vrouwen werden meestal van elkaar gescheiden, maar ook samen geïnterneerd."@nl;
    skos:altLabel "Jappenkampen"@nl, "Japanse concentratiekampen"@nl, "Japanse interneringskampen"@nl,
      "Japanse burgerkampen"@nl, "Japanse burgerlijke interneringskampen"@nl, "Japanse burgerinterneringskampen"@nl;
