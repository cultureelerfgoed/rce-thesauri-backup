    skos:prefLabel "Stalag IV-G"@nl, "Stalag IV-G"@de, "Stalag IV-G"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Stalag IV-G was een Duits krijgsgevangenkamp in Oschatz, Duitsland. Het kamp werd in februari 1941 in gebruik genomen en had twee locaties. Het hoofdkwartier bevond zich in Oschatz en het manschappenverblijf was gevestigd in de Spinnerei Marthaus. De gevangenen werden via Arbeitskommandos te werk gesteld in de landbouw, bosbouw en industrie. Er zaten vooral Amerikaanse en Britse krijgsgevangenen, maar ook Nederlanders. Het gebied rond Oschatz was een van de laatste die aan het eind van de oorlog werd bevrijd."@nl;
    skos:altLabel "Stalag IV G"@nl, "Stalag IV-G Oschatz"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/6435> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "50.91889"^^xsd:float;
    <http://www.w3.org/2003/01/geo/wgs84_pos#long> "14.05667"^^xsd:float;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:35:21.033Z"^^xsd:dateTime;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/6407>;
    dcterms:created "2018-07-13T09:03:02.000Z"^^xsd:dateTime;
    skos:prefLabel "Oflag IV-B"@nl, "Oflag IV-B"@de, "Oflag IV-B"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Oflag IV-B was een Duits krijgsgevangenkamp voor geallieerde officieren in vesting Königstein, Duitsland. Het werd in gebruik genomen na de invasie van Polen in 1939. Op 8 mei 1945 werd het overgegeven aan de Franse generaal Condé. "@nl;
    skos:altLabel "Oflag IV B"@nl, "Oflag IV-B Koenigstein"@nl, "Oflag IV-B Königstein"@nl .
  
