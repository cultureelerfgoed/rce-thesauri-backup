    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://studiezaal.erfgoedhuisweert.nl/detail.php?id=223375734";
    <http://schema.org/startDate> "1944-06-21"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2666>;
    dcterms:created "2021-02-10T15:49:42.451Z"^^xsd:dateTime;
    skos:prefLabel "Verraad van Weert"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Het Verraad van Weert vond plaats op 21 juni 1944, toen tijdens een vergadering van de Landelijke Organisatie voor Hulp aan Onderduikers in het klooster Saint Louis in Weert een aantal Limburgse verzetsmensen werd opgepakt, onder wie Jac Naus, Jan Willem Berix, Jan Hendrikx, Guus Hermans, W.H.M. Jansen en Jacques Knops. Ze waren verraden door de verzetsman Bob Jesse, die na zijn arrestatie op 16 juni 1944 tijdens verhoor doorsloeg."@nl .
  
