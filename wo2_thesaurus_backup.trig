    dcterms:created "2020-09-23T09:33:03.000Z"^^xsd:dateTime;
    skos:prefLabel "Fusillade bij Sint Nicolaasga"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 19 september 1944 werden door de bezetter drie verzetsmensen bij Sint Nicolaasga gefusilleerd. Dit was een represaille voor een actie van de plaatselijke Knokploeg die samenhing met de landelijke spoorwegstaking die op 17 september 1944 werd afgekondigd. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/5104> .
  
