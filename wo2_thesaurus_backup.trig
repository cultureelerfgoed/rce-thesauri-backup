    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het Sint Jacobus Gesticht in Eersel ving vanaf de lente van 1939 Joodse vluchtelingenkinderen op in hun gezondheidshuis."@nl .
  
