    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Oflag XI-B was een Duits krijgsgevangenkamp in Braunschweig, Duitsland, waar Poolse officieren zaten. Het kamp was tussen 1939 en juni 1940 in gebruik. Daarna werden de gevanenen naar Oflag VIb overgebracht. "@nl;
    skos:altLabel "Oflag XI B"@nl, "Oflag XI-B Braunschweig"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/6484> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "52.8561333"^^xsd:float;
    <http://www.w3.org/2003/01/geo/wgs84_pos#long> "9.7338744"^^xsd:float;
