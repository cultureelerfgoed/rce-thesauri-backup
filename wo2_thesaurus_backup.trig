    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/9/9a/Centraal_Israelitisch_Wees-_en_Doorgangshuis_Leiden.jpg/1280px-Centraal_Israelitisch_Wees-_en_Doorgangshuis_Leiden.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/w/index.php?title=Centraal_Isra%C3%ABlitisch_Wees-_en_Doorgangshuis_(Leiden)&oldid=54256678#/media/Bestand:Centraal_Israelitisch_Wees-_en_Doorgangshuis_Leiden.jpg"@nl;
