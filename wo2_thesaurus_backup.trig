    skos:prefLabel "Ginkelse Heide"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "De Ginkelse Heide bij Ede was een belangrijke plek voor de geallieerde luchtlandingen tijdens operatie Market Garden. Hier stonden de geallieerden tegenover Nederlandse Waffen-SS'ers."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
