  <https://data.niod.nl/WO2_Thesaurus/11205> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-08-03T11:11:33.120Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/9b6169e2-1c2d-be8f-edaf-c3e4df45f2e7.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/f8c602ee-025a-11e7-904b-d89d6717b464/media/9b6169e2-1c2d-be8f-edaf-c3e4df45f2e7";
    dcterms:source "https://nl.wikipedia.org/wiki/Zigeunervervolging"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2788>;
    dcterms:created "2021-03-17T09:08:50.606Z"^^xsd:dateTime;
    skos:prefLabel "Porajmos"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De zigeunervervolging, ook wel Porajmos genoemd, was de vervolging en genocide van Sinti en Roma in de Tweede Wereldoorlog. De nazi's beschouwden de Roma als asociaal, crimineel en niet-Arisch. De vervolging en vernietiging kwam later op gang, maar verliep vrijwel identiek aan de Jodenvervolging: na concentratie in getto's werden ze vanuit daar naar concentratie- en vernietigingskampen gedeporteerd. In Nederland gebeurde dit met de Zigeunerrazzia van 16 mei 1944, waarbij Sinti en Roma via Kamp Westerbork naar Auschwitz werden gedeporteerd."@nl;
    skos:altLabel "Zigeunervervolging"@nl .
  
