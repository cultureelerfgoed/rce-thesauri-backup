    skos:prefLabel "Razzia van Den Haag"@nl, "Raid on Den Haag"@en, "Razzia Den Haag"@de;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Razzia van Den Haag, Rijswijk en Voorburg, onder de codenaam Operatie Sneeuwvlok, vond plaats op 21 november 1944. Er werden ongeveer 13.000 mannen opgepakt en afgevoerd in het kader van de Arbeidsinzet."@nl;
    skos:altLabel "Razzia van Den Haag, Rijswijk en Voorburg"@nl, "Operatie Sneeuwvlok"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
