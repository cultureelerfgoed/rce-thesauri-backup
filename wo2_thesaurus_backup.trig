    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2860>, <https://data.niod.nl/WO2_Thesaurus/corporaties/8581>;
    dcterms:created "2018-10-04T13:21:46.000Z"^^xsd:dateTime;
    skos:prefLabel "Zweeds wittebrood"@nl, "Schwedisches Weissbrot"@de, "Swedish white bread"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Zweeds wittebrood is de benaming van het brood, waarvan het meel tussen 28 januari 1945 en 1 april 1945 via de haven van Delfzijl werd aangevoerd door drie schepen van het Zweedse Rode Kruis (de Noreg, de Dagmar Bratt en de Hallaren). Van het meel werd vervolgens door lokale bakkers brood gebakken, maar vanwege transportproblemen bereikte deze voedselhulp de stedelijke bevolking van westelijk Nederland pas vanaf februari."@nl;
    skos:altLabel "Zweedse wittebrood"@nl, "Rode Kruis-zendingen"@nl, "Rode Kruis zendingen"@nl,
      "Zweedsche wittebrood"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4665> .
  
