    dcterms:references "Ad van Liempt, Kopgeld. Nederlandse premiejagers op zoek naar joden, 1943 (Amsterdam: Balans, 2002)"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    dcterms:modified "2024-10-24T09:08:55.983Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/250x250/88122238-2c6c-7aa1-818e-e65a1c3c3f5a.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://beeldbankwo2.nl/nl/beelden/detail/d1d36b3c-0259-11e7-904b-d89d6717b464/media/88122238-2c6c-7aa1-818e-e65a1c3c3f5a";
