    dcterms:references "Oorlogsverhalen uit Austerlitz. Geschreven door verhalenvangers van basisschool Pirapoleon. Uitgave in kader van 75 jaar Vrijheid."@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
