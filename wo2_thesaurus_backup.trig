    <https://data.niod.nl/organizationsWO2/endDate> "1941-01-01"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Nationaal-Socialistische Nederlandsche Arbeiderspartij-Kruyt (NSNAP-Kruyt) was een nationaalsocialistische politieke partij die in 1933 werd opgericht door Cornelis Jacobus Aart Kruyt. De NSNAP-Kruyt ontstond na het uiteenvallen van de Nationaal-Socialistische Nederlandsche Arbeiderspartij (NSNAP). In 1941 werd de partij op Duits bevel opgenomen in de Nationaal-Socialistische Beweging (NSB)."@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4620>;
    dcterms:created "2018-01-18T19:06:11.000Z"^^xsd:dateTime;
    skos:prefLabel "N.S.N.A.P. Kruyt"@nl, "'NSNAP Kruyt'"@de, "'NSNAP Kruyt'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De NSNAP-Kruyt ontstond op 30 juli 1933 toen de gepensioneerde majoor Cornelis Jacobus Aart Kruyt ‘Rijksleider’ werd van een van de verschillende nazipartijtjes die zich allen tooiden met de naam Nationaal-Socialistische Nederlandsche Arbeiderspartij (NSNAP). De NSNAP-Kruyt was fel antisemitisch en wilde de bevolking van West-Indië deporteren om te vervangen door Nederlanders. Bij de verkiezingen van 1937 kreeg de partij slechts 998 stemmen, oftewel 0,03%. De NSNAP-Kruyt werd gekenmerkt door wanbestuur en afsplitsingen. In december 1940 kreeg Kruyt opdracht van de Duitsers om zijn partijtje in de NSB te doen opgaan."@nl;
    skos:altLabel "N.S.N.A.P. Kruijt"@nl, "N.S.N.A.P.-Kruyt"@nl, "Nationaal-Socialistische Nederlandsche Arbeiderspartij Kruyt"@nl,
      "Nationaal-Socialistische Nederlandsche Arbeiderspartij-Kruyt"@nl, "N.S.N.A.P. (Majoor Kruyt)"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
