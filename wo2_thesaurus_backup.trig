    dcterms:created "2021-10-06T14:19:36.054Z"^^xsd:dateTime;
    skos:prefLabel "Algemene mobilisatie afgekondigd in Limburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Bij de afkondiging van de algemene mobilisatie op 28 augustus 1939 worden in Limburg de twee belangrijkste verdedigingslinies - de Maaslinie en de Peel-Raamstelling - in een hogere staat van paraatheid gebracht. Bij de Peel-Raamstelling vinden inundaties plaats. Bij strategisch belangrijke bruggen worden explosieven aangebracht. Ook worden de grensposten versterkt."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2338>, <https://data.niod.nl/WO2_Thesaurus/events/6729>,
      <https://data.niod.nl/WO2_Thesaurus/events/6647> .
  
