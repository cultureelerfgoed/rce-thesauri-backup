    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://archief.amsterdam/beeldbank/detail/05fd6e66-5b5a-2948-c72a-c755107e33a7"@nl;
    dcterms:source "https://www.makveilingen.nl/category/geschiedenis https://rkd.nl/collections/573"@nl;
