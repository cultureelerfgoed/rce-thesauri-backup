    dcterms:created "2020-09-22T11:17:48.000Z"^^xsd:dateTime;
    skos:prefLabel "Fusillade in Bergschenhoek"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 7 januari 1945 werden tien Nederlandse mannen op de Bergweg-zuid in Bergschenhoek door de bezetter gefusilleerd. Het was een vergeldingsactie omdat op dezelfde plaats op 6 januari 1945 een Duitse militair door een onbekende man werd doodgeschoten. De dader was gevlucht richting Rotterdam en nooit gevonden.  "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9492> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
