    dcterms:references "J. Brauer, ‘‘Willkommen in Holland!’ De opvang van Joodse vluchtelingen in Nijmegen 1933-1940’, in: Jaarboek Numaga 65 (2018), p. 102-121."@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/ravend>;
