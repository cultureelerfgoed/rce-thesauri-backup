    <https://data.niod.nl/organizationsWO2/startDate> "1941-03-03"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/7f5affd7-7f53-a920-4843-0bed94553644.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/2d0a1e10-025a-11e7-904b-d89d6717b464/media/7f5affd7-7f53-a920-4843-0bed94553644";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/6c5a6458-025a-11e7-904b-d89d6717b464/media/1681bbf9-e1d2-dfc5-296a-0c6504498871>;
    dcterms:source "https://www.archieven.nl/nl/zoeken?mivast=0&mizig=210&miadt=298&miaet=1&micode=001&minr=958567&miview=inv2"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1943-07-31"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Westdeutscher Wach- und Schutzdienst was een Duitse particuliere bewakingsdienst die vanaf 1941 vliegvelden en installaties van de Wehrmacht, het Duitse leger, in Nederland bewaakte. Ongeveer 550 Nederlanders waren in dienst bij de Wach- und Schutzdienst, voornamelijk leden van de Nationaal-Socialistische Beweging (NSB). Op 1 augustus 1943 ging de Wach- und Schutzdienst op in de militaire bewakingsdienst Wachabteilung des Chefintendanten beim Wehrmachtsbefehlshaber in den Niederlanden."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/20719>;
    dcterms:created "2023-05-11T14:45:48.342Z"^^xsd:dateTime;
    skos:prefLabel "Westdeutscher Wach- und Schutzdienst"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Westdeutscher Wach- und Schutzdienst werd op 3 maart 1941 opgericht en stond onder leiding van de Duitser Fritz Kötter. Het doel van deze in Amsterdam gevestigde civiele bewakingsdienst was het bewaken van Wehrmachtsobjecten, waarvoor een contract was afgesloten met het Luftgau Kommando Holland. Nadat het oorspronkelijk aangetrokken personeel weinig gemotiveerd bleek te zijn, ging de Westdeutscher Wach- und Schutzdienst ertoe over hoofdzakelijk NSB’ers te werven. De Westdeutscher Wach- und Schutzdienst werd op 31 juli 1943 ontbonden nadat het Lufgau Kommando Holland het contract opzegde. Het personeel, dat met een geweer gewapend was, ging gedeeltelijk over naar de Wachabteilung des Chefintendanten beim Wehrmachtsbefehlshaber in den Niederlanden."@nl;
    skos:altLabel "Wach- und Schutzdienst"@nl, "Wach und Schutzdienst"@nl, "Wach & Schutzdienst"@nl,
      "Wach en Schutzdienst"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
