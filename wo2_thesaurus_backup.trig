    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Arbeidsbureau&oldid=51136082"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Gewestelijke Arbeidsbureaus waren overheidsinstellingen die uitkeringen uitbetaalden en werklozen aan werk hielpen in Nederland en Duitsland. Eerst was dit de taak van de Nederlandse Gemeentelijke Arbeidsbeurzen. Vanaf mei 1941 werden ze hernoemd tot Gewestelijke Arbeidsbureaus en kwamen ze onder Duits toezicht. Tewerkstelling in Duitsland was in eerste instantie op vrijwillige basis, maar vanaf mei 1942 waren de Gewestelijke Arbeidsbureaus verplicht om Nederlandse arbeiders voor de Arbeitseinsatz te leveren."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/demoadmin>;
