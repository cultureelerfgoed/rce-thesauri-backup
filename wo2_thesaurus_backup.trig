    dcterms:created "2021-12-01T13:51:29.169Z"^^xsd:dateTime;
    skos:prefLabel "Kinsayok"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Kinsayok was een krijgsgevangenkamp dat op 171 km van Non Pladuk lag, het basiskamp van de Birma-spoorlijn. Kinsayok werd in 1943 opgebouwd en bestond uit een werkkamp, een hospitaalkamp en een cholera-kamp. Toen het werk aan de Birma-spoorlijn in dit kamp voltooid was werd het werkkamp als doorgangskamp gebruikt. "@nl;
    skos:altLabel "Kim Sayok"@nl, "King Sayo"@nl, "Kansayo"@nl, "Sai Yok"@nl, "Sayok"@nl .
  
