  <https://data.niod.nl/WO2_Thesaurus/corporaties/5153> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "Nationaal Archief"@nl, "M.H. Severein, Alles is gedaan om het recht te vinden. Bijzondere rechtspleging in Leeuwarden 1945-1949 (Hilversum: Uitgeverij Verloren, 2017), 61"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    dcterms:modified "2025-09-16T09:41:56.082Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://service.archief.nl/gaf/api/file/v1/default/b5ea040c-fc49-4905-a776-8b83a23ddc8f"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://hdl.handle.net/10648/a88773f4-d0b4-102d-bcf8-003048976d84"@nl;
    dcterms:source "https://www.nationaalarchief.nl/onderzoeken/archief/2.09.42.02"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Het Bureau Bijzondere Jeugdzorg (BBJ) zorgde voor de begeleiding en opvang in tehuizen en pleeggezinnen van kinderen van wie de ouders veroordeeld waren voor collaboratie. Minderjarige verdachten van collaboratie werden ook enige tijd begeleid door het BBJ."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1576>, <https://data.niod.nl/WO2_Thesaurus/19586>,
      <https://data.niod.nl/WO2_Thesaurus/20713>;
    dcterms:created "2017-04-05T11:45:58.000Z"^^xsd:dateTime;
    skos:prefLabel "Bureau Bijzondere Jeugdzorg"@nl, "'Bureau Bijzondere Jeugdzorg'"@de,
      "'Bureau Bijzondere Jeugdzorg'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "Het Bureau Bijzondere Jeugdzorg (BBJ) werd opgericht op 1 november 1945 door het Militair Gezag en opgeheven in maart 1949. Het hield zich bezig met de registratie, verzorging, begeleiding en re-integratie in de samenleving van kinderen van mensen die verdacht werden van collaboratie, landverraad en oorlogsmisdaden en berecht werden in de Bijzondere Rechtspleging. Eventueel werden kinderen in een pleeggezin geplaatst. Vanaf november 1945 viel het BBJ onder het Ministerie van Justitie."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization>;
    skos:hiddenLabel "BBJ"@nl .
  
