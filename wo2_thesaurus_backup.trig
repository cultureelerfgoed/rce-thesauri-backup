    skos:prefLabel "Kringleidster"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De kringleidster was de functionaris binnen Nationaal-Socialistische Vrouwenorganisatie (NSVO) die leiding had over een lokale kring, bestaande uit verschillende groepen. Zij stuurde de groepsleiders in haar kring aan. De territoriale indeling van de NSVO in groepen, kringen en districten liep parallel aan die van de NSB en kende dezelfde hiërarchische structuur."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4621> .
  
  <https://data.niod.nl/WO2_Thesaurus/19911> a <http://schema.org/Thing>, skos:Concept;
