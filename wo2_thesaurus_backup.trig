    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> <https://imageviewer.kb.nl/ImagingService/imagingService?id=MMKB08:000196585:mpeg21:p057:image&w=500>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://resolver.kb.nl/resolve?urn=MMKB08:000196585:mpeg21:a0006";
    <http://schema.org/description> "De Nederlandsche Coöperatieve Raad werd op 20 maart 1942 ingesteld bij besluit van de secretarissen-generaal van Landbouw en Visscherij en van Handel, Nijverheid en Scheepvaart (VO 36/42), en was bedoeld als toporganisatie voor coöperatieve verenigingen op het gebied van de voedselvoorziening. De raad nam de taken over van de Nationale Coöperatieve Raad, die werd geliquideerd. De raad had tot taak de gemeenschappelijke belangen te behartigen van de coöperatieve verenigingen en centrale organisaties, die alle verplicht waren zich bij deze toporganisatie aan te sluiten. De raad had onder meer de bevoegdheid controle uit te oefenen op de boekhouding en het financieel beleid, als ook om in bepaalde gevallen coöperatieve verenigingen te ontbinden, zulks behoudens toestemming van de secretaris-generaal van Landbouw en Visscherij. Het algemeen toezicht op de Nederlandsche Coöperatieve Raad werd uitgeoefend door genoemde secretaris-generaal, door wie tevens de statuten werden vastgesteld."@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2751>, <https://data.niod.nl/WO2_Thesaurus/1758>;
    dcterms:created "2017-03-10T19:57:42.000Z"^^xsd:dateTime;
    skos:prefLabel "Nederlandsche Coöperatieve Raad"@nl, "'Nederlandsche Coöperatieve Raad'"@de,
      "'Nederlandse Coöperatieve Raad'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Nederlandsche Coöperatieve Raad werd op 20 maart 1942 ingesteld en had tot taak de behartiging van de gemeenschappelijke belangen van de coöperatieve verenigingen en centrale organisaties op het gebied van de voedselvoorziening. De raad had onder meer de bevoegdheid controle uit te oefenen op boekhouding en financieel beleid van de organisaties en verenigingen."@nl;
    skos:altLabel "Nederlandse Coöperatieve Raad"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
