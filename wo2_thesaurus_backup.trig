    dcterms:modified "2020-09-01T10:12:35.000Z"^^xsd:dateTime;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>;
    dcterms:created "2019-11-07T15:12:58.000Z"^^xsd:dateTime;
    skos:prefLabel "De Blaozepiepe"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het illegale blad De Blaozepiepe werd van oktober 1944 tot december 1944 uitgegeven in Eibergen (Achterhoek, Gelderland) door Trouw-drukker J. Smits toen deze na Dolle Dinsdag enige tijd het contact kwijt was met de leiding van Trouw."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8699> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "PPN: 268962626"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2019-11-18T14:34:16.000Z"^^xsd:dateTime;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Wikipedia:Wikiproject/Verzetskranten/Beginnetjes/Het_Bloemendaalse_weekblad:_uitgave_van_Herrijzend_Bloemendaal_(verzetsblad,_Bloemendaal)&oldid=47013594"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>;
    dcterms:created "2019-11-07T15:14:42.000Z"^^xsd:dateTime;
    skos:prefLabel "Het Bloemendaalse weekblad: uitgave van Herrijzend Bloemendaal"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het Bloemendaalse weekblad: uitgave van Herrijzend Bloemendaal was een verzetsblad dat van 19 januari 1945 tot 6 mei 1945 wekelijks verscheen in een oplage van circa 250 stuks. Het blad, dat inging op lokale bijzonderheden te Bloemendaal, werd uitgebracht naast De Vrije Pers en voor het drukken werd gebruikt gemaakt van de apparatuur van De Vrije Pers. Na de bezetting ging het blad legaal verder met de titel: Ons Gemeenteblad."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8700> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "PPN : 269050205"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2020-09-01T11:18:07.000Z"^^xsd:dateTime;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>;
    dcterms:created "2019-11-07T15:16:41.000Z"^^xsd:dateTime;
    skos:prefLabel "De bosgeus; 'en tout fidelles au roy jusques à la besace'"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het illegale blad De Bosgeus werd van eind 1941 tot begin 1942 uitgegeven in Groningen door C. Spaans, W. Heystra, L. de Vries en J. Roos, leerlingen van de Zeevaartschool te Groningen. Het blad eindigde met de arrestatie van de makers wegens allerlei illegale werkzaamheden. Spaans werd op 24 juni 1943 gefusilleerd en De Vries is in het concentratiekamp Natzweiler overleden."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8701> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "PPN: 268964912"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2021-03-22T13:28:21.432Z"^^xsd:dateTime;
    dcterms:source "https://upload.wikimedia.org/wikipedia/commons/2/23/PDF_of_De_Ondergrondse_Pers_1940-1945_-_derde_druk_-_1989.pdf"@nl,
      "https://nl.wikipedia.org/w/index.php?title=Willem_Arondeus&oldid=54333388"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>;
    dcterms:created "2019-11-07T15:31:57.000Z"^^xsd:dateTime;
    skos:prefLabel "De Brandarisbrief"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Brandarisbrief was een verzetsblad uitgegeven door verzetsstrijder Willem Arondeus te Amsterdam. Hij riep kunstenaars op zich te verzetten tegen de bezetter. In mei 1942 werd verzetsblad  De Vrije Kunstenaar; religieus en politiek onafhankelijk orgaan van de Nederlandsche kunstenaars, waarin opgenomen de Brandarisbrief opgericht, welk blad met een oplage van 3000 tot 5000 stuks tot mei 1945 maandelijks verscheen."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8702> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "PPN: 047422262"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2019-11-18T15:03:01.000Z"^^xsd:dateTime;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Wikipedia:Wikiproject/Verzetskranten/Beginnetjes/Branding;_orgaan_voor_Jong-Nederland_(verzetsblad,_Den_Haag)&oldid=46516838"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>;
    dcterms:created "2019-11-07T15:35:17.000Z"^^xsd:dateTime;
    skos:prefLabel "Branding; orgaan voor Jong-Nederland"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote """Branding; orgaan voor Jong-Nederland was een verzetsblad dat met een oplage van 100 tot 600 stuks vanaf 1 februari 1945 tot mei 1945 dagelijks werd uitgegeven in Den Haag. Aanvankelijk bestond het blad uit nieuws van Radio Oranje, maar later kwamen daar ook artikelen bij speciaal voor jongeren van 17 tot 20 jaar. 
"""@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8703> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "Lydia E. Winkel; De Ondergrondse Pers 1940-1945, 3e herziene druk door Drs. Hans de Vries. "@nl,
      "PPN: 852762003"@nl;
