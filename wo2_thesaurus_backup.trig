    skos:prefLabel "'Stijkel-groep'"@de, "'Stijkel-groep'"@en, "Stijkel-groep"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote """De Stijkelgroep was een verzetsgroep in het westen van het land onder leiding van J.A. Stijkel. De groep legde zich toe op het bedrijven van spionage. Verschillende zelfstandig opererende verzetsgroepen werden bij de verzetsactiviteiten van de Stijkelgroep ingeschakeld. Door verraad werd de groep opgerold. Samen met 32 andere verzetsmannen werd Stijkel op 4 juni 1943 gefusilleerd in de gevangenis Berlijn-Tegel.
Bron: Wikipedia"""@nl;
    skos:altLabel "Stijkelgroep"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/6054>;
