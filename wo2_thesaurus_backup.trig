    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/19853>;
    dcterms:created "2023-08-31T08:23:01.532Z"^^xsd:dateTime;
    skos:prefLabel "Kommandeur"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De rang Kommandeur was de hoogste rang in de Nederlandsche Landwacht. Op voorstel van Rauter wijzigde Himmler begin 1945 eerst de titel van inspecteur-generaal in kommandeur en kende hij vervolgens aan Kees van Geelkerken de rang van Landwacht-Oberführer toe."@nl;
    skos:altLabel "Kommandeur van de Nederlandsche Landwacht"@nl, "Kommandeur der Nederlandsche Landwacht"@nl,
      "Kommandeur Nederlandsche Landwacht"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2249> .
  
