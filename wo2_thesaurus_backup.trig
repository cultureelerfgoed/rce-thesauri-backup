    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/w/index.php?title=Vervolgoorlog&oldid=54520500#/media/Bestand:Continuation-War-1941.png"@nl;
    <http://schema.org/startDate> "1944-09-19"^^xsd:date;
    <http://schema.org/endDate> "1941-06-25"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Vervolgoorlog&oldid=54520500"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3558>;
    dcterms:created "2020-09-11T08:13:04.000Z"^^xsd:dateTime;
    skos:prefLabel "Vervolgoorlog"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Vervolgoorlog was de Finse deelname aan de Tweede Wereldoorlog als bondgenoot van nazi-Duitsland. De strijd tegen het Sovjetleger vond plaats van 25 juni 1941 tot 19 september 1944 met het doel om de gebieden die in de Winteroorlog waren geannexeerd terug te krijgen. "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9413> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2020-09-15T07:42:24.000Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/d/d2/The_War_in_Finland%2C_1940_HU55566.jpg/500px-The_War_in_Finland%2C_1940_HU55566.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/w/index.php?title=Winteroorlog&oldid=56611468#/media/Bestand:The_War_in_Finland,_1940_HU55566.jpg"@nl;
    <http://schema.org/startDate> "1939-11-30"^^xsd:date;
    <http://schema.org/endDate> "1940-03-13"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Winteroorlog&oldid=56611468"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/events/9415>, <https://data.niod.nl/WO2_Thesaurus/events/9419>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3558>;
    dcterms:created "2020-09-11T08:19:18.000Z"^^xsd:dateTime;
    skos:prefLabel "De Winteroorlog"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Winteroorlog was een militaire campagne van de Sovjet-Unie tegen Finland van 30 november 1939 tot 13 maart 1940. De Sovjet-Unie kreeg wat zij eisten: Finland stond een aantal gebieden af, waaronder de eilanden in de Finse Golf, de marine- en luchtmachtbasis bij Hanko zou voor dertig jaar van de Sovjet-Unie zijn en er zou een verdrag worden gesloten ter verdediging van de Finse Golf. Als vergoeding voor deze offers bood Moskou een 'rechttrekking' van de grens bij Karelië aan."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9414> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2021-06-29T16:55:04.498Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/16956>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/c/cc/Voitto-lapissa-2.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/w/index.php?title=Laplandoorlog&oldid=55860339#/media/Bestand:Voitto-lapissa-2.jpg"@nl;
    <http://schema.org/startDate> "1944-09-15"^^xsd:date;
    <http://schema.org/endDate> "1945-04-25"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Laplandoorlog&oldid=55860339"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3558>;
    dcterms:created "2020-09-11T09:21:02.000Z"^^xsd:dateTime;
    skos:prefLabel "De Laplandoorlog"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Laplandoorlog was de strijd tussen Finland en nazi-Duitsland, die speelde vanaf september 1944 tot april 1945. Het noordelijkste landschap van Finland was het strijdtoneel, waardoor het de naam 'Laplandoorlog' kreeg. Al in de zomer van 1943 begon de Duitse legertop plannen te maken voor de situatie die zou ontstaan als Finland een afzonderlijke vrede zou sluiten met de Sovjet-Unie. In augustus 1944 is het zo ver en sloten de Sovjet-Unie en Finland een vredesverdrag, waarbij de Finnen als voorwaarde de resterende Duitse troepen van hun grondgebied moesten verdrijven. De Duitsers, die kwaad waren over dit verraad, zetten als reactie het Finse Lapland in brand."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9415> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2021-06-29T17:11:54.348Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/16961>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/0/02/Raate_road.jpg/500px-Raate_road.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Slag_bij_Suomussalmi#/media/Bestand:Raate_road.jpg"@nl;
    <http://schema.org/startDate> "1939-12-07"^^xsd:date;
    <http://schema.org/endDate> "1940-01-08"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Slag_bij_Suomussalmi&oldid=55847086"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/9413>;
    dcterms:created "2020-09-11T09:34:40.000Z"^^xsd:dateTime;
    skos:prefLabel "Slag bij Suomussalmi"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Slag bij Suomussalmi was een veldslag tussen de Sovjet-Unie en Finland die plaatsvond vanaf 7 december 1939 tot 8 januari 1940. Het gevecht werd als symbool beschouwd voor de Winteroorlog en betekende een overwinning voor de Finnen."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9416> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2020-09-11T09:48:21.000Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/6/69/Doppelkopf_1944.jpg/500px-Doppelkopf_1944.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/w/index.php?title=Operatie_Doppelkopf&oldid=56833653#/media/Bestand:Doppelkopf_1944.jpg"@nl;
    <http://schema.org/startDate> "1944-08-16"^^xsd:date;
    <http://schema.org/endDate> "1944-08-27"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Operatie_Doppelkopf&oldid=56833653"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/9411>;
    dcterms:created "2020-09-11T09:42:26.000Z"^^xsd:dateTime;
    skos:prefLabel "Operatie Doppelkopf"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Operatie Doppelkopf was de codenaam voor een Duits offensief in augustus 1944 in Koerland. Het Duitse leger wilde de verbinding tussen de Heeresgruppen Nord en Mitte herstellen. Daarnaast was het uit op een verovering van de strategisch belangrijke plaatsen Šiauliai in Litouwen en Jelgava in Letland. De verbinding tussen de twee Duitse troepen kon hersteld worden, maar de rest van de doelen werden niet gehaald."@nl;
    skos:altLabel "Unternehmen Doppelkopf"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9418> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
