    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Nahdlatul_Ulama&oldid=35668384"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/20702>;
    dcterms:created "2019-01-17T16:27:46.000Z"^^xsd:dateTime;
    skos:prefLabel "Nahdlatul Ulama"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Nahdlatul Ulama bestaat sinds 13 januari 1926, is opgericht door Hasyim Asy'ari en is met circa 45 miljoen leden één van de grootste onafhankelijke islamitische organisaties ter wereld. Tijdens de Japanse bezetting werd Hasyim Asy'ari opgesloten wegens zijn opstandige houding tegenover de bezetter, maar werd later vrijgelaten op voorwaarden dat zijn organisatie de Japanse zaak ging verheerlijken tegenover zijn achterban en functioneerde het als spreekbuis voor de bezetter.  "@nl;
    skos:altLabel "NU"@en;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/4382>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
