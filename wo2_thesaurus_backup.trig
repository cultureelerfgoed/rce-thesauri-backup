      "https://nl.m.wikipedia.org/wiki/Wikipedia:Wikiproject/Verzetskranten/Beginnetjes/Brieven_aan_een_jeugdvriend_(verzetsblad,_Amsterdam)"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4819>;
    dcterms:created "2019-11-08T09:04:45.000Z"^^xsd:dateTime;
    skos:prefLabel "Brieven aan een jeugdvriend"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Brieven aan een jeugdvriend was één van de verzetsbladen dat uitgegeven werd door de communistische verzetsgroep het Marx-Lenin-Luxemburg-front. Het blad, dat vanaf de zomer van 1940 tot de zomer van 1941 in een oplage van circa 800 stuk maandelijks werd uitgegeven in Amsterdam, bestond uit verdiepende opiniestukken."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8709> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "PPN: 269051961"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
