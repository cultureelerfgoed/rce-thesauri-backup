    <http://schema.org/endDate> "1941-08-13"^^xsd:date;
    skos:relatedMatch <https://data.niod.nl/WO2_biografieen/Max-de-Marchant-et-dAnsembourg>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/7753>, <https://data.niod.nl/WO2_Thesaurus/17716>;
    dcterms:created "2021-10-08T11:31:56.873Z"^^xsd:dateTime;
    skos:prefLabel "D'Ansembourg kondigt aan alle gemeenteraden in Limburg op te heffen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "In twee bijeenkomsten, op 11 en 13 augustus 1941 stelde D'Ansembourg de Limburgse burgemeesters op de hoogte van een nieuwe verordening volgens welke per 1 september alle Provinciale Staten en gemeenteraden zouden worden opgeheven. Ook spoorde hij de burgemeesters aan om meer mee te gaan in \"de Nieuwe Tijd\". Het leidde tot het opstappen van een flink aantal burgemeesters. In november 1941 had ongeveer een derde deel  van de burgemeesters in de provincie Limburg ontslag genomen."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/17716> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "R. te Slaa, 1941. Het masker valt (Amsterdam 2016)"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2023-01-31T12:40:11.471Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/bhic/thumb/1000x1000/3e67107e-2618-9dd5-7a05-d594b7af1053.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://www.bhic.nl/foto/8e76cfac-45f9-11e3-b434-8bd3de67c776";
    <http://schema.org/startDate> "1941-09-01"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/17715>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1756>;
    dcterms:created "2021-10-08T11:54:51.360Z"^^xsd:dateTime;
    skos:prefLabel "Gemeenteraden en provinciale staten opgeheven"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Op 1 september 1941 hief Seyss-Inquart de gemeenteraden, de colleges van B&W en de provinciale staten op. Wethouders en gedeputeerden werden medewerkers van de burgemeesters, respectievelijk provinciaal commissarissen. De maatregel - gebaseerd op het Duitse Führerprinzip - was aanleiding voor een groot aantal burgemeesters om hun ontslag in te dienen."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/17717> a <http://schema.org/Thing>, skos:Concept,
