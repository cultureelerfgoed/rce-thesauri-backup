    dcterms:created "2024-08-09T13:11:52.709Z"^^xsd:dateTime;
    skos:prefLabel "Haischau"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Haischau was een krijgsgevangenkamp op het eiland Hainan voor de zuidkust van China. Het kamp lag ten zuiden van de stad Basuo bij het begin van de spoorlijn naar een ijzermijn. De werkzaamheden waren o.a. de aanleg van wegen en een vliegveld, de productie van straatstenen en werk in de ijzermijn en in de haven."@nl;
    skos:altLabel "Hashio"@nl, "Hachow"@nl, "Hainan"@nl, "Hukurei"@nl, "Pak Loi"@nl, "Pakalai"@nl,
      "Haiao Ling Hainan"@nl .
  
