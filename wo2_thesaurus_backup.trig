    <http://schema.org/location> "Den Helder";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/50f381e0-025a-11e7-904b-d89d6717b464/media/2d3dbaad-835a-61b6-d9bb-ecc795f22e09>,
