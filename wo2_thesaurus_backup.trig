    skos:prefLabel "Discriminatie bij Prinses Irene Brigade"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Discriminatie bij de Prinses Irene Brigade was aan de orde onder enkele Surinaamse militairen die zich aansloten bij het leger. Zij stelden last te hebben van een neerbuigende houding van de witte militairen. Ook gaven zij aan minder kans op promotie te maken en regelmatig slachtoffer te zijn van fysieke mishandeling."@nl;
    skos:altLabel "Discriminatie Surinaamse Schutterij"@nl, "Discriminatie Surinaamse militairen"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/9220> a <http://schema.org/Thing>, skos:Concept;
