    skos:prefLabel "Tekisan Kanribu"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Tekisan Kanribu (Kantoor tot beheer van vijandig eigendom) kreeg de controle over geconfisqueerde eigendommen tijdens de Japanse bezetting van Nederlands-Indië. De Tekisan Kanribu stond onder direct gezag van de Gunseikanbu. "@nl;
    skos:altLabel "Kantoor tot Beheer van Vijandelijk Eigendom"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7787> a <http://schema.org/Thing>,
