    dcterms:source "https://www.omroepgelderland.nl/nieuws/2137895/De-aanslag-op-de-Nijmeegse-politiechef-en-jodenjager-Van-Dijk"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
