    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/c28647ca-025a-11e7-904b-d89d6717b464/media/692fe555-b5b3-5b44-2183-b8e910801e9e?mode=detail&view=horizontal&q=molenhoek&rows=1&page=7";
    dcterms:source "https://www.gelderlander.nl/nijmegen-e-o/gesneuvelden-op-begraafplaats-molenhoek-verdienen-beter-monument~af013ae2/"@nl;
