    dcterms:modified "2024-06-25T13:08:06.331Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://studiezaal.nijmegen.nl/HttpHandler/icoon.ico?icoonfromxmlbeschr=2010258529";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://studiezaal.nijmegen.nl/ran/_detail.aspx?xmldescid=2010258529";
    dcterms:source "http://www.gahetna.nl/sites/default/files/bijlagen/oorlogsgids-vraag10.pdf"@nl,
      "http://www.tweedewereldoorlog.nl/themas/dagelijks-leven/vrijheidsinperkingen/nederlandse-arbeidsdienst/ "@nl,
      "https://nl.wikipedia.org/w/index.php?title=Nederlandse_Arbeidsdienst&oldid=46947471 "@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/demoadmin>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/corporaties/5142>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2145>, <https://data.niod.nl/WO2_Thesaurus/2354>;
    dcterms:created "2016-08-01T19:19:51.000Z"^^xsd:dateTime;
    skos:prefLabel "'Arbeidsdienst'"@de, "'Arbeidsdienst'"@en, "Arbeidsdienst"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Arbeidsdienst is de verplichte dienst aan de staat gedurende een bepaalde tijd in een op militaire leest geschoeide organisatie."@nl;
    skos:altLabel "Arbeitsambt"@de;
    skos:definition "De Nederlandse Arbeidsdienst heeft als doel het Nederlandse volk op te voeden in het Nationaal-Socialistische gedachtegoed. Voorloper van de Arbeidsdienst is de Opbouwdienst, waar Nederlandse soldaten dienst in moeten nemen. In 1941 krijgt elke man een oproep om in dienst te gaan. Eerst vrijwillig, maar dat leverde weinig tot geen reacties op. Hierna wordt deelname verplicht en duiken veel mannen onder. Het werk waarvoor ze worden opgeroepen bestaat voornamelijk uit landbouwwerkzaamheden en ontginningen."@nl .
  
