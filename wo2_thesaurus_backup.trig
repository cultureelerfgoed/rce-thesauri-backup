    dcterms:modified "2024-11-07T13:45:11.611Z"^^xsd:dateTime;
    dcterms:source "https://www.japansekrijgsgevangenkampen.nl/Nakon%20Pathom.htm"@nl,
      "https://2nd4thmgb.com.au/camp/nacompaton-nakom-pathom-hospital-thailand/"@en;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/b7354d29-49d5-4fe0-922a-3f3b5929fa84>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1699>, <https://data.niod.nl/WO2_Thesaurus/19085>;
    dcterms:created "2024-08-05T19:18:48.888Z"^^xsd:dateTime;
    skos:prefLabel "Nakon Pathom"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Nakon Pathom was een krijgsgevangenkamp bij de plaats Nakon Pathom, 40 km ten westen van Bangkok. Het kamp deed dienst als hospitaalkamp sinds februari 1944 en bestond uiteindelijk uit 50 hutten met in elke hut plek voor 200 man. Dit was het grootste hospitaalkamp in de omgeving van de Birma-Siam-spoorweg. De werkzaamheden bestonden uit corvee binnen het kamp, er waren geen werkzaamheden buiten het kamp."@nl;
    skos:altLabel "Nakon Patom"@nl, "Nakorn Paton"@nl, "Thaicamp Nakompatom"@nl, "Nakompatom"@nl,
      "Nakhon Pathom"@nl .
  
