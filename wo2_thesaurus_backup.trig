    dcterms:created "2018-12-07T10:06:09.000Z"^^xsd:dateTime;
    skos:prefLabel "Operatie Manna"@nl, "Operation Manna"@de, "Operation Manna"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Operatie Manna en Operatie Chowhound waren de namen van de geallieerde voedseldroppings in Nederland in april-mei 1945, aan het eind van de Hongerwinter. Operatie Manna werd van 29 april tot 8 mei 1945 uitgevoerd door de Royal Air Force. Deze voedseldroppings waren noodzakelijk geworden, omdat er vele honderdduizenden Nederlanders in West-Nederland al maandenlang verstoken waren van alle soorten van voedsel, kleding en hulpgoederen."@nl;
    skos:altLabel "Operation Manna"@nl;
