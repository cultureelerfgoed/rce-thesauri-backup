    <http://schema.org/startDate> "1943-02-02"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/wiki/Aanslag_op_Alois_Bamberger"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/9271>;
    dcterms:created "2020-11-17T10:16:29.225Z"^^xsd:dateTime;
    skos:prefLabel "Fusillade in Haarlem, 2 februari 1943"@nl, "Hinrichtung in Haarlem, 2. Februar 1943"@de,
      "Execution in Haarlem, February 2, 1943"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "In Haarlem werden op 2 februari 1943 als represaille voor de aanslag op een Duitse militair, Alois Bamberger, 10 personen gefusilleerd in de duinen bij het Kopje van Bloemendaal. Drie Joodse slachtoffers en zeven communisten. Onder hen bevonden zich Barend Chapon, voorzitter van de Joodsche Raad in Haarlem en opperrabbijn Philip Frank. Commandant van het vuurpeloton was J.J. Wagner. "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/10300> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Guus Hartendorf, Velser Affaire. Bezettingstijd 1940-1945 in Kennemerland (Haarlem 2001) "@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
