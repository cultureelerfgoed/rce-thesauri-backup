      "Ministry for Internal Affairs"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote """Het Departement van Binnenlandse Zaken stond tijdens de Duitse bezetting onder leiding van secretaris-generaal Karel Johannes Frederiks, die al vanaf 1931 deze functie bekleedde.
        """@nl;
