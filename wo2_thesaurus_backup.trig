    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/15067>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/f5117dda-04f0-267e-123e-91097db66bfd.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/97d1704a-025a-11e7-904b-d89d6717b464/media/f5117dda-04f0-267e-123e-91097db66bfd";
    <http://schema.org/location> "Neurenberg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/97d1704a-025a-11e7-904b-d89d6717b464/media/f5117dda-04f0-267e-123e-91097db66bfd>;
    <http://schema.org/startDate> "1947-09-29"^^xsd:date;
    <http://schema.org/endDate> "1948-04-10"^^xsd:date;
    dcterms:source "https://en.wikipedia.org/wiki/Einsatzgruppen_trial"@nl, "https://nl.wikipedia.org/wiki/Processen_van_Neurenberg"@nl;
    skos:relatedMatch <https://data.niod.nl/WO2_Thesaurus/corporaties/4504>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/4399>;
    dcterms:created "2021-06-24T09:50:47.729Z"^^xsd:dateTime;
    skos:prefLabel "Einsatzgruppen Trial"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "De Einsatzgruppen Trial, officieel The United States of America vs. Otto Ohlendorlf, et al., was de negende van de twaalf vervolgprocessen voor de Amerikaanse militaire rechtbank. De 24 aangeklaagden waren allemaal commandanten van de Einsatzgruppen. De hoofdaanklager was Benjamin B. Ferencz. Het proces duurde van 29 september 1947 tot 10 april 1948 en alle aangeklaagden werden veroordeeld."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/16885> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2021-06-25T08:54:14.564Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/kampen/3699>;
    <http://schema.org/startDate> "1945-03-25"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Kamp_Rees&oldid=58483964"@de;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/3699>;
    dcterms:created "2021-06-25T08:50:55.902Z"^^xsd:dateTime;
    skos:prefLabel "Bevrijding Kamp Rees"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote """Rees werd op 23 maart 1945, kort na de Operatie Veritable, platgebombardeerd door de Engelsen en de Schotten (51e (Hoogland) Infanteriedivisie). Twee dagen later, op 25 maart 1945 om 12:00 werd het kamp bevrijd en werden de nog aanwezige Duitsers gevangengenomen. Er werd een tentenkamp opgezet voor de gevangenen. 
Bron: Wikipedia

"""@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/16887> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2021-06-25T09:36:23.066Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8037>;
    <http://schema.org/startDate> "1945-04-14"^^xsd:date;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/7144>;
    dcterms:created "2021-06-25T09:34:24.147Z"^^xsd:dateTime;
    skos:prefLabel "Gevechten bij Villa Laag Buurlo"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Bij Villa Laag Buurlo werd op 14 april 1945 één van de laatste gevechten geleverd voor de bevrijding van Nederland, toen de bemanning van een Duits kanon op een tankonderstel de Canadezen ontdekte en het vuur opende op de villa. In de villa werden door de Canadezen voorbereidingen getroffen voor de bevrijding van Apeldoorn. Gedurende het gevecht drong een granaat door de buitenmuren van het huis naar binnen waarbij twee Canadese soldaten werden gedood: Captain F.J. Sims en Lieutenant J.W. Reardon. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4466> .
  
