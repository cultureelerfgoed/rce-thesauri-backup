    skos:broader <https://data.niod.nl/WO2_Thesaurus/1870>;
    dcterms:created "2021-09-22T14:22:23.994Z"^^xsd:dateTime;
    skos:prefLabel "Invoering Allied Powers (Maritime Courts) Act 1941"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Allied Powers (Maritime Courts) Act 1941 werd ingevoerd op 22 mei 1941 en was een wet in Groot-Brittannië die het toeliet dat andere geallieerde regeringen, zoals de Noorse en Nederlandse die door de Duitse invasie naar het Verenigd Koninkrijk waren gevlucht, maritieme rechtbanken opzetten bij gebrek aan een eigen juridische infrastructuur. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/17646> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Dissel, Anita van, Martin Elands, Hylke Faber en Pieter Stolk, eds. De Nederlandse koopvaardij in oorlogstijd. Amsterdam: Boom, 2014. Bezemer, K.W.L.  Geschiedenis van de Nederlandse koopvaardij in de Tweede Wereldoorlog / Dl. 1 en dl. 2. Tweede druk. Amsterdam: Elsevier, 1987. Jong, Loe de. Het Koninkrijk der Nederlanden in de Tweede Wereldoorlog. Deel 11a. Nederlands-Indië I. Tweede helft (1984). "@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:04:51.270Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/17647>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://service.archief.nl/gaf/api/file/v1/img/726a468c-ae28-4f88-823c-14580de7dc82?h=1000";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://www.nationaalarchief.nl/onderzoeken/fotocollectie/aef5e45a-d0b4-102d-bcf8-003048976d84";
    <http://schema.org/location> "Tjilatjap";
    <http://schema.org/startDate> "1942-03-04"^^xsd:date;
    <http://schema.org/endDate> "1942-03-06"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1870>;
    dcterms:created "2021-09-22T14:34:24.779Z"^^xsd:dateTime;
    skos:prefLabel "Japanse luchtaanval haven Tjilatjap"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Op 4, 5, en 6 maart 1942 vonden Japanse luchtaanvallen plaats op de haven van Tjilatjap, Nederlands-Indië. Deze haven was zo lang mogelijk open gehouden voor evacués, maar na deze aanval beveelde de Nederlandse regering dat ook hier alle resterende schepen tot zinken moesten worden gebracht om de toegang tot de haven te versperren en om de schepen niet in de handen van de vijand te laten vallen. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/17648> a <http://schema.org/Thing>, skos:Concept,
