  <https://data.niod.nl/WO2_Thesaurus/11505> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    dcterms:modified "2025-02-19T12:24:43.927Z"^^xsd:dateTime;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/freet>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/2669>;
    dcterms:created "2021-04-16T13:51:36.404Z"^^xsd:dateTime;
    skos:prefLabel "De Vrijbuiters"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Verzetsgroep 'De Vrijbuiters' in Maarheeze werkte vanuit de woonwagen van Harry Semler (1906-1973) en Trien Semler-Hendriks (1901-1979). De verzetsgroep maakte onderdeel uit van een internationale pilotenlijn, waarlangs geallieerde piloten via België, Frankrijk, Zwitserland, Spanje of Gibraltar terugkeerden naar Engeland. Lid van De Vrijbuiters was onder meer Derk Hendricus Albers (1923-1988)."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/11506> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:34:19.686Z"^^xsd:dateTime;
