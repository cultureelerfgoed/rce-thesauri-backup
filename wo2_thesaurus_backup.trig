    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Op basis van het Zuiveringsbesluit konden personen die verdacht werden van collaboratie uit bepaalde beroepsgroepen (zoals ambtenaren, kunstenaars en journalisten) onderzocht en eventueel ontslagen worden. Er konden ook andere maatregelen worden genomen, zoals overplaatsing, terugplaatsen in rang of inhouding van loon."@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2591>;
