    <https://data.niod.nl/organizationsWO2/startDate> "1943-11-12"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/ef2a93fa-3ea2-29c7-87e6-403b5a816944.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/2cecfdc6-025a-11e7-904b-d89d6717b464/media/ef2a93fa-3ea2-29c7-87e6-403b5a816944";
    dcterms:source "https://www.verzetsmuseum.org/museum/nl/tweede-wereldoorlog/begrippenlijst/achtergrond-verzet/onderdrukking_van (31 augustus 2016)"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-06"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    skos:relatedMatch <https://data.niod.nl/WO2_biografieen/Hendrik-van-der-Molen>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Nederlandsche Landwacht, opgericht in 1943, trad op als hulppolitie van de Nationaal-Socialistische Beweging (NSB). De taak van de Landwacht was het beschermen van NSB’ers tegen aanslagen van het verzet. In de praktijk was de Landwacht vooral betrokken bij het bewaken van gebouwen, het controleren van persoonsbewijzen en het opsporen van verzetsdeelnemers en onderduikers. Ongeveer 20.000 NSB’ers waren lid van de Landwacht. De Landwacht bestond uit beroepslandwachters die fulltime in dienst waren en een hulplandwachters die naast hun gewone baan enkele uren per week in hun lokale omgeving actief waren.  Ze waren meestal bewapend met een jachtgeweer, wat hen de spottende bijnaam Jan Hagel opleverde."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/demoadmin>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/corporaties/6645>, <https://data.niod.nl/WO2_Thesaurus/16967>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2715>, <https://data.niod.nl/WO2_Thesaurus/20640>;
    dcterms:created "2016-08-01T19:20:02.000Z"^^xsd:dateTime;
    skos:prefLabel "Nederlandsche Landwacht"@nl, "'Landwacht'"@de, "Dutch Landwacht"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Nederlandsche Landwacht was een gewapende formatie met politietaken en -bevoegdheden die op 12 november 1943 werd opgericht. De Landwacht bestond uit met jachtgeweren gewapende NSB-leden (meer dan 20.000) en kreeg daardoor de bijnaam ‘Jan Hagel’. Vanwege het toegenomen aantal aanslagen op NSB’ers wilde Mussert een bewapend korps ter bescherming van zijn leden. In de praktijk werd de Landwacht echter vooral ingezet voor het opsporen van illegale activiteiten, verzetsmensen en onderduikers. De Landwacht bestond uit beroepslandwachters die fulltime in dienst waren en hulplandwachters die naast hun gewone baan enkele uren per week in hun lokale omgeving actief waren. Na Dolle Dinsdag viel de Landwacht direct onder Rauter als Höherer SS- und Polizeiführer. Vanwege de door hen uitgeoefende terreur (onder andere diefstal, roof, afpersing, mishandeling, marteling en moord) waren de Landwachters zeer gehaat."@nl;
    skos:altLabel "Landwacht"@nl, "Nederlandse Landwacht"@nl, "Hulplandwacht"@nl, "Beroepslandwacht"@nl,
      "Hulpdienst der Landwacht"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/6645>, <https://data.niod.nl/WO2_Thesaurus/events/10925>,
      <https://data.niod.nl/WO2_Thesaurus/locations/8002>, <https://data.niod.nl/WO2_Thesaurus/16967>,
      <https://data.niod.nl/WO2_Thesaurus/19874>, <https://data.niod.nl/WO2_Thesaurus/19876>,
      <https://data.niod.nl/WO2_Thesaurus/19890>, <https://data.niod.nl/WO2_Thesaurus/20242>,
      <https://data.niod.nl/WO2_Thesaurus/20243>, <https://data.niod.nl/WO2_Thesaurus/20244>,
      <https://data.niod.nl/WO2_Thesaurus/20246>, <https://data.niod.nl/WO2_Thesaurus/20250>,
      <https://data.niod.nl/WO2_Thesaurus/20257>, <https://data.niod.nl/WO2_Thesaurus/20281>,
      <https://data.niod.nl/WO2_Thesaurus/20296>, <https://data.niod.nl/WO2_Thesaurus/20297>,
      <https://data.niod.nl/WO2_Thesaurus/20298>, <https://data.niod.nl/WO2_Thesaurus/20299>,
      <https://data.niod.nl/WO2_Thesaurus/20300>;
    skos:definition " De Nederlandsche Landwacht werd op 11 maart 1943 opgericht als hulppolitiekorps op verzoek van Rauter door de Leider der NSB uit eigen leden ter bescherming van de sinds begin 1943 toenemende aanslagen op NSB'ers. Rauter beschouwde het korps echter ook als zijn eigen politiemacht, waarvan hij meer loyaliteit verwachtte dan van de Nederlandse politie. Hij leidde en bewapende de Landwacht, verleende haar politiebevoegdheden en regelde in overleg met de NSB organisatie, bezoldiging en andere zaken. Hoewel zij op centraal en regionaal niveau organisatorisch aan de Nederlandse politie was gekoppeld die toezicht hield, stond zij direkt onder de Befehlshaber der Ordnungspolizei, waarin zij sinds september 1944 ook formeel werd opgenomen. Zij viel onder de jurisdictie van het SS- en Polizeigericht X. Kees van Geelkerken, de tweede man binnen de NSB, werd in november 1943 door Seyss-Inquart benoemd tot Inspecteur-Generaal van de Landwacht."@nl .
  
