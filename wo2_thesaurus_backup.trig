    skos:relatedMatch <https://data.niod.nl/WO2_biografieen/Paulus-Gerardus-de-Jager-Meezenbroek>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3554>, <https://data.niod.nl/WO2_Thesaurus/2244>;
    dcterms:created "2023-05-16T08:19:25.072Z"^^xsd:dateTime;
    skos:prefLabel "Centrale Inlichtingen Dienst NSB"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Centrale Inlichtingen Dienst (CID) werd op 29 oktober 1940 opgericht als inlichtingendienst van de NSB en werd geleid door NSB’er Paulus Gerardus de Jager Meezenbroek. Afdeling I van de CID verzamelde inlichtingen binnen de NSB en afdeling II onderzocht aspirant-leden. Afdeling III verzamelde inlichtingen over acties tegen de NSB, zoals verstoringsacties, en afdeling IV verzamelde gegevens over illegale, anti-Duitse en anti-nationaalsocialistische activiteiten van Nederlanders. De CID werkte aanvankelijk samen met de Sicherheitsdienst (SD), maar op 5 juni 1941 werd de CID op bevel van Höherer SS- und Polizeiführer Hanns Albin Rauter opgeheven. Afdeling II van de CID bleef voort bestaan onder de naam Algemeen Toezicht Leden (ATL). "@nl;
    skos:altLabel "Centrale Inlichtingen Dienst van de NSB"@nl, "Centrale Inlichtingen Dienst der NSB"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/19576>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
