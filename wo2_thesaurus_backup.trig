    <http://schema.org/location> "Veenendaal";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/2175eaca-025a-11e7-904b-d89d6717b464/media/d2647b9a-9ad6-a090-1ce4-98f395a388ea>;
    <http://schema.org/startDate> "1945-05-09"^^xsd:date;
    dcterms:source "https://gemeentearchief.veenendaal.nl/tour-wo-ii/bevrijding"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/6983>;
    dcterms:created "2021-06-16T13:23:57.870Z"^^xsd:dateTime;
    skos:prefLabel "Bevrijding Veenendaal"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De bevrijding van Veenendaal vond plaats op 9 mei 1945. Na de capitulatie op 5 mei zaten er nog steeds SS'ers in Veenendaal. Op 7 mei vond er een vuurgevecht tussen de Binnenlandse Strijdkrachten (BS) en de SS plaats waarbij drie leden van de BS omkwamen. Op 9 mei kreeg de Engelse majoor George Lockett de opdracht Veenendaal te bevrijden. "@nl .
  
