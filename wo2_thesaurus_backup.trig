    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    skos:relatedMatch <https://data.niod.nl/WO2_biografieen/Paulus-Jacobus-Johannes-Kramer>,
      <https://data.niod.nl/WO2_biografieen/Wilhelmus-Verweij>, <https://data.niod.nl/WO2_biografieen/Leo-Poos>,
      <https://data.niod.nl/WO2_biografieen/Marten-Slagter>, <https://data.niod.nl/WO2_biografieen/Adrianus-Wolterbeek>,
      <https://data.niod.nl/WO2_biografieen/Walter-Hermann-Eugen-Bartels>, <https://data.niod.nl/WO2_biografieen/Fritz-Ernst-William-Koch>,
      <https://data.niod.nl/WO2_biografieen/Antonie-Bolland>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Sicherheitsdienst (SD) was de Duitse inlichtingendienst. Tijdens de Duitse bezetting van Nederland was de SD betrokken bij het opsporen van tegenstanders van de bezetter en het vervolgen van groepen als verzetsdeelnemers en Joden. De SD maakte hierbij gebruik van informanten, de zogeheten V-Männer en V-Frauen."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/corporaties/7948>, <https://data.niod.nl/WO2_Thesaurus/8797>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/8009>, <https://data.niod.nl/WO2_Thesaurus/locations/6570>,
      <https://data.niod.nl/WO2_Thesaurus/22088>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/8532>;
    dcterms:created "2016-10-04T13:07:41.000Z"^^xsd:dateTime;
    skos:prefLabel "S.D."@nl, "SD"@de, "SD"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Sicherheitsdienst (SD) werd in september 1931 opgericht als de inlichtingendienst van de NSDAP en groeide uit tot een staatsinlichtingendienst met duizenden medewerkers. Vanaf 1939 ressorteerde de SD onder het Reichssicherheitshauptamt (RSHA). Tijdens de bezetting was de SD ook in Nederland werkzaam en gevreesd vanwege het fanatisme waarmee de dienst tegenstanders van de nazi’s vervolgde. Ook Nederlanders waren in dienst van de SD of verleenden al dan niet gedwongen hieraan hun diensten als infiltrant of informant."@nl;
    skos:altLabel "Sicherheitsdienst"@nl, "Sicherheits Dienst"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/7950>, <https://data.niod.nl/WO2_Thesaurus/corporaties/8004>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/5106>, <https://data.niod.nl/WO2_Thesaurus/corporaties/7998>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization>;
    skos:definition "De SD (Sicherheitsdienst) werd opgericht in 1931 als de inlichtingendienst van de NSDAP en groeide uit tot de staatsinlichtingendienst met duizenden medewerkers. De SD werkte onder meer met informanten, zogenaamde V-männer, of Vertrouwensman, jaagden op onderduikers en verzetsmensen. De SD had kantoren door heel Nederland, waaronder in Amsterdam, Den Haag, Groningen, Utrecht, Rotterdam en Arnhem."@en .
  
