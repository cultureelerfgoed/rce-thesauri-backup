    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Speciaal:Citeren&page=Geheime_Dienst_Nederland&id=46347498"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/2669>;
    dcterms:created "2017-03-01T21:03:18.000Z"^^xsd:dateTime;
    skos:prefLabel "'Geheime Dienst Nederland'"@de, "'Geheime Dienst Nederland'"@en, "Geheime Dienst Nederland"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Geheime Dienst Nederland (GDN) was een vanuit Londen opgezette verzetsgroep die ongeveer twaalfhonderd medewerkers telde. De GDN was verdeeld in vier districten en was actief in heel Nederland. De GDN verzamelde politieke, economisch en vooral militaire gegevens en gaf deze via Zwitserland en Spanje en via geheime radioverbindingen door naar het Bureau Inlichtingen Londen. De GDN was actief vanaf lente 1943. De Groep Reinaert of Groep Vogel en de Groep Harry waren onderdeel van de GDN."@nl;
    skos:altLabel "Groep Harry"@nl, "Groep Reinaert"@nl, "Groep Vogel"@nl, "Hoofdgroep Vogel"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
