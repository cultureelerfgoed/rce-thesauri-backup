    dcterms:created "2021-02-17T12:03:17.643Z"^^xsd:dateTime;
    skos:prefLabel "Liquidatie van Jan Willem Stuit"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De liquidatie van Jan Willem Stuit vond plaats op 25 augustus 1944 in Rotterdam. Stuit was leider van het Gewestelijk Arbeidsbureau in Naaldwijk en lid van de NSB. Sinds 17 augustus 1944 werd hij vermist. Op 26 augustus 1944 werd zijn lijk met een schotwond in een sloot langs de Kanaalweg in Rotterdam-Overschie gevonden. "@nl .
  
