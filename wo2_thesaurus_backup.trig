    dcterms:created "2020-08-27T08:46:57.000Z"^^xsd:dateTime;
    skos:prefLabel "Bevrijding Haarlem"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De bevrijding van Haarlem vond plaats op 8 mei 1945. De Canadezen van de Princess Patricia's Canadian Light Infantry kwamen vanuit Amsterdam de stad binnenrijden. Al vanaf 5 mei, toen de capitulatie werd aangekondigd, waren er feesten in de stad. De Duitsers probeerden die tevergeefs te beëindigen. "@en .
  
