    <http://schema.org/startDate> "1944-09-19"^^xsd:date;
    <http://schema.org/endDate> "1944-09-22"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1699>, <https://data.niod.nl/WO2_Thesaurus/kampen/3773>;
    dcterms:created "2018-11-14T09:51:06.000Z"^^xsd:dateTime;
    skos:prefLabel "Krijgsgevangenkamp Gevangenis Padang, 19-09-1944 - 22-09-1944"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote """Krijgsgevangenkamp Gevangenis in Padang functioneerde van 19 september 1944 tot 22 september als tijdelijk kamp voor 723 overlevenden van de torpedo-aanval (op 18 september 1944) van de Britse onderzeeboot HMS Tradewind op het Japanse schip Junyo Maru. Aan boord waren circa 4200 Romusha's en 2300 krijgsgevangenen. Circa 5600 personen kwamen om het leven bij deze aanval. Op 22 september werden de 723 gevangenen naar Spoorwegkamp 3 bij Taratakboeloeh, 17 kilometer ten zuiden van Pakanbaroe, afgevoerd.     
"""@nl;
