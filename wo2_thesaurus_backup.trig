    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/5167>, <https://data.niod.nl/WO2_Thesaurus/1699>,
      <https://data.niod.nl/WO2_Thesaurus/8176>;
    dcterms:created "2023-07-03T12:15:54.445Z"^^xsd:dateTime;
    skos:prefLabel "Kamp Wiesenfeld"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Wiesenfeld was een werkkamp in Glinde, 5 kilometer ten oosten van Hamburg. Het kamp was tussen 1939 en 1942 gebouwd om dwangarbeiders onder te brengen die in de Kurbelwellenwerk Hamburg (Ku-Ha) fabriek en in andere nabijgelegen fabrieken van de firma Krupp voor de Duitse wapenindustrie werkten. Er zaten in het kamp duizenden voornamelijk krijgsgevangenen, maar ook dwangarbeiders uit Nederland, België, Kroatië, Denemarken, Litouwen en de Sovjet-Unie gevangen. Het kamp werd bewaakt door een private bewakingsdienst. Op 3 mei 1945 werd het kamp bevrijd door Britse troepen, hoewel de bewaking al eerder was gevlucht. Hierna werden er Duitse krijgsgevangenen in het kamp geïnterneerd.  "@nl;
    skos:altLabel "Krijgsgevangenenkamp Wiesenfeld"@nl, "Arbeitslager Wiesenfeld"@nl,
      "Zwangarbeiterlager Wiesenfeld"@nl, "Werkkamp Wiesenfeld"@nl, "Lager Wiesenfeld"@nl .
  
