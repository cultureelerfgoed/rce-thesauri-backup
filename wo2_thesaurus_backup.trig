    <https://data.niod.nl/organizationsWO2/startDate> "1932-06-29"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/6909f2b7-7308-f470-0941-7716e386c6f7.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/cbb7dfa8-0259-11e7-904b-d89d6717b464/media/6909f2b7-7308-f470-0941-7716e386c6f7";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/cbb7dfa8-0259-11e7-904b-d89d6717b464/media/6909f2b7-7308-f470-0941-7716e386c6f7>,
      <https://beeldbankwo2.nl/nl/beelden/detail/e82aaf20-025a-11e7-904b-d89d6717b464/media/d98f6c6a-84b1-19d6-56a4-482c74e230b9>,
      <https://beeldbankwo2.nl/nl/beelden/detail/cf8ff48e-025a-11e7-904b-d89d6717b464/media/29b4a64b-cb5c-ed76-0b7f-1234e00e034c>;
    <https://data.niod.nl/organizationsWO2/endDate> "1934-05-05"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Algemeen Nederlandsche Fascisten Bond (ANFB) was een fascistische politieke partij. De ANFB werd op 29 juni 1932 opgericht door Jan Baars, maar viel op 5 mei 1934 uiteen in verschillende partijen, waaronder het Zwart Front onder leiding van Arnold Meijer."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2506>, <https://data.niod.nl/WO2_Thesaurus/corporaties/6109>;
    dcterms:created "2016-10-04T13:07:42.000Z"^^xsd:dateTime;
    skos:prefLabel "Algemeene Nederlandsche Fascisten Bond"@nl, "Allgemeiner Niederländischer Faschistenbund"@de,
      "General Dutch Fascist League"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Algemeene Nederlandsche Fascisten Bond (ANFB) werd op 29 juni 1932 opgericht. Leider was de voormalige marktkoopman Jan Baars. De ANFB oriënteerde zich volledig op Mussolini’s Italië en wees de nationaalsocialistische rassenleer en antisemitisme principieel af. Uit onvrede over de slechte organisatie en samenwerking met de meer gematigde Nationale Unie, liepen veel leden over naar de NSB. Na het vertrek van Baars in april 1934 werd de ANFB op 5 mei van dat jaar opgedeeld in het wegkwijnende Fascistisch Verbond de Vuurslag en het succesvollere Fascistisch verbond Zwart Front, dat onder leiding van Arnold Meijer stond."@nl;
    skos:altLabel "Algemene Nederlandsche Fascisten Bond"@nl, "A.N.F.B."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Organization> .
  
