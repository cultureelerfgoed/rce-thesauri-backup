    dcterms:created "2021-08-24T12:07:13.557Z"^^xsd:dateTime;
    skos:prefLabel "Kamp Kasteel Hoensbroek"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Kasteel Hoensbroek was een kindertehuis en interneringskamp (bijzondere rechtspleging). Vanaf 23 december 1942 was het kasteel een kindertehuis voor 120 Rijksvoogdijkinderen. Deze kinderen kwamen uit het kindertehuis Meerzicht bij Velsen, dat voor de bouw van de Atlantikwal moet wijken. Op 18 september 1944 werd Hoensbroek door het Amerikaanse leger bevrijd. Een gedeelte van het kasteel was van 19 september 1944 tot 1948 in gebruik als interneringskamp. Hier zaten verdachten van en veroordeelden voor collaboratie opgesloten. Tot mei 1946 bleef Kasteel Hoensbroek een kindertehuis."@nl;
    skos:altLabel "Interneringskamp Hoensbroek"@nl, "Bewarings- en Verblijfskamp Kasteel Hoensbroek"@nl,
      "Bewaringskamp Hoensbroek"@nl, "Kindertehuis Hoensbroek"@nl, "Kamp Hoensbroek"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
