      <http://schema.org/Event>;
    dcterms:references "The Kindertransport, Jennifer Craig-Norton, Indiana University Press 2019"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-06-21T14:14:39.950Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/2/24/Stolperstein_Berolinastr_32_%28Mitte%29_Adolf_Abraham_Bachner.jpg/500px-Stolperstein_Berolinastr_32_%28Mitte%29_Adolf_Abraham_Bachner.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://en.wikipedia.org/wiki/1938_expulsion_of_Polish_Jews_from_Germany#/media/File:Stolperstein_Berolinastr_32_(Mitte)_Adolf_Abraham_Bachner.jpg";
    <http://schema.org/startDate> "1938-10-27"^^xsd:date;
    <http://schema.org/endDate> "1938-10-29"^^xsd:date;
    dcterms:source "https://en.wikipedia.org/wiki/1938_expulsion_of_Polish_Jews_from_Germany"@nl;
    skos:relatedMatch <https://data.niod.nl/WO2_Thesaurus/events/18869>, <https://data.niod.nl/WO2_Thesaurus/events/18870>,
      <https://data.niod.nl/WO2_Thesaurus/events/18871>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/18868>;
    dcterms:created "2022-03-23T09:40:54.544Z"^^xsd:dateTime;
    skos:prefLabel "Polenaktion"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Polenaktion was een reactie van Nazi-Duitsland op een Pools besluit van 6 oktober 1938 waarmee het voor Poolse Joden in Duitsland erg moeilijk werd om naar Polen terug te keren. Duitsland vreesde dat Poolse Joden Duitsland niet meer gingen verlaten. Hoofd van de Gestapo Reinhard Heydrich besloot in oktober 1938 17.000 Poolse Joden te verbannen. De gedeporteerde Joden werden afgewezen door Polen dat zijn grenzen sloot. Ze verbleven in tentenkampen aan de Duits-Poolse grens. Pas vlak voor de Duitse invasie van Polen in 1939 werden de vluchtelingen toegelaten. De Polenaktion was de eerste gecoördineerde massadeportatie van Joden uit het Duitse Rijk."@nl;
    skos:altLabel "Polish Action"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/18868> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    dcterms:modified "2022-03-23T10:37:21.064Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/8/8b/Bundesarchiv_Bild_146-1982-174-27%2C_N%C3%BCrnberg%2C_Ausweisung_polnischer_Juden.jpg?20130702000844";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/wiki/File:Bundesarchiv_Bild_146-1982-174-27,_N%C3%BCrnberg,_Ausweisung_polnischer_Juden.jpg";
    <http://schema.org/startDate> "1938-10-06"^^xsd:date;
    dcterms:source "https://en.wikipedia.org/wiki/1938_expulsion_of_Polish_Jews_from_Germany"@nl;
    skos:relatedMatch <https://data.niod.nl/WO2_Thesaurus/events/4394>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/18867>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2005>;
    dcterms:created "2022-03-23T10:15:39.305Z"^^xsd:dateTime;
    skos:prefLabel "Poolse ordonnantie van 6 oktober 1938"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Op 6 oktober 1938 maakte het Poolse ministerie van Binnenlandse Zaken een ordonnantie bekend dat Poolse burgers die in het buitenland verbleven vóór 30 oktober 1938 een stempel in hun paspoort moesten halen om de geldigheid te garanderen. Zonder deze stempel kwam je Polen niet meer binnen. Vanwege de invoering van de Neurenberger Wetten vreesde Polen een enorme instroom van Poolse Joden die in Duitsland woonden. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
