    skos:prefLabel "Internationale Brigaden"@de, "International Brigades"@en, "Internationale brigades"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Tijdens de Spaanse Burgeroorlog (1936-1939) vochten ongeveer 32.000 vrijwilligers uit meer dan vijftig landen aan de zijde van de republikeinen tegen de opstandige nationalisten van generaal Franco. In de internationale Brigades streden vooral communisten, socialisten en andere links-georiënteerden. Nederlandse vrijwilligers werden ook spanjestrijders genoemd."@nl;
    skos:altLabel "Spanjestrijders"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/4414> .
  
