    dcterms:created "2020-06-15T11:44:00.000Z"^^xsd:dateTime;
    skos:prefLabel "Evacuatie van Blechhammer"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "De evacuatie van Blechhammer vond plaats op 21 januari 1945 vanwege de nadering van het Sovjet leger. Zo'n 4.000 gevangenen werden gedwongen naar Gross-Rosen te lopen. Ongeveer 800 werden onderweg doodgeschoten. De rest kwam op 2 februari aan in Gross-Rosen. De achtergebleven zieken in Blechhammer werden vrijwel allemaal vermoord, slechts tien overleefden."@en;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9046> a <http://schema.org/Thing>, skos:Concept,
