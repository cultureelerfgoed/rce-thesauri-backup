    dcterms:source "https://regiopurmerend.nl/2020/05/06/bevrijding-precies-75-jaar-geleden-liepen-de-binnenlandse-strijdkrachten-purmerend-binnen/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
