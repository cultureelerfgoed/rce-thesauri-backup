    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    dcterms:modified "2026-05-04T12:51:01.478Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Een Fiat Executie is de goedkeuring van de Hoge Autoriteit op de uitspraak van een Tribunaal. Pas na deze goedkeuring konden de straffen in de uitspraak uitgevoerd worden. De Hoge Autoriteit kon een uitspraak ook deels of volledig afkeuren."@nl;
