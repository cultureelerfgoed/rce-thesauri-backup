    dcterms:source "https://wikimiddenbrabant.nl/Explosie_V1_Broekhoven,_20_februari_1945"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/19539>;
    dcterms:created "2025-10-08T08:54:11.218Z"^^xsd:dateTime;
    skos:prefLabel "V-1 inslag Broekhoven Tilburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De inslag van een Duitse V-1 in de wijk Broekhoven in Tilburg vond plaats op 20 februari 1945. Een V1 stort neer in de buurt van het pand 'De Elzenhof', iets voorbij de ververij van Gerard van Spaendonck aan de weg naar Hilvarenbeek. Landbouwer Gerardus Vissers en zijn paard worden dodelijk getroffen."@nl .
  
