    dcterms:source "https://www.amsterdam.nl/kunst-cultuur/monumenten/erfgoed-week/bombardement-blauwburgwal/"@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2322>, <https://data.niod.nl/WO2_Thesaurus/events/19539>;
    dcterms:created "2020-05-08T09:18:16.000Z"^^xsd:dateTime;
    skos:prefLabel "Bombardement bij Blauwburgwal"@nl, "Bombardierung von Blauwburgwal"@de,
      "Bombing of the Blauwburgwal"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote """Het bombardement bij de Blauwburgwal door de Luftwaffe vond plaats op 11 mei 1940. Er vielen 4 brisantbommen van 250 kilo in het centrum van Amsterdam: 3 vielen in het water van de Herengracht en de Blauwburgwal, 1 bom ontplofte op straat. Bij het bombardement vielen 44 doden en 79 gewonden. De reden voor het bombardement is niet duidelijk. 
Het bombardement bij de Blauwburgwal is een van de eerste bombardementen in Nederland."""@nl .
  
