    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Nederlandsche Apothekerskamer (NAK) was een nationaalsocialistische organisatie voor apothekers. Het doel van de NAK was alle apothekers onder nationaalsocialistisch gezag te plaatsen. Alle apothekers waren automatisch lid van de NAK. De NAK werd op 13 maart 1942 opgericht en verving de Nederlandse Maatschappij ter bevordering van de Farmacie."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2852>, <https://data.niod.nl/WO2_Thesaurus/20640>,
      <https://data.niod.nl/WO2_Thesaurus/20645>;
    dcterms:created "2018-03-02T13:24:28.000Z"^^xsd:dateTime;
    skos:prefLabel "Nederlandsche Apothekerskamer"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Nederlandsche Apothekerskamer werd door Seyss-Inquart per verordening op 13 maart 1942 ingesteld onder gelijktijdige opheffing van de Nederlandse Maatschappij ter bevordering van de Farmacie. De Apothekerskamer was een nationaalsocialistische organisatie met publiekrechtelijke bevoegdheden die apothekers moest inschakelen in het Duitse beleid ten aanzien van de volksgezondheid. Apothekers werden automatisch lid. President van de Apothekerskamer was de NSB’er H.P. Stam."@nl;
    skos:altLabel "Apothekerskamer"@nl, "Nederlandse Apothekerskamer"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization>;
    skos:hiddenLabel "N.A.K."@nl .
  
