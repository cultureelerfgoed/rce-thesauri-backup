    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/fa46ce82-025a-11e7-904b-d89d6717b464/media/ece209ca-6d91-6eec-3a8a-829569c5599c";
    dcterms:source "https://www.canonvannederland.nl/nl/utrecht/regio-eemland/leusden/karel-brouwer"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/8506>;
    dcterms:created "2020-11-24T14:10:31.573Z"^^xsd:dateTime;
    skos:prefLabel "Ambtenarenverzet in Leusden"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Gemeentesecretaris Karel Brouwer, werkzaam op het gemeentehuis in Leusden, verstrekte onderduikers originele documenten, met aanvankelijk willekeurige personalia. Later gebruikte hij persoonsgegevens van overleden personen. Landelijk werd deze vorm van administratief verzet toegepast door de TD-groep. De bezetter werd tegengewerkt bij het opsporen van onderduikers met de tweede distributiestamkaart. "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/10443> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "José Huurdeman, Ondergronds in de Tweede Wereldoorlog. Verhalen uit de Gelderse Vallei, Veluwe en Krimpenerwaard, Leusden 2019."@nl;
