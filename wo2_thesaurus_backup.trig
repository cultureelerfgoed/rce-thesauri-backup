    skos:prefLabel "Jawa Hokokai"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Jawa Hokokai bestond van 8 januari 1944 tot het eind van de Japanse bezetting van Nederlands-Indië en werd opgericht door de Japanse bezetter. Het was de directe opvolger van de PUTERA, maar stond onder leiding van de bezetter zelf. Het doel was het snel kunnen mobiliseren van de inheemse bevolking en hen in te kunnen zetten ten gunste van de Japanners in de strijd tegen de geallieerden. "@nl;
    skos:altLabel "Djawa Hokokai"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/4382>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7765> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "Peter Post - The Encyclopedia of Indonesia in the Pacific War"@en,
      "Peter Post, ed., The Encyclopedia of Indonesia in the Pacific War (Leiden : Brill, 2010)"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:36:33.043Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8028>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4551>, <https://data.niod.nl/WO2_Thesaurus/20702>;
    dcterms:created "2019-01-24T11:22:23.000Z"^^xsd:dateTime;
    skos:prefLabel "Tokubetsu Kakyo Keibotai"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote """De Tokubetsu Kakyo Keibotai bestond van 17 november 1944 tot het eind van de Japanse bezetting van Indonesië en stond onder leiding van de steenrijke Tjong Hauw Oei. Het was een Japanse elite-eenheid waar hoogopgeleide Chinezen in Indonesië lid van waren en was bedoeld voor de verdediging van Indonesië.
"""@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/4382>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7767> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "Peter Post - The Encyclopedia of Indonesia in the Pacific War"@en;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-05-30T09:28:29.486Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> false;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2878>;
    dcterms:created "2019-01-24T11:49:18.000Z"^^xsd:dateTime;
    skos:prefLabel "B.O.M.P.A."@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De BOMPA (Badan Oentoek Mempertahankan Peperangan Asia) bestond van november 1943 tot 23 augustus 1945 en werd opgezet door de Japanse bezetter. De organisatie had als doel om Giyugun en Heiho-soldaten te rekruteren en geld te werven om hen financieel te ondersteunen. Mohammad Yusuf was officieel de leider, maar de drijvende kracht achter de organisatie was Muhammad Sutan Abdu'l Xarim. "@nl;
    skos:altLabel "Badan Oentoek Mempertahankan Peperangan Asia"@nl, "Badan Untuk Mempertahankan Peperangan Asia"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/4382>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7768> a <http://schema.org/Thing>,
      skos:Concept;
    dcterms:references "Herman Smit - Gezag is gezag..."@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:31:26.645Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8019>,
      <https://data.niod.nl/WO2_Thesaurus/locations/8028>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/f/f6/COLLECTIE_TROPENMUSEUM_Opening_van_de_Volksraad_door_gouverneur-generaal_Van_Limburg_Stirum_op_18_mei_1918_op_Java_TMnr_10001373.jpg/500px-COLLECTIE_TROPENMUSEUM_Opening_van_de_Volksraad_door_gouverneur-generaal_Van_Limburg_Stirum_op_18_mei_1918_op_Java_TMnr_10001373.jpg";
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Volksraad_(Nederlands-Indi%C3%AB)&oldid=49553640"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/events/8406>, <https://data.niod.nl/WO2_Thesaurus/events/7823>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/1717>, <https://data.niod.nl/WO2_Thesaurus/20702>;
    dcterms:created "2019-01-24T12:14:44.000Z"^^xsd:dateTime;
    skos:prefLabel "Volksraad"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Volksraad bestond van 1918 tot de capitulatie van Nederlands-Indië in 1942 en was opgericht als adviesraad voor de gouverneur-generaal en vertegenwoordigers van verschillende etnische achtergronden. Hoewel de macht van de Volksraad altijd beperkt is gebleven werd de bevoegdheid wel steeds ruimer (zo mocht de raad stemmen over de begroting voor Nederlands-Indië). De Nederlandse regering had echter altijd vetorecht. "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7769> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "Peter Post - The Encyclopedia of Indonesia in the Pacific War"@en;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-04-09T11:28:42.498Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8028>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2506>;
    dcterms:created "2019-01-24T12:40:36.000Z"^^xsd:dateTime;
    skos:prefLabel "Partai Tionghoa Indonesia"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Partai Tionghoa Indonesia (PTI) bestond van 25 september 1932 tot circa 1939 en werd opgericht door Liem Koen Hian. De partij streed voor een onafhankelijk Indonesië en was de eerste Chinese beweging die niet de focus op China had, maar Indonesië echt als haar land zag."@nl;
    skos:altLabel "PTI"@nl, "Indo-Chinese Partij"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4763>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7770> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "Peter Post - The Encyclopedia of Indonesia in the Pacific War"@en,
      "Peter Post, ed., The Encyclopedia of Indonesia in the Pacific War (Leiden : Brill, 2010)"@nl,
      "Audrey Kahin - Historical Dictionary of Indonesia"@en;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-04-09T14:37:03.609Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8028>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2506>, <https://data.niod.nl/WO2_Thesaurus/20702>;
    dcterms:created "2019-01-24T12:53:40.000Z"^^xsd:dateTime;
    skos:prefLabel "Persatuan Bangsa Indonesia"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Persatuan Bangsa Indonesia bestond van oktober 1930 tot 1935 en werd opgericht door Sutomo en Durasim. De partij had een onafhankelijk Indonesië als doel en ging in 1935 op in de Partai Indonesia Raya."@nl;
    skos:altLabel "Partai Bangsa Indonesia"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7771> a <http://schema.org/Thing>,
      skos:Concept;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-02-16T14:51:11.433Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8028>;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=De_Stuw-groep&oldid=52367479"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2506>;
    dcterms:created "2019-01-24T13:15:25.000Z"^^xsd:dateTime;
    skos:prefLabel "Stuw-Groep"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Stuw-Groep bestond van 1931 tot 1933 en werd opgericht door J.A. Jonkman. Het doel was toewerken naar een onafhankelijk Indonesië. Door het elitaire karakter wist de vereniging nooit echt aansluiting te vinden bij het grote publiek. De organisatie bestond uit witte heren van Nederlandse afkomst."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/1717> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7772> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "Cornelis Smit - De Indonesische quaestie: de wordingsgeschiedenis der souvereiniteitsoverdracht"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:36:03.656Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8019>,
      <https://data.niod.nl/WO2_Thesaurus/locations/8028>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/1717>, <https://data.niod.nl/WO2_Thesaurus/2506>;
    dcterms:created "2019-01-24T13:29:36.000Z"^^xsd:dateTime;
    skos:prefLabel "Nationale Fractie in de Volksraad"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Nationale Fractie in de Volksraad werd opgericht op 27 januari 1930 tot de capitulatie van Nederlands-Indië in 1942. De fractie was een bundeling van partijen in de Volksraad die via samenwerking met de Nederlandse machthebbers een onafhankelijk Indonesië wilde bewerkstelligen en was de tegenhanger van de Vaderlandsche Club."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7773> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "T.J. Bezemer - Encyclopaedie van Nederlandsch-Indië"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-04-09T14:40:46.730Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8028>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2506>, <https://data.niod.nl/WO2_Thesaurus/20702>;
    dcterms:created "2019-01-24T13:53:57.000Z"^^xsd:dateTime;
    skos:prefLabel "Perserikatan Kaoem Christen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Perserikatan Kaoem Christen (PKC) bestond van 26 juni 1930 tot de capitulatie van Nederlands-Indië in 1942. De partij streed voor de Volksraad als volwaardig parlement. Hoewel de partij officieel ook voor onafhankelijkheid van Indonesië streed wilde de leiding dit enkel bewerkstelligd zien nadat de bevolking was bekeerd tot het Christendom."@nl;
    skos:altLabel "PKC"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7774> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-06-12T15:15:29.570Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8028>;
    dcterms:source "http://resources.huygens.knaw.nl/bwn1880-2000/lemmata/bwn4/zentgraaff"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2506>, <https://data.niod.nl/WO2_Thesaurus/20702>;
    dcterms:created "2019-01-24T14:48:45.000Z"^^xsd:dateTime;
    skos:prefLabel "Vaderlandsche Club"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Vaderlandsche Club Bestond van oktober 1929 tot de capitulatie van Nederlands-Indië in 1942 en werd opgericht door journalist H.C. Zentgraaff. De club ontstond als reactie op de inheemse onafhankelijkheidsbewegingen en had als doel de Nederlandse macht en greep op Nederlands-Indië te versterken. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7775> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "Peter Post - The Encyclopedia of Indonesia in the Pacific War"@en;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:32:12.618Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8028>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2376>;
    dcterms:created "2019-01-24T15:01:01.000Z"^^xsd:dateTime;
    skos:prefLabel "Sin Po"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "Sin Po bestond vanaf 1910 tot 1 oktober 1965 en was een Chinese krant in Indonesië, die het Chinees nationalisme wilde ondersteunen in de overzeese gebieden. Ondanks de support voor het moederland had de krant wel sympathie voor de partijen die streden voor een onafhankelijk Indonesië en publiceerde het bijvoorbeeld als eerst het Indonesische volkslied. Vanwege de sterk anti-Japanse houding van de krant werd deze tijdens de bezetting verboden, werden veel journalisten van de krant opgepakt en dook hoofdredacteur Kwee Kek Beng onder. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4763>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7776> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Event>;
