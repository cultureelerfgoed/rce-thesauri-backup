    dcterms:created "2018-03-07T08:56:04.000Z"^^xsd:dateTime;
    skos:prefLabel "Strijdend Nederland-groep"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote """De Strijdend Nederland-groep was een verzetsgroep rondom het illegale blad Strijdend Nederland (nr. 789 in L. Winkel, De Ondergrondse Pers)  dat vanaf 1 augustus 1943 tot en met 17 april 1945 in Kampen werd uitgegeven. Het blad was opgericht door G. Spanhaak en had tot doel de verzetsgeest onder de bevolking wakker te houden. De groep stond onder leiding van Roelof Jan Dam, rector van het Gereformeerd Gymnasium van Kampen en vertegenwoordiger van Trouw voor de vier noordelijke provinciën. 
"""@nl;
    skos:altLabel "Persgroep Strijdend Nederland"@nl, "Strijdend Nederland groep"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/6061> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
