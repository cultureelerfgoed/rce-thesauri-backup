    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/640x480/4be88f9e-818d-38e0-6685-04113c194353.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/a5e75650-0259-11e7-904b-d89d6717b464/media/4be88f9e-818d-38e0-6685-04113c194353"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2026>;
    dcterms:created "2020-07-28T06:39:42.000Z"^^xsd:dateTime;
    skos:prefLabel "Hoogte-experimenten"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Hoogte-experimenten werden van maart 1942 tot augustus 1942 in Dachau uitgevoerd. Het onderzoek was ten behoeve van de Duitse Luchtmacht uitgevoerd, om de menselijke grenzen op het gebied van extreme hoogte te ontdekken. Voor deze experimenten werden gevangenen in een lagedrukkamer geplaatst, waarna de druk werd opgevoerd. Vele proefpersonen stierven."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9099> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "Luca Crippa, & Maurizio Onnis, Het meisje dat bleef leven. Een jonge vrouw zoekt naar sporen van haar ouders die verdwenen tijdens de Tweede Wereldoorlog (Amsterdam: Meulenhoff Boekerij B.V., 2018)"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2020-09-15T11:42:10.000Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/en/4/4c/Dachau_cold_water_immersion.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://en.wikipedia.org/w/index.php?title=File:Dachau_cold_water_immersion.jpg&oldid=887335732"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2026>;
    dcterms:created "2020-07-28T06:53:32.000Z"^^xsd:dateTime;
    skos:prefLabel "Onderkoelingsexperimenten"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Onderkoelingsexperimenten werden van augustus 1942 tot mei 1943 uitgevoerd in concentratiekamp Dachau ter behoeve van de Duitse Luchtmacht. Het doel van het onderzoek was om uit te vinden wat de beste behandelmethode was voor onderkoelde Duitse soldaten. Proefpersonen moesten drie uur lang in een tank met ijskoud water zitten. Bij de andere onderzoeksmethode stonden de gevangenen urenlang en zonder kleding buiten tot lichaamsdelen onderkoeld waren."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9100> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "Luca Crippa, & Maurizio Onnis, Het meisje dat bleef leven. Een jonge vrouw zoekt naar sporen van haar ouders die verdwenen tijdens de Tweede Wereldoorlog (Amsterdam: Meulenhoff Boekerij B.V., 2018)"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2020-07-29T07:52:41.000Z"^^xsd:dateTime;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2026>;
    dcterms:created "2020-07-28T07:14:22.000Z"^^xsd:dateTime;
    skos:prefLabel "Malaria-experimenten"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Malaria-experimenten werden van februari 1942 tot april 1945 in Dachau uitgevoerd om de immuniteit voor en behandeling van malaria te onderzoeken. Gevangenen kregen een injectie met extracten uit de speekselklieren van malariamuggen toegediend, of werden direct gestoken door dit insect."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9101> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2020-07-29T07:51:24.000Z"^^xsd:dateTime;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2026>;
    dcterms:created "2020-07-28T07:27:45.000Z"^^xsd:dateTime;
    skos:prefLabel "Gasexperimenten"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Gas-experimenten werden ten behoeve van de Duitse Wehrmacht uitgevoerd tussen september 1939 en april 1945 in concentratiekamp Sachsenhausen en Natzweiler. Nazi-artsen wilden het effect van mosterdgas toetsen, door eerst gevangenen te verwonden en vervolgens de wonden te infecteren met dit gas. Ook moesten proefpersonen het gas inhaleren, in vloeibare vorm opdrinken of werd het geïnjecteerd met een naald."@nl;
    skos:altLabel "Mosterdgas-experimenten"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9102> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2020-09-15T12:33:52.000Z"^^xsd:dateTime;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2026>;
    dcterms:created "2020-07-28T07:40:15.000Z"^^xsd:dateTime;
    skos:prefLabel "Zeewaterexperimenten"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Zeewater-experimenten werden in Dachau vanaf juli 1944 uitgevoerd in opdracht van de Duitse Luchtmacht en Marine. De SS-artsen moesten een methode verzinnen om zeewater drinkbaar te maken. Proefpersonen werden in vier groepen verdeeld. De eerste groep kreeg niks te drinken, de tweede alleen zeewater, de derde behandeld zeewater en de vierde ontzilt water. Himmler gaf instructies om Roma en Sinti als proefpersonen te gebruiken."@nl;
    skos:altLabel "zoutwater-experimenten"@nl, "salzwasser experiment"@nl, "salt water experiment"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9103> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "Luca Crippa, & Maurizio Onnis, Het meisje dat bleef leven. Een jonge vrouw zoekt naar sporen van haar ouders die verdwenen tijdens de Tweede Wereldoorlog (Amsterdam: Meulenhoff Boekerij B.V., 2018)"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2020-07-29T07:51:47.000Z"^^xsd:dateTime;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2026>;
    dcterms:created "2020-07-28T08:47:50.000Z"^^xsd:dateTime;
    skos:prefLabel "Sulfonamidenexperimenten"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Sulfonamidenexperimenten werden vanaf juli 1942 tot september 1943 uitgevoerd in concentratiekamp Ravensbrück ten behoeve van de Duitse strijdmachten. Proefpersonen werden opzettelijk verwond en geïnfecteerd met onder andere streptokok- en tetanusbacteriën. Vervolgens werden de infecties verergerd door hout- en glassplinters om de wonden daarna te behandelen met sulfonamiden."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9104> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "Luca Crippa, & Maurizio Onnis, Het meisje dat bleef leven. Een jonge vrouw zoekt naar sporen van haar ouders die verdwenen tijdens de Tweede Wereldoorlog (Amsterdam: Meulenhoff Boekerij B.V., 2018)"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2020-07-29T07:52:07.000Z"^^xsd:dateTime;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2026>;
    dcterms:created "2020-07-28T09:40:17.000Z"^^xsd:dateTime;
    skos:prefLabel "Regeneraties en transplantaties"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Bot-, spier- en zenuwregeneraties en bottransplantaties werden van september 1942 tot december 1943 uitgevoerd in concentratiekamp Ravensbrück. De betrokken artsen verwijderden grote stukken bot, spieren en zenuwen bij de proefpersonen, zonder dat zij daar toestemming voor vroegen, met als gevolg invaliditeit en verminking."@nl .
  
