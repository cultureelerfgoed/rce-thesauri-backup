    skos:prefLabel "Aktion Erntefest"@de, "Aktion Erntefest"@en, "Aktion Erntefest"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Aktion Erntefest (Operatie Oogstfeest) was de codenaam voor de op 3 en 4 november 1943 uitgevoerde massamoord op meer dan 40.000 joden. De executies vonden plaats in de concentratiekampen Majdanek, Poniatowa en Trawniki als reactie op opstanden in onder meer de vernietigingskampen Treblinka en Sobibor en vormden het einde van de Aktion Reinhard."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/kampen/5025>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
