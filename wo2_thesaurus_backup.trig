    skos:prefLabel "Kamp Café Lauenroth en Berentz in Walbeck"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De groep gevangenen uit het tentenkamp bij Walbeck werd na 8 weken ondergebracht in de danszalen van café Lauenroth en Berentz in Walbeck. Ze werden tewerkgesteld bij bedrijven in de omgeving."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/18647> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    dcterms:modified "2022-02-09T11:59:39.444Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/17443>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/e/e8/Two_survivors_of_Nordhausen_among_corpses.jpg/1280px-Two_survivors_of_Nordhausen_among_corpses.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://en.wikipedia.org/wiki/Boelcke-Kaserne_concentration_camp#/media/File:Two_survivors_of_Nordhausen_among_corpses.jpg";
    dcterms:source "https://en.wikipedia.org/wiki/Boelcke-Kaserne_concentration_camp"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/3718>;
    dcterms:created "2022-02-02T14:48:32.308Z"^^xsd:dateTime;
    skos:prefLabel "Boelcke-Kaserne"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Boelcke-Kaserne was een subkamp van concentratiekamp Mittelbau-Dora en gevestigd in een voormalig kazernecomplex van de Lufwaffe in Nordhausen, Duitsland. Het grensde aan verschillende dwangarbeidskampen en gevangenen werden er achtergelaten om te sterven nadat ze arbeidsongeschikt waren verklaard. Het kamp bestond slechts drie maanden maar er stierven bijna 3000 van de 6000 gevangenen. Ruim 1000 gevangenen kwamen om tijdens het bombardement op Nordhausen door de Royal Air Force op 3 en 4 april 1945. Op 11 april 1945 werd het kamp door de Amerikanen bevrijd."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/18664> .
  
