    dcterms:source "https://nl.wikipedia.org/wiki/Oranjewacht"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/5418>;
    dcterms:created "2021-10-19T10:06:34.323Z"^^xsd:dateTime;
    skos:prefLabel "Eerste proces tegen Oranjewacht"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "Het eerste proces tegen de Oranjewacht vond plaats tussen 27 oktober en 15 november 1941 bij de Hoge Raad in Den Haag. Veertien verzetsleden stonden terecht. Voor verboden wapenbezit en spionage bij vliegveld Leeuwarden kregen negen de doodstraf. De Duitsers namen hier geen genoegen mee en er volgde een tweede proces. De gevangenen werden van het Oranjehotel naar Kamp Amersfoort getransporteerd."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/17733> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-03-02T14:23:08.362Z"^^xsd:dateTime, "2026-03-02T14:23:08.497Z"^^xsd:dateTime;
