    skos:prefLabel "Executie Gorssel"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Executie in Gorssel vond plaats op 24 september 1944, waarbij zes burgers door de Sicherheitsdienst werden geëxecuteerd. Dit gebeurde onder leiding van SD-Untersturmführer Ludwig Heinemann, die persoonlijk al politieman Jacob Meijer, die weigerde de gijzelaars op te pakken, te Vorden had geëxecuteerd. De executies waren represaillemaatregelen als gevolg van diverse verzetsacties."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4629>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
