    dcterms:source "https://de.wikipedia.org/w/index.php?title=SS-Baubrigade&oldid=188459396"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2355>, <https://data.niod.nl/WO2_Thesaurus/20717>;
    dcterms:created "2019-12-06T09:17:53.000Z"^^xsd:dateTime;
    skos:prefLabel "SS-Baubrigaden"@nl, "SS-Baubrigaden"@de, "SS-Baubrigaden"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De SS-Baubrigaden (SS-Bouwbrigade, SS-BB) waren een type mobiele subkampen die vanaf september 1942 na geallieerde bombardementen in Duitse steden werden ingezet voor bouwactiviteiten, puinruimen en het bergen van lijken. Vanaf maart 1943 werden de Baubrigaden ook ingezet in de wapenindustrie en voor het herstel van infrastructuur. Een Baubrigade bestond meestal uit ongeveer 1000 niet-Joodse mannelijke concentratiekampgevangenen voornamelijk uit Buchenwald, Neuengamme en Sachsenhausen. Van september 1942 tot oktober 1944 waren er vijf Baubrigaden actief, SS-BB I tot en met SS-BB V."@nl;
    skos:altLabel "SS Baubrigaden"@nl, "SS-Baubrigade"@nl, "SS-bouwbrigade"@nl, "SS-Baubrigades"@nl .
  
