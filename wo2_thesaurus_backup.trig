    <http://schema.org/startDate> "1944-01-24"^^xsd:date;
    dcterms:source "https://wikimiddenbrabant.nl/Moordaanslag_Piet_Gerrits,_Nieuwlandstraat_24_januari_1944"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2683>;
    dcterms:created "2025-10-08T14:05:43.334Z"^^xsd:dateTime;
    skos:prefLabel "Moordaanslag op Piet Gerrits Tilburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De moordaanslag op Piet Gerrits in Tilburg vond plaats op 24 januari 1944. Gerrits was een in Tilburg gevreesde en gehate NSB-politieagent. Het verzet besloot hem uit de weg te ruimen, omdat Gerrits vermoedde dat er gesjoemeld was met persoonsbewijzen van een Joods echtpaar. De aanslag mislukte en diverse mensen moesten dit met de dood bekopen."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
