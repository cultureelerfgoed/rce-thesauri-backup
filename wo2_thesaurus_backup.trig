    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/265c5675-fd58-d543-a47d-4c5e16983d2c/media/332823a3-7620-3ff4-dad6-c54660a13c50";
    dcterms:source "https://merwedegijzelaars.nl/werkplek/4/bussing-brandweer-braunschweig"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/6390>;
    dcterms:created "2022-02-01T10:30:12.950Z"^^xsd:dateTime;
    skos:prefLabel "Werkplek Büssing Brandweer in Braunschweig"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Van de Merwedegijzelaars van het transport op 7 juli 1944 vanuit Kamp Amersfoort die in Braunschweig uit moesten stappen ging een deel bij de Brandweer van de firma Büssing werken. Door de vele geallieerde bombardementen op fabrieken in Braunschweig was er veel te doen voor de Brandweer."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/18631> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    dcterms:modified "2022-02-09T10:28:43.880Z"^^xsd:dateTime;
