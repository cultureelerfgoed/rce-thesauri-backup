    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/9259>;
    <http://schema.org/startDate> "1944-09-18"^^xsd:date;
    dcterms:source "http://monument-rozenoord.nl/18-september-1944/"@nl;
