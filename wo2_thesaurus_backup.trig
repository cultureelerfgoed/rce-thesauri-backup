    skos:broader <https://data.niod.nl/WO2_Thesaurus/1686>, <https://data.niod.nl/WO2_Thesaurus/locations/9639>;
    dcterms:created "2019-03-08T11:12:18.000Z"^^xsd:dateTime;
    skos:prefLabel "Huis van Bewaring Zutphen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het Huis van Bewaring in Zutphen bleef tijdens de bezetting in gebruik als gevangenis en werd onder meer door de Sicherheitsdienst gebruikt, met aan het hoofd hier de beruchte Ludwig Heinemann. In/nabij de gevangenis bracht de SD vier politiek gevangenen om het leven; twee op 26 maart en twee op 30 maart. Heinemann had eind maart 1945 de opdracht gekregen de gevangenis te ontruimen, waarna hij op eigen initiatief besloot om tot moord over te gaan. "@nl;
    skos:altLabel "Huis van Bewaring te Zutphen"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/7906>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4673>;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
