    skos:prefLabel "Prinses Margriet Babyhuis (Groningen)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "Het Prinses Margriet Babyhuis was een opvangplek voor dertien Amsterdamse baby's in de Hongerwinter. Het initiatief kwam van Sieneke Botjes, een Groningse kinderjuf. De kinderen konden gedurende de laatste maanden van de oorlog tot aan augustus 1945 aansterken. "@nl;
    skos:altLabel "Babyhuis"@nl;
