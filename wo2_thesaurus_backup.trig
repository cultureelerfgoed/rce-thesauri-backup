    dcterms:created "2020-08-22T11:52:13.000Z"^^xsd:dateTime;
    skos:prefLabel "Fusillade Rozenoord - 18 september 1944"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 18 september 1944 werden zes mannen gefusilleerd bij Rozenoord aan de Amsteldijk.Tot op heden is het niet duidelijk of de mannen zijn gefusilleerd vanwege een misdaad waarvan zij verdacht werden of als represaillemaatregel zijn gefusilleerd."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9288> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
