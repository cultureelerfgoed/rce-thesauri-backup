    skos:prefLabel "Burgemeesterscursus der NSB"@nl, "'Burgemeesterscursus der NSB'"@de,
      "'Burgemeesterscursus der NSB'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Burgemeesterscursus der NSB was opgezet omdat de NSB in weerwil van de eigen bestuurlijke ambities bijna geen geschikte burgemeesterskandidaten kon leveren. Daarom werd in 1941 gestart met kortdurende schriftelijke cursussen om kandidaten de beginselen bij te brengen van het staatsrecht, het gemeenterecht en de gemeentefinanciën om hen klaar te stomen voor het ambt."@nl;
    skos:altLabel "Burgemeesterscursus"@nl, "Burgemeesterscursus van de NSB"@nl, "Burgemeesterscursussen"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/1738> .
  
