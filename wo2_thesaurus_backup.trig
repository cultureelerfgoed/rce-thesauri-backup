    <http://schema.org/startDate> "1945-03-08"^^xsd:date;
    dcterms:source "https://www.tracesofwar.nl/sights/73181/Executie-Monument-Riedsterweg.htm"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/9271>;
    dcterms:created "2020-09-23T09:03:55.000Z"^^xsd:dateTime;
    skos:prefLabel "Fusillade in Dongjum"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 8 maart 1945 werden aan de Riedsterweg in Dongjum vijf burgers die gevangen zaten door de bezetter gefusilleerd. De fusillade was een represaillemaatregel voor de aanslag op Grietje Sinnema, de tolk en secretaresse van de staf van de 'Abteilung für Ernährung und Landwirtschaft' te Franeker. Deze 19-jarige boerendochter uit Ried regelde voor deze instantie de paardenvorderingen en hooileveringen ten behoeve van de Duitse Wehrmacht. "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9508> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
