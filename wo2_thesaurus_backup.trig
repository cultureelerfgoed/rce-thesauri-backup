    skos:prefLabel "Arrestatie en liquidatie leden van de KP Zuid-Limburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 5 september 1944 werden drie leden van Knokploeg Zuid-Limburg door de Duitsers gearresteerd. Dick Meulenkamp wist te ontkomen. Joep Francotte en Sjeng Coenen werden zwaar mishandeld en bij de Cauberg in Valkenburg doodgeschoten."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/5569> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/18851> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "https://www.historischanloo.nl/executies/"@de, "https://www.historischanloo.nl/projecten/onderduikershol/"@de;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:26:51.168Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/16972>;
