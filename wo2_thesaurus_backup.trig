    <http://schema.org/location> "Randwijk";
    <http://schema.org/startDate> "1944-09-29"^^xsd:date;
    <http://schema.org/endDate> "1945-04-02"^^xsd:date;
    dcterms:source "https://www.spannendegeschiedenis.nl/locatie/randwijk-de-britten-overrompeld/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1922>;
    dcterms:created "2022-01-06T13:20:32.283Z"^^xsd:dateTime;
    skos:prefLabel "Evacuatie van Randwijk"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Evacuatie van Randwijk vond plaats na hevige gevechten tussen Engelse en Duitse troepen. Een groot deel van het dorp werd verwoest en er vielen 5 burgerslachtoffers. Op 29 september 1944 moesten de inwoners van Randwijk daarom het dorp verlaten naar Zetten of Herveld. Randwijk werd frontgebied en bleef verboden terrein tot de bevrijding in april 1945."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/18589> a <http://schema.org/Thing>, skos:Concept,
