    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/4/4d/The_Campaign_in_North_West_Europe_1944-45_B13712.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://en.wikipedia.org/wiki/Operation_Blackcock#/media/File:The_Campaign_in_North_West_Europe_1944-45_B13712.jpg";
    <http://schema.org/location> "Limburg";
    <http://schema.org/startDate> "1945-01-14"^^xsd:date;
    <http://schema.org/endDate> "1945-01-27"^^xsd:date;
    dcterms:source "https://en.wikipedia.org/w/index.php?title=Operation_Blackcock&oldid=864244559"@de;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3557>;
    dcterms:created "2018-10-25T12:17:49.000Z"^^xsd:dateTime;
    skos:prefLabel "Operatie Blackcock"@nl, "Operation Blackcock"@de, "Operation Blackcock"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Operatie Blackcock was een Britse militaire operatie tussen 14 en 27 januari 1945 in Limburg, met als doel het front te verleggen richting de Roer. Tijdens deze operatie werd Montfort gebombardeerd, met 186 slachtoffers tot gevolg. De operatie was een geallieerd succes."@nl .
  
