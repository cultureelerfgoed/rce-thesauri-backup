    skos:prefLabel "Afdeling Emigratie Joodsche Raad"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De afdeling Emigratie van de Joodsche Raad gaf advies bij het aanvragen van visa en verzoeken tot repatriëring. Het bood hulp bij het invullen van de formulieren voor een verzoek tot uitreizen. Als een 'Ausreise' was verleend verzorgde het bureau dollarpassages. Aan het hoofd stond mevrouw G. van Tijn en het was gevestigd aan de Lijnbaansgracht 366 in Amsterdam."@nl;
    skos:altLabel "Afdeeling Emigratie Joodsche Raad"@nl, "Afdeling Emigratie Joodse Raad"@nl,
      "Afdeling Emigratie der Joodsche Raad"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/18545> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-06-07T14:35:23.799Z"^^xsd:dateTime;
