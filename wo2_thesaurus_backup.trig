    dcterms:source "https://www.tracesofwar.nl/sights/104341/Executie-Monument-Van-Harinxmakanaal.htm"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/9271>;
    dcterms:created "2020-09-23T08:24:12.000Z"^^xsd:dateTime;
    skos:prefLabel "Fusillade in Dronrijp"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote """Op 11 april 1945 werden door de bezetter bij het Harinxmakanaal in Dronrijp dertien verzetsmannen gefusilleerd. Dit was een represaille voor een sabotageorder van het hoofdkwartier van de NBS in Friesland, 'Sabotage op weg, rail en water'. De bezetter mocht niet de gelegenheid krijgen naar Duitsland te ontkomen. De gevechtsgroep Franeker zorgde voor een ontsporing van een Wehrmachtslocomotief met 26 wagens.
 """@nl .
  
