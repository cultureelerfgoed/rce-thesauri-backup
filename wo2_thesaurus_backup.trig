    dcterms:created "2023-12-07T11:24:19.273Z"^^xsd:dateTime;
    skos:prefLabel "Liquidatie Marinus Adrianus Simonis"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Liquidatie van Marinus Adrianus Simonis vond plaats op 17 februari 1945 op de provinciaalse weg ten zuiden van Heienoord. Simonis was NSB-burgemeester van Goudswaard, Piershil en Nieuw-Beijerland. Hij was op 13 februari 1945 samen met zijn zoon in het gemeentehuis overvallen en bedreigd door KP Groep Zinkweg. Simonis liet als represaille tientallen mannen oppakken voor tewerkstelling in Schouwen. Als reactie besloot de KP om Simonis te liquideren. "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/20616> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
