    <http://schema.org/startDate> "1944-09-24"^^xsd:date;
    dcterms:source "https://wikimiddenbrabant.nl/Fusillade_Willem_II_kazerne,_Ringbaan-Zuid_24_september_1944"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/9271>;
    dcterms:created "2025-10-08T09:08:53.605Z"^^xsd:dateTime;
    skos:prefLabel "Fusillade bij Willem II-kazerne Tilburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De fusillade van de gebroeders Appels en Willem van de Voort bij de Willen II-kazerne in Tilburg vond plaats op 24 september 1944. Tijdens een inval van de Bredase Feldgendarmerie in een houtzagerij in Udenhout worden  bedrijfsleider Willem van de Voort en de eigenaars Jan en Adrianus Appels gearresteerd. Ze worden vanuit Breda overgebracht naar de Willem-II-kazerne waar ze gedwongen worden hun eigen graf te graven. Zonder proces worden ze gefusilleerd. Op 26 september 1947 worden hun lichamen gevonden op het terrein van de Willem II kazerne."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/21833> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
