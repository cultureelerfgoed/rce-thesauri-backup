    dcterms:created "2019-11-06T12:14:26.000Z"^^xsd:dateTime;
    skos:prefLabel "Het Dagblad"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het Dagblad was een verzetsblad dat vanaf 5 oktober 1944 tot 7 mei 1945 in een oplage van 100 tot 2500 stuks dagelijks verscheen in Zwijndrecht. Als officiële berichtendienst van de Binnenlandse Strijdkrachten in Zwijndrecht en omgeving was Het Dagblad zeer succesvol als waarschuwingsmiddel tegen bijvoorbeeld razzia's."@nl;
    skos:altLabel "Het DAGBLAD; 'Nederland zal herrijzen' "@nl .
  
