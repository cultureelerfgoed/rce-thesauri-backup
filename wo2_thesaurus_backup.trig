    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/035ae59a-025a-11e7-904b-d89d6717b464/media/89ad0041-bffb-17a4-2ac0-b6a957ab4688";
    <http://schema.org/location> "Javazee";
    <http://schema.org/startDate> "1942-03-01"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/wiki/Tweede_Slag_in_de_Javazee"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3536>;
    dcterms:created "2021-10-20T13:49:55.077Z"^^xsd:dateTime;
    skos:prefLabel "Tweede Slag in de Javazee"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Tweede Slag in de Javazee vond plaats op 1 maart 1942. De ABDA-schepen die de (Eerste) Slag in de Javazee en de Slag in de Straat Soenda hadden overleefd probeerden zich terug te trekken naar Australië. Het ging hierbij om de Britse zware kruiser HMS Exeter, de Britse torpedojager HMS Encounter en de Amerikaanse torpedojager USS Pope. Ze wisten echter de Japanse eskaders niet te ontwijken en werden allen tot zinken gebracht. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/17765> a <http://schema.org/Thing>, skos:Concept,
