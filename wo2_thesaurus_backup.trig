    skos:prefLabel "Rijkscommissie voor Oorlogspleegkinderen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Rijkscommissie voor Oorlogspleegkinderen was een naoorlogse commissie, die opgericht was om de toekomst van gedupeerde kinderen te bepalen. Op 8 mei 1945 kwam de commissie tot stand en bestond uit 25 Joodse en niet-Joodse leden. Het waren verschillende partijen, die vaak niet tot consensus konden komen wat betreft het lot van Joodse kinderen. "@nl;
    skos:altLabel "Bureau Oorlogspleegkinderen"@nl, "Voogdijcommissie voor Oorlogspleegkinderen"@nl,
      "Besluit Oorlogspleegkinderen"@nl;
