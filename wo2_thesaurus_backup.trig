      "https://mijngelderland.nl/inhoud/verhalen/de-evacuatie-van-millingen-aan-de-rijn"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1922>;
