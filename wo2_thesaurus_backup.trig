    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>;
    dcterms:created "2019-11-18T10:58:28.000Z"^^xsd:dateTime;
    skos:prefLabel "De Baanbreker: sociaal-democratisch orgaan (Editie voor Zuid-Hollland)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Baanbreker: sociaal-democratisch orgaan (Editie voor Zuid-Hollland) was een verzetsblad dat van 14 februari 1945 tot mei 1945 in een oplage van 750 tot 1000 stuks wekelijks werd uitgegeven in Den Haag. Het blad was een lokale editie van het door de Sociaal-Democratische Arbeiderspartij uitgegeven Utrechtse 'De Baanbreker: sociaal-democratisch orgaan', dat eerder ook in Zuid-Holland werd gedistribueerd. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4672> .
  
  <https://data.niod.nl/WO2_Thesaurus/8766> a <http://schema.org/Thing>, skos:Concept;
