    <http://schema.org/startDate> "1941-01-26"^^xsd:date;
    <http://schema.org/endDate> "1941-01-27"^^xsd:date;
    dcterms:source "https://mass.cultureelerfgoed.nl/beemsterdijk"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3511>;
    dcterms:created "2021-11-01T13:40:24.723Z"^^xsd:dateTime;
    skos:prefLabel "Scheepsramp Beemsterdijk"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Scheepsramp met de Beemsterdijk vond plaats van 26 tot 27 januari 1941. De Beemsterdijk was een Nederlands schip van de Nederlandsch-Amerikaansche Stoomvaart Maatschappij (later de Holland-Amerika Lijn) dat op 21 januari vanuit Glasgow naar Cardiff vertrok. Op 26 januari liep het schip per ongeluk op een Britse zeemijn, maar het schip bleef in eerste instantie drijven. Er werd gewacht op sleepboten, maar door slecht weer begon het de volgende ochtend plotseling te zinken. Binnen enkele minuten verdween het schip in de diepte. 39 bemanningsleden kwamen om het leven, slechts drie zeelieden overleefden de ramp."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/1870> .
  
