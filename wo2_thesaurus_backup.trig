    dcterms:source "https://www.japansekrijgsgevangenkampen.nl/Tantoei.htm"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/4877>;
    dcterms:created "2018-11-19T08:58:03.000Z"^^xsd:dateTime;
    skos:prefLabel "Krijgsgevangenkamp Tantoei "@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Krijgsgevangenkamp Tantoei functioneerde van 3 februari 1942 tot 10 september 1945 voor circa 1250 gevangen, waarvan er circa 400 het kamp niet hebben overleefd. Hoewel er in het kamp slachtoffers vielen bij geallieerde bombardementen op Tantoei, vielen de meeste slachtoffers door het harde regime van uithongering en mishandelingen. Na de overplaatsing van circa 500 gevangenen op 26 oktober 1942 en de vrijlating, op 26 april 1942, van inheemse KNIL-militairen, zaten er voor namelijk Australische krijgsgevangenen in het kamp.         "@nl;
    skos:altLabel "Tantui"@nl;
