    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/e/e5/Auschwitz_Mengele_Block_10.jpg/500px-Auschwitz_Mengele_Block_10.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/w/index.php?title=Blok_10&oldid=55533684#/media/Bestand:Auschwitz_Mengele_Block_10.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://opac-gonext.oclc.org/DB=8/XMLPRS=Y/PPN?PPN=86145569X>;
    <http://schema.org/endDate> "1945-01-27"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Blok_10&oldid=55533684"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/9331>;
    dcterms:created "2020-07-24T14:20:24.000Z"^^xsd:dateTime;
    skos:prefLabel "Blok 10"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Blok 10 was in concentratiekamp Auschwitz het 'kampziekenhuis'. Hier werden medische experimenten op gevangenen uitgevoerd, variërend van huidonderzoeken tot dodelijke injecties in het hart of de longen. Josef Mengele verrichtte hier zijn onderzoek naar tweelingen. Naast hem waren de belangrijkste SS-artsen Carl Clauberg, Horst Schumann en August Hirt."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9098> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Luca Crippa, & Maurizio Onnis, Het meisje dat bleef leven. Een jonge vrouw zoekt naar sporen van haar ouders die verdwenen tijdens de Tweede Wereldoorlog (Amsterdam: Meulenhoff Boekerij B.V., 2018)"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
