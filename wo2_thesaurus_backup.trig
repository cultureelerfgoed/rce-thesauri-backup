    dcterms:references "NIOD"@nl, "L. de Jong, Het Koninkrijk der Nederlanden in de Tweede Wereldoorlog. Deel 5, Maart ’41-Juli ‘42 (’s-Gravenhage : Martinus Nijhoff, 1974)"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
