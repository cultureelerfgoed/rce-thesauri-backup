    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Verloren_transport&oldid=53520498"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/3654>, <https://data.niod.nl/WO2_Thesaurus/2005>,
