    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Shermantank die nu in het Canadapark te Doetinchem in te vinden werd gebruikt bij de bevrijding van Doetinchem."@nl;
    skos:altLabel "M4A4 Sherman tank"@nl;
