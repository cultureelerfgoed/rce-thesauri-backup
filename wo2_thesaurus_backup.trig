    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/5bff302a-025a-11e7-904b-d89d6717b464/media/2953d424-f487-1ac0-5567-0f8b4ea24adc";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/2f7aafa2-025a-11e7-904b-d89d6717b464/media/165b1e6a-bcf2-cddf-f0b5-b828ccba4099>;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Nederlandse_Arbeidsdienst&oldid=46947471"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1944-09-10"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Nederlandsche Arbeidsdienst (NAD) was een nationaalsocialistische dienst die werkverschaffing organiseerde. Lidmaatschap was aanvankelijk op vrijwillige basis. Vanaf begin 1942 werd een halfjarige dienstplicht ingevoerd voor mannen en vrouwen tussen de 18 en 23 jaar. Naast activiteiten als marcheren, sporten, zingen en lessen in nationaalsocialistisch gedachtegoed, moesten de leden voornamelijk landbouw- en graafwerkzaamheden uitvoeren. De mannen werden in NAD-kampen ondergebracht. De NAD werd op 6 oktober 1940 opgericht en werd op 10 september 1944 opgeheven omdat vrijwel alle NAD’ers waren weggevlucht uit angst voor de naderende geallieerde troepen."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/locations/8381>, <https://data.niod.nl/WO2_Thesaurus/10172>,
      <https://data.niod.nl/WO2_Thesaurus/events/7625>, <https://data.niod.nl/WO2_Thesaurus/21250>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2152>, <https://data.niod.nl/WO2_Thesaurus/20640>;
    dcterms:created "2017-04-05T09:10:51.000Z"^^xsd:dateTime;
    skos:prefLabel "Nederlandsche Arbeidsdienst"@nl, "'Nederlandsche Arbeidsdienst'"@de,
      "'Nederlandsche Arbeidsdienst'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Nederlandsche Arbeidsdienst (NAD), ingesteld op 6 oktober 1940, had als doel het Nederlandse volk op te voeden in nationaalsocialistische geest. Voorloper van de Arbeidsdienst was de Opbouwdienst, waar Nederlandse soldaten van het ontbonden leger dienst in moesten nemen. Toetreding tot de NAD gebeurde aanvankelijk op vrijwillige basis, maar vanwege het gebrek aan belangstelling werd vanaf begin 1942 overgegaan tot het oproepen van verplichte categorieën. Naast activiteiten als exercitie, sport, zang en vorming, bestonden de arbeidsdiensten uit vooral ontginningen en graafwerkzaamheden. "@nl;
    skos:altLabel "N.A.D."@nl, "Nederlandse Arbeidsdienst"@nl, "Nederlandschen Arbeidsdienst"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/kampen/6010>, <https://data.niod.nl/WO2_Thesaurus/9059>,
