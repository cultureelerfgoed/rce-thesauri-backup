    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Wikipedia:Wikiproject/Verzetskranten/Beginnetjes/De_baanbreker_(verzetsblad,_Rotterdam)&oldid=46727004"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>;
    dcterms:created "2019-11-18T11:11:57.000Z"^^xsd:dateTime;
    skos:prefLabel "De Baanbreker; sociaal-democratisch orgaan (Rotterdam)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Baanbreker; sociaal-democratisch orgaan (Rotterdam) was een verzetsblad daar werd uitgeven door de Sociaal-Democratische Arbeiderspartij en in een oplage van circa 3000 stuks dagelijks verscheen in Rotterdam. Van september 1944 tot maart 1945 waren het nagestencilde exemplaren van de Utrechtse editie en van maart 1945 tot mei 1945 van de Zeister editie. "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8767> a <http://schema.org/Thing>, skos:Concept;
