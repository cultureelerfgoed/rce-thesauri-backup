    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Een officier van justitie van een bijzondere strafkamer bij een arrondissementsrechtbank leidde vanaf 1950 het opsporingsonderzoek. De officier van justitie nam de taken van de procureurs-fiscaal over. Ze konden bepaalde zaken zelf afhandelen door besluiten een verdachte vrij te laten of niet verder te vervolgen, maar wel eventueel maatregelen op te leggen."@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/19586>;
    dcterms:created "2024-05-23T08:06:27.179Z"^^xsd:dateTime;
    skos:prefLabel "Officier van Justitie van Bijzondere strafkamer arrondissementsrechtbank"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "Een officier van justitie van een bijzondere strafkamer bij een arrondissementsrechtbank leidde vanaf 1950 het opsporingsonderzoek. De officier van justitie nam de taken van de procureurs-fiscaal over. Ze konden bepaalde zaken zelf afhandelen door besluiten een verdachte vrij te laten of niet verder te vervolgen, maar wel eventueel maatregelen op te leggen."@nl;
    skos:altLabel "Officier van Justitie van bijzondere strafkamer"@nl, "Officier van Justititie (Bijzondere Strafkamer)"@nl;
