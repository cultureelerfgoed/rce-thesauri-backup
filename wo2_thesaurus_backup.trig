    dcterms:source "https://www.archieven.nl/nl/zoeken?mivast=0&mizig=210&miadt=298&miaet=1&micode=785&minr=913813&miview=inv2&milang=nl"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1942-05-31"^^xsd:date;
    <https://data.niod.nl/EventsWO2/location> "Schaarsbergen";
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4580>, <https://data.niod.nl/WO2_Thesaurus/2244>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/6032>;
    dcterms:created "2019-03-06T12:45:17.000Z"^^xsd:dateTime;
    skos:prefLabel "N.I.V.O."@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Nederlandse Inrichting voor Volkse opvoeding (N.I.V.O.) was gevestigd in het voormalig Sanatorium Koningsheide in Schaarsbergen dat voor dit doel verbouwd werd. De school heeft maar korte tijd bestaan; op 20 oktober 1941 startten de eerste lessen, en in het voorjaar van 1942 sloot de school alweer haar deuren. Doordat de school voor Groot-Duitse georiënteerde NSB’ers zoals Meinoud Rost van Tonningen niet Duits genoeg was en daarover ruzie op hoog niveau ontstond sloot de school alweer snel na oprichting en werd het gebouw in gebruik genomen door de Luftwaffe."@nl;
    skos:altLabel "Nederlandse Inrichting voor Volkse Opvoeding"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
