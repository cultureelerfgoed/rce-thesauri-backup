    dcterms:created "2023-08-22T12:51:49.422Z"^^xsd:dateTime;
    skos:prefLabel "Plaatsvervangend Sectieleider"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De plaatsvervangend sectieleider trad op als plaatsvervanger van de sectieleider van een NSB-front (bijvoorbeeld het Economisch Front) of een NSB-gilde (bijvoorbeeld het Opvoedersgilde). De plaatsvervanger van de leider van een NSB-korps (bijvoorbeeld het Nationaal-Socialistisch Ambtenaren Korps) werd Plaatsvervangend korpsleider genoemd. Naast de territoriale indeling in kringen, districten en gewesten die aansloot op de territoriale indeling van de NSB, kenden de fronten, gilden van NSB dikwijls ook een indeling in secties (afdelingen) van bedrijfsgroepen, vakgebieden of beroepen.  "@nl;
    skos:altLabel "Plaatsvervangend Korpsleider"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2244> .
  
