    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/18064>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://imageviewer.kb.nl/ImagingService/imagingService?id=ddd:010309852:mpeg21:p001:image&w=1000";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://resolver.kb.nl/resolve?urn=ddd:010309852:mpeg21:a0004";
    <http://schema.org/location> "Golf van Bengalen";
    <http://schema.org/startDate> "1942-04-06"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3511>;
    dcterms:created "2021-10-20T13:10:11.615Z"^^xsd:dateTime;
    skos:prefLabel "Scheepsramp Batavia"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Scheepsramp met de ms Batavia vond plaats op 6 april 1942. De ms Batavia was een Nederlands schip van de Koninklijke Paketvaart Maatschappij dat na de val van Nederlands-Indië naar Calcutta was ontkomen. Op 3 april vertrok het schip richting Karachi (Pakistan) zonder konvooi. Het werd op 6 april aangevallen door Japanse vliegtuigen en uiteindelijk door een Japanse kruiser tot zinken gebracht. Er vielen 4 dodelijke slachtoffers onder de bemanning. De schipbreukelingen troffen aan land de overlevenden van de schepen Van der Capellen en Banjoewangi. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/1870> .
  
