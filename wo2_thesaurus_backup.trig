    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote """Transport Amsterdam - Kamp Schoorl, 11-06-1941 bracht 310 jonge joodse mannen binnen. Ze werden opgepakt tijdens de razzia van 11 juni 1941 in Amsterdam. Een deel kwam uit het Joodse werkdorp Wieringermeer.
"""@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/18466> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:04:35.156Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/10291>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/ams/thumb/350x350/875653fb-5297-73c3-6123-9691ae50245a.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://archief.amsterdam/beeldbank/detail/2ac2f8c9-dd26-4003-9b5e-8a2532262472";
    <http://schema.org/location> "Schiphol";
    <http://schema.org/startDate> "1941-06-03"^^xsd:date;
    dcterms:source "https://www.4en5mei.nl/oorlogsmonumenten/zoeken/2153/dieren-monument-voor-theo-dobbe"@nl;
    skos:relatedMatch <https://data.niod.nl/WO2_Thesaurus/events/9082>, <https://data.niod.nl/WO2_Thesaurus/18467>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2681>;
    dcterms:created "2021-12-02T14:36:36.859Z"^^xsd:dateTime;
    skos:prefLabel "Aanslag op telefooncentrale Schiphol, 3 juni 1941"@nl, "Angriff auf Telefonzentrale Schiphol, 3. Juni 1941"@de,
      "Attack on telephone exchange Schiphol, June 3, 1941"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Op 3 juni 1941 vond er een aanslag op de telefooncentrale van de Duitse Luftwaffe op vliegveld Schiphol plaats. Er viel één zwaargewonde. Op 14 mei 1941 had het verzet ook al een villa aan de Bernard Zweerskade in Amsterdam-Zuid opgeblazen waarin Duitse officieren waren gehuisvest. Als represaille voor beide aanslagen vond er op 11 juni een razzia plaats waarbij ruim driehonderd Joden werden opgepakt. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/18467> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Y.N. Ypma, Friesland annis Domini 1940-1945, Dokkum 1953"@nl,
      "J. Presser, Ondergang. De vervolging en verdelging van het Nederlandse Jodendom 1940-1945, Den Haag, 1985"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:05:09.145Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/18468>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/ams/thumb/350x350/90e21422-8228-b58d-33b6-0456c0c2fbef.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://archief.amsterdam/beeldbank/detail/11703e1a-9ddb-49e1-b69c-58133b987f21";
    <http://schema.org/location> "Amsterdam";
    <http://schema.org/startDate> "1941-05-14"^^xsd:date;
    dcterms:source "https://www.4en5mei.nl/oorlogsmonumenten/zoeken/2153/dieren-monument-voor-theo-dobbe"@nl;
    <https://data.niod.nl/organizationsWO2/caused> <https://data.niod.nl/WO2_Thesaurus/events/9082>;
    skos:relatedMatch <https://data.niod.nl/WO2_Thesaurus/events/9082>, <https://data.niod.nl/WO2_Thesaurus/18466>,
      <https://data.niod.nl/WO2_biografieen/Theo-Dobbe>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2681>;
    dcterms:created "2021-12-02T15:17:54.927Z"^^xsd:dateTime;
    skos:prefLabel "Aanslag Bernard Zweerskade Amsterdam, 14 mei 1941"@nl, "Angriff Bernards Zweerskade Amsterdam, 14. Mai 1941"@de,
      "Attack on Bernard Zweerskade Amsterdam, May 14, 1941"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Op 14 mei 1941 blies de verzetsgroep Dobbe een villa aan de Bernard Zweerskade in Amsterdam op. Hier waren Duitse officieren in gehuisvest. Er was veel schade, maar geen slachtoffers. Toen er op 3 juni weer een aanslag door het verzet werd gepleegd hielden de Duitsers als represaille een razzia op 11 juni 1941. Ruim 300 Joden werden opgepakt en naar Mauthausen gedeporteerd."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/18469> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    dcterms:modified "2022-03-09T15:48:32.367Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/dd3bbb82-cdcf-27fd-4c7c-8e7658a6b96f.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/ff3b8b26-025a-11e7-904b-d89d6717b464/media/dd3bbb82-cdcf-27fd-4c7c-8e7658a6b96f";
    dcterms:source "https://duitslandinstituut.nl/artikel/21134/het-onbekende-lot-van-gevluchte-joodse-kinderen"@nl,
      "https://www.dokin.nl/"@nl;
    skos:relatedMatch <https://data.niod.nl/WO2_Thesaurus/events/4386>, <https://data.niod.nl/WO2_Thesaurus/18471>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2011>;
    dcterms:created "2021-12-06T12:14:17.367Z"^^xsd:dateTime;
    skos:prefLabel "Kindertransporten naar Nederland"@nl, "Kindertransport nach Niederlande"@de,
      "'Kindertransport' to the Netherlands"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Na de Kristallnacht vond in Nederland overleg plaats over de opvang van Joodse vluchtelingen uit nazi-Duitsland. De regering kondigde aan 1.500 kinderen op te willen nemen. De kinderen kwamen met kindertransporten die door de overheid waren georganiseerd de grens over. Maar er werden door ouders zelf ook groepen georganiseerd. In totaal kwamen ongeveer 2.000 Joodse kinderen uit Duitsland en Oostenrijk naar Nederland. Ze kwamen in opvangkampen terecht en bij pleeggezinnen."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/18470> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Vera K. Fast, Kindertransporten 1938-1948. Hoe duizenden Joodse kinderen uit de klauwen van de nazi's werden gered, 2019"@nl;
