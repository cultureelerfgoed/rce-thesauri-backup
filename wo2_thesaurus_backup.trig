    <http://schema.org/location> "Amsterdam";
    <http://schema.org/startDate> "1942-06-04"^^xsd:date;
    <http://schema.org/endDate> "1942-06-06"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/wiki/Oranjewacht"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/5418>;
    dcterms:created "2021-10-19T10:25:50.129Z"^^xsd:dateTime;
    skos:prefLabel "Tweede proces tegen Oranjewacht"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "Van 4-6 juni 1942 vond in Amsterdam het tweede proces tegen de Oranjewacht plaats. De Duitsers waren na het eerste proces niet tevreden met de uitspraak. Ook in dit proces kregen weer negen verzetsleden de doodstraf. De executies vonden plaats in het Fort bij Rijnauwen. De overige gevangenen gingen terug naar Kamp Amersfoort."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
