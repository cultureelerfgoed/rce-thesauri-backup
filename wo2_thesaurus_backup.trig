    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Fort_Bijlmer#/media/Bestand:Fort_bijlmer_in_1939.jpg";
    dcterms:source "https://nl.wikipedia.org/wiki/Fort_Bijlmer"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/6141>;
    dcterms:created "2021-08-03T12:27:43.670Z"^^xsd:dateTime;
    skos:prefLabel "Fort Bijlmer"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Fort Bijlmer werd in 1868 gebouwd om Amsterdam te beschermen tegen vijanden vanuit met name richting Utrecht. In verband met militair-technologische ontwikkelingen werd het fort steeds minder belangrijk. In 1936 werd zelfs de Rijksstraatweg recht over het fortterrein getrokken. Na de Tweede Wereldoorlog werd het fort gebruikt als executieplaats voor oorlogsmisdadigers zoals Ans van Dijk. In de jaren zestig werd het fort geruimd voor de nieuwe wijk Bijlmer."@nl;
    skos:altLabel "Fort Duivendrecht"@nl, "Fort in den Laander- en Westbijlmerpolder"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/17306> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    dcterms:modified "2021-08-10T08:52:47.486Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/17307>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/fbd71266-5c75-4a3c-6066-29815419f1f2.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/819d1bbc-025a-11e7-904b-d89d6717b464/media/fbd71266-5c75-4a3c-6066-29815419f1f2";
    dcterms:source "https://nl.wikipedia.org/wiki/Rabenhauptkazerne"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1873>;
    dcterms:created "2021-08-03T12:56:32.758Z"^^xsd:dateTime;
    skos:prefLabel "Rabenhauptkazerne"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Rabenhauptkazerne aan de Hereweg in de stad Groningen werd in de Tweede Wereldoorlog ingericht voor de Duitse Wehrmacht. Verzetsdeelnemers Harm Bakker en Broer de Witte werden hier na de Meistaking van 1943 geëxecuteerd. Op 14 april 1945 werd de kazerne door de Canadezen in brand geschoten en daarna gesloopt."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/2661> .
  
  <https://data.niod.nl/WO2_Thesaurus/17308> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:04:48.457Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/9576>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/46c1c6f8-04ab-26a9-65aa-4e56ce656407.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/65ee2c94-025a-11e7-904b-d89d6717b464/media/46c1c6f8-04ab-26a9-65aa-4e56ce656407";
    dcterms:source "https://www.erasmusmagazine.nl/2021/05/04/boek-in-de-maak-over-verzet-van-rotterdamse-studenten-tijdens-de-tweede-wereldoorlog/"@nl,
      "https://www.4en5mei.nl/oorlogsmonumenten/zoeken/3754/rotterdam-monument-in-de-erasmus-universiteit"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2392>;
    dcterms:created "2021-08-04T12:24:38.563Z"^^xsd:dateTime;
    skos:prefLabel "Erasmus Universiteit Rotterdam"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "In 1913 werd de Nederlandsche Handels-Hoogeschool (NHH) opgericht. In 1939 werd een naamsverandering doorgevoerd naar Nederlandse Economische Hogeschool (NEH) en in 1973 werden de Medische Faculteit Rotterdam en de NEH samengevoegd tot de Erasmus Universiteit Rotterdam. Het Erasmus University College is gevestigd in de voormalige bibliotheek van Rotterdam, één van de weinige gebouwen die de Tweede Wereldoorlog hebben overleefd. Aan de NEH studeerden in 1940 zo'n 800 studenten. Bij de hogeschool waren veel bedrijven betrokken en een groot aantal bedrijven werkte met de Duitsers samen. Het motto was dan ook doorgaan met onderwijs. Maar er waren ook studenten betrokken bij het verzet, zoals de jaarclub De Keien van het Rotterdamse Studentencorps (RSC). Door oorlogsgeweld zijn 52 studenten van de NEH om het leven gekomen."@nl;
    skos:altLabel "Nederlandsche Handels-Hoogeschool "@nl, "Nederlandse Economische Hogeschool"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/17309> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:05:00.184Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/9382>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://studiezaal.nijmegen.nl/HttpHandler//icoon.ico?icoonfromxmlbeschr=360521";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://studiezaal.nijmegen.nl/detail.php?id=360521";
    dcterms:source "https://www.ru.nl/over-ons/overradboud/geschiedenis/tweede-wereldoorlog/"@nl,
      "https://www.ru.nl/@671954/historie/"@nl, "https://historiek.net/het-verzet-van-de-radboud-universiteit/77976/"@nl,
      "https://nl.wikipedia.org/wiki/Radboud_Universiteit"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2392>;
    dcterms:created "2021-08-04T12:53:53.566Z"^^xsd:dateTime;
    skos:prefLabel "Radboud Universiteit"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Katholieke Universiteit Nijmegen werd op 17 oktober 1923 opgericht. Na de capitulatie van Nederland werden in september 1940 de colleges hervat. In de oorlog werd de universiteit zwaar getroffen. De hoogeleraren Robert Regout en Titus Brandsma werden vanwege verzetsactiviteiten gearresteerd en kwamen in concentratiekamp Dachau om het leven. Tijdens het bombardement van Nijmegen in 1944 verloor de universiteit veel van haar gebouwen. De rector magnificus Bernardus Hermesdorf weigerde om studenten een loyaliteitsverklaring aan de bezetter voor te leggen waardoor de universiteit op 10 april 1943 haar deuren moest sluiten. In maart 1945 ging de universiteit weer open. "@nl;
    skos:altLabel "Katholieke Universiteit Nijmegen"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/1731> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "Van Dale Groot Woordenboek van de Nederlandse Taal (14e druk, 2005)"@nl;
