    <https://data.niod.nl/organizationsWO2/startDate> "1940-05-29"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/640x480/4d0ca68b-4866-0672-cc44-923688c28975.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://beeldbankwo2.nl/nl/beelden/detail/d1e797d8-0259-11e7-904b-d89d6717b464/media/4d0ca68b-4866-0672-cc44-923688c28975"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/d1eb0ff8-0259-11e7-904b-d89d6717b464/media/7189b7c1-99ac-2953-12b7-46f4add25b19>;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Generalkommissariat_f%C3%BCr_Finanz_und_Wirtschaft&oldid=48694092"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-09"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Het Generalkommissariat für Finanz und Wirtschaft was het door de Duitse bezetter ingestelde departement van financiën en economie. Het had als doel de Nederlandse economie in te zetten voor de Duitse oorlogsindustrie. Het departement was onderdeel van het Rijkscommissariaat, het burgerlijk bestuur van bezet Nederland. Het departement werd op 29 mei 1940 ingesteld met Hans Fischböck aan het hoofd."@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/corporaties/6098>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4656>;
    dcterms:created "2018-01-22T13:24:06.000Z"^^xsd:dateTime;
    skos:prefLabel "Generalkommissariat für Finanz und Wirtschaft"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Generalkommissariat für Finanz und Wirtschaft (financiën en economie) werd op 29 mei 1940 ingesteld met aan het hoofd dr. Hans Fischböck. Vier Generalkommissariate, die deel uitmaakten van het Reichskommissariat, gaven sturing aan de Nederlandse bestuursorganen en hielden toezicht op hun functioneren. Het Generalkommissariat für Finanz und Wirtschaft had tot bevoegdheid alle aangelegenheden van de departementen van Financiën, Economische Zaken, Waterstaat, Sociale Zaken (behalve volksgezondheid en culturele en sociale jeugdzorg) en de Nederlandse Posterijen. De twee hoofddoelen van zijn beleid waren het dienstbaar maken van de Nederlandse economie aan de Duitse oorlogsproductie en het inkapselen van Nederland in een Europese ‘Großraumwirtschaft’."@nl;
    skos:altLabel "Generaalkommissariaat Financiën en Economie"@nl, "Generaalkommissariaat voor Financiën en Economie"@nl,
      "Generalkommissar für Finanz und Wirtschaft"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/5823> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "L. de Jong, Het Koninkrijk der Nederlanden in de Tweede Wereldoorlog, Deel 4. Mei ’40- maart ’41. Eerste helft (s’-Gravenhage 1972-1974) "@nl;
