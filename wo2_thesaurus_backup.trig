    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/315a4f94-025a-11e7-904b-d89d6717b464/media/d3e01c74-6070-40cd-64ec-cd8f1fde6bc6>,
      <https://beeldbankwo2.nl/nl/beelden/detail/315b6244-025a-11e7-904b-d89d6717b464/media/e284873f-a84c-28ef-de5c-830a1552f9a4>;
