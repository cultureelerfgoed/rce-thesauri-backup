    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/4319>, <https://data.niod.nl/WO2_Thesaurus/1670>;
    dcterms:created "2017-06-22T10:50:44.000Z"^^xsd:dateTime;
    skos:prefLabel "Burgau"@nl, "Burgau"@de, "Burgau"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Kamp Burgau was een buitenkamp of Aussenlager van kamp Dachau in de Duitse plaats Burgau. Burgau functioneerde van 3 februari 1945 tot 24 april 1945. In het kamp zaten 120 mannelijke gevangenen uit Augsburg-Pfersee en 1000 vrouwelijk gevangenen uit Bergen-Belsen en Ravensbrück gevangen die moesten werken in Messerschmitt AG fabrieken. Zeker 18 personen kwamen om. Burgau werd op 24 april 1945 ontruimd en per trein en per voet vervoerd naar buitenkamp Kaufering VI – Türkheim. Bij deze dodenmars stierven nog eens 60 personen. Burgau fungeerde na de bevrijding als interneringskamp en daarna als vluchtelingenkamp voor 'displaced persons'."@nl;
    skos:altLabel "KZ-Außenlager Burgau"@nl, "Aussenlager Burgau"@nl, "Werkkamp Burgau"@nl,
      "Buitenkamp Burgau"@nl;
