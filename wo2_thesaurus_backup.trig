    <http://schema.org/location> "Eindhoven";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/2399184a-025a-11e7-904b-d89d6717b464/media/8485b8a2-58db-f130-dba0-fee011b4207c>,
