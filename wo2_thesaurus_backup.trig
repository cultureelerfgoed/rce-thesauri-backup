    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/wo2nedindieThema> "Inval Japan";
    <http://schema.org/startDate> "1942-01-03"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Archibald_Wavell&oldid=49256003"@nl;
    <http://schema.org/description> "De Britse generaal sir Archibald Wavell wordt benoemd tot opperbevelhebber van ABDACOM. ABDACOM wordt op 15 januari operationeel. Het hoofdkwartier wordt gevestigd in Grand Hotel Lembang bij Bandoeng. Wavells ondercommandanten zijn de Amerikaanse admiraal Thomas C. Hart (marine), de Britse air vice-marshall sir Richard E.C. Peirse (luchtstrijdkrachten) en de Nederlandse luitenant-generaal KNIL Hein ter Poorten (leger)."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2350>, <https://data.niod.nl/WO2_Thesaurus/corporaties/7729>,
      <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2019-03-19T13:56:14.000Z"^^xsd:dateTime;
    skos:prefLabel "Benoeming Sir Archibald Wavell tot opperbevelhebber ABDACOM "@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Benoeming Sir Archibald Wavell tot opperbevelhebber ABDACOM vindt plaats op 3 januari 1942. De ABDACOM, een samenwerkingsverband tussen Amerikaanse-, Britse-, Australische- en Nederlandse Strijdkrachten, werd op 15 januari 1942 operationeel. Het hoofdkwartier wordt gevestigd in Grand Hotel Lembang bij Bandoeng."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8172> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2022-04-11T07:58:20.030Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8028>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/wo2nedindieThema> "Inval Japan";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/640x480/cdbe0cf2-a3ff-86c9-a06f-627b0ce123eb.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/edd85e86-025a-11e7-904b-d89d6717b464/media/cdbe0cf2-a3ff-86c9-a06f-627b0ce123eb";
    <http://schema.org/location> "Indonesië ";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://www.openarch.nl/show.php?archive=nim&identifier=e7d3524a-4bc3-0382-dcd5-c09202b4213d>,
      <https://www.delpher.nl/nl/kranten/view?coll=ddd&identifier=ddd:011176510:mpeg21:a0001>,
      <https://www.delpher.nl/nl/kranten/view?coll=ddd&identifier=ddd:110583727:mpeg21:a0001>;
    <http://schema.org/startDate> "1942-02-11"^^xsd:date;
    <http://schema.org/endDate> "1942-02-12"^^xsd:date;
    <http://schema.org/description> "Japanse grondtroepen en parachutisten bezetten de Minahassa in Noord-Celebes. De Japanse gevechtsgroep Sakaguchi, die ongeveer 6.000 man telt, landt op het olie-eiland Tarakan voor de kust van Oost-Borneo. Tarakan wordt verdedigd door een KNIL-garnizoen van 1.365 man. Voor de Japanse landing plaatsvindt wordt een omvangrijk vernielingsplan uitgevoerd: de olie-installaties worden vernietigd en een voorraad stookolie van 100.000 ton gaat in vlammen op. De territoriaal commandant van het KNIL, luitenant-kolonel S. de Waal, geeft zich met zijn troepen op 12 januari over. "@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2350>, <https://data.niod.nl/WO2_Thesaurus/events/16381>,
      <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2019-03-19T14:20:11.000Z"^^xsd:dateTime;
    skos:prefLabel "Inval Minahassa en Tarakan"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Inval Minahassa en Tarakan, respectievelijk gelegen in Noord-Celebes in Oost-Borneo door Japanse troepen vindt gelijktijdig plaats van 11 op 12 januari 1942. Japanse grondtroepen en parachutisten bezetten de Minahassa in Noord-Celebes terwijl de Japanse gevechtsgroep Sakaguchi, die ongeveer 6.000 man telt, landt op het olie-eiland Tarakan voor de kust van Oost-Borneo. De territoriaal commandant van het KNIL, luitenant-kolonel S. de Waal, geeft zich met zijn troepen op 12 januari 1942 over."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4551> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8173> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2026-10-15T06:33:17.400Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/18209>;
