    skos:prefLabel "Weer Afdeeling van de NSB heft zichzelf op"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote """Per 1 januari 1936 heft de Weer Afdeeling van de NSB zichzelf op, vooruitlopend op de Wet op Weerkorpsen die particuliere paramilitaire partijlegers verbiedt. De WA'ers worden ontheven uit hun gelofte en traden zij formeel toe tot de reguliere organisatie van de NSB.
"""@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
