    dcterms:created "2019-04-23T14:12:19.000Z"^^xsd:dateTime;
    skos:prefLabel "Nieuwe Synagoge Nijmegen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "De Nieuwe Synagoge Nijmegen aan de Gerard Noodtstraat werd door de Duitsers gevorderd en gebruikt als opslagplaats voor onder andere geconfisqueerde radiotoestellen tijdens de bezetting. De hele inboedel is door NSB’ers en Duitsers vernield. Zo werden er wandschilderingen vernietigd en uit de gebrandschilderde ramen is de Davidster geslagen en zijn de Tora-rollen en andere rituele voorwerpen verloren gegaan."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/locations/8380> a <http://schema.org/Thing>, skos:Concept,
