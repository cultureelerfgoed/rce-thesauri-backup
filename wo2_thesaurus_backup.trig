    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/996c331a-583e-4470-9fa7-2fc91e4da38c.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/de7f78ac-025a-11e7-904b-d89d6717b464/media/996c331a-583e-4470-9fa7-2fc91e4da38c";
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Vrijwilligerslegioen_Nederland&oldid=42707506"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-08"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Het Vrijwilligerslegioen Nederland was een onderdeel van de Waffen-SS, het legeronderdeel van de Schutzstaffel (SS). Het Vrijwilligerslegioen Nederland streed vanaf juli 1941 aan het Oostfront. De eenheid bestond uit zo’n 6.000 Nederlandse vrijwilligers, voornamelijk leden van de Nationaal-Socialistische Beweging (NSB). In augustus 1943 veranderde de naam in 4. SS-Freiwilligen-Panzergrenadier Brigade Nederland en in februari 1945 in 23. SS-Freiwilligen-Panzergrenadier-Division Nederland. Nederlanders die bij de Waffen-SS gingen, verloren na de oorlog hun Nederlandse nationaliteit."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/events/7841>, <https://data.niod.nl/WO2_Thesaurus/events/7853>,
      <https://data.niod.nl/WO2_Thesaurus/events/7843>, <https://data.niod.nl/WO2_Thesaurus/events/7842>,
