    <http://schema.org/location> "Harderwijk";
    <http://schema.org/startDate> "1945-04-18"^^xsd:date;
    dcterms:source "https://www.omroepgelderland.nl/gemist?pagina=programma&programma=217"@nl;
    <http://schema.org/name> "Harderwijk";
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/locations/8100>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/6983>;
    dcterms:created "2018-11-03T09:43:07.000Z"^^xsd:dateTime;
    skos:prefLabel "Befreiung von Harderwijk"@de, "Liberation of Harderwijk"@en, "Bevrijding Harderwijk"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Op 18 april 1945 is Harderwijk bevrijd door het Canadese leger. Het Canadese leger had als opdracht om richting het IJsselmeer op te rukken om zo een laatste ontsnapping voor de Duitsers onmogelijk te maken. Omdat er op 17 april 1945 berichten kwamen vanuit het Harderwijker verzet dat er veel Duitsers in Harderwijk waren, hadden de Canadezen het plan om Harderwijk te beschieten met hun tanks. Door moedig optreden van het verzet heeft men dit voorkomen en is Harderwijk bevrijd zonder bloedvergieten."@nl .
  
