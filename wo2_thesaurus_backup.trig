    dcterms:created "2021-06-14T13:10:18.046Z"^^xsd:dateTime;
    skos:prefLabel "Bevrijding Hoorn"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De bevrijding van Hoorn vond plaats op 8 mei 1945. Al vanaf 5 mei werd voorzichtig de vlag uitgehangen maar pas op 8 mei kwamen de Canadezen in Hoorn aan. Ze werden verwelkomd door burgemeester Leemhorst. De aan de Duitsers loyale burgemeester Zondervan was inmiddels gearresteerd.  "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/15281> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
