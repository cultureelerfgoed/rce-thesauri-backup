    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/9d3635c0-025a-11e7-904b-d89d6717b464/media/8cfda8a4-1cb4-e1ab-9e41-9134c92df2a7";
    dcterms:source "https://nl.wikipedia.org/wiki/Stalag_XI-A"@nl, "https://krijgsgevangen.nl/stalag-xi-a-altengrabow/"@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/6411>;
    dcterms:created "2017-06-26T14:05:03.000Z"^^xsd:dateTime;
    skos:prefLabel "Stalag XI-A"@nl, "Stalag XI-A"@de, "Stalag XI-A"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Stalag XI-A was een Duits krijgsgevangenkamp bij Altengrabow in de deelstaat Saksen-Anhalt. Tijdens de Eerste Wereldoorlog was het krijgsgevangenkamp Dörnitz Altengrabow. Vanaf november 1939 werd het Stalag XI-A. Krijgsgevangenen van vele nationaliteiten waren hier gehuisvest. Voor de meesten was het een doorgangskamp maar sommigen kwamen in Arbeitskommando's terecht. Op 1 januari 1945 telde het kamp meer dan 60.000 gevangenen. Van mei tot juli 1943 fungeerde Stalag XI-A als eerste opvangkamp voor Nederlandse krijgsgevangenen. Stalag IV-B Mühlberg nam daarna deze functie over. Na de oorlog werd het gebied overgenomen door eenheden van het Rode Leger uit de Sovjet-bezettingszone in Duitsland."@nl;
    skos:altLabel "Altengrabow"@nl, "Stalag XI A"@nl, "Stalag XI-A Altengrabow"@nl, "Dörnitz"@nl,
      "Stalag 341"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/7645> .
  
