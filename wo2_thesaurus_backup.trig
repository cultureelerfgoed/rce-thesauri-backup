    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Herdenkingen zijn bijeenkomsten waar plechtig aandacht wordt geschonken aan gebeurtenissen uit het verleden, waar men bijvoorbeeld stil staat bij de gevallenen van de Tweede Wereldoorlog."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/1594> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/VosJ>;
    dcterms:modified "2022-11-11T15:22:26.701Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/bfc83b58-627d-2b47-a395-e8c02c6bfdaf.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/af49c084-0259-11e7-904b-d89d6717b464/media/bfc83b58-627d-2b47-a395-e8c02c6bfdaf";
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Speciaal:Citeren&page=Nationale_Dodenherdenking&id=47376217"@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/demoadmin>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1593>;
    dcterms:created "2016-08-01T19:19:01.000Z"^^xsd:dateTime;
    skos:prefLabel "Totengedenktag"@de, "Remembrance of the Dead"@en, "Dodenherdenking"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Dodenherdenking is een gebeurtenis die jaarlijks plaatsvindt op 4 mei, waarbij de Nederlandse slachtoffers van de Tweede Wereldoorlog,  oorlogssituaties en vredesmissies nadien worden herdacht."@nl;
    skos:altLabel "Nationale herdenking"@nl;
    skos:definition "De Dodenherdenking vindt jaarlijks in Nederland plaats op 4 mei, met onder andere twee minuten stilte om 20.00 uur. De landelijke herdenking op de Dam in Amsterdam wordt georganiseerd door het Nationaal Comité 4 en 5 mei, terwijl honderden andere plaatselijke comités eigen herdenkingen organiseren. De Dodenherdenking wordt ook wel de Nationale Herdenking of de Nationale Dodenherdenking genoemd."@nl .
  
