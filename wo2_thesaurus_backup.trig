    <http://schema.org/startDate> "1945-04-10"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Twentol-drama&oldid=52210934"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/7131>;
    dcterms:created "2018-11-02T14:03:27.000Z"^^xsd:dateTime;
    skos:prefLabel "Twentol-drama"@nl, "Twentol-Drama"@de, "Twentol tragedy"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Bij het Twentol-drama in Deventer op 10 april 1945 raakten acht verzetsstrijders, toen zij probeerden een brug over het Overijssels Kanaal voor de Canadese strijdkrachten beschikbaar te behouden, in een magazijn van de Twentol Smeerolie-Industrie in een vuurgevecht met Duitse soldaten. Twee verzetsmensen kwamen hierbij om het leven en vijf werden gevangen genomen en op 10 april, een half uur voor de bevrijding van Deventer, gefusilleerd."@nl;
    skos:altLabel "Twentol Drama"@nl, "Twentoldrama"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/7234> a <http://schema.org/Thing>, skos:Concept,
