      <https://data.niod.nl/WO2_Thesaurus/19556>, <https://data.niod.nl/WO2_Thesaurus/21352>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2700>, <https://data.niod.nl/WO2_Thesaurus/2657>;
