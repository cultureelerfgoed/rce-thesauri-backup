    dcterms:source "https://bersiapkampen.nl/Gevangenis%20Soebang.htm"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/b7354d29-49d5-4fe0-922a-3f3b5929fa84>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1631>, <https://data.niod.nl/WO2_Thesaurus/19098>;
    dcterms:created "2024-08-14T12:06:44.536Z"^^xsd:dateTime;
    skos:prefLabel "Soebang Gevangenis"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Soebang was een republikeins kamp in de plaats Soebang, ongeveer 40 km oostelijk van Purwakarta op Java. Het kamp was mogelijk ondergebracht in de gevangenis in Soebang. In dit kamp waren 71 mannen, vrouwen en kinderen geïnterneerd in de periode tussen 15 oktober 1945 en 10 juni 1946."@nl;
    skos:altLabel "Subang"@nl, "Soebang"@nl .
  
