    <http://schema.org/startDate> "1944-02-02"^^xsd:date;
    <http://schema.org/endDate> "1944-08-10"^^xsd:date;
    dcterms:source "https://historiek.net/slag-om-narva-estland-1944/71400/"@nl, "https://nl.wikiqube.net/wiki/Battle_of_Narva_(1944)"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3558>;
    dcterms:created "2021-06-24T09:15:24.293Z"^^xsd:dateTime;
    skos:prefLabel "Slag om Narva"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Slag om Narva vond plaats tussen 2 februari en 10 augustus 1944. Het Duitse en Russische leger vochten voor het bezit van de strategisch belangrijke Narva landengte. De militaire campagne bestond uit twee hoofdfasen: de strijd om het bruggenhoofd van Narva en de Slag bij Tannenberglinie. Aan Duitse kant vocht ook de brigade Nederland die bestond uit vrijwilligers, Waffen-SS'ers, de Oostfrontstrijders. Het was een van de zwaarste veldslagen en de verliezen aan beide kanten waren enorm. Toen Narva viel trokken de Duitsers zich terug en betrokken de Tannenberg-Stellung ten westen van Narva in de Blauwe Bergen."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/16882> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
