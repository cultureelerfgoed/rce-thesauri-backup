    dcterms:modified "2025-12-17T14:38:20.971Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://preserve2.archieven.nl/mi-37/fonc-gea/1584/889.jp2?format=thumb&miadt=37&miahd=1352279908&mivast=37";
