    dcterms:source "https://en.wikipedia.org/w/index.php?title=Communist_Party_of_Indonesia&oldid=876748992"@en;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/events/8407>;
