    dcterms:source "https://www.tracesofwar.nl/sights/719/Crossroads-Monument-Heteren.htm"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3557>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4886>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/4752>;
    dcterms:created "2019-02-26T08:00:36.000Z"^^xsd:dateTime;
    skos:prefLabel "Slag bij Crossroads"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Tijdens de Slag bij Crossroads op 5 oktober 1944 kruisten Amerikaanse soldaten van Easy Company van de 506th PIR, 101st Airborne Division het pad van zo'n 150 Duitse SS'ers. Ondanks de grote tegenstand wisten de Amerikanen stand te houden op de Randwijkse Rijndijk te Heteren. De slag komt voor in de aflevering Crossroads van de televisieserie Band of Brothers."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
