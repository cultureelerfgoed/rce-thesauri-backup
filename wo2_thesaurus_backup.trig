    <http://schema.org/name> "Apeldoorn";
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/locations/8033>, <https://data.niod.nl/WO2_Thesaurus/16887>;
