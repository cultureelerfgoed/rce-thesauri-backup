    skos:prefLabel "Stichting 500 Joodse Kinderen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Stichting 500 Joodse Kinderen werd opgericht nadat de Nederlandse regering na de oorlog had toegezegd om 440 Joods-Roemeense kinderen op te vangen. De Stichting huurde het gebouwencomplex van 'het Apeldoornsche Bosch', waar de kinderen van 1947 tot 1948 verbleven."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9250> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-08-03T11:08:49.168Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/kampen/3655>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/7/7e/Bundesarchiv_R_165_Bild-244-57%2C_Asperg%2C_Deportation_von_Sinti_und_Roma.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Zigeunervervolging#/media/Bestand:Bundesarchiv_R_165_Bild-244-57,_Asperg,_Deportation_von_Sinti_und_Roma.jpg"@nl;
    <http://schema.org/startDate> "1944-05-21"^^xsd:date;
    <http://schema.org/endDate> "1944-08-02"^^xsd:date;
    dcterms:source "https://westerborkportretten.nl/bronnen/het-zigeunerlager-in-auschwitz-birkenau"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/11456>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/3655>, <https://data.niod.nl/WO2_Thesaurus/2788>;
    dcterms:created "2020-08-18T06:32:45.000Z"^^xsd:dateTime;
    skos:prefLabel "'Zigeunerkamp' Auschwitz"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het ‘Zigeunerkamp’ was het gedeelte van Auschwitz voor opgepakte Sinti en Roma, officieel sectie B-IIe van Auschwitz II-Birkenau genaamd. Families werden, in tegenstelling tot de rest van het kamp, niet van elkaar gescheiden. De Duitsers hadden gemerkt dat het teveel chaos veroorzaakte bij de Sinti en Roma, bij wie familie een heilig begrip is. Het Zigeunerkamp werd daarom ook het 'Familienlager' genoemd. Barak 18 was het 'Holländerblock’ waar uit Nederland afkomstige Roma en Sinti werden ondergebracht. In de nacht van 2 op 3 augustus 1944 werden alle Sinti en Roma die toen nog in dit barak verbleven, zo'n 4200 mensen, uit het ‘Zigeunerkamp’ vergast."@nl;
    skos:altLabel "Familienlager"@nl, "Sectie B-IIe Auschwitz II-Birkenau"@nl, "Zigeunerlager"@nl,
      "Zigeunerfamilienlager"@nl, "Auschwitz II-Birkenau Sector B-IIe"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/9078>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9251> a <http://schema.org/Thing>, skos:Concept;
