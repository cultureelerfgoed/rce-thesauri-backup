    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://archief.amsterdam/beeldbank/detail/d059508f-0948-146e-23f2-ae4804296b05>;
    <http://schema.org/startDate> "1942-04-16"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/5054>;
    dcterms:created "2020-11-03T16:21:48.032Z"^^xsd:dateTime;
    skos:prefLabel "Beroving van Joodse diamanthandelaren"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Beroving van Joodse diamanthandelaren op de Amsterdamse Diamantbeurs vond plaats op 16 april 1942. De handelaren werden gedwongen hun diamantvoorraad à 23.000 tot 71.500 karaat in te leveren bij de Duitsers. Een dag later hield de Crisis Controledienst onder leiding van de Amsterdamse rechercheur Willem Klarenbeek een controle, de handelaren werden op grove en vernederende wijze gefouilleerd op eventueel achtergehouden diamanten."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
