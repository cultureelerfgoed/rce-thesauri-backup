    dcterms:created "2021-10-06T09:12:07.129Z"^^xsd:dateTime;
    skos:prefLabel "Oproep Joden Breda"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Op 27 augustus 1942 ontvingen ongeveer honderd Joodse Bredanaars de oproep om zich op 28 augustus te melden voor vertrek naar Duitsland. Enige dagen later vertrok van de verzamelplaats aan de Oude Vest een vijftigtal Joden richting Kamp Westerbork. Van de ruim tweehonderd Joden die begin 1942 in Breda woonden waren er aan het eind van dat jaar 100 ondergedoken en 50 gedeporteerd. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
