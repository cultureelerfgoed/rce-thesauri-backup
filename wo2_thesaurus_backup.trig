    <http://schema.org/name> "Eindhoven";
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/6983>;
    dcterms:created "2018-10-31T10:34:08.000Z"^^xsd:dateTime;
    skos:prefLabel "Liberation of Eindhoven"@en, "Befreiung von Eindhoven"@de, "Bevrijding Eindhoven"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De bevrijding van Eindhoven vond plaats op 18 september 1944. Vanuit het noorden kwam het Amerikaanse leger en vanuit het zuiden de Engelsen. Maar op 19 september werd Eindhoven door de Duitse Luftwaffe gebombardeerd. De Duitsers wilden de doorgangsroutes van het Britse legerkorps blokkeren. Er vielen 227 doden. "@nl .
  
