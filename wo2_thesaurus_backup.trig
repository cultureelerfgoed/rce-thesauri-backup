    skos:prefLabel "Inundaties rondom Rotterdam"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Inundaties rondom Rotterdam omvatte het gebied vanaf het oostelijk gelegen Kralingen tot aan Nieuwerkerk aan den IJssel en Noord-Oosten van Rotterdam tot aan Delft. De onderwaterzetting vond plaats in maart 1944 en werd door de Duitsers uitgevoerd om een verdedigingsgordel aan te leggen."@nl;
    skos:altLabel "Inundatie Delfland"@nl, "Inundatie Krimpen aan de Ijssel"@nl, "Inundatie Capelle aan de Ijssel"@nl,
      "Inundatie Overschie"@nl .
  
