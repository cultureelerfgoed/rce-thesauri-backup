      <https://beeldbankwo2.nl/nl/beelden/detail/07b8f71c-025a-11e7-904b-d89d6717b464/media/b0dd4a7c-ba5a-8461-4878-bdbc41ba4815>;
    <http://schema.org/startDate> "1942-04-07"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/1717>, <https://data.niod.nl/WO2_Thesaurus/events/8185>;
