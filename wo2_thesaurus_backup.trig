    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/7/78/Bezoek_aan_bataljon_Friesland_1-9_R.I._gelegerd_te_Tjimahi._Generaal_Doorman_s%2C_Bestanddeelnr_60-5-5.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/w/index.php?title=File:Bezoek_aan_bataljon_Friesland_1-9_R.I._gelegerd_te_Tjimahi._Generaal_Doorman_s,_Bestanddeelnr_60-5-5.jpg&oldid=709479560";
    dcterms:source "https://en.wikipedia.org/w/index.php?title=Friesland_Battalion&oldid=1095851262"@en,
      "https://friesfilmarchief.nl/av7502-bataljon-friesland-detailbeschrijving/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/10679>, <https://data.niod.nl/WO2_Thesaurus/20711>;
    dcterms:created "2023-01-10T08:57:00.268Z"^^xsd:dateTime;
    skos:prefLabel "Bataljon Friesland"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Bataljon Friesland, ook wel bekend als het 1ste Bataljon van het 9de Regiment Infanterie (I-9 RI), was een Nederlandse gevechtseenheid die op 16 september 1945 werd opgericht. Het bataljon bestond grotendeels uit Friese oorlogsvrijwilligers afkomstig uit Friese verzetsgroepen. Na training in Engeland en een taalcursus Maleis te hebben ontvangen, reisde het Bataljon Friesland in december 1945 per schip de Johan van Oldenbarneveldt naar Indonesië. De gevechtseenheid was actief op Midden-Java rondom Bandung tijdens de Indonesische Onafhankelijkheidsoorlog. In juli 1948 ging het Bataljon Friesland met het schip de Zuiderkruis terug naar Nederland."@nl;
    skos:altLabel "1ste Bataljon van het 9de Regiment Infanterie"@nl, "I-9 RI"@nl, "1-9 R.I."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
