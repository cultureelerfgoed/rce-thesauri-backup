    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/2669>;
    dcterms:created "2017-09-18T13:55:42.000Z"^^xsd:dateTime;
    skos:prefLabel "Nederlandse Verzetsorganisatie"@nl, "'Nederlandse Verzetsorganisatie'"@de,
      "'Nederlandse Verzetsorganisatie'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Nederlandse Verzetsorganisatie (NVO), ook wel  Groep Lex of Nederlandse Verzetsorganisatie “Strijdend Nederland” genoemd, was een verzetsgroep te Leiden rond Lex Bernard. De NVO was vanaf 1944 actief bij het verzorgen van onderduikers, onder wie ook Joodse onderduikers, en het regelen van distributiebescheiden en vervalste persoonsbewijzen en de uitgave van november 1944 tot mei 1945 van het illegale blad 'Strijdend Nederland : men rekent de uitslag niet, doch telt het doel alleen' (nr. 790 in L. Winkel, De Ondergrondse Pers)."@nl;
    skos:altLabel "Groep Lex"@nl, "NVO"@nl, "Nederlandse Verzetsorganisatie Strijdend Nederland"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
