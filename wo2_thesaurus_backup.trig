  <https://data.niod.nl/WO2_Thesaurus/locations/11278> a skos:Concept, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "54.159166666667"^^xsd:float;
