    skos:prefLabel "Nationaal-Socialistisch Museum"@nl, "'Nationaal-Socialistisch Museum'"@de,
      "'Nationaal-Socialistisch Museum'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Nationaal-Socialistisch Museum werd vanaf 1931 opgebouwd door H.L. Schuilenburg. In 1939 werden er kleine tentoonstellingen gehouden in Kringhuizen van de NSB. Op 1 oktober 1942 werd de verzameling ondergebracht in de Dienst Nationaal-Socialistisch Museum in het hoofdkwartier van de NSB in Utrecht. Op 2 september 1944 werd het een stichting. "@nl;
    skos:altLabel "Verzameling Schuilenburg"@nl, "Dienst Nationaal-Socialistisch Museum"@nl,
      "Stichting Nationaal-Socialistisch Museum"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/8587> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references """Documentatie : status en werkzaamheden van organisaties en instellingen uit de tijd der Duitse bezetting van Nederland, samengesteld ten behoeve van de Bijzondere Rechtspleging, op last van de Procureur-Fiscaal bij het Bijzonder Gerechtshof te Amsterdam. Amsterdam, 1947
"""@nl,
      "Notitie Samenvatting klachten Vervoersfront, december 1942. NSB-arch. inv.nr. 178."@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2024-08-12T12:03:08.672Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1941-03-01"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> <https://resolver.kb.nl/resolve?urn=urn:gvn:EVDO02:NIOD05_0657&role=thumbnail>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://resolver.kb.nl/resolve?urn=urn:gvn:EVDO02:NIOD05_0657"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-06"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Het Vervoersfront, opgericht op 1 maart 1941, was de vervoersorganisatie van de Nationaal-Socialistische Beweging (NSB). Het doel van het Vervoersfront was de vervoerssector onder nationaalsocialistische controle te brengen."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2101>, <https://data.niod.nl/WO2_Thesaurus/2244>;
    dcterms:created "2019-09-18T13:43:55.000Z"^^xsd:dateTime;
    skos:prefLabel "Vervoersfront"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Vervoersfront werd op 1 maart 1941 opgericht en was een NSB-organisatie. De organisatie werd geleid door F.D. Brands. Bij de leiding en de leden van deze organisatie ontstond onvrede over het uitblijven van maatregelen ten gunste van kleine ondernemers in de vervoersector. Toen het orgaan van de Vervoerfront deze kritiek uitte, werd het blad in 1942 door het Duitse gezag eerst verboden en daarna enige tijd onder preventieve censuur geplaatst. "@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Organization> .
  
