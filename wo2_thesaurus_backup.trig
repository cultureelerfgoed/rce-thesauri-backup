    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/wiki/File:Buchcover_zu_Mathias_Middelbergs_Buch_%C3%BCber_Hans_Calmeyer.jpg";
    dcterms:source "https://nl.wikipedia.org/wiki/Hans_Calmeyer"@nl;
    skos:relatedMatch <https://data.niod.nl/WO2_biografieen/Hans-Calmeyer>;
