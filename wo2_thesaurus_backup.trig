      <https://data.niod.nl/WO2_Thesaurus/corporaties/4580>, <https://data.niod.nl/WO2_Thesaurus/2352>;
    dcterms:created "2019-03-11T12:24:34.000Z"^^xsd:dateTime;
    skos:prefLabel "Freya-radarstation (Aalten)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Freya-radarstelling aan de Ringweg in Aalten was tijdens de Tweede Wereldoorlog een radarstation van de Duitsers. Deze radarstelling was onderdeel van een uitgebreid luchtverdedigingssysteem van de Luftwaffe en kon vliegtuigen tot op een afstand van ongeveer 150 kilometer signaleren. Bij dit radarstation waren ook ongeveer twaalf barakken gebouwd en het geheel werd beveiligd door loopgraven en een prikkeldraadafrastering en tevens was er een luchtdoelgeschut aanwezig."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
