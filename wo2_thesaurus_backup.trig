    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://studiezaal.erfgoedhuisweert.nl/detail.php?id=205165148";
    <http://schema.org/startDate> "1943-05-02"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/klijne>;
