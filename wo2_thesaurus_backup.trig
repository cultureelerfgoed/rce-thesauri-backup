    <http://schema.org/startDate> "1940-12-23"^^xsd:date;
    dcterms:source "https://en.wikipedia.org/wiki/SS_Breda"@de;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3511>;
    dcterms:created "2021-11-15T10:09:01.039Z"^^xsd:dateTime;
    skos:prefLabel "Scheepsramp Breda"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Scheepsramp met de Breda vond plaats op 23 december 1940. De Breda was een Nederlands schip van de Koninklijke Nederlandse Stoomboot Maatschappij dat vanaf 20 december in de haven van Oban (Schotland) lag. Op 23 december vond er een bombardement plaats van Duitse gevechtsvliegtuigen die o.a. de Breda raakten en tot zinken brachten. De gehele bemanning overleefde de ramp. Het wrak werd in 1968 aangewezen voor een NAVO-oefening voor duikers en ligt nog steeds in de haven van Oban."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/1870> .
  
