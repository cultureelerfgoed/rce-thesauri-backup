    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://www.japansekrijgsgevangenkampen.nl/Plattegrond%20Haischau_bestanden/image002.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://www.japansekrijgsgevangenkampen.nl/Plattegrond%20Haischau.htm"@nl;
    dcterms:source "https://www.japansekrijgsgevangenkampen.nl/Haischau%20(Hainan).htm"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/b7354d29-49d5-4fe0-922a-3f3b5929fa84>;
