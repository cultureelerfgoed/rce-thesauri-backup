    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Euthanasiecentrum_Grafeneck#/media/Bestand:Schloss_Grafeneck_28.03.2012.JPG";
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Euthanasiecentrum_Grafeneck&oldid=56014117"@nl;
