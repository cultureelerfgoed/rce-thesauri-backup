    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Kamp_Sandbostel#/media/Bestand:Bundesarchiv_Bild_146-2005-0146,_Sandbostel,_sowjetische_Kriegsgefangene.jpg";
    <http://schema.org/location> "Sandbostel";
    <http://schema.org/startDate> "1945-04-19"^^xsd:date;
    <http://schema.org/endDate> "1945-04-20"^^xsd:date;
    dcterms:source "https://www.stiftung-lager-sandbostel.de/more-languages/nederlands/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/3703>;
    dcterms:created "2021-10-11T14:10:47.447Z"^^xsd:dateTime;
    skos:prefLabel "Hongeropstand in Sandbostel"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "In de nacht van 19 op 20 april 1945 vond er een hongeropstand plaats in Stalag X B in Sandbostel. De SS was honderden gevangenen aan het verzamelen voor een transport toen een luchtalarm ervoor zorgde dat de bewakers voor korte tijd verdwenen. De schijnwerpers vielen uit en de keuken en voorraadruimten werden opengebroken. De posten op de wachttorens openden het vuur. Er vielen ongeveer 300 doden en enkele tientallen gevangenen wisten het kamp te ontvluchten. Diezelfde nacht werden honderden gevangenen door de SS naar Flensburg gebracht."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
