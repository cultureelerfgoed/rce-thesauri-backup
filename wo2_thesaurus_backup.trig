      <http://digitaal.zeeuwsebibliotheek.nl/foto/9d668e48-97d0-11e3-a37a-53fba619b6aa>;
    dcterms:source "https://www.4en5mei.nl/oorlogsmonumenten/monumenten_zoeken/oorlogsmonument/2177/kapelle%2C-frans-ereveld"@nl,
      "https://www.tracesofwar.nl/sights/579/Franse-Oorlogsbegraafplaats-Kapelle.htm"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/isPointofInterest> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3612>, <https://data.niod.nl/WO2_Thesaurus/locations/10250>;
    dcterms:created "2020-11-11T10:36:43.367Z"^^xsd:dateTime;
    skos:prefLabel "Franse Militaire Ereveld Kapelle"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "Het Franse ereveld in Kapelle herbergt de stoffelijke overschotten van 229 Franse militairen die tijdens de Tweede Wereldoorlog op Nederlands grondgebied zijn begraven. Van de 228 militairen zijn er 23 met Noord-Afrikaanse afkomst en 1 uit Syrië. Van de 22 Noord-Afrikaanse soldaten zijn 17 Marokkaans, 4 Algerijns en bij 2 is het precieze land van herkomst onbekend. Bij elk graf is een zerk van witte natuursteen geplaatst. Op de begraafplaats bevinden zich ook nog twee monumenten."@nl;
    skos:altLabel "Franse begraafplaats"@nl, "Franse Ereveld"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/10251> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "Erfgoedvereniging Heerlijkheid Hooge en Lage Zwaluwe"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-07-14T13:36:42.732Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/10258>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://service.archief.nl/gaf/api/file/v1/img/7b2717d1-cb3e-40b3-81c8-d4da56bc7560?h=1000";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://www.nationaalarchief.nl/onderzoeken/fotocollectie/aca79af4-d0b4-102d-bcf8-003048976d84";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <http://www.gahetna.nl/collectie/afbeeldingen/fotocollectie/zoeken/weergave/detail/q/id/aca797fc-d0b4-102d-bcf8-003048976d84>;
    dcterms:source "https://www.tracesofwar.nl/sights/70149/Vertrek-en-Eindpunt-Liniecrossers-Lage-Zwaluwe.htm"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/2669>;
    dcterms:created "2020-11-11T13:42:13.299Z"^^xsd:dateTime;
    skos:prefLabel "Liniecrossers Lage Zwaluwe"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Liniecrossers Lage Zwaluw gingen tussen het najaar van 1944 en mei 1945 vanuit Lage Zwaluwe naar Sliedrecht met gemotoriseerde kano’s en bootjes via de Merwede door de vijandelijke linies naar Sliedrecht. Men bracht vanuit het bevrijde Zuiden o.a. medicijnen naar het bezette gebied. Vanuit het bezette gebied naar het bevrijde Zuiden bracht men inlichtingen over Duitse stellingen en verdedigingswerken. Ook bracht men geallieerde militairen vanuit het bezette gebied naar het Zuiden. Eén van hen was de Engelse generaal John Hackett die in de slag om Arnhem gewond was geraakt."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/10294> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-06-21T14:24:36.391Z"^^xsd:dateTime;
    dcterms:source "https://de.wikipedia.org/w/index.php?title=Schutzhaft&oldid=203311371"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1977>, <https://data.niod.nl/WO2_Thesaurus/1659>;
    dcterms:created "2020-11-16T09:38:06.227Z"^^xsd:dateTime;
    skos:prefLabel "Schutzhaft"@nl, "Schutzhaft"@de, "Protective custody"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Schutzhaft (preventieve hechtenis) was de benaming in het Derde Rijk voor het, zonder gerechtelijke uitspraak, arresteren en in concentratiekampen gevangen houden van personen die het nationaalsocialistische bewind onwelgevallig waren om reden van hun (linkse) politieke overtuiging, geloof, geaardheid of afkomst, zoals Joden, Jehova’s getuigen, Sinti en Roma, asocialen en homoseksuelen. De Schutzhäftlinge werden gearresteerd door de SA, de SS of de Gestapo en werden gedetineerd in kampen waar de SS of de SA de enige autoriteit was. De Schutzhaft kon niet bij een rechtbank aangevochten worden en er was geen gerechtelijke bescherming tegen mishandeling tijdens deze gevangenschap."@nl;
    skos:altLabel "Preventieve hechtenis"@nl;
    skos:hiddenLabel "Schutzhäftlinge"@nl .
  
