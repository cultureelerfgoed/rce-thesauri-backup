    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Arbeitserziehungslager_Oberndorf-Aistaig&oldid=60779796"@nl,
      "https://virtuell.geschichtsort-hotel-silber.de/das-netz-der-gestapo/wuerttemberg-und-baden/arbeitserziehungslager-oberndorf-aistaig/"@de;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4883>, <https://data.niod.nl/WO2_Thesaurus/8176>;
    dcterms:created "2024-01-31T11:01:06.168Z"^^xsd:dateTime;
    skos:prefLabel "Oberndorf-Aistaig"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Oberndorf-Aistaig was een Arbeitserziehungslager (AEL) bij Oberndorf am Neckar in Duitsland. In dit strafkamp of ‘heropvoedingskamp’ werden dwangarbeiders van de Arbeidsinzet gevangen en tewerkgesteld in nabijgelegen wapenfabrieken en mijnen. Oberndorf-Aistaig functioneerde van september 1941 tot het kamp op 18 april 1945 werd bevrijd. Er zaten ongeveer 4400 voornamelijk Nederlandse, Duitse, Poolse en Russische dwangarbeiders gevangen waarvan er zeker 308 omkwamen. "@nl;
    skos:altLabel "Arbeitserziehungslager Oberndorf-Aistaig"@nl, "AEL Oberndorf-Aistaig"@nl,
      "AEL Oberndorf-Aistaig (Württemberg)"@nl, "AEL Aistaig-Oberndorf"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
