    dcterms:created "2018-11-01T14:00:31.000Z"^^xsd:dateTime;
    skos:prefLabel "Muur van Mussert"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "De in 1938 gebouwde 'Muur van Mussert' werd 150 meter lang en tien meter hoog. In de muur is een kamertje gemetseld waar Mussert zijn brieven aan Hitler schreef. Er kwam ook een vlaggenmast bij van 38 meter lengte. Bij de muur werden zes grote bijeenkomsten gehouden, \"Hagespraken\", waar maximaal per keer zo'n 20.000 NSB'ers bij aanwezig waren. In 2018 is de Muur officieel als Rijksmonument aangewezen."@nl;
    skos:altLabel "Muur Mussert"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/locations/7216> a skos:Concept, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
