    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/download/default/5539f7ba-9fd0-af5a-c40f-4e9dddf2a821.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/e18972a6-0259-11e7-904b-d89d6717b464/media/5539f7ba-9fd0-af5a-c40f-4e9dddf2a821";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Commissie voor Persreorganisatie (CPR) was een door de Duitse bezetter ingestelde persorganisatie. De CPR werd eind juni 1941 opgericht door Generalkommissar zur besonderen Verwendung Fritz Schmidt. Het had als doel de Nederlandse pers onder strenge nationaalsocialistische controle te brengen en van politieke tegenstanders te ontdoen. Honderden kranten, dagbladen en tijdschriften kwamen onder toezicht of werden opgeheven. De CPR bestond voornamelijk uit Nederlandse nationaalsocialisten. Op 1 februari 1942 werd de CPR opgeheven."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2215>, <https://data.niod.nl/WO2_Thesaurus/1741>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/5824>;
    dcterms:created "2024-06-12T07:30:31.051Z"^^xsd:dateTime;
    skos:prefLabel "Commissie voor Persreorganisatie"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Commissie voor Persreorganisatie (CPR) was een door de Duitse bezetter ingestelde persorganisatie. De CPR werd eind juni 1941 opgericht door Generalkommissar zur besonderen Verwendung Fritz Schmidt. Het had als doel de Nederlandse pers onder strenge nationaalsocialistische controle te brengen en van politieke tegenstanders te ontdoen. Honderden kranten, dagbladen en tijdschriften kwamen onder toezicht of werden opgeheven. De CPR bestond voornamelijk uit Nederlandse nationaalsocialisten. Op 1 februari 1942 werd de CPR opgeheven."@nl;
    skos:altLabel "Commissie voor de Persreorganisatie"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization>;
    skos:hiddenLabel "C.P.R."@nl .
  
