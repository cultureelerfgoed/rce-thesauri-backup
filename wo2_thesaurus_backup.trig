  <https://data.niod.nl/WO2_Thesaurus/16864> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "A.D. Belinfante, In plaats van Bijltjesdag. De geschiedenis van de bijzondere rechtspleging na de Tweede Wereldoorlog (Assen: Van Gorcum, 1978), 30"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-03-02T14:18:55.834Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/3cd119f4-d696-50f2-c195-51be1d1c6f87.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/4afc311a-025a-11e7-904b-d89d6717b464/media/3cd119f4-d696-50f2-c195-51be1d1c6f87";
    dcterms:source "https://nl.wikipedia.org/wiki/Bijzondere_rechtspleging"@nl, "https://wetten.overheid.nl/jci1.3:c:BWBR0002007&z=2002-01-01&g=2002-01-01"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Met het Besluit op de Bijzondere Gerechtshoven richtte de Nederlandse regering vijf Bijzondere Gerechtshoven op. Voor een Bijzonder Gerechtshof verschenen onder andere personen die verdacht werden van misdaden zoals verraad, hulpverlening aan de vijand of vrijwillige dienstneming in het Duitse leger."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/19586>;
    dcterms:created "2021-06-23T12:29:31.821Z"^^xsd:dateTime;
    skos:prefLabel "Besluit Bijzondere Gerechtshoven"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "Met het Besluit op de Bijzondere Gerechtshoven van 22 december 1943 werden in Amsterdam, Arnhem, 's-Hertogenbosch, Den Haag en Leeuwarden de Bijzondere Gerechtshoven in het leven geroepen. Het was één van de vier besluiten waarmee in 1943 de bijzondere rechtspleging werd ingesteld. De hoven vonnisten volgens het besluit met drie leden, waarvan één militair. In de praktijk kwamen ook colleges met vijf leden voor. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/16869>, <https://data.niod.nl/WO2_Thesaurus/16870>,
      <https://data.niod.nl/WO2_Thesaurus/16872>, <https://data.niod.nl/WO2_Thesaurus/16874>,
      <https://data.niod.nl/WO2_Thesaurus/16875> .
  
  <https://data.niod.nl/WO2_Thesaurus/16869> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:references "S.C. Kooijman, ‘Verraders waarvoor in een bevrijd Nederland geen plaats zal zijn’. Institutioneel onderzoek naar het beleidsterrein van de bijzondere rechtspleging, 1945-1952 (’s-Gravenhage: Rijksarchiefdienst, 2000), 49; A.D. Belinfante, In plaats van Bijltjesdag. De geschiedenis van de bijzondere rechtspleging na de Tweede Wereldoorlog (Assen: Van Gorcum, 1978), 617."@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-08-18T13:51:38.699Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/10675>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/46d1ca5c-7ecc-09d7-6391-f67e5117ea26.jpg",
      "https://service.archief.nl/gaf/api/file/v1/render/b634c212-9739-45f2-bb34-76e1651789b9"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/f74b73e0-025a-11e7-904b-d89d6717b464/media/46d1ca5c-7ecc-09d7-6391-f67e5117ea26",
      "http://hdl.handle.net/10648/a88b5a1e-d0b4-102d-bcf8-003048976d84"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://resolver.kb.nl/resolve?urn=MMNIOD05:000107178:mpeg21:a0014>;
    dcterms:source "https://nl.wikipedia.org/wiki/Bijzondere_rechtspleging"@nl, "https://commons.wikimedia.org/wiki/File:Den_Haag._Zitting_van_het_Bijzonder_Gerechtshof_in_de_balzaal_van_het_paleis_aan,_Bestanddeelnr_900-7650.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Het Bijzonder Gerechtshof te ’s-Gravenhage is een speciaal gerechtshof dat na de Tweede Wereldoorlog is ingesteld om personen te veroordelen die verdacht werden van collaboratie. Voor een Bijzonder Gerechtshof verschenen onder andere personen die verdacht werden van misdrijven zoals verraad of vrijwillige dienstneming in het Duitse leger. Bijzondere Gerechtshoven konden onder andere gevangenisstraffen en de doodstraf opleggen."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/19272>;
    dcterms:created "2021-06-23T13:35:52.690Z"^^xsd:dateTime;
    skos:prefLabel "Bijzonder Gerechtshof 's-Gravenhage"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "Het Bijzonder Gerechtshof in Den Haag was een van de vijf hoven die in 1943 voor de bijzondere rechtspleging werd ingesteld. Het Hof werd op 3 augustus 1945 geïnstalleerd. In september 1945 werd Max Blokzijl door dit hof ter dood veroordeeld."@nl;
    skos:altLabel "Bijzonder Gerechtshof te Den Haag"@nl, "Bijzonder Gerechtshof Den Haag"@nl,
      "BG ’s-Gravenhage"@nl, "BG Den Haag"@nl, "Bijzonder Gerechtshof te 's-Gravenhage"@nl,
      "Bijzonder Gerechtshof in 's-Gravenhage"@nl, "Bijzonder Gerechtshof van 's-Gravenhage"@nl,
      "Bijzondere Gerechtshof te 's-Gravenhage"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/16864>;
