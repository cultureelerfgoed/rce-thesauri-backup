    <http://schema.org/startDate> "1942-10-19"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1922>, <https://data.niod.nl/WO2_Thesaurus/events/4330>;
    dcterms:created "2022-01-06T09:19:39.366Z"^^xsd:dateTime;
    skos:prefLabel "Ontruimingsbevel Hollandse kuststreek"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Het Ontruimingsbevel voor de Hollandse kuststreek werd op 19 oktober 1942 uitgegeven door SS-leider Hanns Albin Rauter. Grote aantallen bewoners van het kustgebied tussen Den Helder en Hoek van Holland moesten tussen 1942 en 1945 evacueren om ruimte te maken voor de Atlantikwall, een door de Duitsers aangelegde verdedigingslinie."@nl .
  
