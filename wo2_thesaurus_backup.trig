    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    dcterms:modified "2026-05-04T13:16:13.285Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Artikel 102 van het Wetboek van Strafrecht maakte opzettelijke hulpverlening aan de vijand strafbaar. Hierbij kon een levenslange gevangenisstraf of de doodstraf worden opgelegd. Voor de bijzondere rechtspleging werd Artikel 102 uitgebreid met het verspreiden van (vijandige) propaganda."@nl;
