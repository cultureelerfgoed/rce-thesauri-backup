    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    <https://data.niod.nl/EventsWO2/dateDescription> "1932-1933"@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2955>, <https://data.niod.nl/WO2_Thesaurus/1999>;
    dcterms:created "2016-10-04T11:45:13.000Z"^^xsd:dateTime;
    skos:prefLabel "Holodomor"@de, "Holodomor"@en, "Holodomor"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Holodomor was een hongersnood op het grondgebied van de Oekraïense Socialistische Sovjetrepubliek in de jaren 1932-1933. Veroorzaakt door het beleid van de regering van de Sovjet-Unie onder Stalin was het een van de grootste nationale rampen in de moderne geschiedenis van Oekraïne; het aantal doden lag tussen de 2,5 en de 3,9 miljoen."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/4378> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
