    dcterms:source "https://nl.qwe.wiki/wiki/Battle_of_the_Dnieper#:~:text=De%20Slag%20van%20de%20Dnjepr%20was%20een%20militaire%20campagne%20die,(870%20mi)%20lang%20front.&text=Vervolgens%20Kiev%20werd%20bevrijd%20in%20de%20Slag%20van%20Kiev%20."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3558>;
