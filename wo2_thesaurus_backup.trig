    <http://schema.org/startDate> "1944-10-26"^^xsd:date;
    dcterms:source "https://www.4en5mei.nl/oorlogsmonumenten/monumenten_zoeken/oorlogsmonument/863"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/6141>;
    dcterms:created "2019-03-14T15:50:06.000Z"^^xsd:dateTime;
    skos:prefLabel "Hinderlaag bij Fort Nieuw St. Andries"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "In een Hinderlaag bij Fort Nieuw St. Andries liep op 26 oktober 1944 het Britse 43rd Reconnaissance Regiment. Twee dagen eerder bevalen de Bitten een visser zijn schip dwars in de nabijgelegen sluis te varen, waarna het door middel van mitrailleurvuur tot zinken werd gebracht en hierdoor ingang werd afgesloten. In de ochtend van 26 oktober kwam de visser bij het hoofdkwartier (café 't Zwaantje in Dreumel) en vertelde dat Fort Sint-Andries door de bezetter verlaten was, echter bleek dit een hinderlaag te zijn en werden bij aankomst vier Engelse militairen omgebracht in een vuurgevecht en werd de rest (11 man) van de soldaten werd krijgsgevangen genomen."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/3585>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4460>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8113> a <http://schema.org/Thing>, skos:Concept,
