    dcterms:source "https://www.nationaalarchief.nl/onderzoeken/archief/2.04.74"@nl, "https://www.archieven.nl/nl/zoeken?mivast=0&mizig=210&miadt=298&miaet=1&micode=099&minr=2056014&miview=inv2"@nl;
