    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/084643ce-025a-11e7-904b-d89d6717b464/media/0bdaaf0a-c542-c5ae-5be0-89ff635662de"@nl;
    dcterms:source "https://www.japansekrijgsgevangenkampen.nl/Fukuoka%204B.htm"@de;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/VosJ>;
