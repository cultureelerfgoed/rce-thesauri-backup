    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/4dafd970-025a-11e7-904b-d89d6717b464/media/aa646582-2e20-fc10-3262-1053d7a4092f";
    <http://schema.org/startDate> "1943-09-29"^^xsd:date;
    <https://data.niod.nl/eventsWO2/toLocation> <https://data.niod.nl/WO2_Thesaurus/9385>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4448>, <https://data.niod.nl/WO2_Thesaurus/events/8315>;
    dcterms:created "2021-04-19T18:37:47.605Z"^^xsd:dateTime;
    skos:prefLabel "Transport van Barneveldgroep naar Westerbork, 29-09-1943"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 29 september 1943 werd de Barneveldgroep alsnog getransporteerd naar Kamp Westerbork. De Barneveldgroep was een groep prominente joden die door de Duitsers waren vrijgesteld van Arbeitseinsatz en deportatie. Uiteindelijk werden ze toch gedeporteerd. Vanuit Westerbork gingen de meesten naar Theresienstadt. Een groot deel overleefde."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/11507> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    dcterms:modified "2024-02-19T13:04:36.305Z"^^xsd:dateTime;
    <http://schema.org/startDate> "1942-07-01"^^xsd:date;
    <http://schema.org/endDate> "1943-02-15"^^xsd:date;
    dcterms:source "https://www.joodsmonument.nl/en/page/749/joodse-diamantbewerkers"@de;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2014>, <https://data.niod.nl/WO2_Thesaurus/corporaties/5054>;
    dcterms:created "2021-04-20T07:45:19.891Z"^^xsd:dateTime;
    skos:prefLabel "Vrijstellingen Diamantbewerkers"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote """Amsterdam kende een uitgebreide diamantindustrie met veel Joodse werkgevers en werknemers. De diamanthandel was een belangrijke inkomstenbron voor de Nazi's. Toen in 1942 de deportaties van Joden begonnen dreigde de gespecialiseerde diamantbewerkers afgevoerd te worden. Om dit te voorkomen werd een lijst opgesteld van ongeveer 500 diamantbewerkers en 300 ondernemers, die tijdelijk vrijgesteld werden van deportatie.
 De meeste diamantbewerkers en handelaren werden in september 1943 alsnog gedeporteerd naar Vught of Westerbork."""@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
