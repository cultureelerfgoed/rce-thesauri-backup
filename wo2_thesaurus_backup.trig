    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Nederlands_Isra%C3%ABlitisch_Meisjesweeshuis&oldid=55528866"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/9118>, <https://data.niod.nl/WO2_Thesaurus/18673>;
    dcterms:created "2020-07-30T08:44:46.000Z"^^xsd:dateTime;
    skos:prefLabel "Razzia Nederlandsch-Israëlitisch Meisjesweeshuis Amsterdam"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Razzia van het Nederlandsch-Israëlitisch Meisjesweeshuis 'Mangasiem Toviem Magadle Jethomiem' in Amsterdam vond plaats op 10 februari 1943. Een aantal kinderen kon vluchten of kwam vrij dankzij de Joodsche Raad, waardoor er van de 103 meisjes in het weeshuis er uiteindelijk 63 vanaf de Panamakade per trein naar Westerbork werden overgebracht. 25 kinderen werden direct gedeporteerd naar Sobibor, samen met vijf medewerkers van het weeshuis. Op 10 maart 1943 werden de overige kinderen en de directrice Rebekka Frank naar Sobibor gedeporteerd. Alle naar Sobibor gedeporteerde kinderen en medewerkers werden vermoord. Onderdirectrice Betsy Vromen-Snapper werd naar Bergen-Belsen gedeporteerd en overleefde de Holocaust."@nl;
    skos:altLabel "Ontruiming Israëlitisch Meisjesweeshuis Amsterdam"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
