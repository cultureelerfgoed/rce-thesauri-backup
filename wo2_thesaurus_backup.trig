    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/038dc7f8-025a-11e7-904b-d89d6717b464/media/5290b825-5f6e-e56c-607c-780fcfa1e96d";
    <http://schema.org/location> "Indische Oceaan";
    <http://schema.org/startDate> "1942-03-01"^^xsd:date;
    dcterms:source "https://en.wikipedia.org/wiki/SS_Rooseboom"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3511>;
    dcterms:created "2021-10-05T12:03:46.958Z"^^xsd:dateTime;
    skos:prefLabel "Scheepsramp Rooseboom"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Scheepsramp met de Rooseboom vond plaats op 1 maart 1942. De Rooseboom was een Nederlands schip van de Koninklijke Paketvaart Maatschappij dat op 22 februari 1942 uit Tandong Priok in konvooi was weggezonden naar Colombo (Sri Lanka). De route voerde via Emmahaven (Padang) om evacués op te halen en naar Brits-Indië te brengen. Op 26 februari voer de Rooseboom met ongeveer 500 evacués, waarvan 250 Britse militairen afkomstig uit Singapore en Malakka, verder en werd op 1 maart 1942 getorpedeerd door een Japanse onderzeeboot. De schipbreukelingen moesten onder vreselijke omstandigheden proberen te overleven op open zee. Slechts 4 van de 500 overleefden de ramp. De gehele Nederlandse bemanning kwam om."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/1870> .
  
