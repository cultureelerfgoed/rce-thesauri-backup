    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Watervliegtuig&oldid=48555947"@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/demoadmin>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1877>, <https://data.niod.nl/WO2_Thesaurus/2283>,
