    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://www.archieval.nl/detail.php?id=452210";
    dcterms:source "https://www.angerenstein-arnhem.nl/historie/leven-in-de-wijk/het-verzet-en-angerenstein/"@nl;
    skos:relatedMatch <https://data.niod.nl/WO2_Thesaurus/events/8042>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/2669>;
