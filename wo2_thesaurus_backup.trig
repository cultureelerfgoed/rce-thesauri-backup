    skos:narrower <https://data.niod.nl/WO2_Thesaurus/8753>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/2669>;
    dcterms:created "2018-03-07T09:01:52.000Z"^^xsd:dateTime;
    skos:prefLabel "Groep F152"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Groep F152 was een verzetsgroep die in oktober 1943 werd opgericht door de ontslagen procureur-generaal te Amsterdam, J.A. van Thiel. De groep gaf vanaf augustus 1944 het illegale nieuwsblad ‘De Eendracht’ uit (nr. 152 in L. Winkel, De ondergrondse pers), dat tot en met mei 1945 verscheen. De redactie was in handen van F.W. Vogels. "@nl;
    skos:altLabel "Groep F 152"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/6066> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
