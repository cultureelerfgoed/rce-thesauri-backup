      <https://beeldbankwo2.nl/nl/beelden/detail/28a2bddc-025a-11e7-904b-d89d6717b464/media/477e22d1-1216-e119-6940-7dec5dc25017>;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Speciaal:Citeren&page=Nationaalsocialistische_Duitse_Arbeiderspartij&id=48540903"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-08"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    skos:relatedMatch <https://data.niod.nl/WO2_biografieen/Walter-Hermann-Eugen-Bartels>,
      <https://data.niod.nl/WO2_biografieen/Gunther-Quandt>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Nationalsozialistische Deutsche Arbeiterpartei (NSDAP) was een Duitse nationaalsocialistische politieke partij die werd opgericht in 1920. In 1933 kwam de NSDAP onder leiding van Adolf Hitler aan de macht in Duitsland. Onder de NSDAP viel een groot aantal andere organisaties die de Duitse maatschappij onder nationaalsocialistische controle moesten brengen, zoals een jeugdorganisatie, een knokploeg en een inlichtingendienst."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
