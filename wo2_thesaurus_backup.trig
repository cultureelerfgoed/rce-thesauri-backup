    <http://schema.org/location> "Hedel";
    <http://schema.org/startDate> "1945-04-23"^^xsd:date;
    <http://schema.org/endDate> "1945-04-26"^^xsd:date;
    dcterms:source "http://www.prinsesirenebrigade.nl/hedel.html"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4549>;
    dcterms:created "2019-03-14T14:34:59.000Z"^^xsd:dateTime;
    skos:prefLabel "Strijd om een bruggenhoofd bij Hedel"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Bij de Strijd om een bruggenhoofd bij Hedel in april 1945 probeerde de Prinses Irene Brigade samen met de Britten, die een eind verderop lagen bij Alem, een bruggenhoofd over de Maas te vormen, om van daaruit door te stoten richting Zaltbommel. Na dagen van felle gevechten moest de Brigade zich terugtrekken over de Maas, omdat de kracht van de Duitse defensie sterk was onderschat en versterkingen uitbleven. Bovendien was de strijd in Europa zo goed als gestreden en had het weinig zin meer soldaten op te offeren in een strijd die in een patstelling was beland. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/3585>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4460>;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
