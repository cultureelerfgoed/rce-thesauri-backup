    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://beeldbank.cultureelerfgoed.nl/alle-afbeeldingen/detail/05624ef0-2f6a-6163-8c08-9f32acd55687/media/ff0209f8-25b4-4b1d-8274-40b4da4b8eab";
    <http://schema.org/description> "Hospitaal, erholungsheim, jachtlocatie nazi-top"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/isPointofInterest> true;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/20272>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4717>, <https://data.niod.nl/WO2_Thesaurus/1880>,
