    dcterms:created "2024-05-21T07:11:13.534Z"^^xsd:dateTime;
    skos:prefLabel "Tribunaalbesluit"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "Het Tribunaalbesluit was een wetsbesluit waarin werd bepaald welke zaken de Tribunalen konden berechten en welke straffen ze konden opleggen. Tribunalen oordeelden over personen die verdacht werden van collaboratie, zoals personen die lid waren geweest van de NSB of openlijk de Duitse bezetter steunden. De Tribunalen konden onder andere een internering (gevangenisstraf) van maximaal 10 jaar opleggen en (een gedeelte van) het vermogen afnemen. Ze konden ook (tijdelijk) bepaalde burgerrechten afnemen, zoals kiesrecht, het bekleden van publieke ambten, of het dienen in het leger. Verdachten die personen hadden verraden of vermoord, of bij het Duitse leger waren gegaan, werden berecht door een Bijzonder Gerechtshof."@nl;
    skos:altLabel "Tribunaal-besluit"@nl, "Trib. Besluit"@nl, "Tribunaal Besluit"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <https://data.niod.nl/thesaurus_wo2/ImagesWW2/Legislation> .
  
  <https://data.niod.nl/WO2_Thesaurus/20732> a <http://schema.org/Thing>, skos:Concept,
      <https://data.niod.nl/thesaurus_wo2/ImagesWW2/Legislation>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    dcterms:modified "2026-05-04T13:18:47.465Z"^^xsd:dateTime;
    dcterms:source "https://wetten.overheid.nl/jci1.3:c:BWBR0002009&titeldeel=IV&artikel=48&z=2015-01-01&g=2015-01-01"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Artikel 48 van het Tribunaalbesluit gaat over het beheer van het in beslag genomen vermogen van een verdachte. Het vermogen, zowel geld als goederen, werd vaak in beslag genomen bij een arrestatie. Bij de behandeling van de zaak werd bepaald of het in beslag genomen vermogen (deels) verbeurdverklaard of teruggegeven werd."@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/20731>;
    dcterms:created "2024-05-21T07:11:13.582Z"^^xsd:dateTime;
    skos:prefLabel "Tribunaalbesluit - Artikel 48"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "Artikel 48 van het Tribunaalbesluit gaat over het beheer van het in beslag genomen vermogen van een verdachte. Het vermogen, zowel geld als goederen, werd vaak in beslag genomen bij een arrestatie. Bij de behandeling van de zaak werd bepaald of het in beslag genomen vermogen (deels) verbeurdverklaard of teruggegeven werd."@nl;
    skos:altLabel "Trib. besluit 48"@nl;
