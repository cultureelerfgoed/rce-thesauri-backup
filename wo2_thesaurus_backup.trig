    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Nationale_herdenking_15_augustus_1945&oldid=53684549"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/8386>;
