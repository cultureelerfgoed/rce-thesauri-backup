    dcterms:created "2023-08-22T13:58:21.109Z"^^xsd:dateTime;
    skos:prefLabel "Onderkringleider"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De onderkringleider NSB was de functionaris binnen de NSB die in het door de kringleider aangewezen gebied optrad als zijn rechterhand. Hij voerde speciale opdrachten uit die de kringleider hem gaf en die voornamelijk inspectie betroffen."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2244> .
  
  <https://data.niod.nl/WO2_Thesaurus/20035> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "NSB, 12 Instructie voor den Kringleider Instructie voor den Onderkringleider (Utrecht 1 december 1936) p. 15-20. Dit document is aanwezig in NSB-archief inv.nr. 1288. NSB, Deel VI De Kring (Utrecht 1 oktober 1937) p. 6-18. Dit document is aanwezig in NSB-archief inv.nr. 1988. Zie ook NSB, Distinctieven der Beweging. Uitgegeven in opdracht van de Organisatieleider der N.S.B. (z.p. z.j.; oorlogsperiode) p. 9."@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2025-07-31T13:45:35.168Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
