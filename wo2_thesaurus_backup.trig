    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/16dd9b80-025a-11e7-904b-d89d6717b464/media/0b836687-5503-3631-6055-42333487b880";
    dcterms:source "https://www.kamparchieven.nl/nl/zoeken?mivast=959&mizig=210&miadt=298&miaet=1&micode=250i&minr=982413&miview=inv2&milang=en"@nl;
