    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/e0c0280a-025a-11e7-904b-d89d6717b464/media/1b02e45f-1fd8-2b37-24a3-62c2d2ed5120";
    <http://schema.org/startDate> "1944-12-01"^^xsd:date;
    <http://schema.org/endDate> "1944-01-23"^^xsd:date;
    dcterms:source "https://www.4en5mei.nl/oorlogsmonumenten/zoeken/3465/maasbracht-schepenkerkhof"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1922>;
    dcterms:created "2022-01-17T15:13:38.126Z"^^xsd:dateTime;
    skos:prefLabel "Evacuatie van Maasbracht"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "In december 1944 moesten de inwoners van Maasbracht en de schippersgezinnen die door de scheepsramp op 30 september 1944 hun woning hadden verloren op last van de Duitse bezetter evacueren. Maasbracht dreigde in de vuurlinie te komen. Een gedeelte van de evacués kwam in Friesland terecht, een ander gedeelte in Montfort. Op 23 januari 1945 werd Maasbracht bevrijd."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/8968>, <https://data.niod.nl/WO2_Thesaurus/18617> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/18704> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
