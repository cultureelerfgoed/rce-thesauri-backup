    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://www.collectiegelderland.nl/object/e8a88b53-0612-44e1-5efc-387f89d0832e>,
      <https://www.collectiegelderland.nl/object/0d0bd7aa-84d7-0b7a-3ac2-7534d535b600>;
    dcterms:source "http://www.virtueelindie.nl/index.php?pagina=virtueelindie&locatie=12"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/VosJ>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/locations/10649>;
    dcterms:created "2023-01-19T11:30:17.681Z"^^xsd:dateTime;
    skos:prefLabel "Tjihampelas"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote """Zwemmen was in Nederlands-Indië een populaire vrijetijdsbesteding. Men ging graag naar  zwembad Tjihampelas in Bandoeng.
Het stond nergens officieel aangegeven, maar de oorspronkelijke bevolking was niet echt welkom in de luxe zwembaden. Als men lid was van een zwemclub werd er nog wel eens een uitzondering gemaakt. Indo-Europeanen die het konden betalen bezochten wel de zwembaden. 
Bron: http://www.virtueelindie.nl/"""@nl .
  
