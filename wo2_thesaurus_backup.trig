    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    dcterms:modified "2025-02-18T08:31:10.238Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://service.archief.nl/gaf/api/file/v1/img/af3ad0a4-57ae-42bd-8290-fa1622882706?h=1000";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://www.nationaalarchief.nl/onderzoeken/fotocollectie/a8943526-d0b4-102d-bcf8-003048976d84";
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Dierentuin&oldid=55069060"@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/demoadmin>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/11109>, <https://data.niod.nl/WO2_Thesaurus/11110>,
      <https://data.niod.nl/WO2_Thesaurus/11112>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2823>, <https://data.niod.nl/WO2_Thesaurus/2920>;
    dcterms:created "2016-08-01T19:21:16.000Z"^^xsd:dateTime;
    skos:prefLabel "Zoos"@de, "Zoos"@en, "Dierentuinen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Dierentuinen zijn parken waarin verzamelingen levende, oorspronkelijk wilde dieren in gevangenschap worden gehouden om het publiek de gelegenheid te geven ze te kunnen bekijken. Ouwehands Dierenpark ligt vlakbij de Grebbelinie, uit voorzorg werden de dieren tijdens de meidagen van 1940 afgemaakt. Ook de Rotterdamse dierentuin kwam in de problemen tijdens de meidagen, het werd door Duitse bommen getroffen. Een groot deel van de dieren overleed. Het Amsterdamse Artis lag middenin de Joodse Wijk en tijdens de bezetting zaten hier honderden mensen ondergedoken."@nl;
    skos:altLabel "Diergaarden"@nl .
  
