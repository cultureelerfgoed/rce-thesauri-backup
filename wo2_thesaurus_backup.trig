    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Mariniersbrigade_in_Nederlands-Indi%C3%AB&oldid=53380518"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3481>;
