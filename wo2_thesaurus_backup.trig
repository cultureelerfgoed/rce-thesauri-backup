    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/10481>;
    <http://schema.org/startDate> "1944-05-21"^^xsd:date;
    dcterms:source "https://sneekernieuwsblad.nl/artikel/1005463/we-waren-zo-klaar-met-die-rotoorlog.html?harvest_referrer=https%3A%2F%2Fwww.google.com%2F"@nl,
      "https://sites.google.com/site/historievansneek/tweede-wereldoorlog/razzia-sportpark-leeuwarderweg"@nl;
    <http://schema.org/description> "De Sportpark Razzia in Sneek vond plaats op 21 mei 1944. Tijdens een voetbalwedstrijd in het stadion aan de Leeuwarderweg, waarin de populaire voetballers Abe Lenstra en Kees Smit meespeelden, klonk plotseling door de megafoon: \"Alle mannen tussen de achttien en vijftig jaar dienen in verband met de Arbeidseinsatz na afloop van de wedstrijd bij de uitgang hun Ausweiss te tonen\". Veel mannen ontsnapten door zich te verstoppen op de tribune en in het restaurant. Ruim twintig mannen zijn opgepakt voor de Arbeidsinzet. Hoewel het verzet had opgeroepen om niet naar de wedstrijd te gaan, kwamen veel toeschouwers ernaartoe. "@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2360>, <https://data.niod.nl/WO2_Thesaurus/2056>;
    dcterms:created "2020-07-29T10:15:07.000Z"^^xsd:dateTime;
    skos:prefLabel "Sportpark-razzia in Sneek"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Sportpark Razzia in Sneek vond plaats op 21 mei 1944. Tijdens een voetbalwedstrijd in het stadion aan de Leeuwarderweg, waarin Abe Lenstra en Kees Smit meespeelden, zijn ruim twintig mannen opgepakt. Anderen wisten te ontkomen door zich te verstoppen op de tribune of in het restaurant. Ruim twintig mannen zijn opgepakt voor de Arbeidsinzet. Hoewel het verzet had opgeroepen om niet naar de wedstrijd te gaan, kwamen veel toeschouwers ernaartoe."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
