    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:37:28.746Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8028>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2560>, <https://data.niod.nl/WO2_Thesaurus/events/4382>,
      <https://data.niod.nl/WO2_Thesaurus/2376>, <https://data.niod.nl/WO2_Thesaurus/20702>;
    dcterms:created "2019-01-24T15:27:44.000Z"^^xsd:dateTime;
    skos:prefLabel "Sinar Matahari"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/11183>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Sinar Matahari bestond van het begin tot het eind van de Japanse bezetting van Nederlands-Indië en werd opgericht door de Japanse bezetter. De krant werd geschreven in het Maleis, vermoedelijk omdat de Japanners dit makkelijker begrepen. Het doel van de krant was Japanse propaganda verspreiden."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7777> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "Peter Post - The Encyclopedia of Indonesia in the Pacific War"@en,
      "Peter Post, ed., The Encyclopedia of Indonesia in the Pacific War (Leiden : Brill, 2010)"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-04-12T13:38:40.185Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8028>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4545>;
    dcterms:created "2019-01-24T15:49:58.000Z"^^xsd:dateTime;
    skos:prefLabel "Hizbullah"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Hizbullah werd opgericht op 8 december 1945 door de Japanse bezetter in Indonesië en bestond uit strijders met een moslimachtergrond. In eerste instantie werd de groep ingezet door de Japanners, maar na de capitulatie streed de groep mee voor de onafhankelijkheid van Indonesië."@nl;
    skos:altLabel "Hizboellah"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7778> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "Peter Post - The Encyclopedia of Indonesia in the Pacific War"@en,
      "Peter Post, ed., The encyclopedia of Indonesia in the Pacific War (Leiden : Brill, 2010)"@nl,
      "R.P.G.A. Voskuil - Bandoeng, Beeld van een stad"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-04-12T13:43:09.710Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8028>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4545>;
    dcterms:created "2019-01-24T16:20:06.000Z"^^xsd:dateTime;
    skos:prefLabel "Voorvechterskorps"@nl, "Pioneer Corps"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Voorvechterskorps werd opgericht in september 1944 en stond onder leiding van Soekarno. De militanten-beweging bestond uit inheemse nationalistische jongeren, die uit waren op een onafhankelijk Indonesië. Na de Japanse capitulatie zou deze groep een trouwe groep aanhangers en strijders voor Soekarno vormen."@nl;
    skos:altLabel "Suishintai"@nl, "Barisan Pelopor"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7783> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Event>;
    dcterms:references "D. van Velden - De Japanse burgerkampen"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:05:00.003Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8019>;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Bushido&oldid=52260584"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2350>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4551>;
    dcterms:created "2019-01-28T12:38:38.000Z"^^xsd:dateTime;
    skos:prefLabel "Bushido"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Bushido is traditioneel een erecode van de samoerai, waarbij loyaliteit en eer tot aan de dood de eis was. Tijdens de Tweede Wereldoorlog werd deze code door de Japanners ingezet om de bevolking en het leger volledig voor de Japanse zaak in te zetten. De code was onder andere de drijvende kracht achter zelfmoordaanslagen (zoals kamikaze) en het verkiezen van zelfmoord boven overgave of gevangenschap. "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7784> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
