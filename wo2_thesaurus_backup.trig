    dcterms:created "2019-03-15T08:57:12.000Z"^^xsd:dateTime;
    skos:prefLabel "Kasteel Hemmen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "In Kasteel Hemmen hield zich vanaf december 1944 een groep Duitse parachutisten schuil. Hemmen was van eind september 1944 tot aan de bevrijding frontgebied, en met name kasteel Hemmen bood een sterke uitgangspositie voor de verovering van Zetten. Aangezien de geallieerden wilden voorkomen dat Zetten weer in handen van de Duitsers kwam, besloten ze het landhuis met tanks aan te vallen. Het werd uiteindelijk op 6 januari 1945, na een onverwacht zware tegenstand van de Duitse verdedigers, volledig verwoest door een Brits-Canadese strijdmacht. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4466>, <https://data.niod.nl/WO2_Thesaurus/3585>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/4460>;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
