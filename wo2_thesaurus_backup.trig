    <https://data.niod.nl/eventsWO2/fromLocation> <https://data.niod.nl/WO2_Thesaurus/kampen/4869>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/640x480/8ec59a46-f317-59f0-1e34-f6a600ec82e3.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/7fcf7e10-025a-11e7-904b-d89d6717b464/media/8ec59a46-f317-59f0-1e34-f6a600ec82e3"@nl;
    <http://schema.org/startDate> "1945-04-11"^^xsd:date;
    <http://schema.org/endDate> "1945-04-14"^^xsd:date;
    dcterms:source "https://www.ovcg.nl/projecten/de-vrouwenmars-van-westerbork-project-in-2020/"@de;
    <https://data.niod.nl/eventsWO2/toLocation> <https://data.niod.nl/WO2_Thesaurus/locations/9606>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/4869>;
    dcterms:created "2020-06-18T09:46:56.000Z"^^xsd:dateTime;
    skos:prefLabel "Vrouwenmars van Westerbork"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "De Vrouwenmars van Westerbork vond plaats tussen 11 en 14 april 1945. 116 vrouwelijke politieke gevangenen werden vanuit Westerbork te voet weggevoerd om te voorkomen dat ze in handen vielen van de naderende Canadezen. De eindbestemming was onduidelijk. De vrouwen liepen via Assen naar Groningen en vanuit daar richting Visvliet. Daar werden ze op 14 april 1945 bevrijd. Het bevel om de vrouwen dood te schieten werd niet uitgevoerd. Alle vrouwen overleefden de mars."@en;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9050> a <http://schema.org/Thing>, skos:Concept,
