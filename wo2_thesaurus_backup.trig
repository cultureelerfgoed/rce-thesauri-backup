  <https://data.niod.nl/WO2_Thesaurus/1563> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-03-02T15:47:21.814Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/21256>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/wo2nedindieThema> "Betrekkingen Nederland-Indonesië";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://service.archief.nl/gaf/api/file/v1/img/799b3eac-3417-4b13-8b1f-be48c4d53653?h=1000";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://www.nationaalarchief.nl/onderzoeken/fotocollectie/ad757b4a-d0b4-102d-bcf8-003048976d84";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://www.nationaalarchief.nl/onderzoeken/fotocollectie/aef6643e-d0b4-102d-bcf8-003048976d84>,
      <https://beeldbankwo2.nl/nl/beelden/detail/e62be7d0-0259-11e7-904b-d89d6717b464/media/7ad7c38f-8203-8b7a-f46b-3296bcb74487>,
      <https://beeldbankwo2.nl/nl/beelden/detail/4a898192-025a-11e7-904b-d89d6717b464/media/dca1f0ce-9f5c-c4d7-4455-8b4432fece50>;
    <http://schema.org/startDate> "1949-12-27"^^xsd:date;
    dcterms:source "http://www.encyclo.nl/begrip/Soevereiniteitsoverdracht"@nl;
    <http://schema.org/description> "Op 27 december 1949 vindt de formele soevereiniteitsoverdracht plaats aan de Verenigde Staten van Indonesië. Tegelijk met de ceremonie in het Paleis op de Dam in Amsterdam vindt in Batavia/Djakarta de overdrachtsplechtigheid plaats. In het Paleis Koningsplein ondertekenen dr. A.H.J. Lovink, de Hoge Vertegenwoordiger van de Kroon, en sultan Hamengku Buwono IX het protocol van de overdracht van het bewind aan de Republik Indonesia Serikat. Daarna luisteren de aanwezigen naar de radiotoespraak van koningin Juliana. Onder het spelen van het Wilhelmus wordt de Nederlandse vlag op het paleis gestreken. Onder het spelen van het Indonesia Raya gaat de roodwitte vlag in top. De volgende dag, op 28 december, maakt president Soekarno een triomfantelijke intocht in Djakarta."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/demoadmin>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1584>;
    dcterms:created "2016-08-01T19:18:59.000Z"^^xsd:dateTime;
    skos:prefLabel "Souveränitätstransfer"@de, "Transfer of sovereignty"@en, "Soevereiniteitsoverdracht"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Soevereiniteitsoverdracht was de overdracht van de hoogste macht door de Nederlandse regering aan de regering van Indonesië op 27 december 1949, waarmee een einde kwam aan het Nederlandse koloniale bewind in Nederlands-Indië (op Nieuw-Guinea na)."@nl .
  
