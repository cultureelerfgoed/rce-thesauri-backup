  <https://data.niod.nl/WO2_Thesaurus/2875> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:references "N.J.G. Sikkel (red.), Documentatie. Samengesteld ten behoeve van de Bijzondere Rechtspleging, op last van de Procureur-Fiscaal bij het Bijzonder Gerechtshof te Amsterdam (Amsterdam 1947)"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-08-18T15:23:37.038Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1940-10-22"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/413c6ad5-1141-c5a8-974b-c642acee2f04.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/5a0677e2-025a-11e7-904b-d89d6717b464/media/413c6ad5-1141-c5a8-974b-c642acee2f04";
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Winterhulp_Nederland&oldid=42581846"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-06"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Stichting Winterhulp Nederland was een nationaalsocialistische hulporganisatie die vooral levensmiddelen en kleding aan gezinnen leverde. Officieel had de Winterhulp als doel om alle Nederlanders te helpen, maar in de praktijk kregen alleen pro-Duitse gezinnen hulp. De voornaamste inkomstenbron van de Winterhulp waren collectes door leden van de Nationaal-Socialistische Beweging (NSB)."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/demoadmin>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/12704>, <https://data.niod.nl/WO2_Thesaurus/11244>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2874>, <https://data.niod.nl/WO2_Thesaurus/20640>;
    dcterms:created "2016-08-01T19:21:23.000Z"^^xsd:dateTime;
    skos:prefLabel "Winterhulp"@nl, "Winterhilfe"@de, "Winteraid"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Stichting Winterhulp Nederland werd op 22 oktober 1940 per decreet opgericht door Rijkscommissaris Seyss-Inquart, naar het voorbeeld van de nationaalsocialistische Winterhilfswerk des Deutschen Volkes. Het doel van deze liefdadigheidsinstelling was ‘behoeftige Nederlandse staatsburgers zonder aanzien des persoons hulp en ondersteuning te verschaffen’. Evenals het Duitse voorbeeld verstrekte de Winterhulp hoofdzakelijk voedsel en kleding. Spoedig werden gezinnen met nationaalsocialistische sympathieën bevoordeeld, terwijl openlijke tegenstanders van de ‘Nieuwe Orde’ en Joden niet op bijstand hoefden te rekenen. Doordat NSB’ers massaal bij de collectes waren betrokken, was de organisatie niet geliefd bij de bevolking."@nl;
    skos:altLabel "Winterhulp Stichting"@nl, "Stichting Winterhulp Nederland"@nl, "Winterhilfe Niederland"@nl,
      "Winterhulp Nederland"@nl, "Winterhulp-Nederland"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4719>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization>;
    skos:hiddenLabel "W.H.N."@nl, "WHN"@nl .
  
