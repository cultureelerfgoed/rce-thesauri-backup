    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2005>, <https://data.niod.nl/WO2_Thesaurus/locations/10482>;
    dcterms:created "2018-10-05T11:46:28.000Z"^^xsd:dateTime;
    skos:prefLabel "Velodrome d'Hiver"@nl, "Velodrome d'Hiver"@de, "Velodrome d'Hiver"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "Het Vélodrome d'Hiver was een wielerstadion in Parijs dat op 16 en 17 juli 1942 gebruikt werd als verzamelpunt voor duizenden Parijse Joden die, in opdracht van de Duitse bezetter, tijdens een grootschalige razzia opgepakt waren door de Franse politie. Na enkele dagen verblijf zonder eten of verzorging werden de gevangenen gedeporteerd naar doorgangskampen, zoals dat van Drancy, en dan verder naar Auschwitz."@nl;
    skos:altLabel "La Rafle du Velodrome d'Hiver"@nl, "Rafle du Velodrome d'Hiver"@nl,
      "Razzia van de Velodrome d'Hiver"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
