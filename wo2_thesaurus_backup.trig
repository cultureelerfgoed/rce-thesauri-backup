    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <http://archief.zaanstad.nl/beeldbank/beeldbank-beelden/detail/7b8bdda7-3629-e407-cacc-128de825643c>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/2662>;
    dcterms:created "2019-02-15T12:56:56.000Z"^^xsd:dateTime;
    skos:prefLabel "Februaristaking in de Zaanstreek"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Februaristaking in de Zaanstreek was een reactie op de staking die in Amsterdam begon op 25 februari 1941 en om half 12 dezelfde dag in de Zaanstreek zijn aanvang nam. Net als op andere plekken werd ook hier de staking hardhandig neergeslagen en kreeg Zaandam een boete van een half miljoen gulden."@nl .
  
