    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/5dfa24f2-025a-11e7-904b-d89d6717b464/media/01cdbfc1-3e5e-1164-f635-7b5e41cd3b46";
    dcterms:source "https://hetutrechtsarchief.nl/onderzoek/resultaten/archieven?mivast=39&mizig=210&miadt=39&miaet=1&micode=1312&minr=5264883&miview=inv2"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/11464>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2151>;
