    dcterms:created "2018-11-03T11:52:44.000Z"^^xsd:dateTime;
    skos:prefLabel "Operatie Infatuate"@nl, "Operation Infatuate"@en, "Kampf um Walcheren"@de;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Operatie Infatuate, of de Strijd om Walcheren (Zeeland), vond plaats van 1 tot 8 november 1944. De operatie bestond uit aanvallen van drie zijden gelijktijdig uitgevoerd: over de Sloedam vanuit het oosten (de Slag om de Sloedam), over de Westerschelde vanuit het zuiden (Landing Vlissingen, Operatie Infatuate I) en over de zee vanuit het westen (Landing Westkapelle, Operatie Infatuate II). Buiten Normandië was Walcheren de enige plek waar de Atlantikwall werd doorbroken."@nl;
    skos:altLabel "Bevrijding van Walcheren"@nl .
  
