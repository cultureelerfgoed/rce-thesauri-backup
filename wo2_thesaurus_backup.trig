    <http://schema.org/startDate> "1954-12-14"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Nederlands-Indonesische_Unie&oldid=42426737"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/8386>;
    dcterms:created "2019-04-24T14:30:17.000Z"^^xsd:dateTime;
    skos:prefLabel "Eenzijdige opzegging Nederlands-Indonesische Unie door Indonesische regering"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Eenzijdige opzegging Nederlands-Indonesische Unie door Indonesische regering vindt plaats op 14 december 1954 en is een besluit van de Indonesische regering waarin zij aankondigen alle overige akkoorden van de Rondetafelconferentie niet langer na te leven. De opheffing maakt een einde van de bijzondere staatsrechtelijke band tussen Nederland en Indonesië die vanaf 27 december 1949 bestond."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8409> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2019-04-24T14:40:07.000Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/wo2nedindieThema> "Betrekkingen Nederland-Indonesië";
    <http://schema.org/startDate> "1960-08-19"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/8386>;
    dcterms:created "2019-04-24T14:38:26.000Z"^^xsd:dateTime;
    skos:prefLabel "Indonesië verbreekt betrekkingen met Nederland"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Indonesië verbreekt betrekkingen met Nederland, op 19 augustus 1960, op diplomatiek gebied naar aanleiding van de oplopende spanningen rondom Nederlands Nieuw Guinea. De Indonesische diplomatieke missie in Nederland wordt gesloten. De ambassade van Egypte neemt de belangen van Indonesië waar."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8410> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
