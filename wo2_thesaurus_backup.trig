    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/86ef4504-025a-11e7-904b-d89d6717b464/media/d09e7a91-ebfd-48d9-bcb8-8b05db61e277";
    <http://schema.org/startDate> "1943-01-30"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/wiki/Secretarie_van_Staat"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/16877>;
    dcterms:created "2021-06-24T08:33:48.330Z"^^xsd:dateTime;
    skos:prefLabel "Instelling Secretarie van Staat"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De instelling van de Secretarie van Staat vond plaats op 30 januari 1943 bij decreet van de Rijkscommissaris. De NSB werd door het Reichskommissariat van Seyss-Inquart structureel betrokken bij het bestuur van Nederland, in het bijzonder bij benoemingsbeleid. In de praktijk kwam hier echter weinig van terecht omdat de bereidheid om bevoegdheden aan de Secretarie af te staan gering was."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
