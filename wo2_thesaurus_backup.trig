    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/640x480/584449ef-7bb3-24f7-647f-92a898b1938f.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/477b3072-025a-11e7-904b-d89d6717b464/media/584449ef-7bb3-24f7-647f-92a898b1938f";
    <http://schema.org/description> "'De Brandaris', radio-omroep voor Nederlandsche zeevarenden Londen (Dutch Seamen's broadcast), kwam tot stand in een samenwerking tussen de BBC en de Nederlandse Regeringsvoorlichtingsdienst. Vanaf 1 juli 1941 werd dagelijks een aflevering van een kwartier gemaakt. Formeel was deze bedoeld voor de opvarenden van de Koninklijke Marine en de Nederlandse koopvaardij, maar in werkelijkheid was het doel luisteraars in bezet gebied te bereiken. 'De Rotterdammer' (H.J. van den Broek, Telegraaf-correspondent uit Parijs die daar in mei 1940 'Radio Vrij Nederland' had georganiseerd) en 'Bob' (de schrijver A. den Doolaard), die beiden uit Frankrijk waren ontkomen, ontpopten zich al snel als bezielende radiosprekers. De Brandaris werd in Nederland goed beluisterd, maar de uitzendingen werden vaak door Duitse stoorzenders verstoord. De Brandaris werd op 2 november 1942 samengevoegd met Radio Oranje. Van den Broek kreeg de leiding van de nieuwe 'Radio Oranje, de stem van strijdend Nederland'.";
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2365>, <https://data.niod.nl/WO2_Thesaurus/20657>;
    dcterms:created "2017-03-10T19:43:43.000Z"^^xsd:dateTime;
    skos:prefLabel "De Brandaris"@nl, "'De Brandaris'"@de, "Dutch Seamen's Broadcast"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Brandaris, radio-omroep voor Nederlandsche zeevarenden Londen (Dutch Seamen's Broadcast) was tussen juli 1941 en november 1942 de radio-omroep voor Nederlandse zeevarenden te London."@nl;
    skos:altLabel "Dutch Seamen's Broadcast"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
