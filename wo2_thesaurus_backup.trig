    <http://schema.org/location> "Atlantische Oceaan";
    <http://schema.org/startDate> "1942-11-28"^^xsd:date;
    dcterms:source "https://uboat.net/allies/merchants/ships/2478.html"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
