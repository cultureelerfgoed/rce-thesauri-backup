    dcterms:created "2020-03-25T09:08:11.000Z"^^xsd:dateTime;
    skos:prefLabel "Zschopau"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote """Aussenlager Zschopau was van 21 november 1944 tot midden april 1945 een buitenkamp van Flossenbürg waar 500 Joodse vrouwen tewerkgesteld waren bij de fabricage van vliegtuigonderdelen en voertuigen voor DKW. Aanvankelijk waren de gevangenen ondergebracht in de Zschopauer Bürgerschule en later in een fabrieksgebouw op het terrein van DKW-Werk.


"""@nl;
    skos:altLabel "Aussenlager Zschopau"@nl .
  
