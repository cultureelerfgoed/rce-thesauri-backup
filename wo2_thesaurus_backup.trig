    dcterms:created "2023-08-23T14:13:13.898Z"^^xsd:dateTime;
    skos:prefLabel "Vliegveld Havelte"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Vliegveld Havelte was een door de Duitsers aangelegd militair vliegveld. Het was in 1944 aangelegd in heidegbeid bij de Havelterberg en werd door de Duitsers vliegveld Steenwijk genoemd. Op vliegveld Havelte waren kort tijd nachtjagers van de Luftwaffe gstationeerd. In april 1945 viel vliegveld Havelte in handen van het Canadese leger."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
