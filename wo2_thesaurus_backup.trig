    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Tweede_Italiaans-Ethiopische_Oorlog#/media/File:DC-1936-52-d.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/c7b247a4-0259-11e7-904b-d89d6717b464/media/033d6adb-9a96-9012-78e7-af4f1d223e98>,
