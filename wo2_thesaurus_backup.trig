    skos:prefLabel "Maliebaan 35"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "Het Hoofdkwartier van de NSB was gevestigd op Maliebaan 35. NSB-leider Anton Mussert had er zijn werkkamer op de eerste verdieping en het balkon aan de voorzijde van het pand gebruikte hij tijdens parades en toespraken. Reichsführer-SS Heinrich Himmler kwam in 1942 naar Nederland en bracht een bezoek aan de NSB op Maliebaan 35."@nl;
    skos:altLabel "NSB-hoofdkantoor"@nl, "NSB-hoofdkwartier"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/locations/9247> a skos:Concept, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "52.0901956"^^xsd:float;
