    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Heinkel_He_111#/media/Bestand:Bundesarchiv_Bild_101I-408-0847-10,_Flugzeuge_Heinkel_He_111.jpg";
    <http://schema.org/startDate> "1940-09-07"^^xsd:date;
    dcterms:source "https://www.verliesregister.studiegroepluchtoorlog.nl/ahome/lossregister/results?sglo=T0827"@de;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2329>;
    dcterms:created "2023-08-30T08:13:08.402Z"^^xsd:dateTime;
    skos:prefLabel "Vliegtuigcrash bij Amstelveen, 7 september 1940"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Crash bij Amstelveen van de Heinkel He 111 Werknummer 3294 van de 4e Staffel van Kampfgeschwader 26 vond plaats in de nacht van 6 op 7 september 1940 op Henegouwselaan 89 in Amstelveen. De oorzaak van de crash was dat het vliegtuig werd neergeschoten door eigen luchtafweer bij Schiphol. Van de vijf bemanningsleden kwamen twee om het leven. Er vielen zes doden onder de burgerbevolking en twee doden onder ingekwartierde Duitsers."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/20250> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "A. Dekker, Ook Gij behoort bij ons. Het NSKK in de Lage Landen (z.p. 2013) p. 199. "@nl,
