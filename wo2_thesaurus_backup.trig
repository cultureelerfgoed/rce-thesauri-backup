    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het illegale blad Communiqué werd vanaf juni 1944 uitgegeven in Amersfoort (provincie Utrecht). Er werden nummers per post verzonden aan NSB-ers."@nl .
  
