    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/11363>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/e/ec/Linda_Reich_Auschwitz_Album.jpg/1280px-Linda_Reich_Auschwitz_Album.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Kanada-Kommando#/media/Bestand:Linda_Reich_Auschwitz_Album.jpg";
    dcterms:source "https://nl.wikipedia.org/wiki/Kanada-Kommando"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/3655>;
    dcterms:created "2021-12-15T13:12:43.919Z"^^xsd:dateTime;
    skos:prefLabel "Aufräumungskommando Kanada"@de, "Kanada-Kommando"@nl, "Kanada-Kommando"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Het Kanada-Kommando bestond uit een groep aangewezen Joodse gevangenen die in concentratiekamp Auschwitz en Auschwitz-Birkenau de bagage van nieuw aangekomen gevangenen moest sorteren. Het terrein waar dit werd uitgevoerd kreeg de naam Kanada omdat Canada een rijk land zou zijn. Ze waren iets meer beschermd in deze functie, maar leden van het Kommando werden geregeld vervangen en vermoord omdat ze te veel wisten. In Birkenau werd Kanada II ingericht vanwege de grote hoeveelheden bezittingen van vermoorde Joden. Vanaf oktober 1944 werkten er 815 vrouwelijke gevangenen en enkele honderden mannelijke gevangenen in het Kanada-Kommando. Toen de Duitsers in januari 1945 Auschwitz gingen ontruimen werden dertig barakken met persoonlijke bezittingen van vermoorde gevangenen in brand gestoken om deze misdaden te verbergen."@nl .
  
