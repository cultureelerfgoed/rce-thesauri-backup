    <http://schema.org/startDate> "1945-04-12"^^xsd:date;
    <http://schema.org/endDate> "1945-04-16"^^xsd:date;
    dcterms:source "https://www.tracesofwar.nl/operations/5434/Operatie-Anger.htm"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/events/7136>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3557>, <https://data.niod.nl/WO2_Thesaurus/2343>;
    dcterms:created "2018-11-02T14:18:22.000Z"^^xsd:dateTime;
    skos:prefLabel "Operatie Anger"@nl, "Operation Anger"@en, "Unternehmen 'Anger'"@de;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Operatie Anger, ook wel de Tweede Slag om Arnhem genoemd, vond plaats van 12-16 april 1945, met als doel Arnhem te bevrijden. Operatie Quick Anger was een voorloper van het plan om Arnhem vanuit westelijke richting via Driel te bevrijden. Dit plan werd afgelast en vervangen met Operatie Anger waarbij Arnhem vanuit oostelijke richting via Westervoort werd bevrijd. Van 12-13 april waren er bombardementen op de wijk Geitenkamp. Op 14 april was heel Arnhem bevrijd."@nl;
    skos:altLabel "Tweede Slag om Arnhem"@nl, "Bombardement op de Geitenkamp"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    skos:hiddenLabel "Operatie Quick Anger"@nl, "Operation Quick Anger"@nl .
  
