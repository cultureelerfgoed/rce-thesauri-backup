    dcterms:source "https://www.wo2slachtoffers.nl/bio/52093/Vaumont-Marinus.htm"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2684>, <https://data.niod.nl/WO2_Thesaurus/locations/10669>;
