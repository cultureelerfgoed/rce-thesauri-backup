    dcterms:created "2022-05-30T13:54:56.316Z"^^xsd:dateTime;
    skos:prefLabel "Displaced Persons Registration Eindhoven"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De afdeling Displaced Persons Registration in Eindhoven viel onder de Allied Expeditionary Forces (SHAEF). Het Britse leger richtte dit registratiecentrum in voor Nederlanders die uit het buitenland terugkwamen en daar in eerste instantie werden opgevangen. Het bevond zich in een loods in het Veemgebouw van Philips. Ook de groep Unbekannte Kinder uit Theresienstadt werd daar opgevangen."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/18993> a <http://schema.org/Thing>, skos:Concept,
