  <https://data.niod.nl/WO2_Thesaurus/8713> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "PPN: 269055517"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2019-11-18T15:39:10.000Z"^^xsd:dateTime;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Wikipedia:Wikiproject/Verzetskranten/Beginnetjes/Bulletin_(verzetsblad,_Maartensdijk_)&oldid=47050775"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>;
    dcterms:created "2019-11-08T09:45:55.000Z"^^xsd:dateTime;
    skos:prefLabel "Bulletin (Maartensdijk)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Bulletin was een verzetsblad uit Maartensdijk dat met een oplage van circa 1200 stuks maandelijks verscheen van 14 juni 1940 tot 14 augustus 1941. Het blad bestond voornamelijk uit artikelen van gebeurtenissen in het buitenland, al is vooral het door heel Nederland verspreide pamflet 'Nederlands geestelijke vrijheid en de Jodenvervolging' door professor van Holk (dat als bijdrage als eerst in Bulletin verscheen) bekend geworden."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8714> a <http://schema.org/Thing>, skos:Concept;
