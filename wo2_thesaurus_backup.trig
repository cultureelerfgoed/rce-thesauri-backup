    dcterms:created "2019-05-15T05:55:45.000Z"^^xsd:dateTime;
    skos:prefLabel "Storm SS"@nl, "'Storm SS'"@de, "'Storm SS'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "Het tijdschrift Storm was een weekblad dat verscheen tussen 11 april 1941 ern 4 mei 1945 en uitgegeven werd door de Nederlandsche SS. De inhoud van het blad was niet specifiek gericht op SS'ers maar op een breed publiek, met de bedoeling dat buitenstaanders geïnteresseerd zouden raken in het gedachtegoed van de SS. Het blad werd gedrukt bij De Arbeiderspers."@nl;
    skos:altLabel "Tijdschrift Storm"@nl .
  
