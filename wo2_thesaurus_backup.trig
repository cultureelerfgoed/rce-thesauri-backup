    <http://schema.org/startDate> "1944-09-23"^^xsd:date;
    dcterms:source "https://www.tracesofwar.nl/sights/88643/Plaquette-Fusillade-Airborne-Krijgsgevangen.htm"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/9271>;
    dcterms:created "2020-09-30T12:16:49.000Z"^^xsd:dateTime;
    skos:prefLabel "Fusillade in Brummen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Fusillade in Brummen vond plaats op 23 september 1944. Zes krijgsgevangen militairen van de \"First British Airborne Division\" werden gefusilleerd door een SS-onderofficier. De Britse krijgsgevangenen die tot de groep van majoor Tony Hibbert behoorden waren op weg naar een krijgsgevangenkamp in de buurt van München."@nl .
  
