      <https://beeldbankwo2.nl/nl/beelden/detail/e8f561e4-0259-11e7-904b-d89d6717b464/media/e87b6ce0-962b-9316-05f2-3bfc342ecff8>;
    dcterms:source "https://aandemaliebaan.nl/verhalen/geen-knoop-van-mijn-gulp-voor-de-winterhulp/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/locations/9245>;
    dcterms:created "2020-08-20T06:44:09.000Z"^^xsd:dateTime;
    skos:prefLabel "Maliebaan 90"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "Aan de Maliebaan nummer 90 zat de 'Stichting Winterhulp' van de NSB, een organisatie die noodhulp verleende aan Nederlanders die het moeilijk hadden. De hulp was selectief, aangezien Joden waren uitgesloten en NSB-gezinnen voorgetrokken werden. "@nl;
    skos:altLabel "Adres Stichting Winterhulp"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/locations/9276> a skos:Concept, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "52.0940316"^^xsd:float;
    <http://www.w3.org/2003/01/geo/wgs84_pos#long> "5.1346551"^^xsd:float;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2020-08-24T09:24:05.000Z"^^xsd:dateTime;
    dcterms:source "https://aandemaliebaan.nl/verhalen/samenwerking-tussen-joodse-raad-en-corrupte-politieman/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/locations/9245>;
    dcterms:created "2020-08-20T06:58:35.000Z"^^xsd:dateTime;
    skos:prefLabel "Maliebaan 92"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "Aan de Maliebaan 92 woonde tot 1943 de Joodse Frits Elzas, vice-voorzitter van de Joodse Raad Utrecht. Hij werkte samen met NSB'er Jan Smorenburg. Elzas knoopte het samenwerkingsverband aan om te bemiddelen en Joden zich te laten vrijkopen. Smorenburg vangt er grote bedragen voor en had Joden indirect het leven gered. Na Elzas' deportatie naar Theresienstadt, werd zijn huis het kantoor van de Abwehr."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/locations/9277> a skos:Concept, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
