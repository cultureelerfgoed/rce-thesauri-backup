    <http://schema.semantic-web.at/ppt/appliedType> <https://data.niod.nl/thesaurus_wo2/ImagesWW2/Legislation> .
  
  <https://data.niod.nl/WO2_Thesaurus/20943> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:references "A.D. Belinfante, In plaats van Bijltjesdag. De geschiedenis van de bijzondere rechtspleging na de Tweede Wereldoorlog (Assen: Van Gorcum, 1978), 395."@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-02-25T09:48:18.491Z"^^xsd:dateTime;
    dcterms:source "https://www.nationaalarchief.nl/onderzoeken/archief/2.06.089"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Centrale Zuiveringsraad Bedrijfsleven controleerde en bekrachtigde beslissingen van de diverse zuiveringsraden. De zuiveringsraden voor verschillende takken van het bedrijfsleven konden onder meer leidinggevenden ontslaan die gecollaboreerd hadden met de Duitse bezetter. Veroordeelden konden bij de Centrale Zuiveringsraad in beroep gaan."@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2591>, <https://data.niod.nl/WO2_Thesaurus/20701>;
    dcterms:created "2024-05-24T09:26:41.212Z"^^xsd:dateTime;
    skos:prefLabel "Centrale Zuiveringsraad Bedrijfsleven"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Centrale Zuiveringsraad Bedrijfsleven controleerde en bekrachtigde beslissingen van de diverse naoorlogse zuiveringsraden. De zuiveringsraden voor verschillende takken van het bedrijfsleven konden onder meer leidinggevenden ontslaan die gecollaboreerd hadden met de Duitse bezetter. Veroordeelden konden bij de Centrale Zuiveringsraad in beroep gaan."@nl;
    skos:altLabel "Centr. Zuiverings Raad"@nl, "Centr. Zuiveringsraad"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/20944> a <http://schema.org/Thing>, skos:Concept,
      <https://data.niod.nl/thesaurus_wo2/ImagesWW2/Legislation>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/ravend>;
    dcterms:modified "2024-12-13T08:50:14.659Z"^^xsd:dateTime;
