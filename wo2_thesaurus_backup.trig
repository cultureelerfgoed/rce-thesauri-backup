    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/e/e8/Leusderheide_-_herdenkingskruis_Jannetjesdal.jpg/500px-Leusderheide_-_herdenkingskruis_Jannetjesdal.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/wiki/File:Leusderheide_-_herdenkingskruis_Jannetjesdal.jpg";
    <http://schema.org/startDate> "1943-07-20"^^xsd:date;
    dcterms:source "https://www.4en5mei.nl/oorlogsmonumenten/zoeken/1678/leusden-gedenkkruis-bij-het-jannetjesdal"@de,
