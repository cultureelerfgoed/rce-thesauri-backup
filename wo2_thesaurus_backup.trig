    skos:broader <https://data.niod.nl/WO2_Thesaurus/1686>, <https://data.niod.nl/WO2_Thesaurus/4999>,
      <https://data.niod.nl/WO2_Thesaurus/8176>;
    dcterms:created "2019-08-26T11:34:10.000Z"^^xsd:dateTime;
    skos:prefLabel "Huis van Bewaring Assen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Het Huis van Bewaring Assen, ook Huis van Arrest Assen genoemd, was een gevangenis en interneringskamp (bijzondere rechtspleging) in Assen. Tijdens de Duitse bezetting van Nederland zaten hier verzetsdeelnemers gevangen. Op 11 december 1944 vond een overval plaats waarbij meer dan 50 verzetsdeelnemers werden bevrijd. Het Huis van Bewaring Arnhem was van 1945 tot 1948 in gebruik als interneringskamp. Hier zaten verdachten van en veroordeelden voor collaboratie opgesloten."@nl;
    skos:altLabel "Huis van Bewaring te Assen"@nl, "Huis van Arrest Assen"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
