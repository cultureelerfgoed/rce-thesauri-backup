    dcterms:source "https://www.tracesofwar.nl/sights/4677/Villa-Laag-Buurlo.htm"@nl,
      "https://www.4en5mei.nl/oorlogsmonumenten/monumenten_zoeken/oorlogsmonument/2951"@nl;
    <http://schema.org/url> <https://www.4en5mei.nl/oorlogsmonumenten/zoeken/2951/apeldoorn-plaquette-op-de-gevel-van-villa-laag-buurlo>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/isPointofInterest> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2870>, <https://data.niod.nl/WO2_Thesaurus/locations/9637>;
    dcterms:created "2019-03-11T15:35:03.000Z"^^xsd:dateTime;
    skos:prefLabel "Villa Laag Buurlo (Apeldoorn)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "Bij Villa Laag Buurlo werd op 14 april 1945 één van de laatste gevechten geleverd voor de bevrijding van Nederland, toen de bemanning van een Duits kanon op een tankonderstel de Canadezen ontdekte en het vuur opende op de villa. In de villa werden door de Canadezen voorbereidingen getroffen voor de bevrijding van Apeldoorn. Gedurende het gevecht drong een granaat door de buitenmuren van het huis naar binnen waarbij twee Canadese soldaten werden gedood: Captain F.J. Sims en Lieutenant J.W. Reardon. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/locations/8038> a skos:Concept, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "51.983477"^^xsd:float;
    <http://www.w3.org/2003/01/geo/wgs84_pos#long> "5.911470"^^xsd:float;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2025-12-17T14:38:14.509Z"^^xsd:dateTime;
    dcterms:source "https://mijngelderland.nl/inhoud/routes/freedomtrail/33-velperplein"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/isPointofInterest> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/locations/9601>;
    dcterms:created "2019-03-11T15:46:15.000Z"^^xsd:dateTime;
    skos:prefLabel "Velperplein (Arnhem)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:exactMatch <http://www.wikidata.org/entity/Q2617480>;
    skos:scopeNote "Het Velperplein vormde het hart van de Arnhemse afdeling van de Landelijke Knokploegen (LKP). Toon van Dalen, eigenaar van radiohandel Van Daalen Bros op nummer 8, en zijn buurman, elektricien Johan Penseel die een winkel had op nummer 7, waren lid van deze verzetsgroep en hun winkelpanden vormden de operatiebasis voor het verzet en er werd regelmatig overlegd door de lokale en regionale leiders van de LKP. Een geheime ondergrondse gang verbond de beide huizen met elkaar, terwijl een vluchtgang naar een filiaal van de Nederlandse Bank op nummer 9 een ontsnapping bij een inval moest vergemakkelijken."@nl;
    skos:altLabel "Panden LKP en LO "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/4889> .
  
  <https://data.niod.nl/WO2_Thesaurus/locations/8039> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "51.985051"^^xsd:float;
    <http://www.w3.org/2003/01/geo/wgs84_pos#long> "5.886020"^^xsd:float;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2025-12-17T14:37:41.823Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/nda/thumb/640x480/20f6dbf6-6870-4841-f413-6e6a8743d8a9.jpg";
    <http://schema.org/startDate> "1944-09-18"^^xsd:date;
    dcterms:source "http://mijngelderlandmedia.azureedge.net/2100/07-st-elisabeths-gasthuis_nl.pdf"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/isPointofInterest> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2845>, <https://data.niod.nl/WO2_Thesaurus/locations/9601>;
    dcterms:created "2019-03-11T16:02:52.000Z"^^xsd:dateTime;
    skos:prefLabel "St. Elisabeth Gasthuis (Arnhem)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "Het St. Elisabeth Gasthuis in Arnhem was gedurende de nacht en ochtend van 18 september 1944 onderdeel van hevige gevechten, toen diverse Britse bataljons vanuit Oosterbeek pogingen ondernamen om de parachutisten bij een nabijgelegen brug probeerde te bereiken. Zij stootten echter op hevige Duitse tegenstand en tijdens de gevechten deden Rode Kruis- en ziekenhuispersoneel, met gevaar voor eigen leven, verwoede pogingen om patiënten in veiligheid te brengen. Daarbij was het ziekenhuis nu eens in Engelse en dan weer in Duitse handen en, nadat de Duitsers het gasthuis definitief weer in handen hadden gekregen, werden de gewonde Britten krijgsgevangenen geëvacueerd en later getransporteerd naar Apeldoorn."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4665>, <https://data.niod.nl/WO2_Thesaurus/3585>,
      <https://data.niod.nl/WO2_Thesaurus/events/4411>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4460>;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/locations/8040> a <http://schema.org/Thing>, skos:Concept,
