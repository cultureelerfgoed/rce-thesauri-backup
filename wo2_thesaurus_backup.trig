    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/069795d2-025a-11e7-904b-d89d6717b464/media/00636fbe-c13a-b4c8-57a7-f5e74f3548b5"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/c88dbf36-025a-11e7-904b-d89d6717b464/media/27f2586e-4b70-24ff-2b22-8daf3070d4b1>,
