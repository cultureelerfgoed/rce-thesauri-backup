    <http://schema.org/startDate> "1945-04-17"^^xsd:date;
    dcterms:source "https://www.wieringermeer.nl/cgi-bin/objecten.pl "@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1760>;
    dcterms:created "2020-10-07T13:20:16.000Z"^^xsd:dateTime;
    skos:prefLabel "Dubbele proclamatie bevrijding Wieringermeer"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Dubbele proclamatie bevrijding Wieringermeer vond plaats op 17 april 1945 met de dood van Adriaan Cornelis de Graaf. Met de bevrijding in het vooruitzicht stelde het lokale verzet in het voorjaar van 1945 Adriaan Cornelis de Graaf, oud-wethouder en verzetsman, aan als waarnemend burgemeester voor een bevrijd Wieringermeer. De tekst van de proclamatie werd gedrukt met zijn naam eronder. De Graaf werd op 17 april 1945, de dag van de onderwaterzetting van de polder, doodgeschoten door een landwachter. Mede verzetsman Sicco Leendert Mansholt werd nu waarnemer, zijn naam verscheen op de tweede versie van de bevrijdingsproclamatie."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/7664>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
