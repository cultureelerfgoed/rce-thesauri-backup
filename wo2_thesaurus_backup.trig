    dcterms:created "2019-04-02T11:53:36.000Z"^^xsd:dateTime;
    skos:prefLabel "Inwerkingtreding Algemene Oorlogsongevallen Regeling in Indië"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Inwerkingtreding Algemene Oorlogsongevallen Regeling (AOR) in Indië vindt plaats op 3 juni 1946 en is bedoeld voor Nederlanders in Indië die door de oorlog geen inkomen meer konden verdienen. De verantwoordelijkheid voor uitvoering van de AOR ging bij de soevereiniteitsoverdracht op 27 december 1949 over naar de Indonesische staat, maar kwam op 1 februari 1954 weer voor rekening van Nederland."@nl .
  
