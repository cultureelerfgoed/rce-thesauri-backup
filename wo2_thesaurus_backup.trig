      "Archief 249-0508B Nederlandsche Dierenartsenkamer (NIOD) inv.nr. 1"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2024-08-12T12:03:08.698Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1942-02-25"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://www.delpher.nl/nl/kranten/view?coll=ddd&identifier=ddd:110531156:mpeg21:a0032>;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-06"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Nederlandsche Dierenartsenkamer was een nationaalsocialistische organisatie voor dierenartsen. Alle ongeveer 760 dierenartsen in Nederland waren verplicht lid van de Dierenartsenkamer. Enkele dierenartsen weigerden lid te worden. De Nederlandsche Dierenartsenkamer werd opgericht op 25 februari 1943."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2823>, <https://data.niod.nl/WO2_Thesaurus/20640>,
      <https://data.niod.nl/WO2_Thesaurus/20645>;
    dcterms:created "2023-05-11T11:44:13.307Z"^^xsd:dateTime;
    skos:prefLabel "Nederlandsche Dierenartsenkamer"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Nederlandsche Dierenartsenkamer werden per verordening op 25 februari 1942 ingesteld. De organisatie bezat verordende bevoegdheid. De Dierenartsenkamer was onderworpen aan het toezicht van de secretaris-generaal van Landbouw en Visserij en de secretaris-generaal van Sociale Zaken. Alle dierenartsen moesten verplicht lid zijn van deze nationaalsocialistische organisatie. President van de Nederlandsche Dierenartsenkamer was B.J.C. te Hennepe."@nl;
    skos:altLabel "Nederlandse Dierenartsenkamer"@nl, "Dierenartsenkamer"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
