    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Wikipedia:Wikiproject/Verzetskranten/Beginnetjes/De_baanbreker_(verzetsblad,_Zeist)&oldid=46516246"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/8629>;
    dcterms:created "2019-11-18T11:46:55.000Z"^^xsd:dateTime;
    skos:prefLabel "De Baanbreker: sociaal-democratisch orgaan (Zeist)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Baanbreker: sociaal-democratisch orgaan (Zeist) was een verzetsblad dat van september 1944 tot mei 1945 in Zeist werd uitgegeven. Het was van september tot maart 1945 een exclusief in Zeist uitgegeven kopie van de Utrechtse editie met een oplage van 500 stuks. Vanaf maart 1945 tot mei 1945 werd er een dagelijkse Zeister editie uitgebracht, met een oplage van 1500 stuks."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8769> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "52.230858"^^xsd:float;
    <http://www.w3.org/2003/01/geo/wgs84_pos#long> "6.234328"^^xsd:float;
    dcterms:references "Jochem Botman, Detentiecentrum Fort Blauwkapel (1945-1947) Waar de oorlog nog niet voorbij was (2026)"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-03-09T13:47:18.108Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/f/ff/Oxerhof%2C_aanzicht_-_Diepenveen_-_20057217_-_RCE.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/wiki/File:Oxerhof,_aanzicht_-_Diepenveen_-_20057217_-_RCE.jpg";
    dcterms:source "https://www.tracesofwar.nl/articles/4824/Landgoed-De-Oxerhof-in-Deventer.htm"@nl,
      "https://www.battlefieldtours.nu/blog/2017/07/08/het-drama-bij-landgoed-oxerhof/"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1686>, <https://data.niod.nl/WO2_Thesaurus/4999>,
      <https://data.niod.nl/WO2_Thesaurus/2420>, <https://data.niod.nl/WO2_Thesaurus/8176>;
    dcterms:created "2019-11-27T08:37:16.000Z"^^xsd:dateTime;
    skos:prefLabel "Landgoed De Oxerhof"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Landgoed De Oxerhof te Deventer werd in juni 1943 door de bezetter gevorderd en, nadat het kasteel op het landgoed eerst als woonhuis voor Hanns Albin Rauter was ingericht, omgevormd tot een hersteloord voor SS'ers die gewond waren geraakt aan het oostfront. In 1944 werd het onder de naam Kühoff een opleidingscentrum voor geheimagenten, die informatie in geallieerd gebied moesten verzamelen. Eind 1944 werd het opleidingscentrum gesloten en werd De Oxerhof een gevangenis van de Sicherheitsdienst, waar verzetsdeelnemers en deserteurs werden opgesloten. Van 10 april 1945 tot augustus 1945 was het in gebruik als interneringskamp (bijzondere rechtspleging). Hier zaten verdachten van en veroordeelden voor collaboratie opgesloten."@nl;
    skos:altLabel "Oxerhof"@nl, "Kamp Oxerhof"@nl, "Concentratiekamp Oxerhof"@nl, "Gevangenis Oxerhof"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
