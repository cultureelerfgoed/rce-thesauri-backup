    dcterms:created "2020-12-11T09:37:24.877Z"^^xsd:dateTime;
    skos:prefLabel "Bombardement op vliegveld Leeuwarden"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 24 februari 1944 werd het vliegveld Leeuwarden getroffen door een zware aanval van de Royal Air Force. In 10 minuten tijd werden er 5000 bommen gedropt op het vliegveld, dat tijdens de oorlog door de Duitsers was overgenomen. Het grootste deel van de startbanen raakte ernstig beschadigd."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/10846> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
