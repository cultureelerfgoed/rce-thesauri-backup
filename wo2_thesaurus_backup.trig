    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Het Nederlands Beheersinstituut (NBI) was een instituut die het in beslag genomen vermogen van verdachten beheerde. Ook beheerde het NBI het vermogen van vermiste personen."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/20701>;
