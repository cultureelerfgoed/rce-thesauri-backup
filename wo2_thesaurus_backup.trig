    <http://schema.org/location> "Salerno";
    <http://schema.org/startDate> "1943-09-09"^^xsd:date;
    <http://schema.org/endDate> "1943-09-16"^^xsd:date;
    dcterms:source "https://en.wikipedia.org/wiki/Operation_Avalanche#The_German_strategy_changes"@nl;
    skos:relatedMatch <https://data.niod.nl/WO2_Thesaurus/17946>;
