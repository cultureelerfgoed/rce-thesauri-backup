    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/031ea8f4-8c72-76e0-ffc7-f293b2636b38.jpg"@en;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/0735a092-025a-11e7-904b-d89d6717b464/media/031ea8f4-8c72-76e0-ffc7-f293b2636b38";
    <http://schema.org/location> "Jakarta";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/fa6c0224-025a-11e7-904b-d89d6717b464/media/fd3b6222-b265-d604-6d84-62f0baaf067b>,
      <http://93.191.128.243/MHM/Details/collect/5730>, <https://beeldbankwo2.nl/nl/beelden/detail/07a3f0f6-025a-11e7-904b-d89d6717b464/media/c7e36efd-c590-5d60-fce8-03f8f15154b4>;
    <http://schema.org/startDate> "1945-08-17"^^xsd:date;
    <http://schema.org/description> "Op 17 augustus 1945, om tien uur ’s morgens, leest Soekarno in de voortuin van zijn huis aan Pegangsaan Timoer 56 in Djakarta de onafhankelijkheidsproclamatie voor. Na het voorlezen van de proclamatie hijst Abdoel Latif, de ondercommandant het PETA-bataljon van Djakarta, de roodwitte vlag van de Republiek en wordt het volkslied, het Indonesia Raya gezongen. Soekarno wordt president, Hatta vice-president. Er wordt een grondwet aangenomen die bepaalt dat Indonesië een republiek is en er een kabinet komt dat verantwoording aflegt aan de president. Tot er algemene verkiezingen worden gehouden, vertegenwoordigt de KNIP (Komite Nasional Indonesia Poesat – Centraal Indonesisch Nationaal Comité) de gehele Indonesische bevolking. De leden van het comité worden door Soekarno benoemd."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/5110>, <https://data.niod.nl/WO2_Thesaurus/3533>,
      <https://data.niod.nl/WO2_Thesaurus/events/4402>, <https://data.niod.nl/WO2_Thesaurus/events/8185>;
    dcterms:created "2018-10-03T18:28:19.000Z"^^xsd:dateTime;
    skos:prefLabel "Uitroepen Indonesische Onafhankelijkheid"@nl, "Ausrufen Indonesischer Unabhängigkeit"@de,
      "Declaration of Indonesian Independence"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Het Uitroepen van de Indonesische Onafhankelijkheid, ofwel het Uitroepen van de Republik Indonesia (Proklamasi) gebeurde op 17 augustus 1945 door de Indonesische leiders Soekarno en Mohammed Hatta. Dit was twee dagen na de Japanse capitulatie. Nederland erkende de Republiek niet en streefde naar herstel van het koloniale gezag."@nl;
    skos:altLabel "Proklamasi"@nl, "Uitroepen Republik Indonesia"@nl, "Uitroepen van de Indonesische Onafhankelijkheid"@nl,
      "Indonesische Onafhankelijkheidsverklaring"@nl, "Uitroepen van de Republik Indonesia"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
