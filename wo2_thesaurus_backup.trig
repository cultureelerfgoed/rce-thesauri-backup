    dcterms:source "https://en.wikipedia.org/w/index.php?title=Battle_of_Smolensk_(1943)&oldid=961686160"@nl,
      "https://en.wikipedia.org/w/index.php?title=Battle_of_Smolensk_(1941)&oldid=973138275"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
