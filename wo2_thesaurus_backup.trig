    <http://schema.org/location> "Melbourne";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://www.nationaalarchief.nl/onderzoeken/archief/2.12.44>,
      <https://nimh-beeldbank.defensie.nl/foto-s/573d5ba6-1616-59ae-7873-b165a640a95a>,
