    skos:narrower <https://data.niod.nl/WO2_Thesaurus/events/7902>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/2669>;
    dcterms:created "2017-09-13T10:56:51.000Z"^^xsd:dateTime;
    skos:prefLabel "Groep Overduin"@nl, "'Groep Overduin'"@de, "'Groep Overduin'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Groep Overduin was een verzetsgroep, vanaf de zomer van 1942 actief in Enschede, die Joodse onderduikers verzorgde. Samen met enkele kleine groepjes in Almelo hebben zij minstens 800 joden (30% van de joden in Twente) voor deportatie behoed. Het merendeel van de Joden duikt onder in Twente, maar ook in Nijmegen, Hilversum, Harderwijk, de Achterhoek en in Friesland en Limburg. De Groep Overduin was gevormd rond Leendert Overduin, dominee van de Gereformeerde Gemeenten in Hersteld Verband te Enschede. Andere betrokken personen waren onder meer zijn zusters Corrie en Maartje Overduin, Friso van Hoorn, banketbakker G. Voogd en diens dochter Sara Voogd."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/5425> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "Coen Hilbrink, De illegalen. Illegaliteit in Twente en het aangrenzende Salland, 1940-1945 (Groningen, 1989)"@nl;
