    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Grave_(plaats)#/media/Bestand:Grave_-_Arsenaalplein.jpg";
    dcterms:source "https://www.joodsmonument.nl/nl/page/611094/de-joodse-slachtoffers-van-het-rijks-krankzinnigen-gesticht-te"@nl;
