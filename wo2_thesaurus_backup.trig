  <https://data.niod.nl/WO2_Thesaurus/19946> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "Gordon Williamson en Ramiro Bujeiro, World War II German Women’s Auxiliary Services (Osprey Publishing: Oxford. 2003). "@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2023-08-08T12:23:29.085Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/d/d1/Bundesarchiv_Bild_101I-768-0147-20%2C_Paris%2C_Wehrmachtshelferinnen.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/w/index.php?title=File:Bundesarchiv_Bild_101I-768-0147-20,_Paris,_Wehrmachtshelferinnen.jpg&oldid=678565164";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/a9fdde8a-0259-11e7-904b-d89d6717b464/media/c13bb258-7287-8b68-1eb8-c88a0bd37e84>,
      <https://beeldbankwo2.nl/nl/beelden/detail/a9ffe2d4-0259-11e7-904b-d89d6717b464/media/6007211c-93cb-17c1-bb2f-a2195b23a251>;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Wehrmachthelferin&oldid=63630126"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/19947>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3585>;
    dcterms:created "2023-08-08T10:55:31.280Z"^^xsd:dateTime;
    skos:prefLabel "Wehrmachthelferinnen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Wehrmachthelferinnen was het onderdeel van het Duitse leger waarin vrouwen dienden. De Wehrmacht, Kriegsmarine en Luftwaffe hadden allen verschillende takken waarin vrouwen in voornamelijk ondersteunende functies werkten. Per 29 november 1944 werden deze losse onderdelen formeel ondergebracht in de Wehrmachthelferinnen. De vrouwen stonden ook wel bekend als Blitzmädel of Blizmädchen en werden in Nederland ook wel eens 'grijze muizen' genoemd. "@nl;
    skos:altLabel "Blitzmädel"@nl, "Blitzmädchen"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/19947> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:references "Gordon Williamson en Ramiro Bujeiro, World War II German Women’s Auxiliary Services (Osprey Publishing: Oxford. 2003). "@en;
