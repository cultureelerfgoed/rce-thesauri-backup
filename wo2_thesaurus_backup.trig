    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Golf_van_Bengalen#/media/Bestand:Bay_of_Bengal_map_de.svg";
    <http://schema.org/location> "Golf van Bengalen";
    <http://schema.org/startDate> "1942-04-06"^^xsd:date;
