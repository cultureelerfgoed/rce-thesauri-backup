    skos:prefLabel "Burgerkamp Darmo-wijkkamp"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Burgerkamp Darmo-wijkkamp (ziekenkamp) functioneerde van mei 1945 tot augustus 1945. Een klein deel van de wijk, aan de Patrasstraat en de Camphuyslaan, was ingericht als ziekenkamp. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/7223> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
