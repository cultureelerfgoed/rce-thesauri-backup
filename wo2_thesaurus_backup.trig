    <http://schema.org/location> "Antwerpen";
    <http://schema.org/startDate> "1939-07-17"^^xsd:date;
    dcterms:source "https://www.joodsamsterdam.nl/ss-dora/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/18602>;
    dcterms:created "2022-01-12T11:56:20.706Z"^^xsd:dateTime;
    skos:prefLabel "Tussenstop SS Dora in Antwerpen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Op 17 juli 1939 maakte de SS Dora een tussenstop in Antwerpen om Duits-Joodse vluchtelingen op te halen. Na veel discussie over het aantal gingen uiteindelijk zo'n 170 vluchtelingen aan boord. De Dora vertrok nog dezelfde dag richting Vlissingen."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/18607> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:00:39.055Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/10116>;
    <http://schema.org/location> "Vlissingen";
    <http://schema.org/startDate> "1939-07-18"^^xsd:date;
    <http://schema.org/endDate> "1939-07-19"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/18602>;
    dcterms:created "2022-01-12T12:25:59.814Z"^^xsd:dateTime;
    skos:prefLabel "Tussenstop SS Dora in Vlissingen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Op 18 juli 1939 lag de SS Dora voor anker bij Vlissingen. Er waren personeels- en geldproblemen. Er werd besloten dat de Dora geen vluchtelingen meer in Le Havre in Frankrijk op ging halen omdat dit met alle vertragingen te veel risico op zou leveren. Bovendien zat het schip al helemaal vol. Op 19 juli 1939 vertrok de Dora richting Palestina."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/18608> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:00:39.174Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/18610>;
    dcterms:source "https://www.joodsamsterdam.nl/ss-dora/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/18602>;
    dcterms:created "2022-01-12T12:52:08.802Z"^^xsd:dateTime;
    skos:prefLabel "Tussenstop SS Dora in Turkije"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Begin augustus 1939 bereikte de Dora de zuidkust van Turkije. Er was een tekort aan voedsel en water. In de haven van Mersin werden naast voedsel en water vooral veel watermeloenen aan boord gebracht. Na ongeveer een week ging de tocht verder richting Palestina."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/18611> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:00:39.276Z"^^xsd:dateTime;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/18602>;
    dcterms:created "2022-01-12T13:26:39.700Z"^^xsd:dateTime;
    skos:prefLabel "Opstand op de SS Dora"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "In augustus 1939 brak er een opstand uit op de Dora. Het schip was net weer vertrokken uit Turkije. De bemanning eiste meer geld omdat de tocht langer dan de geplande twee weken duurde. Ook was er meer risico om door de Britten in Palestina opgepakt te worden omdat de Dora zelf de passagiers aan de kust moest afzetten. Het kleinere schip dat hiervoor was gepland was niet beschikbaar. Het is onduidelijk hoe de opstand werd opgelost, maar er kwam snel een einde aan."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/18612> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:00:39.415Z"^^xsd:dateTime;
