    <http://schema.org/startDate> "1944-09-19"^^xsd:date;
    dcterms:source "https://www.driel-polen.nl/nl/historie/cora-baltussen/"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/isPointofInterest> true;
