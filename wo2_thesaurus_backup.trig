    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Evacuatie van Soest vond plaats tussen 10 en 14 mei 1940, vanwege de Duitse inval in Nederland. Ongeveer 9.000 inwoners werden geëvacueerd. De evacués vertrokken per trein vanaf station Baarn naar verschillende plaatsen in West-Friesland, waaronder Venhuizen, Andijk en Wervershoof. Op 15 mei 1940 keerden de meeste inwoners op eigen gelegenheid terug naar huis."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/18618> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    dcterms:modified "2022-01-18T09:35:23.648Z"^^xsd:dateTime;
