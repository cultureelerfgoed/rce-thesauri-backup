    dcterms:created "2016-10-04T11:45:13.000Z"^^xsd:dateTime;
    skos:prefLabel "Ungarische Besetzung"@de, "Hungarian occupation"@en, "Hongaarse bezetting"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Met Hongaarse bezetting wordt hier bedoeld de gebiedsuitbreiding van Hongarije met delen van Slowakije, Karpato-Roethenië, Transsylvanië, Servië en Slovenië in november 1938, augustus 1940 en april 1941. Met deze re-annexaties kreeg Hongarije een deel terug van het grondgebied dat het na de Eerste Wereldoorlog had moeten afstaan. In 1945 werden de grenswijzigingen echter weer teruggedraaid."@nl .
  
