    skos:prefLabel "Oprichting Commissie Zeeverkeer"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Op 26 augustus 1939 richtte admiraal H. Ferwerda de Commissie Zeeverkeer op. Het viel onder het departement van Marine en regelde het gehele zeeverkeer, waaronder instructies voor de scheepvaart en de scheepsbelading in Nederlands-Indië. In deze commissie zaten kapitein-luitenant-ter-zee J.J.L. Willinge namens de Commandant der Zeemacht (CZM), W. van Enst (Economische Zaken), D.H. de Jong (directeur Koninklijke Paketvaart) als vertegenwoordiger der rederijen en als voorzitter J. Kuyper (hoofd Dienst van Scheepvaart).  "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/17682> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Dissel, Anita van, Martin Elands, Hylke Faber en Pieter Stolk, eds. De Nederlandse koopvaardij in oorlogstijd. Amsterdam: Boom, 2014. Bezemer, K.W.L.  Geschiedenis van de Nederlandse koopvaardij in de Tweede Wereldoorlog / Dl. 1 en dl. 2. Tweede druk. Amsterdam: Elsevier, 1987. "@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    dcterms:modified "2021-09-30T14:04:03.412Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/5d439fb2-e80c-099f-9608-c735bf15b36d.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/4663eca6-025a-11e7-904b-d89d6717b464/media/5d439fb2-e80c-099f-9608-c735bf15b36d";
    <http://schema.org/startDate> "1939-09-01"^^xsd:date;
    dcterms:source "https://www.tracesofwar.nl/articles/2506/Gemilitariseerde-schepen-van-de-Gouvernements-Marine.htm"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1870>;
    dcterms:created "2021-09-30T13:55:18.389Z"^^xsd:dateTime;
    skos:prefLabel "Militarisering Dienst van Scheepvaart"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Door de oorlogsdreiging werd de Dienst van Scheepvaart in Nederlands-Indië door de Nederlandse overheid gemilitariseerd om de scheepvaart in de Oost te kunnen voortzetten en beschermen. De Dienst van Scheepvaart was een civiele organisatie, opgericht in 1905 (bestaande uit o.a. de Gouvernements Marine) en verantwoordelijk voor het loodswezen, de havendiensten, betonning, bebakening en verlichting in Nederlands-Indië. In 1939 werd het onder het Departement Marine en de Commandant der Zeemacht in Nederlands-Indië (CZMNI) geplaatst, waardoor het direct door de marine werd aangestuurd."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
