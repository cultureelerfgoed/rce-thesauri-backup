    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://www.nationaalarchief.nl/onderzoeken/archief/2.20.05>;
    <http://schema.org/startDate> "1957-12-05"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/8386>;
    dcterms:created "2019-04-24T14:51:54.000Z"^^xsd:dateTime;
    skos:prefLabel "Nationalisatie Nederlandse bedrijven door Indonesië"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Nationalisatie Nederlandse bedrijven door Indonesië vindt plaats op 5 december 1957, nadat radicale Indonesische nationalisten Nederlandse bedrijven bezetten. In Jakarta zijn de bedrijfspanden van het scheepvaartbedrijf KPM en de handelsondernemingen Borsumij, Jacobsen Van den Berg, Lindeteves, Internatio en Geo Wehry doelwit van de actie. De Indonesische regering is volkomen verrast door de spontane bezettingen."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8413> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2019-04-24T14:57:10.000Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/wo2nedindieThema> "Erkenning en rechtsherstel";
    <http://schema.org/startDate> "2015-12-16"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/8386>;
    dcterms:created "2019-04-24T14:55:47.000Z"^^xsd:dateTime;
    skos:prefLabel "Inwerkingstelling Uitkeringsregeling Backpay"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Inwerkingstelling Uitkeringsregeling Backpay wordt door de Staatssecretaris van Volksgezondheid, Welzijn en Sport gedaan op 16 december 2015. Deze regeling heeft betrekking op het toekennen van een eenmalige uitkering aan hen die ambtenaar of militair ten tijde van de Japanse bezetting in Nederlands-Indië in dienst waren van het Nederlands-Indisch Gouvernement en aan wie gedurende deze periode geen dan wel onvolledig salaris is uitbetaald."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/8414> a <http://schema.org/Thing>, skos:Concept,
