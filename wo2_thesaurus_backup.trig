    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Transport Kamp Amersfoort - Buchenwald, 18-04-1944 - 19-04-1944 vertrok met 538 mannen naar Kamp Buchenwald. Het transport ging via Rheine en Weimar waar enkele gevangen de trein verlieten. De overige 497 gevangenen werden in Buchenwald tewerkgesteld."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/18756> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Scheepsramp 'Joanna', door H. Beukema, Delfzijl 1998"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2023-05-28T14:44:18.781Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/12456>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/7797ae7c-6df8-7b70-fbf6-5c456323439d.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/831c7c30-025a-11e7-904b-d89d6717b464/media/7797ae7c-6df8-7b70-fbf6-5c456323439d";
    <http://schema.org/startDate> "1945-05-09"^^xsd:date;
    dcterms:source "https://www.dodenakkers.nl/grafmonumenten/een-oorlogsgraf-met-fouten.html"@nl,
      "https://www.tracesofwar.nl/articles/4387/Oorlogsslachtoffers-op-de-Eems-in-vredestijd-9-mei-1945.htm"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3511>;
    dcterms:created "2022-02-24T13:53:07.225Z"^^xsd:dateTime;
    skos:prefLabel "Scheepsramp Joanna"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De scheepsramp met motorschip Joanna vond plaats op 9 mei 1945. Het schip was van het Duitse waddeneiland Wangerooge op weg naar Delfzijl en had een groot aantal dwangarbeiders aan boord. Die hadden op 7 mei gehoord dat Duitsland had gecapituleerd en wilden terug naar Nederland. De Duitse kapitein Heinz Baumeister wilde ze wel naar Delfzijl brengen. Hij nam voor de zekerheid de Nederlandse naam aan van de kapitein-eigenaar, Piet Visser. Zijn Duitse bemanning werd onderweg afgezet in de haven van Norddeich. Op 9 mei voer het schip in de Eems op een zeemijn. Van de waarschijnlijk 46 opvarenden overleefden slechts zeven de ramp. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/11161> .
  
