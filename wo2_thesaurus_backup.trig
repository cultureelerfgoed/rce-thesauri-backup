    <http://schema.org/startDate> "1945-03-29"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2682>;
    dcterms:created "2021-02-10T14:22:29.762Z"^^xsd:dateTime;
    skos:prefLabel "Liquidatie van Jacoba Aagje Louwe"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De liquidatie van Jacoba Aagje Louwe vond plaats op 29 maart 1945 in Rotterdam. Op de liquidatielijst van de LKP Rotterdam stond als reden: verraadster. Louwe werd in de Boezemstraat door twee KP'ers doodgeschoten."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/11070> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
