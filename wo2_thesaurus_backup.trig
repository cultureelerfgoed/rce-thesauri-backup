    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/4a4d2eec-ed20-832c-2502-71b95dd8b892.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/258a8422-025a-11e7-904b-d89d6717b464/media/4a4d2eec-ed20-832c-2502-71b95dd8b892";
    <http://schema.org/location> "Sittard";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/258adf58-025a-11e7-904b-d89d6717b464/media/330dbe8b-3866-7148-ccc4-6578eb17681a>,
      <https://beeldbankwo2.nl/nl/beelden/detail/258b4394-025a-11e7-904b-d89d6717b464/media/a96afd53-1ce8-9833-6920-716c58ff0924>;
    <http://schema.org/startDate> "1944-09-18"^^xsd:date;
    <http://schema.org/endDate> "1944-09-19"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/wiki/Geschiedenis_van_Sittard"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/6983>;
    dcterms:created "2018-10-19T08:06:27.000Z"^^xsd:dateTime;
    skos:prefLabel "Befreiung von Sittard"@de, "Liberation of Sittard"@en, "Bevrijding Sittard"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De bevrijding van Sittard vond plaats op 18 en 19 september 1944 door troepen van de Amerikaanse 2nd Armored Division. Het front liep ten noorden en oosten van Sittard vast waardoor de stad nog tot januari 1945 in de frontlinie lag. Deze periode werd de 'granatentijd' genoemd. Er werd veel schade aan de stad toegebracht en er vielen meerdere slachtoffers door de Duitse beschietingen. "@nl .
  
