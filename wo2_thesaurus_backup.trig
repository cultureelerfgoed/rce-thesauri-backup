    skos:prefLabel "Saksen-Weimarkazerne"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Saksen Weimarkazerne te Arnhem waren vanaf het begin van de Duitse bezetting Duitse troepen gelegerd. De SS-Unterführerschule Arnheim was vanaf circa augustus 1943 in de Saksen Weimarkazerne in Arnhem gevestigd. De school stond onder leiding van SS-Standartenführer Willi Fortenbacher en vanaf juli 1944 SS-Standartenführer Michael Lippert."@nl;
    skos:altLabel "Saksen-Weimarkaserne"@de, "SS-Unterführerschule Arnheim "@de, "Saksen Weimarkazerne"@nl,
      "Saksen Weimar Kazerne"@nl;
