    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Nationaal_Arbeids-Secretariaat&oldid=53659252"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2146>;
    dcterms:created "2019-09-04T19:37:36.000Z"^^xsd:dateTime;
    skos:prefLabel "Nationaal Arbeids-Secretariaat"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Nationaal Arbeids-Secretariaat (NAS) was een radicaal-linkse syndicalistische koepelorganisatie van Nederlandse vakbonden dat bestond van 1893 tot 1940. Op 8 september 1940 werd het NAS door de Duitse bezetter geliquideerd. "@nl;
    skos:altLabel "Nationaal Arbeids Sekretariaat"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/8579> a <http://schema.org/Thing>,
