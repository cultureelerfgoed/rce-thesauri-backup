    skos:prefLabel "Het Dagelijks Nieuws"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het Dagelijks Nieuws was een verzetsblad dat vanaf 9 juni 1943 tot 9 mei 1945 eerst titelloos en daarna tot 25 juli 1944 onder de titel BERICHT No. 1 [2, 3, enz.] dagelijks verscheen in Leiden. Het blad bereikte en maximale oplage van circa 10.000 stuks."@nl;
    skos:altLabel "BERICHT No. 1 [2, 3, enz.]"@nl .
  
