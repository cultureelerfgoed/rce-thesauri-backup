    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/ravend>;
    dcterms:modified "2024-06-12T10:19:02.095Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/10441>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/c/cb/Bunker_met_witte_vlag.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/w/index.php?search=bunkers+grebbelinie&title=Special:Search&profile=advanced&fulltext=1&advancedSearch-current=%7B%7D&ns0=1&ns6=1&ns12=1&ns14=1&ns100=1&ns106=1#/media/File:Bunker_met_witte_vlag.jpg";
    <http://schema.org/startDate> "1944-06-06"^^xsd:date;
    dcterms:source "https://www.historieleusden.nl/museumbunker-grebbelinie/"@nl, "http://www.grebbelinie.nl/page/pantherstellung"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/isPointofInterest> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/4374>, <https://data.niod.nl/WO2_Thesaurus/locations/10441>;
    dcterms:created "2020-11-26T12:26:19.996Z"^^xsd:dateTime;
    skos:prefLabel "Nieuwe bunker in Leusden"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "In de zomer van 1944 verwachtte de Wehrmacht de geallieerden uit het zuidwesten. De Grebbelinie/Pantherstellung kreeg daarom 24 nieuwe bunkers waaronder een aan de Langesteeg in Leusden. In 1945 werd het kanon vanuit de bunker op de dijk geplaatst. De geallieerde opmars uit het oosten stopte rond 22 april. Bij patrouilles in het niemandsland tegenover de bunker sneuvelden vijf Canadezen."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/10568> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "52.12952"^^xsd:float;
    <http://www.w3.org/2003/01/geo/wgs84_pos#long> "5.46588"^^xsd:float;
    dcterms:references """‘Russen ondergedoken in Asschat’. Artikel in Leusden Toen, Historische Kring
Leusden, meinummer 2013"""@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-03-04T11:02:48.657Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/10572>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/5d2d5a0c-f86b-e467-f128-a682460ca15e.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/c3c23ef0-025a-11e7-904b-d89d6717b464/media/5d2d5a0c-f86b-e467-f128-a682460ca15e";
    <http://schema.org/location> "Asschat";
    <http://schema.org/startDate> "1944-10-15"^^xsd:date;
    <http://schema.org/endDate> "1945-01-31"^^xsd:date;
    dcterms:source "https://josehuurdeman.nl/publicaties/"@nl;
    skos:relatedMatch <https://data.niod.nl/WO2_Thesaurus/kampen/3652>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2695>;
    dcterms:created "2020-11-26T13:09:55.110Z"^^xsd:dateTime;
    skos:prefLabel "Russen ondergedoken in Asschat"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Twee gedeserteerde Russische krijgsgevangenen leefden maandenlang in Asschat onder de grond. In het diepste geheim brachten buurtbewoners eten. Eind januari 1945 ontdekte een Feldwebel voetsporen in de sneeuw en vond het hol. De Russen werden weggevoerd naar Kamp Amersfoort. Huiszoekingen leverden niets op en er volgden geen arrestaties."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
