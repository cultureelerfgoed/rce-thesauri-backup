    dcterms:created "2022-02-18T11:13:57.722Z"^^xsd:dateTime;
    skos:prefLabel "Executie op de Hamert, 2 mei 1943"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "In de avond van 2 mei 1943 werden zeven ter dood veroordeelde verzetslieden - J.L. Boogerd, M.A.M. Bouman, L.Th. Brouwer, P.L. Ruyters, R. Savelsberg, S. Toussaint en M. Tempelaars - terechtgesteld door een vuurpeloton van 15 soldaten en begraven op ‘De Hamert’ in Wellerlooi. Zij waren gevonnist vanwege hun betrokkenheid bij stakingen onder de mijnwerkers, als onderdeel van de zogenaamde April-Meistakingen. De executie werd geleid door oud SS-er Nitsch. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/2661> .
  
