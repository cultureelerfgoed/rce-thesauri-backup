      "https://bersiapkampen.nl/Sint%20Vincentius%20Bat.htm"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/19155>, <https://data.niod.nl/WO2_Thesaurus/19156>,
      <https://data.niod.nl/WO2_Thesaurus/19157>;
