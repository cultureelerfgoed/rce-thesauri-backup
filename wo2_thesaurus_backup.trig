    dcterms:created "2024-08-05T18:56:24.279Z"^^xsd:dateTime;
    skos:prefLabel "Tamadjo"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Tamadjo was een krijgsgevangenkamp aan de Birma Siam Spoorweg, gelegen op 237 km van Non Pladuk. Het kamp fungeerde eerst als werkkamp en vervolgens als houthakkerskamp. De werkzaamheden waren o.a. de aanleg van de spoordijk en het hakken van hout als brandstof voor de locomotieven."@nl;
    skos:altLabel "Tamadjo - 237"@nl, "Tamadju"@nl, "Tamaja"@nl, "Tomajo"@nl, "Tomajan"@nl,
      "Tha Ma Jao"@nl, "Tamajo"@nl, "Tamajao"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/21102> a <http://schema.org/Thing>, skos:Concept,
