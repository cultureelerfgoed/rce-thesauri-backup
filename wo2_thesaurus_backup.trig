    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/0/0f/Veritable_grenade.png/500px-Veritable_grenade.png";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Operatie_Grenade#/media/Bestand:Veritable_grenade.png";
    <http://schema.org/startDate> "1945-02-23"^^xsd:date;
    <http://schema.org/endDate> "1945-03-10"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/wiki/Operatie_Grenade"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/5110>;
    dcterms:created "2021-06-09T08:20:30.373Z"^^xsd:dateTime;
    skos:prefLabel "Operatie Grenade"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Operatie Grenade vond plaats tussen 23 februari en 10 maart 1945. Het was de zuidelijke helft van een tangbeweging om het gebied tussen de Roer en de Rijn te bevrijden. Het 9e Amerikaanse leger zou de Roer oversteken en zich voegen bij het Canadese leger dat noordelijk vanuit Nijmegen Operatie Veritable uitvoerde. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/14354> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2022-01-24T12:03:30.450Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/14355>;
    <http://schema.org/startDate> "1946-03-10"^^xsd:date;
    <http://schema.org/endDate> "1946-05-03"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2611>;
    dcterms:created "2021-06-09T09:55:36.730Z"^^xsd:dateTime;
    skos:prefLabel "Neuengamme-proces"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het Neuengamme-Hoofdproces was een Brits oorlogstribunaal dat zich van 18 maart 1946 tot 3 mei 1946 bevond in het Curiohaus, een voormalig conservatorium en cultuurhuis in Hamburg. Tijdens dit proces werden SS’ers berecht die oorlogsmisdaden hadden gepleegd in het concentratiekamp Neuengamme door een Britse militaire rechtbank. Naast dit hoofdproces werden oorlogsmisdadigers van de kampen Ravensbrück, Bergen-Belsen en Groβ-Rosen tot 1949 in het Curiohaus berecht."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/kampen/3688>;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/14356> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    dcterms:modified "2021-06-10T12:40:49.106Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/10255>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/e/e8/Hilversum_Polar_Bear.jpg/500px-Hilversum_Polar_Bear.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Polar_Bear_(Hilversum)#/media/Bestand:Hilversum_Polar_Bear.jpg";
    <http://schema.org/location> "Hilversum";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://www.nationaalarchief.nl/onderzoeken/fotocollectie/ac088680-d0b4-102d-bcf8-003048976d84>,
      <https://beeldbankwo2.nl/nl/beelden/detail/246d9c78-025a-11e7-904b-d89d6717b464/media/67e38682-b8e3-274c-713e-b6d8e282ce8c>,
      <https://beeldbankwo2.nl/nl/beelden/detail/66339b4e-025a-11e7-904b-d89d6717b464/media/1b88a5c5-89d6-6b87-187e-0f00501834b6>;
    <http://schema.org/startDate> "1945-05-07"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/wiki/Polar_Bear_(Hilversum)"@nl, "https://www.nhnieuws.nl/nieuws/266489/deze-helden-bevrijdden-hilversum-tijdens-de-tweede-wereldoorlog"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/6983>;
    dcterms:created "2021-06-09T10:34:41.218Z"^^xsd:dateTime;
    skos:prefLabel "Bevrijding Hilversum"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De bevrijding van Hilversum vond plaats op 7 mei 1945. De Britse 49e Infanterie Divisie, de Polar Bears, trokken vanuit Utrecht via de Utrechtseweg Hilversum binnen. De Polar Bears moesten na de bevrijding zorgen dat de Duitsers hun wapens in zouden inleveren. Op 10 mei 1945 gooide een Duitser een mijn op een stapel met munitie en hierbij kwamen dertien Polar Bears om. Ze zijn begraven op de Noorderbegraafplaats in Hilversum."@nl .
  
