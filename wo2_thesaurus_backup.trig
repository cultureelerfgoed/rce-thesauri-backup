    dcterms:source "http://www.encyclo.nl/lokaal/10068"@nl, "https://nl.wikipedia.org/w/index.php?title=Marxisme&oldid=47740090"@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/demoadmin>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1887>;
    dcterms:created "2016-08-01T19:19:28.000Z"^^xsd:dateTime;
    skos:prefLabel "Marxismus"@de, "Marxism"@en, "Marxisme"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het Marxisme is de sociaal-theoretische en politiek-filosofische grondslag voor talloze moderne sociale ideeën, scholen en denkrichtingen, gebaseerd op de ideeën en denkbeelden van Karl Marx en Friedrich Engels. Beperkt tot het politiek-ideologische vlak, vormt het marxisme de basis voor het moderne socialisme en communisme."@nl;
    skos:definition "Het Marxisme is de sociaal-theoretische en politiek-filosofische grondslag voor talloze moderne sociale ideeën, scholen en denkrichtingen, gebaseerd op de ideeën en denkbeelden van Karl Marx en Friedrich Engels. Beperkt tot het politiek-ideologische vlak, vormt het marxisme de basis voor het moderne socialisme en communisme. Deze politieke stroming en levensbeschouwing ontstond in de negentiende eeuw, toen de industriële revolutie voor een toenemende tweedeling in de maatschappij had gezorgd."@nl .
  
