    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/11363>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/3/3e/Ruin_of_the_White_House_%28Pill-box_II%29_in_Auschwitz_II_%28Birkenau%29.jpg/500px-Ruin_of_the_White_House_%28Pill-box_II%29_in_Auschwitz_II_%28Birkenau%29.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/wiki/File:Ruin_of_the_White_House_(Pill-box_II)_in_Auschwitz_II_(Birkenau).jpg";
