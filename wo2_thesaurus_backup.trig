    skos:prefLabel "Muhammadiyah"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Muhammadiya bestaat sinds 18 november 1912 en is opgericht in Jogjakarta door Ahmad Dahlan. Het doel van de organisatie is moslims de moderne tijd te laten omarmen, met inachtneming van hun geloof. Tijdens de Japanse bezetting van Indonesië was deze organisatie gedwongen pleitbezorger van de Japanse zaak."@nl;
    skos:altLabel "Moehammadijah"@nl, "Persyarikatan Muhammadiyah"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/4382>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
