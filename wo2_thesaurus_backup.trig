    dcterms:created "2022-02-23T13:17:43.869Z"^^xsd:dateTime;
    skos:prefLabel "Opvang Joodse vluchtelingen in vakantiehuis Centraal Israëlitisch Weeshuis Utrecht"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Opvang van Joodse vluchtelingen in het vakantiehuis van het Centraal Israëlitisch Weeshuis begon vlak na Kristallnacht, 9-10 november 1938. In totaal vonden 56 kinderen tijdelijk onderdak in het zomerhuis in Den Dolder. Zij kwamen voornamelijk uit Frankfurt am Main en Königsberg. Medio oktober 1939 werd het vakantiehuis ontruimd. Duitse vluchtelingen werd daarna onderdak geboden in het weeshuis aan de Nieuwegracht. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
