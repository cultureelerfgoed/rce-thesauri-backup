    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Razzia van Cornjum, een Fries dorpje ten noorden van Leeuwarden, vond plaats op 11 februari 1944. Tijdens een kerkdienst viel de bezetter binnen en nam negentien Friese mannen mee. Vijftien van hen werden tewerkgesteld in Drenthe tot de bevrijding van Noord-Nederland in april. "@nl;
    skos:altLabel "Razzia Cornjum"@nl, "Razzia Koarnjum"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
