    dcterms:modified "2026-02-03T12:38:06.893Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> <https://resolver.kb.nl/resolve?urn=urn:gvn:EVDO01:NIMH01_KBN013000025&role=image&size=large>;
