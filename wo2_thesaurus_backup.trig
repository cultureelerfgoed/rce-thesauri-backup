    dcterms:created "2019-01-23T14:01:31.000Z"^^xsd:dateTime;
    skos:prefLabel "Kantor Oeroesan Peranakan"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote """Het Kantor Oeroesan Peranakan (KOP) was een door de Japanse bezetter opgezette organisatie in Indonesië en bestond van juli 1943 tot maart 1944, toen de organisatie opging in de Jawa Hokokai. De organisatie, die onder leiding stond van P.F. Dahler, moest de Indo-Europeanen er van overtuigen mee te werken met de Japanners en zo voorkomen dat bij een geallieerde aanval de Indo-Europeanen zich achter de geallieerden zouden scharen.   
"""@nl;
    skos:altLabel "KOP"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/4382>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7746> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "Loe de Jong - Het Koninkrijk der Nederlanden in de Tweede Wereldoorlog"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2024-08-13T09:07:07.291Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8019>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/nda/thumb/250x250/def60ef3-49d8-a8e2-cda6-92eb1f737c03.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nimh-beeldbank.defensie.nl/memorix/39866d66-eb18-11df-a391-13966e870614";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <http://opac-gonext.oclc.org:8180/xslt/DB=8/XMLPRS=Y/PPN?PPN=041094611>,
      <http://www.gahetna.nl/collectie/afbeeldingen/fotocollectie/zoeken/weergave/detail/q/id/aefa62aa-d0b4-102d-bcf8-003048976d84>,
      <https://nimh-beeldbank.defensie.nl/memorix/5e3418be-ae74-1d2a-cdc2-3522e208159f>;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Korps_Insulinde&oldid=52295539"@nl;
    <http://schema.org/description> "In Colombo (Ceylon) wordt een Netherlands Special Operations-organisatie opgericht (NSO). Omwille van de geheimhouding spreekt men over de ‘afdeling Insulinde’. De eenheid heeft als voornaamste taak inlichtingengroepen (‘parties’) in te brengen in Sumatra. Op 1 augustus 1942 wordt NSO het Korps Insulinde. In de periode mei 1942 tot augustus 1945 voert het Korps Insulinde acht operaties uit op Sumatra met in totaal dertien landingen"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/events/8270>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3554>;
    dcterms:created "2019-01-23T14:29:16.000Z"^^xsd:dateTime;
    skos:prefLabel "Korps Insulinde"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Korps Insulinde bestond van maart 1942 tot maart 1946 en werd opgericht door de Prinses Irene Brigade. Het korps, onder leiding van KNIL-majoor F. Mollinger, had als doel om inlichtingen te verzamelen op bezet Sumatra. Na de Japanse bezetting was de taak van het korps het evacueren van de 15.000 krijgsgevangenen op Sumatra."@nl;
    skos:altLabel "Netherland Special operations"@en;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7747> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "Peter Post - The Encyclopedia of Indonesia in the Pacific War"@en;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-06-03T12:58:50.808Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/8028>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2210>;
    dcterms:created "2019-01-23T14:48:43.000Z"^^xsd:dateTime;
    skos:prefLabel "Togyo Kodan"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Togyo Kodan bestond van 5 juni 1943 tot het eind van de Japanse bezetting van Nederlands-Indië en werd door de Japanse bezetter opgericht op Java. De organisatie nam het voormalige Algemeen Syndicaat van Suikerfabrikanten in Nederlands-Indië en de Nederlands-Indische Vereniging voor de Afzet van Suiker (NIVAS) over en probeerde de productie van suiker te verdubbelen voor de productie van de brandstof butanol. Door problemen met het verschepen van de suiker wierp deze productie nooit zijn vruchten af en ontstond er voor de bevolking op Java een groot tekort aan suiker.      "@nl;
    skos:altLabel "Corporatie van de Suikerindustrie "@nl, "Sugar Industry Corporation"@en,
      "Togyo Rengokai"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/7748> a <http://schema.org/Thing>,
