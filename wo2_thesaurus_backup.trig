    skos:prefLabel "Executie Budel-Dorplein"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Als represaille voor de overval op een Duitse legertrein executeerden de Duitse autoriteiten op 5 september 1944 zes leden van de Sabotageploeg Dorplein. Het ging om Johannes Zandvliet, Jan Theodorus Stevens, Antonius Everardus van der Putten, Leo Louis Looymans, Martinus Hubertus Looymans en Cornelis Hendrikus Kappers."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/17738>;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
