    skos:prefLabel "Operatie Nutcracker"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Operatie Nutcracker was een militaire operatie van het Britse leger tussen 14 november en 3 december 1944, bedoeld om de Duitsers te verdrijven van het bruggenhoofd tussen de Peel en de Maas en het westelijke front te verleggen naar de Maas. Vooral bij Blerick ontstond een zware strijd, waarbij de burgers door de Duitsers werden ingezet om een tankgracht te graven."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/7011>;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/17763> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:04:24.107Z"^^xsd:dateTime;
