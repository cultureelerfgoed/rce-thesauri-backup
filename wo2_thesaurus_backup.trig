  <https://data.niod.nl/WO2_Thesaurus/18623> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    dcterms:modified "2022-02-01T11:41:44.959Z"^^xsd:dateTime;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1659>;
    dcterms:created "2022-01-25T13:16:53.829Z"^^xsd:dateTime;
    skos:prefLabel "Merktekens"@nl, "Kennzeichnungen"@de, "Badges"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Merktekens van gekleurde driehoeken op de kleding werden in concentratiekampen gebruikt om de verschillende groepen gevangenen van elkaar te onderscheiden. Rode driehoeken waren politieke gevangenen, roze driehoeken waren homoseksuelen, paarse waren Jehova's Getuigen, zwarte waren asocialen, bruine waren Sinti en Roma, groene waren criminelen en blauwe waren emigranten. Gele sterren (voor Joden) werden eventueel gebruikt in combinatie met bovengenoemde driehoeken. De gevangenen kregen ook een identificatienummer op de kleding. Dit nummer werd alleen in Auschwitz getatoeëerd op de huid."@nl;
    skos:altLabel "Roze driehoek"@nl, "Rode driehoek"@nl, "Bruine driehoek"@nl, "Zwarte driehoek"@nl,
      "Paarse driehoek"@nl, "Blauwe driehoek"@nl, "Groene driehoek"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2035>, <https://data.niod.nl/WO2_Thesaurus/2007> .
  
