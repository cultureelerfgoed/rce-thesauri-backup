  <https://data.niod.nl/WO2_Thesaurus/corporaties/4620> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "J.H. Nijdam, De NSNAP-Kruyt: een nationaal-socialistische splinterpartij in Nederland (1933-1941) (Doctoraalscriptie Vrije Universiteit Amsterdam 1986)"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2025-11-17T12:48:22.285Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1931-12-16"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/119a3ea5-af46-5de4-58f7-bf571fa57e8f.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/5ad10be2-025a-11e7-904b-d89d6717b464/media/119a3ea5-af46-5de4-58f7-bf571fa57e8f";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/64e8108a-025a-11e7-904b-d89d6717b464/media/c4ed94d0-1991-0dbf-d71d-8a4fafa2277d>,
      <http://beeldbank.amsterdam.nl/afbeelding/KOKBB00012000001>, <https://beeldbankwo2.nl/nl/beelden/detail/e88282be-0259-11e7-904b-d89d6717b464/media/6808e292-2f05-a5c1-d114-48c62f9b74b1>,
      <https://beeldbankwo2.nl/nl/beelden/detail/cc60679e-025a-11e7-904b-d89d6717b464/media/d308bf6d-e335-014b-483f-6fb3fc9de4e9>;
    <https://data.niod.nl/organizationsWO2/endDate> "1941-12-14"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Nationaal-Socialistische Nederlandsche Arbeiderspartij (NSNAP) was een nationaalsocialistische politieke partij, in 1931 opgericht door Bertus Smit en Ernst Herman ridder van Rappard. De NSNAP pleitte voor de aansluiting van Nederland bij Duitsland. In 1932 viel de partij uiteen in de NSNAP-Van Rappard, NSNAP-Smit en de NSNAP-Kruyt. In 1941 werden deze partijen op Duits bevel opgenomen in de Nationaal-Socialistische Beweging (NSB)."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/corporaties/5818>, <https://data.niod.nl/WO2_Thesaurus/corporaties/5816>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/5817>, <https://data.niod.nl/WO2_Thesaurus/20995>,
      <https://data.niod.nl/WO2_Thesaurus/20996>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1906>, <https://data.niod.nl/WO2_Thesaurus/2506>;
    dcterms:created "2016-10-04T13:07:40.000Z"^^xsd:dateTime;
    skos:prefLabel "N.S.N.A.P."@nl, "'NSNAP'"@de, "National Socialist Dutch Workers Party"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Nationaal-Socialistische Nederlandsche Arbeiderspartij (NSNAP) werd op 16 december 1931 opgericht door Bertus Smit en zijn secretaris dr. Ernst Herman Ridder van Rappard. Spoedig sloot Albert van Waterland (werkelijke naam Albert de Joode) zich aan. De NSNAP viel al in 1932 uiteen in drie, elkaar bestrijdende nazipartijtjes die zich allen tooiden met de naam NSNAP. Hierna deden zich nog verschillende splitsingen voor. De twee voornaamste NSNAP-en, die van de gepensioneerde majoor Cornelis Jacobus Aart Kruyt en die van Van Rappard, gingen op bevel van de Duitse autoriteiten respectievelijk in december 1940 en in december 1941 op in de NSB. "@nl;
    skos:altLabel "Nationaal-Socialistische Nederlandsche Arbeiderspartij"@nl, "Nationaal-Socialistische Nederlandse Arbeiderspartij"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/4621> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
