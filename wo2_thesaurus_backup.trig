  <https://data.niod.nl/WO2_Thesaurus/18664> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/jornaj>;
    dcterms:modified "2023-06-13T09:47:43.428Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/17443>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/90e9a595-058c-e0be-a17d-532750cbe6d9.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/a6c1af76-0259-11e7-904b-d89d6717b464/media/90e9a595-058c-e0be-a17d-532750cbe6d9";
    <http://schema.org/startDate> "1944-04-03"^^xsd:date;
    <http://schema.org/endDate> "1944-04-04"^^xsd:date;
    dcterms:source "https://historiek.net/vergeldingsbommen-op-nordhausen/133698/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/19538>;
    dcterms:created "2022-02-09T11:58:59.395Z"^^xsd:dateTime;
    skos:prefLabel "Bombardement op Nordhausen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Het bombardement op Nordhausen door de geallieerden vond plaats van 3 tot 4 april 1945. De Britten zagen het als vergelding voor de bommen die in 1940-1941 boven Engeland waren gedropt. In concentratiekamp Mittelbau bij Nordhausen en zo'n 40 buitenkampen vond de productie van V1's en V2's plaats. Er vielen zo'n 8800 doden waaronder gevangenen en dwangarbeiders uit de Boelcke-Kaserne. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/18647> .
  
