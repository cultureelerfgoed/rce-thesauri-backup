    dcterms:created "2023-05-08T08:43:35.773Z"^^xsd:dateTime;
    skos:prefLabel "Britse bombardementen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De eerste Britse bombardementen op doelen in Nederland vonden direct na de Duitse inval op 10 mei 1940 plaats. Gedurende de oorlog werden vliegvelden, havens, bruggen, spoorlijnen, fabrieken en olie- en brandstofopslaglocaties gebombardeerd. Vanaf eind april en beigin mai 1945 werden de voedseldroppingen onder de codenaam Operation Manna uitgevoerd."@nl .
  
