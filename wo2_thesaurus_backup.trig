    skos:prefLabel "Munitieopslagplaats Het Bommenbos (Groesbeek)"@nl, "Feldmunitionslager 15/VI (Groesbeek)"@de;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "Munitieopslagplaats Het Bommenbos (officieel Feldmunitionslager 15/VI) in het Staatsbos tussen Groesbeek en Mook werd in 1943 aangelegd voor de bevoorrading van Duitse militaire vliegvelden."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4580>, <https://data.niod.nl/WO2_Thesaurus/2209> .
  
