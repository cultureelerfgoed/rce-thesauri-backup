    dcterms:created "2019-11-08T10:29:18.000Z"^^xsd:dateTime;
    skos:prefLabel "Bulletin (Utrecht)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Bulletin (Utrecht) was een verzetskrant die van mei 1942 tot mei 1943 onregelmatig verscheen in Utrecht. Het blad bestond uit opiniestukken. In februari 1943 werd er een samenwerking aangegaan met verzetsblad Je Maintiendrai en in mei 1943 ging Bulletin op in dit blad."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8718> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "PPN: 860484262"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2020-09-01T12:10:49.000Z"^^xsd:dateTime;
    dcterms:source "https://upload.wikimedia.org/wikipedia/commons/2/23/PDF_of_De_Ondergrondse_Pers_1940-1945_-_derde_druk_-_1989.pdf"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4819>;
    dcterms:created "2019-11-08T10:54:16.000Z"^^xsd:dateTime;
    skos:prefLabel "M.L.L.-bulletin van het Marx-Lenin-Luxemburgfront"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "M.L.L.-bulletin van het Marx-Lenin-Luxemburgfront was één van de  verzetsbladen van het communistische Marx-Lenin-Luxemburgfront. Het blad verscheen van juli 1940 tot februari 1942 twee maal per maand in Amsterdam. Het blad bestond uit communistisch propagandamateriaal en was gericht tegen de nationaalsocialisten."@nl;
    skos:altLabel "Bulletin van het M.L.L.-Front; door klassestrijd en internationalisme naar het socialisme "@nl,
      "M.L.L.-BULLETIN"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8719> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "PPN: 116372214"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-01-23T14:32:53.389Z"^^xsd:dateTime;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/5450>, <https://data.niod.nl/WO2_Thesaurus/2372>;
    dcterms:created "2019-11-08T11:00:26.000Z"^^xsd:dateTime;
    skos:prefLabel "Spartacus; orgaan van het derde front"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het illegale blad Spartacus : Orgaan van het Derde Front werd van eind januari 1941 tot half februari 1942 uitgegeven in Amsterdam door het Marx-Lenin-Luxemburg-Front. Het blad verscheen 1× per 2 weken. Vanaf ca. juli 1941 ten dele voortgezet als: De Rode October : Orgaan van het Comité van Revolutionnaire Marxisten (CRM). Voorgezet als: Spartacus : bulletin van de revolutionnair-socialistische arbeiders in Nederland / [Communistenbond \"Spartacus\"]."@nl;
    skos:altLabel "Spartacus; orgaan van het Marx-Lenin-Luxemburg-Front"@nl .
  
