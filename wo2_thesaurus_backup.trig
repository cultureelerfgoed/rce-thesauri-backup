    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Eibergen#/media/Bestand:Watermolen_van_Mallem.jpg";
    <http://schema.org/startDate> "1945-03-20"^^xsd:date;
    dcterms:source "https://www.tubantia.nl/achterhoek/zoeken-naar-speld-in-hooiberg~a2776d24/?referrer=https%3A%2F%2Fwww.google.com%2F"@nl,
      "https://www.historischekringeibergen.nl/koninklijke-textiel-veredelingsfabriek/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3537>;
    dcterms:created "2020-11-30T13:38:32.241Z"^^xsd:dateTime;
    skos:prefLabel "Bombardement KTV-terrein Eibergen"@nl, "Bombardierung von KTV-Gelände Eibergen"@de,
      "Bombing of KVT-area Eibergen"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Bij het bombardement op 20 maart 1945 lieten zes geallieerde vliegtuigen zo'n veertig bommen vallen op het KTV-complex in Eibergen. Vijf gebouwen werden daarbij beschadigd. Op 23 maart 1945 was er weer een luchtaanval. Ditmaal werd het fabrieksterrein met raketten en boordwapens beschoten. Het kantoor kreeg een voltreffer, de kalanderij werd verwoest. Drie dagen later kwamen er weer vijf raketten neer op het complex."@nl .
  
