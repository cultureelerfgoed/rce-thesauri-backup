    <http://schema.org/startDate> "1944-09-17"^^xsd:date;
    dcterms:source "http://canonvanmoerdijk.nl/wo-ll-bevrijding/"@nl, "http://database.documentatiegroep40-45.nl/details2.php?ID=13792"@nl;
