    skos:prefLabel "Displaced Persons"@de, "Displaced Person"@en, "Displaced Persons"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Displaced Persons zijn mensen die (tengevolge van oorlog of onderdrukking) geen woonplaats meer hebben. Na de oorlog waren er naar schatting ongeveer 850.000 mensen - grotendeels uit Oost-Europa - die verbleven in speciale 'displaced person camps' in Oostenrijk, Italië en Duitsland. "@nl;
