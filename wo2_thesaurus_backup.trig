    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2020-09-01T07:45:51.000Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/250x250/2e54a40d-7e81-14ef-ad0b-a00a26e0a719.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/661443a2-025a-11e7-904b-d89d6717b464/media/2e54a40d-7e81-14ef-ad0b-a00a26e0a719";
