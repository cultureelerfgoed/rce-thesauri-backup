    <https://data.niod.nl/organizationsWO2/startDate> "1941-07-28"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/90bdfe11-e25e-a745-5155-b86f0508be5e.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/5ba35c8c-025a-11e7-904b-d89d6717b464/media/90bdfe11-e25e-a745-5155-b86f0508be5e"@nl;
    dcterms:source "https://resources.huygens.knaw.nl/socialezekerheid/instellingen_en_personen/show_long/NedVolksdienst"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-06"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    skos:relatedMatch <https://data.niod.nl/WO2_biografieen/Johannes-Werkhoven>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Nederlandsche Volksdienst (NVD) was een nationaalsocialistische hulporganisatie opgericht in 1941. De NVD hield zich bezig met sociale hulpverlening, zoals maatschappelijk werk en niet-medische zorg, op basis van de nazistische rassenleer. Uiteindelijk verving de NVD particuliere hulporganisaties en werkte de organisatie nauw samen met de Stichting Winterhulp Nederland."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2878>, <https://data.niod.nl/WO2_Thesaurus/20640>;
    dcterms:created "2016-10-04T13:07:40.000Z"^^xsd:dateTime;
    skos:prefLabel "'Nederlandsche Volksdienst'"@de, "'Nederlandsche Volksdienst'"@en,
      "Nederlandsche Volksdienst"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Nederlandsche Volksdienst (NVD) was nauw verbonden met Winterhulp Nederland en werd in de zomer van 1941 opgericht als tegenhanger van de Duitse Nationalsozialistische Volkswohlfahrt. De NVD moest de plaats innemen van de talrijke particuliere liefdadigheidsorganisaties die in het verzuilde Nederland bestonden en op den duur alle sociale hulpverlening, het maatschappelijk werk en de paramedische zorg gaan omvatten. De organisatie ging uit van de nazistische rassenleer en ontfermde zich alleen over mensen die ‘erfbiologisch’ gezond waren. De NVD werkte nauw samen met de Winterhulp en was evenals deze organisatie geen succes."@nl;
    skos:altLabel "Nederlandse Volksdienst"@nl, "Stichting Nederlandsche Volksdienst"@nl,
      "Ned. Volksdienst"@nl, "Nederlandschen Volksdienst"@nl, "Nederlandsche Volks Dienst"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/9089>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization>;
    skos:hiddenLabel "NVD"@nl, "N.V.D."@nl .
  
