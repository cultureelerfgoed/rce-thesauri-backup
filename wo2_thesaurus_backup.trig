    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/b/b2/Stolperschwelle_Arbeitslager_Wiesenfeld_%28Glinde%29.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/w/index.php?title=File:Stolperschwelle_Arbeitslager_Wiesenfeld_(Glinde).jpg&oldid=694573858";
    dcterms:source "https://www.stadtmarketing-glinde.de/lager-wiesenfeld"@de, "https://www.kultur-stormarn.de/stormarn-smart-entdecken/glinde/view/9"@de;
