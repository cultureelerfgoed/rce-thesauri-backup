    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het illegale blad De Bezem: de Waarheid, de Leugen werd uitgegeven in Utrecht."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8698> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "PPN: 268962405"@nl;
