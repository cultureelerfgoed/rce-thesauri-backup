    <http://schema.org/startDate> "1944-09-03"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/4409>;
    dcterms:created "2022-12-19T12:22:30.778Z"^^xsd:dateTime;
    skos:prefLabel "Silbertanne-moordpoging op Lambertus J. van Aken"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Silbertanne-moordpoging op Lambertus J. (Bertus) van Aken vond plaats op 3 september 1944 in Voorschoten. Van Aken was lid van de verzetsgroep ‘rond de Laurentiuskerk’ in Voorschoten. Hij werd door de SS’ers Rauwerda en Besteman in de deuropening van zijn huis op de Voorstraat in Voorschoten met vier kogels neergeschoten, maar overleefde de aanslag. De moordpoging was wraak voor de liquidatie van NSB’er en Landwachter Johan Bouw."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/19413> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
