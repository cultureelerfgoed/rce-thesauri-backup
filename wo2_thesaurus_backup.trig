      "https://nl.wikipedia.org/w/index.php?title=Wikipedia:Wikiproject/Verzetskranten/Beginnetjes/De_baanbreker_(verzetsblad,_Utrecht)&oldid=46516215"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/8768>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>;
    dcterms:created "2019-11-06T08:54:23.000Z"^^xsd:dateTime;
    skos:prefLabel "De Baanbreker; sociaal-democratisch orgaan (Utrecht)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Baanbreker; sociaal-democratisch orgaan was een verzetsblad dat door de Sociaal-Democratische Arbeiderspartij (SDAP) wekelijks van 19 augustus 1944 tot december 1944 werd uitgegeven in Utrecht (maar werd gedrukt in het Friese Bergum) en een oplage had van 3000 tot 5000 stuks. Het blad had als doel het richting geven aan jonge SDAP'ers. Om ook aan de behoefte aan nieuwsvoorziening te voldoen werd onder dezelfde titel van 30 september 1944 tot mei 1945 in Utrecht dagelijks een nieuwsbulletin uitgegeven met een oplage van 3500 stuks en deze verving de wekelijkse editie vanaf december 1944 en werd in Utrecht gedrukt."@nl;
    skos:altLabel "De Baanbreker"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4672> .
  
  <https://data.niod.nl/WO2_Thesaurus/8630> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "PPN: 268796416"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2019-11-08T08:55:00.000Z"^^xsd:dateTime;
    dcterms:source "https://upload.wikimedia.org/wikipedia/commons/2/23/PDF_of_De_Ondergrondse_Pers_1940-1945_-_derde_druk_-_1989.pdf"@nl,
      "http://katwijkinoorlog.nl/het-baken-een-katwijkse-verzetskrant/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>;
    dcterms:created "2019-11-06T09:34:52.000Z"^^xsd:dateTime;
    skos:prefLabel "Het Baken (Katwijk)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het Baken was een verzetsblad uit Katwijk aan Zee dat vanaf 14 april 1944 tot 31 mei 1945 in een oplage van 400 tot 2000 stuks drie maal per week verscheen. Plaatselijk leider van de Landelijke Organisatie voor Hulp aan Onderduikers (LO) Willem Vooijs was de drijvende kracht achter het blad en het blad werd één van de manieren waarmee hij inkomsten genereerde voor de onderduikers."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/8631> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "PPN: 266269532"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2019-11-07T16:11:39.000Z"^^xsd:dateTime;
