    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/2e9dac39-0f3a-a1a9-2af4-f8888bb8dacd.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/ff945c92-025a-11e7-904b-d89d6717b464/media/2e9dac39-0f3a-a1a9-2af4-f8888bb8dacd";
    <http://schema.org/location> "Rhenen";
    <http://schema.org/startDate> "1944-10-03"^^xsd:date;
    <http://schema.org/endDate> "1944-10-22"^^xsd:date;
    dcterms:source "https://dspace.library.uu.nl/bitstream/handle/1874/249002/RHEN_1990-02_2.pdf?sequence=1"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1922>, <https://data.niod.nl/WO2_Thesaurus/events/4391>;
    dcterms:created "2022-01-06T11:17:26.326Z"^^xsd:dateTime;
    skos:prefLabel "Evacuatie van Rhenen 1944"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Evacuatie van Rhenen van 1944 vond plaats vanaf 3 oktober 1944, na het mislukken van Operatie Market-Garden. Om de inwoners van de gemeente Rhenen te beschermen tegen voornamelijk geallieerde oorlogshandelingen, werden de inwoners van Rhenen, Achterberg en Elst stapsgewijs geëvacueerd tussen 3 oktober 1944 en 22 oktober 1944. Zij vertrokken onder andere naar Amerongen, Leersum, Doorn en Driebergen. Ook de repatriëring vond stapsgewijs plaats: tussen 22 februari en 1 juni 1945 mochten de bewoners van Rhenen terugkeren."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/18583> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
