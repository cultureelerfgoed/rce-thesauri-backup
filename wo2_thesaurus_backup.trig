  <https://data.niod.nl/WO2_Thesaurus/1718> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:34:48.292Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/250x250/073d6dce-6223-4b85-ba88-eb1a0fe8efce.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/d395c5f0-0259-11e7-904b-d89d6717b464/media/073d6dce-6223-4b85-ba88-eb1a0fe8efce";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <http://hdl.handle.net/10934/RM0001.COLLECT.466564>,
      <https://beeldbankwo2.nl/nl/beelden/detail/4757b034-025a-11e7-904b-d89d6717b464/media/97db84ae-e55c-c59a-84d4-825b94ea13d8>,
      <https://www.nationaalarchief.nl/onderzoeken/fotocollectie/ad96e74e-d0b4-102d-bcf8-003048976d84>;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Regering_in_ballingschap&oldid=45905384 "@nl;
    <http://schema.org/description> """Een regering in ballingschap is een politieke entiteit die beweert de wettelijke regering te zijn van een land, maar deze macht niet kan uitvoeren om verscheidene redenen. Om die reden verblijft ze in een ander land. Regeringen in ballingschap handelen meestal in de veronderstelling eens terug te keren naar het thuisland om opnieuw de macht uit te oefenen. Deze regeringen verschijnen meestal tijdens een oorlogsperiode. Tijdens de Tweede Wereldoorlog, toen vele landen werden bezet door nazi-Duitsland, weken vele regeringen en monarchen - waaronder Koningin Wilhelmina en de Nederlandse regering - uit naar het Verenigd Koninkrijk, in plaats van zich over te geven aan de bezetter.
"""@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/demoadmin>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/corporaties/5081>, <https://data.niod.nl/WO2_Thesaurus/corporaties/6090>,
      <https://data.niod.nl/WO2_Thesaurus/events/8170>, <https://data.niod.nl/WO2_Thesaurus/corporaties/5062>,
      <https://data.niod.nl/WO2_Thesaurus/events/7642>, <https://data.niod.nl/WO2_Thesaurus/events/7644>,
      <https://data.niod.nl/WO2_Thesaurus/events/7641>, <https://data.niod.nl/WO2_Thesaurus/events/7643>,
      <https://data.niod.nl/WO2_Thesaurus/events/7846>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1763>;
    dcterms:created "2016-08-01T19:19:11.000Z"^^xsd:dateTime;
    skos:prefLabel "Exilregierung"@de, "Government in exile"@en, "Regering in ballingschap"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Een Regering in ballingschap is een politieke entiteit die beweert de wettelijke regering te zijn van een land, maar deze macht door omstandigheden niet kan uitvoeren.  Een Regering in Ballingschap verblijft in een ander land. Tijdens de Tweede Wereldoorlog weken Koningin Wilhelmina en het Nederlandse kabinet uit naar het Verenigd Koninkrijk, in plaats van zich over te geven aan de bezetter."@nl;
    skos:altLabel "Londens kabinet"@nl, "Londense kabinetten"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/1605> .
  
