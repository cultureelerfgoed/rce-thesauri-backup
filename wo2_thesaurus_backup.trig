    dcterms:created "2023-07-20T14:10:23.643Z"^^xsd:dateTime;
    skos:prefLabel "Hoofd van Dienst"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De rang hoofd van dienst ressorteerde onder het hoofdkwartier van de NSB. De rang behoorde hiermee tot de hoogste rangen van Mussert beweging.  Het hoofd van dienst was ook de hoogste rang binnen het Algemeen Toezicht Leden (ATL) van de NSB. Hij had de leiding over deze dienst en was aan de plaatsvervangend leider NSB Kees van Geelkerken persoonlijk verantwoording schuldig."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/19576> .
  
  <https://data.niod.nl/WO2_Thesaurus/19926> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "N.J.G. Sikkel (red.), Documentatie. Samengesteld ten behoeve van de Bijzondere Rechtspleging, op last van de Procureur-Fiscaal bij het Bijzonder Gerechtshof te Amsterdam (Amsterdam 1947) p. 53."@nl;
