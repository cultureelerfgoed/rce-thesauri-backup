    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Op 22 mei 1941 zijn 340 mannen, die opgepakt waren bij de razzia's in Amsterdam en Den Haag in februari 1941, van Buchenwald naar Mauthausen getransporteerd."@nl;
