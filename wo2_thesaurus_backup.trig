    skos:prefLabel "Philips-Kommando"@de, "'Philips-Kommando'"@en, "Philips-Kommando"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Philips-Kommando was een arbeidscommando in concentratiekamp Vught. Er werkten tussen februari 1943 en juni 1944 Joodse en niet-Joodse gevangenen in relatief beschermde omstandigheden in het grootste arbeidscommando in het kamp dat officieel de Philips Speciale Werkplaats Vught heette. Op 3 juni 1944 werden alle 496 Joodse Philips-gevangenen op transport gesteld naar Auschwitz waar zij op 6 juni 1944 aankwamen."@nl;
    skos:altLabel "Philips Speciale Werkplaats Vught"@nl, "Philips-Commando"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4638>, <https://data.niod.nl/WO2_Thesaurus/kampen/4884>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization>;
    skos:hiddenLabel "Philips Kommando"@nl, "Philipskommando"@nl .
  
