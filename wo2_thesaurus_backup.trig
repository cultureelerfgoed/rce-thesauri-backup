    dcterms:modified "2025-08-26T14:13:48.976Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/18633>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/3/31/Bundesarchiv_Bild_183-22015-0015%2C_Chemiekombinat_Buna.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/w/index.php?title=File:Bundesarchiv_Bild_183-22015-0015,_Chemiekombinat_Buna.jpg&oldid=838329083";
    dcterms:source "https://merwedegijzelaars.nl/werkplek/8/buna-werke-schkopau"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/events/8497>, <https://data.niod.nl/WO2_Thesaurus/18633>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2355>, <https://data.niod.nl/WO2_Thesaurus/1670>,
      <https://data.niod.nl/WO2_Thesaurus/2210>;
    dcterms:created "2016-10-04T13:07:39.000Z"^^xsd:dateTime;
    skos:prefLabel "Buna-Werke"@de, "Buna Werke"@en, "Buna-Werke"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Buna-Werke GmbH was een chemie-fabrikant. Tijdens de Tweede Wereldoorlog was in Auschwitz-Monowitz een fabriek van Buna Werke waar duizenden dwangarbeiders en concentratiekampgevangenen te werk werden gesteld voor de productie van synthetisch rubber. Vanaf 1939 tot en met 1944 werd ongeveer 237.000 ton kunstrubber door de BUNA gemaakt door ongeveer 10.000 arbeiders onder wie zo'n 6000 buitenlanders. Merwedegijzelaars uit Kamp Schkopau werden bij de BUNA en andere bedrijven in de omgeving tewerkgesteld."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/kampen/6392>;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/4464> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "NIOD"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2024-12-23T06:16:37.626Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1930-04-20"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/250x250/2ea45b73-80f1-8dc3-ac52-6dba21293715.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://beeldbankwo2.nl/nl/beelden/detail/a71dd77e-0259-11e7-904b-d89d6717b464/media/2ea45b73-80f1-8dc3-ac52-6dba21293715";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/95335f2e-025a-11e7-904b-d89d6717b464/media/9140eb35-164d-2947-8a5e-135fed40572f>;
    dcterms:source "https://en.wikipedia.org/w/index.php?title=League_of_German_Girls&oldid=1148099454"@en;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-10-10"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Bund Deutscher Mädel (BDM) was het vrouwenonderdeel van de Hitlerjugend, de jeugdorganisatie van de Nationalsozialistische Deutsche Arbeiterpartei (NSDAP). De activiteiten van de BDM bestonden uit marcheren, sporten, zingen en lessen in nationaalsocialistisch gedachtegoed. Vanaf 1936 was lidmaatschap verplicht voor alle Duitse meisjes van 10 tot 18 jaar. In 1944 had de BDM 4,5 miljoen leden. In Nederland was een onbekend aantal meisjes lid van de BDM."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2886>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4534>,
      <https://data.niod.nl/WO2_Thesaurus/1906>;
    dcterms:created "2016-10-04T13:07:39.000Z"^^xsd:dateTime;
    skos:prefLabel "Bund Deutscher Mädel"@de, "League of German Girls"@en, "Bund Deutscher Mädel"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Bund Deutscher Mädel (BDM) was de vrouwelijke tak van de Hitlerjugend. Meisjes van 10 tot 18 jaar waren vanaf 1936 verplicht lid, tenzij ze vanwege raciale gronden (d.w.z. een niet ‘Arische’ afkomst) hiervan werden uitgesloten. Naast het beoefenen van sport en andere activiteiten, werden leden van de BDM onderricht in de nationaalsocialistische ideologie en voorbereid op hun toekomstig rol van huisvrouw en moeder in de volksgemeenschap. In het jaar 1944 telde de Bund Deutscher Mädel 4,5 miljoen leden."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/21453>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/4465> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "NIOD"@nl;
