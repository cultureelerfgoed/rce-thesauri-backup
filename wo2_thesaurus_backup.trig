    <http://schema.org/startDate> "1943-03-27"^^xsd:date;
    <http://schema.org/endDate> "1944-02-29"^^xsd:date;
    dcterms:source "https://www.tracesofwar.nl/sights/28358/Buitenkamp-Moerdijk.htm"@nl,
      "https://geheugenvancentrum.amsterdam/nl/page/2450/twee-ooggetuigen--verslagen-over-het-buitencommando-moerdijk"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/4884>;
    dcterms:created "2021-12-15T13:50:10.177Z"^^xsd:dateTime;
    skos:prefLabel "Buitencommando Moerdijk"@nl, "Aussenkommando Moerdijk"@de, "Aussenkommando Moerdijk"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Van 27 maart 1943 tot eind februari 1944 was er een Buitencommando van Kamp Vught aan de haven in Moerdijk gevestigd. Ongeveer 500 Joden verbleven daar in scheepsbarakken en werden ingezet bij het graven van tankvallen in Zuid-Holland en Noord-Brabant. Er zaten ook politieke gevangenen in dit Buitencommando. De meeste mannen bleven hier werken tot enkele dagen voor hun transport naar Kamp Westerbork. Bij de bevrijding van Moerdijk op 9 november 1944 werd het kamp van het Commando in brand gestoken."@nl;
    skos:altLabel "Aussenkommando Moerdijk"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
