    dcterms:modified "2025-12-17T15:26:26.890Z"^^xsd:dateTime;
    dcterms:source "https://spannendegeschiedenis.nl/liberation-route/heilig-landstichting-sionshof"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/isPointofInterest> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/locations/9382>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4752>;
    dcterms:created "2019-03-14T16:05:38.000Z"^^xsd:dateTime;
    skos:prefLabel "Hotel Sionshof (Nijmegen)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "Op 17 september 1944, na de luchtlandingen bij Groesbeek, vestigde kapitein Arie Bestebreurtje, Nederlandse liaisonofficier bij de 82nd Airborne Division, zijn hoofdkwartier in Hotel Sionshof. Daarnaast diende het hotel als perscentrum voor de internationale media. Op 19 september vertrok van hieruit de eerste gecombineerde Amerikaans-Engelse aanval op de bruggen bij Nijmegen."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/locations/8112> a <http://schema.org/Thing>, skos:Concept,
