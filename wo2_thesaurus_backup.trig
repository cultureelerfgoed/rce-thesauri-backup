    skos:prefLabel "Secretarie van Staat"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Secretarie van Staat was een nationaalsocialistisch bestuursorgaan dat tussen februari 1943 en september 1944 het toekomstige aandeel van de NSB in het landsbestuur moest voorbereiden. Hoofd van de Secretarie was dr. J.H. Carp en het was gevestigd in het Groen van Prinsterer-huis aan de Korte Vijverberg in Den Haag. Na Dolle Dinsdag verdween de Secretarie van Staat van het toneel."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/16878> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:32:15.648Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/10674>;
