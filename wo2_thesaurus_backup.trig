    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/locations/9245>;
    dcterms:created "2020-08-18T06:19:42.000Z"^^xsd:dateTime;
    skos:prefLabel "Maliebaan 13"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "Aan de Maliebaan 13 zat het hoofdkantoor van het Rechtsfront, de beroepsorganisatie van de NSB voor werknemers in de juridische hoek. In het pand zaten drie afdelingen gevestigd: justitie, politie en 'vrije' beroepen als advocaten."@nl;
    skos:altLabel "Hoofdkantoor Rechtsfront Utrecht"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/locations/9252> a skos:Concept, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
