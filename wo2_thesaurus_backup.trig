    dcterms:created "2021-10-08T13:01:20.783Z"^^xsd:dateTime;
    skos:prefLabel "Nederlandse kunstschatten ondergebracht in Sint-Pietersberg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Op 24 maart 1941 vond het eerste treintransport plaats van Nederlandse kunstwerken naar de nieuw ingerichte nieuwe kunstbunker in de Sint-Pietersberg. In totaal werden circa 800 kunstschatten in de Limburgse kunstbunker opgeslagen, waaronder werken van Vermeer, Paulus Potter en De Nachtwacht van Rembrandt."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
