    <http://schema.org/startDate> "1941-06-22"^^xsd:date;
    <http://schema.org/endDate> "1941-07-03"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Slag_om_Bia%C5%82ystok-Minsk&oldid=56051215"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/kroesf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/events/4396>;
    dcterms:created "2020-09-11T12:50:51.000Z"^^xsd:dateTime;
    skos:prefLabel "De Slag om Białystok-Minsk"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Slag om Białystok-Minsk was een onderdeel van Operatie Barbarossa in Oost-Polen en Wit-Rusland die plaatsvond van 22 juni tot 3 juli 1941. De Duitsers rukten op naar Minsk en omsingelde drie legers van het Rode Leger. Vervolgens werden alle Sovjet-tegenaanvallen afgeslagen, waardoor Minsk in handen viel van de Duitse Wehrmacht."@nl .
  
