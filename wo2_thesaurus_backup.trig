    dcterms:source "https://de.wikipedia.org/w/index.php?title=Stunde_Null&oldid=163130137"@nl,
      "https://duitslandinstituut.nl/naslagwerk/80/tussen-derde-rijk-en-duitse-deling"@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    <https://data.niod.nl/EventsWO2/dateDescription> "1945"@nl;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1561>, <https://data.niod.nl/WO2_Thesaurus/2326>;
    dcterms:created "2016-10-04T11:45:13.000Z"^^xsd:dateTime;
    skos:prefLabel "Stunde Null"@nl, "Stunde Null"@de, "'Stunde Null'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Stunde Null duidt op het begin van een nieuw tijdperk na de totale ineenstorting van het nationaalsocialistisch bewind in Duitsland. De onvoorwaardelijke capitulatie van 8 mei 1945 zou een radicale breuk met het verleden moeten vormen waarna maatschappij, economie en staat opnieuw opgebouwd konden worden. Het begrip is echter in wetenschappelijke kring bekritiseerd."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/4850> a <http://schema.org/Thing>, skos:Concept;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2017-12-19T10:44:15.000Z"^^xsd:dateTime;
    dcterms:source "https://de.wikipedia.org/w/index.php?title=Holocaustleugnung&oldid=158496861"@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1634>;
    dcterms:created "2016-10-05T06:33:48.000Z"^^xsd:dateTime;
    skos:prefLabel "Auschwitz-Lüge"@de, "Auschwitz-Lüge"@en, "Auschwitz-Lüge"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Terwijl Holocaust-ontkenners met het begrip Auschwitz-Lüge de moord op de Joden als een leugen en verzinsel trachten neer te zetten, wordt in het algemene spraakgebruik de term inmiddels juist gebruikt voor het verloochenen en ontkennen van de Jodenvervolging en van de systematische vernietiging van Joden en Sinti en Roma in Auschwitz en andere vernietigingskampen."@nl;
    skos:altLabel "Auschwitzlüge"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/4888> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "NIOD"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
