    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Troepenmacht_in_Suriname&oldid=53414836"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1854>, <https://data.niod.nl/WO2_Thesaurus/3477>;
    dcterms:created "2019-12-11T10:16:06.000Z"^^xsd:dateTime;
    skos:prefLabel "Troepenmacht in Suriname"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Troepenmacht in Suriname (beter bekend als TRIS) was van 16 oktober 1868 tot de onafhankelijkheid van Suriname op 25 november 1975 het Nederlandse koloniale leger in Suriname. De TRIS kwam voort uit de splitsing van het 27e Bataljon West-Indische Jagers in de Troepenmacht in Suriname en de Troepenmacht op Curaçao. In 1939 kreeg de TRIS versterking van de toen opgerichte Surinaamse Schutterij."@nl;
    skos:altLabel "TRIS"@nl .
  
