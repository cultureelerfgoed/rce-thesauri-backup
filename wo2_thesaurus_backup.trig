    dcterms:created "2016-08-01T19:20:37.000Z"^^xsd:dateTime;
    skos:prefLabel "Buddhismus"@de, "Buddhism"@en, "Boeddhisme"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Boeddhisme is de leer en verering van Boeddha. Boeddhisten geloven dat men bevrijd kan worden uit de cirkel van wedergeboortes door het volgen van de door de Boeddha onderwezen 'middenweg'. De belangrijkste aspecten van deze middenweg zijn het uitbannen van alle materiële verlangens, het zich ethisch gedragen, en het ontwikkelen van de geest."@nl .
  
