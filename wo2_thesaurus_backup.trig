    dcterms:created "2021-09-23T11:49:01.670Z"^^xsd:dateTime;
    skos:prefLabel "CPN-Aktion"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "In de nacht van 24 op 25 juni 1941 werden onder de naam CPN-Aktion meer dan 400 communisten door de Duitse bezetter opgepakt. Na de inval in Nederland werden communistische partijen verboden. De actieve vervolging van communisten begon nadat Duitsland het Molotov-Ribbenpact had geschonden bij Operatie Barbarossa. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
