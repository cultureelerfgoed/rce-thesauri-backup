    dcterms:source "https://westerborkportretten.nl/bronnen/het-zigeunerlager-in-auschwitz-birkenau"@nl;
    <https://data.niod.nl/eventsWO2/toLocation> <https://data.niod.nl/WO2_Thesaurus/kampen/3659>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
