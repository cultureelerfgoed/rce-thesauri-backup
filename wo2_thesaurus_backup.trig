    dcterms:created "2021-09-23T13:44:02.248Z"^^xsd:dateTime;
    skos:prefLabel "United Maritime Authority"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Op 23 augustus 1944 trad de United Maritime Authority (UMA) in werking en bleef actief tot 2 maart 1946. Het werd opgericht door de geallieerden om na de oorlog het vervoer van voedsel en grondstoffen te garanderen. De UMA zou een korte periode na de oorlog de geallieerde koopvaardijvloten gezamenlijk beheren. Het gevolg hiervan was dat de bemanning van de koopvaardij tot die tijd niet naar huis konden."@nl;
    skos:altLabel "UMA"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/17651> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Dissel, Anita van, Martin Elands, Hylke Faber en Pieter Stolk, eds. De Nederlandse koopvaardij in oorlogstijd. Amsterdam: Boom, 2014."@nl;
