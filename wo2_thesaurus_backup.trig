    skos:prefLabel "'Het Parool'"@de, "'Het Parool'"@en, "Het Parool"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>;
    skos:scopeNote "Het Parool ontstond uit de Nieuwsbrief van Pieter 't Hoen van de journalist Frans Goedhart. Op 25 juli 1940 verscheen de eerste Nieuwsbrief en op 10 februari 1941 verscheen in Amsterdam het eerste exemplaar van Het Parool. Vanaf augustus 1941 kwam Het Parool in gedrukte vorm uit. Daarmee was het het eerste gedrukte illegale blad. Het blad werd door heel Nederland verspreid."@nl;
    skos:altLabel "Nieuwsbrief van Pieter 't Hoen"@nl, "Parool"@nl, "Parool-groep"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
