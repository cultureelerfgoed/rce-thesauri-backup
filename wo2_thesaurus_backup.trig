    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Ons_Volk_(verzetskrant)&oldid=51053832"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/bakkerm>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>, <https://data.niod.nl/WO2_Thesaurus/corporaties/2669>;
    dcterms:created "2018-03-07T08:57:29.000Z"^^xsd:dateTime;
    skos:prefLabel "Ons Volk-groep"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote """De Ons Volk-groep was een verzetsgroep rondom het illegale blad Ons Volk (nr. 581 in L. Winkel, De ondergrondse pers) dat verscheen van 7 oktober 1943 tot en met mei 1945 en vanuit o.a. Utrecht, Amsterdam en Den Haag landelijk werd verspreid. Doel van de uitgave was om de geest van het verzet te stimuleren. De oprichters van het blad waren de studenten G.H. Gelder en W. Eggink. Ons Volk was het eerste illegale orgaan waarin ook veel actuele foto's waren opgenomen. De verspreiding was grotendeels in handen van studenten en de relaties, die deze in verschillende plaatsen hadden. 
"""@nl;
    skos:altLabel "Ons Volk groep"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/6062> a <http://schema.org/Thing>,
