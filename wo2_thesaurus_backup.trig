    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Liberale_Staatspartij&oldid=53806229"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2506>;
    dcterms:created "2019-08-30T13:33:35.000Z"^^xsd:dateTime;
    skos:prefLabel "Liberale Staatspartij"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "LSP (Liberale Staatspartij) was een op 16 april 1921, onder de naam De Vrijheidsbond, opgerichte politieke partij. De partij, die in 1937 verder ging als de Liberale Staatspartij, was een traditioneel liberale partij in Nederland. Tijdens de Duitse bezetting van Nederland werd de partij op 5 april 1941 verboden en in 1946  ging de partij op in de Partij van de Vrijheid, die op haar beurt weer opging in de VVD."@nl;
    skos:altLabel "De Vrijheidsbond"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
