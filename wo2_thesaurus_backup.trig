      "https://nl.wikipedia.org/wiki/Reichsschule_Valkenburg"@nl, "https://anderetijden.nl/programma/1/Andere-Tijden/aflevering/276/De-Reichsschule-voor-jongens"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/isPointofInterest> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/17723>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/6032>;
    dcterms:created "2021-03-23T13:54:16.026Z"^^xsd:dateTime;
    skos:prefLabel "Reichsschule Valkenburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Reichsschule Valkenburg was een opleidingsinstituut met als doel jeugdige (Nederlandse) leerlingen voor leidende posities binnen het Groot-Germaanse Rijk op te leiden. Het eerder opgerichte NIVO voldeed niet aan de maatstaven die de bezetter hanteerde: te veel op Nederland gericht en te weinig discipline. Daarom werd met steun van Rauter in 1942 dicht bij Duitsland, in Valkenburg, de eerste Reichsschule für Jungen - Reichsschule Valkenburg - opgericht. Het was gevestigd in het Jezuïtenklooster, waaruit kort daarvoor de Jezuïeten verdreven waren. De school werd in 1944, wegens voortdurende luchtaanvallen in de directe omgeving en de dreiging van oprukkende geallieerde troepen richting de Nederlandse grens, verplaatst en opgenomen in de Napola in Bensberg bij Keulen."@nl .
  
