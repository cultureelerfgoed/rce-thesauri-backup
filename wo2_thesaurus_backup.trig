    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://www.japansekrijgsgevangenkampen.nl/Plattegrond%20Tarsao_bestanden/image002.jpg",
      "https://www.japansekrijgsgevangenkampen.nl/Plattegrond%20Tarsao%202_bestanden/image002.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://www.japansekrijgsgevangenkampen.nl/Plattegrond%20Tarsao.htm",
      "https://www.japansekrijgsgevangenkampen.nl/Plattegrond%20Tarsao%202.htm";
    dcterms:source "https://www.japansekrijgsgevangenkampen.nl/Tarsao.htm"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1699>, <https://data.niod.nl/WO2_Thesaurus/21031>;
    dcterms:created "2018-06-08T06:40:26.000Z"^^xsd:dateTime;
    skos:prefLabel "Tarsao"@nl, "Tarsao"@de, "Tarsao"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Tarsao was een krijgsgevangenkamp aan de Birma-Siam-spoorweg, gelegen op 130 km van Non Pladuk. Het kamp fungeerde als werkkamp, doorgangskamp en hospitaalkamp. De werkzaamheden waren o.a. de aanleg van de spoordijk en de opvang van zieken uit de andere kampen langs de Birma-Siam-spoorweg. Het is het eindpunt van de nog resterende spoorlijn vanuit Kanchanaburi en tevens de plek waar een gedenkteken is opgericht en waar jaarlijks op 25 april een Australische herdenking plaatsvindt."@nl;
    skos:altLabel "Tarso"@nl, "Tasao"@nl, "Tha Soe"@nl, "Tarsao - 130"@nl, "Thai kamp Tarsao"@nl,
      "Thai Kamp IV"@nl, "Tassao"@nl .
  
