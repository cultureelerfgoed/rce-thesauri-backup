    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/c6bbc7cf-b068-5351-3bac-645b245261e5.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/abe6e200-0259-11e7-904b-d89d6717b464/media/c6bbc7cf-b068-5351-3bac-645b245261e5";
    dcterms:source "https://merwedegijzelaars.nl/werkplek/6/bussing-braunschweig"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/6390>;
    dcterms:created "2022-01-27T15:06:16.428Z"^^xsd:dateTime;
    skos:prefLabel "Werkplek Büssing in Braunschweig"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Gevangenen in Kamp Mascherode werden tewerkgesteld bij de Firma Büssing in Braunschweig waar o.a. dieselmotoren werden gemaakt. De tewerkgestelden maakten werkweken van 72 uur. Aan het eind van de oorlog was de fabriek grotendeels vernield door geallieerde bombardementen en werden een aantal Nederlandse gevangenen samen met het werk verplaatst naar Hessen. Op 12 april 1945 werd Braunschweig door de Amerikanen bevrijd. "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/18629> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    dcterms:modified "2022-01-31T15:29:03.509Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/2a2bfea1-bc6b-a361-551a-9df985c59f0b.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/0f10326e-025a-11e7-904b-d89d6717b464/media/2a2bfea1-bc6b-a361-551a-9df985c59f0b";
    <http://schema.org/startDate> "1944-02-06"^^xsd:date;
    <http://schema.org/endDate> "1944-02-07"^^xsd:date;
    dcterms:source "https://pacificwrecks.com/ships/maru/yorihime.html"@nl, "https://web.archive.org/web/20130409135527/https://www.svd.org.au/Dorish%20Story%20Doc.pdf"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3511>;
    dcterms:created "2022-01-31T14:07:23.708Z"^^xsd:dateTime;
    skos:prefLabel "Scheepsramp Dorish Maru"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De scheepsramp met de Dorish Maru vond plaats in de nacht van 6 februari 1944. Het schip stond onder bevel van het Japanse Keizerlijke Leger en werd gebruikt als passagiers- en vrachtschip. Het was bewapend met luchtafweergeschut. Op 5 februari 1944 kwamen meer dan 100 missionarissen en burgergevangenen aan boord toen Dorish Maru voor anker lag in Hansa Bay. In de nacht van 6 februari vertrok het schip op weg naar Kairiru, een eiland in Papoea-Nieuw-Guinea. Er waren geen markeringen of vlaggen die aangaven dat er burgergevangenen aan boord waren. Voor de kust van Turubu werd het aangevallen door Amerikaanse vliegtuigen. Bisschop Wolf, 27 zusters, 7 priesters, 14 broeders, 28 nonnen en 7 anderen kwamen om het leven. Het beschadigde schip wist de haven van Wewak te bereiken. 's Avonds vertrok de Dorish Maru met de overlevenden en kwam op 8 februari 1944 in Humbolt Bay aan."@nl;
    skos:altLabel "Scheepsramp Yorihime Maru"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2350>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
