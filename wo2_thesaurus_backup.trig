    skos:prefLabel "Ambtenarenverbod ook van toepassing op NSB"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Op 28 december 1933 ondertekende minister-president Colijn het Koninklijk Besluit om het NSB-lidmaatschap voor ambtenaren te verbieden. Een onbekend aantal leden waren gedwongen de partij te verlaten."@nl;
