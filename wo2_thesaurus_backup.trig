    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/6411>;
    dcterms:created "2018-02-20T09:04:25.000Z"^^xsd:dateTime;
    skos:prefLabel "Stalag IX-B"@nl, "Stalag IX-B"@de, "Stalag IX-B"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Stalag IX-B was een Duits krijgsgevangenkamp bij Bad Orb, Duitsland. Het lag op de heuvel Wegscheideküppel en maakte oorspronkelijk deel uit van een militair oefenterrein. Er waren tijdens de oorlog meer dan 25.000 krijgsgevangen gehuisvest waaronder veel Russische. Joods-Amerikaanse troepen werden naar werkkamp Berga overgebracht. De gevangenen werden als dwangarbeiders in de omgeving te werk gesteld. Op 2 april 1945 werd het kamp door Amerikaanse troepen bevrijd."@nl;
    skos:altLabel "Bad Orb-Wegscheide"@nl, "Stalag IX B"@nl, "Stalag IX-B Bad Orb"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/5984> a <http://schema.org/Thing>, skos:Concept,
