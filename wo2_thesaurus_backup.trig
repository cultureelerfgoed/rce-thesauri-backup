    dcterms:source "https://wikimiddenbrabant.nl/Granaatinslagen_Daendelsstraat_e.o.,_18_oktober_1944"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/8508>;
    dcterms:created "2025-10-08T13:15:27.476Z"^^xsd:dateTime;
    skos:prefLabel "Granaatinslagen Daendelsstraat Tilburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De granaatinslagen in de Daendelsstraat en omgeving in Tilburg vonden plaats op 18 oktober 1944. Vanaf 14 oktober 1944 gaan Britse troepen (opnieuw) de strijd aan met Duitse troepen om Tilburg te bevrijden. Op 18 oktober slaan in de Daendelsstraat en omgeving granaten in. De granaten veroorzaken schade aan 54 panden. Minstens vijf mensen raken gewond, drie overlijden."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
