  <https://data.niod.nl/WO2_Thesaurus/21950> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>, <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-02-23T13:00:18.090Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/17400>;
    dcterms:source "https://en.wikipedia.org/wiki/Marburg_Central_Collecting_Point"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/ravend>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/21912>;
    dcterms:created "2026-02-18T11:32:22.464Z"^^xsd:dateTime;
    skos:prefLabel "Marburg Central Collecting Point"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het Marburg Central Collecting Point was het eerste kunstdepot in het Duitsland van na de oorlog. Het werd opgericht door het Amerikaanse Office of Military Government om kunstwerken te verzamelen die voor en tijdens de oorlog uit musea, bibliotheken, archieven, kastelen enz. waren geroofd of geëvacueerd, en deze terug te geven aan hun rechtmatige eigenaren. Het centrale verzamelpunt bestond tussen mei 1945 en half augustus 1946."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/21951> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>, <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2026-02-23T13:00:59.740Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/17339>;
    dcterms:source "https://de.wikipedia.org/wiki/Munich_Central_Collecting_Point"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/ravend>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/21912>;
    dcterms:created "2026-02-18T11:32:22.474Z"^^xsd:dateTime;
    skos:prefLabel "Offenbach Central Collecting Point"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het Offenbach Central Collecting Point beheerde voornamelijk joodse religieuze objecten, boeken, manuscripten en archieven.  In december 1945 werden de boeken en archiefstukken vanuit de Rothschild-bibliotheek in Frankfurt am Main over gebracht naar de I. G. Farben-fabriekshal in Offenbach, een voormalig industrieel complex dat werd omgedoopt tot het Offenbach Archival Depot (OAD). Op dat moment bevatte het OAD de grootste collectie joodse materialen ter wereld."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
