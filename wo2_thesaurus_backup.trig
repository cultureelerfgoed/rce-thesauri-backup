    dcterms:modified "2024-06-13T08:37:28.644Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/bakkerm>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>, <https://data.niod.nl/WO2_Thesaurus/corporaties/2669>;
    dcterms:created "2018-03-07T08:54:18.000Z"^^xsd:dateTime;
    skos:prefLabel "Christofoor-groep"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Christofoor-groep was een verzetsgroep rondom het illegale katholieke blad Christofoor (nr. 109 in L. Winkel, De Ondergrondse Pers). Christofoor werd rond mei 1942 opgericht en was aanvankelijk een klein plaatselijk rooms-katholiek verzetsblad, uitgegeven door o.a. de ambtenaar ter secretarie L.F.W. Jansen te IJsselstein. Vanaf mei 1943 groeide Christofoor uit tot een opinie-uitgave van vooruitstrevende rooms-katholieke jongeren. Begin 1944 begon Cristofoor nauw samen te werken met de groep rondom Je Maintiendrai. Na Dolle Dinsdag werd Christofoor in Amsterdam gereorganiseerd."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/6058> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "L.E. Winkel, De ondergrondse pers, 1940-1945. 3e dr., geheel herz. / door Hans de Vries (Utrecht: Veen, 1989) (nr. 520)"@nl,
      "PPN: 861431189"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-02-21T14:42:07.991Z"^^xsd:dateTime;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=De_nieuwsbode;_orgaan_van_de_vrije_pers&oldid=50277815"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/bakkerm>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>, <https://data.niod.nl/WO2_Thesaurus/corporaties/2669>;
    dcterms:created "2018-03-07T08:55:11.000Z"^^xsd:dateTime;
    skos:prefLabel "De Nieuwsbode"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Nieuwsbode was een illegaal blad dat vanaf 1 augustus 1942 tot en met 1 mei 1945 in Amsterdam en Utrecht werd uitgegeven, van waaruit het landelijk werd verspreid. De oprichters waren een aantal Amsterdamse en Utrechtse studenten. Het doel van De Nieuwsbode was het op zo ruim mogelijke schaal verspreiden van nieuws om zo de verzetsgeest aan te moedigen en daarnaast het verkrijgen van inkomsten ter ondersteuning van hen, die als gevolg van verzet hun normale inkomsten verloren hadden. Na arrestatie - door verraad - van de leiding begin 1944 werd de zetel van het blad naar Amsterdam verplaatst."@nl;
    skos:altLabel "DNB"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/6059> a <http://schema.org/Thing>,
      skos:Concept;
    dcterms:references "L.E. Winkel, De ondergrondse pers, 1940-1945. 3e dr., geheel herz. / door Hans de Vries (Utrecht: Veen, 1989) (nr. 326)"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:35:44.183Z"^^xsd:dateTime;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/bakkerm>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/8645>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2372>;
    dcterms:created "2018-03-07T08:55:37.000Z"^^xsd:dateTime;
    skos:prefLabel "Kroniek van de Week"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Kroniek van de Week was een illegaal blad dat verscheen van 20 juli 1943 tot 14 maart 1945 en landelijk werd verspreid. De oprichters waren de Leidse studenten J. Gijsman en J .M. van Stralen die eerder betrokken waren bij het illegale blad ‘Ik zal handhaven’. De joodse onderduiker ir. H.H. Adelaar te Leiden luisterde o.a. naar alle Russische uitzendingen in de oorspronkelijke taal, waardoor het soms gebeurde dat de Kroniek al een plaatsnaam aan het Oostfront kon opgeven, waarvan de BBC en Radio Oranje nog niet het ware wisten. "@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/6060> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "L.E. Winkel, De ondergrondse pers, 1940-1945. 3e dr., geheel herz. / door Hans de Vries (Utrecht: Veen, 1989) (nr. 789)"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
