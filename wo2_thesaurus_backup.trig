    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/22002>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/c/c0/Jacob_Catshuis_Sorghvliet%2C_achterkant_Catshuis%2C_Bestanddeelnr_916-1044.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/w/index.php?title=File:Jacob_Catshuis_Sorghvliet,_achterkant_Catshuis,_Bestanddeelnr_916-1044.jpg&oldid=1010461429";
    dcterms:source "https://meitotmei.nl/het-catshuis-als-nazistische-spionnenschool/"@nl,
      "https://www.atlantikwallmuseum.nl/nl/atlantikwall/overige/a-schule-westen#:~:text=De%20Agenten%20Schule%20West%20kreeg,wel%20aangeduid%20als%20Referat%20VIs."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/4658>, <https://data.niod.nl/WO2_Thesaurus/2420>;
    dcterms:created "2026-04-16T10:59:54.430Z"^^xsd:dateTime;
    skos:prefLabel "Agentenschule West"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Agentenschule West, ook aangeduid als A-Schule West, Sonderkommando S en Seehof, was vanaf mei 1943 tot 6 juni 1944 een spionage- en sabotageopleiding van het Amt VI van het Reichssicherheitshauptamt (RSHA). Enkele tientallen Nederlandse, Belgische, Zwitserse, Italiaanse en Arabisch ‘studenten’ worden hier opgeleid tot spion, een aantal van hen onder dwang. Zij krijgen les in explosieven, wapens, vermommingen en codes. De Duitse spionnenschool bevond zich in het Catshuis in Den Haag en werd geleid door Standartenführer Friedrich Ludwig Knolle, Hauptsturmführer Jan Jacobus Bate Spreij en Sturmbanführer Manfred Karl Friedrich Pechau."@nl;
    skos:altLabel "Agentschule West"@nl, "Agenten Schule West"@nl, "A-Schule West"@nl,
      "Seehof"@nl, "Spionnenschool Zorgvliet"@nl, "SS Agentenschule West"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
