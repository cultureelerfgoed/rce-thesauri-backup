    skos:prefLabel "Deelname Wiking bij Slag om Dnjepropetrovsk"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Deelname van Wiking bij de Slag om Dnjepropetrovsk vond plaats in september 1941. Nadat Divisie Wiking eerder in Kiev werd afgelost, begaven de manschappen zich in de richting van rivier de Dnjepr. Daar vochten zij vervolgens om de Oekraïense stad Dnjepropetrovsk. Halverwege de maand september viel de stad in Duitse handen. "@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
