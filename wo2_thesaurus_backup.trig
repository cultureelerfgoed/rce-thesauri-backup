  <https://data.niod.nl/WO2_Thesaurus/18483> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Bart Nauta, In het Centrum van de Vernietiging. Een kleine geschiedenis van de Nederlanders in het Joodse Sonderkommando en de SS-Totenkopfverbände bij de gaskamers van Auschwitz-Birkenau, Bachelorscriptie Geschiedenis, 1 juli 2015, UvA Amsterdam"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:32:45.543Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/11363>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/7/74/Auschwitz_Resistance_280.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/wiki/Category:Sonderkommando_photographs#/media/File:Auschwitz_Resistance_280.jpg";
    <http://schema.org/startDate> "1942-07-04"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/wiki/Sonderkommando_van_Auschwitz"@nl;
    skos:relatedMatch <https://data.niod.nl/WO2_biografieen/Henry-Bronkhorst>, <https://data.niod.nl/WO2_biografieen/Joseph-Peperwortel>,
      <https://data.niod.nl/WO2_biografieen/Salomon-van-Sijs>, <https://data.niod.nl/WO2_biografieen/Salomon-Zoute>,
      <https://data.niod.nl/WO2_biografieen/Jacob-Beesemer>, <https://data.niod.nl/WO2_biografieen/Abraham-Beesemer>,
      <https://data.niod.nl/WO2_biografieen/Louis-Elzas>, <https://data.niod.nl/WO2_biografieen/Maurice-Schellekes>,
      <https://data.niod.nl/WO2_biografieen/Josef-van-Rijk>, <https://data.niod.nl/WO2_biografieen/Mozes-van-Kleef>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/5414>;
    dcterms:created "2021-12-14T15:02:29.401Z"^^xsd:dateTime;
    skos:prefLabel "Sonderkommando van Auschwitz"@nl, "Sonderkommando Auschwitz"@de, "Sonderkommando Auschwitz"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het Sonderkommando van Auschwitz was werkzaam in vernietigingskamp Auschwitz-Birkenau. Het bestond uit Joodse gevangenen die gedwongen werden mee te werken in de crematoria II-V. Ze moesten gevangenen de gaskamers indrijven en lijken van gouden tanden en kiezen en haar ontdoen om ze vervolgens in verbrandingsovens te schuiven. Bij crematorium IV en V werden lijken naar buiten gebracht om te verbranden. Het Sonderkomando werd op 4 juli 1942 opgericht. In het begin waren er nog geen crematoria en werden twee huisjes als gaskamer ingericht. Het Sonderkommando moest de lijken naar grafkuilen vervoeren en begraven. Sonderkommando's hadden twee eigen barakken en een zekere beschermde status maar bij dienstverzuim volgde liquidatie. Bij het Sonderkommando waren 100-150 Nederlandse mannen betrokken."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/9458>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
