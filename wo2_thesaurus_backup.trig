    dcterms:source "https://resolver.kb.nl/resolve?urn=MMCODA01:000159214:mpeg21:a0063"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-06"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Stichting Het Nederlandsch Verbond voor Sibbekunde was een bundeling van genealogische verenigingen. De stichting werd in december 1940 opgericht door Ludo ten Cate om informatie over Joden te verzamelen en genealogisch onderzoek te ondersteunen. Met het maandblad Sibbe, radio-uitzendingen en tentoonstellingen verspreidde de stichting het nationaalsocialistische gedachtegoed over rassenleer."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2016>, <https://data.niod.nl/WO2_Thesaurus/20640>;
    dcterms:created "2023-05-10T10:14:27.566Z"^^xsd:dateTime;
    skos:prefLabel "Nederlandsch Verbond van Sibbekunde"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Stichting Het Nederlandsch Verbond voor Sibbekunde werd begin december 1940 opgericht door de Nederlandse SS’er Ludo ten Cate en enkele gelijkgezinden. De werkelijke initiatiefnemer achter de schermen was SS-Sturmbannführer dr. Wolfgang Ispert die op het Rijkscommissariaat werkte. Ispert wilde dat het Nederlandsch Verbond voor Sibbekunde ook informatie zou verzamelen over Joden. Het verbond ontstond uit een fusie van alle daarvoor bestaande genealogische verenigingen. Naast de uitgave van een eigen maandblad Sibbe kreeg het verbond vanaf december 1940 de gelegenheid voor de radio lezingen te houden over nationaalsocialistische rassenleer en genealogie."@nl;
    skos:altLabel "Nederlands Verbond van Sibbekunde"@nl, "Stichting Het Nederlandsch Verbond voor Sibbekunde"@nl,
      "Het Nederlandsch Verbond voor Sibbekunde"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/19548> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:references "L. de Jong, Het Koninkrijk der Nederlanden in de Tweede Wereldoorlog. Deel 5. Maart ’41-Juli ’42. Eerste helft (’s-Gravenhage 1974) "@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2024-08-12T12:03:08.637Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1941-02-28"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/dbe47e2c-0259-11e7-904b-d89d6717b464/media/eea85b0c-1739-31b0-32a5-7217e7de6792>,
      <https://beeldbankwo2.nl/nl/beelden/detail/cd3e4fb0-0259-11e7-904b-d89d6717b464/media/ca3d262a-a7ac-88c8-7dee-4e89c95115aa>;
    dcterms:source "https://www.leiden4045.nl/verboden-verenigingen/"@nl, "https://www.oorlogsgetroffenen.nl/thema/rechtsherstel/03_02_Niet_commerciele_verenigingen_en_stichtingen"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-06"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "Het Commissariaat voor Niet-Commerciële Vereenigingen en Stichtingen (CNCV) was een nationaalsocialistische organisatie voor maatschappelijke en culturele verenigingen en stichtingen. Alle Nederlandse verenigingen en stichtingen zonder economisch doel werden bij het CNCV geregistreerd. Politieke en religieuze instellingen werden meestal verboden. Niet-politieke organisaties, zoals sportclubs, zorginstellingen en scholen, mochten blijven bestaan. Van de 90.000 bij het CNCV geregistreerde organisaties hief de bezetter er 7.700 op en het onteigende 360 Joodse bedrijven."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2146>, <https://data.niod.nl/WO2_Thesaurus/2085>,
      <https://data.niod.nl/WO2_Thesaurus/20640>, <https://data.niod.nl/WO2_Thesaurus/20712>;
    dcterms:created "2023-05-10T10:49:20.600Z"^^xsd:dateTime;
    skos:prefLabel "Commissariaat voor niet-commercieële Vereenigingen en Stichtingen "@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Commissariaat van Niet-Commerciële Vereenigingen en Stichtingen werd op 28 februari 1941 door Seyss-Inquart ingesteld in het kader van de nazificering van de Nederlandse samenleving. Aan het hoofd stond de NSB’er Hans Werner Müller-Lehning die vrijwel alleen partijgenoten als personeel aannam. Het commissariaat kon bij de ruim 90.000 verenigingen en stichtingen die Nederland telde ingrijpen en deze desgewenst ontbinden. Binnen acht maanden waren al 7.700 particuliere organisaties gedeeltelijk of geheel opgeheven. De ruim 360 Joodse verenigingen en stichtingen hieronder werden volledig van hun bezittingen en financiële middelen beroofd."@nl;
    skos:altLabel "Commissariaat voor niet-commerciële Verenigingen en Stichtingen"@nl,
      "Commissariaat voor niet-commercieele Vereenigingen en Stichtingen"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization>;
    skos:hiddenLabel "C.N.C.V."@nl .
  
