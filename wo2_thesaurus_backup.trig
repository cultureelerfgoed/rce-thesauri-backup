    skos:prefLabel "Slag om De Heuvel"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Slag om De Heuvel te Bemmel vond plaats na Market Garden, tussen 1 en 4 oktober 1944. In het gebied werd hevige strijd geleverd tussen Britse en Duitse tank- en infanterie-eenheden. Na de gevechten kwam de frontlijn ter hoogte van de Linge te liggen."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
