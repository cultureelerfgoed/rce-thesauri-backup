    <http://schema.org/startDate> "1944-06-20"^^xsd:date;
    dcterms:source "https://www.mijn-genea.nl/genea/member/van-santen/content/treinbeschieting-hattemerbroek-29-juni-1944/165"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/21835>;
    dcterms:created "2021-01-20T14:43:30.638Z"^^xsd:dateTime;
    skos:prefLabel "Treinbeschieting Hattemerbroek"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Langs de Oude Kerkweg in Hattemerbroek werd op 20 juni 1944 de trein Groningen-Utrecht door geallieerde jagers beschoten en tot stoppen gewongen. Passagiers verlieten de trein en zochten een veilig heenkomen maar er vielen 7 doden. Na een ingediend burgerinitiatief is op 11 november 2020 een monument onthuld aan de Oude Kerkweg in Hattemerbroek. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
