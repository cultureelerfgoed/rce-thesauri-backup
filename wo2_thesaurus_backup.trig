    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/19056>;
    <http://schema.org/startDate> "1944-08-28"^^xsd:date;
    dcterms:source "Albert Willem Oosthoek, Nieuw licht op liquidatie. Knokploegen in Rotterdam 1944-1945 (Soesterberg: Uitgeverij Specht, 2015)"@nl;
    skos:relatedMatch <https://data.niod.nl/WO2_Thesaurus/corporaties/5554>, <https://data.niod.nl/WO2_Thesaurus/17302>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2682>;
    dcterms:created "2022-08-30T17:45:22.025Z"^^xsd:dateTime;
    skos:prefLabel "Aanslag op Groep 10, 28 augustus 1944"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Aanslag op Groep 10 vond plaats op 28 augustus 1944 in Rotterdam. Op verschillende plekken in Rotterdam werden aanslagen gepleegd op drie leden van Groep 10. NSB’er en opperwachtmeester staatspolitie Philippus Pikaar werd doodgeschoten bij West Sidelinge 208. Politieagent en NSB’er Johannes Jager werd neergeschoten op de hoek Nieuwe Binnenweg en Mathenesserlaan, maar overleefde de aanslag. Politieagent en dubbelspion Willem Frederik Los kon ook ontkomen. Als reactie op de aanslag vond op 30 augustus 1944 een onsuccesvolle Silbertanne-actie door het Commando Feldmeijer plaats."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/19058> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
