    skos:relatedMatch <https://data.niod.nl/WO2_biografieen/Wernher-von-Braun>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/3697>;
    dcterms:created "2021-12-08T14:34:27.951Z"^^xsd:dateTime;
    skos:prefLabel "Peenemünde"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "In Peenemünde was tussen juni en oktober 1943 een buitenkamp van Ravensbrück operationeel. Onder toezicht van de technische directeur Wernher von Braun werden er hier V2-raketten gebouwd. Ook na opheffing van het kamp werden onder anderen Nederlandse dwangarbeiders in Peenemünde ingezet voor productiewerk ten dienste van de Luftwaffe."@nl;
    skos:altLabel "Karlshagen"@nl .
  
