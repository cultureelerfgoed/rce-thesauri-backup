    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Groep_Albrecht#/media/File:Albrecht_logo.jpg";
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Speciaal:Citeren&page=Groep_Albrecht&id=48983813 "@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    <https://data.niod.nl/EventsWO2/dateDescription> "Oprichting in maart 1943.";
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/2669>;
    dcterms:created "2016-10-04T13:07:43.000Z"^^xsd:dateTime;
    skos:prefLabel "Gruppe 'Groep Albrecht'"@de, "Group 'Groep Albrecht'"@en, "Groep Albrecht"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Groep Albrecht was een verzetsgroep voor militaire en economische spionage, opgericht in maart 1943 en gevestigd in de Oosterkerk op de Utrechtse Maliebaan. De oprichter, eerste luitenant Henk de Jonge, was in 1942 naar Engeland uitgeweken en als geheim agent teruggezonden door Bureau Inlichtingen Londen. In acht maanden tijd bouwde hij een hechte organisatie op. De Jonge werd bij zijn poging terug te keren naar Engeland in november 1944 in de Pyreneeën gearresteerd. Groep Albrecht bleef tot aan de bevrijding actief."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/4817> a <http://schema.org/Thing>,
