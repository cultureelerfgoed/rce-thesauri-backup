    dcterms:created "2020-09-14T08:26:59.000Z"^^xsd:dateTime;
    skos:prefLabel "Slag om Korsun-Tsjerkasy"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Slag om Korsun-Tsjerkasy was een Sovjet-offensief die plaatsvond van 24 januari tot 16 februari 1944 aan het oostfront van de Tweede Wereldoorlog. Het Sovjetleger onder leiding van Nikolaj Vatoetin en Ivan Konev wist de Duitse troepen van Legergroep Zuid te omsingelen in een gebied nabij de rivier Dnjepr. "@nl .
  
