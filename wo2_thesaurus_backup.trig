    skos:broader <https://data.niod.nl/WO2_Thesaurus/2056>;
    dcterms:created "2020-07-21T12:07:44.000Z"^^xsd:dateTime;
    skos:prefLabel "Razzia Hollandia-Kattenburg in Amsterdam"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 11 november 1942 werden tijdens een razzia bij confectiefabriek 'Hollandia Kattenburg' in Amsterdam-Noord 367 Joodse medewerkers opgepakt en samen met hun familieleden weggevoerd naar Duitse concentratiekampen. Uiteindelijk kwam dit neer op 826 mensen, waarvan acht personen terugkeerden."@nl;
