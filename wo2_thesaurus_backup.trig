    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Wilhelm_Gustloff_(schip,_1938)&oldid=54328411"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3511>;
    dcterms:created "2019-08-08T14:58:10.000Z"^^xsd:dateTime;
    skos:prefLabel "Scheepsramp Wilhelm Gustloff"@nl, "Versenkung der Wilhelm Gustloff"@de,
      "Sinking of the Wilhelm Gustloff"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Wilhelm Gustloff was een Duits passagiersschip van de nationaalsocialistische organisatie Kraft durch Freude (KdF), genoemd naar de vermoorde Duitse leider van de Zwitserse nazipartij. Bij de ondergang van de Wilhelm Gustloff op 30 januari 1945 na een torpedering door een Sovjet-onderzeeboot kwamen ongeveer 9.000 mensen om het leven."@nl;
    skos:altLabel "Ondergang van de Gustloff"@nl, "Ondergang van de Wilhelm Gustloff"@nl .
  
