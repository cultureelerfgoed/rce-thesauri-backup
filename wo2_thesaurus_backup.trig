    <http://www.w3.org/2003/01/geo/wgs84_pos#long> "17.373975"^^xsd:float;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:32:49.919Z"^^xsd:dateTime;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/6407>;
    dcterms:created "2018-07-16T06:29:57.000Z"^^xsd:dateTime;
    skos:prefLabel "Oflag VIII-C"@nl, "Oflag VIII-C"@de, "Oflag VIII-C"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Oflag VIII-C was een Duits krijgsgevangenkamp voor officieren in Juliusburg, Polen (destijds Duitsland). Het kamp werd in november 1940 gevestigd in een deel van het klooster Amalienstift. De Nederlandse gevangenen, die in 1940 geweigerd hadden om de erewoordverklaring te tekenen, werden eerst in Oflag VI A in Soest ondergebracht en vervolgens per trein naar Juliusburg gebracht. Na de succesvolle ontsnapping van kapitein Trebels en luitenant Van der Veen werden alle Nederlandse gevangenen op 23 juli 1941 overgeplaatst naar Slot Colditz (Oflag IV-C)."@nl;
    skos:altLabel "Oflag Juliusburg"@nl, "Oflag VIII C"@nl, "Oflag VIII-C Juliusburg"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/6468> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "49.83524"^^xsd:float;
    <http://www.w3.org/2003/01/geo/wgs84_pos#long> "17.70425"^^xsd:float;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:33:03.017Z"^^xsd:dateTime;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/6407>;
    dcterms:created "2018-07-16T06:30:07.000Z"^^xsd:dateTime;
    skos:prefLabel "Oflag VIII-E"@nl, "Oflag VIII-E"@de, "Oflag VIII-E"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Oflag VIII-E was een Duits krijgsgevangenkamp voor geallieerde generaals in Johannisbrunn, Sudetenland (nu: Tsjechië). Het kamp was gevestigd in een voormalig Spa hotel en werd in juli 1940 in gebruik genomen. Er verbleven zo'n 70 generaals van verschillende nationaliteiten. Op 27 april 1942 werden de Polen naar o.a. Oflag VII-A in Murnau overgebracht. Al snel werden de andere gevangenen ook naar elders getransporteerd en werd het kamp op 1 juli 1942 gesloten."@nl;
    skos:altLabel "Oflag Johannisbrunn"@nl, "Oflag VIII E"@nl, "Oflag VIII-E Johannisbrunn"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/6469> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:34:13.533Z"^^xsd:dateTime;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/jacobsf>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/6407>;
    dcterms:created "2018-07-16T06:30:18.000Z"^^xsd:dateTime;
    skos:prefLabel "Oflag VIII-F"@nl, "Oflag VIII-F"@de, "Oflag VIII-F"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Oflag VIII-F was een Duits krijgsgevangenkamp dat in juli 1940 in Wahlstatt, Duitsland werd gevestigd. Er verbleven Franse en Belgische officieren. In juli 1942 kwam er een nieuw kamp in Mährisch-Trübau, protectoraat van Bohemen en Moravië (nu: Tsjechië) dat ook Oflag VIII-F werd genoemd. Het kamp in Wahlstatt werd een subkamp, genaamd Oflag VIIIF/Z. Dit subkamp werd in juli 1943 gesloten."@nl;
    skos:altLabel "Oflag Maehrisch Truebau"@nl, "Oflag Mährisch Trübau"@nl, "Oflag VIII F"@nl,
      "Oflag VIII-F Maehrisch Truebau"@nl, "Oflag VIII-F Mährisch Trübau"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/6470> a <http://schema.org/Thing>, skos:Concept,
      <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
