    dcterms:created "2019-09-27T11:32:32.000Z"^^xsd:dateTime;
    skos:prefLabel "Rijksdienst voor de Werkverruiming"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Rijksdienst voor de Werkverruiming bestond van 1939 tot en met 1945 en was een overheidsinstituut dat zich richtte op het verschaffen van werk aan werklozen, veelal in daartoe opgerichte kampen. Veel van deze kampen werden in 1942 gebruikt als Joodse werkkampen."@nl;
    skos:altLabel "RvdW"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/9058>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/8611> a <http://schema.org/Thing>,
