    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De liquidatie van Anne Jannes Elsinga vond plaats nadat de top van de LO en KP kort na Kerstmis 1943 besloten dat NSB'er Elsinga geliquideerd moest worden. Elsinga was erachter gekomen wie de personen achter de illegale krant Trouw in Bedum waren. De opdracht werd uitgevoerd door verzetsman Reint Dijkema op 31 december 1943 op de Eendrachtsbrug in Groningen."@nl;
    skos:altLabel "Liquidatie van Anne Jannes Elzinga"@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
