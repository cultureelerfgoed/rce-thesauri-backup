    dcterms:created "2021-09-16T08:17:21.706Z"^^xsd:dateTime;
    skos:prefLabel "Invoering Wet Behoud Scheepsruimte"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Wet Behoud Scheepsruimte die op 1 juli 1939 in werking trad verbood in het geval van oorlog, oorlogsgevaar of andere buitengewone omstandigheden de sloop van zeeschepen en het gebruik van zeeschepen voor andere doeleinden dan de zeescheepvaart. Scheepsruimte mocht ook niet in buitenlandse handen terecht komen. Het doel was om te zorgen dat in tijden van oorlog Nederland over voldoende scheepsruimte beschikte voor bijvoorbeeld de aanvoer van voedsel. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
