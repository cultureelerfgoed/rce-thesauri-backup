    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://resolver.kb.nl/resolve?urn=urn:gvn:EVDO02:NIOD05_0919&size=large";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "http://resolver.kb.nl/resolve?urn=urn:gvn:EVDO02:NIOD05_0919";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/bafa4344-025a-11e7-904b-d89d6717b464/media/978297ef-7832-631d-d03c-4816a54634cf>,
      <http://beeldbankwo2.nl/nl/beelden/detail/baf9e02a-025a-11e7-904b-d89d6717b464/media/75b86a27-769a-a3bf-fa32-5e4fd84dab3f>,
      <https://beeldbankwo2.nl/nl/beelden/detail/3a804844-025a-11e7-904b-d89d6717b464/media/0244e554-1e64-1d8b-5851-7f5c365eae46>;
    dcterms:source "https://historiek.net/het-artsenverzet-opgesloten-in-kamp-amersfoort-in-1942-en-1943/148255/"@nl,
      "https://anderetijden.nl/aflevering/278/Artsen-in-de-oorlog"@nl;
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-06"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Nederlandsche Artsenkamer was een nationaalsocialistische organisatie voor artsen. Alle 7.000 artsen in Nederland waren verplicht lid van de Nederlandsche Artsenkamer. Toch meldden ongeveer 5.000 artsen zich niet aan. Daarnaast mochten 700 Joodse artsen geen lid worden. De Nederlandsche Artsenkamer werd op 20 december 1941 opgericht en verving de Maatschappij tot Bevordering der Geneeskunst."@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2853>, <https://data.niod.nl/WO2_Thesaurus/20640>,
      <https://data.niod.nl/WO2_Thesaurus/20645>;
    dcterms:created "2017-03-17T19:34:20.000Z"^^xsd:dateTime;
    skos:prefLabel "Nederlandsche Artsenkamer"@nl, "'Nederlandsche Artsenkamer'"@de, "Dutch Chamber of Doctors"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Nederlandsche Artsenkamer werd door Seyss-Inquart op 20 december 1941 per verordening ingesteld. De nationaalsocialistische organisatie kwam in de plaats van de Maatschappij tot Bevordering der Geneeskunst en stond onder leiding van de NSB’er C.C.A. Croïn. De verplichting om lid te worden van de Artsenkamer gaf een belangrijke impuls aan de geweldloze verzetsorganisatie Medisch Contact die in de zomer van 1941 tot stand was gekomen. "@nl;
    skos:altLabel "Nederlandse Artsenkamer"@nl, "Artsenkamer"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization>;
    skos:definition "De Nederlandsche Artsenkamer werd op 20 december 1941 ingesteld bij Verordening VO 22/41. Alle Nederlandse artsen werden verplicht lid. Tegelijkertijd werd de Nederlandse Vereniging van Ziekenhuisartsen opgericht, waar alle artsen die in 1941 als ziekenfondsarts werkzaam waren geweest (en dat waren vrijwel alle artsen) automatisch lid waren. Deze organisatie kwamen in de plaats van de Maatschappij tot Bevordering der Geneeskunst en kwamen onder leiding van de NSB’er C.C.A. Croïn.  De verzetsorganisatie Medisch Contact is ontstaan uit protest tegen het instellen van de Artsenkamer."@nl .
  
