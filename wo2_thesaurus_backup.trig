    skos:relatedMatch <https://data.niod.nl/WO2_biografieen/Willem-Bernard-Engelbrecht_2>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/7819>;
    dcterms:created "2019-01-23T19:33:08.000Z"^^xsd:dateTime;
    skos:prefLabel "Commissaris der provincie Utrecht"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Tijdens de Duitse bezetting werden bijna alle commissarissen van de Koningin ontslagen door de Duitsers en werden NSB'ers geïnstalleerd met als titel Commissaris der provincie. In Utrecht werd Lodewijk Hendrik Nicolaas Bosch van Rosenthal (CHU) in 1941 vanwege zijn anti-Duitse houding ontslagen en aanvankelijk vervangen door Frederik Ernst Müller en vanaf oktober 1941 door Willem Bernard Engelbrecht, beiden lid van de NSB. Na de bevrijding werd Bosch van Rosenthal wederom Commissaris van de Koningin in Utrecht."@nl .
  
