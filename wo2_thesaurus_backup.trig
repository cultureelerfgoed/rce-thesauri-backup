  <https://data.niod.nl/WO2_Thesaurus/19575> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "N.J.G. Sikkel (red.), Documentatie. Samengesteld ten behoeve van de Bijzondere Rechtspleging, op last van de Procureur-Fiscaal bij het Bijzonder Gerechtshof te Amsterdam (Amsterdam 1947)"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2025-08-06T08:05:29.511Z"^^xsd:dateTime;
    <https://data.niod.nl/organizationsWO2/startDate> "1943-08-01"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/1000x1000/8817a660-7962-905c-d906-5d823093a682.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/960509c0-025a-11e7-904b-d89d6717b464/media/8817a660-7962-905c-d906-5d823093a682";
    <https://data.niod.nl/organizationsWO2/endDate> "1945-05-06"^^xsd:date;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/ovdrScopeNote> "De Wachabteilung des Chefintendanten beim Wehrmachtsbefehlshaber in den Niederlanden, ook wel Wachabteilung genoemd, was een Duitse militaire bewakingsdienst. De Wachabteilung bewaakte vliegvelden en installaties van het Duitse leger (Wehrmacht) in Nederland en België. In juli 1941 waren er zeker 550 leden van de Nationaal-Socialistische Beweging (NSB) in dienst bij de Wachabteilung."@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/20719>;
    dcterms:created "2023-05-15T07:23:53.051Z"^^xsd:dateTime;
    skos:prefLabel "Wachabteilung"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Wachabteilung des Chefintendanten beim Wehrmachtsbefehlshaber in den Niederlanden (ook wel Wachabteilung genoemd) werd op 1 augustus 1943 opgericht op bevel van de Wehrmachtsbefehlshaber in den Niederlanden Friedrich Christiansen. De leiding van de Wachabteilung berustte bij admiraal dr. Delohr. Het doel van de militaire bewakingsorganisatie bestond uit de bewaking van de voor Wehrmacht van belang zijnde bedrijven, inrichtingen en installaties in Nederland en België. Het personeel van de opgeheven civiele bewakingsdiensten Wachdienst Niedersachsen en Westdeutscher Wach- und Schutzdienst (vooral NSB’ers) werd gevorderd door de Wachabteilung, terwijl ook Rijksduitsers en ‘betrouwbare buitenlanders’ werden aangenomen."@nl;
    skos:altLabel "Wachabteilung des Chefintendanten beim Wehrmachtsbefehlshaber in den Niederlanden"@nl,
      "Bismarck-Jugend"@nl, "W.B.N."@nl, "Bismarckjugend"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/19913>, <https://data.niod.nl/WO2_Thesaurus/19914>,
