    dcterms:created "2020-07-23T10:57:41.000Z"^^xsd:dateTime;
    skos:prefLabel "Tweede Auschwitzproces"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het Tweede Auschwitzproces vond plaats in Frankfurt am Main. Dit proces kwam, in tegenstelling tot het eerste proces in Krakau, moeilijk op gang en de bedeelde straffen waren minder hoog. In Frankfurt stonden SS'ers terecht die op eigen initiatief gevangenen hadden gemarteld, verminkt of vermoord. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9095> a <http://schema.org/Thing>, skos:Concept,
