    dcterms:created "2019-02-26T08:32:45.000Z"^^xsd:dateTime;
    skos:prefLabel "Razzia van Oldebroek"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Razzia van Oldebroek vond plaats op 10 oktober 1944, waarna de mannen werden ingezet als dwangarbeiders bij de IJssel. In de buurt van Hattem moesten zij loopgraven spitten. De werkzaamheden waren van korte duur en alle mannen mochten naar afloop weer naar huis."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
