    skos:prefLabel "Molen De Vrijheid (Beesd)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>;
    skos:scopeNote "Molen De Vrijheid in Beesd werd tijdens de bezetting gebruikt door het verzet om boodschappen te versturen via de stand van de wieken. De naam is als eerbetoon in 1968 aan de tot dan toe naamloze molen gegeven. "@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/locations/8058> a <http://schema.org/Thing>, skos:Concept;
