    skos:broader <https://data.niod.nl/WO2_Thesaurus/2316>;
    dcterms:created "2024-03-28T13:06:27.819Z"^^xsd:dateTime;
    skos:prefLabel "B-24 Liberator"@nl, "B-24 Liberator"@en, "B-24 Liberator"@de;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De B-24 Liberator is een zware Amerikaanse langeafstandsbommenwerper die ontworpen werd door Consolidated Aircraft. De bommenwerper was primair gemaakt om de ruim 3600 kilo aan bommen te vervoeren en er was weinig comfort voor de bemanning. Mede daardoor kreeg het vliegtuig de bijnaam Vliegende Doodskist."@nl;
    skos:altLabel "Consolidated B-24"@nl, "Consolidated B-24 Liberator"@nl .
  
