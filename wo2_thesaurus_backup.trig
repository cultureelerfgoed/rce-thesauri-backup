    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2322>, <https://data.niod.nl/WO2_Thesaurus/events/19539>;
    dcterms:created "2025-10-07T08:03:30.801Z"^^xsd:dateTime;
    skos:prefLabel "Bombardement op Lijnsheike Tilburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Het bombardement in Lijnsheike, Tilburg, vond plaats op 10 mei 1940. In de middag slaan in de buurt van het treinstation bommen in. Later volgt een bominslag op de Bosscheweg en rond 17.20 uur wordt een bominslag gemeld op de Heikant. Die bom ontploft in de tuin van Lijnsheike 16, vlakbij etablissement ’t Wit Paardje. Twee personen komen om het leven."@nl .
  
