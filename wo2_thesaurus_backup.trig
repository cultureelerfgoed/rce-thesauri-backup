    dcterms:modified "2024-02-23T09:53:29.953Z"^^xsd:dateTime;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/2669>;
    dcterms:created "2017-09-13T10:57:13.000Z"^^xsd:dateTime;
    skos:prefLabel "Hazemeyergroep"@nl, "'Hazemeyergroep'"@de, "'Hazemeyergroep'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Hazemeyergroep was een verzetsgroep van buiten de CPN opererende communisten die bij werkzaam waren bij Hazemeyer-Signaal te Hengelo. Zij pleegden vanaf zomer 1941 sabotage-acties. De groep werd in oktober 1942 opgerold. Betrokken personen waren onder meer Herman Reef en Harry van Genuchten."@nl;
    skos:altLabel "Hazemeyer Groep"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/5427> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "NIOD"@nl, "A.P.M. Cammaert, Het verborgen front. Geschiedenis van de georganiseerde illegaliteit in de provincie Limburg tijdens de Tweede Wereldoorlog (Leeuwarden : Eisma, 1994)"@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-02-22T16:07:42.043Z"^^xsd:dateTime;
    dcterms:source "https://www.verzetsmuseum.org/museum/nl/tweede-wereldoorlog/begrippenlijst/achtergrond,ordedienst "@nl;
    skos:relatedMatch <https://data.niod.nl/WO2_Thesaurus/11224>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/corporaties/2669>;
    dcterms:created "2017-09-13T10:57:20.000Z"^^xsd:dateTime;
    skos:prefLabel "Groep Erkens"@nl, "'Groep Erkens'"@de, "'Groep Erkens'"@en;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De verzetsgroep Groep Erkens, ook wel de Verzetsgroep Erkens of  Organisatie-Erkens of Roodkapje genoemd, was een in de zomer van 1940 opgerichte inlichtingendienst rond reserve-eerste luitenant Nicolaas Erkens uit Rotterdam, met veel contacten in Zuid-Limburg (Eijsden) en België.  Erkens had na de meidagen een functie die hem toegang gaf tot Nederlandse militaire magazijnen. Hij nam daar wapens en explosieven weg voor het 'bevrijdingsbataljon' dat hij wilde opbouwen. Verder ging Erkens (schuilnaam Van der Maas) zich bezighouden met spionage, en organiseerde hij samen met twee Belgische groepen een ontsnappingslijn."@nl;
    skos:altLabel "Organisatie-Erkens"@nl, "Roodkapje"@nl, "Verzetsgroep Erkens"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/corporaties/5428> a <http://schema.org/Thing>,
      skos:Concept, <http://schema.org/Organization>;
    dcterms:references "A.P.M. Cammaert, Het verborgen front. Geschiedenis van de georganiseerde illegaliteit in de provincie Limburg tijdens de Tweede Wereldoorlog (Leeuwarden : Eisma, 1994)"@nl;
