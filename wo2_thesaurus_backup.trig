    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Djerba#/media/Bestand:Djerba_topographic_map-de.svg";
    <http://schema.org/location> "Djerba";
    <http://schema.org/startDate> "1942-12-21"^^xsd:date;
    dcterms:source "https://www.joodsamsterdam.nl/ss-dora/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/18602>;
    dcterms:created "2022-01-12T14:15:30.985Z"^^xsd:dateTime;
    skos:prefLabel "Scheepsramp SS Dora"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Op 21 december 1942 werd de SS Dora dicht bij de haven van Djerba in Tunesië tot zinken gebracht door een Brits oorlogsschip. De Dora was na haar reis met Joodse vluchtelingen naar Palestina in 1939 niet voor een tweede reis in aanmerking gekomen wegens finanieringsproblemen. Daarna kwam ze in 1941 in Duitse handen en moest voor Duitsland gaan varen."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/3511>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/18616> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-06-07T14:17:54.450Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/5/57/Haganah_fighters_-_1947.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Hagana_(organisatie)#/media/Bestand:Haganah_fighters_-_1947.jpg";
    dcterms:source "https://nl.wikipedia.org/wiki/Hagana_(organisatie)"@nl;
    <https://data.niod.nl/eventsWO2/oorlogDichtbijSelectOption> false;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1892>, <https://data.niod.nl/WO2_Thesaurus/20704>;
    dcterms:created "2022-01-13T10:55:00.673Z"^^xsd:dateTime;
    skos:prefLabel "Hagana"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Hagana was een zionistisch-Joodse paramilitaire organisatie met als doel het verdedigen van de Joodse gemeenschap in Palestina. Ben-Zvi die later president van Israël werd was een van de eerste leiders. De Palmach was de elite-eenheid van de Hagana. De organisatie was actief gedurende het Britse mandaat over Palestina van 1920-1948."@nl;
    skos:altLabel "Haganah"@nl, "Irgun HaHagannah Ha'vri"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/18603>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/18617> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    dcterms:modified "2022-01-18T09:35:10.701Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/9950>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/8/80/Maasbracht_%28Maasgouw%29_sculptuur_schepenkerkhof.JPG/500px-Maasbracht_%28Maasgouw%29_sculptuur_schepenkerkhof.JPG";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/wiki/File:Maasbracht_(Maasgouw)_sculptuur_schepenkerkhof.JPG";
    <http://schema.org/startDate> "1944-09-29"^^xsd:date;
    <http://schema.org/endDate> "1944-09-30"^^xsd:date;
    dcterms:source "https://l1.nl/het-schepenkerkhof-zondag-op-l1-tv-28216"@nl, "https://www.4en5mei.nl/oorlogsmonumenten/zoeken/3465/maasbracht-schepenkerkhof"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3511>;
    dcterms:created "2022-01-17T14:54:04.903Z"^^xsd:dateTime;
    skos:prefLabel "Scheepsramp in Maasbracht"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Op 30 september 1944 vond in Maasbracht de grootste binnenscheepvaartramp in de Nederlandse geschiedenis plaats. Op 29 september 1944 moesten in opdracht van de Duitse bezetter alle opvarenden van 240 binnenvaartschepen in de haven van Maasbracht (meer dan 1000 personen) hun schepen verlaten. Een dag later werden de 240 schepen gekelderd door een Duits ‘Sprengkommando’. De getroffen schippers en hun gezin werden daarmee niet alleen beroofd van hun werk/inkomen, maar ook van hun huis en haard. Dat gold ook voor de vaak inwonende knecht."@nl;
    skos:altLabel "Het Schepenkerkhof "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/events/8968>, <https://data.niod.nl/WO2_Thesaurus/events/18618> .
  
  <https://data.niod.nl/WO2_Thesaurus/18619> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:references "Jaap Focke, Machseh Lajesoumim. A Jewish Orphanage in the City of Leiden, 1890-1943 (Amsterdam University Press: Amsterdam, 2021)"@nl;
