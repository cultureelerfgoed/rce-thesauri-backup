    dcterms:created "2018-10-31T10:47:19.000Z"^^xsd:dateTime;
    skos:prefLabel "Befreiung von Leeuwarden"@de, "Bevrijding van Leeuwarden"@en, "Bevrijding Leeuwarden"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De bevrijding van Leeuwarden vond plaats op 15 april 1945 door de 9e Infanterie Brigade van de Canadese strijdkrachten. De Royal Canadian Dragoons reden vanuit Dokkum over de Groningerstraatweg de stad binnen. Op die zondagochtend was Leeuwarden 'een dode stad' schreef Goffe Miedema in zijn oorlogsdagboek, want de Duitsers waren weg en de Canadezen moesten nog komen."@nl .
  
