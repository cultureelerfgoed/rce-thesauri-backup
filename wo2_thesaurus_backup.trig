    dcterms:source "https://www.omroepgelderland.nl/nieuws/2129524/Razzia-Apeldoorn-dwangarbeiders-voor-Kamp-Rees"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2360>, <https://data.niod.nl/WO2_Thesaurus/2056>;
    dcterms:created "2019-02-26T09:48:52.000Z"^^xsd:dateTime;
    skos:prefLabel "Razzia's van Apeldoorn"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Tijdens de Razzia's van Apeldoorn werden in oktober en december 1944 zo'n 11.000 mannen opgepakt, waarvan er 4.500 werden getransporteerd naar het Duitse werkkamp Rees. De razzia was een represaillemaatregel op een verzetsactie waarbij de vooraankondigingen voor een oproep tot tewerkstelling werden gestolen. Ook werden er 8 mannen standrechtelijk geëxecuteerd."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/locations/7943>, <https://data.niod.nl/WO2_Thesaurus/kampen/3699> .
  
