    skos:prefLabel "Krijgsgevangenkamp Gevangenis Padang, 18-05-1944 - 19-05-1944"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote """Krijgsgevangenkamp Gevangenis in Padang functioneerde één dag (18 en 19 mei 1944) als krijgsgevangenkamp voor 1937 mannen. Zij werden ondergebracht in de gevangenis, om de volgende dag naar Pakanbaroe te worden overgebracht en daar aan de spoorlijn tewerkgesteld te worden.
"""@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/kampen/7457> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
