    <http://schema.org/startDate> "1945-04-18"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2682>;
    dcterms:created "2021-02-11T10:58:36.062Z"^^xsd:dateTime;
    skos:prefLabel "Liquidatie van Petrus Mous"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De liquidatie van Petrus Mous vond plaats op 18 april 1945 in Dokkum. Mous was groepscommandant van de Staatspolitie en lid van de NSB. Mous werd beschuldigd van samenwerking met de Sicherheitsdienst (SD) en was aanwezig geweest bij een massa-executie in januari 1945. Hij werd op dezelfde locatie, aan de Woudweg geëxecuteerd door Johannes Antonides, Teun van der Laan, Yde Pranger en Theun Prins."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/11078> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Recht op wraak. Liquidaties in Nederland 1940-1945, Jack Kooistra en Albert Oosthoek, Leeuwarden 2009"@nl;
