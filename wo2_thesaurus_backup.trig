    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/ec7e85ec-025a-11e7-904b-d89d6717b464/media/4c52f541-62de-0f54-7b55-762ccfbff5a9";
    <http://schema.org/location> "Stille Oceaan";
    <http://schema.org/startDate> "1941-08-17"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1870>;
    dcterms:created "2021-09-30T13:18:43.572Z"^^xsd:dateTime;
    skos:prefLabel "Kota Nopan buitgemaakt"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Kota Nopan werd op 17 augustus 1941 buitgemaakt. Het Nederlands schip van de Rotterdamse Lloyd dat op de Java-New Yorklijn voer werd onderweg van Makassar (Indonesië) naar New York, op de Stille Oceaan door de Duitse hulpkruiser Komet buitgemaakt en naar Bordeaux vervoerd. Het was het enige Nederlandse schip dat voor de aanval op Pearl Harbor in de Oost werd aangevallen. Het schip werd op 10 maart 1943 door de Duitsers tot zinken gebracht bij nadering van Amerikaanse schepen op de Atlantische Oceaan."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/17681> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
