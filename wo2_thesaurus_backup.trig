    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/5b8fd5cc-025a-11e7-904b-d89d6717b464/media/a032c50d-42ee-d564-ee31-0b369cadecc3";
    <http://schema.org/location> "Atlantische Oceaan";
    <http://schema.org/startDate> "1939-09-03"^^xsd:date;
    <http://schema.org/endDate> "1945-05-08"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/wiki/Slag_om_de_Atlantische_Oceaan"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/17676>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/3536>;
    dcterms:created "2021-09-22T10:37:34.136Z"^^xsd:dateTime;
    skos:prefLabel "Slag om de Atlantische Oceaan"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De Slag om de Atlantische Oceaan was de strijd tussen de geallieerde vloot en de Duitse Kriegsmarine op de Atlantische Oceaan tussen 1939 en 1945. Het was de langstdurende militaire campagne van de Tweede Wereldoorlog. Duitse U-boten bestreden voortdurend de militaire aanvoerlijnen (vooral tussen de VS en Groot-Brittannië). Meer dan 3500 geallieerde koopvaardijschepen werden tot zinken gebracht tegenover 783 Duitse U-Boten.  "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/3536>, <https://data.niod.nl/WO2_Thesaurus/1870>;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/17643> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Dissel, Anita van, Martin Elands, Hylke Faber en Pieter Stolk, eds. De Nederlandse koopvaardij in oorlogstijd. Amsterdam: Boom, 2014. Bezemer, K.W.L.  Geschiedenis van de Nederlandse koopvaardij in de Tweede Wereldoorlog / Dl. 1 en dl. 2. Tweede druk. Amsterdam: Elsevier, 1987. "@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2023-05-16T09:04:21.386Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/10248>;
    <http://schema.org/location> "Londen";
    <http://schema.org/startDate> "1942-06-06"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1870>;
    dcterms:created "2021-09-22T13:56:04.465Z"^^xsd:dateTime;
    skos:prefLabel "Zeeschepenbesluit 1942"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "Het Zeeschepenbesluit van 6 juni 1942 was een aanpassing op de Zeeschepenvorderingswet 1939 waarbij door de Nederlandse regering alleen gebruiksvordering van schepen kon plaatsvinden. Door het nieuwe besluit kon de regering overgaan tot bezitsvordering om het daadwerkelijk eigendom van Nederlandse koopvaardijschepen in handen te krijgen. De custodianvolmacht van de Netherland(s) Shipping and Trading Committee in Londen werd hiermee ook ingetrokken. Het comité trad alleen nog op als bewindvoerder terwijl de verantwoordelijkheid nu bij de minister van Handel, Nijverheid en Scheepvaart P.A. Kerstens lag. De financiële huishouding moest worden gedaan door een Scheepvaartfonds."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/17644> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Dissel, Anita van, Martin Elands, Hylke Faber en Pieter Stolk, eds. De Nederlandse koopvaardij in oorlogstijd. Amsterdam: Boom, 2014."@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:20:21.677Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/10248>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://service.archief.nl/gaf/api/file/v1/img/821752af-563d-4566-8fe3-97ab134d3ee8?h=1000";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://www.nationaalarchief.nl/onderzoeken/fotocollectie/ac1c0994-d0b4-102d-bcf8-003048976d84";
    <http://schema.org/location> "Londen";
    <http://schema.org/startDate> "1944-08-01"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1870>, <https://data.niod.nl/WO2_Thesaurus/18413>;
    dcterms:created "2021-09-22T14:08:16.260Z"^^xsd:dateTime;
    skos:prefLabel "Einde bewindvoering Netherland(s) Shipping and Trading Committee"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Op 1 augustus 1944 werd de bewindvoering over de Nederlandse Koopvaardijschepen van de NSTC overgeheveld naar de minister van Scheepvaart en Visserij, J. M. de Booy. De maatregel was bedoeld om de continuïteit van de uitvoering van taken na de oorlog veilig te stellen. De leden van de NSTC bleven aan als adviseurs en ambtenaren in De Booy's ministerie. Rederijen met een zetel buiten bezet gebied bleven buiten de bewindvoering van de minister. Deze werden vertegenwoordigd door de Raad voor de Koopvaardij, met als voorzitter Dirk Hudig L. Jzn."@nl;
    skos:altLabel "Einde bewindvoering NSTC"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
  <https://data.niod.nl/WO2_Thesaurus/17645> a <http://schema.org/Thing>, skos:Concept,
