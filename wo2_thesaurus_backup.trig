    dcterms:references "Piet Hagen, Politicus uit hartstocht. Biografie van Pieter-Jelles Troelstra (Amsterdam: De Arbeiderspers, 2010)"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2025-12-17T14:40:35.126Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/mediabank-horizontal/d550ace3-ced4-030c-f1c6-b7c24dc3b4d5.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/e6f1fd12-0259-11e7-904b-d89d6717b464/media/d550ace3-ced4-030c-f1c6-b7c24dc3b4d5?mode=detail&view=horizontal&q=troelstraoord&rows=1&page=1";
    dcterms:source "https://mijngelderland.nl/inhoud/verhalen/de-nsb-in-het-troelstraoord"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/isPointofInterest> true;
    <https://data.niod.nl/EventsWO2/location> "Beekbergen";
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2244>, <https://data.niod.nl/WO2_Thesaurus/locations/10228>;
    dcterms:created "2019-03-06T12:26:27.000Z"^^xsd:dateTime;
    skos:prefLabel "Troelstraoord (Beekbergen)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/6564>,
      <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Het Troelstraoord was een scholings- en vakantiecentrum in Beekbergen, opgericht door de Nederlands Verbond van Vakverenigingen (N.V.V.) in 1927. Gedurende de bezetting werd de locatie gebruikt door diverse nationaalsocialistische organisaties zoals de NSB, het Nederlands Arbeidsfront (N.A.F.), de Volksche Werkgemeenschap en de Nationalsozialistische Volkswohlfahrt (N.S.V.). Op 4 en 5 oktober 1941 organiseerde de afdeling Propaganda van de NSB hier een propagandakamp. "@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/4603>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4600>;
    <http://schema.semantic-web.at/ppt/propagateType> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .
  
  <https://data.niod.nl/WO2_Thesaurus/locations/7975> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Organization>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    dcterms:modified "2024-06-12T13:48:19.768Z"^^xsd:dateTime;
