    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "Maschinenfabrik Rodas in Taucha bij Leipzig maakte motoren. Tijdens de Tweede Wereldoorlog was het onderdeel van de Mitteldeutschen Motorenwerke (MMW) en werden er vliegtuigmotoren gemaakt. Dwangarbeiders uit Lager V in Taucha werden hier tewerkgesteld. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
  <https://data.niod.nl/WO2_Thesaurus/18645> a <http://schema.org/Thing>, skos:Concept;
