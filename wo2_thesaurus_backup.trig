    <http://schema.org/startDate> "1944-04-14"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/2682>;
    dcterms:created "2021-02-04T14:41:54.527Z"^^xsd:dateTime;
    skos:prefLabel "Aanslag op Speijer Jasper de Graaf"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Aanslag op Speijer Jasper de Graaf vond plaats op 14 april 1944 in Beverwijk. De Graaf was lid van de NSB, Groepsleider en Vaandrig WA. Op 14 april werd hij in de Kerkstraat beschoten door verzetsstrijders Jan Bonekamp en Hendrik Pools. In het Rode Kruisziekenhuis in Beverwijk overleed hij rond middernacht aan zijn verwondingen. Als represaille werd op 16 april 1944 een grote razzia in Beverwijk gehouden op bevel van de SS'er Rauter."@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Event> .
  
