    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/93680672-025a-11e7-904b-d89d6717b464/media/98fe9c54-0403-1340-550b-ce89cdd01d8b";
    <http://schema.org/location> "Doornenburg";
    <http://schema.org/startDate> "1944-10-07"^^xsd:date;
    <http://schema.org/endDate> "1944-10-08"^^xsd:date;
    dcterms:source "https://www.spannendegeschiedenis.nl/locatie/doornenburg-verwoesting-en-verdriet/"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1922>, <https://data.niod.nl/WO2_Thesaurus/events/4391>;
    dcterms:created "2022-01-06T12:37:32.707Z"^^xsd:dateTime;
    skos:prefLabel "Evacuatie van Doornenburg"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Evacuatie van Doornenburg vond plaats op 7 oktober 1944, nadat de Over-Betuwe na de mislukte Operatie Market-Garden frontliniegebied werd. De Duitse bevelhebber Heinz Harmel maakte het middeleeuwse kasteel van Doornenburg tot zijn nieuwe hoofdkwartier. De geallieerden voerden daarom meerdere bombardementen uit op Doornenburg. Op 7 oktober 1944 moesten de inwoners van Doornenburg op last van de Duitse bezetter evacueren. De inwoners konden na de bevrijding op 2 april 1945 terugkeren."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/18586> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:references "Historische Kring Kesteren en Omstreken, Een onbewoond eiland. De Betuwe, verwoest en weer opgebouwd (Drukkerij Ochten: Ochten, 2005)"@nl;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/vanderheidenj>;
    dcterms:modified "2025-08-29T07:25:01.527Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/14488>;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/thumb/e/e7/Gem-Neder-Betuwe-OpenTopo.jpg/1920px-Gem-Neder-Betuwe-OpenTopo.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://nl.wikipedia.org/wiki/Neder-Betuwe_(gemeente)#/media/Bestand:Gem-Neder-Betuwe-OpenTopo.jpg";
    <http://schema.org/startDate> "1940-05-10"^^xsd:date;
    <http://schema.org/endDate> "1940-05-31"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1922>, <https://data.niod.nl/WO2_Thesaurus/2322>;
    dcterms:created "2022-01-06T12:43:39.691Z"^^xsd:dateTime;
    skos:prefLabel "Evacuatie van de Neder-Betuwe 1940"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Evacuatie van de Neder-Betuwe van 1940 was al in september 1939 voorbereid vanwege de ligging van de Betuwestelling. Bij het uitbreken van de oorlog op 10 mei 1940 werd het evacuatieplan uitgevoerd. De inwoners van Echteld, Ochten, Kesteren, Opheusden en Dodewaard werden per schip geëvacueerd. De inwoners van Ochten werden ondergebracht in Papendrecht en de inwoners van Dodewaard in Sliedrecht. De evacués vanuit Opheusden en Kesteren bereikten de geplande eindbestemming niet en werden ondergebracht in de Krimpenerwaard. Ruim twee weken later konden de evacués terug naar huis."@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/locations/8126> .
  
  <https://data.niod.nl/WO2_Thesaurus/events/18587> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    dcterms:modified "2022-01-06T13:12:45.946Z"^^xsd:dateTime;
    <http://www.w3.org/2003/01/geo/wgs84_pos#location> <https://data.niod.nl/WO2_Thesaurus/locations/14925>;
    <http://schema.org/startDate> "1944-10-01"^^xsd:date;
    <http://schema.org/endDate> "1944-11-20"^^xsd:date;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1922>;
    dcterms:created "2022-01-06T12:57:21.633Z"^^xsd:dateTime;
    skos:prefLabel "Evacuatie van de Neder-Betuwe 1944"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "De Evacuatie van de Neder-Betuwe van 1944 vond plaats vanaf 1 oktober 1944 vanwege het geplande Duitse offensief om de geallieerden uit de Betuwe te verjagen. Inwoners van Kesteren, Ochten, Opheusden en IJzendoorn moesten op 1 oktober 1944 halsoverkop evacueren. Op 17 oktober 1944 moesten ook de inwoners van de niet ontruimde delen van Ochten en IJzendoorn en de dorpen Echteld en Lienden evacueren. Ook trokken evacués naar plaatsen ten westen van het Amsterdam-Rijnkanaal, Noord-Brabant en België. Meer dan 5.000 inwoners moesten evacueren, voornamelijk naar Maurik, Eck en Wiel en Tiel."@nl .
  
