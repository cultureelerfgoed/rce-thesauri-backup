    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/b7354d29-49d5-4fe0-922a-3f3b5929fa84>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/1699>, <https://data.niod.nl/WO2_Thesaurus/19099>;
    dcterms:created "2024-09-02T10:56:05.981Z"^^xsd:dateTime;
    skos:prefLabel "Soengei Gerong"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Soengei Gerong was een krijgsgevangenkamp bij de plaats Palembang op Sumatra. Het kamp lag aan de noordoever van de Musi rivier, 2 kilometer ten oosten van het stadscentrum en was omringd door een Japans militair vliegveld, kampementen, luchtafweergeschut etc. Het kamp was van februari 1944 tot september 1945 operationeel De werkzaamheden waren o.a. de aanleg en reparatie van de voorzieningen bij het vliegveld."@nl;
    skos:altLabel "Soengei Gron"@nl, "Soengei Geroe"@nl, "Soengu Ron"@nl, "Sungai Gerong"@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/21296> a <http://schema.org/Thing>, skos:Concept,
