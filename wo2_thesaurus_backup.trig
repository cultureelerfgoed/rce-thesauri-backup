    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/c1aa6994-025a-11e7-904b-d89d6717b464/media/68931d56-4603-47e6-251f-e96f2a3f6c47"@nl;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Zweefvliegtuig&oldid=48677460"@nl;
    <http://schema.semantic-web.at/ppt/inScheme> <https://data.niod.nl/WO2_Thesaurus/1560>;
    dcterms:creator <https://cultureelerfgoed.poolparty.biz/user/demoadmin>;
    skos:narrower <https://data.niod.nl/WO2_Thesaurus/20687>;
