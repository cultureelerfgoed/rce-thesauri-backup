    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://upload.wikimedia.org/wikipedia/commons/3/3c/Bundesarchiv_Bild_183-H06156%2C_Linz%2C_Reichswerke_%22Hermann_G%C3%B6ring%22%2C_Spatenstich.jpg";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://commons.wikimedia.org/w/index.php?title=File:Bundesarchiv_Bild_183-H06156,_Linz,_Reichswerke_%22Hermann_G%C3%B6ring%22,_Spatenstich.jpg&oldid=588735447";
