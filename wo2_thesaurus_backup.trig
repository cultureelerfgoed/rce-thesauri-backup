    <http://schema.org/location> "Den Haag";
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <http://www.haagsebeeldbank.nl/afbeelding/7f8e377d-ce3a-4296-b01f-f808601cfbef>;
    <http://schema.org/startDate> "1944-12-15"^^xsd:date;
    dcterms:source "https://www.tracesofwar.nl/sights/58895/Plaquette-Executie-15-December-1944.htm"@nl;
    <https://data.niod.nl/organizationsWO2/isCausedBy> <https://data.niod.nl/WO2_Thesaurus/events/18996>,
      <https://data.niod.nl/WO2_Thesaurus/events/18997>;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/9271>;
    dcterms:created "2020-09-22T11:01:52.000Z"^^xsd:dateTime;
    skos:prefLabel "Fusillade in Den Haag, 15 december 1944"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/11183>,
      <https://data.niod.nl/WO2_Thesaurus/events/4329>;
    skos:scopeNote "Op 15 december 1944 werden in de Laan van Nieuw-Oost Indië in Den Haag twaalf personen gefusilleerd. In december 1944 had het verzet een Duitse soldaat vermoord en twee militairen verwond. Uit wraak werden op de plaats van de aanslag twaalf gevangen geëxecuteerd. Tevens werden er door de bezetter ter plaatse verschillende panden opgeblazen. De gefusilleerden waren: Leendert van Etten, Johannes Cornelis Folkers, Johannes Kop, Wilhelmus Gerhardus Adrianus Nieuwenhuizen, Josephus Dirk Noordermeer, Abraham Johannes Platteel, David Nicolaas Verburg, Hendrikus Verspeek, Johan Antonie van der Vijver, Wilhelmus Arnoldus Quirinus Wanrooij, Johannes Cornelis Maria van der Wee en Hendrik Johannes van der Wolf."@nl .
  
  <https://data.niod.nl/WO2_Thesaurus/events/9490> a <http://schema.org/Thing>, skos:Concept,
      <http://schema.org/Event>, <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
    dcterms:references "N. Wachsmann, KL. A history of the Nazi concentration camps (New York 2015)."@de;
    dcterms:contributor <https://cultureelerfgoed.poolparty.biz/user/jongmal>;
    dcterms:modified "2020-09-22T11:44:37.000Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/imageURL> "https://images.memorix.nl/niod/thumb/640x480/482d6086-05f0-dee8-70d6-ac376922aaf3.jpg"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/sourceImage> "https://beeldbankwo2.nl/nl/beelden/detail/f8d4e93a-025a-11e7-904b-d89d6717b464/media/482d6086-05f0-dee8-70d6-ac376922aaf3"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/hasHighlightedObjects> <https://beeldbankwo2.nl/nl/beelden/detail/f8d6f1c6-025a-11e7-904b-d89d6717b464/media/a7651854-aaea-fbc8-2f69-6812e9d11662>,
      <https://beeldbankwo2.nl/nl/beelden/detail/f8d5b5d6-025a-11e7-904b-d89d6717b464/media/f2350973-8585-5f30-17f5-ea114c41c27b>;
    <http://schema.org/startDate> "1933-03-22"^^xsd:date;
    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Dachau_(concentratiekamp)&oldid=56172494"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/klijne>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/4319>;
    dcterms:created "2020-09-22T11:04:22.000Z"^^xsd:dateTime;
    skos:prefLabel "Kamp Dachau in gebruik genomen"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "Kamp Dachau werd in gebruik genomen op 22 maart 1933. Het was het eerste van vele SS concentratiekampen die nadien gebouwd zouden worden. Oorspronkelijk waren het vooral politieke gevangenen die in het kamp geïnterneerd werden."@nl;
    <http://schema.semantic-web.at/ppt/propagateType> <http://schema.org/Event> .
  
