    dcterms:source "https://nl.wikipedia.org/w/index.php?title=Colonne_Henneicke&oldid=51538868"@nl;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogVoordeRechterConcept> true;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/gentrobrechtvan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/5139>, <https://data.niod.nl/WO2_Thesaurus/20640>;
    dcterms:created "2019-02-15T14:29:55.000Z"^^xsd:dateTime;
    skos:prefLabel "Colonne Henneicke"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Colonne Henneicke, officieel de Hausraterfassungsstelle, was een groep Nederlandse collaborateurs die actief waren als premiejagers in de periode tussen maart en oktober 1943. De groep bestond uit ruim vijftig Nederlanders die tegen betaling jacht maakten op Joodse onderduikers en stond onder leiding van Wim Henneicke. In het halve jaar dat de organisatie bestond was deze verantwoordelijk voor de deportatie van acht- tot negenduizend personen."@nl;
    skos:altLabel "Hausraterfassungsstelle"@de, "Kolonne Henneicke"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
