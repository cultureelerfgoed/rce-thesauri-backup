    skos:prefLabel "Joodse Coördinatie Commissie (naoorlogs)"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De naoorlogse Joodse Coördinatie Commissie (JCC) was een organisatie die zich vanaf 1945 tot 1948 voornamelijk bezighield met het opsporen van vermiste Joden, maar ook de opvang van terugkerende Joodse mensen. "@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
