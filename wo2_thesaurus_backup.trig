    skos:prefLabel "Volkssturm"@de, "Volkssturm"@en, "Volkssturm"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4434>;
    skos:scopeNote "De Volkssturm was een Duitse volksmilitie aan het einde van de Tweede Wereldoorlog. De Volkssturm werd officieel op 18 oktober 1944 op bevel van Adolf Hitler opgericht en bestond uit mannen tussen de 16 en 60 jaar die nog niet in militaire dienst zaten."@nl;
    skos:altLabel "Deutsche Volkssturm"@nl;
    <http://schema.semantic-web.at/ppt/appliedType> <http://schema.org/Organization> .
  
