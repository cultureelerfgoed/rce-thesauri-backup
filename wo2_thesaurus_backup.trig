    dcterms:source "https://merwedegijzelaars.nl/werkplek/9/leuna-werke-spergau"@nl;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/helfricha>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/kampen/6391>;
    dcterms:created "2022-02-01T13:25:48.099Z"^^xsd:dateTime;
    skos:prefLabel "Werkplek LEUNA-Werke in Spergau"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>, <https://data.niod.nl/WO2_Thesaurus/kampen/3650>;
    skos:scopeNote "De Leuna-Werke zijn genoemd naar de plaats waar in 1916 de eerste fabriek werd gesticht. In 1939 werd 76% van de benodigde benzine door de Leuna-Werke gemaakt en de productie nam alleen maar toe. Vanaf mei 1944 vonden de eerste bombardementen door de geallieerden plaats. Op 28 juli 1944 werd het kamp in Spergau op het terrein van de Leuna-Werke bij een bombardement vernield. De Nederlanders uit Beverwijk en Velsen-Noord overleefden dit en werden teruggebracht naar Kamp Schkopau."@nl .
  
