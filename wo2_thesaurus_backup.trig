    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/19853>;
    dcterms:created "2023-08-31T10:23:05.431Z"^^xsd:dateTime;
    skos:prefLabel "Gewestelijk Commandeur"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De rang gewestelijk commandeur behoorde tot de hoogste rangen van de Nederlandsche Landwacht. De gewestelijk commandeur stond aan het hoofd van een stormban (gewest). Rauter had de Nederlandsche Landwacht ingedeeld in vijf stormbannen (gewesten) die overeenkomstig was met de territoriale indeling van de reguliere politie. Van de vijf gewestelijke commandeurs waren er drie WA-functionarissen en twee functionarissen van de Nederlandsche SS."@nl;
    skos:altLabel "Gewestelijk-Commandeur"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/2249> .
  
  <https://data.niod.nl/WO2_Thesaurus/20301> a <http://schema.org/Thing>, skos:Concept;
    dcterms:references "‘De rangen in de W.A. en de uniform’, ongedateerd in, NSB-archief inv.nr. 1129, Volk en Vaderland jrg. 9 (1941), nr. 32, 8 augustus 1941, NSB, Distinctieven der Beweging. Uitgegeven in opdracht van de Organisatieleider der N.S.B. (z.p. z.j.; oorlogsperiode) p. 17."@nl,
      "N.J.G. Sikkel (red.), Documentatie. Samengesteld ten behoeve van de Bijzondere Rechtspleging, op last van de Procureur-Fiscaal bij het Bijzonder Gerechtshof te Amsterdam (Amsterdam 1947) p. 53."@nl;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    dcterms:modified "2025-07-28T14:43:27.600Z"^^xsd:dateTime;
    <https://data.niod.nl/thesaurus_wo2/ImagesWW2/oorlogDichtbijConcept> false;
    dcterms:creator <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
    skos:broader <https://data.niod.nl/WO2_Thesaurus/19853>;
    dcterms:created "2023-08-31T10:26:03.409Z"^^xsd:dateTime;
    skos:prefLabel "Commandant"@nl;
    skos:inScheme <https://data.niod.nl/WO2_Thesaurus/1560>;
    skos:scopeNote "De rang commandant der WA (Weerbaarheidsafdeeling) was de hoogste rang in het paramilitaire weerkorps van de NSB die werd bekleed Arie Zondervan. Mussert gaf in augustus 1941 het bevel dat alle mannelijke leden van de NSB tussen 18 en 40 jaar verplicht moesten toetreden tot de WA. De WA speelde een belangrijke rol in de militarisering van de NSB en het leveren van manschappen ten behoeve van de Duitse oorlogsvoering. De rang commandant was ook de hoogste rang in de Lijfwacht Mussert. De Lijfwacht Mussert werd in september 1940 opgericht en was belast met de persoonlijke beveiliging van de leider van de NSB. Naast de geüniformeerde en gewapende lijfwachten in vaste dienst, bestonden in enkele grote steden kleine groepen van jonge NSB’ers die ook tot de lijfwacht behoorden maar hierin geen betrekking hadden. De rang commandant was de hoogste rang binnen de Nederlandsche Arbeidsdienst (NAD). De NAD, ingesteld op 6 oktober 1940, had als doel het Nederlandse volk op te voeden in nationaalsocialistische geest. Toetreding tot de NAD gebeurde aanvankelijk op vrijwillige basis, maar vanwege het gebrek aan belangstelling werd vanaf begin 1942 overgegaan tot het oproepen van verplichte categorieën."@nl;
    skos:altLabel "Commandant der WA"@nl, "Commandant der Weerbaarheidsafdeeling"@nl,
      "Commandant der W.A. "@nl, "Commandant van de Weerbaarheidsafdeeling"@nl, "Commandant van de WA"@nl,
      "Commandant van de W.A."@nl, "Commandant van de Nederlandsche Arbeidsdienst"@nl, "Commandant der Nederlandsche Arbeidsdienst"@nl,
      "Commandant Nederlandsche Arbeidsdienst"@nl, "Commandant van de Lijfwacht Mussert"@nl,
      "Commandant der Lijfwacht Mussert"@nl, "Commandant Lijfwacht Mussert"@nl, "Commandant Weerbaarheidsafdeeling"@nl;
    skos:related <https://data.niod.nl/WO2_Thesaurus/corporaties/5142>, <https://data.niod.nl/WO2_Thesaurus/corporaties/4716>,
      <https://data.niod.nl/WO2_Thesaurus/9531> .
  
