    <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "52.195180"^^xsd:float;
    <http://www.w3.org/2003/01/geo/wgs84_pos#long> "6.291131"^^xsd:float;
    dcterms:contributor <https://digitaalerfgoed.poolparty.biz/user/dijkeivan>;
